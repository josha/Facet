{
  "name": "Facet-Consumer",
  "emitLegacyScripts": true,
  "globIgnorePaths": [
    "**/*.verify.luau"
  ],
  "tree": {
    "$className": "DataModel",
    "Lighting": { "$properties": { "Technology": "Future" } },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "PlayerScriptsUseInputActionSystem": "Enabled"
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Size": [
            512,
            20,
            512
          ],
          "Position": [
            0,
            -10,
            0
          ],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "ReplicatedStorage": {
      "Facet": {
        "$path": "../../src"
      },
      "FacetConsumerScreen": {
        "$path": "src/screen.luau"
      }
    },
    "StarterGui": {
      "$properties": {
        "ScreenOrientation": "Sensor"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "FacetConsumer": {
          "$path": "src/main.client.luau"
        }
      }
    }
  }
}
