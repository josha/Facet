{
  "name": "Facet Farm",
  "emitLegacyScripts": true,
  "globIgnorePaths": [
    "**/*.verify.luau"
  ],
  "tree": {
    "$className": "DataModel",
    "Lighting": { "$properties": { "Technology": "Future" } },
    "ReplicatedStorage": {
      "Facet": {
        "$path": "../../src"
      },
      "FacetFarm": {
        "$className": "Folder",
        "model": {
          "$path": "model.luau"
        },
        "screens": {
          "$path": "screens.luau"
        },
        "theme": {
          "$path": "theme.luau"
        },
        "world": {
          "$path": "world.luau"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "FacetFarm": {
          "$path": "main.client.luau"
        }
      }
    },
    "StarterGui": {
      "$properties": {
        "ScreenOrientation": "Sensor"
      }
    }
  }
}
