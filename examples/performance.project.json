{
  "name": "Facet-PerformanceLab",
  "emitLegacyScripts": false,
  "globIgnorePaths": [
    "**/*.spec.luau"
  ],
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$attributes": {
        "Facet_PerfLabPlace": "Facet-PerformanceLab",
        "Facet_NativeStyle": false
      },
      "$properties": {
        "FilteringEnabled": true,
        "PlayerScriptsUseInputActionSystem": "Enabled"
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Size": [
            512,
            20,
            512
          ],
          "Position": [
            0,
            -10,
            0
          ],
          "Color": [
            0.35,
            0.37,
            0.39
          ],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [
            12,
            1,
            12
          ],
          "Position": [
            0,
            0.5,
            0
          ],
          "Duration": 0,
          "Neutral": true
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "ReplicatedStorage": {
      "Facet": {
        "$path": "../src"
      },
      "FacetThemes": {
        "$path": "themes"
      },
      "FacetScenarios": {
        "$path": "performance/lab",
        "runner": {
          "$path": "gallery/scenarios/runner.luau"
        },
        "foreign_instances": {
          "$path": "gallery/scenarios/foreign_instances.luau"
        }
      }
    },
    "StarterGui": {
      "$properties": {
        "ScreenOrientation": "Sensor"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "PerfLab": {
          "$path": "performance/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Unified",
        "LightingStyle": "Soft",
        "PrioritizeLightingQuality": false
      }
    }
  }
}
