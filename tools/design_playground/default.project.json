{
  "name": "Compose Design Playground",
  "emitLegacyScripts": true,
  "tree": {
    "$className": "DataModel",
    "Workspace": { "$properties": { "UseNewLuauTypeSolver": "Enabled" } },
    "Lighting": { "$properties": { "Technology": "Future" } },
    "ReplicatedStorage": {
      "Facet": {
        "$path": "../../src"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "ComposeDesign": {
          "$path": "play.client.luau"
        }
      }
    },
    "ServerScriptService": {
      "ComposeDesignStorage": {
        "$path": "storage.server.luau"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ScreenOrientation": "Sensor"
      }
    }
  }
}
