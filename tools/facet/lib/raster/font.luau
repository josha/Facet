local SUBSTITUTES: { [number]: string } = {
	[0x2013] = "-",
	[0x2014] = "-",
	[0x2212] = "-",
	[0x00D7] = "x",
}

local Font = {}

Font.ADVANCE = 6
Font.HEIGHT = 9

local function glyph(codepoint: number): string
	if codepoint >= 32 and codepoint <= 126 then
		return GLYPHS[string.char(codepoint)]
	end
	return GLYPHS[SUBSTITUTES[codepoint] or "?"]
end

function Font.measure(text: string, scale: number?): number
	return (utf8.len(text) or #text) * Font.ADVANCE * (scale or 1)
end

function Font.draw(image: Image, x: number, y: number, text: string, color: { number }, scale: number?)
	local size = scale or 1
	local channels = image.channels
	local cursor = x
	for _, codepoint in utf8.codes(text) do
		local row = 0
		for line in string.gmatch(glyph(codepoint), "[^/]+") do
			for column = 1, #line do
				if string.sub(line, column, column) == "#" then
					for dy = 0, size - 1 do
						for dx = 0, size - 1 do
							local px = cursor + (column - 1) * size + dx
							local py = y + row * size + dy
							if px >= 0 and px < image.width and py >= 0 and py < image.height then
								local offset = (py * image.width + px) * channels
								for channel = 0, channels - 1 do
									buffer.writeu8(image.data, offset + channel, color[channel + 1] or 255)
								end
							end
						end
					end
				end
			end
			row += 1
		end
		cursor += Font.ADVANCE * size
	end
end

return table.freeze(Font)
