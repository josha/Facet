      <Item class="ModuleScript" referent="73">
        <Properties>
          <string name="Name">CodesService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Ledger = require(script.Parent.Ledger)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Codes = require(ReplicatedStorage.Shared.Hub.Codes)

type State = Codes.State
type Reward = Codes.Reward
type RedeemResult = Codes.RedeemResult

export type Entry = { code: string, ok: boolean, reason: Codes.Failure?, at: number }

type Definition = { rewards: { Reward }, expired: boolean }

type Profile = {
	wallet: { Coins: number, Gems: number },
	items: { [string]: number },
	redeemed: { string },
	failures: { number },
	busy: boolean,
	journal: { Entry },
}

local CATALOG: { [string]: Definition } = {
	WELCOME = {
		rewards = {
			{ kind = "Currency", name = "Coins", amount = 500 },
			{ kind = "Currency", name = "Gems", amount = 10 },
		},
		expired = false,
	},
	SPEEDY = {
		rewards = { { kind = "Item", name = "Speed Potion", amount = 2 } },
		expired = false,
	},
	LUCKY7 = {
		rewards = {
			{ kind = "Item", name = "Lucky Charm", amount = 1 },
			{ kind = "Currency", name = "Coins", amount = 77 },
		},
		expired = false,
	},
	SUMMER24 = {
		rewards = { { kind = "Currency", name = "Gems", amount = 50 } },
		expired = true,
	},
}

local FAILURE_LIMIT = 5
local FAILURE_WINDOW = 30
local SERVER_DELAY = 0.4

local profiles: { [Player]: Profile } = {}
local changed = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CodesStateChanged") :: RemoteEvent

local function profileOf(player: Player): Profile
	local profile = profiles[player]
	if profile == nil then
		local created: Profile = {
			wallet = Ledger.wallet(player),
			items = {},
			redeemed = {},
			failures = {},
			busy = false,
			journal = {},
		}
		profiles[player] = created
		return created
	end
	return profile
end

local function snapshot(profile: Profile): State
	return {
		wallet = { Coins = profile.wallet.Coins, Gems = profile.wallet.Gems },
		items = table.clone(profile.items),
		redeemed = table.clone(profile.redeemed),
	}
end

local function publish(player: Player)
	changed:FireClient(player, snapshot(profileOf(player)))
end

local function normalize(raw: unknown): string
	if type(raw) ~= "string" then
		return ""
	end
	local trimmed = string.match(raw, "^%s*(.-)%s*$") or ""
	return string.upper(string.sub(trimmed, 1, 40))
end

local function getState(player: Player): State
	return snapshot(profileOf(player))
end

local function redeem(player: Player, raw: unknown): RedeemResult
	local profile = profileOf(player)
	local code = normalize(raw)
	local now = os.clock()
	local function refuse(reason: Codes.Failure, retryIn: number?): RedeemResult
		table.insert(profile.journal, { code = code, ok = false, reason = reason, at = now })
		return { ok = false, code = code, reason = reason, retryIn = retryIn, rewards = {}, state = snapshot(profile) }
	end
	local recent: { number } = {}
	for _, at in profile.failures do
		if now - at < FAILURE_WINDOW then
			table.insert(recent, at)
		end
	end
	profile.failures = recent
	if #recent >= FAILURE_LIMIT then
		return refuse("rate_limited", math.max(1, math.ceil(FAILURE_WINDOW - (now - recent[1]))))
	end
	if code == "" then
		return refuse("empty")
	end
	if profile.busy then
		return refuse("busy")
	end
	local definition = CATALOG[code]
	if definition == nil then
		table.insert(profile.failures, now)
		return refuse("invalid")
	end
	if definition.expired then
		table.insert(profile.failures, now)
		return refuse("expired")
	end
	if table.find(profile.redeemed, code) ~= nil then
		return refuse("already_redeemed")
	end
	profile.busy = true
	task.wait(SERVER_DELAY)
	for _, reward in definition.rewards do
		if reward.kind == "Currency" then
			if reward.name == "Gems" then
				profile.wallet.Gems += reward.amount
			else
				profile.wallet.Coins += reward.amount
			end
		else
			profile.items[reward.name] = (profile.items[reward.name] or 0) + reward.amount
		end
	end
	table.insert(profile.redeemed, code)
	profile.busy = false
	table.insert(profile.journal, { code = code, ok = true, reason = nil, at = os.clock() })
	publish(player)
	return {
		ok = true,
		code = code,
		reason = nil,
		retryIn = nil,
		rewards = table.clone(definition.rewards),
		state = snapshot(profile),
	}
end

local function journal(player: Player): { Entry }
	return table.clone(profileOf(player).journal)
end

Players.PlayerRemoving:Connect(function(player)
	profiles[player] = nil
end)

return {
	getState = getState,
	redeem = redeem,
	journal = journal,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="74">
        <Properties>
          <string name="Name">CrateService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Ledger = require(script.Parent.Ledger)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Crates = require(ReplicatedStorage.Shared.Hub.Crates)

type State = Crates.State
type Card = Crates.Card

export type Entry = { crate: string, ok: boolean, reason: Crates.Failure?, cards: { string }, at: number }

type Profile = {
	wallet: Ledger.Wallet,
	collection: { [string]: number },
	opened: number,
	busy: boolean,
	journal: { Entry },
}

local SERVER_DELAY = 0.4
local RARITIES: { Crates.Rarity } = { "Common", "Rare", "Epic", "Legendary" }

local profiles: { [Player]: Profile } = {}
local changed = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CrateStateChanged") :: RemoteEvent

local byRarity: { [string]: { Card } } = {}
for _, card in Crates.cards do
	byRarity[card.rarity] = byRarity[card.rarity] or {}
	table.insert(byRarity[card.rarity], card)
end

local function profileOf(player: Player): Profile
	local profile = profiles[player]
	if profile == nil then
		local created: Profile =
			{ wallet = Ledger.wallet(player), collection = {}, opened = 0, busy = false, journal = {} }
		profiles[player] = created
		return created
	end
	return profile
end

local function snapshot(profile: Profile): State
	return { gems = profile.wallet.Gems, collection = table.clone(profile.collection) }
end

local function publish(player: Player)
	changed:FireClient(player, snapshot(profileOf(player)))
end

local function chance(odds: Crates.Odds, rarity: string): number
	return if rarity == "Common"
		then odds.Common
		elseif rarity == "Rare" then odds.Rare
		elseif rarity == "Epic" then odds.Epic
		else odds.Legendary
end

local function crateOf(id: string): Crates.Crate?
	for _, crate in Crates.crates do
		if crate.id == id then
			return crate
		end
	end
	return nil
end

local function draw(crate: Crates.Crate, random: Random): { Card }
	local result: { Card } = {}
	for _ = 1, crate.cards do
		local roll = random:NextNumber() * 100
		local chosen: Crates.Rarity = "Common"
		local sum = 0
		for _, rarity in RARITIES do
			sum += chance(crate.odds, rarity)
			if roll < sum then
				chosen = rarity :: Crates.Rarity
				break
			end
		end
		local pool = byRarity[chosen]
		table.insert(result, table.clone(pool[random:NextInteger(1, #pool)]))
	end
	return result
end

local function getState(player: Player): State
	return snapshot(profileOf(player))
end

local function open(player: Player, crateId: unknown): Crates.OpenResult
	local profile = profileOf(player)
	local id = if type(crateId) == "string" then crateId else ""
	local function refuse(reason: Crates.Failure): Crates.OpenResult
		table.insert(profile.journal, { crate = id, ok = false, reason = reason, cards = {}, at = os.clock() })
		return { ok = false, crate = id, reason = reason, cards = {}, state = snapshot(profile) }
	end
	local crate = crateOf(id)
	if crate == nil then
		return refuse("unknown_crate")
	end
	if profile.busy then
		return refuse("busy")
	end
	local free = id == "starter" and Ledger.progress(player).crates > 0
	if not free and profile.wallet.Gems < (crate :: Crates.Crate).price then
		return refuse("insufficient_funds")
	end
	profile.busy = true
	task.wait(SERVER_DELAY)
	profile.opened += 1
	local cards = draw(crate :: Crates.Crate, Random.new(1000 + profile.opened))
	if not free or not Ledger.consumeCrate(player) then
		profile.wallet.Gems -= (crate :: Crates.Crate).price
	end
	local names: { string } = {}
	for _, card in cards do
		profile.collection[card.id] = (profile.collection[card.id] or 0) + 1
		table.insert(names, card.id)
	end
	profile.busy = false
	table.insert(profile.journal, { crate = id, ok = true, reason = nil, cards = names, at = os.clock() })
	publish(player)
	return { ok = true, crate = id, reason = nil, cards = cards, state = snapshot(profile) }
end

local function grant(player: Player, gems: number)
	local profile = profileOf(player)
	profile.wallet.Gems = math.max(0, profile.wallet.Gems + gems)
	publish(player)
end

local function journal(player: Player): { Entry }
	return table.clone(profileOf(player).journal)
end

Players.PlayerRemoving:Connect(function(player)
	profiles[player] = nil
end)

return {
	getState = getState,
	open = open,
	grant = grant,
	journal = journal,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="75">
        <Properties>
          <string name="Name">DialogueService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Ledger = require(script.Parent.Ledger)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Dialogue = require(ReplicatedStorage.Shared.Hub.Dialogue)

type State = Dialogue.State
type Node = Dialogue.Node
type Result = Dialogue.Result

export type Entry = { kind: string, node: string?, choice: string?, ok: boolean, at: number }

type Option = { id: string, text: string, goes: string }

type Step = { speaker: string, text: string, choices: { Option }, ended: boolean, grant: number? }

type Profile = {
	nearby: string?,
	node: string?,
	wallet: Ledger.Wallet,
	questAccepted: boolean,
	busy: boolean,
	journal: { Entry },
}

local NPC = "Mechanic"

local TREE: { [string]: Step } = {
	start = {
		speaker = NPC,
		text = "Hello, racer! Help me test the hub equipment. Will you help me?",
		choices = {
			{ id = "help", text = "I will help you.", goes = "thanks" },
			{ id = "ask", text = "What needs a test?", goes = "well" },
			{ id = "refuse", text = "Not today.", goes = "later" },
		},
		ended = false,
	},
	well = {
		speaker = NPC,
		text = "The kart motor needs a test before the next race.",
		choices = {
			{ id = "help", text = "I will help you.", goes = "thanks" },
			{ id = "refuse", text = "Not today.", goes = "later" },
		},
		ended = false,
	},
	thanks = {
		speaker = NPC,
		text = "Thank you! Take 50 Coins and a Starter Crate for the test.",
		choices = { { id = "bye", text = "Goodbye.", goes = "farewell" } },
		ended = false,
		grant = 50,
	},
	later = {
		speaker = NPC,
		text = "Maybe another day, then.",
		choices = {},
		ended = true,
	},
	farewell = {
		speaker = NPC,
		text = "Safe racing. Open your crate before the next race!",
		choices = {},
		ended = true,
	},
}

local profiles: { [Player]: Profile } = {}
local overrides: { [Player]: boolean } = {}
local changed = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DialogueStateChanged") :: RemoteEvent

local function profileOf(player: Player): Profile
	local profile = profiles[player]
	if profile == nil then
		local created: Profile = {
			nearby = nil,
			node = nil,
			wallet = Ledger.wallet(player),
			questAccepted = false,
			busy = false,
			journal = {},
		}
		profiles[player] = created
		return created
	end
	return profile
end

local function nodeOf(id: string?): Node?
	if id == nil then
		return nil
	end
	local step = TREE[id :: string]
	local choices: { Dialogue.Choice } = {}
	for _, choice in step.choices do
		table.insert(choices, { id = choice.id, text = choice.text })
	end
	return { id = id :: string, speaker = step.speaker, text = step.text, choices = choices, ended = step.ended }
end

local function snapshot(profile: Profile): State
	return {
		nearby = profile.nearby,
		node = nodeOf(profile.node),
		coins = profile.wallet.Coins,
		questAccepted = profile.questAccepted,
	}
end

local function publish(player: Player)
	changed:FireClient(player, snapshot(profileOf(player)))
end

local function answer(profile: Profile, ok: boolean, reason: Dialogue.Failure?): Result
	return { ok = ok, reason = reason, state = snapshot(profile) }
end

local function record(profile: Profile, kind: string, node: string?, choice: string?, ok: boolean)
	table.insert(profile.journal, { kind = kind, node = node, choice = choice, ok = ok, at = os.clock() })
end

local function getState(player: Player): State
	return snapshot(profileOf(player))
end

local function talk(player: Player): Result
	local profile = profileOf(player)
	if profile.nearby == nil then
		return answer(profile, false, "not_nearby")
	end
	profile.node = "start"
	record(profile, "talk", "start", nil, true)
	publish(player)
	return answer(profile, true, nil)
end

local function choose(player: Player, choiceId: unknown): Result
	local profile = profileOf(player)
	if profile.node == nil then
		return answer(profile, false, "no_conversation")
	end
	if profile.busy then
		return answer(profile, false, "busy")
	end
	local step = TREE[profile.node :: string]
	local chosen: Option? = nil
	for _, choice in step.choices do
		if choice.id == choiceId then
			chosen = choice
		end
	end
	if chosen == nil then
		record(profile, "choose", profile.node, tostring(choiceId), false)
		return answer(profile, false, "unknown_choice")
	end
	profile.busy = true
	task.wait(0.2)
	local target = (chosen :: Option).goes
	profile.node = target
	local grant = TREE[target].grant
	if grant ~= nil and not profile.questAccepted then
		profile.questAccepted = true
		profile.wallet.Coins += grant
		Ledger.addCrate(player)
	end
	profile.busy = false
	record(profile, "choose", target, tostring(choiceId), true)
	publish(player)
	return answer(profile, true, nil)
end

local function leave(player: Player): Result
	local profile = profileOf(player)
	profile.node = nil
	record(profile, "leave", nil, nil, true)
	publish(player)
	return answer(profile, true, nil)
end

local function setNearby(player: Player, nearby: boolean)
	local profile = profileOf(player)
	profile.nearby = if nearby then NPC else nil
	if not nearby then
		profile.node = nil
	end
	publish(player)
end

local function journal(player: Player): { Entry }
	return table.clone(profileOf(player).journal)
end

Players.PlayerRemoving:Connect(function(player)
	profiles[player] = nil
	overrides[player] = nil
end)

return {
	getState = getState,
	talk = talk,
	choose = choose,
	leave = leave,
	setNearby = function(player: Player, nearby: boolean)
		overrides[player] = true
		setNearby(player, nearby)
	end,
	autoNearby = function(player: Player, nearby: boolean)
		if overrides[player] == nil and (profileOf(player).nearby ~= nil) ~= nearby then
			setNearby(player, nearby)
		end
	end,
	journal = journal,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="76">
        <Properties>
          <string name="Name">DriverService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Ledger = require(script.Parent.Ledger)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Drivers = require(ReplicatedStorage.Shared.Hub.Drivers)

type State = Drivers.State
type Result = Drivers.Result

export type Entry = { kind: string, driver: string, ok: boolean, reason: Drivers.Failure?, at: number }

type Profile = {
	wallet: Ledger.Wallet,
	owned: { [string]: boolean },
	rented: { [string]: number },
	equipped: string?,
	busy: boolean,
	journal: { Entry },
}

local profiles: { [Player]: Profile } = {}
local changed = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DriverStateChanged") :: RemoteEvent

local byId: { [string]: Drivers.Driver } = {}
for _, driver in Drivers.drivers do
	byId[driver.id] = driver
end

local function profileOf(player: Player): Profile
	local profile = profiles[player]
	if profile == nil then
		local created: Profile = {
			wallet = Ledger.wallet(player),
			owned = { haru = true },
			rented = {},
			equipped = "haru",
			busy = false,
			journal = {},
		}
		profiles[player] = created
		return created
	end
	return profile
end

local function prune(profile: Profile)
	local now = workspace:GetServerTimeNow()
	for id, expires in profile.rented do
		if expires <= now then
			profile.rented[id] = nil
			if profile.equipped == id then
				profile.equipped = nil
			end
		end
	end
end

local function snapshot(profile: Profile): State
	prune(profile)
	return {
		coins = profile.wallet.Coins,
		owned = table.clone(profile.owned),
		rented = table.clone(profile.rented),
		equipped = profile.equipped,
	}
end

local function publish(player: Player)
	changed:FireClient(player, snapshot(profileOf(player)))
end

local function answer(profile: Profile, kind: string, id: string, reason: Drivers.Failure?): Result
	table.insert(profile.journal, { kind = kind, driver = id, ok = reason == nil, reason = reason, at = os.clock() })
	return { ok = reason == nil, reason = reason, state = snapshot(profile) }
end

local function pay(player: Player, raw: unknown, kind: "buy" | "rent"): Result
	local profile = profileOf(player)
	local id = if type(raw) == "string" then raw else ""
	local driver = byId[id]
	if driver == nil then
		return answer(profile, kind, id, "unknown_driver")
	end
	if profile.busy then
		return answer(profile, kind, id, "busy")
	end
	if profile.owned[id] then
		return answer(profile, kind, id, "already_owned")
	end
	local cost = if kind == "buy" then driver.price else driver.rentPrice
	if profile.wallet.Coins < cost then
		return answer(profile, kind, id, "insufficient_funds")
	end
	profile.busy = true
	task.wait(0.4)
	profile.wallet.Coins -= cost
	if kind == "buy" then
		profile.owned[id] = true
		profile.rented[id] = nil
	else
		profile.rented[id] = workspace:GetServerTimeNow() + Drivers.rentSeconds
	end
	profile.busy = false
	publish(player)
	return answer(profile, kind, id, nil)
end

local function equip(player: Player, raw: unknown): Result
	local profile = profileOf(player)
	local id = if type(raw) == "string" then raw else ""
	prune(profile)
	if byId[id] == nil then
		return answer(profile, "equip", id, "unknown_driver")
	end
	if not profile.owned[id] and profile.rented[id] == nil then
		return answer(profile, "equip", id, "not_available")
	end
	profile.equipped = id
	Ledger.setDriver(player, id)
	publish(player)
	return answer(profile, "equip", id, nil)
end

local function getState(player: Player): State
	return snapshot(profileOf(player))
end

local function grant(player: Player, coins: number)
	local profile = profileOf(player)
	profile.wallet.Coins = math.max(0, profile.wallet.Coins + coins)
	publish(player)
end

local function journal(player: Player): { Entry }
	return table.clone(profileOf(player).journal)
end

Players.PlayerRemoving:Connect(function(player)
	profiles[player] = nil
end)

return {
	getState = getState,
	buy = function(player: Player, id: unknown): Result
		return pay(player, id, "buy")
	end,
	rent = function(player: Player, id: unknown): Result
		return pay(player, id, "rent")
	end,
	equip = equip,
	grant = grant,
	journal = journal,
}
]]></string>
        </Properties>
