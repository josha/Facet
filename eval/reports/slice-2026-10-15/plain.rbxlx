        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Codes</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type Currency = "Coins" | "Gems"

export type Reward = {
	kind: "Currency" | "Item",
	name: string,
	amount: number,
}

export type State = {
	wallet: { Coins: number, Gems: number },
	items: { [string]: number },
	redeemed: { string },
}

export type Failure = "empty" | "invalid" | "expired" | "already_redeemed" | "rate_limited" | "busy"

export type RedeemResult = {
	ok: boolean,
	code: string,
	reason: Failure?,
	retryIn: number?,
	rewards: { Reward },
	state: State,
}

export type Client = {
	getState: () -> State,
	redeem: (code: string) -> RedeemResult,
	onStateChanged: (callback: (State) -> ()) -> RBXScriptConnection,
}

local function client(): Client
	assert(RunService:IsClient(), "Codes.client() runs on the client")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local getState = remotes:WaitForChild("GetCodesState") :: RemoteFunction
	local redeem = remotes:WaitForChild("RedeemCode") :: RemoteFunction
	local changed = remotes:WaitForChild("CodesStateChanged") :: RemoteEvent
	return {
		getState = function(): State
			return getState:InvokeServer()
		end,
		redeem = function(code: string): RedeemResult
			return redeem:InvokeServer(code)
		end,
		onStateChanged = function(callback: (State) -> ()): RBXScriptConnection
			return changed.OnClientEvent:Connect(callback)
		end,
	}
end

return {
	client = client,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Crates</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type Rarity = "Common" | "Rare" | "Epic" | "Legendary"

export type Card = { id: string, name: string, rarity: Rarity }

export type Odds = { Common: number, Rare: number, Epic: number, Legendary: number }

export type Crate = { id: string, name: string, price: number, cards: number, odds: Odds }

export type State = {
	gems: number,
	collection: { [string]: number },
}

export type Failure = "insufficient_funds" | "unknown_crate" | "busy"

export type OpenResult = {
	ok: boolean,
	crate: string,
	reason: Failure?,
	cards: { Card },
	state: State,
}

export type Client = {
	crates: { Crate },
	cards: { Card },
	getState: () -> State,
	open: (crateId: string) -> OpenResult,
	onStateChanged: (callback: (State) -> ()) -> RBXScriptConnection,
}

local crates: { Crate } = {
	{
		id = "starter",
		name = "Starter Crate",
		price = 50,
		cards = 3,
		odds = { Common = 70, Rare = 25, Epic = 5, Legendary = 0 },
	},
	{
		id = "veteran",
		name = "Veteran Crate",
		price = 120,
		cards = 4,
		odds = { Common = 45, Rare = 35, Epic = 17, Legendary = 3 },
	},
	{
		id = "legend",
		name = "Legend Crate",
		price = 300,
		cards = 5,
		odds = { Common = 20, Rare = 40, Epic = 30, Legendary = 10 },
	},
}

local cards: { Card } = {
	{ id = "pebble_golem", name = "Pebble Golem", rarity = "Common" },
	{ id = "moss_sprite", name = "Moss Sprite", rarity = "Common" },
	{ id = "dune_beetle", name = "Dune Beetle", rarity = "Common" },
	{ id = "river_otter", name = "River Otter", rarity = "Common" },
	{ id = "frost_fox", name = "Frost Fox", rarity = "Rare" },
	{ id = "ember_hawk", name = "Ember Hawk", rarity = "Rare" },
	{ id = "tide_serpent", name = "Tide Serpent", rarity = "Rare" },
	{ id = "storm_lion", name = "Storm Lion", rarity = "Epic" },
	{ id = "crystal_stag", name = "Crystal Stag", rarity = "Epic" },
	{ id = "sun_dragon", name = "Sun Dragon", rarity = "Legendary" },
	{ id = "moon_whale", name = "Moon Whale", rarity = "Legendary" },
}

local function client(): Client
	assert(RunService:IsClient(), "Crates.client() runs on the client")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local getState = remotes:WaitForChild("GetCrateState") :: RemoteFunction
	local open = remotes:WaitForChild("OpenCrate") :: RemoteFunction
	local changed = remotes:WaitForChild("CrateStateChanged") :: RemoteEvent
	return {
		crates = crates,
		cards = cards,
		getState = function(): State
			return getState:InvokeServer()
		end,
		open = function(crateId: string): OpenResult
			return open:InvokeServer(crateId)
		end,
		onStateChanged = function(callback: (State) -> ()): RBXScriptConnection
			return changed.OnClientEvent:Connect(callback)
		end,
	}
end

return {
	client = client,
	crates = crates,
	cards = cards,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">DailyRewards</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type Reward = {
	kind: "Coins" | "Gems" | "Item",
	name: string,
	amount: number,
}

export type Day = { day: number, reward: Reward }

export type State = {
	track: { Day },
	day: number,
	claimedToday: boolean,
	nextClaimAt: number,
	restarted: boolean,
	wallet: { Coins: number, Gems: number },
	items: { [string]: number },
}

export type Failure = "already_claimed" | "busy"

export type ClaimResult = {
	ok: boolean,
	reason: Failure?,
	reward: Reward?,
	state: State,
}

export type Client = {
	getState: () -> State,
	claim: () -> ClaimResult,
	serverNow: () -> number,
	onStateChanged: (callback: (State) -> ()) -> RBXScriptConnection,
}

local function client(): Client
	assert(RunService:IsClient(), "DailyRewards.client() runs on the client")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local getState = remotes:WaitForChild("GetRewardsState") :: RemoteFunction
	local claim = remotes:WaitForChild("ClaimReward") :: RemoteFunction
	local changed = remotes:WaitForChild("RewardsStateChanged") :: RemoteEvent
	return {
		getState = function(): State
			return getState:InvokeServer()
		end,
		claim = function(): ClaimResult
			return claim:InvokeServer()
		end,
		serverNow = function(): number
			return workspace:GetServerTimeNow()
		end,
		onStateChanged = function(callback: (State) -> ()): RBXScriptConnection
			return changed.OnClientEvent:Connect(callback)
		end,
	}
end

return {
	client = client,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Dialogue</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type Choice = { id: string, text: string }

export type Node = {
	id: string,
	speaker: string,
	text: string,
	choices: { Choice },
	ended: boolean,
}

export type State = {
	nearby: string?,
	node: Node?,
	coins: number,
	questAccepted: boolean,
}

export type Failure = "not_nearby" | "no_conversation" | "unknown_choice" | "busy"

export type Result = {
	ok: boolean,
	reason: Failure?,
	state: State,
}

export type Client = {
	getState: () -> State,
	talk: () -> Result,
	choose: (choiceId: string) -> Result,
	leave: () -> Result,
	onStateChanged: (callback: (State) -> ()) -> RBXScriptConnection,
}

local function client(): Client
	assert(RunService:IsClient(), "Dialogue.client() runs on the client")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local getState = remotes:WaitForChild("GetDialogueState") :: RemoteFunction
	local talk = remotes:WaitForChild("Talk") :: RemoteFunction
	local choose = remotes:WaitForChild("Choose") :: RemoteFunction
	local leave = remotes:WaitForChild("Leave") :: RemoteFunction
	local changed = remotes:WaitForChild("DialogueStateChanged") :: RemoteEvent
	return {
		getState = function(): State
			return getState:InvokeServer()
		end,
		talk = function(): Result
			return talk:InvokeServer()
		end,
		choose = function(choiceId: string): Result
			return choose:InvokeServer(choiceId)
		end,
		leave = function(): Result
			return leave:InvokeServer()
		end,
		onStateChanged = function(callback: (State) -> ()): RBXScriptConnection
			return changed.OnClientEvent:Connect(callback)
		end,
	}
end

return {
	client = client,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Drivers</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary"

export type Driver = {
	id: string,
	name: string,
	series: "Circuit" | "Rally",
	rarity: Rarity,
	price: number,
	rentPrice: number,
	strength: number,
	speed: number,
	durability: number,
}

export type State = {
	coins: number,
	owned: { [string]: boolean },
	rented: { [string]: number },
	equipped: string?,
}

export type Failure = "insufficient_funds" | "already_owned" | "not_available" | "unknown_driver" | "busy"

export type Result = { ok: boolean, reason: Failure?, state: State }

export type Client = {
	drivers: { Driver },
	rentSeconds: number,
	getState: () -> State,
	buy: (driverId: string) -> Result,
	rent: (driverId: string) -> Result,
	equip: (driverId: string) -> Result,
	serverNow: () -> number,
	onStateChanged: (callback: (State) -> ()) -> RBXScriptConnection,
}

local drivers: { Driver } = {
	{
		id = "kira",
		name = "Kira",
		series = "Circuit",
		rarity = "Legendary",
		price = 900,
		rentPrice = 90,
		strength = 92,
		speed = 80,
		durability = 70,
	},
	{
		id = "ren",
		name = "Ren",
		series = "Circuit",
