		category = "Circuit",
		rarity = "Rare",
		level = 6,
		speed = 80,
		armor = 25,
		firepower = 20,
		controls = LAND,
	},
	{
		id = "iron_kart",
		name = "Iron Kart",
		category = "Circuit",
		rarity = "Epic",
		level = 12,
		speed = 30,
		armor = 95,
		firepower = 85,
		controls = LAND,
	},
	{
		id = "rail_kart",
		name = "Rail Kart",
		category = "Circuit",
		rarity = "Legendary",
		level = 19,
		speed = 25,
		armor = 70,
		firepower = 100,
		controls = LAND,
	},
	{
		id = "coast_kart",
		name = "Coast Kart",
		category = "Coast",
		rarity = "Common",
		level = 2,
		speed = 50,
		armor = 10,
