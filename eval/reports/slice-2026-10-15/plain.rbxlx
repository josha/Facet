      <Item class="ModuleScript" referent="77">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Ledger = require(script.Parent.Ledger)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Hub.Economy)

type State = Economy.State
type Result = Economy.Result

export type Entry = { kind: string, ok: boolean, reason: Economy.Failure?, at: number }

type Profile = {
	wallet: Ledger.Wallet,

	earned: number,
	boostEndsAt: number?,
	boosts: number,
	quests: { Economy.Quest },
	offer: Economy.Offer,
	journal: { Entry },
}

local BASE_INCOME = 5
local BOOST_PRICE = 10
local BOOST_SECONDS = 30
local ZONE_GOAL = 5000
local OFFER_SECONDS = 25 * 60

local changed = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("EconomyStateChanged") :: RemoteEvent
local profiles: { [Player]: Profile } = {}
local paused = false

local function profileOf(player: Player): Profile
	local profile = profiles[player]
	if profile == nil then
		local created: Profile = {
			wallet = Ledger.wallet(player),

			earned = 1180,
			boostEndsAt = nil,
			boosts = 0,
			quests = {
				{
					id = "earn_small",
					title = "Earn 1,200 Coins",
					goal = 1200,
					progress = 0,
					reward = 5,
					claimed = false,
				},
				{
					id = "earn_big",
					title = "Earn 10,000 Coins",
					goal = 10000,
					progress = 0,
					reward = 25,
					claimed = false,
				},
				{ id = "boost", title = "Buy a 2x Coins boost", goal = 1, progress = 0, reward = 10, claimed = false },
			},
			offer = {
				name = "Starter Offer",
				coins = 5000,
				price = 99,
				endsAt = workspace:GetServerTimeNow() + OFFER_SECONDS,
				bought = false,
			},
			journal = {},
		}
		profiles[player] = created
		return created
	end
	return profile
end

local function boosted(profile: Profile): boolean
	return profile.boostEndsAt ~= nil and (profile.boostEndsAt :: number) > workspace:GetServerTimeNow()
end

local function refresh(profile: Profile)
	for _, quest in profile.quests do
		if quest.id == "boost" then
			quest.progress = math.min(quest.goal, profile.boosts)
		else
			quest.progress = math.min(quest.goal, profile.earned)
		end
	end
	if not boosted(profile) then
		profile.boostEndsAt = nil
	end
end

local function snapshot(profile: Profile): State
	refresh(profile)
	local quests: { Economy.Quest } = {}
	for _, quest in profile.quests do
		table.insert(quests, table.clone(quest))
	end
	return {
		coins = profile.wallet.Coins,
		gems = profile.wallet.Gems,
		perSecond = if boosted(profile) then BASE_INCOME * 2 else BASE_INCOME,
		boostEndsAt = profile.boostEndsAt,
		boostPrice = BOOST_PRICE,
		zone = 2,
		zoneProgress = math.min(ZONE_GOAL, profile.earned),
		zoneGoal = ZONE_GOAL,
		quests = quests,
		offer = table.clone(profile.offer),
	}
end

local function publish(player: Player)
	changed:FireClient(player, snapshot(profileOf(player)))
end

local function answer(profile: Profile, kind: string, reason: Economy.Failure?): Result
	table.insert(profile.journal, { kind = kind, ok = reason == nil, reason = reason, at = os.clock() })
	return { ok = reason == nil, reason = reason, state = snapshot(profile) }
end

local function earn(profile: Profile, amount: number)
	profile.wallet.Coins += amount
	profile.earned += amount
end

local function buyBoost(player: Player): Result
	local profile = profileOf(player)
	if boosted(profile) then
		return answer(profile, "boost", "already_active")
	end
	if profile.wallet.Gems < BOOST_PRICE then
		return answer(profile, "boost", "insufficient_funds")
	end
	profile.wallet.Gems -= BOOST_PRICE
	profile.boosts += 1
	profile.boostEndsAt = workspace:GetServerTimeNow() + BOOST_SECONDS
	publish(player)
	return answer(profile, "boost", nil)
end

local function claimQuest(player: Player, questId: unknown): Result
	local profile = profileOf(player)
	refresh(profile)
	for _, quest in profile.quests do
		if quest.id == questId then
			if quest.claimed then
				return answer(profile, "quest", "already_claimed")
			end
			if quest.progress < quest.goal then
				return answer(profile, "quest", "not_complete")
			end
			quest.claimed = true
			profile.wallet.Gems += quest.reward
			publish(player)
			return answer(profile, "quest", nil)
		end
	end
	return answer(profile, "quest", "unknown_quest")
end

local function buyOffer(player: Player): Result
	local profile = profileOf(player)
	local offer = profile.offer
	if offer.bought then
		return answer(profile, "offer", "already_bought")
	end
	if workspace:GetServerTimeNow() >= offer.endsAt then
		return answer(profile, "offer", "expired")
	end
	if profile.wallet.Gems < offer.price then
		return answer(profile, "offer", "insufficient_funds")
	end
	profile.wallet.Gems -= offer.price
	offer.bought = true
	earn(profile, offer.coins)
	publish(player)
	return answer(profile, "offer", nil)
end

local function start()
	task.spawn(function()
		while true do
			task.wait(1)
			if not paused then
				for player, profile in profiles do
					earn(profile, if boosted(profile) then BASE_INCOME * 2 else BASE_INCOME)
					publish(player)
				end
			end
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		profileOf(player)
	end)
	for _, player in Players:GetPlayers() do
		profileOf(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		profiles[player] = nil
	end)
end

return {
	start = start,
	getState = function(player: Player): State
		return snapshot(profileOf(player))
	end,
	buyBoost = buyBoost,
	claimQuest = claimQuest,
	buyOffer = buyOffer,
	setPaused = function(value: boolean)
		paused = value
	end,
	grant = function(player: Player, coins: number, gems: number)
		local profile = profileOf(player)
		earn(profile, coins)
		profile.wallet.Gems += gems
		publish(player)
	end,
	journal = function(player: Player): { Entry }
		return table.clone(profileOf(player).journal)
	end,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="78">
        <Properties>
          <string name="Name">GarageService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Ledger = require(script.Parent.Ledger)
local Garage = require(ReplicatedStorage.Shared.Hub.Garage)

type State = Garage.State
type Result = Garage.Result

export type Entry = { kind: string, vehicle: string?, ok: boolean, reason: Garage.Failure?, at: number }

type Profile = {
	favorites: { [string]: boolean },
	spawned: string?,
	busy: boolean,
	journal: { Entry },
}

local profiles: { [Player]: Profile } = {}
local changed = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GarageStateChanged") :: RemoteEvent

local known: { [string]: boolean } = {}
for _, vehicle in Garage.vehicles do
	known[vehicle.id] = true
end

local function profileOf(player: Player): Profile
	local profile = profiles[player]
	if profile == nil then
		local created: Profile = { favorites = { summit_kart = true }, spawned = nil, busy = false, journal = {} }
		profiles[player] = created
		return created
	end
	return profile
end

local function snapshot(profile: Profile): State
	return { favorites = table.clone(profile.favorites), spawned = profile.spawned }
end

local function publish(player: Player)
	changed:FireClient(player, snapshot(profileOf(player)))
end

local function answer(profile: Profile, kind: string, vehicle: string?, reason: Garage.Failure?): Result
	table.insert(
		profile.journal,
		{ kind = kind, vehicle = vehicle, ok = reason == nil, reason = reason, at = os.clock() }
	)
	return { ok = reason == nil, reason = reason, state = snapshot(profile) }
end

local function getState(player: Player): State
	return snapshot(profileOf(player))
end

local function spawnVehicle(player: Player, vehicleId: unknown): Result
	local profile = profileOf(player)
	local id = if type(vehicleId) == "string" then vehicleId else ""
	if not known[id] then
		return answer(profile, "spawn", id, "unknown_vehicle")
	end
	if profile.busy then
		return answer(profile, "spawn", id, "busy")
	end
	if profile.spawned ~= nil then
		return answer(profile, "spawn", id, "already_spawned")
	end
	profile.busy = true
	task.wait(0.4)
	profile.spawned = id
	Ledger.setKart(player, id)
	profile.busy = false
	publish(player)
	return answer(profile, "spawn", id, nil)
end

local function exitVehicle(player: Player): Result
	local profile = profileOf(player)
	if profile.spawned == nil then
		return answer(profile, "exit", nil, "nothing_spawned")
	end
	local id = profile.spawned
	profile.spawned = nil
	publish(player)
	return answer(profile, "exit", id, nil)
end

local function setFavorite(player: Player, vehicleId: unknown, favorite: unknown): Result
	local profile = profileOf(player)
	local id = if type(vehicleId) == "string" then vehicleId else ""
	if not known[id] then
		return answer(profile, "favorite", id, "unknown_vehicle")
	end
	if favorite == true then
		profile.favorites[id] = true
	else
		profile.favorites[id] = nil
	end
	publish(player)
	return answer(profile, "favorite", id, nil)
end

local function journal(player: Player): { Entry }
	return table.clone(profileOf(player).journal)
end

Players.PlayerRemoving:Connect(function(player)
	profiles[player] = nil
end)

return {
	getState = getState,
	spawn = spawnVehicle,
	exit = exitVehicle,
	setFavorite = setFavorite,
	journal = journal,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="79">
        <Properties>
          <string name="Name">InventoryService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Inventory = require(ReplicatedStorage.Shared.Hub.Inventory)

type State = Inventory.State
type Result = Inventory.Result
type Slot = Inventory.Slot

export type Entry = { kind: string, item: string?, ok: boolean, reason: string?, at: number }

type Profile = {
	owned: { string },
	equipped: { [Slot]: string },
	journal: { Entry },
}

local STARTING_ITEMS = {
	"starter_motor",
	"frost_motor",
	"ember_motor",
	"light_body",
	"steel_body",
	"city_wheels",
	"snow_wheels",
	"spark_trail",
	"galaxy_trail",
}

local profiles: { [Player]: Profile } = {}
local changed = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("InventoryChanged") :: RemoteEvent

local function fresh(): Profile
	return {
		owned = table.clone(STARTING_ITEMS),
		equipped = { Motor = "starter_motor", Body = "light_body", Wheels = "city_wheels" },
		journal = {},
	}
end

local function profileOf(player: Player): Profile
	local profile = profiles[player]
	if profile == nil then
		local created = fresh()
		profiles[player] = created
		return created
	end
	return profile
end

local function snapshot(profile: Profile): State
	return { owned = table.clone(profile.owned), equipped = table.clone(profile.equipped) }
end

local function publish(player: Player)
	changed:FireClient(player, snapshot(profileOf(player)))
end

local function record(profile: Profile, kind: string, item: string?, ok: boolean, reason: string?)
	table.insert(profile.journal, { kind = kind, item = item, ok = ok, reason = reason, at = os.clock() })
end

local function getState(player: Player): State
	return snapshot(profileOf(player))
end

local function equip(player: Player, itemId: unknown): Result
	local profile = profileOf(player)
	local id = if type(itemId) == "string" then itemId else ""
	local definition = Inventory.byId[id]
	if definition == nil then
		record(profile, "equip", id, false, "unknown_item")
		return { ok = false, reason = "unknown_item", state = snapshot(profile) }
	end
	if table.find(profile.owned, id) == nil then
		record(profile, "equip", id, false, "not_owned")
		return { ok = false, reason = "not_owned", state = snapshot(profile) }
	end
	profile.equipped[definition.slot] = id
	record(profile, "equip", id, true, nil)
	publish(player)
	return { ok = true, reason = nil, state = snapshot(profile) }
end

local function unequip(player: Player, slot: unknown): Result
	local profile = profileOf(player)
	local name = if type(slot) == "string" then slot else ""
	if table.find(Inventory.slots, name :: Slot) == nil or profile.equipped[name :: Slot] == nil then
		record(profile, "unequip", name, false, "empty_slot")
		return { ok = false, reason = "empty_slot", state = snapshot(profile) }
	end
	profile.equipped[name :: Slot] = nil
	record(profile, "unequip", name, true, nil)
	publish(player)
	return { ok = true, reason = nil, state = snapshot(profile) }
end

local function give(player: Player, itemId: string): boolean
	local profile = profileOf(player)
	if Inventory.byId[itemId] == nil or table.find(profile.owned, itemId) ~= nil then
		return false
	end
	table.insert(profile.owned, itemId)
	record(profile, "give", itemId, true, nil)
	publish(player)
	return true
end

local function journal(player: Player): { Entry }
	return table.clone(profileOf(player).journal)
end

Players.PlayerRemoving:Connect(function(player)
	profiles[player] = nil
end)

return {
	getState = getState,
	equip = equip,
	unequip = unequip,
	give = give,
	journal = journal,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="80">
        <Properties>
          <string name="Name">Kart</string>
          <string name="Source"><![CDATA[--!strict

export type Kart = { model: Model, seat: VehicleSeat }
local Kart = {}

function Kart.create(name: string, color: Color3, frame: CFrame, kinematic: boolean): Kart
	local model = Instance.new("Model")
	model.Name = name
	local function part(label: string, size: Vector3, offset: CFrame, tint: Color3): Part
		local object = Instance.new("Part")
		object.Name = label
		object.Size = size
		object.CFrame = frame * offset
		object.Color = tint
		object.Anchored = kinematic
		object.CanCollide = not kinematic
		object.TopSurface = Enum.SurfaceType.Smooth
		object.BottomSurface = Enum.SurfaceType.Smooth
		object.Parent = model
		return object
	end
	local body = part("Chassis", Vector3.new(5, 0.7, 7), CFrame.new(0, 1, 0), color)
	body.RootPriority = 127
	body.CustomPhysicalProperties = PhysicalProperties.new(1, 0.15, 0, 100, 100)
	model.PrimaryPart = body
	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 0.7, 2)
	seat.CFrame = frame * CFrame.new(0, 1.8, 0.6)
	seat.Color = Color3.fromRGB(42, 49, 64)
	seat.Anchored = kinematic
	seat.CanCollide = false
	seat.HeadsUpDisplay = not kinematic
	seat.Parent = model
	local function weld(object: BasePart)
		local joint = Instance.new("WeldConstraint")
		joint.Part0 = body
		joint.Part1 = object
		joint.Parent = object
	end
	weld(seat)
	weld(part("Nose", Vector3.new(3, 1, 2), CFrame.new(0, 1.8, -2.4), color))
	weld(part("Spoiler", Vector3.new(6, 0.4, 1), CFrame.new(0, 2.4, 3), color))
	for _, x in { -3.2, 3.2 } do
		for _, z in { -2, 2 } do
			local wheel = part("Wheel", Vector3.new(1.2, 2, 2), CFrame.new(x, 0.5, z), Color3.fromRGB(34, 40, 53))
			wheel.Shape = Enum.PartType.Cylinder
			wheel.CustomPhysicalProperties = PhysicalProperties.new(0.5, 0.15, 0, 100, 100)
			if kinematic then
				weld(wheel)
			else
				local axle = Instance.new("Attachment")
				axle.Position = Vector3.new(x, -0.5, z)
				axle.Parent = body
				local hub = Instance.new("Attachment")
				hub.Parent = wheel
				local hinge = Instance.new("HingeConstraint")
				hinge.Attachment0 = axle
				hinge.Attachment1 = hub
				hinge.Parent = body
			end
		end
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "DriveAttachment"
	attachment.Parent = body
	local drive = Instance.new("LinearVelocity")
	drive.Name = "Drive"
	drive.Attachment0 = attachment
	drive.RelativeTo = Enum.ActuatorRelativeTo.World
	drive.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	drive.PrimaryTangentAxis = Vector3.xAxis
	drive.SecondaryTangentAxis = Vector3.zAxis
	drive.MaxForce = 18000
	drive.Enabled = not kinematic
	drive.Parent = body
	local turn = Instance.new("AngularVelocity")
	turn.Name = "Turn"
	turn.Attachment0 = attachment
	turn.RelativeTo = Enum.ActuatorRelativeTo.World
	turn.MaxTorque = 12000
	turn.Enabled = not kinematic
	turn.Parent = body
	local uprightAxis = Instance.new("Attachment")
	uprightAxis.Axis = Vector3.yAxis
	uprightAxis.SecondaryAxis = Vector3.xAxis
	uprightAxis.Parent = body
	local upright = Instance.new("AlignOrientation")
	upright.Attachment0 = uprightAxis
	upright.Mode = Enum.OrientationAlignmentMode.OneAttachment
	upright.AlignType = Enum.AlignType.PrimaryAxisParallel
	upright.CFrame = CFrame.Angles(0, 0, math.pi / 2)
	upright.MaxTorque = 100000
	upright.Responsiveness = 15
	upright.Enabled = not kinematic
	upright.Parent = body
	model.Parent = workspace
	return { model = model, seat = seat }
end

return Kart
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="81">
        <Properties>
          <string name="Name">Ledger</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

export type Wallet = { Coins: number, Gems: number }
export type Progress = { xp: number, level: number, races: number, crates: number, kart: string, driver: string }
type Profile = { wallet: Wallet, progress: Progress, rewarded: number }
local profiles: { [Player]: Profile } = {}

local function profileOf(player: Player): Profile
	local profile = profiles[player]
	if profile == nil then
		profile = {
			wallet = { Coins = 320, Gems = 40 },
			progress = { xp = 0, level = 1, races = 0, crates = 0, kart = "rookie_kart", driver = "haru" },
			rewarded = 0,
		}
		profiles[player] = profile
	end
	return profile
end

Players.PlayerRemoving:Connect(function(player)
	profiles[player] = nil
end)

return {
	wallet = function(player: Player): Wallet
		return profileOf(player).wallet
	end,
	progress = function(player: Player): Progress
		return table.clone(profileOf(player).progress)
	end,
	setKart = function(player: Player, id: string)
		profileOf(player).progress.kart = id
	end,
	setDriver = function(player: Player, id: string)
		profileOf(player).progress.driver = id
	end,
	addCrate = function(player: Player)
		profileOf(player).progress.crates += 1
	end,
	consumeCrate = function(player: Player): boolean
		local progress = profileOf(player).progress
		if progress.crates < 1 then
			return false
		end
		progress.crates -= 1
		return true
	end,
	reward = function(player: Player, round: number, coins: number)
		local profile = profileOf(player)
		if round <= profile.rewarded then
			return
		end
		profile.rewarded = round
		profile.wallet.Coins += coins
		profile.wallet.Gems += 5
		profile.progress.xp += 120
		profile.progress.level = 1 + profile.progress.xp // 100
		profile.progress.races += 1
	end,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="82">
        <Properties>
          <string name="Name">QueueService</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Lobby = require(ReplicatedStorage.Shared.Hub.Lobby)

type State = Lobby.State
type Result = Lobby.Result

export type Entry = { kind: string, mode: string?, ok: boolean, reason: Lobby.Failure?, at: number }

local COUNTDOWN = 10
local STARTING = 6
local BOT_INTERVAL = 4

local changed = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("LobbyStateChanged") :: RemoteEvent

local state: State = { phase = "Lobby", mode = nil, players = 0, needed = 0, countdownEndsAt = nil }
local bots = 0
local automatic = true
local lastBot = 0
local startedAt = 0
local journal: { Entry } = {}

local function snapshot(): State
	return {
		phase = state.phase,
		mode = state.mode,
		players = state.players,
		needed = state.needed,
		countdownEndsAt = state.countdownEndsAt,
	}
end

local function publish()
	changed:FireAllClients(snapshot())
end

local function modeOf(id: unknown): Lobby.Mode?
	for _, mode in Lobby.modes do
		if mode.id == id then
			return mode
		end
	end
	return nil
end

local function recount()
	if state.phase ~= "Queue" and state.phase ~= "Countdown" then
		return
	end
	state.players = math.min(state.needed, 1 + bots)
	if state.players >= state.needed and state.phase == "Queue" then
		state.phase = "Countdown"
		state.countdownEndsAt = workspace:GetServerTimeNow() + COUNTDOWN
	elseif state.players < state.needed and state.phase == "Countdown" then
		state.phase = "Queue"
		state.countdownEndsAt = nil
	end
	publish()
end

local function answer(kind: string, mode: string?, reason: Lobby.Failure?): Result
	table.insert(journal, { kind = kind, mode = mode, ok = reason == nil, reason = reason, at = os.clock() })
	return { ok = reason == nil, reason = reason, state = snapshot() }
end

local function join(_player: Player, modeId: unknown): Result
	local mode = modeOf(modeId)
	if mode == nil then
		return answer("join", tostring(modeId), "unknown_mode")
	end
	if state.phase == "Starting" then
		return answer("join", (mode :: Lobby.Mode).id, "starting")
	end
	if state.phase ~= "Lobby" then
		return answer("join", (mode :: Lobby.Mode).id, "already_queued")
	end
	state.phase = "Queue"
	state.mode = (mode :: Lobby.Mode).id
	state.needed = (mode :: Lobby.Mode).players
	bots = 0
	lastBot = os.clock()
	recount()
	return answer("join", state.mode, nil)
end

local function leave(_player: Player): Result
	if state.phase ~= "Queue" and state.phase ~= "Countdown" then
		return answer("leave", nil, "not_queued")
	end
	state.phase = "Lobby"
	state.mode = nil
	state.players = 0
	state.needed = 0
	state.countdownEndsAt = nil
	bots = 0
	publish()
	return answer("leave", nil, nil)
end

local function addBots(count: number)
	bots = math.max(0, bots + count)
	recount()
end

local function tick()
	local now = workspace:GetServerTimeNow()
	if state.phase == "Queue" and automatic and os.clock() - lastBot >= BOT_INTERVAL then
		lastBot = os.clock()
		addBots(1)
	elseif state.phase == "Countdown" and state.countdownEndsAt ~= nil and now >= state.countdownEndsAt then
		state.phase = "Starting"
		state.countdownEndsAt = nil
		startedAt = os.clock()
		publish()
	elseif state.phase == "Starting" and os.clock() - startedAt >= STARTING then
		state.phase = "Lobby"
		state.mode = nil
		state.players = 0
		state.needed = 0
		bots = 0
		publish()
	end
end

local function start()
	task.spawn(function()
		while true do
			tick()
			task.wait(0.25)
		end
	end)
end

return {
	start = start,
	snapshot = snapshot,
	join = join,
	leave = leave,
	addBots = addBots,
	finishCountdown = function()
		if state.phase == "Countdown" then
			state.countdownEndsAt = workspace:GetServerTimeNow()
		end
	end,
	setAutomatic = function(value: boolean)
		automatic = value
	end,
	journal = function(): { Entry }
		return table.clone(journal)
	end,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="83">
        <Properties>
          <string name="Name">RaceService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Track = require(game:GetService("ReplicatedStorage").Shared.RaceTrack)
local Rules = require(game:GetService("ReplicatedStorage").Shared.RaceRules)
local Round = require(game:GetService("ReplicatedStorage").Shared.Hub.Round)
local Kart = require(script.Parent.Kart)

type Racer = {
	name: string,
	team: Round.Team,
	kart: Kart.Kart,
	player: Player?,
	progress: number,
	startProgress: number,
	checkpoint: number,
	lap: number,
	finish: number,
	speed: number,
	lane: number,
	out: boolean,
}
local racers: { Racer } = {}
local ordered: { Racer } = {}
local names: { string } = {}
local active = false
local manual = false
local elapsed = 0
local accumulator = 0
local measuredSeconds = 0
local measuredSteps = 0
local measuredCost = 0
local measuredMax = 0
local reseatAt = 0
local complete: () -> () = function() end
local palette = {
	Color3.fromRGB(255, 190, 65),
	Color3.fromRGB(240, 90, 95),
	Color3.fromRGB(73, 180, 225),
	Color3.fromRGB(178, 112, 225),
	Color3.fromRGB(80, 210, 145),
	Color3.fromRGB(255, 145, 70),
	Color3.fromRGB(238, 120, 190),
	Color3.fromRGB(235, 225, 110),
}

local function markOut(name: string)
	for _, racer in racers do
		if racer.name == name then
			racer.out = true
			for _, object in racer.kart.model:GetDescendants() do
				if object:IsA("BasePart") then
					object.Anchored = true
				end
			end
			return
		end
	end
end

local function stop()
	active = false
	for _, racer in racers do
		local player = racer.player
		if player then
			player:SetAttribute("Racing", false)
			local character = player.Character
			local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
			if humanoid then
				humanoid.Sit = false
				humanoid.Jump = false
			end
		end
		racer.kart.model:Destroy()
		if player and player.Character then
			player.Character:PivotTo(CFrame.lookAt(Vector3.new(0, 5, 0), Vector3.new(0, 5, -100)))
			local root = player.Character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end
	table.clear(racers)
	table.clear(ordered)
end

local function start(fighters: { Round.Fighter }, scenario: boolean, onComplete: () -> ())
	stop()
	manual = scenario
	complete = onComplete
	elapsed = 0
	accumulator = 0
	reseatAt = 0
	table.clear(names)
	for index, fighter in fighters do
		local player = Players:FindFirstChild(fighter.name)
		local driver = if player and player:IsA("Player") then player else nil
		local lane = if index % 2 == 0 then -5 else 5
		local progress = 0.05 - math.floor((index - 1) / 2) * 0.012
		local kart = Kart.create(
			fighter.name .. "Kart",
			palette[(index - 1) % #palette + 1],
			Track.frame(progress, lane),
			driver == nil or manual
		)
		local racer: Racer = {
			name = fighter.name,
			team = fighter.team,
			kart = kart,
			player = driver,
			progress = progress,
			startProgress = progress,
			checkpoint = 0,
			lap = 0,
			finish = math.huge,
			speed = 0.047 + index * 0.0007,
			lane = lane,
			out = false,
		}
		table.insert(racers, racer)
		table.insert(ordered, racer)
		if driver then
			driver:SetAttribute("Racing", true)
			driver:SetAttribute("RaceAutopilot", manual)
			local character = driver.Character
			local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
			if humanoid then
				if character then
					character:PivotTo(kart.seat.CFrame * CFrame.new(0, 2, 0))
				end
				kart.seat:Sit(humanoid)
			end
			if not manual and kart.model.PrimaryPart then
				kart.model.PrimaryPart:SetNetworkOwner(driver)
			end
			local progressData = require(script.Parent.Ledger).progress(driver)
			kart.model:SetAttribute("KartId", progressData.kart)
			kart.model:SetAttribute("DriverId", progressData.driver)
		end
	end
	for index, racer in ordered do
		names[index] = if racer.player then "You" else racer.name
	end
	active = true
end

RunService.Heartbeat:Connect(function(dt: number)
	if not active then
		return
	end
	accumulator += dt
	if accumulator < 1 / 30 then
		return
	end
	debug.profilebegin("SunfieldRaceStep")
	local stepStarted = os.clock()
	measuredSeconds += accumulator
	elapsed += accumulator
	accumulator = 0
	local reseat = elapsed >= reseatAt
	if reseat then
		reseatAt = elapsed + 0.5
	end
	local finished = 0
	for _, racer in racers do
		if racer.out then
			finished += 1
			continue
		end
		if reseat and racer.player then
			local character = racer.player.Character
			local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
			if humanoid and humanoid.SeatPart ~= racer.kart.seat then
				if character then
					character:PivotTo(racer.kart.seat.CFrame * CFrame.new(0, 2, 0))
				end
				racer.kart.seat:Sit(humanoid)
			end
		end
		if racer.player == nil or manual then
			racer.progress = math.min(Track.laps, elapsed * racer.speed + racer.startProgress)
			local lap = math.floor(racer.progress)
			racer.lap = lap
			racer.checkpoint = math.floor(racer.progress % 1 * Track.checkpoints)
			racer.kart.model:PivotTo(Track.frame(racer.progress % 1, racer.lane) * CFrame.new(0, 1, 0))
		else
			local root = racer.kart.model.PrimaryPart
			if root then
				local t = Track.progress(root.Position)
				local onRoad = (root.Position - Track.point(t)).Magnitude < Track.width / 2 + 5
				Rules.advance(racer, t, onRoad, Track.checkpoints)
				root:SetAttribute("Lap", math.min(Track.laps, racer.lap + 1))
				root:SetAttribute("Checkpoint", racer.checkpoint)
				root:SetAttribute("RaceProgress", racer.progress)
				if root.Position.Y < -10 or (root.Position - Track.point(t)).Magnitude > 60 then
					racer.kart.model:PivotTo(
						Track.frame(racer.checkpoint / Track.checkpoints, racer.lane) * CFrame.new(0, 3, 0)
					)
					root.AssemblyLinearVelocity = Vector3.zero
				end
			end
		end
		if racer.progress >= Track.laps and racer.finish == math.huge then
			racer.finish = if racer.player == nil or manual
				then (Track.laps - racer.startProgress) / racer.speed
				else elapsed
		end
		if racer.finish ~= math.huge then
			finished += 1
		end
	end
	table.sort(ordered, Rules.ahead)
	for index, racer in ordered do
		names[index] = if racer.player then "You" else racer.name
	end
	if not manual and finished == #racers then
		complete()
	end
	local cost = os.clock() - stepStarted
	measuredCost += cost
	measuredMax = math.max(measuredMax, cost)
	measuredSteps += 1
	if measuredSeconds >= 1 then
		workspace:SetAttribute("RaceStepMeanUs", measuredCost / measuredSteps * 1e6)
		workspace:SetAttribute("RaceStepMaxUs", measuredMax * 1e6)
		workspace:SetAttribute("RaceStepHz", measuredSteps / measuredSeconds)
		measuredSeconds, measuredSteps, measuredCost, measuredMax = 0, 0, 0, 0
	end
	debug.profileend()
end)

return {
	start = start,
	stop = stop,
	positions = function(): { string }
		return names
	end,
	winner = function(): Round.Team | "Draw"
		return if ordered[1] then ordered[1].team else "Draw"
	end,
	setManual = function(value: boolean)
		manual = value
	end,
	markOut = markOut,
	laps = function(name: string): number
		for _, racer in racers do
			if racer.name == name then
				return racer.lap
			end
		end
		return 0
	end,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="84">
        <Properties>
          <string name="Name">RewardService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Ledger = require(script.Parent.Ledger)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DailyRewards = require(ReplicatedStorage.Shared.Hub.DailyRewards)

type State = DailyRewards.State
type Reward = DailyRewards.Reward

export type Entry = { kind: string, day: number, ok: boolean, reason: string?, at: number }

type Profile = {
	day: number,
	claimedToday: boolean,
	nextClaimAt: number,
	restarted: boolean,
	wallet: { Coins: number, Gems: number },
	items: { [string]: number },
	busy: boolean,
	journal: { Entry },
}

local TRACK: { DailyRewards.Day } = {
	{ day = 1, reward = { kind = "Coins", name = "Coins", amount = 100 } },
	{ day = 2, reward = { kind = "Coins", name = "Coins", amount = 150 } },
	{ day = 3, reward = { kind = "Gems", name = "Gems", amount = 5 } },
	{ day = 4, reward = { kind = "Coins", name = "Coins", amount = 300 } },
	{ day = 5, reward = { kind = "Gems", name = "Gems", amount = 10 } },
	{ day = 6, reward = { kind = "Item", name = "Speed Potion", amount = 3 } },
	{ day = 7, reward = { kind = "Item", name = "Legendary Crate", amount = 1 } },
}

local COOLDOWN = 6 * 3600
local SERVER_DELAY = 0.3

local profiles: { [Player]: Profile } = {}
local changed = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("RewardsStateChanged") :: RemoteEvent

local function profileOf(player: Player): Profile
	local profile = profiles[player]
	if profile == nil then
		local created: Profile = {
			day = 3,
			claimedToday = false,
			nextClaimAt = 0,
			restarted = false,
			wallet = Ledger.wallet(player),
			items = {},
			busy = false,
			journal = {},
		}
		profiles[player] = created
		return created
	end
	return profile
end

local function snapshot(profile: Profile): State
	local track: { DailyRewards.Day } = {}
	for _, entry in TRACK do
		table.insert(track, { day = entry.day, reward = table.clone(entry.reward) })
	end
	return {
		track = track,
		day = profile.day,
		claimedToday = profile.claimedToday,
		nextClaimAt = profile.nextClaimAt,
		restarted = profile.restarted,
		wallet = { Coins = profile.wallet.Coins, Gems = profile.wallet.Gems },
		items = table.clone(profile.items),
	}
end

local function publish(player: Player)
	changed:FireClient(player, snapshot(profileOf(player)))
end

local function getState(player: Player): State
	return snapshot(profileOf(player))
end

local function claim(player: Player): DailyRewards.ClaimResult
	local profile = profileOf(player)
	if profile.busy then
		return { ok = false, reason = "busy", reward = nil, state = snapshot(profile) }
	end
	if profile.claimedToday then
		table.insert(
			profile.journal,
			{ kind = "claim", day = profile.day, ok = false, reason = "already_claimed", at = os.clock() }
		)
		return { ok = false, reason = "already_claimed", reward = nil, state = snapshot(profile) }
	end
	profile.busy = true
	task.wait(SERVER_DELAY)
	local reward = TRACK[profile.day].reward
	if reward.kind == "Coins" then
		profile.wallet.Coins += reward.amount
	elseif reward.kind == "Gems" then
		profile.wallet.Gems += reward.amount
	else
		profile.items[reward.name] = (profile.items[reward.name] or 0) + reward.amount
	end
	profile.claimedToday = true
	profile.restarted = false
	profile.nextClaimAt = workspace:GetServerTimeNow() + COOLDOWN
	profile.busy = false
	table.insert(profile.journal, { kind = "claim", day = profile.day, ok = true, reason = nil, at = os.clock() })
	publish(player)
	return { ok = true, reason = nil, reward = table.clone(reward), state = snapshot(profile) }
end

local function advance(player: Player)
	local profile = profileOf(player)
	profile.day = if profile.claimedToday then profile.day % #TRACK + 1 else profile.day
	profile.claimedToday = false
	profile.nextClaimAt = 0
	profile.restarted = false
	table.insert(profile.journal, { kind = "advance", day = profile.day, ok = true, reason = nil, at = os.clock() })
	publish(player)
end

local function miss(player: Player)
	local profile = profileOf(player)
	profile.day = 1
	profile.claimedToday = false
	profile.nextClaimAt = 0
	profile.restarted = true
	table.insert(profile.journal, { kind = "miss", day = 1, ok = true, reason = nil, at = os.clock() })
	publish(player)
end

local function journal(player: Player): { Entry }
	return table.clone(profileOf(player).journal)
end

Players.PlayerRemoving:Connect(function(player)
	profiles[player] = nil
end)

return {
	getState = getState,
	claim = claim,
	advance = advance,
	miss = miss,
	journal = journal,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="85">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Ledger = require(script.Parent.Ledger)
local RaceService = require(script.Parent.RaceService)
local Round = require(ReplicatedStorage.Shared.Hub.Round)

type State = Round.State
type Fighter = Round.Fighter
type Phase = Round.Phase

local function duration(phase: Phase): number
	return if phase == "Round" then 90 elseif phase == "Results" then 10 else 20
end
local BOTS: { { name: string, team: Round.Team } } = {
	{ name = "Nova", team = "Red" },
	{ name = "Pip", team = "Red" },
	{ name = "Rook", team = "Red" },
	{ name = "Zed", team = "Blue" },
	{ name = "Ivy", team = "Blue" },
	{ name = "Bolt", team = "Blue" },
	{ name = "Moss", team = "Blue" },
}
local WIN_REWARD = 50
local LOSS_REWARD = 20

local changed = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("RoundStateChanged") :: RemoteEvent
local event = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("RoundEvent") :: RemoteEvent

local state: State = {
	round = 1,
	phase = "Intermission",
	endsAt = workspace:GetServerTimeNow() + duration("Intermission"),
	fighters = {},
	winner = nil,
	rewards = nil,
}
local automatic = true
local raceComplete = false
local log: { Round.Event } = {}

for _, bot in BOTS do
	table.insert(state.fighters, { name = bot.name, team = bot.team, eliminated = false, eliminations = 0 })
end

local function snapshot(): State
	local fighters: { Fighter } = {}
	for _, fighter in state.fighters do
		table.insert(fighters, table.clone(fighter))
	end
	return {
		round = state.round,
		phase = state.phase,
		endsAt = state.endsAt,
		fighters = fighters,
		winner = state.winner,
		rewards = if state.rewards ~= nil then table.clone(state.rewards) else nil,
	}
end

local function publish()
	changed:FireAllClients(snapshot())
end

local function find(name: string): Fighter?
	for _, fighter in state.fighters do
		if fighter.name == name then
			return fighter
		end
	end
	return nil
end

local function alive(team: Round.Team): number
	local count = 0
	for _, fighter in state.fighters do
		if fighter.team == team and not fighter.eliminated then
			count += 1
		end
	end
	return count
end

local function enter(phase: Phase, seconds: number?, winner: (Round.Team | "Draw")?)
	state.phase = phase
	state.endsAt = workspace:GetServerTimeNow() + (seconds or duration(phase))
	if phase == "Round" then
		for _, fighter in state.fighters do
			fighter.eliminated = false
			fighter.eliminations = 0
		end
		state.winner = nil
		state.rewards = nil
		raceComplete = false
		RaceService.start(state.fighters, not automatic, function()
			raceComplete = true
		end)
	elseif phase == "Results" then
		local red, blue = alive("Red"), alive("Blue")
		state.winner = winner
			or (
				if automatic
					then RaceService.winner()
					elseif red > blue then "Red"
					elseif blue > red then "Blue"
					else "Draw"
			)
		RaceService.stop()
		state.rewards = {
			Red = if state.winner == "Red" then WIN_REWARD else LOSS_REWARD,
			Blue = if state.winner == "Blue" then WIN_REWARD else LOSS_REWARD,
		}
		for _, player in Players:GetPlayers() do
			Ledger.reward(player, state.round, (state.rewards :: { Red: number, Blue: number }).Red)
		end
	elseif phase == "Intermission" then
		RaceService.stop()
		state.round += 1
		state.winner = nil
		state.rewards = nil
	end
	publish()
end

local function eliminate(victim: string, lap: string): boolean
	local target = find(victim)
	if automatic or target == nil or target.eliminated or state.phase ~= "Round" then
		return false
	end
	target.eliminated = true
	RaceService.markOut(victim)
	local entry: Round.Event = { kind = "elimination", victim = victim, by = lap, at = workspace:GetServerTimeNow() }
	table.insert(log, entry)
	event:FireAllClients(entry)
	publish()
	if not automatic and (alive("Red") == 0 or alive("Blue") == 0) then
		enter("Results")
	end
	return true
end

local function join(player: Player)
	if find(player.Name) == nil then
		local fighter: Fighter = { name = player.Name, team = "Red", eliminated = false, eliminations = 0 }
		table.insert(state.fighters, 1, fighter)
		publish()
	end
end

local function leave(player: Player)
	for index, fighter in state.fighters do
		if fighter.name == player.Name then
			table.remove(state.fighters, index)
			publish()
			return
		end
	end
end

local function tick()
	local now = workspace:GetServerTimeNow()
	if state.phase ~= "Intermission" and now >= state.endsAt then
		if state.phase == "Round" then
			enter("Results")
		else
			enter("Intermission")
		end
		return
	end
	if automatic and state.phase == "Round" then
		local updated = false
		for _, fighter in state.fighters do
			local laps = RaceService.laps(fighter.name)
			if fighter.eliminations ~= laps then
				fighter.eliminations = laps
				updated = true
			end
		end
		if updated then
			publish()
		end
		if raceComplete then
			enter("Results")
		end
	end
end

local function start()
	Players.PlayerAdded:Connect(join)
	Players.PlayerRemoving:Connect(leave)
	for _, player in Players:GetPlayers() do
		join(player)
	end
	task.spawn(function()
		while true do
			tick()
			task.wait(0.25)
		end
	end)
end

return {
	start = start,
	snapshot = snapshot,
	enter = enter,
	eliminate = eliminate,
	setLaps = function(name: string, laps: number)
		assert(not automatic, "lap fixtures require manual mode")
		local fighter = find(name)
		assert(fighter, "unknown racer")
		fighter.eliminations = math.clamp(math.floor(laps), 0, 3)
		publish()
	end,
	setAutomatic = function(value: boolean)
		automatic = value
		RaceService.setManual(not value)
	end,
	events = function(): { Round.Event }
		return table.clone(log)
	end,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="86">
        <Properties>
          <string name="Name">SettingsStore</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Settings = require(ReplicatedStorage.Shared.Hub.Settings)

type Values = Settings.Values
type SaveResult = Settings.SaveResult

export type Entry = { kind: string, fields: { string }, ok: boolean, reason: string?, at: number }

local SAVED: Values = {
	musicVolume = 60,
	effectsVolume = 80,
	showDamageNumbers = true,
	cameraShake = false,
	graphics = "Medium",
}
local SAVE_DELAY = 0.2

local stored: { [Player]: Values } = {}
local journals: { [Player]: { Entry } } = {}
local changed = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("SettingsChanged") :: RemoteEvent

local function valuesOf(player: Player): Values
	local values = stored[player]
	if values == nil then
		values = table.clone(SAVED)
		stored[player] = values
	end
	return values
end

local function journalOf(player: Player): { Entry }
	local journal = journals[player]
	if journal == nil then
		journal = {}
		journals[player] = journal
	end
	return journal
end

local function get(player: Player): Values
	return table.clone(valuesOf(player))
end

local function volume(value: unknown): number?
	if type(value) ~= "number" or value ~= value then
		return nil
	end
	if value < 0 or value > 100 then
		return nil
	end
	return math.floor(value + 0.5)
end

local function save(player: Player, patch: unknown): SaveResult
	local current = valuesOf(player)
	local journal = journalOf(player)
	if type(patch) ~= "table" then
		table.insert(journal, { kind = "save", fields = {}, ok = false, reason = "invalid_value", at = os.clock() })
		return { ok = false, reason = "invalid_value", field = nil, values = table.clone(current) }
	end
	local raw = patch :: { [string]: unknown }
	local next = table.clone(current)
	local fields: { string } = {}
	for key, value in raw do
		local accepted = true
		if key == "musicVolume" or key == "effectsVolume" then
			local level = volume(value)
			if level == nil then
				accepted = false
			elseif key == "musicVolume" then
				next.musicVolume = level
			else
				next.effectsVolume = level
			end
		elseif key == "showDamageNumbers" or key == "cameraShake" then
			if type(value) ~= "boolean" then
				accepted = false
			elseif key == "showDamageNumbers" then
				next.showDamageNumbers = value
			else
				next.cameraShake = value
			end
		elseif key == "graphics" then
			if value == "Low" or value == "Medium" or value == "High" then
				next.graphics = value
			else
				accepted = false
			end
		else
			accepted = false
		end
		if not accepted then
			table.insert(
				journal,
				{ kind = "save", fields = { key }, ok = false, reason = "invalid_value", at = os.clock() }
			)
			return { ok = false, reason = "invalid_value", field = key, values = table.clone(current) }
		end
		table.insert(fields, key)
	end
	task.wait(SAVE_DELAY)
	stored[player] = next
	table.sort(fields)
	table.insert(journal, { kind = "save", fields = fields, ok = true, reason = nil, at = os.clock() })
	changed:FireClient(player, table.clone(next))
	return { ok = true, reason = nil, field = nil, values = table.clone(next) }
end

local function push(player: Player, patch: { [string]: unknown }): SaveResult
	return save(player, patch)
end

local function journal(player: Player): { Entry }
	return table.clone(journalOf(player))
end

Players.PlayerRemoving:Connect(function(player)
	stored[player] = nil
	journals[player] = nil
end)

return {
	get = get,
	save = save,
	push = push,
	journal = journal,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="87">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Ledger = require(script.Parent.Ledger)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shop = require(ReplicatedStorage.Shared.Hub.Shop)

type State = Shop.State
type PurchaseResult = Shop.PurchaseResult

export type Entry = { kind: string, item: string?, ok: boolean, reason: string?, at: number }

type Profile = {
	wallet: Shop.Wallet,
	owned: { [string]: boolean },
	busy: boolean,
	journal: { Entry },
}

local STARTING_ITEMS = { "starter_motor" }
local SERVER_DELAY = 0.25

local profiles: { [Player]: Profile } = {}
local changed = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ShopStateChanged") :: RemoteEvent

local function fresh(player: Player): Profile
	local owned: { [string]: boolean } = {}
	for _, id in STARTING_ITEMS do
		owned[id] = true
	end
	return {
		wallet = Ledger.wallet(player),
		owned = owned,
		busy = false,
		journal = {},
	}
end

local function balance(wallet: Shop.Wallet, currency: Shop.Currency): number
	return if currency == "Gems" then wallet.Gems else wallet.Coins
end

local function adjust(wallet: Shop.Wallet, currency: Shop.Currency, delta: number)
	if currency == "Gems" then
		wallet.Gems = math.max(0, wallet.Gems + delta)
	else
		wallet.Coins = math.max(0, wallet.Coins + delta)
	end
end

local function profileOf(player: Player): Profile
	local profile = profiles[player]
	if profile == nil then
		local created = fresh(player)
		profiles[player] = created
		return created
	end
	return profile
end

local function snapshot(profile: Profile): State
	return {
		wallet = { Coins = profile.wallet.Coins, Gems = profile.wallet.Gems },
		owned = table.clone(profile.owned),
	}
end

local function publish(player: Player)
	changed:FireClient(player, snapshot(profileOf(player)))
end

local function record(profile: Profile, entry: Entry)
	table.insert(profile.journal, entry)
end

local function getState(player: Player): State
	return snapshot(profileOf(player))
end

local function purchase(player: Player, itemId: unknown): PurchaseResult
	local profile = profileOf(player)
	local id = if type(itemId) == "string" then itemId else ""
	local function refuse(reason: Shop.Failure): PurchaseResult
		record(profile, { kind = "purchase", item = id, ok = false, reason = reason, at = os.clock() })
		return { ok = false, item = id, reason = reason, state = snapshot(profile) }
	end
	local item = Shop.byId[id]
	if item == nil then
		return refuse("unknown_item")
	end
	if profile.busy then
		return refuse("busy")
	end
	if profile.owned[id] then
		return refuse("already_owned")
	end
	if balance(profile.wallet, item.currency) < item.price then
		return refuse("insufficient_funds")
	end
	profile.busy = true
	task.wait(SERVER_DELAY)
	adjust(profile.wallet, item.currency, -item.price)
	profile.owned[id] = true
	profile.busy = false
	record(profile, { kind = "purchase", item = id, ok = true, reason = nil, at = os.clock() })
	publish(player)
	return { ok = true, item = id, reason = nil, state = snapshot(profile) }
end

local function grant(player: Player, currency: Shop.Currency, amount: number)
	local profile = profileOf(player)
	adjust(profile.wallet, currency, amount)
	record(profile, { kind = "grant", item = currency, ok = true, reason = nil, at = os.clock() })
	publish(player)
end

local function journal(player: Player): { Entry }
	return table.clone(profileOf(player).journal)
end

Players.PlayerRemoving:Connect(function(player)
	profiles[player] = nil
end)

return {
	getState = getState,
	purchase = purchase,
	grant = grant,
	journal = journal,
	publish = publish,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="88">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!strict

local Lighting = game:GetService("Lighting")
local Track = require(game:GetService("ReplicatedStorage").Shared.RaceTrack)

local World = {}

function World.build()
	local folder = Instance.new("Folder")
	folder.Name = "SunfieldCircuit"
	folder.Parent = workspace
	local count = 0
	local function part(name: string, size: Vector3, frame: CFrame, color: Color3, material: Enum.Material?): Part
		local object = Instance.new("Part")
		object.Name = name
		object.Size = size
		object.CFrame = frame
		object.Color = color
		object.Material = material or Enum.Material.SmoothPlastic
		object.Anchored = true
		object.TopSurface = Enum.SurfaceType.Smooth
		object.BottomSurface = Enum.SurfaceType.Smooth
		object.Parent = folder
		count += 1
		return object
	end
	local green = Color3.fromRGB(113, 192, 100)
	local cream = Color3.fromRGB(255, 235, 172)
	local coral = Color3.fromRGB(244, 99, 75)
	local teal = Color3.fromRGB(46, 178, 180)
	part("Meadow", Vector3.new(440, 2, 440), CFrame.new(0, -1, -155), green, Enum.Material.Grass)
	part("Plaza", Vector3.new(100, 1, 72), CFrame.new(0, 0.5, 0), cream, Enum.Material.Concrete)
	part("GridWalk", Vector3.new(18, 1, 72), CFrame.new(0, 0.5, -70), cream)
	for index = 0, Track.segments - 1 do
		local a, b = Track.point(index / Track.segments), Track.point((index + 1) / Track.segments)
		local frame = CFrame.lookAt((a + b) / 2, b)
		local length = (a - b).Magnitude + 0.6
		part(
			"Asphalt",
			Vector3.new(Track.width, 1, length),
			frame * CFrame.new(0, -1, 0),
			Color3.fromRGB(57, 67, 80),
			Enum.Material.Asphalt
		)
		for _, side in { -1, 1 } do
			part(
				"Curb",
				Vector3.new(2, 0.5, length),
				frame * CFrame.new(side * 14, -0.5, 0),
				if index % 2 == 0 then coral else cream
			)
			part(
				"Barrier",
				Vector3.new(1.5, 3, length),
				frame * CFrame.new(side * 17, 0.5, 0),
				if index % 4 < 2 then teal else cream
			)
		end
	end
	for index = 0, Track.checkpoints - 1 do
		local checkpoint = part(
			"Checkpoint",
			Vector3.new(30, 12, 1),
			Track.frame(index / Track.checkpoints) * CFrame.new(0, 5, 0),
			teal
		)
		checkpoint.Transparency = 1
		checkpoint.CanCollide = false
		checkpoint.CanTouch = false
		checkpoint:SetAttribute("Index", index)
	end
	for _, side in { -1, 1 } do
		part("GantryPost", Vector3.new(2, 15, 2), Track.frame(0, side * 16) * CFrame.new(0, 6, 0), teal)
	end
	part("FinishGantry", Vector3.new(34, 4, 2), Track.frame(0) * CFrame.new(0, 13, 0), cream)
	for index = 0, 11 do
		part(
			"FinishTile",
			Vector3.new(2, 0.1, 3),
			Track.frame(0, index * 2 - 11) * CFrame.new(0, -0.44, 0),
			if index % 2 == 0 then cream else Color3.fromRGB(40, 50, 65)
		)
	end
	local function stall(name: string, x: number, z: number, color: Color3, width: number)
		part(name, Vector3.new(width, 10, 3), CFrame.new(x, 6, z), color)
		part(name .. "Roof", Vector3.new(width + 4, 2, 16), CFrame.new(x, 12, z + 4), cream)
		for _, side in { -1, 1 } do
			part(name .. "Pillar", Vector3.new(1, 10, 1), CFrame.new(x + side * (width / 2), 6, z + 10), color)
		end
		part(name .. "Counter", Vector3.new(width - 2, 3, 4), CFrame.new(x, 2.5, z + 7), color)
	end
	stall("Garage", -32, 15, teal, 25)
	stall("ShopStall", 0, 23, coral, 16)
	stall("MechanicStand", 26, -7, teal, 14)
	stall("CrateArea", 36, 22, coral, 15)
	for index = 1, 6 do
		part(
			"SupplyCrate",
			Vector3.new(4, 4, 4),
			CFrame.new(28 + (index % 3) * 5, 3 + (index // 4) * 4, 29),
			cream,
			Enum.Material.WoodPlanks
		)
	end
	for _, side in { -1, 1 } do
		part("QueueGate", Vector3.new(3, 10, 3), CFrame.new(side * 12, 6, -30), coral)
	end
	part("QueueArch", Vector3.new(27, 3, 3), CFrame.new(0, 12, -30), teal)
	local random = Random.new(Track.seed)
	for index = 1, 24 do
		local frame = Track.frame(index / 24, if index % 2 == 0 then 32 else -35)
		local height = random:NextNumber(9, 15)
		part(
			"TreeTrunk",
			Vector3.new(2, height, 2),
			frame * CFrame.new(0, height / 2 - 2, 0),
			Color3.fromRGB(143, 100, 65),
			Enum.Material.Wood
		)
		local crown = part(
			"TreeCrown",
			Vector3.new(10, 10, 10),
			frame * CFrame.new(0, height - 2, 0),
			if index % 2 == 0 then teal else Color3.fromRGB(65, 151, 99)
		)
		crown.Shape = Enum.PartType.Ball
	end
	local spawn = workspace:FindFirstChildOfClass("SpawnLocation")
	if spawn then
		spawn.CFrame = CFrame.lookAt(Vector3.new(0, 2, 0), Vector3.new(0, 2, -100))
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.Neutral = true
	end
	Lighting.ClockTime = 12
	Lighting.Brightness = 2.5
	Lighting.Ambient = Color3.fromRGB(165, 178, 198)
	Lighting.OutdoorAmbient = Color3.fromRGB(180, 190, 210)
	folder:SetAttribute("StaticParts", count)
	assert(count == 511, "update the racing world part budget")
end

return World
]]></string>
        </Properties>
