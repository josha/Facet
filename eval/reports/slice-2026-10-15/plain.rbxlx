        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">Inventory</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Items = require(script.Parent.Items)

export type Slot = Items.Slot
export type Rarity = Items.Rarity
export type Definition = Items.Definition

export type State = {
	owned: { string },
	equipped: { [Slot]: string },
}

export type Failure = "not_owned" | "unknown_item" | "empty_slot"

export type Result = {
	ok: boolean,
	reason: Failure?,
	state: State,
}

export type Client = {
	definitions: { Definition },
	slots: { Slot },
	getState: () -> State,
	equip: (itemId: string) -> Result,
	unequip: (slot: Slot) -> Result,
	onChanged: (callback: (State) -> ()) -> RBXScriptConnection,
}

local function client(): Client
	assert(RunService:IsClient(), "Inventory.client() runs on the client")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local getInventory = remotes:WaitForChild("GetInventory") :: RemoteFunction
	local equip = remotes:WaitForChild("Equip") :: RemoteFunction
	local unequip = remotes:WaitForChild("Unequip") :: RemoteFunction
	local changed = remotes:WaitForChild("InventoryChanged") :: RemoteEvent
	return {
		definitions = Items.definitions,
		slots = Items.slots,
		getState = function(): State
			return getInventory:InvokeServer()
		end,
		equip = function(itemId: string): Result
			return equip:InvokeServer(itemId)
		end,
		unequip = function(slot: Slot): Result
			return unequip:InvokeServer(slot)
		end,
		onChanged = function(callback: (State) -> ()): RBXScriptConnection
			return changed.OnClientEvent:Connect(callback)
		end,
	}
end

return {
	client = client,
	definitions = Items.definitions,
	byId = Items.byId,
	slots = Items.slots,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Items</string>
            <string name="Source"><![CDATA[--!strict

export type Slot = "Motor" | "Body" | "Wheels" | "Trail"

export type Rarity = "Common" | "Rare" | "Epic" | "Legendary"

export type Definition = {
	id: string,
	name: string,
	slot: Slot,
	rarity: Rarity,
	power: number,
	description: string,
}

local definitions: { Definition } = {
	{
		id = "starter_motor",
		name = "Starter Motor",
		slot = "Motor",
		rarity = "Common",
		power = 5,
		description = "A reliable motor for new racers.",
	},
	{
		id = "frost_motor",
		name = "Frost Motor",
		slot = "Motor",
		rarity = "Rare",
		power = 42,
		description = "A stable motor for cold tracks.",
	},
	{
		id = "ember_motor",
		name = "Ember Motor",
		slot = "Motor",
		rarity = "Epic",
		power = 77,
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "night_motor",
		name = "Night Motor",
		slot = "Motor",
		rarity = "Legendary",
		power = 128,
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "light_body",
		name = "Light Body",
		slot = "Body",
		rarity = "Common",
		power = 8,
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "steel_body",
		name = "Steel Body",
		slot = "Body",
		rarity = "Rare",
		power = 36,
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "storm_body",
		name = "Storm Body",
		slot = "Body",
		rarity = "Epic",
		power = 61,
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "city_wheels",
		name = "City Wheels",
		slot = "Wheels",
		rarity = "Common",
		power = 3,
		description = "Road wheels for daily hub runs.",
	},
	{
		id = "snow_wheels",
		name = "Snow Wheels",
		slot = "Wheels",
		rarity = "Rare",
		power = 19,
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "flame_wheels",
		name = "Flame Wheels",
		slot = "Wheels",
		rarity = "Legendary",
		power = 95,
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "spark_trail",
		name = "Spark Trail",
		slot = "Trail",
		rarity = "Common",
		power = 1,
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "galaxy_trail",
		name = "Galaxy Trail",
		slot = "Trail",
		rarity = "Epic",
		power = 4,
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "golden_trail",
		name = "Golden Trail",
		slot = "Trail",
		rarity = "Legendary",
		power = 6,
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
}

for _, item in require(script.Parent.Catalog).items do
	if item.id ~= "starter_motor" then
		local definition: Definition = {
			id = item.id,
			name = item.name,
			slot = if item.category == "Motors" or item.category == "Boosts"
				then "Motor"
				elseif item.category == "Wheels" then "Wheels"
				else "Trail",
			rarity = "Rare",
			power = item.price,
			description = item.description,
		}
		table.insert(definitions, definition)
	end
end
local byId: { [string]: Definition } = {}
for _, definition in definitions do
	byId[definition.id] = definition
end

local slots: { Slot } = { "Motor", "Body", "Wheels", "Trail" }

return {
	definitions = definitions,
	byId = byId,
	slots = slots,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">Lobby</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type ModeId = "solo" | "duo"

export type Mode = { id: ModeId, name: string, players: number, description: string }

export type Phase = "Lobby" | "Queue" | "Countdown" | "Starting"

export type State = {
	phase: Phase,
	mode: ModeId?,
	players: number,
	needed: number,
	countdownEndsAt: number?,
}

export type Failure = "already_queued" | "not_queued" | "unknown_mode" | "starting"

export type Result = { ok: boolean, reason: Failure?, state: State }

export type Client = {
	modes: { Mode },
	getState: () -> State,
	join: (modeId: ModeId) -> Result,
	leave: () -> Result,
	serverNow: () -> number,
	onStateChanged: (callback: (State) -> ()) -> RBXScriptConnection,
}

local modes: { Mode } = {
	{ id = "solo", name = "Solo", players = 4, description = "Every player for themselves." },
	{ id = "duo", name = "Duo", players = 6, description = "Team up in pairs." },
}

local function client(): Client
	assert(RunService:IsClient(), "Lobby.client() runs on the client")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local getState = remotes:WaitForChild("GetLobbyState") :: RemoteFunction
	local join = remotes:WaitForChild("JoinQueue") :: RemoteFunction
	local leave = remotes:WaitForChild("LeaveQueue") :: RemoteFunction
	local changed = remotes:WaitForChild("LobbyStateChanged") :: RemoteEvent
	return {
		modes = modes,
		getState = function(): State
			return getState:InvokeServer()
		end,
		join = function(modeId: ModeId): Result
			return join:InvokeServer(modeId)
		end,
		leave = function(): Result
			return leave:InvokeServer()
		end,
		serverNow = function(): number
			return workspace:GetServerTimeNow()
		end,
		onStateChanged = function(callback: (State) -> ()): RBXScriptConnection
			return changed.OnClientEvent:Connect(callback)
		end,
	}
end

return {
	client = client,
	modes = modes,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">Round</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type Phase = "Intermission" | "Round" | "Results"

export type Team = "Red" | "Blue"

export type Fighter = {
	name: string,
	team: Team,
	eliminated: boolean,
	eliminations: number,
}

export type State = {
	round: number,
	phase: Phase,
	endsAt: number,
	fighters: { Fighter },
	winner: (Team | "Draw")?,
	rewards: { Red: number, Blue: number }?,
}

export type Event = {
	kind: "elimination",
	victim: string,
	by: string,
	at: number,
}

export type Client = {
	localName: string,
	getState: () -> State,
	serverNow: () -> number,
	onStateChanged: (callback: (State) -> ()) -> RBXScriptConnection,
	onEvent: (callback: (Event) -> ()) -> RBXScriptConnection,
}

local function client(): Client
	assert(RunService:IsClient(), "Round.client() runs on the client")
	local Players = game:GetService("Players")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local getState = remotes:WaitForChild("GetRoundState") :: RemoteFunction
	local changed = remotes:WaitForChild("RoundStateChanged") :: RemoteEvent
	local event = remotes:WaitForChild("RoundEvent") :: RemoteEvent
	return {
		localName = (Players.LocalPlayer :: Player).Name,
		getState = function(): State
			return getState:InvokeServer()
		end,
		serverNow = function(): number
			return workspace:GetServerTimeNow()
		end,
		onStateChanged = function(callback: (State) -> ()): RBXScriptConnection
			return changed.OnClientEvent:Connect(callback)
		end,
		onEvent = function(callback: (Event) -> ()): RBXScriptConnection
			return event.OnClientEvent:Connect(callback)
		end,
	}
end

return {
	client = client,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">Settings</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type Preset = "Low" | "Medium" | "High"

export type Values = {
	musicVolume: number,
	effectsVolume: number,
	showDamageNumbers: boolean,
	cameraShake: boolean,
	graphics: Preset,
}

export type Patch = {
	musicVolume: number?,
	effectsVolume: number?,
	showDamageNumbers: boolean?,
	cameraShake: boolean?,
	graphics: Preset?,
}

export type Keybind = { action: string, keyboard: string, gamepad: string }

export type Failure = "invalid_value"

export type SaveResult = {
	ok: boolean,
	reason: Failure?,
	field: string?,
	values: Values,
}

export type Client = {
	defaults: Values,
	presets: { Preset },
	keybinds: { Keybind },
	get: () -> Values,
	save: (patch: Patch) -> SaveResult,
	onChanged: (callback: (Values) -> ()) -> RBXScriptConnection,
}

local defaults: Values = {
	musicVolume = 70,
	effectsVolume = 70,
	showDamageNumbers = true,
	cameraShake = true,
	graphics = "High",
}

local presets: { Preset } = { "Low", "Medium", "High" }

local keybinds: { Keybind } = {
	{ action = "Sprint", keyboard = "Left Shift", gamepad = "L3" },
	{ action = "Interact", keyboard = "E", gamepad = "X" },
	{ action = "Inventory", keyboard = "I", gamepad = "Y" },
	{ action = "Map", keyboard = "M", gamepad = "Select" },
}

local function client(): Client
	assert(RunService:IsClient(), "Settings.client() runs on the client")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local getSettings = remotes:WaitForChild("GetSettings") :: RemoteFunction
	local saveSettings = remotes:WaitForChild("SaveSettings") :: RemoteFunction
	local changed = remotes:WaitForChild("SettingsChanged") :: RemoteEvent
	return {
		defaults = table.clone(defaults),
		presets = table.clone(presets),
		keybinds = keybinds,
		get = function(): Values
			return getSettings:InvokeServer()
		end,
		save = function(patch: Patch): SaveResult
			return saveSettings:InvokeServer(patch)
		end,
		onChanged = function(callback: (Values) -> ()): RBXScriptConnection
			return changed.OnClientEvent:Connect(callback)
		end,
	}
end

return {
	client = client,
	defaults = defaults,
	presets = presets,
	keybinds = keybinds,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Catalog = require(script.Parent.Catalog)

export type Currency = Catalog.Currency
export type Category = Catalog.Category
export type Item = Catalog.Item

export type Wallet = { Coins: number, Gems: number }

export type State = {
	wallet: Wallet,
	owned: { [string]: boolean },
}

export type Failure = "insufficient_funds" | "already_owned" | "unknown_item" | "busy"

export type PurchaseResult = {
	ok: boolean,
	item: string,
	reason: Failure?,
	state: State,
}

export type Client = {
	catalog: { Item },
	categories: { Category },
	getState: () -> State,
	purchase: (itemId: string) -> PurchaseResult,
	onStateChanged: (callback: (State) -> ()) -> RBXScriptConnection,
}

local function client(): Client
	assert(RunService:IsClient(), "Shop.client() runs on the client")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local getState = remotes:WaitForChild("GetShopState") :: RemoteFunction
	local purchase = remotes:WaitForChild("Purchase") :: RemoteFunction
	local changed = remotes:WaitForChild("ShopStateChanged") :: RemoteEvent
	return {
		catalog = Catalog.items,
		categories = Catalog.categories,
		getState = function(): State
			return getState:InvokeServer()
		end,
		purchase = function(itemId: string): PurchaseResult
			return purchase:InvokeServer(itemId)
		end,
		onStateChanged = function(callback: (State) -> ()): RBXScriptConnection
			return changed.OnClientEvent:Connect(callback)
		end,
	}
end

return {
	client = client,
	catalog = Catalog.items,
	byId = Catalog.byId,
	categories = Catalog.categories,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">RaceRules</string>
          <string name="Source"><![CDATA[--!strict

export type Progress = { checkpoint: number, lap: number, progress: number }
export type Rank = { name: string, progress: number, finish: number, out: boolean }

local function advance(racer: Progress, t: number, onRoad: boolean, checkpoints: number): boolean
	local checkpoint = math.floor(t * checkpoints)
	local crossed = onRoad and checkpoint == (racer.checkpoint + 1) % checkpoints
	if crossed then
		racer.checkpoint = checkpoint
		if checkpoint == 0 then
			racer.lap += 1
		end
	end
	local fraction = if onRoad then math.clamp(t * checkpoints - racer.checkpoint, 0, 1) else 0
	racer.progress = racer.lap + (racer.checkpoint + fraction) / checkpoints
	return crossed and checkpoint == 0
end

local function ahead(a: Rank, b: Rank): boolean
	if a.out ~= b.out then
		return not a.out
	end
	if a.finish ~= b.finish then
		return a.finish < b.finish
	end
	if a.progress == b.progress then
		return a.name < b.name
	end
	return a.progress > b.progress
end

return { advance = advance, ahead = ahead }
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="70">
        <Properties>
          <string name="Name">RaceTrack</string>
          <string name="Source"><![CDATA[--!strict

local Track = { segments = 80, checkpoints = 16, laps = 3, width = 26, seed = 20261015 }
local knots: { Vector3 } = {}
for index = 0, 11 do
	local angle = index / 12 * math.pi * 2
	knots[index + 1] = Vector3.new(130 * math.sin(angle), 2, -190 + 85 * math.cos(angle))
end

function Track.point(t: number): Vector3
	local scaled = t % 1 * #knots
	local index = math.floor(scaled)
	local u = scaled - index
	local a, b, c, d =
		knots[(index - 1) % #knots + 1],
		knots[index + 1],
		knots[(index + 1) % #knots + 1],
		knots[(index + 2) % #knots + 1]
	return (2 * b + (c - a) * u + (2 * a - 5 * b + 4 * c - d) * u ^ 2 + (-a + 3 * b - 3 * c + d) * u ^ 3) * 0.5
end

function Track.frame(t: number, lane: number?): CFrame
	local point = Track.point(t)
	local frame = CFrame.lookAt(point, Track.point(t + 0.0001))
	return frame * CFrame.new(lane or 0, 0, 0)
end

function Track.progress(point: Vector3): number
	return (math.atan2(point.X / 130, (point.Z + 190) / 85) / (math.pi * 2)) % 1
end

return Track
]]></string>
        </Properties>
      </Item>
    </Item>
