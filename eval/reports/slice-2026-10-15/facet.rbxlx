          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">input_adjustment</string>
              <string name="Source"><![CDATA[--!strict
local InputTypes = require("./input_types")
local Shared = require("./types")
local ComposeTypes = require("../vendor/compose/core")

export type Adjust = {
	vertical: boolean?,
	once: boolean?,
	guard: boolean?,
	arrows: ((ComposeTypes.Use, number) -> boolean)?,
	extra: (((ComposeTypes.Use) -> boolean) -> ())?,
}
export type EnabledSource = InputTypes.EnabledOptions | InputTypes.NumberInputOptions | InputTypes.LevelOptions | {
	value: Shared.Value<number>,
	onChange: ((number) -> ())?,
}
export type RepeatHeld = (
	{ onFrame: ((number) -> ()) -> () -> () },
	number,
	number,
	() -> boolean,
	() -> ()
) -> () -> ()
export type Adjustment = (
	GuiObject,
	InputTypes.AdjustmentState,
	(number) -> (),
	(() -> ())?,
	number?,
	number?,
	Adjust?
) -> ()
type Base = {
	attributes: (Instance, Shared.Attributes) -> Instance,
	enabled: (EnabledSource, ComposeTypes.Use?) -> boolean,
	stopEnabled: (EnabledSource, ComposeTypes.Use?) -> boolean,
	repeatHeld: RepeatHeld,
	repeatDelay: number,
	repeatInterval: number,
}

local STICK_PRESS, STICK_RELEASE, STICK_DOMINANCE = 0.5, 0.35, 1.2

return function(ctx: Shared.Context, base: Base): Adjustment
	local runtime, Compose, read = ctx.runtime, ctx.Compose, ctx.read
	local E = ctx.types.Enum
	local attributes, enabled, stopEnabled, repeatHeld =
		base.attributes, base.enabled, base.stopEnabled, base.repeatHeld
	local function adjustment(
		node: GuiObject,
		spec: InputTypes.AdjustmentState,
		apply: (number) -> (),
		cancel: (() -> ())?,
		minimum: number?,
		maximum: number?,
		options: Adjust?
	): ()
		local adjust: Adjust = options or {}
		node:AddTag("facet-adjustable")
		runtime.connect(node, "SelectionGained", function() end)
		attributes(node, {
			disabled = function(use: ComposeTypes.Use): boolean
				return not stopEnabled((spec :: unknown) :: InputTypes.EnabledOptions, use)
			end,
		})
		if minimum ~= nil and maximum ~= nil then
			node:SetAttribute("axis", if adjust.vertical then "vertical" else "horizontal")
		end
		local landing = false
		local function arrowHeld(): boolean
			local input = ctx.config.services.UserInputService
			if input == nil then
				return false
			end
			local probe = (input :: unknown) :: {
				IsKeyDown: ((UserInputService, Enum.KeyCode) -> boolean)?,
				IsGamepadButtonDown: ((UserInputService, Enum.UserInputType, Enum.KeyCode) -> boolean)?,
			}
			for _, key in { E.KeyCode.Up, E.KeyCode.Down, E.KeyCode.Left, E.KeyCode.Right } do
				if probe.IsKeyDown and input:IsKeyDown(key) then
					return true
				end
			end
			if probe.IsGamepadButtonDown then
				for _, pad in ctx.navigationGamepads() do
					for _, key in { E.KeyCode.DPadUp, E.KeyCode.DPadDown, E.KeyCode.DPadLeft, E.KeyCode.DPadRight } do
						if input:IsGamepadButtonDown(pad, key) then
							return true
						end
					end
				end
			end
			return false
		end
		local function stickHeld(): boolean
			local service = ctx.config.services.UserInputService
			local probe = (
				service :: unknown
			) :: { GetGamepadState: ((UserInputService, Enum.UserInputType) -> { InputObject })? }
			if service == nil or probe.GetGamepadState == nil then
				return false
			end
			for _, pad in ctx.navigationGamepads() do
				for _, state in service:GetGamepadState(pad) do
					if state.KeyCode == E.KeyCode.Thumbstick1 and state.Position.Magnitude >= STICK_PRESS then
						return true
					end
				end
			end
			return false
		end
		local guiService = ctx.config.services.GuiService
		local target = guiService and guiService.SelectedObject
		local selected = Compose.cell(target ~= nil and target == node)
		if guiService then
			local nativeSelection = ctx.observe.SelectedObject(guiService)
			Compose.watch(function(use: ComposeTypes.Use)
				local target = use(nativeSelection)
				local inside = target ~= nil and target == node
				if selected:peek() and not inside and cancel then
					cancel()
				end
				if inside and not selected:peek() and adjust.guard then
					landing = arrowHeld()
				end
				selected:set(inside)
			end)
		else
			runtime.connect(node, "SelectionGained", function()
				selected:set(true)
			end)
			runtime.connect(node, "SelectionLost", function()
				selected:set(false)
				if cancel then
					cancel()
				end
			end)
		end
		local active = function(use: ComposeTypes.Use)
			return read(selected, use) and enabled(spec, use)
		end
		runtime.mountFragment(function()
			return {
				Compose.show(active, function()
					local held: unknown = nil
					local stopFrame: (() -> ())?
					local function stopRepeat()
						held = nil
						if stopFrame then
							stopFrame()
							stopFrame = nil
						end
					end
					Compose.cleanup(stopRepeat)
					Compose.watch(function(use: ComposeTypes.Use)
						if not active(use) or not ctx.available(node, use) then
							stopRepeat()
						end
					end)
					local function peekUse<T>(source: ComposeTypes.Readable<T>): T
						return read(source)
					end
					local function movable(direction: number): () -> boolean
						return function(): boolean
							if not active(peekUse) then
								return false
							end
							if adjust.arrows then
								return adjust.arrows(peekUse, direction)
							end
							if minimum == nil or maximum == nil then
								return true
							end
							local value = read(((spec :: unknown) :: { value: Shared.ValueNumber }).value)
							return if direction < 0 then value > minimum else value < maximum
						end
					end
					local function start(token: unknown, direction: number, holding: () -> boolean)
						stopRepeat()
						local can = movable(direction)
						if not can() then
							return
						end
						apply(direction)
						held = token
						if runtime.host.frames and not adjust.once then
							local timing = (spec :: unknown) :: { repeatDelay: number?, repeatInterval: number? }
							stopFrame = repeatHeld(
								runtime.host.frames,
								timing.repeatDelay or base.repeatDelay,
								timing.repeatInterval or base.repeatInterval,
								function(): boolean
									if held ~= token or not can() or not ctx.available(node) or not holding() then
										stopRepeat()
										return false
									end
									return true
								end,
								function()
									apply(direction)
								end
							)
						end
					end
					local function steers(direction: number): (ComposeTypes.Use) -> boolean
						return function(use: ComposeTypes.Use): boolean
							if not active(use) then
								return false
							end
							if adjust.arrows then
								return adjust.arrows(use, direction)
							end
							if minimum == nil or maximum == nil then
								return true
							end
							local value = read(((spec :: unknown) :: { value: Shared.ValueNumber }).value, use)
							return if direction < 0 then value > minimum else value < maximum
						end
					end
					local function bind(name: string, keys: Shared.ActionBindings, direction: number, arrow: boolean?)
						local action: InputAction
						action = ctx.action(node, name, keys, if arrow then steers(direction) else active, function()
							if arrow and landing then
								return
							end
							local probe = (action :: unknown) :: { GetState: ((InputAction) -> unknown)? }
							local state = probe.GetState
							local engaged = state ~= nil and state(action) == true
							start(action, direction, function(): boolean
								return not engaged or (state :: (InputAction) -> unknown)(action) == true
							end)
						end, {
							priority = 250,
							capture = true,
							onReleased = function()
								if arrow then
									landing = false
								end
								if held == (action :: unknown) then
									stopRepeat()
								end
							end,
						})
					end
					bind("Decrease", { E.KeyCode.Comma, E.KeyCode.ButtonL1 }, -1)
					bind("Increase", { E.KeyCode.Period, E.KeyCode.ButtonR1 }, 1)
					if minimum ~= nil and maximum ~= nil then
						for _, direction in { -1, 1 } do
							local keys = if adjust.vertical
								then (if direction < 0
									then { E.KeyCode.Down, E.KeyCode.DPadDown }
									else { E.KeyCode.Up, E.KeyCode.DPadUp })
								else (if direction < 0
									then { E.KeyCode.Left, E.KeyCode.DPadLeft }
									else { E.KeyCode.Right, E.KeyCode.DPadRight })
							bind(if direction < 0 then "DecreaseArrow" else "IncreaseArrow", keys, direction, true)
						end
						local leaning = 0
						local settling = stickHeld()
						local stickInput = ctx.config.services.UserInputService
						local function lean(event: InputObject, ended: boolean)
							if
								event.KeyCode ~= E.KeyCode.Thumbstick1
								or not table.find(ctx.navigationGamepads(), event.UserInputType)
							then
								return
							end
							local x, y = if ended then 0 else event.Position.X, if ended then 0 else event.Position.Y
							local along = if adjust.vertical then y else x
							local across = math.abs(if adjust.vertical then x else y)
							local reach = math.abs(along)
							local sign = if along > 0 then 1 else -1
							if settling then
								settling = reach >= STICK_RELEASE and reach >= across
								return
							end
							local direction = if leaning == sign
									and reach >= STICK_RELEASE
									and reach >= across
								then sign
								elseif reach >= STICK_PRESS and reach > across * STICK_DOMINANCE then sign
								else 0
							if direction == leaning then
								return
							end
							leaning = direction
							if direction == 0 then
								if held == "stick" then
									stopRepeat()
								end
							elseif ctx.available(node) then
								start("stick", direction, function(): boolean
									return leaning == direction
								end)
							end
						end
						if stickInput then
							runtime.connect(stickInput, "InputChanged", function(event: InputObject)
								lean(event, false)
							end)
							runtime.connect(stickInput, "InputEnded", function(event: InputObject)
								lean(event, true)
							end)
						end
					end
					if adjust.extra then
						adjust.extra(active)
					end
					if cancel then
						ctx.action(
							node,
							"Cancel",
							{ E.KeyCode.Escape, E.KeyCode.ButtonB },
							active,
							cancel,
							{ priority = 100 }
						)
					end
					return Compose.fragment(function()
						return {}
					end)
				end),
			}
		end, node)
	end
	return adjustment
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">input_button</string>
              <string name="Source"><![CDATA[--!strict
local reducedMotion = require("./motion").reduced
local decoration = require("./native_decoration")
local feedbackPaint = require("./feedback_paint")
local richText = require("./rich_text")
local help = require("./help")
local activation = require("./activation")
local inputKit = require("./input_kit")
local buttonContent = require("./input_button_content")
local InputTypes = require("./input_types")
local Shared = require("./types")
local ThemeTypes = require("./theme_types")
local EngineTypes = require("./engine_types")
local ControlTypes = require("./control_types")
local InputProps = require("./input_props")
local ComposeTypes = require("../vendor/compose/core")

return function(ctx: Shared.Context, UI: ControlTypes.Controls, kit: inputKit.Kit): ()
	local runtime, Host, Compose = ctx.runtime, ctx.Host, ctx.Compose
	local read = ctx.read
	local D, D2, V2, E = ctx.types.UDim, ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local dynamic, enabled = kit.dynamic, kit.enabled
	local noKey, typeRoles = kit.noKey, kit.typeRoles
	local dialogOrder = 0
	local roles: { [string]: boolean } = { default = true, cancel = true, destructive = true, onIndicator = true }
	local roleTags: { [string]: string } = {}
	for name in roles do
		roleTags[name] = "facet-role-" .. name
	end
	local contentGap = 8

	local buttonKeys = table.freeze({
		"haptic",
		"label",
		"compactLabel",
		"pop",
		"enabled",
		"disabled",
		"busy",
		"onActivate",
		"repeatDelay",
		"repeatInterval",
		"shortcut",
		"selected",
		"appearance",
		"help",
		"disclose",
		"controlSize",
		"corners",
		"role",
		"dialogAction",
		"icon",
		"trailingIcon",
		"image",
		"imageAspectRatio",
		"imageFraming",
		"subtitle",
		"row",
		"name",
		"hint",
		"shape",
		"onPointerDown",
		"onPointerUp",
		"onPointerCancel",
		"textSize",
		"underline",
	})
	local CONTROL_RUNGS = { "xsmall", "compact", "regular", "large" }
	local rungTags: { string } = {}
	for index, name in CONTROL_RUNGS do
		rungTags[index] = "facet-size-" .. name
	end
	local escapeRich = richText.escape
	UI.Button = ctx.construct("Button", function(spec: InputProps.ButtonProps): TextButton
		assert(
			spec.onActivate == nil or type(spec.onActivate) == "function",
			"Facet.Button: onActivate must be a function"
		)
		assert(
			spec.shape == nil or spec.shape == "rect" or spec.shape == "circle",
			"Facet.Button: shape must be rect or circle"
		)
		local function cornerRadius(use: ComposeTypes.Use?): UDim
			local corners = read(spec.corners, use)
			assert(corners == "pill" or corners == "square", "Facet.Button: corners must be pill or square")
			return D.new(if corners == "pill" then 1 else 0, 0)
		end
		if spec.corners ~= nil then
			cornerRadius()
		end
		assert(
			spec.dialogAction == nil or spec.dialogAction == "default" or spec.dialogAction == "cancel",
			"Facet.Button: invalid dialogAction"
		)
		assert(
			spec.imageFraming == nil or spec.imageFraming == "fit" or spec.imageFraming == "crop",
			"Facet.Button: imageFraming must be fit or crop"
		)
		local declaredSize = read(spec.textSize)
		assert(
			declaredSize == nil
				or (type(declaredSize) == "string" and typeRoles[declaredSize])
				or (type(declaredSize) == "number" and declaredSize > 0 and declaredSize < math.huge),
			"Facet.Button: textSize must be a type role or a positive number"
		)
		local underline = spec.underline
		assert(
			underline == nil or underline == "always" or underline == "hover",
			"Facet.Button: underline must be always or hover"
		)
		local popSeconds = ctx.metric("motion.durations.buttonPop")
		local popTimeline = if spec.pop then runtime.timeline({ duration = popSeconds, autoplay = false }) else nil
		local popReduced = if popTimeline then reducedMotion(ctx) else nil
		local popStart = Compose.cell(1)
		local popScale
		if popTimeline then
			popTimeline:seek(popSeconds)
			local present = ctx.motionEase("present")
			local overshoot = ctx.metric("motion.materialize.popOvershoot")
			local decay = ctx.metric("motion.materialize.popDecay")
			popScale = Compose.formula(function(use: ComposeTypes.Use)
				if assert(popReduced)(use) then
					return 1
				end
				local phase = use(popTimeline.progress)
				return 1
					+ (use(popStart) - 1) * (1 - present(phase))
					+ overshoot * math.sin(math.pi * phase) * math.exp(-decay * phase)
			end)
			Compose.watch(function(use: ComposeTypes.Use)
				if assert(popReduced)(use) then
					popTimeline:pause()
					popTimeline:seek(popSeconds)
				end
			end)
		end

		local node: TextButton
		local iconState: ComposeTypes.Cell<ThemeTypes.SkinState>?
		if
			(spec.icon or spec.trailingIcon)
			and (
				ctx.iconVaries(spec.icon or (spec.row and spec.row.icon))
				or ctx.iconVaries(spec.trailingIcon)
				or (spec.row ~= nil and spec.onActivate ~= nil and ctx.iconVaries("chevron.trailing"))
			)
		then
			local initial: ThemeTypes.SkinState = "default"
			iconState = Compose.cell(initial)
		end
		local held, repeated, elapsed = false, false, 0
		local repeatDelay, repeatInterval =
			spec.repeatDelay or kit.repeatDelay, spec.repeatInterval or kit.repeatInterval
		assert(
			repeatDelay > 0 and repeatDelay < math.huge and repeatInterval > 0 and repeatInterval < math.huge,
			"Facet.Button: repeat timings must be finite and positive"
		)
		local function activate(...)
			local pressed: Instance? = node
			if
				activation.consumed((...))
				or (pressed and (help.consume(pressed) or activation.intercepted(pressed, (...))))
			then
				return
			end
			local route = if node then ctx.shiftActivation(node, (...)) else nil
			if route and enabled(spec) and ctx.available(node) then
				route()
				return
			end
			local live = enabled(spec)
			if live and node and ctx.available(node) and spec.onActivate then
				if popTimeline and popScale and popReduced and not held and not popReduced() then
					popStart:set(popScale:peek())
					popTimeline:restart()
				end
				spec.onActivate(...)
			end
			if live and node and ctx.available(node) then
				activation.notify(node, ...)
			end
		end
		local function shortcutActive(use)
			local input = ctx.config.services.UserInputService
			return enabled(spec, use)
				and node.Visible
				and node.Parent ~= nil
				and (not input or not input:GetFocusedTextBox())
		end
		local guiService = ctx.config.services.GuiService
		local lazyKeyboard = underline ~= "hover"
		local enabledLive = dynamic(spec.enabled) or dynamic(spec.disabled) or dynamic(spec.busy)
		local selectedForKeyboard: Shared.Value<boolean>
		local fallbackSelection: ComposeTypes.Cell<boolean>?
		local function observeSelection(): Shared.Value<boolean>
			local selected = ctx.observe.SelectedObject(assert(guiService))
			return function(use: ComposeTypes.Use)
				local target = use(selected)
				return node and target == node or false
			end
		end
		if guiService then
