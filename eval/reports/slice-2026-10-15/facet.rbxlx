          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">media_stage</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Engine = require("./engine_types")
local ComposeTypes = require("../vendor/compose/core")
local prepareMedia = require("./media_readiness")
local ControlTypes = require("./control_types")
local MediaProps = require("./media_props")
local MediaShared = require("./media_shared")

local SETTLE_SECONDS = 0.15
local VISIBLE_FRACTION = 0.5

return function(ctx: Types.Context, UI: ControlTypes.Controls, shared: MediaShared.Shared)
	local Host, runtime, Compose = ctx.Host, ctx.runtime, ctx.Compose
	local types = ctx.types
	local D2 = types.UDim2
	local bind = shared.bind
	local frames = runtime.host.frames
	local pending: { () -> () } = {}
	local stopQueue: (() -> ())? = nil
	local function enqueue(job: () -> (), owner: ComposeTypes.Owner)
		table.insert(pending, job)
		Compose.withOwner(owner, function()
			Compose.cleanup(function()
				local index = table.find(pending, job)
				if index then
					table.remove(pending, index)
				end
				if #pending == 0 and stopQueue then
					stopQueue()
					stopQueue = nil
				end
			end)
		end)
		if stopQueue == nil and frames then
			stopQueue = frames.onFrame(function()
				local next = table.remove(pending, 1)
				if next then
					next()
				end
				if #pending == 0 and stopQueue then
					stopQueue()
					stopQueue = nil
				end
			end)
		end
	end
	local function stageLive(stage: ViewportFrame): (ComposeTypes.Readable<boolean>, ComposeTypes.Readable<boolean>)
		local owner = assert(Compose.currentOwner())
		local moving = Compose.cell(false)
		local visible = Compose.cell(true)
		local near = Compose.cell(true)
		local position = ctx.observe.AbsolutePosition(stage)
		local size = ctx.observe.AbsoluteSize(stage)
		local current: ScrollingFrame? = nil
		local tracking: ComposeTypes.Owner? = nil
		local function track(frame: ScrollingFrame)
			local canvas = ctx.observe.CanvasPosition(frame)
			local origin = ctx.observe.AbsolutePosition(frame)
			local window = ctx.observe.AbsoluteWindowSize(frame)
			local last = canvas:peek()
			local lastMove = -math.huge
			local stopWatch: (() -> ())? = nil
			local function halt()
				if stopWatch then
					stopWatch()
					stopWatch = nil
				end
			end
			Compose.watch(function(use: ComposeTypes.Use)
				local value = use(canvas)
				local clock = frames
				if value == last or clock == nil then
					return
				end
				last = value
				lastMove = clock.now()
				moving:set(true)
				if stopWatch == nil then
					stopWatch = clock.onFrame(function()
						if clock.now() - lastMove >= SETTLE_SECONDS then
							halt()
							moving:set(false)
						end
					end)
				end
			end)
			Compose.cleanup(halt)
			Compose.watch(function(use: ComposeTypes.Use)
				local at, extent = use(position), use(size)
				local top, box = use(origin), use(window)
				if extent.X <= 0 or extent.Y <= 0 or box.X <= 0 or box.Y <= 0 then
					visible:set(false)
					near:set(false)
					return
				end
				local reachX, reachY = box.X / 2, box.Y / 2
				near:set(
					at.X + extent.X > top.X - reachX
						and at.X < top.X + box.X + reachX
						and at.Y + extent.Y > top.Y - reachY
						and at.Y < top.Y + box.Y + reachY
				)
				local width = math.min(at.X + extent.X, top.X + box.X) - math.max(at.X, top.X)
				local height = math.min(at.Y + extent.Y, top.Y + box.Y) - math.max(at.Y, top.Y)
				if width <= 0 or height <= 0 then
					visible:set(false)
					return
				end
				local shown = width * height / (extent.X * extent.Y)
				visible:set(shown >= VISIBLE_FRACTION or height >= box.Y * VISIBLE_FRACTION)
			end)
		end
		local function locate()
			if owner.isDisposed() then
				return
			end
			local found: ScrollingFrame? = nil
			local at = stage.Parent
			while at do
				if at:IsA("ScrollingFrame") then
					found = at
					break
				end
				if at:IsA("LayerCollector") then
					break
				end
				at = at.Parent
			end
			if found == current and tracking ~= nil then
				return
			end
			current = found
			if tracking then
				tracking.dispose()
				tracking = nil
			end
			moving:set(false)
			visible:set(true)
			near:set(true)
			if found then
				local child = owner.createChild()
				tracking = child
				Compose.withOwner(child, function()
					track(found)
				end)
			end
		end
		runtime.connect(stage, "AncestryChanged", locate)
		locate()
		return Compose.formula(function(use: ComposeTypes.Use): boolean
			return use(visible) and not use(moving)
		end),
			near
	end

	UI.Stage = ctx.construct("Stage", function(spec: MediaProps.StageProps): ViewportFrame
		local world = Host.WorldModel "World" {}
		local externalCamera = spec.camera
			and (
				typeof(spec.camera) == "Instance"
				or (
					type(spec.camera) == "table"
					and type(((spec.camera :: unknown) :: { IsA: unknown }).IsA) == "function"
					and ((spec.camera :: unknown) :: Camera):IsA("Camera")
				)
			)
		local camera = if externalCamera
			then spec.camera :: Camera
			else Host.Camera "Camera" {
				FieldOfView = bind(spec.fieldOfView, 45),
				CFrame = (spec.camera :: Types.Value<CFrame>?)
					or types.CFrame.lookAt(types.Vector3.new(0, 2, 8), types.Vector3.new(0, 0, 0)),
			}
		local native = ctx.props(
			spec,
			{ "content", "camera", "fieldOfView", "lazy" },
			{
				Size = D2.fromOffset(240, 180),
				CurrentCamera = Compose.static(camera),
				world :: ComposeTypes.Child,
				if not externalCamera then camera else nil,
			} :: Engine.ViewportFrameNativeProps
		)
		local stage = ctx.styled(Host.ViewportFrame(native), "panel")
		local live, shown = stageLive(stage)
		stage:SetAttribute("FacetLive", live:peek())
		Compose.watch(function(use: ComposeTypes.Use)
			stage:SetAttribute("FacetLive", use(live))
		end)
		if spec.content then
			local content = spec.content
			local owner = assert(Compose.currentOwner())
			local built = false
			local function build()
				if built or owner.isDisposed() then
					return
				end
				built = true
				Compose.withOwner(owner, function()
					local cleanup = content(runtime, world, live)
					if type(cleanup) == "function" then
						Compose.cleanup(cleanup)
					end
				end)
				stage:SetAttribute("FacetBuilt", true)
			end
			stage:SetAttribute("FacetBuilt", false)
			if spec.lazy ~= true or frames == nil then
				build()
			else
				local queued = false
				local function attempt()
					queued = false
					if not owner.isDisposed() and shown:peek() then
						build()
					end
				end
				Compose.watch(function(use: ComposeTypes.Use)
					if use(shown) and not built and not queued then
						queued = true
						enqueue(attempt, owner)
					end
				end)
			end
		end
		prepareMedia(ctx, stage, spec.ImageTransparency)
		return stage
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="136">
            <Properties>
              <string name="Name">media_text</string>
              <string name="Source"><![CDATA[--!strict
local layoutKit = require("./layout_kit")
local Types = require("./types")
local Engine = require("./engine_types")
local Media = require("./media_types")
local Theme = require("./theme_types")
local ComposeTypes = require("../vendor/compose/core")
local bindThemes = require("./themes")
local help = require("./help")
local textReveal = require("./text_reveal")
local ControlTypes = require("./control_types")
local MediaProps = require("./media_props")
local MediaShared = require("./media_shared")

return function(ctx: Types.Context, UI: ControlTypes.Controls, shared: MediaShared.Shared)
	local Host, runtime, Compose = ctx.Host, ctx.runtime, ctx.Compose
	local themes = bindThemes(Compose)
	local lists = layoutKit.of(ctx)
	local types, read = ctx.types, ctx.read
	local E, D2, D, V2 = types.Enum, types.UDim2, types.UDim, types.Vector2
	local metric = ctx.metric
	local bind = shared.bind
	local function roleTag(value: string?): string
		local name = value or "body"
		assert(table.find(themes.TYPE_ROLES, name), "Facet Text invalid textRole")
		return "facet-type-" .. name
	end
	local function textRole(node: TextLabel, role: Types.Value<Media.TextRole>?): TextLabel
		if not Compose.isReadable(role) and type(role) ~= "function" then
			node:AddTag(roleTag(role :: Media.TextRole?))
			return node
		end
		local live = role :: Types.Value<Media.TextRole>
		local previous: string?
		Compose.watch(function(use: ComposeTypes.Use)
			local tag = roleTag(read(live, use))
			if previous then
				node:RemoveTag(previous)
			end
			previous = tag
			node:AddTag(tag)
		end)
		return node
	end

	local ELLIPSIS = "\u{2026}"
	local function middle(label: TextLabel, text: string, width: number): string
		local function fits(candidate: string): boolean
			label.Text = candidate
			return label.TextBounds.X <= width
		end
		if text == "" or width <= 0 or fits(text) then
			return text
		end
		local offsets: { number } = {}
		for position, _ in utf8.codes(text) do
			table.insert(offsets, position)
		end
		local total = #offsets
		local function form(keep: number): string
			if keep <= 0 then
				return ELLIPSIS
			end
			local head = math.ceil(keep / 2)
			local tail = keep - head
			local headEnd = if offsets[head + 1] ~= nil then offsets[head + 1] - 1 else #text
			return string.sub(text, 1, headEnd)
				.. ELLIPSIS
				.. (if tail > 0 then string.sub(text, offsets[total - tail + 1]) else "")
		end
		local low, high, best = 0, total - 1, 0
		while low <= high do
			local keep = (low + high) // 2
			if fits(form(keep)) then
				best = keep
				low = keep + 1
			else
				high = keep - 1
			end
		end
		return form(best)
	end
	local function fitOf(value: Media.TextFit?): { cap: Media.TextFitBound?, floor: Media.TextFitBound? }?
		if value == nil then
			return nil
		end
		if value == "fit" then
			return {}
		end
		local refusal =
			'Facet Text textSize must be a size, a type role, "fit" or { fit = { cap = size, floor = size } }'
		assert(type(value) == "table" and type(value.fit) == "table", refusal)
		local band = value.fit
		for key in band :: { [unknown]: unknown } do
			assert(key == "cap" or key == "floor", "Facet Text textSize fit takes only cap and floor")
		end
		for _, bound in { band.cap, band.floor } do
			assert(
				bound == nil
					or (type(bound) == "number" and bound > 0)
					or (type(bound) == "string" and table.find(themes.TYPE_ROLES, bound) ~= nil),
				"Facet Text textSize fit cap and floor must be a positive size or a type role"
			)
		end
		return band
	end

	local TEXT_KEYS = {
		"text",
		"textRole",
		"role",
		"truncate",
		"textSize",
		"textAlign",
		"wrap",
		"rich",
		"direction",
		"tint",
		"lines",
		"disclose",
		"reveal",
	}
	local ALIGN: { [string]: Enum.TextXAlignment } = {
		start = E.TextXAlignment.Left,
		center = E.TextXAlignment.Center,
		["end"] = E.TextXAlignment.Right,
	}
	local DIRECTION: { [string]: Enum.TextDirection } = {
		auto = E.TextDirection.Auto,
		ltr = E.TextDirection.LeftToRight,
		rtl = E.TextDirection.RightToLeft,
	}
	UI.Text = ctx.construct("Text", function(spec: MediaProps.TextProps): TextLabel
		local fields = (spec :: unknown) :: { [string]: unknown }
		for _, retired in { "color", "font" } do
			if fields[retired] ~= nil then
				error(`Facet UI.Text: {retired} is style authority. Use role or textRole.`, 0)
			end
		end
		if fields.label ~= nil or spec.Text ~= nil then
			error("Facet UI.Text: set the text with text. Remove label and Text.", 0)
		end
		local source: Types.Value<string>? = spec.text
		if not Compose.isReadable(source) and type(source) ~= "function" then
			assert(type(source) == "string", "Facet UI.Text requires text")
		end
		local truncate = spec.truncate
		assert(
			truncate == nil or truncate == "end" or truncate == "middle",
			"Facet Text truncate must be end or middle"
		)
		local cut = truncate == "middle"
		local rich = spec.rich == true or spec.RichText == true
		assert(spec.rich == nil or type(spec.rich) == "boolean", "Facet Text rich must be a boolean")
		assert(not cut or not rich, "Facet Text cannot cut rich text in the middle")
		assert(
			not cut or (spec.TextWrapped ~= true and spec.wrap ~= true),
			"Facet Text middle truncation needs one line; remove wrap"
		)
		assert(
			spec.direction == nil or DIRECTION[spec.direction] ~= nil,
			"Facet Text direction must be auto, ltr or rtl"
		)
		local size = spec.textSize
		local pixels: number? = if type(size) == "number" then size else nil
		assert(pixels == nil or (pixels > 0 and pixels < math.huge), "Facet Text textSize must be a positive size")
		local sizeRole: Media.TextRole? = nil
		if type(size) == "string" and size ~= "fit" then
			assert(
				table.find(themes.TYPE_ROLES, size) ~= nil,
				`Facet Text textSize "{size}" is not a type role; use one of {table.concat(themes.TYPE_ROLES, ", ")}`
			)
			sizeRole = size :: Media.TextRole
		end
		assert(
			sizeRole == nil or spec.textRole == nil,
			"Facet Text: set the type role one time, with textSize or textRole"
		)
		local fit = if pixels == nil and sizeRole == nil then fitOf(size :: Media.TextFit?) else nil
		local lines = spec.lines
		assert(
			lines == nil or (type(lines) == "number" and lines >= 1 and lines % 1 == 0),
			"Facet Text lines must be a whole number, 1 or more"
		)
		assert(lines == nil or not cut, "Facet Text lines cannot combine with a middle cut")
		assert(lines == nil or fit == nil, "Facet Text lines cannot combine with a fitted text size")
		assert(spec.reveal == nil or spec.reveal == "auto", "Facet Text reveal must be auto")
		assert(
			spec.reveal == nil or (lines == nil and not cut and spec.wrap ~= true and spec.TextWrapped ~= true),
			"Facet Text reveal needs one line that truncates at the end; remove wrap, lines or the middle cut"
		)
		local defaults: Engine.TextLabelNativeProps = {
			Text = if cut then read(source) or "" else bind(source, ""),
		}
		if rich then
			defaults.RichText = true
		end
		if pixels then
			defaults.TextSize = pixels
		end
		if spec.wrap ~= nil then
			defaults.TextWrapped = spec.wrap
		end
		if spec.direction ~= nil then
			defaults.TextDirection = DIRECTION[spec.direction]
		end
		if spec.tint ~= nil then
			defaults.TextColor3 = spec.tint :: Types.Value<Color3>
		end
		if spec.textAlign ~= nil then
			defaults.TextXAlignment = function(use: ComposeTypes.Use): Enum.TextXAlignment
				local align = read(spec.textAlign, use) or "start"
				return (assert(ALIGN[align], "Facet Text textAlign must be start, center or end"))
			end
		end
		if cut then
			defaults.Size = D2.fromScale(1, 0)
			defaults.AutomaticSize = E.AutomaticSize.Y
			defaults.TextWrapped = false
			defaults.TextTruncate = E.TextTruncate.None
		elseif
			truncate == "end"
			or spec.reveal
			or (spec.disclose == true and spec.wrap ~= true and spec.TextWrapped ~= true)
		then
			defaults.TextTruncate = E.TextTruncate.AtEnd
		end
		if lines then
			defaults.Size = D2.fromScale(1, 0)
			defaults.AutomaticSize = E.AutomaticSize.Y
			defaults.TextWrapped = true
			defaults.TextTruncate = E.TextTruncate.AtEnd
		end
		local roleSource: Types.Value<Media.TextRole>? = sizeRole or spec.textRole
		if fit then
			local function scale(bound: Media.TextFitBound, use: ComposeTypes.Use): number
				return math.round(
					if type(bound) == "string" then metric("typography." .. bound .. ".size", use) else bound
				)
			end
			defaults.TextScaled = true
			defaults.Size = D2.fromScale(1, 1)
			defaults.AutomaticSize = E.AutomaticSize.None
			defaults[1] = Host.UITextSizeConstraint({
				MaxTextSize = function(use: ComposeTypes.Use): number
					return scale(fit.cap or read(roleSource, use) or "body", use)
				end,
				MinTextSize = function(use: ComposeTypes.Use): number
					return scale(fit.floor or "caption", use)
				end,
			})
		end
		local label = textRole(ctx.text(ctx.props(spec, TEXT_KEYS, defaults)), roleSource)
		if lines then
			local styledSize = ctx.observeStyled.TextSize(label)
			local styledLine = ctx.observeStyled.LineHeight(label)
			runtime.mount(function()
				return Host.UISizeConstraint({
					Name = "LineClamp",
					MaxSize = function(use: ComposeTypes.Use): Vector2
						local inset = label:FindFirstChildWhichIsA("UIPadding")
						local vertical = if inset then inset.PaddingTop.Offset + inset.PaddingBottom.Offset else 0
						return V2.new(math.huge, math.ceil(lines * use(styledSize) * use(styledLine)) + vertical)
					end,
				})
			end, label)
		end
		if cut then
			local measured = ctx.layoutSize(label)
			local insets = Compose.cell({ left = D.new(0, 0), right = D.new(0, 0) })
			local sideConnections: { RBXScriptConnection } = {}
			local function paddingChanged()
				for _, connection in sideConnections do
					connection:Disconnect()
				end
				table.clear(sideConnections)
				local inset = label:FindFirstChildWhichIsA("UIPadding")
				local function refresh()
					insets:set(
						if inset
							then { left = inset.PaddingLeft, right = inset.PaddingRight }
							else { left = D.new(0, 0), right = D.new(0, 0) }
					)
				end
				if inset then
					table.insert(sideConnections, inset:GetPropertyChangedSignal("PaddingLeft"):Connect(refresh))
					table.insert(sideConnections, inset:GetPropertyChangedSignal("PaddingRight"):Connect(refresh))
				end
				refresh()
			end
			runtime.connect(label, "ChildAdded", paddingChanged)
			runtime.connect(label, "ChildRemoved", paddingChanged)
			Compose.cleanup(function()
				for _, connection in sideConnections do
					connection:Disconnect()
				end
			end)
			paddingChanged()
			local width = Compose.formula(function(use: ComposeTypes.Use): number
				local box = use(measured).X
				local inset = use(insets)
				return math.max(
					0,
					box - inset.left.Scale * box - inset.left.Offset - inset.right.Scale * box - inset.right.Offset
				)
			end)
			local textSize = ctx.observe.TextSize(label)
			local face = ctx.observe.FontFace(label)
			local styledSize = ctx.observeStyled.TextSize(label)
			local styledFace = ctx.observeStyled.FontFace(label)
			Compose.watch(function(use: ComposeTypes.Use)
				local value = read(source, use) or ""
				use(textSize)
				use(face)
				use(styledSize)
				use(styledFace)
				label.Text = middle(label, value, use(width))
			end)
		end
		assert(spec.disclose == nil or type(spec.disclose) == "boolean", "Facet Text disclose must be a boolean")
		if spec.disclose or spec.reveal then
			local fits, painted = ctx.observe.TextFits(label), ctx.observe.Text(label)
			local shown = Compose.cell(false)
			help.attach(ctx, label, bind(source, ""), {
				name = "Disclosure",
				gate = function(use: ComposeTypes.Use): boolean
					return not use(fits) or (cut and use(painted) ~= (read(source, use) or ""))
				end,
				shown = shown,
			})
			if spec.reveal then
				textReveal(ctx, label, shown)
			end
		end
		if spec.role ~= nil then
			Compose.watch(function(use: ComposeTypes.Use)
				local role = read(spec.role, use)
				assert(
					role == nil or role == "secondary" or role == "content",
					"Facet Text role must be secondary or content"
				)
				if role == "secondary" then
					label:AddTag("facet-secondary")
				elseif label:HasTag("facet-secondary") then
					label:RemoveTag("facet-secondary")
				end
			end)
		end
		return label
	end)

	local PRESENTATIONS = { titleAndIcon = true, titleOnly = true, iconOnly = true }
	UI.Label = ctx.construct("Label", function(spec: MediaProps.LabelProps): Frame
		local fields = (spec :: unknown) :: { [string]: unknown }
		if fields.text ~= nil or fields.label ~= nil then
			error("Facet UI.Label: a Label is an icon and a title. Use title, or use UI.Text for plain text.", 0)
		end
		local initial = read(spec.title)
		assert(
			type(initial) == "string" and initial ~= "",
			"Facet UI.Label: title is required and must not be empty. It is the accessible name in every presentation."
		)
		local presentation = spec.presentation or "titleAndIcon"
		if not PRESENTATIONS[presentation] then
			error(`Facet UI.Label: unknown presentation '{presentation}'. Use iconOnly | titleAndIcon | titleOnly.`, 0)
		end
		assert(
			spec.iconPosition == nil or spec.iconPosition == "leading" or spec.iconPosition == "trailing",
			"Facet UI.Label: iconPosition must be leading or trailing"
		)
		local effective = if spec.icon == nil then "titleOnly" else presentation
		local icon = spec.icon
		if type(icon) == "string" and not string.match(icon, "^rbx") then
			local package: Theme.IconRegistry = read(ctx.config.theme) or {}
			local overrides = read(ctx.config.icons)
			if overrides then
				package = table.clone(package)
				package.icons = overrides
			end
			local known = themes.resolveIcon(package, icon)
			assert(known ~= nil, `Facet UI.Label: unknown icon '{icon}'.`)
		end
		local children: { ComposeTypes.Child } = {}
		if effective ~= "titleOnly" then
			local iconSize = spec.iconSize
			local iconProps: Engine.ImageLabelNativeProps = { Name = "Icon" }
			if iconSize ~= nil then
				assert(
					(type(iconSize) == "number" and iconSize > 0) or type(iconSize) == "string",
					"Facet UI.Label: iconSize must be a positive number or a theme metric name"
				)
				iconProps.Size = function(use: ComposeTypes.Use): UDim2
					local pixels = if type(iconSize) == "number" then iconSize else metric(iconSize, use)
					return D2.fromOffset(pixels, pixels)
				end
			end
			table.insert(children, ctx.icon(icon :: string, iconProps))
		end
		if effective ~= "iconOnly" then
			local titleSize: Media.TextSize = spec.textSize or "body"
			table.insert(children, UI.Text("Title")({ text = spec.title, textSize = titleSize }))
		end
		if spec.iconPosition == "trailing" then
			local reversed: { ComposeTypes.Child } = {}
			for index = #children, 1, -1 do
				table.insert(reversed, children[index])
			end
			children = reversed
		end
		local keys = { "title", "icon", "presentation", "iconSize", "textSize", "gap", "iconPosition" }
		local root =
			ctx.row(children, (ctx.props(spec, keys, { Name = "Label" }) :: unknown) :: Engine.FrameNativeProps)
		local layout = assert(root:FindFirstChildWhichIsA("UIListLayout"))
		layout.VerticalAlignment = E.VerticalAlignment.Center
		if spec.gap ~= nil then
			runtime.decorate(layout, {
				Padding = function(use: ComposeTypes.Use)
					return D.new(0, lists.spacing(spec.gap, use))
				end,
			})
		end
		root:SetAttribute("FacetPresentation", effective)
		Compose.watch(function(use: ComposeTypes.Use)
			root:SetAttribute("AccessibleLabel", read(spec.title, use))
		end)
		return root
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="137">
            <Properties>
              <string name="Name">media_types</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local Engine = require("./engine_types")

export type ControlSize = "xsmall" | "compact" | "regular" | "large"
export type Status = "neutral" | "info" | "success" | "warning" | "error" | "accent" | "voice" | "contrast"
export type TextRole = "caption" | "label" | "body" | "heading" | "title" | "control" | "strong" | "numeral"
export type Corners = number | "pill" | "square" | "rounded"
export type TextFitBound = number | TextRole
export type TextFit = "fit" | { fit: { cap: TextFitBound?, floor: TextFitBound? } }
export type TextSize = number | TextRole | TextFit
export type TextAlign = "start" | "center" | "end"
export type TextOptions = {
	ref: ((TextLabel) -> ())?,
	text: Types.ValueString,
	textRole: Types.Value<TextRole>?,
	role: Types.Value<"secondary" | "content">?,
	truncate: ("end" | "middle")?,
	textSize: TextSize?,
	textAlign: Types.Value<TextAlign>?,
	wrap: Types.ValueBoolean?,
	rich: boolean?,
	direction: ("auto" | "ltr" | "rtl")?,
	tint: Types.Value<Color3>?,
	lines: number?,
	disclose: boolean?,
	reveal: "auto"?,
}
export type LabelPresentation = "titleAndIcon" | "titleOnly" | "iconOnly"
export type LabelOptions = {
	ref: ((Frame) -> ())?,
	title: Types.ValueString,
	icon: string?,
	presentation: LabelPresentation?,
	iconSize: (number | string)?,
	textSize: (number | TextRole)?,
	gap: Types.Value<Types.Space>?,
	iconPosition: ("leading" | "trailing")?,
}
export type ScaleMode = "fit" | "fill" | "crop" | "stretch" | "tile" | "slice"
export type ImageOptions = {
	ref: ((ImageLabel) -> ())?,
	image: Types.ValueString?,
	tint: Types.Value<Color3>?,
	scaleMode: Types.Value<ScaleMode>?,
	tileSize: { width: number, height: number }?,
	sliceCenter: { x0: number, y0: number, x1: number, y1: number }?,
	sliceScale: number?,
	resample: Types.Value<"default" | "pixelated">?,
	shape: ("rect" | "circle")?,
}
export type BadgeOptions = {
	label: Types.Value<string?>?,
	name: string?,
	icon: Types.ValueString?,
	iconPosition: "leading" | "trailing"?,
	status: Types.Value<Status>?,
	appearance: Types.Value<"standard" | "status" | "utility">?,
	controlSize: Types.Value<ControlSize?>?,
	corners: Types.Value<number | "square" | "rounded" | "capsule">?,
}
export type StatusIndicatorOptions = {
	status: Types.Value<Status>?,
	form: Types.Value<"dot" | "ring" | "square" | "dash">?,
	count: Types.Value<number?>?,
	max: number?,
	diameter: Types.ValueNumber?,
	controlSize: Types.Value<ControlSize?>?,
	cutout: boolean?,
	name: Types.ValueString?,
}
export type PathPoint = { x: number, y: number, inX: number, inY: number, outX: number, outY: number }
export type PathOptions = {
	points: Types.Value<{ PathPoint }>,
	thickness: Types.Value<number | string>?,
	closed: Types.ValueBoolean?,
	role: Types.Value<"content" | "secondary" | "accent">?,
	tint: Types.Value<Color3>?,
	width: number?,
	height: number?,
}
export type Trail = { delay: number?, duration: number? }
export type ProgressViewOptions = {
	value: Types.ValueNumber?,
	min: Types.ValueNumber?,
	max: Types.ValueNumber?,
	presentation: "bar" | "circular" | "spinner"?,
	label: Types.ValueString?,
	endLabel: Types.ValueString?,
	showValue: boolean?,
	format: ((value: number) -> string)?,
	diameter: Types.ValueNumber?,
	thickness: Types.ValueNumber?,
	segments: number?,
	trail: Trail?,
	controlSize: Types.Value<ControlSize?>?,
}
export type SkeletonOptions = {
	form: "box" | "circle" | "line"?,
	lines: number?,
	controlSize: Types.Value<ControlSize?>?,
	corners: Types.Value<Corners | "control" | "panel">?,
}
export type ImageState = "loading" | "ready" | "failed"
export type ImageResource =
	{ value: Types.Value<string?>, state: Types.Value<ImageState>, status: Types.Value<ImageState>? }
	| { value: Types.Value<string?>, state: Types.Value<ImageState>?, status: Types.Value<ImageState> }
export type ImageLoader = (
	source: string,
	resolve: (value: string?) -> (),
	reject: (reason: unknown) -> ()
) -> (() -> ())?
export type ImageStatusCallback = (state: ImageState, reason: unknown) -> ()
export type AsyncImageOptions = {
	source: Types.Value<string?>?,
	image: Types.Value<string?>?,
	resource: (() -> ImageResource)?,
	loader: ImageLoader?,
	onStatus: ImageStatusCallback?,
	failureLabel: Types.ValueString?,
	placeholder: ((state: ComposeTypes.Readable<ImageState>) -> Instance)?,
	dimmed: Types.ValueBoolean?,
	imageProperties: Types.ImageLabelProps?,
}
export type Presence = "online" | "away" | "busy" | "offline" | "inExperience"
export type AvatarOptions = {
	name: Types.ValueString,
	image: Types.Value<string?>?,
	userId: Types.ValueNumber?,
	resource: (() -> ImageResource)?,
	loader: ImageLoader?,
	onStatus: ImageStatusCallback?,
	presence: Types.Value<Presence?>?,
	presenceLabel: Types.ValueString?,
	presenceMark: boolean?,
	diameter: Types.ValueNumber?,
	controlSize: Types.Value<ControlSize?>?,
	form: "standard" | "icon"?,
	backplate: boolean?,
	icon: Types.Value<string?>?,
	background: string?,
	onActivate: (() -> ())?,
}
export type AvatarMember = {
	id: string,
	name: string,
	image: string?,
	userId: number?,
	icon: string?,
	resource: (() -> ImageResource)?,
	presence: Presence?,
}
export type AvatarGroupOptions = {
	items: Types.Value<{ AvatarMember }>,
	max: number?,
	diameter: Types.ValueNumber?,
	controlSize: Types.Value<ControlSize?>?,
	form: "standard" | "icon"?,
	layout: "stacked" | "spread"?,
	overflow: "count" | "ellipsis"?,
	overflowLabel: Types.ValueString?,
	onOverflow: (() -> ())?,
}
export type StageOptions = {
	content: ((
		runtime: ComposeTypes.Runtime,
		world: WorldModel,
		live: ComposeTypes.Readable<boolean>
	) -> (() -> ())?)?,
	lazy: boolean?,
	camera: Camera | Types.Value<CFrame>?,
	fieldOfView: Types.ValueNumber?,
}
return {}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="138">
            <Properties>
              <string name="Name">motion</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Shared = require("./types")

type Acquire = ComposeTypes.AcquireSharedResource<ComposeTypes.Cell<boolean>>
export type Level = Shared.MotionLevel

local RANK = { normal = 0, limited = 1, none = 2 }
local warned: { [string]: boolean } = {}
local PUBLISHED = {}

local function check(value: unknown)
	if value ~= nil and (type(value) ~= "string" or RANK[value :: string] == nil) then
		error(`Facet motionLevel must be "normal", "limited" or "none", got {tostring(value)}`, 0)
	end
end

local function resolve(chosen: unknown, engineReduced: boolean): Level
	local device: Level = if engineReduced then "limited" else "normal"
	if chosen == nil then
		return device
	end
	if type(chosen) ~= "string" or RANK[chosen :: string] == nil then
		local key = tostring(chosen)
		if not warned[key] then
			warned[key] = true
			warn(`Facet motionLevel must be "normal", "limited" or "none", got {key}; following the device`)
		end
		return device
	end
	return if RANK[chosen :: string] > RANK[device] then chosen :: Level else device
end

local function publish(Compose: typeof(ComposeTypes), runtime: unknown, value: unknown)
	if value == nil then
		return
	end
	local owner = runtime :: { [unknown]: { unknown }? }
	local list = owner[PUBLISHED] or {}
	owner[PUBLISHED] = list
	local entry = { value }
	table.insert(list, entry)
	if Compose.currentOwner() ~= nil then
		Compose.cleanup(function()
			local at = table.find(list, entry)
			if at then
				table.remove(list, at)
			end
		end)
	end
end

local function publishedFor(runtime: unknown): { unknown }
	local out = {}
	local list: { { unknown } } = (runtime :: { [unknown]: { { unknown } }? })[PUBLISHED] or {}
	for _, entry in list do
		table.insert(out, entry[1])
	end
	return out
end

local function level(ctx: Shared.Context): (ComposeTypes.Use?) -> Level
	local config = ctx.config
	local gui = config.guiService
	local native: ComposeTypes.Cell<boolean>? = nil
	if gui then
		local acquire: Acquire = (ctx.reducedMotion :: Acquire?)
			or ctx.Compose.createSharedResource(function(): (ComposeTypes.Cell<boolean>, (() -> ())?)
				return ctx.observe.ReducedMotionEnabled(gui), nil
			end)
		ctx.reducedMotion = acquire
		native = acquire()
	end
	return function(use: ComposeTypes.Use?): Level
		return resolve(
			ctx.read(config.motionLevel, use),
			native ~= nil and (if use then use(native) else native:peek()) == true
		)
	end
end

local function reduced(ctx: Shared.Context): (ComposeTypes.Use?) -> boolean
	local current = level(ctx)
	return function(use: ComposeTypes.Use?): boolean
		return current(use) ~= "normal"
	end
end

return {
	level = level,
	reduced = reduced,
	resolve = resolve,
	check = check,
	publish = publish,
	published = publishedFor,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="139">
            <Properties>
              <string name="Name">native_decoration</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Engine = require("./engine_types")
type Insets = { [string]: UDim }
local observeGeometry = require("./geometry_observation")

return function(
	Compose: typeof(ComposeTypes),
	runtime: ComposeTypes.Runtime,
	types: Engine.RobloxTypes,
	target: GuiObject?,
	node: GuiObject,
	options: { inset: boolean? }?
): GuiObject
	if target == nil then
		return node
	end
	local settings: { inset: boolean? } = options or {}
	local Host = (runtime.constructors :: unknown) :: Engine.Host
	local D2 = types.UDim2
	if target:FindFirstChildWhichIsA("UIPadding") == nil then
		runtime.mount(function()
			return Host.UIPadding({})
		end, target)
	end
	local container = Host.Frame(node.Name .. "Bounds")({
		Size = D2.fromOffset(0, 0),
		AnchorPoint = types.Vector2.new(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = false,
		ZIndex = node.ZIndex,
		node,
	})
	local boundary = Host.Frame(node.Name .. "Boundary")({
		Size = D2.fromOffset(1, 1),
		Position = D2.fromScale(1, 1),
		AnchorPoint = types.Vector2.new(1, 1),
		AutomaticSize = types.Enum.AutomaticSize.None,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = false,
		ZIndex = node.ZIndex,
		container,
	})
	local scale = (observeGeometry(Compose, runtime, boundary, "AbsoluteSize") :: unknown) :: ComposeTypes.Cell<Vector2>
	local size = (observeGeometry(Compose, runtime, target, "AbsoluteSize") :: unknown) :: ComposeTypes.Cell<Vector2>
	local at = (observeGeometry(Compose, runtime, target, "AbsolutePosition") :: unknown) :: ComposeTypes.Cell<Vector2>
	local boundaryAt = (
		observeGeometry(Compose, runtime, boundary, "AbsolutePosition") :: unknown
	) :: ComposeTypes.Cell<Vector2>
	local insets = Compose.cell({} :: Insets)
	local connections: { RBXScriptConnection }, paddingConnections: { RBXScriptConnection } = {}, {}
	local function disconnectPadding()
		for _, connection in paddingConnections do
			connection:Disconnect()
		end
		table.clear(paddingConnections)
	end
	local function paddingChanged()
		disconnectPadding()
		local padding = target:FindFirstChildWhichIsA("UIPadding")
		if padding == nil then
			insets:set({})
			return
		end
		local function refresh()
			local values: Insets = {}
			for _, side in { "Left", "Right", "Top", "Bottom" } do
				values[side] = padding:GetStyled("Padding" .. side) :: UDim
			end
			insets:set(values)
		end
		for _, side in { "Left", "Right", "Top", "Bottom" } do
			table.insert(paddingConnections, padding:GetStyledPropertyChangedSignal("Padding" .. side):Connect(refresh))
			table.insert(paddingConnections, padding:GetPropertyChangedSignal("Padding" .. side):Connect(refresh))
		end
		refresh()
	end
	local function childChanged(child: Instance)
		if child:IsA("UIPadding") then
			paddingChanged()
		end
	end
	table.insert(connections, target.ChildAdded:Connect(childChanged))
	table.insert(connections, target.ChildRemoved:Connect(childChanged))
	paddingChanged()
	Compose.cleanup(function()
		disconnectPadding()
		for _, connection in connections do
			connection:Disconnect()
		end
	end)
	local bounds = Compose.formula(function(use)
		local rendered, factor, padding = use(size), use(scale), use(insets)
		if factor.X <= 0 or factor.Y <= 0 then
			return { x = 0, y = 0, width = 0, height = 0 }
		end
		local pixels = types.Vector2.new(rendered.X / factor.X, rendered.Y / factor.Y)
		local distance = use(at) - use(boundaryAt)
		local offset = types.Vector2.new(distance.X / factor.X, distance.Y / factor.Y)
		local function inset(side: string, length: number): number
			local value = padding[side]
			return if value then value.Scale * length + value.Offset else 0
		end
		local left, top = inset("Left", pixels.X), inset("Top", pixels.Y)
		local right, bottom = inset("Right", pixels.X), inset("Bottom", pixels.Y)
		return if settings.inset
			then {
				x = offset.X + pixels.X - right,
				y = offset.Y + pixels.Y - bottom,
				width = math.max(0, pixels.X - left - right),
				height = math.max(0, pixels.Y - top - bottom),
			}
			else { x = offset.X + pixels.X, y = offset.Y + pixels.Y, width = pixels.X, height = pixels.Y }
	end)
	if target:IsA("ScrollingFrame") then
		local frame = target :: ScrollingFrame
		local canvas = (
			observeGeometry(Compose, runtime, frame, "CanvasPosition") :: unknown
		) :: ComposeTypes.Cell<Vector2>
		runtime.decorate(boundary, {
			Position = function(use: ComposeTypes.Use): UDim2
				local rendered: Vector2, factor: Vector2, at: Vector2 = use(size), use(scale), use(canvas)
				local padding: Insets = use(insets)
				if factor.X <= 0 or factor.Y <= 0 then
					return D2.fromScale(1, 1)
				end
				local width, height = rendered.X / factor.X, rendered.Y / factor.Y
				local function inset(side: string, length: number): number
					local value = padding[side]
					return if value then value.Scale * length + value.Offset else 0
				end
				return D2.fromOffset(
					at.X + width - inset("Left", width) - inset("Right", width),
					at.Y + height - inset("Top", height) - inset("Bottom", height)
				)
			end,
		})
	end
	runtime.decorate(container, {
		Size = function(use)
			local box: { width: number, height: number } = use(bounds)
			return if settings.inset
				then D2.fromOffset(math.ceil(box.width - 1e-3), math.ceil(box.height - 1e-3))
				else D2.fromOffset(box.width, box.height)
		end,
		Position = function(use)
			local box = use(bounds)
			return D2.fromOffset(box.x, box.y)
		end,
	})
	return boundary
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="140">
            <Properties>
              <string name="Name">nav_alert</string>
              <string name="Source"><![CDATA[--!strict
local layoutKit = require("./layout_kit")
local Types = require("./types")
local Nav = require("./navigation_types")
local materialize = require("./materialize")
local ComposeTypes = require("../vendor/compose/core")
local parts = require("./overlay_parts")
local ControlTypes = require("./control_types")
local NavigationProps = require("./navigation_props")
local reducedMotion = require("./motion").reduced
local surfaceParts = require("./nav_surface_parts")

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	surfaces: Nav.Surfaces,
	kit: surfaceParts.SurfaceParts
): ()
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local lists = layoutKit.of(ctx)
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local function presented<P>(
		spec: { isPresented: ComposeTypes.Cell<boolean>?, item: ComposeTypes.Cell<P?>? }
	): ComposeTypes.Body<boolean>
		assert(spec.isPresented or spec.item, "A presented control requires isPresented or item")
		return function(use: ComposeTypes.Use)
			return if spec.item then use(spec.item) ~= nil else use(assert(spec.isPresented))
		end
	end
	local function dismiss<P>(spec: {
		isPresented: ComposeTypes.Cell<boolean>?,
		item: ComposeTypes.Cell<P?>?,
		error: ComposeTypes.Cell<string?>?,
	}): ()
		if spec.item then
			spec.item:set(nil)
		end
		if spec.isPresented then
			spec.isPresented:set(false)
		end
		if spec.error and spec.error.set then
			spec.error:set(nil)
		end
	end

	local function alert<P>(spec: NavigationProps.AlertSpec<P>): Frame
		local function words(value: Nav.AlertText<P>?, payload: P): Types.ValueString?
			return if type(value) == "function" then value(payload) else value
		end
		local function actionsFor(
			value: ({ Nav.AlertAction<P> } | ((P) -> { Nav.AlertAction<P> }))?,
			payload: P
		): { Nav.AlertAction<P> }?
			return if type(value) == "function" then value(payload) else value
		end
		local root = kit.empty(spec, {
			"title",
			"message",
			"actions",
			"isPresented",
			"presenting",
			"item",
			"error",
			"icon",
			"severity",
			"suppression",
			"content",
			"maxWidth",
			"padding",
			"surface",
			"transition",
		}, "Alert")
		local fullScreen = spec.surface == "fullScreen"
		assert(
			spec.surface == nil or spec.surface == "dialog" or fullScreen,
			"Alert.surface must be dialog or fullScreen"
		)
		assert(
			spec.transition == nil or spec.transition == false or type(spec.transition) == "table",
			"Alert transition must be a table or false"
		)
		local transition: Nav.SourceTransition? = if type(spec.transition) == "table" then spec.transition else nil
		if transition then
			assert(
				type(transition) == "table",
				"Alert.transition requires Compose tween options and an optional native source"
			)
			for key in (transition :: unknown) :: { [string]: unknown } do
				assert(
					key == "source" or key == "seconds" or key == "ease",
					"Alert.transition supports source, seconds, ease"
				)
			end
		end
		local reduce = reducedMotion(ctx)
		local condition = presented(spec)
		local lastItem: P? = nil
		local generation = 0
		surfaces.attach(root, {
			surfaces.overlay(root, condition, function(phase: Nav.PresencePhase?): Instance
				if spec.suppression and spec.suppression.isSuppressed:peek() then
					dismiss(spec)
					return Host.Folder({})
				end
				local payload = (if spec.item then spec.item:peek() else read(spec.presenting)) :: P
				local actions: { Nav.AlertAction<P> } = actionsFor(spec.actions, payload)
					or { { id = "OK", label = "OK" } }
				assert(#actions > 0, "Alert requires at least one action")
				local cancel: Nav.AlertAction<P>?
				local initial: string?
				local identities: { [string]: boolean } = {}
				for _, action in actions do
					assert(
						type(action.id) == "string" and not identities[action.id],
						"Alert actions require unique ids"
					)
					identities[action.id] = true
					if action.role == "cancel" or action.shortcut == "cancelAction" then
						assert(cancel == nil, "Alert accepts one cancel action")
						cancel = action
					end
					if
						read(action.enabled) ~= false
						and action.role ~= "destructive"
						and (initial == nil or action.shortcut == "defaultAction")
					then
						initial = action.id
					end
				end
				local function activate(action: Nav.AlertAction<P>?): ()
					if action and read(action.enabled) == false then
						return
					end
					dismiss(spec)
					if action and action.onActivate then
						action.onActivate(payload)
					end
				end
				local offer = Compose.cell(V2.new(720, 720))
				local padding = spec.padding or 20
				local labelWidths = Compose.cell(0)
				local form = parts.stackedForm(ctx)
				local stacked = Compose.formula(function(use: ComposeTypes.Use)
					return #actions > 2
						or form(use)
						or use(offer).X < 480
						or use(labelWidths) > math.min(use(offer).X - 32, spec.maxWidth or 440) - padding * 2
				end)
				local contents: { Types.Child } = {}
				if spec.icon or spec.severity == "critical" or spec.error then
					table.insert(
						contents,
						ctx.icon(spec.icon or "status.warning", { Name = "AlertIcon", Size = D2.fromOffset(28, 28) })
					)
				end
				local title = words(spec.title, payload) or (spec.error and "Something went wrong")
				if title then
					local titleOrder = #contents + 1
					table.insert(
						contents,
						Compose.show(function(use: ComposeTypes.Use)
							return string.find(tostring(read(title, use)), "%S") ~= nil
						end, function()
							local heading = ctx.text({
								Name = "Title",
								Text = title,
								TextWrapped = true,
								TextXAlignment = E.TextXAlignment.Center,
								LayoutOrder = titleOrder,
								Size = D2.new(1, 0, 0, 0),
								AutomaticSize = E.AutomaticSize.Y,
							})
							heading:AddTag("facet-type-heading")
							return heading
						end)
					)
				end
				local message = words(spec.message, payload) or (spec.error and tostring(read(spec.error)))
				if message then
					table.insert(
						contents,
						ctx.styled(
							ctx.text({
								Name = "Message",
								Text = message,
								TextWrapped = true,
								TextXAlignment = E.TextXAlignment.Center,
								Size = D2.new(1, 0, 0, 0),
								AutomaticSize = E.AutomaticSize.Y,
							}),
							"secondary"
						)
					)
				end
				if spec.content then
					table.insert(contents, spec.content(payload))
				end
				local contentRoot = ctx.column(
					contents,
					{ Name = "AlertContent", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y }
				)
				local contentLayout = contentRoot:FindFirstChildWhichIsA("UIListLayout") :: UIListLayout?
				if contentLayout then
					contentLayout.HorizontalAlignment = E.HorizontalAlignment.Center
				end
				local contentHeight = Compose.cell(0)
				local actionProps: Types.FrameNativeProps = {
					Name = "Actions",
					BackgroundTransparency = 1,
					Size = D2.new(1, 0, 0, 0),
					AutomaticSize = E.AutomaticSize.Y,
					Host.UIListLayout({
						FillDirection = function(use: ComposeTypes.Use)
							return if use(stacked) then E.FillDirection.Vertical else E.FillDirection.Horizontal
						end,
						HorizontalFlex = function(use: ComposeTypes.Use)
							return if use(stacked) then E.UIFlexAlignment.None else E.UIFlexAlignment.Fill
						end,
						SortOrder = E.SortOrder.LayoutOrder,
						Padding = ctx.types.UDim.new(0, 8),
					}),
				}
				local textBounds: { ComposeTypes.Readable<Vector2> } = {}
				for index, action in actions do
					local button = UI.Button({
						Name = action.id,
						label = action.label,
						enabled = action.enabled,
						role = action.role,
						haptic = action.role == "destructive" or action.shortcut == "defaultAction",
						shortcut = if action.shortcut == "defaultAction"
							then { keyCode = "Return" }
							elseif type(action.shortcut) == "table" then action.shortcut
							else nil,
						Size = function(use: ComposeTypes.Use)
							return if use(stacked) then D2.new(1, 0, 0, 44) else D2.fromOffset(0, 44)
						end,
						AutomaticSize = E.AutomaticSize.None,
						LayoutOrder = function(use: ComposeTypes.Use)
							return if action.role == "cancel" then (if use(stacked) then #actions + 1 else 0) else index
						end,
						onActivate = function()
							activate(action)
						end,
					})
					actionProps[#actionProps + 1] = button
					table.insert(textBounds, ctx.observe.TextBounds(button))
				end
				Compose.watch(function(use: ComposeTypes.Use)
					local total = (#actions - 1) * 8
					for _, bounds in textBounds do
						total += use(bounds).X + 24
					end
					labelWidths:set(total)
				end)
				local actionBar: GuiObject = Host.Frame(actionProps)
				if spec.suppression then
					actionBar = ctx.column({
						actionBar,
						UI.Toggle "Suppression" {
							value = spec.suppression.isSuppressed,
							label = spec.suppression.label or "Do not show again",
						},
					}, { Name = "AlertFooter", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
				end
				local actionSize = ctx.layoutSize(actionBar)
				local function chrome(use: ComposeTypes.Use): number
					local package = read(ctx.config.theme, use)
					local recipe = if package and package.chrome then package.chrome.panel else nil
					local inset = if recipe then recipe.contentInsets else nil
					return padding * 2
						+ 8
						+ math.max(0, if inset then inset.top or 0 else 0)
						+ math.max(0, if inset then inset.bottom or 0 else 0)
				end
				local scroll, _, _, messageExtent, messageRested = parts.scroller(ctx, {
					Name = "AlertMessage",
					Selectable = false,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					ScrollingDirection = E.ScrollingDirection.Y,
					ScrollBarThickness = 4,
					VerticalScrollBarInset = E.ScrollBarInset.ScrollBar,
					Size = function(use: ComposeTypes.Use)
						if fullScreen then
							return D2.new(1, 0, 1, -use(actionSize).Y - 12)
						end
						return D2.new(
							1,
							0,
							0,
							math.min(
								use(contentHeight),
								math.max(44, math.floor(use(offer).Y - use(actionSize).Y - chrome(use) - 32))
							)
						)
					end,
				}, { lists.list({}, true) :: Instance, contentRoot :: Instance }, { rest = spec.transition == nil })
				local layout: GuiObject
				if fullScreen then
					local readable = V2.new(spec.maxWidth or 960, math.huge)
					runtime.decorate(actionBar, { AnchorPoint = V2.new(0.5, 1), Position = D2.fromScale(0.5, 1) })
					runtime.decorate(scroll, { AnchorPoint = V2.new(0.5, 0), Position = D2.fromScale(0.5, 0) })
					surfaces.attach(actionBar, { Host.UISizeConstraint "ReadableWidth" { MaxSize = readable } })
					surfaces.attach(scroll, { Host.UISizeConstraint "ReadableWidth" { MaxSize = readable } })
					layout = Host.Frame "AlertLayout" {
						BackgroundTransparency = 1,
						Size = function(use: ComposeTypes.Use)
							local destination = use(offer)
							return if destination.X > 0 and destination.Y > 0
								then D2.fromOffset(destination.X, destination.Y)
								else D2.fromScale(1, 1)
						end,
						scroll :: Instance,
						actionBar,
						ctx.padding(padding, padding),
					}
				else
					layout = ctx.column(
						{ scroll, actionBar, ctx.padding(padding, padding), ctx.corner() },
						{ Name = "AlertLayout", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y }
					)
				end
				local panel = ctx.styled(
					ctx.fade({
						Name = "AlertPanel",
						BackgroundTransparency = 0,
						BorderSizePixel = 0,
						Size = D2.fromScale(1, 1),
						layout,
					}, true),
					"alert"
				)
				if not fullScreen then
					surfaces.centered(panel, spec.maxWidth or 440)
				end
				ctx.styled(panel, if fullScreen then "pane" else "panel")
				surfaces.skin(panel, "panel")
				local settled = Compose.cell(false)
				local shown = if spec.transition == nil
					then surfaces.appearance(phase, ctx.motionTiming("dialog"), settled)
					else nil
				Compose.watch(function(use: ComposeTypes.Use)
					local height = use(messageExtent)
					if not use(messageRested) or shown == nil or shown.travel(use) >= 1 then
						contentHeight:set(height)
					end
					settled:set(use(messageRested) or #contents == 0)
				end)
				if shown then
					local presence = shown
					ctx.fadeTo(panel, function(use: ComposeTypes.Use)
						return 1 - presence.opacity(use)
					end)
					materialize(ctx, panel, {
						Size = if fullScreen then D2.fromScale(1, 1) else D2.new(1, -32, 0, 0),
						AutomaticSize = if fullScreen then E.AutomaticSize.None else E.AutomaticSize.Y,
					}, function(use: ComposeTypes.Use)
						local rest = ctx.metric("motion.materialize.modal", use)
						return if use(settled) then rest + (1 - rest) * presence.travel(use) else 1
					end, nil, true)
				end
				local modal = surfaces.modal(function()
					return panel
				end, function()
					if cancel and read(cancel.enabled) == false then
						dismiss(spec)
					else
						activate(cancel)
					end
				end, {
					Name = "AlertModal",
					initialFocus = initial,
					outsideDismiss = false,
					exiting = if phase then phase.exiting else nil,
					appearance = if shown then shown.opacity else nil,
				})
				if transition then
					local phase = assert(phase)
					local ready = Compose.cell(false)
					local source: GuiObject? = read(transition.source)
					local sourcePosition: ComposeTypes.Readable<Vector2> = if source
						then ctx.observe.AbsolutePosition(source)
						else Compose.cell(V2.zero)
					local sourceSize: ComposeTypes.Readable<Vector2> = if source
						then ctx.observe.AbsoluteSize(source)
						else Compose.cell(V2.zero)
					local origin = ctx.observe.AbsolutePosition(modal)
					local progress = runtime.tween(function(use: ComposeTypes.Use)
						return if use(phase.exiting) then 0 elseif use(ready) then 1 else 0
					end, { seconds = transition.seconds or ctx.metric("motion.normal"), ease = transition.ease })
					local function amount(use: ComposeTypes.Use): number
						return if reduce(use) then 1 else use(progress)
					end
					if fullScreen then
						local sourceParent = if source
							then ctx.observe.Parent(source)
							else Compose.cell(nil :: Instance?)
						local corner = ctx.Host.UICorner({ CornerRadius = ctx.types.UDim.new(0, 0) })
						local sourceCorner = if source then source:FindFirstChildWhichIsA("UICorner") else nil
						local radius = if sourceCorner then sourceCorner.CornerRadius.Offset else 12
						local snapshot = if source then source:Clone() else nil
						if snapshot then
							runtime.adopt(snapshot)
							local copies: { [Instance]: Instance } = {}
							local function match(original: Instance, clone: Instance): ()
								copies[original] = clone
								local children = clone:GetChildren()
								for _, child in original:GetChildren() do
									if child.Archivable then
										for index, candidate in children do
											if
												candidate.Name == child.Name
												and candidate.ClassName == child.ClassName
											then
												table.remove(children, index)
												match(child, candidate)
												break
											end
										end
									end
								end
							end
							match(assert(source), snapshot)
							for original, clone in copies do
								if original:IsA("ViewportFrame") and clone:IsA("ViewportFrame") then
									local camera = original.CurrentCamera
									local copied: Instance? = if camera then copies[camera] else nil
									clone.CurrentCamera = (
										if copied and copied:IsA("Camera")
											then copied
											elseif camera and not camera:IsDescendantOf(assert(source)) then camera
											else nil
									) :: Camera
								end
							end
							local nodes = snapshot:GetDescendants()
							table.insert(nodes, snapshot)
							for _, node in nodes do
								if node:IsA("GuiObject") then
									node.Interactable, node.Active, node.Selectable = false, false, false
								elseif node:IsA("UIDragDetector") then
									node.Enabled = false
								elseif node:IsA("InputContext") then
									node.Enabled = false
								end
							end
							runtime.decorate(snapshot, {
								Name = "SourceSnapshot",
								AnchorPoint = V2.zero,
								Position = D2.fromOffset(0, 0),
								Size = function(use: ComposeTypes.Use)
									local extent = use(sourceSize)
									return D2.fromOffset(extent.X, extent.Y)
								end,
								AutomaticSize = E.AutomaticSize.None,
							})
							surfaces.attach(panel, {
								ctx.fade {
									Name = "SourcePreview",
									BackgroundTransparency = 1,
									Size = D2.fromScale(1, 1),
									Interactable = false,
									ZIndex = 2,
									Visible = function(use: ComposeTypes.Use)
										return use(sourceParent) ~= nil and amount(use) < 0.35
									end,
									GroupTransparency = function(use: ComposeTypes.Use)
										return math.clamp(amount(use) / 0.35, 0, 1)
									end,
									snapshot,
								},
							})
						end
						runtime.decorate(layout, {
							Interactable = function(use: ComposeTypes.Use)
								return not use(phase.exiting) and amount(use) >= 0.65
							end,
						})
						runtime.decorate(panel, {
							AnchorPoint = V2.zero,
							AutomaticSize = E.AutomaticSize.None,
							ClipsDescendants = true,
							Position = function(use: ComposeTypes.Use)
								local t = amount(use)
								local at = if use(sourceParent) then use(sourcePosition) - use(origin) else V2.zero
								return D2.fromOffset(at.X * (1 - t), at.Y * (1 - t))
							end,
							Size = function(use: ComposeTypes.Use)
								local t, destination = amount(use), use(offer)
								local size = if use(sourceParent) then use(sourceSize) else destination
								return D2.fromOffset(
									size.X + (destination.X - size.X) * t,
									size.Y + (destination.Y - size.Y) * t
								)
							end,
						})
						ctx.fadeTo(panel, function(use: ComposeTypes.Use)
							return if use(sourceParent) then 0 else 1 - amount(use)
						end)
						runtime.decorate(corner, {
							CornerRadius = function(use: ComposeTypes.Use)
								return ctx.types.UDim.new(0, radius * (1 - amount(use)))
							end,
						})
						surfaces.attach(panel, { corner })
						local backdrop = modal:FindFirstChild("DismissOutside")
						local preferred = surfaces.preference()
						runtime.decorate(backdrop, {
							BackgroundTransparency = function(use: ComposeTypes.Use)
								return 1 - amount(use) * (1 - 0.35 * preferred(use))
							end,
						})
					else
						ctx.fadeTo(panel, function(use: ComposeTypes.Use)
							return 1 - amount(use)
						end)
						runtime.decorate(panel, {
							Position = function(use: ComposeTypes.Use)
								local size, at, box, offset, t =
									use(offer), use(sourcePosition), use(sourceSize), use(origin), amount(use)
								local x, y = size.X / 2, size.Y / 2
								if source and source.Parent then
									x = (at.X - offset.X + box.X / 2) * (1 - t) + x * t
									y = (at.Y - offset.Y + box.Y / 2) * (1 - t) + y * t
								end
								return D2.fromOffset(x, y)
							end,
						})
						materialize(ctx, panel, {
							Size = D2.new(1, -32, 0, 0),
							AutomaticSize = E.AutomaticSize.Y,
						}, function(use: ComposeTypes.Use)
							if not source then
								return 1
							end
							local t = amount(use)
							local width = math.max(1, math.min(use(offer).X - 32, spec.maxWidth or 440))
							return math.max(0.01, use(sourceSize).X / width) * (1 - t) + t
						end)
					end
					local parent = ctx.observe.Parent(modal)
					local measured = ctx.observe.AbsoluteSize(modal)
					Compose.watch(function(use: ComposeTypes.Use)
						local size = use(measured)
						if use(parent) and (not fullScreen or (size.X > 0 and size.Y > 0)) then
							ready:set(true)
						end
					end)
				end
				local bounds = ctx.observe.AbsoluteSize(modal)
				Compose.watch(function(use: ComposeTypes.Use)
					local size = use(bounds)
					if size.X > 0 and size.Y > 0 then
						offer:set(size)
					end
				end)
				return modal
			end, {
				presence = if transition
					then {
						exit = function(): ComposeTypes.Exiting
							if reduce() then
								return { completed = Compose.cell(true) }
							end
							local motion =
								runtime.timeline({ duration = read(transition.seconds) or ctx.metric("motion.normal") })
							return { completed = motion.completed }
						end,
					}
					else nil,
				motion = if spec.transition == nil then ctx.motionTiming("dialog") else nil,
				identity = if spec.item
					then function(use: ComposeTypes.Use): number
						local value = use(assert(spec.item))
						if value ~= nil and value ~= lastItem then
							lastItem = value
							generation += 1
						end
						return generation
					end
					else nil,
				failure = function(failure)
					root:SetAttribute("FacetError", tostring(failure))
					dismiss(spec)
					if ctx.config.onError then
						ctx.config.onError(failure)
					end
					return Host.Folder "FailedAlert" {}
				end,
			}),
		})
		return root
	end
	UI.Alert = ctx.construct("Alert", alert)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="141">
            <Properties>
              <string name="Name">nav_callout</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local parts = require("./overlay_parts")
local anchoredPlacement = require("./overlay_placement")
local Overlay = require("./overlay_types")
local NavigationProps = require("./navigation_props")
local surfaceParts = require("./nav_surface_parts")

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	surfaces: Nav.Surfaces,
	kit: surfaceParts.SurfaceParts
): ()
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local body = kit.body
	type CalloutRegistration = { id: number, eligible: ComposeTypes.Readable<boolean>, priority: number }
	local callouts = Compose.cell({} :: { CalloutRegistration })
	local nextCallout = 0

	UI.Callout = ctx.construct("Callout", function(spec: NavigationProps.CalloutSpec): Frame
		assert(type(spec.onRetire) == "function", "Callout requires onRetire")
		assert(spec.anchor, "Callout requires a native anchor")
		local where = "UI.Callout"
		parts.checkMedia(where, spec.media)
		local actionCount = parts.checkActions(ctx, where, spec.actions, 2)
		if spec.closeButton ~= nil and type(spec.closeButton) ~= "boolean" then
			error(`Facet {where}: closeButton must be true or false`, 0)
		end
		if spec.title ~= nil and not parts.bound(ctx, spec.title, "string") then
			error(`Facet {where}: title must be a string or a bound string`, 0)
		end
		local steps = spec.steps
		if steps ~= nil then
			local index = if type(steps) == "table" then steps.index else nil
			local count = if type(steps) == "table" then steps.count else nil
			local function whole(value: unknown): boolean
				return type(value) == "number" and value == math.floor(value) and value < math.huge
			end
			if
				not whole(index)
				or not whole(count)
				or (index :: number) < 1
				or (index :: number) > (count :: number)
			then
				error(`Facet {where}: steps must be \{ index, count } with whole numbers 1 <= index <= count`, 0)
			end
		end
		if spec.content == nil and spec.title == nil and spec.media == nil and steps == nil and actionCount == 0 then
			error(`Facet {where}: nothing to show. Supply content, or a title, media, steps or actions`, 0)
		end
		local input = surfaces.service("UserInputService")
		local preferred = if input and input.GetPropertyChangedSignal then ctx.observe.PreferredInput(input) else nil
		local calloutOwner = assert(Compose.currentOwner())
		local retired = Compose.cell(false)
		local anchorAvailable = surfaces.available(spec.anchor)
		local eligible = Compose.formula(function(use: ComposeTypes.Use)
			return use(anchorAvailable)
				and not use(retired)
				and read(spec.isPresented, use) ~= false
				and read(spec.seen, use) ~= true
				and read(spec.featureUsed, use) ~= true
				and (spec.afterSessions == nil or (read(spec.sessions, use) or 0) >= spec.afterSessions)
		end)
		nextCallout += 1
		local registration: CalloutRegistration =
			{ id = nextCallout, eligible = eligible, priority = spec.priority or 0 }
		local registered = table.clone(callouts:peek())
		table.insert(registered, registration)
		callouts:set(registered)
		Compose.cleanup(function()
			local next: { CalloutRegistration } = {}
			for _, entry in callouts:peek() do
				if entry ~= registration then
					table.insert(next, entry)
				end
			end
			callouts:set(next)
		end)
		local visible = Compose.formula(function(use: ComposeTypes.Use)
			local active: CalloutRegistration?
			for _, entry in use(callouts) do
				if use(entry.eligible) and (not active or entry.priority > active.priority) then
					active = entry
				end
			end
			return active == registration
		end)
		local root = kit.empty(spec, {
			"anchor",
			"content",
			"dismissLabel",
			"edge",
			"align",
			"tail",
			"priority",
			"seen",
			"sessions",
			"afterSessions",
			"featureUsed",
			"onRetire",
			"onShow",
			"onHide",
			"isPresented",
			"title",
			"media",
			"steps",
			"actions",
			"closeButton",
		}, "Callout")
		local plate: Instance? = nil
		local function retire(reason: Nav.CalloutRetirement): ()
			if retired:peek() or calloutOwner.isDisposed() then
				return
			end
			local gui = ctx.config.guiService
			local current = if gui then gui.SelectedObject else nil
			if
				gui
				and plate
				and current
				and current:IsDescendantOf(plate)
				and spec.anchor.Selectable
				and spec.anchor.Parent
			then
				gui.SelectedObject = spec.anchor
			end
			retired:set(true)
			spec.onRetire(reason)
		end
		Compose.watch(function(use: ComposeTypes.Use)
			if read(spec.featureUsed, use) == true then
				retire("featureUsed")
			elseif read(spec.seen, use) == true then
				retire("seen")
			end
		end)
		local short = ctx.metric("motion.fast")
		local timing: Nav.MotionTiming = { enter = short, exit = short }
		surfaces.attach(root, {
			surfaces.overlay(spec.anchor, visible, function(phase: Nav.PresencePhase?)
				local settled = Compose.cell(false)
				local presence = surfaces.appearance(phase, timing, settled)
				if spec.onShow then
					local ok: boolean, failure: unknown = pcall(spec.onShow)
					if not ok then
						if ctx.config.onError then
							ctx.config.onError(failure)
						else
							warn(`Facet UI.Callout: onShow failed: {tostring(failure)}`)
						end
					end
				end
				Compose.cleanup(function()
					if spec.onHide then
						spec.onHide(if retired:peek() then "retired" else "hidden")
					end
				end)
				local position, size = ctx.observe.AbsolutePosition(spec.anchor), ctx.observe.AbsoluteSize(spec.anchor)
				local rows: { Types.Child } = {}
				if spec.title ~= nil or spec.closeButton == true then
					local header: { Types.Child } = {}
					if spec.title ~= nil then
						local title = spec.title :: Types.Value<string>
						local heading = ctx.text({
							Name = "Title",
							Text = function(use: ComposeTypes.Use): string
								return read(title, use) or ""
							end,
							TextWrapped = true,
							Size = D2.new(1, 0, 0, 0),
							AutomaticSize = E.AutomaticSize.Y,
							Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }),
						})
						heading:AddTag("facet-type-heading")
						table.insert(header, heading)
					end
					if spec.closeButton == true then
						table.insert(
							header,
							UI.Button "Close" {
								name = "Close",
								icon = "close",
								Size = D2.fromOffset(44, 44),
								AutomaticSize = E.AutomaticSize.None,
								onActivate = function()
									retire("dismissed")
								end,
							}
						)
					end
					local row = ctx.row(
						header,
						{ Name = "Header", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y }
					)
					table.insert(rows, row)
				end
				if spec.media then
					table.insert(rows, parts.media(ctx, spec.media))
				end
				if spec.content ~= nil then
					table.insert(rows, body(spec.content))
				end
				if steps then
					table.insert(
						rows,
						ctx.styled(
							ctx.text({
								Name = "Steps",
								Text = function(use: ComposeTypes.Use): string
									return ctx.phrase(
										"Facet.IndexOf",
										"{current} of {count}",
										{ current = steps.index, count = steps.count },
										use
									)
								end,
							}),
							"secondary"
						)
					)
				end
				local actions: { Overlay.Action } = spec.actions or {}
				if #actions > 0 then
					local buttons: Types.FrameNativeProps = {
						Name = "Actions",
						BackgroundTransparency = 1,
						Size = D2.new(1, 0, 0, 0),
						AutomaticSize = E.AutomaticSize.Y,
					}
					buttons[#buttons + 1] = Host.UIListLayout({
						FillDirection = E.FillDirection.Horizontal,
						HorizontalFlex = E.UIFlexAlignment.Fill,
						SortOrder = E.SortOrder.LayoutOrder,
						Padding = ctx.types.UDim.new(0, 8),
					})
					for index, action in actions do
						buttons[#buttons + 1] = UI.Button({
							Name = action.id,
							label = action.label,
							role = action.role,
							enabled = action.enabled,
							busy = action.busy,
							LayoutOrder = index,
							onActivate = function()
								parts.call(action.onActivate, function()
									retire("action")
								end)
							end,
						})
					end
					table.insert(rows, Host.Frame(buttons))
				else
					table.insert(
						rows,
						UI.Button "Dismiss" {
							label = spec.dismissLabel or "Got it",
							onActivate = function()
								retire("dismissed")
							end,
						}
					)
				end
				table.insert(rows, ctx.padding(12, 12))
				local panel = ctx.styled(
					ctx.fade {
						Name = "CalloutPanel",
						GroupTransparency = function(use: ComposeTypes.Use)
							return 1 - presence.opacity(use)
						end,
						Size = D2.fromOffset(280, 0),
						AutomaticSize = E.AutomaticSize.Y,
						ctx.corner() :: Types.Child,
						ctx.column(rows, {
							Name = "CalloutContent",
							Size = D2.new(1, 0, 0, 0),
							AutomaticSize = E.AutomaticSize.Y,
						}) :: Types.Child,
					},
					"callout"
				)
				ctx.modalPortal(panel, spec.anchor)
				ctx.styled(panel, "panel")
				ctx.styled(panel, "floating")
				surfaces.skin(panel)
				local layer = assert(surfaces.parent(spec.anchor))
				local extent = ctx.observe.AbsoluteSize(layer)
				local origin = ctx.observe.AbsolutePosition(layer)
				local sizes, rested = surfaces.atRest(presence.travel, settled, { panel })
				local measured = sizes[1]
				local function held(use: ComposeTypes.Use): Vector2?
					return if use(rested) and presence.travel(use) < 1 then use(measured) else nil
				end
				local tailed = spec.tail ~= false and spec.tail ~= "none"
				local function lift(use: ComposeTypes.Use): number
					return 8 + (if tailed then parts.tailSize(ctx, use) * math.sqrt(2) / 2 else 0)
				end
				local function above(use: ComposeTypes.Use, floor: number): number
					use(position)
					local outermost = 0
					local at: Instance? = spec.anchor
					while at and at ~= layer do
						if at:IsA("GuiObject") then
							outermost = at.ZIndex
						end
						at = at.Parent
					end
					return math.max(floor, outermost + floor - 93)
				end
				local placement = Compose.formula(function(use: ComposeTypes.Use)
					local at, bounds, offer, offset, box =
						use(position), use(size), use(extent), use(origin), use(measured)
					local x = at.X - offset.X
					local y = at.Y - offset.Y
					local align = read(spec.align, use) or "center"
					local edge = read(spec.edge, use)
						or (if preferred and use(preferred) == E.PreferredInput.Touch then "top" else "bottom")
					local gutter = ctx.metric("space.s", use)
					local solved = anchoredPlacement.solve({
						source = { x = x, y = y, w = bounds.X, h = bounds.Y },
						size = { w = box.X, h = box.Y },
						safe = {
							x = gutter,
							y = gutter,
							w = math.max(0, offer.X - gutter * 2),
							h = math.max(0, offer.Y - gutter * 2),
						},
						edge = edge,
						align = if align == "leading" then "start" elseif align == "trailing" then "end" else "center",
						gap = lift(use),
						tail = if tailed then parts.tailSize(ctx, use) * math.sqrt(2) else 0,
						tailInset = ctx.metric("radii.panel", use),
					})
					return {
						left = solved.x,
						top = solved.y,
						edge = solved.edge,
						tailX = solved.tailX,
						tailY = solved.tailY,
						tailSuppressed = solved.tailSuppressed,
					}
				end)
				local panelGeometry: Types.FrameNativeProps = {
					AutomaticSize = function(use: ComposeTypes.Use)
						return if held(use) then E.AutomaticSize.None else E.AutomaticSize.Y
					end,
					Size = function(use: ComposeTypes.Use)
						local box = held(use)
						local at, bounds, offset, offer = use(position), use(size), use(origin), use(extent)
						local gutter = ctx.metric("space.s", use)
						local width = anchoredPlacement.width(
							{ x = at.X - offset.X, y = at.Y - offset.Y, w = bounds.X, h = bounds.Y },
							{ w = 280, h = use(measured).Y },
							{
								x = gutter,
								y = gutter,
								w = math.max(0, offer.X - gutter * 2),
								h = math.max(0, offer.Y - gutter * 2),
							},
							lift(use)
						)
						return D2.fromOffset(width, if box then math.ceil(box.Y) else 0)
					end,
					ZIndex = function(use: ComposeTypes.Use): number
						return above(use, 95)
					end,
				}
				runtime.decorate(panel, panelGeometry)
				local scale = surfaces.popover(
					panel,
					presence.travel,
					function(use: ComposeTypes.Use): (Vector2, Vector2)
						local at, anchorAt, anchorSize, offset, box =
							use(placement), use(position), use(size), use(origin), use(measured)
						local centerX = anchorAt.X - offset.X + anchorSize.X / 2 - at.left
						local centerY = anchorAt.Y - offset.Y + anchorSize.Y / 2 - at.top
						local pivot = if at.edge == "bottom"
							then V2.new(math.clamp(centerX, 0, box.X), 0)
							elseif at.edge == "top" then V2.new(math.clamp(centerX, 0, box.X), box.Y)
							elseif at.edge == "right" then V2.new(0, math.clamp(centerY, 0, box.Y))
							else V2.new(box.X, math.clamp(centerY, 0, box.Y))
						return V2.new(at.left, at.top), pivot
					end,
					{
						pinned = true,
						rested = rested,
						size = measured,
						geometry = { Size = panelGeometry.Size, AutomaticSize = panelGeometry.AutomaticSize },
					}
				)
				local arrow: { Frame }? = if tailed
					then parts.tail(
						ctx,
						"Arrow",
						function(use: ComposeTypes.Use): (Vector2?, string)
							local place = use(placement)
							if place.tailSuppressed or place.tailX == nil or place.tailY == nil then
								return nil, place.edge
							end
							return V2.new(place.tailX, place.tailY), place.edge
						end,
						presence.opacity,
						function(use: ComposeTypes.Use): number
							return above(use, 95)
						end,
						{
							node = panel,
							scale = scale,
							corner = function(use: ComposeTypes.Use): Vector2
								local place = use(placement)
								return V2.new(place.left, place.top)
							end,
							size = measured,
							radius = function(use: ComposeTypes.Use): number
								return ctx.metric("radii.panel", use)
							end,
							role = "floating",
						}
					)
					else nil
				local input = surfaces.service("UserInputService")
				if input then
					runtime.connect(input, "InputBegan", function(event: InputObject, processed: boolean)
						if
							processed
							or (
								event.UserInputType ~= E.UserInputType.MouseButton1
								and event.UserInputType ~= E.UserInputType.Touch
							)
						then
							return
						end
						local function hit(node: GuiObject): boolean
							local point, at, bounds = event.Position, node.AbsolutePosition, node.AbsoluteSize
							return point.X >= at.X
								and point.X <= at.X + bounds.X
								and point.Y >= at.Y
								and point.Y <= at.Y + bounds.Y
						end
						if not hit(panel) and not hit(spec.anchor) then
							retire("tapAway")
						end
					end)
				end
				local gui = ctx.config.guiService
				plate = panel
				if gui then
					local anchor = spec.anchor
					local selection = ctx.observe.SelectedObject(gui)
					local panelAt = ctx.observe.AbsolutePosition(panel)
					local linked: string? = nil
					local linkedTarget: GuiObject? = nil
					local function unlink()
						if
							linked
							and (
									(anchor :: unknown) :: { NextSelectionDown: GuiObject?, NextSelectionUp: GuiObject? }
								)["NextSelection" .. linked]
								== linkedTarget
						then
							((anchor :: unknown) :: { NextSelectionDown: GuiObject?, NextSelectionUp: GuiObject? })["NextSelection" .. linked] =
								nil
						end
						linked, linkedTarget = nil, nil
					end
					local rebuilt = Compose.cell(0)
					local leaving: Instance? = nil
					runtime.connect(panel, "DescendantAdded", function()
						leaving = nil
						rebuilt:set(rebuilt:peek() + 1)
					end)
					runtime.connect(panel, "DescendantRemoving", function(node: Instance)
						if linkedTarget and (node == linkedTarget or linkedTarget:IsDescendantOf(node)) then
							leaving = linkedTarget
							rebuilt:set(rebuilt:peek() + 1)
						end
					end)
					Compose.watch(function(use: ComposeTypes.Use)
						use(rebuilt)
						local below = (use(panelAt) :: Vector2).Y > anchor.AbsolutePosition.Y
						local direction = if below then "Down" else "Up"
						local found = surfaces.firstSelectable(panel)
						local target = if found == leaving then nil else found
						if linked ~= direction or linkedTarget ~= target then
							unlink()
							if
								target
								and (
										(
											anchor :: unknown
										) :: { NextSelectionDown: GuiObject?, NextSelectionUp: GuiObject? }
									)["NextSelection" .. direction]
									== nil
							then
								((anchor :: unknown) :: { NextSelectionDown: GuiObject?, NextSelectionUp: GuiObject? })["NextSelection" .. direction] =
									target
								linked, linkedTarget = direction, target
							end
						end
					end)
					Compose.cleanup(function()
						unlink()
						local current = gui.SelectedObject
						if current and current:IsDescendantOf(panel) then
							gui.SelectedObject = if anchor.Selectable and anchor.Parent then anchor else nil
						end
					end)
					ctx.action(panel, "CalloutBack", { E.KeyCode.Escape, E.KeyCode.ButtonB }, function(use)
						local current = use(selection) :: Instance?
						return current ~= nil and current:IsDescendantOf(panel)
					end, function()
						retire("dismissed")
					end, { priority = 2000 })
				end
				local overlayRoot = if arrow
					then Host.Folder "CalloutOverlay" { panel :: Instance, table.unpack(arrow) }
					else panel :: Instance
				surfaces.keep(spec.content)
				return overlayRoot
			end, { motion = timing }),
		})
		return root
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="142">
            <Properties>
              <string name="Name">nav_collapsible</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local Overlay = require("./overlay_types")
local InputProps = require("./input_props")
local NavigationProps = require("./navigation_props")
local surfaceParts = require("./nav_surface_parts")

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	surfaces: Nav.Surfaces,
	kit: surfaceParts.SurfaceParts
): ()
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local body = kit.body
	UI.CollapsibleView = ctx.construct(
		"CollapsibleView",
		function(spec: NavigationProps.CollapsibleViewSpec): TextButton
			assert(
				type(spec.expanded) == "table" and spec.expanded.set,
				"CollapsibleView.expanded requires a writable Compose cell"
			)
			local buttonSpec: InputProps.ButtonProps & {
				content: Nav.Content?,
				expanded: ComposeTypes.Cell<boolean>?,
				initialFocus: string?,
				dismissButton: Nav.Value<boolean>?,
				outsideDismiss: Nav.Value<boolean>?,
			} =
				table.clone(spec)
			buttonSpec.content = nil
			buttonSpec.expanded = nil
			buttonSpec.initialFocus = nil
			buttonSpec.dismissButton = nil
			buttonSpec.outsideDismiss = nil
			buttonSpec.ref = nil
			buttonSpec.trailingIcon = spec.trailingIcon or "chevron.down"
			buttonSpec.corners = spec.corners or "pill"
			buttonSpec.onActivate = function()
				spec.expanded:set(not spec.expanded:peek())
			end
			local root = UI.Button(buttonSpec)
			local input = surfaces.service("UserInputService")
			local preferred = if input
				then ctx.observe.PreferredInput(input) :: ComposeTypes.Readable<Enum.PreferredInput?>
				else Compose.cell(nil :: Enum.PreferredInput?)
			local prepared, entered = Compose.cell(false), Compose.cell(false)
			Compose.watch(function(use: ComposeTypes.Use)
				entered:set(use(spec.expanded) and use(prepared))
			end)
			local progress, closed, opacity = kit.revealMotion(entered)
			local function hidden(use: ComposeTypes.Use): number
				return if use(prepared) then opacity(use) else 1
			end
			local function collapse()
				spec.expanded:set(false)
			end
			local title = root:FindFirstChild("Title", true)
			if title and title:IsA("TextLabel") then
				runtime.decorate(title, { TextTruncate = E.TextTruncate.AtEnd, TextWrapped = false })
				runtime.mount(function()
					return Host.UIFlexItem({ FlexMode = E.UIFlexMode.Shrink })
				end, title)
			end
			local caret = root:FindFirstChild("TrailingIcon", true)
			if spec.trailingIcon == nil and caret and caret:IsA("GuiObject") then
				runtime.decorate(caret, {
					Rotation = function(use: ComposeTypes.Use)
						return 180 * progress(use)
					end,
				})
			end
			local rootBox, rootAt = ctx.observe.AbsoluteSize(root), ctx.observe.AbsolutePosition(root)
			surfaces.attach(root, {
				surfaces.overlay(root, spec.expanded, function(phase: Nav.PresencePhase?)
					prepared:set(false)
					Compose.cleanup(function()
						prepared:set(false)
					end)
					local layer = assert(surfaces.parent(root))
					local extent, origin = ctx.observe.AbsoluteSize(layer), ctx.observe.AbsolutePosition(layer)
					local column = ctx.column({
						body(spec.content),
						Compose.show(function(use: ComposeTypes.Use)
							return read(spec.dismissButton, use) ~= false or use(preferred) == E.PreferredInput.Gamepad
						end, function()
							return UI.Button "Close" { label = "Close", onActivate = collapse }
						end),
						ctx.padding(16, 16),
					}, { Name = "ExpandedBody", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
					local natural = ctx.observe.AbsoluteSize(column)
					local chrome = Compose.cell(V2.zero)
					local target = Compose.formula(function(use: ComposeTypes.Use): Overlay.Rect
						local room, offset, at, box = use(extent), use(origin), use(rootAt), use(rootBox)
						local margin = ctx.metric("space.s", use)
						local w = math.min(
							math.max(box.X, (ctx.metric("controls.popup.panelWidth", use))),
							math.max(0, room.X - 2 * margin)
						)
						local h =
							math.min(math.max(use(natural).Y + use(chrome).Y, box.Y), math.max(0, room.Y - 2 * margin))
						local x, y = at.X - offset.X, at.Y - offset.Y
						return {
							x = math.clamp(x, margin, math.max(margin, room.X - margin - w)),
							y = math.clamp(y, margin, math.max(margin, room.Y - margin - h)),
							w = w,
							h = h,
						}
					end)
					local function lerp(use: ComposeTypes.Use): Overlay.Rect
						local goal, at, offset = use(target), use(rootAt), use(origin)
						local t = if use(prepared) then progress(use) else 1
						local x, y = at.X - offset.X, at.Y - offset.Y
						return {
							x = x + (goal.x - x) * t,
							y = y + (goal.y - y) * t,
							w = goal.w,
							h = goal.h,
						}
					end
					local fade = ctx.fade {
						Name = "ExpandedFade",
						BackgroundTransparency = 1,
						Size = function(use: ComposeTypes.Use)
							local goal, inset = use(target), use(chrome)
							return D2.fromOffset(goal.w - inset.X, goal.h - inset.Y)
						end,
						GroupTransparency = 0,
						Host.ScrollingFrame "ExpandedScroll" {
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							Size = D2.fromScale(1, 1),
							CanvasSize = function(use: ComposeTypes.Use)
								return D2.fromOffset(0, use(natural).Y)
							end,
							ScrollingDirection = E.ScrollingDirection.Y,
							ScrollBarThickness = 4,
							VerticalScrollBarInset = E.ScrollBarInset.ScrollBar,
							Selectable = false,
							column,
						},
					}
					local plate = surfaces.skin(ctx.styled(
						ctx.fade {
							Name = "Expanded",
							GroupTransparency = hidden,
							Active = true,
							BackgroundTransparency = 0,
							ClipsDescendants = true,
							Position = function(use: ComposeTypes.Use)
								local rect = lerp(use)
								return D2.fromOffset(rect.x, rect.y)
							end,
							Size = function(use: ComposeTypes.Use)
								local rect = lerp(use)
								return D2.fromOffset(rect.w, rect.h)
							end,
							fade,
							Host.Frame "ContentBox" {
								BackgroundTransparency = 1,
								Interactable = false,
								Size = D2.fromScale(1, 1),
							},
							ctx.corner(),
						},
						"panel"
					))
					ctx.styled(plate, "floating")
					local content = assert(plate:FindFirstChild("ContentBox", true)) :: GuiObject
					local plateBox, contentBox = ctx.observe.AbsoluteSize(plate), ctx.observe.AbsoluteSize(content)
					Compose.watch(function(use: ComposeTypes.Use)
						use(plateBox)
						use(contentBox)
						local outer, inner = plate.AbsoluteSize, content.AbsoluteSize
						if inner.X > 0 and inner.Y > 0 then
							chrome:set(outer - inner)
						end
					end)
					surfaces.atRest(function()
						return 0
					end, prepared, { plate, fade, column, content })
					local modal = surfaces.modal(
						function()
							return plate
						end,
						collapse,
						{
							Name = "CollapsibleModal",
							outsideMargin = 0,
							outsideDismiss = spec.outsideDismiss,
							backgroundTransparency = 1,
							initialFocus = spec.initialFocus,
							exiting = if phase then phase.exiting else nil,
							appearance = progress,
						}
					)
					surfaces.keep(spec.content)
					return modal
				end, {
					presence = {
						exit = function(): ComposeTypes.Exiting
							return { completed = closed }
						end,
					},
				}),
			})
			return root
		end
	)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="143">
            <Properties>
              <string name="Name">nav_combo_box</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local Inputs = require("./input_types")
local ComposeTypes = require("../vendor/compose/core")
local NavigationProps = require("./navigation_props")
local MenuPanel = require("./nav_menu_panel")

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces)
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2 = ctx.types.Enum, ctx.types.UDim2
	local menuPanel = MenuPanel(ctx, UI, surfaces)
	local function writable(cell: { set: unknown }, name: string)
		assert(type(cell) == "table" and type(cell.set) == "function", name .. " requires a writable Compose cell")
	end
	UI.ComboBox = ctx.construct("ComboBox", function(spec: NavigationProps.ComboBoxSpec): Frame
		writable(spec.value, "ComboBox.value")
		writable(spec.text, "ComboBox.text")
		assert(type(spec.value:peek()) == "string", "ComboBox.value must be a string")
		assert(type(read(spec.options)) == "table", "ComboBox requires options")
		assert(type(spec.acceptCustom) == "function", "ComboBox requires acceptCustom")
		local errorText = Compose.cell("")
		local alive = true
		Compose.cleanup(function()
			alive = false
		end)
		local opened, editing = Compose.cell(false), Compose.cell(false)
		local navigating = false
		local popup: Frame?
		local gui = surfaces.service("GuiService")
		local function close()
			opened:set(false)
		end
		local function label(value: string): string
			for _, option in read(spec.options) do
				if (option.value or option.id) == value then
					return read(option.label)
				end
			end
			return value
		end
		local function update(value: string)
			close()
			errorText:set("")
			spec.text:set(label(value))
			if value ~= spec.value:peek() then
				spec.value:set(value)
				if spec.onChange then
					spec.onChange(value)
				end
			end
		end
		local function commit(text: string, reason: Inputs.CommitReason)
			if
				navigating
				or read(spec.enabled) == false
				or (reason == "focusLost" and spec.commitOnFocusLost ~= true)
			then
				return
			end
			for _, option in read(spec.options) do
				if read(option.label) == text then
					if read(option.enabled) == false then
						errorText:set("This option is unavailable.")
					else
						update(option.value or option.id)
					end
					return
				end
			end
			local ok, accepted, message = pcall(spec.acceptCustom, text)
			if not alive or read(spec.enabled) == false then
				return
			end
			if ok and accepted == true then
				update(text)
			else
				errorText:set(message or "This value is not accepted.")
			end
		end
		local function cancel()
			close()
			spec.text:set(label(spec.value:peek()))
			errorText:set("")
		end
		local created = UI.TextInput "Editor" {
			value = spec.text,
			placeholder = spec.placeholder,
			enabled = spec.enabled,
			Size = D2.new(1, -60, 1, 0),
			AutomaticSize = E.AutomaticSize.None,
			onCommit = function(value, reason)
				commit(value, reason)
				if reason == "submit" then
					close()
				end
			end,
			onCancel = cancel,
			onChange = function(value)
				spec.text:set(value)
				opened:set(true)
			end,
			Focused = function()
				editing:set(true)
			end,
			FocusLost = function()
				editing:set(false)
			end,
		}
		assert(created:IsA("TextBox"), "Facet ComboBox: the editor is a TextBox")
		local editor = created

		local function open()
			if read(spec.enabled) ~= false then
				opened:set(true)
			end
		end
		local triggerAttributes: Types.Attributes = { FacetLabel = "Suggestions" }
		local suggestions = Host.Frame "Suggestions" {
			BackgroundTransparency = 1,
			Position = D2.new(1, -56, 0, 0),
			Size = D2.new(0, 56, 1, 0),
			UI.Button "Trigger" {
				label = "",
				icon = "chevron.down",
				enabled = spec.enabled,
				Size = D2.fromScale(1, 1),
				AutomaticSize = E.AutomaticSize.None,
				Attributes = triggerAttributes,
				onActivate = function()
					if opened:peek() then
						close()
					else
						open()
					end
				end,
			},
		}
		local row = Host.Frame "Row" {
			BackgroundTransparency = 1,
			Size = D2.new(1, 0, 0, 44),
			editor :: Instance,
			suggestions,
		}
		local root = ctx.column(
			{
				row,
				Compose.show(function(use: ComposeTypes.Use)
					return use(errorText) ~= ""
				end, function()
					return ctx.text({ Name = "Validation", Text = errorText, TextWrapped = true, LayoutOrder = 2 })
				end),
			},
			ctx.props(spec, {
				"value",
				"text",
				"options",
				"enabled",
				"acceptCustom",
				"onChange",
				"commitOnFocusLost",
				"placeholder",
			}, {
				Name = "ComboBox",
				Size = D2.new(1, 0, 0, 44),
				AutomaticSize = E.AutomaticSize.Y,
			})
		)
		local available = surfaces.available(root)
		Compose.watch(function(use: ComposeTypes.Use)
			if not use(available) or read(spec.enabled, use) == false then
				close()
			end
		end)
		local choices = function(use: ComposeTypes.Use): { Nav.MenuItem<string> }
			local result: { Nav.MenuItem<string> } = {}
			local query = string.lower(use(spec.text))
			for _, option in read(spec.options, use) do
				if string.find(string.lower(read(option.label, use)), query, 1, true) then
					table.insert(result, {
						id = option.id or tostring(option.value),
						label = option.label,
						enabled = option.enabled,
						onSelect = function()
							update(option.value or option.id)
						end,
					})
				end
			end
			return result
		end
		surfaces.attach(root, {
			surfaces.overlay(row, function(use: ComposeTypes.Use)
				return use(opened) and #choices(use) > 0
			end, function()
				local panel = menuPanel({ items = choices, presentation = "menu" :: "menu" }, close, row, true)
				popup = panel
				Compose.cleanup(function()
					if gui and surfaces.within(gui.SelectedObject, panel) then
						gui.SelectedObject = if ctx.available(root) then editor else nil
					end
					popup = nil
				end)
				local input = surfaces.service("UserInputService")
				if input then
					runtime.connect(input, "InputBegan", function(event: InputObject)
						if
							event.UserInputType ~= E.UserInputType.MouseButton1
							and event.UserInputType ~= E.UserInputType.Touch
						then
							return
						end
						local function hit(node: GuiObject): boolean
							local at, size, point = node.AbsolutePosition, node.AbsoluteSize, event.Position
							return point.X >= at.X
								and point.Y >= at.Y
								and point.X <= at.X + size.X
								and point.Y <= at.Y + size.Y
						end
						local menu = panel:FindFirstChild("MenuPanel")
						if not hit(row) and menu and menu:IsA("GuiObject") and not hit(menu) then
							close()
						end
					end)
				end
				return panel
			end),
			Compose.show(function(use: ComposeTypes.Use)
				return use(editing) or use(opened)
			end, function()
				ctx.action(root, "ComboSuggestions", { E.KeyCode.Down, E.KeyCode.DPadDown }, editing, function()
					open()
					local panel = popup
					local target: GuiObject?
					if panel then
						for _, item in Compose.sample(choices) do
							if item.divider ~= true and read(item.enabled) ~= false then
								target = surfaces.firstSelectable(panel, item.id)
								if target then
									break
								end
							end
						end
					end
					if target and gui then
						navigating = true
						editor:ReleaseFocus(false)
						navigating = false
						gui.SelectedObject = target
					end
				end, { priority = 11000 })
				ctx.action(root, "ComboCancel", { E.KeyCode.Escape, E.KeyCode.ButtonB }, opened, function()
					cancel()
					if ctx.available(root) then
						editor:CaptureFocus()
					end
				end, { priority = 11000 })
				return Host.Folder({})
			end),
		})
		return root
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="144">
            <Properties>
              <string name="Name">nav_dialog</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local Overlay = require("./overlay_types")
local materialize = require("./materialize")
local ComposeTypes = require("../vendor/compose/core")
local parts = require("./overlay_parts")
local freeze = require("./freeze")
local OverlayProps = require("./overlay_props")

local KEYS = {
	"isPresented",
	"onPresentedChange",
	"onDismiss",
	"title",
	"content",
	"hero",
	"actionLabel",
	"actions",
	"actionLayout",
	"closeButton",
	"width",
	"contentSelectable",
}

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces): ()
	local Compose, Host, runtime, read = ctx.Compose, ctx.Host, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2

	local function blank(value: unknown): boolean
		return type(value) ~= "string" or string.match(value, "%S") == nil
	end

	local function keyboardHeight(input: UserInputService?): (ComposeTypes.Use) -> number
		if input == nil or not input.GetPropertyChangedSignal then
			return function()
				return 0
			end
		end
		local visible = ctx.observe.OnScreenKeyboardVisible(input)
		local size = ctx.observe.OnScreenKeyboardSize(input)
		return function(use: ComposeTypes.Use): number
			local extent = use(size)
			return if use(visible) == true and typeof(extent) == "Vector2" then (extent :: Vector2).Y else 0
		end
	end

	UI.Dialog = ctx.construct("Dialog", function(spec: OverlayProps.DialogSpec): Frame
		local where = "UI.Dialog"
		if spec.isPresented == nil then
			error(`Facet {where}: isPresented is required; it is the caller's boolean fact`, 0)
		end
		for _, key in { "onPresentedChange", "onDismiss" } do
			local value = (spec :: { [unknown]: unknown })[key]
			if value ~= nil and type(value) ~= "function" then
				error(`Facet {where}: {key} must be a function`, 0)
			end
		end
		if spec.closeButton ~= nil and type(spec.closeButton) ~= "boolean" then
			error(`Facet {where}: closeButton must be true or false`, 0)
		end
		local closeButton = if spec.closeButton ~= nil
			then spec.closeButton
			else spec.actions == nil or #spec.actions == 0
		if closeButton and spec.onPresentedChange == nil then
			error(
				`Facet {where}: the close button proposes a close and needs onPresentedChange. `
					.. "Without it, set closeButton = false. The backdrop and Cancel then do nothing.",
				0
			)
		end
		parts.checkPreset(ctx, where, "width", spec.width, parts.WIDTH_PRESETS)
		parts.checkPreset(ctx, where, "actionLayout", spec.actionLayout, parts.ACTION_LAYOUTS)
		if spec.contentSelectable ~= nil and type(spec.contentSelectable) ~= "boolean" then
			error(`Facet {where}: contentSelectable must be true or false`, 0)
		end
		if spec.content ~= nil and type(spec.content) ~= "function" then
			error(`Facet {where}: content must be a factory that returns the body`, 0)
		end
		for _, key in { "title", "actionLabel" } do
			local value = (spec :: { [unknown]: unknown })[key]
			if value ~= nil and not parts.bound(ctx, value, "string") then
				error(`Facet {where}: {key} must be a string or a bound string`, 0)
			end
		end
		parts.checkMedia(where, spec.hero)
		local actions = ((spec.actions or {}) :: unknown) :: { Overlay.Action }
		parts.checkActions(ctx, where, spec.actions, math.huge, nil, true)
		local cancelAction: Overlay.Action? = nil
		for _, action in actions do
			if action.role == "cancel" then
				cancelAction = action
			end
		end
		local function draws(value: unknown): boolean
			return value ~= nil and not (type(value) == "string" and blank(value))
		end
		if
			not draws(spec.title)
			and not draws(spec.actionLabel)
			and spec.hero == nil
			and spec.content == nil
			and #actions == 0
		then
			error(`Facet {where}: nothing to show. Supply a title, content, hero, actionLabel or actions`, 0)
		end

		local owner = assert(Compose.currentOwner())
		local root = Host.Frame(
			ctx.props(spec, KEYS, { Name = "Dialog", BackgroundTransparency = 1, Size = D2.fromOffset(0, 0) })
		)
		local function wanted(): boolean
			return read(spec.isPresented) == true
		end
		local condition = function(use: ComposeTypes.Use): boolean
			return read(spec.isPresented, use) == true
		end
		local closing: Overlay.DialogDismissReason? = nil
		local disposed = false
		local function report(reason: Overlay.DialogDismissReason)
			if spec.onDismiss then
				spec.onDismiss(reason)
			end
		end
		local function propose(nextValue: boolean, reason: Overlay.DialogDismissReason): boolean
			local change = spec.onPresentedChange
			if change == nil then
				return false
			end
			if not nextValue then
				closing = reason
			end
			local accepted = false
			parts.call(change, function()
				accepted = wanted() == nextValue
				if not accepted then
					closing = nil
				end
			end, nextValue)
			return accepted
		end
		local function press(action: Overlay.Action)
			if not parts.usable(ctx, action) then
				return
			end
			closing = "action"
			parts.call(action.onActivate, function()
				if wanted() then
					closing = nil
				end
			end)
			if wanted() and not ((action :: unknown) :: Overlay.DialogAction).keepOpen then
				propose(false, "action")
			end
		end
		local function cancel()
			if cancelAction and parts.usable(ctx, cancelAction) then
				press(cancelAction)
			else
				propose(false, "cancel")
			end
		end
		local input = surfaces.service("UserInputService")
		surfaces.attach(root, {
			surfaces.overlay(root, condition, function(phase: Nav.PresencePhase?)
				local layer = assert(surfaces.parent(root))
				local unit = ctx.layoutUnit(layer)
				local extent = ctx.layoutSize(layer, unit)
				local keyboardPixels = keyboardHeight(input)
				local function keyboard(use: ComposeTypes.Use): number
					return keyboardPixels(use) / use(unit)
				end
				local function margin(use: ComposeTypes.Use?): number
					return ctx.metric("space.m", use)
				end
				local function widthPx(use: ComposeTypes.Use): number
					return math.max(0, math.min(parts.width(ctx, spec.width, use), use(extent).X - 2 * margin(use)))
				end
				local function roomPx(use: ComposeTypes.Use): number
					return math.max(0, use(extent).Y - keyboard(use) - 4 * margin(use))
				end
				local regions: { GuiObject } = {}
				if spec.hero then
					table.insert(regions, parts.media(ctx, spec.hero, "Hero"))
				end
				local header: { Types.Child } = {}
				local plaqued = Compose.cell(false)
				if spec.title ~= nil then
					local title = spec.title
					local heading = ctx.text({
						Name = "Title",
						Text = function(use: ComposeTypes.Use)
							return read(title, use) or ""
						end,
						TextWrapped = true,
						Size = D2.new(1, 0, 0, 0),
						AutomaticSize = E.AutomaticSize.Y,
						Visible = function(use: ComposeTypes.Use)
							return not blank(read(title, use)) and not use(plaqued)
						end,
						Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }),
					})
					heading:AddTag("facet-type-heading")
					table.insert(header, heading)
				end
				if closeButton then
					table.insert(
						header,
						UI.Button "Close" {
							name = "Close",
							icon = "close",
							Size = D2.fromOffset(44, 44),
							AutomaticSize = E.AutomaticSize.None,
							onActivate = function()
								propose(false, "close")
							end,
						}
					)
				end
				if #header > 0 then
					local row = ctx.row(
						header,
						{ Name = "Header", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y }
					)
					local layout = row:FindFirstChildWhichIsA("UIListLayout") :: UIListLayout?
					if layout then
						layout.VerticalAlignment = E.VerticalAlignment.Center
					end
					table.insert(regions, row)
				end
				local body: ScrollingFrame? = nil
				local bodyContent: Frame? = nil
				if spec.content then
					local scroller, flow = parts.scroller(
						ctx,
						{
							Name = "Body",
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							ScrollBarThickness = 4,
							ScrollingDirection = E.ScrollingDirection.Y,
							Selectable = false,
						},
						{ Host.UIListLayout({ SortOrder = E.SortOrder.LayoutOrder }), spec.content() },
						{ name = "Content" }
					)
					bodyContent = flow
					body = scroller
					table.insert(regions, assert(body))
				end
				if spec.actionLabel ~= nil then
					local label = spec.actionLabel
					table.insert(
						regions,
						ctx.styled(
							ctx.text({
								Name = "ActionLabel",
								Text = function(use: ComposeTypes.Use)
									return read(label, use) or ""
								end,
								TextWrapped = true,
								Size = D2.new(1, 0, 0, 0),
								AutomaticSize = E.AutomaticSize.Y,
								Visible = function(use: ComposeTypes.Use)
									return not blank(read(label, use))
								end,
							}),
							"secondary"
						)
					)
				end
				local group: parts.ActionGroup? = nil
				if #actions > 0 then
					group = parts.actions(ctx, UI, actions, spec.actionLayout, function(use: ComposeTypes.Use)
						return widthPx(use) - 2 * margin(use)
					end, press)
					table.insert(regions, assert(group).frame)
				end
				local naturalSize: ComposeTypes.Readable<Vector2> = if bodyContent
					then ctx.layoutSize(bodyContent, unit)
					else Compose.cell(V2.zero)
				local room = parts.room(ctx, regions, body, function(use: ComposeTypes.Use): number
					return use(naturalSize).Y
				end, function(use: ComposeTypes.Use)
					return roomPx(use)
				end, false, unit)
				if body and spec.contentSelectable ~= false then
					local scroller = body
					runtime.decorate(scroller, { Selectable = room.overflowing })
					scroller:SetAttribute("FacetSelectionOwner", true)
					local gui = surfaces.service("GuiService")
					local selected: ComposeTypes.Readable<GuiObject?> = if gui
						then ctx.observe.SelectedObject(gui)
						else Compose.cell(nil :: GuiObject?)
					local canvas = ctx.observe.CanvasPosition(scroller)
					local window = ctx.observe.AbsoluteWindowSize(scroller)
					local content = ctx.observe.AbsoluteSize(assert(bodyContent))
					local function step(direction: number)
						local box = scroller.AbsoluteWindowSize.Y
						local limit = math.max(0, scroller.AbsoluteCanvasSize.Y - box)
						local at = scroller.CanvasPosition
						local target = math.clamp(at.Y + direction * math.max(1, box * 0.8), 0, limit)
						scroller.CanvasPosition = V2.new(at.X, target)
					end
					local function bind(name: string, direction: number, keys: { Enum.KeyCode })
						ctx.action(scroller, name, keys, function(use: ComposeTypes.Use)
							if use(selected) ~= (scroller :: GuiObject) or not use(room.overflowing) then
								return false
							end
							local y = use(canvas).Y
							local limit = math.max(0, use(content).Y - use(window).Y)
							return if direction > 0 then y < limit - 0.5 else y > 0.5
						end, function()
							step(direction)
						end, { priority = 3000, capture = true })
					end
					surfaces.attach(scroller, {
						Compose.show(room.overflowing, function()
							bind("DialogBodyDown", 1, { E.KeyCode.Down, E.KeyCode.DPadDown })
							bind("DialogBodyUp", -1, { E.KeyCode.Up, E.KeyCode.DPadUp })
							return Compose.fragment(function()
								return {}
							end)
						end),
					})
				end
				local settled = Compose.cell(false)
				local held: ComposeTypes.Cell<Vector2?> = Compose.cell(nil :: Vector2?)
				local shown = surfaces.appearance(phase, ctx.motionTiming("dialog"), settled)
				local panelProps: Types.CanvasGroupNativeProps = {
					Name = "Panel",
					AnchorPoint = V2.new(0.5, 0.5),
					Position = function(use: ComposeTypes.Use)
						return D2.new(0.5, 0, 0.5, -keyboard(use) / 2)
					end,
					Size = function(use: ComposeTypes.Use)
						local box = use(held)
						return D2.fromOffset(widthPx(use), if box then math.ceil(box.Y) else 0)
					end,
					AutomaticSize = function(use: ComposeTypes.Use)
						return if use(held) then E.AutomaticSize.None else E.AutomaticSize.Y
					end,
					BackgroundTransparency = 0,
					BorderSizePixel = 0,
					GroupTransparency = function(use: ComposeTypes.Use)
						return 1 - shown.opacity(use)
					end,
					room.frame :: Instance,
					ctx.padding(16, 16),
					ctx.corner(),
				}
				local panel = ctx.styled(ctx.fade(panelProps, true), "dialog")
				ctx.styled(panel, "panel")
				materialize(ctx, panel, panelProps, function(use: ComposeTypes.Use)
					local rest = ctx.metric("motion.materialize.modal", use)
					return if use(settled) then rest + (1 - rest) * shown.travel(use) else 1
				end, nil, true)
				local sizes, rested = surfaces.atRest(shown.travel, settled, { panel })
				Compose.watch(function(use: ComposeTypes.Use)
					held:set(if use(rested) and shown.travel(use) < 1 then use(sizes[1]) / use(unit) else nil)
				end)
				surfaces.skin(panel, "panel", {
					title = spec.title,
					onCaption = function(on: boolean)
						plaqued:set(on)
					end,
				})
				local initial: string? = if cancelAction and parts.usable(ctx, cancelAction)
					then cancelAction.id
					else nil
				if initial == nil then
					for _, action in actions do
						if action.role ~= "destructive" and parts.usable(ctx, action) then
							initial = action.id
							break
						end
					end
				end
				Compose.cleanup(function()
					if disposed or owner.isDisposed() then
						closing = nil
						report("cancel")
						return
					end
					local reason: Overlay.DialogDismissReason = closing or "cancel"
					closing = nil
					if wanted() then
						propose(false, "cancel")
						closing = nil
						report("cancel")
					else
						report(reason)
					end
				end)
				return surfaces.modal(function()
					return panel
				end, function()
					cancel()
				end, {
					Name = "DialogModal",
					initialFocus = initial,
					onOutside = function()
						propose(false, "outside")
					end,
					exiting = if phase then phase.exiting else nil,
					appearance = shown.opacity,
				})
			end, { motion = ctx.motionTiming("dialog") }),
		})
		Compose.cleanup(function()
			disposed = true
		end)
		return root
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="145">
            <Properties>
              <string name="Name">nav_disclosure</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local NavigationProps = require("./navigation_props")
local surfaceParts = require("./nav_surface_parts")

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	surfaces: Nav.Surfaces,
	kit: surfaceParts.SurfaceParts
): ()
	local Host, Compose, runtime = ctx.Host, ctx.Compose, ctx.runtime
	local E, D2 = ctx.types.Enum, ctx.types.UDim2
	local body = kit.body
	UI.DisclosureGroup = ctx.construct("DisclosureGroup", function(spec: NavigationProps.DisclosureGroupSpec): Frame
		assert(
			type(spec.expanded) == "table" and spec.expanded.set,
			"DisclosureGroup.expanded requires a writable Compose cell"
		)
		local gui = surfaces.service("GuiService")
		local side = spec.chevronPosition or "leading"
		assert(side == "leading" or side == "trailing", "Invalid DisclosureGroup.chevronPosition")
		assert(
			spec.appearance == nil or table.find({ "plain", "contained", "divided", "outline" }, spec.appearance),
			"Invalid DisclosureGroup.appearance"
		)
		local indent = spec.indent
		assert(
			indent == nil
				or (type(indent) == "number" and indent >= 0 and indent < math.huge)
				or (type(indent) == "string" and table.find({ "xs", "s", "m", "l", "xl" }, indent) ~= nil),
			"DisclosureGroup.indent must be a spacing step or a number of pixels"
		)
		local function chevron(use: ComposeTypes.Use): string
			return if use(spec.expanded) then "chevron.down" else "chevron.trailing"
		end
		local header = UI.Button "Header" {
			label = spec.label,
			icon = if side == "leading" then chevron else spec.icon,
			trailingIcon = if side == "trailing" then chevron else spec.icon,
			subtitle = spec.description,
			enabled = spec.enabled,
			textSize = spec.textSize,
			Size = D2.new(1, 0, 0, 44),
			selected = if spec.appearance == "outline" then nil else spec.expanded,
			appearance = if spec.appearance == "outline" then "utility" else nil,
			TextXAlignment = if spec.appearance == "outline" then E.TextXAlignment.Left else nil,
			onActivate = function()
				local value = not spec.expanded:peek()
				spec.expanded:set(value)
				if spec.onToggle then
					spec.onToggle(value)
				end
			end,
		}

		local headerContent = header:FindFirstChild("Content")
		local headerLayout = headerContent and headerContent:FindFirstChildWhichIsA("UIListLayout")
		if headerContent and headerLayout then
			headerLayout.HorizontalAlignment = E.HorizontalAlignment.Left
			local captions = headerContent:FindFirstChild("Captions")
			local words = captions or headerContent:FindFirstChild("Title")
			if words and (side == "trailing" or captions) then
				runtime.mount(function()
					return Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill })
				end, words)
			end
			local caption = captions and captions:FindFirstChild("Description")
			if caption and caption:IsA("TextLabel") then
				caption.TextWrapped = true
			end
		end

		local progress, closed, hidden = kit.revealMotion(spec.expanded)
		local caret = header:FindFirstChild(if side == "leading" then "LeadingIcon" else "TrailingIcon", true)
		if caret and caret:IsA("GuiObject") then
			runtime.decorate(caret, {
				Rotation = function(use: ComposeTypes.Use)
					local amount = progress(use)
					return if use(spec.expanded) then -90 * (1 - amount) else 90 * amount
				end,
			})
		end

		local root = ctx.column(
			{
				header,
				Compose.presence(spec.expanded, function(phase: Nav.PresencePhase)
					local node: Instance = body(spec.content)
					if spec.appearance == "divided" then
						node = ctx.column({
							ctx.styled(
								Host.Frame "Divider" { BorderSizePixel = 0, Size = D2.new(1, 0, 0, 1) },
								"divider"
							),
							node,
						})
					end
					local outline = spec.appearance == "outline"
					local function side(use: ComposeTypes.Use): number
						return if outline then 0 else ctx.controlSize(nil, "paddingX", use)
					end
					local inset = Host.UIPadding({
						PaddingTop = ctx.types.UDim.new(0, 8),
						PaddingBottom = ctx.types.UDim.new(0, 8),
						PaddingRight = function(use: ComposeTypes.Use)
							return ctx.types.UDim.new(0, side(use))
						end,
						PaddingLeft = function(use: ComposeTypes.Use)
							local step = indent
							return ctx.types.UDim.new(
								0,
								if type(step) == "number"
									then step
									elseif step then ctx.metric("space." .. step, use)
									else side(use)
							)
						end,
					})
					local fade = ctx.fade({
						Name = "RevealFade",
						BackgroundTransparency = 1,
						Size = D2.new(1, 0, 0, 0),
						AutomaticSize = E.AutomaticSize.Y,
						GroupTransparency = hidden,
						node,
					}, nil, false)
					surfaces.attach(fade, { inset :: Types.Child })
					local automatic, height = kit.unroll(progress, ctx.observe.AbsoluteSize(fade))
					local reveal = Host.Frame "Reveal" {
						BackgroundTransparency = 1,
						ClipsDescendants = true,
						LayoutOrder = 2,
						Interactable = function(use: ComposeTypes.Use)
							return not use(phase.exiting)
						end,
						AutomaticSize = automatic,
						Size = function(use: ComposeTypes.Use)
							return D2.new(1, 0, 0, height(use) or 0)
						end,
						fade,
					}
					local function handBack()
						if gui and surfaces.within(gui.SelectedObject, reveal) and header.Parent then
							gui.SelectedObject = header
						end
					end
					Compose.watch(function(use: ComposeTypes.Use)
						if use(phase.exiting) then
							handBack()
						end
					end)
					Compose.cleanup(handBack)
					surfaces.keep(spec.content)
					return reveal
				end, {
					exit = function()
						return { completed = closed }
					end,
				}),
			},
			ctx.props(spec, {
				"label",
				"expanded",
				"content",
				"enabled",
				"onToggle",
				"description",
				"icon",
				"chevronPosition",
				"appearance",
				"controlSize",
				"textSize",
				"indent",
			}, { Name = "DisclosureGroup", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
		)
		local rhythm = root:FindFirstChildWhichIsA("UIListLayout")
		if rhythm then
			runtime.decorate(rhythm, { Padding = ctx.types.UDim.new(0, 0) })
		end
		ctx.styled(root, "disclosure-group")
		if spec.appearance == "contained" then
			ctx.styled(root, "panel")
			runtime.decorate(root, { BackgroundTransparency = 0 })
			surfaces.skin(root, "panel")
		end
		if spec.appearance then
			ctx.styled(root, "disclosure-" .. spec.appearance)
		end
		return root
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="146">
            <Properties>
              <string name="Name">nav_help</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local help = require("./help")
local Inputs = require("./input_types")
local placement = require("./overlay_placement")
local parts = require("./overlay_parts")
local surfaceKit = require("./nav_surface_kit")
local overlayPresence = require("./nav_overlay_presence")
local overlayPortal = require("./nav_overlay_portal")
local popoverPlacement = require("./nav_popover_placement")
local textMeasure = require("./text_measure")

local HELP_DWELL = 0.45

return function(
	ctx: Types.Context,
	kit: surfaceKit.Kit,
	presence: overlayPresence.Presence,
	portal: overlayPortal.Portal,
	popover: popoverPlacement.Popover
): ()
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local gui, input = kit.gui, kit.input
	local appearance, atRest = presence.appearance, presence.atRest
	local overlay, parent = portal.overlay, portal.parent
	local helpPointer = Compose.createSharedResource(function()
		local buttons: { [string]: boolean } = {}
		local pressed = Compose.cell(false)
		local activity = Compose.cell(0)
		local focused = Compose.cell(true)
		local function mouseButton(kind: Enum.UserInputType): boolean
			return kind == E.UserInputType.MouseButton1
				or kind == E.UserInputType.MouseButton2
				or kind == E.UserInputType.MouseButton3
		end
		local function disturb()
			activity:set(activity:peek() + 1)
		end
		local function begin(event: InputObject)
			if mouseButton(event.UserInputType) then
				buttons[event.UserInputType.Name] = true
				pressed:set(true)
				disturb()
			end
		end
		local function finish(event: InputObject)
			if mouseButton(event.UserInputType) then
				buttons[event.UserInputType.Name] = nil
				pressed:set(next(buttons) ~= nil)
				disturb()
			end
		end
		local function change(event: InputObject)
			if
				event.UserInputType == E.UserInputType.MouseMovement
				or event.UserInputType == E.UserInputType.MouseWheel
			then
				disturb()
			end
		end
		if input then
			if input.GetMouseButtonsPressed then
				for _, event in input:GetMouseButtonsPressed() do
					begin(event)
				end
			end
			runtime.connect(input, "InputBegan", begin)
			runtime.connect(input, "InputEnded", finish)
			runtime.connect(input, "InputChanged", change)
		end
		local window = ctx.config.inputParent
		local focusSource = if window and window:IsA("PluginGui") then window else input
		if focusSource then
			runtime.connect(focusSource, "WindowFocusReleased", function()
				focused:set(false)
				table.clear(buttons)
				pressed:set(false)
				disturb()
			end)
			runtime.connect(focusSource, "WindowFocused", function()
				focused:set(true)
				disturb()
			end)
		end
		return {
			pressed = pressed,
			activity = activity,
			focused = focused,
			begin = begin,
			finish = finish,
			change = change,
			disturb = disturb,
		}
	end)
	help.register(ctx, function(anchor: GuiObject, value: Inputs.Help, plate: help.Plate?)
		local structured: Inputs.HelpSpec? = if type(value) == "table" and not Compose.isReadable(value)
			then value :: Inputs.HelpSpec
			else nil
		local text: Types.Value<string> = if structured then structured.body else value :: Types.Value<string>
		local gate = plate and plate.gate
		local state = ctx.observe.GuiState(anchor)
		local selection = if gui and gui.GetPropertyChangedSignal then ctx.observe.SelectedObject(gui) else nil
		local preferred = if input and input.GetPropertyChangedSignal then ctx.observe.PreferredInput(input) else nil
		local held = Compose.cell(false)
		local touchOffset: ComposeTypes.Cell<Vector2?> = Compose.cell(nil :: Vector2?)
		local function press(points: { Vector2 }, phase: Enum.UserInputState)
			if phase == E.UserInputState.Begin and ctx.read(gate) ~= false then
				local point = points[1]
				touchOffset:set(if point then point - anchor.AbsolutePosition else anchor.AbsoluteSize / 2)
				held:set(true)
				help.hold(anchor, true)
			end
		end
		if anchor:IsA("GuiButton") then
			runtime.connect(anchor, "TouchLongPress", function(points: { Vector2 }, phase: Enum.UserInputState)
				press(points, phase)
			end)
		elseif input then
			runtime.connect(input, "TouchLongPress", function(points: { Vector2 }, phase: Enum.UserInputState)
				local point: Vector2? = points[1]
				local layer = anchor:FindFirstAncestorWhichIsA("ScreenGui")
				if point == nil or layer == nil or not kit.displayed(anchor) then
					return
				end
				local offset = if layer.IgnoreGuiInset and gui then gui:GetGuiInset() else V2.zero
				local at, size = anchor.AbsolutePosition - offset, anchor.AbsoluteSize
				if point.X >= at.X and point.X <= at.X + size.X and point.Y >= at.Y and point.Y <= at.Y + size.Y then
					press({ point + offset }, phase)
				end
			end)
		end
		runtime.connect(anchor, "InputBegan", function()
			help.hold(anchor, false)
		end)
		local pointer = helpPointer()
		runtime.connect(anchor, "InputBegan", pointer.begin)
		runtime.connect(anchor, "InputEnded", pointer.finish)
		runtime.connect(anchor, "InputChanged", pointer.change)
		runtime.connect(anchor, "MouseMoved", pointer.disturb)
		Compose.watch(function(use: ComposeTypes.Use)
			if use(pointer.pressed) or not use(pointer.focused) then
				held:set(false)
				touchOffset:set(nil)
			end
		end)
		if input then
			runtime.connect(input, "InputBegan", function(event: InputObject)
				if held:peek() and event.UserInputType == E.UserInputType.Touch then
					held:set(false)
					touchOffset:set(nil)
				end
			end)
		end
		local wanted = Compose.formula(function(use: ComposeTypes.Use): boolean
			local kind = if preferred then use(preferred) else nil
			if kind == E.PreferredInput.Touch or use(pointer.pressed) or not use(pointer.focused) then
				return false
			end
			local selected = if selection then use(selection) else nil
			return use(state) == E.GuiState.Hover
				or (selected ~= nil and (selected == anchor or anchor:IsDescendantOf(selected)))
		end)
		local rest = runtime.timeline({ duration = HELP_DWELL, autoplay = false })
		Compose.watch(function(use: ComposeTypes.Use)
			if use(wanted) then
				use(pointer.activity)
				rest:restart()
			else
				rest:pause()
				rest:seek(0)
			end
		end)
		local armed = Compose.formula(function(use: ComposeTypes.Use): boolean
			return ctx.read(gate, use) ~= false and (use(held) or (use(wanted) and use(rest.progress) >= 1))
		end)
		local shown = plate and plate.shown
		if shown then
			Compose.watch(function(use: ComposeTypes.Use)
				shown:set(use(armed))
			end)
		end
		local timing: Nav.MotionTiming = { enter = ctx.metric("motion.normal"), exit = ctx.metric("motion.fast") }
		kit.attach(anchor, {
			overlay(anchor, armed, function(phase: Nav.PresencePhase?)
				local settled = Compose.cell(false)
				local presence = appearance(phase, timing, settled)
				local layer = assert(parent(anchor))
				local at, bounds = ctx.observe.AbsolutePosition(anchor), ctx.observe.AbsoluteSize(anchor)
				local extent, origin = ctx.observe.AbsoluteSize(layer), ctx.observe.AbsolutePosition(layer)
				local widths = Compose.cell({} :: { ComposeTypes.Readable<Vector2> })
				local function width(use: ComposeTypes.Use): UDim2
					local widest = 0
					for _, natural in use(widths) do
						widest = math.max(widest, use(natural).X)
					end
					return D2.fromOffset(math.min(264, math.max(0, use(extent).X - 32), widest), 0)
				end
				local function wrap(label: TextLabel): TextLabel
					local nextWidths = table.clone(widths:peek())
					table.insert(nextWidths, textMeasure.natural(ctx, label))
					widths:set(nextWidths)
					runtime.decorate(label, {
						TextWrapped = true,
						Size = width,
						AutomaticSize = E.AutomaticSize.Y,
					})
					return label
				end
				local label = wrap(ctx.text({
					Name = "HelpText",
					Text = function(use: ComposeTypes.Use)
						return ctx.read(text, use) or ""
					end,
					TextWrapped = true,
				}))
				label:AddTag("facet-type-caption")
				local panelProps: Types.CanvasGroupNativeProps = {
					Name = plate and plate.name or "Help",
					GroupTransparency = function(use: ComposeTypes.Use)
						return 1 - presence.opacity(use)
					end,
					AutomaticSize = E.AutomaticSize.XY,
					Size = D2.fromOffset(0, 0),
					ZIndex = 96,
				}
				panelProps[#panelProps + 1] = ctx.padding(8, 6)
				panelProps[#panelProps + 1] =
					Host.UIListLayout({ SortOrder = E.SortOrder.LayoutOrder, Padding = ctx.types.UDim.new(0, 4) })
				if structured and structured.title ~= nil then
					local title = structured.title
					local heading = wrap(ctx.text({
						Name = "HelpTitle",
						LayoutOrder = 1,
						Text = function(use: ComposeTypes.Use)
							return ctx.read(title, use) or ""
						end,
					}))
					heading:AddTag("facet-type-heading")
					panelProps[#panelProps + 1] = heading
				end
				runtime.decorate(label, {
					LayoutOrder = 2,
					Visible = function(use: ComposeTypes.Use)
						return (ctx.read(text, use) or "") ~= ""
					end,
				})
				panelProps[#panelProps + 1] = label
				if structured and structured.shortcut then
					local chords: { string } = {}
					for _, chord in structured.shortcut do
						table.insert(chords, table.concat(chord, "+"))
					end
					local hint = wrap(ctx.text({
						Name = "HelpShortcut",
						LayoutOrder = 3,
						Text = table.concat(chords, " or "),
					}))
					hint:AddTag("facet-type-caption")
					hint:AddTag("facet-secondary")
					panelProps[#panelProps + 1] = hint
				end
				local panel = ctx.fade(panelProps, true)
				local sizes, rested = atRest(presence.travel, settled, { panel, label })
				local measured = sizes[1]
				local edge = if structured and structured.edge then structured.edge else "top"
				local align = if structured and structured.align then structured.align else "center"
				local solution = Compose.formula(function(use: ComposeTypes.Use): placement.Placement
					local anchorAt, anchorSize, offer, offset, box =
						use(at), use(bounds), use(extent), use(origin), use(measured)
					local side = parts.tailSize(ctx, use)
					local contact = use(touchOffset)
					if contact then
						local point = anchorAt + contact - offset
						return placement.touch(
							{ x = point.X, y = point.Y },
							{ w = box.X, h = box.Y },
							{ x = 8, y = 8, w = math.max(0, offer.X - 16), h = math.max(0, offer.Y - 16) },
							ctx.metric("targetSizes.minimum", use) + ctx.metric("space.s", use)
						)
					end
					return placement.solve({
						source = {
							x = anchorAt.X - offset.X,
							y = anchorAt.Y - offset.Y,
							w = anchorSize.X,
							h = anchorSize.Y,
						},
						size = { w = box.X, h = box.Y },
						safe = { x = 8, y = 8, w = math.max(0, offer.X - 16), h = math.max(0, offer.Y - 16) },
						edge = edge,
						align = align,
						gap = 6 + side * math.sqrt(2) / 2,
						tail = side * math.sqrt(2),
						tailInset = 6,
					})
				end)
				ctx.styled(panel, "tooltip")
				local scale = popover(panel, presence.travel, function(use: ComposeTypes.Use): (Vector2, Vector2)
					local anchorAt, anchorSize, offset, box = use(at), use(bounds), use(origin), use(measured)
					local solved = use(solution)
					local centerX = anchorAt.X - offset.X + anchorSize.X / 2 - solved.x
					local centerY = anchorAt.Y - offset.Y + anchorSize.Y / 2 - solved.y
					local origin = if solved.edge == "bottom"
						then V2.new(math.clamp(centerX, 0, box.X), 0)
						elseif solved.edge == "top" then V2.new(math.clamp(centerX, 0, box.X), box.Y)
						elseif solved.edge == "right" then V2.new(0, math.clamp(centerY, 0, box.Y))
						else V2.new(box.X, math.clamp(centerY, 0, box.Y))
					return V2.new(solved.x, solved.y), origin
				end, {
					pinned = true,
					rested = rested,
					size = measured,
					geometry = { Size = panelProps.Size, AutomaticSize = panelProps.AutomaticSize },
				})
				local tail = parts.tail(
					ctx,
					"HelpTail",
					function(use: ComposeTypes.Use): (Vector2?, string)
						local solved = use(solution)
						if solved.tailSuppressed or solved.tailX == nil or solved.tailY == nil then
							return nil, solved.edge
						end
						return V2.new(solved.tailX, solved.tailY), solved.edge
					end,
					presence.opacity,
					function()
						return 96
					end,
					{
						node = panel,
						scale = scale,
						corner = function(use: ComposeTypes.Use): Vector2
							local solved = use(solution)
							return V2.new(solved.x, solved.y)
						end,
						size = measured,
						radius = function(use: ComposeTypes.Use): number
							return math.min(6, (ctx.metric("radii.control", use)))
						end,
						role = "tooltip",
					}
				)
				return Host.Folder "HelpOverlay" { panel :: Instance, table.unpack(tail) }
			end, { motion = timing }),
		})
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="147">
            <Properties>
              <string name="Name">nav_menu</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local activation = require("./activation")
local ComposeTypes = require("../vendor/compose/core")
local ControlTypes = require("./control_types")
local InputProps = require("./input_props")
local NavigationProps = require("./navigation_props")
local MenuItems = require("./nav_menu_items")
local MenuPanel = require("./nav_menu_panel")
local registerPicker = require("./nav_picker")
local registerSplitButton = require("./nav_split_button")
local registerComboBox = require("./nav_combo_box")

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces): ()
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local itemModel = MenuItems(ctx)
	local checkWidth, menuItems, advice = itemModel.checkWidth, itemModel.menuItems, itemModel.advice
	local menuPanel = MenuPanel(ctx, UI, surfaces)
	local MENU_KEYS = {
		"items",
		"query",
		"label",
		"disclosure",
		"trigger",
		"triggers",
		"presentation",
		"backLabel",
		"onOpen",
		"onClose",
		"closeButton",
		"enabled",
		"isPresented",
		"edge",
		"align",
		"width",
		"maxHeight",
		"controls",
	}
	local function buildMenu<V>(spec: NavigationProps.MenuSpec<V>, wrap: boolean): GuiObject
		assert(
			spec.closeButton == nil or type(spec.closeButton) == "boolean",
			"Facet UI.Menu: closeButton must be a boolean"
		)
		assert(spec.items ~= nil, "Menu requires items")
		menuItems(read(spec.items))
		assert(
			spec.edge == nil or table.find({ "top", "bottom", "leading", "trailing" }, spec.edge),
			"Facet UI.Menu: edge must be top, bottom, leading or trailing"
		)
		assert(
			spec.align == nil or table.find({ "start", "center", "end" }, spec.align),
			"Facet UI.Menu: align must be start, center or end"
		)
		assert(
			spec.maxHeight == nil
				or (type(spec.maxHeight) == "number" and spec.maxHeight > 0 and spec.maxHeight < math.huge),
			"Facet UI.Menu: maxHeight must be a finite number of pixels above 0"
		)
		checkWidth(read(spec.width))
		if spec.controls then
			spec.controls.diagnostics = function(): { string }
				return advice(read(spec.items), "items", 0, {})
			end
		end
		if spec.label ~= nil and spec.trigger ~= nil then
			error("Facet UI.Menu: give label or trigger, not both", 0)
		end
		local opened: ComposeTypes.Cell<boolean> = spec.isPresented or Compose.cell(false)
		local pointer: ComposeTypes.Cell<Vector2?> = Compose.cell(nil :: Vector2?)
		local announced = false
		local function announce(state: boolean)
			if state == announced then
				return
			end
			announced = state
			if state and spec.onOpen then
				spec.onOpen()
			elseif not state and spec.onClose then
				spec.onClose()
			end
		end
		local function close()
			if opened:peek() then
				opened:set(false)
			end
			announce(false)
		end
		local function open()
			if read(spec.enabled) == false or opened:peek() then
				return
			end
			opened:set(true)
			announce(true)
		end
		Compose.watch(function(use: ComposeTypes.Use)
			local shown = use(opened)
			if not shown then
				pointer:set(nil)
			end
			announce(shown)
		end)
		Compose.cleanup(function()
			announce(false)
		end)
		local allowed: { Nav.MenuTrigger } = spec.triggers
			or { "activate", "secondary", "longPress", "keyboard", "gamepad" }
		local function allows(trigger: Nav.MenuTrigger): boolean
			return table.find(allowed, trigger) ~= nil
		end
		local authored = if type(spec.trigger) == "function" then spec.trigger() else spec.trigger
		local root: GuiObject
		local trigger: GuiObject
		local automatic = spec.AutomaticSize or (if spec.Size ~= nil then E.AutomaticSize.None else E.AutomaticSize.XY)
		if authored ~= nil and wrap then
			trigger = authored
			root = Host.Frame(ctx.props(spec, MENU_KEYS, {
				Name = "Menu",
				BackgroundTransparency = 1,
				Size = D2.fromOffset(0, 0),
				AutomaticSize = automatic,
				trigger,
			}))
			if allows("activate") then
				if activation.marked(trigger) then
					Compose.cleanup(activation.listen(trigger, open))
				else
					runtime.connect(trigger, "Activated", open)
				end
			end
		elseif authored == nil then
			local triggerProps: InputProps.ButtonProps = {
				Name = "Trigger",
				label = spec.label or "Menu",
				enabled = spec.enabled,
				onActivate = if allows("activate") then open else nil,
			}
			if spec.Size ~= nil then
				triggerProps.AutomaticSize = automatic
				triggerProps.Size = function(use: ComposeTypes.Use)
					local sizing = read(automatic, use)
					local width = sizing == E.AutomaticSize.X or sizing == E.AutomaticSize.XY
					local height = sizing == E.AutomaticSize.Y or sizing == E.AutomaticSize.XY
					return D2.new(
						if width then 0 else 1,
						0,
						if height then 0 else 1,
						if height then ctx.controlSize(nil, "height", use) else 0
					)
				end
				triggerProps.TextTruncate = E.TextTruncate.AtEnd
				triggerProps.TextWrapped = false
				triggerProps.ClipsDescendants = true
				local attributes: Types.Attributes = {
					FacetLabel = function(use: ComposeTypes.Use)
						return read(triggerProps.label, use)
					end,
				}
				triggerProps.Attributes = attributes
			end
			if spec.disclosure then
				triggerProps[#triggerProps + 1] = ctx.icon("chevron.up.chevron.down", {
					Name = "Disclosure",
					Size = D2.fromOffset(12, 12),
					AnchorPoint = V2.new(1, 0.5),
					Position = D2.new(1, 20, 0.5, 0),
					BackgroundTransparency = 1,
				}) :: Types.Child
			end
			local button = UI.Button(triggerProps)
			if spec.disclosure then
				button:AddTag("facet-disclosure")
			end
			trigger = button
			root = Host.Frame(ctx.props(spec, MENU_KEYS, {
				Name = "Menu",
				BackgroundTransparency = 1,
				Size = D2.fromOffset(0, 0),
				AutomaticSize = automatic,
				trigger,
			}))
		else
			trigger = authored
			root = authored
			local native = ctx.props(spec, MENU_KEYS, {})
			local properties: { [string]: unknown } = {}
			local children: { Types.Child } = {}
			for key, value in (native :: unknown) :: { [unknown]: unknown } do
				if type(key) == "number" then
					table.insert(children, value :: Types.Child)
				elseif type(key) == "string" then
					properties[key] = value
				end
			end
			if next(properties) ~= nil then
				runtime.decorate(trigger, properties)
			end
			if #children > 0 then
				surfaces.attach(trigger, children)
			end
			if allows("activate") then
				if activation.marked(trigger) then
					Compose.cleanup(activation.listen(trigger, open))
				else
					runtime.connect(trigger, "Activated", open)
				end
			end
		end
		local available = surfaces.available(root)
		local mounted = false
		Compose.watch(function(use: ComposeTypes.Use)
			local active = use(available)
			if active then
				mounted = true
			end
			if mounted and (not active or read(spec.enabled, use) == false) then
				close()
			end
		end)
		if allows("secondary") then
			local function secondary(input: InputObject)
				if read(spec.enabled) == false then
					return
				end
				if input.UserInputType == E.UserInputType.MouseButton2 and not activation.consumed(input) then
					local point = V2.new(input.Position.X, input.Position.Y)
					local layer = trigger:FindFirstAncestorWhichIsA("ScreenGui")
					local gui = surfaces.service("GuiService")
					if layer and (layer :: ScreenGui).IgnoreGuiInset and gui then
						point += gui:GetGuiInset()
					end
					pointer:set(point)
					open()
					if opened:peek() then
						activation.consume(input)
					end
				end
			end
			local connections: { [Instance]: RBXScriptConnection } = {}
			local function attach(node: Instance)
				if node:IsA("GuiObject") and not connections[node] then
					connections[node] = node.InputBegan:Connect(secondary)
				end
			end
			attach(trigger)
			for _, node in trigger:GetDescendants() do
				attach(node)
			end
			runtime.connect(trigger, "DescendantAdded", attach)
			runtime.connect(trigger, "DescendantRemoving", function(node: Instance)
				if connections[node] then
					connections[node]:Disconnect()
					connections[node] = nil
				end
			end)
			Compose.cleanup(function()
				for _, connection in connections do
					connection:Disconnect()
				end
			end)
		end
		if allows("longPress") then
			runtime.connect(trigger, "TouchLongPress", function(_: { Vector2 }, state: Enum.UserInputState)
				if state == E.UserInputState.Begin then
					open()
				end
			end)
		end
		local gui = surfaces.service("GuiService")
		local selected = if gui then ctx.observe.SelectedObject(gui) else Compose.cell(nil :: GuiObject?)
		local bindings: { Types.ActionBinding } = {}
		if allows("keyboard") then
			table.insert(bindings, E.KeyCode.Menu)
			bindings[#bindings + 1] = { KeyCode = E.KeyCode.F10, PrimaryModifier = E.KeyCode.LeftShift }
			bindings[#bindings + 1] = { KeyCode = E.KeyCode.F10, PrimaryModifier = E.KeyCode.RightShift }
		end
		if allows("gamepad") then
			table.insert(bindings, E.KeyCode.ButtonY)
		end
		if #bindings > 0 then
			ctx.action(root, "Menu", bindings, function(use: ComposeTypes.Use)
				return surfaces.within(use(selected), root)
			end, open, { priority = 1200 })
		end
		local motion = ctx.motionTiming("popover")
		surfaces.attach(root, {
			surfaces.overlay(root, opened, function(phase: Nav.PresencePhase?)
				local presentedPointer = Compose.cell(pointer:peek())
				Compose.watch(function(use: ComposeTypes.Use)
					if use(opened) then
						presentedPointer:set(use(pointer))
					end
				end)
				return menuPanel(
					spec,
					close,
					trigger,
					nil,
					phase,
					motion,
					presentedPointer,
					if spec.closeButton == nil then "automatic" else spec.closeButton
				)
			end, { motion = motion }),
		})
		return root
	end
	UI.Menu = ctx.construct("Menu", function<V>(spec: NavigationProps.MenuSpec<V>): GuiObject
		return buildMenu(spec, false)
	end)
	registerPicker(ctx, UI, surfaces, buildMenu)
	registerSplitButton(ctx, UI, surfaces, buildMenu)
	registerComboBox(ctx, UI, surfaces)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="148">
            <Properties>
              <string name="Name">nav_menu_items</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local Nav = require("./navigation_types")
local NavigationProps = require("./navigation_props")

export type MenuEntry<V> = { key: string, heading: string?, item: Nav.MenuItem<V>?, ruled: boolean? }
export type BuildMenu = <V>(spec: NavigationProps.MenuSpec<V>, wrap: boolean) -> GuiObject

return function(ctx: Types.Context)
	local read = ctx.read
	local DIM_FIELDS: { [string]: { [string]: boolean } } = {
		fixed = { px = true },
		fill = { weight = true, min = true, max = true },
		hug = { min = true, max = true },
		percent = { fraction = true, offset = true, min = true, max = true },
		content = {},
		minMax = { min = true, preferred = true, max = true },
	}
	local function finite(value: unknown): boolean
		return type(value) == "number" and value == value and math.abs(value) < math.huge
	end
	local function checkWidth(width: unknown)
		if width == nil then
			return
		end
		if type(width) == "number" then
			assert(
				finite(width) and width > 0,
				"Facet UI.Menu: width must be a finite number of pixels above 0, a UDim, a UDim2 or a dimension table"
			)
			return
		end
		if typeof(width) == "UDim" or typeof(width) == "UDim2" then
			return
		end
		assert(
			type(width) == "table",
			"Facet UI.Menu: width must be a number of pixels, a UDim, a UDim2 or a dimension table"
		)
		local dim = width :: { [string]: unknown }
		local fields = DIM_FIELDS[tostring(dim.type)]
		if fields == nil then
			error(
				`Facet UI.Menu: width.type must be fixed, fill, hug, percent, content or minMax (got {tostring(dim.type)})`,
				0
			)
		end
		for key, value in dim do
			if key ~= "type" then
				if not fields[key] then
					error(`Facet UI.Menu: a {tostring(dim.type)} width does not take '{tostring(key)}'`, 0)
				end
				if not (finite(value) or (type(value) == "string" and key ~= "fraction" and key ~= "weight")) then
					error(`Facet UI.Menu: width.{tostring(key)} must be a finite number or a theme metric name`, 0)
				end
			end
		end
		if dim.type == "fixed" then
			assert(dim.px ~= nil, "Facet UI.Menu: a fixed width requires px")
		elseif dim.type == "percent" then
			assert(dim.fraction ~= nil, "Facet UI.Menu: a percent width requires fraction")
		end
	end
	local function length(value: Nav.MenuDimLength?, use: ComposeTypes.Use?): number?
		if value == nil then
			return nil
		end
		return if type(value) == "string" then ctx.metric(value, use) else value
	end
	local function resolveWidth(width: Nav.MenuWidth, natural: number, room: number, use: ComposeTypes.Use?): number
		if type(width) == "number" then
			return width
		end
		if typeof(width) == "UDim" then
			local udim = width :: UDim
			return udim.Scale * room + udim.Offset
		end
		if typeof(width) == "UDim2" then
			local udim = (width :: UDim2).X
			return udim.Scale * room + udim.Offset
		end
		local dim = width :: Nav.MenuDim
		local lower, upper = length(dim.min, use) or 0, length(dim.max, use) or math.huge
		local value = if dim.type == "fixed"
			then assert(length(dim.px, use))
			elseif dim.type == "fill" then room
			elseif dim.type == "percent" then (dim.fraction or 0) * room + (dim.offset or 0)
			elseif dim.type == "minMax" then length(dim.preferred, use) or natural
			else natural
		return math.max(0, math.clamp(value, lower, math.max(lower, upper)))
	end
	local function actionItem<V>(item: Nav.MenuItem<V>): Nav.MenuAction<V>
		assert(item.divider ~= true, "Menu action cannot be a divider")
		return item
	end
	local function commitItem<V>(item: Nav.MenuAction<V>): boolean
		if read(item.enabled) == false then
			return false
		end
		if item.checked then
			item.checked:set(not item.checked:peek())
			if item.onChange then
				item.onChange(item.checked:peek())
			end
		elseif item.selected then
			item.selected:set(item.value)
			if item.onChange then
				item.onChange(item.value)
			end
		end
		local onSelect: (() -> ())? = item.onSelect
		if onSelect then
			onSelect()
		end
		return true
	end
	local function menuItems<V>(items: { Nav.MenuItem<V> }, use: ComposeTypes.Use?): { Nav.MenuItem<V> }
		assert(type(items) == "table", "Menu.items must be an array")
		local result: { Nav.MenuItem<V> } = {}
		local identifiers: { [string]: boolean } = {}
		for index = 1, #items do
			local source = items[index]
			local copy = table.clone(source)
			local id = copy.id or tostring(index)
			copy.id = id
			local item: Nav.MenuItem<V> = copy
			assert(not identifiers[id], `Facet UI.Menu: two items at one level share the id '{id}'`)
			identifiers[id] = true
			if item.divider ~= true and item.avatar ~= nil then
				for key in (item.avatar :: unknown) :: { [string]: unknown } do
					if key ~= "name" and key ~= "image" and key ~= "userId" then
						error(`Facet UI.Menu: an avatar takes name, image and userId, not '{key}'`, 0)
					end
				end
			end
			if not item.divider then
				assert(
					type(read(item.label, use)) == "string" and string.find(read(item.label, use), "%S") ~= nil,
					"Menu items require nonempty labels"
				)
				assert(not (item.children and item.onSelect), "A menu item cannot have both children and onSelect")
				assert(
					item.children or item.onSelect or item.checked or item.selected,
					"Menu items require an action, submenu, or selection state"
				)
				assert(not (item.checked and item.selected), "A menu item cannot be both checked and selected")
				if item.children then
					item.children = menuItems(read(item.children, use), use)
				end
			end
			table.insert(result, item)
		end
		return result
	end
	local function advice<V>(items: { Nav.MenuItem<V> }, path: string, depth: number, notes: { string }): { string }
		local actions, destructive = 0, nil :: number?
		for index, item in items do
			if item.divider ~= true then
				actions += 1
				if read(item.role) == "destructive" then
					destructive = index
				end
				if item.children then
					local id = item.id or tostring(index)
					if depth + 1 >= 2 then
						table.insert(
							notes,
							`Facet UI.Menu: submenu '{id}' nests {depth + 1} levels deep. The platform guidance advises a single level.`
						)
					end
					advice(read(item.children), `{path}[{index}].children`, depth + 1, notes)
				end
			end
		end
		if actions > 5 then
			table.insert(notes, `Facet UI.Menu: {path} holds {actions} items; past about five, consider a new menu.`)
		end
		if destructive and destructive ~= #items then
			table.insert(
				notes,
				`Facet UI.Menu: {path}[{destructive}] is destructive but not last; put destructive items at the end of the menu.`
			)
		end
		return notes
	end
	return {
		checkWidth = checkWidth,
		resolveWidth = resolveWidth,
		actionItem = actionItem,
		commitItem = commitItem,
		menuItems = menuItems,
		advice = advice,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="149">
            <Properties>
              <string name="Name">nav_menu_panel</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local reducedMotion = require("./motion").reduced
local rest = require("./rest")
local ComposeTypes = require("../vendor/compose/core")
local parts = require("./overlay_parts")
local NavigationProps = require("./navigation_props")
local MenuItems = require("./nav_menu_items")
local MenuRows = require("./nav_menu_rows")

type MenuEntry<V> = MenuItems.MenuEntry<V>

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces)
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local readSource = ctx.readSource
	local E, D2, V2, D = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2, ctx.types.UDim
	local itemModel = MenuItems(ctx)
	local actionItem, menuItems, resolveWidth = itemModel.actionItem, itemModel.menuItems, itemModel.resolveWidth
	local menuRow = MenuRows(ctx, UI, surfaces)
	local function menuPanel<V>(
		spec: NavigationProps.MenuSpec<V>,
		close: () -> (),
		anchor: GuiObject,
		nonmodal: boolean?,
		phase: Nav.PresencePhase?,
		motion: Nav.MotionTiming?,
		pointer: ComposeTypes.Readable<Vector2?>?,
		closeCommand: (boolean | "automatic")?
	): Frame
		local popoverTiming, sheetTiming = ctx.motionTiming("popover"), ctx.motionTiming("sheet")
		local timing: Nav.MotionTiming = motion or { enter = popoverTiming.enter, exit = popoverTiming.exit }
		local present = ctx.motionEase("present")
		local slide = ctx.metric("motion.distances.menuSlide")
		local materialize = ctx.metric("motion.materialize.menu")
		local entered = Compose.cell(false)
		local appearance = if phase then surfaces.appearance(phase, timing, entered) else nil
		local hitFloor = ctx.hitFloor()
		local path = Compose.cell({} :: { string })
		local branchYs = Compose.cell({} :: { number })
		local rowNodes: { [string]: GuiObject } = {}
		local enter: (string, GuiObject?, { string }?) -> ()
		local pendingFocus: string?
		local sheeted = Compose.cell(false)
		local reduce = reducedMotion(ctx)
		local levelClock = runtime.timeline({ duration = popoverTiming.enter, autoplay = false })
		local levelDirection = Compose.cell(0)
		local levelReady = Compose.cell(true)
		local pendingLevel = false
		local depthSeen = 0
		Compose.watch(function(use: ComposeTypes.Use)
			local depth = #use(path)
			if depth ~= depthSeen then
				levelDirection:set(if depth > depthSeen then 1 else -1)
				depthSeen = depth
				pendingLevel = true
			end
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			if use(levelReady) and pendingLevel then
				pendingLevel = false
				levelClock:restart()
			end
		end)
		local presentedLevel = 1
		local function level(use: ComposeTypes.Use?): number
			if phase and read(phase.exiting, use) then
				return presentedLevel
			end
			local direction: number = if use then use(levelDirection) else levelDirection:peek()
			if direction == 0 or reduce(use) then
				presentedLevel = 1
				return 1
			end
			if not read(levelReady, use) then
				presentedLevel = 0
				return 0
			end
			presentedLevel = present(readSource(levelClock.progress, use))
			return presentedLevel
		end
		local shown: Nav.Presence? = if appearance
			then {
				opacity = function(use: ComposeTypes.Use?): number
					return appearance.opacity(use) * (if read(sheeted, use) then 1 else level(use))
				end,
				travel = function(use: ComposeTypes.Use?): number
					return appearance.travel(use) * (if read(sheeted, use) then 1 else level(use))
				end,
			}
			else nil
		local rootItems = Compose.formula(function(use: ComposeTypes.Use)
			return menuItems(read(spec.items, use), use)
		end)
		local current = Compose.formula(function(use: ComposeTypes.Use)
			local items = use(rootItems)
			for _, id in use(path) do
				local found: Nav.MenuAction<V>?
				for _, item in items do
					if item.divider ~= true and item.id == id then
						found = item
						break
					end
				end
				if not found or not found.children then
					break
				end
				items = read(found.children, use)
			end
			return items
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			local items, valid = use(rootItems), {}
			for _, id in path:peek() do
				local found: Nav.MenuAction<V>?
				for _, item in items do
					if item.divider ~= true and item.id == id then
						found = item
						break
					end
				end
				if not found or not found.children then
					break
				end
				table.insert(valid, id)
				items = read(found.children, use)
			end
			if #valid ~= #path:peek() then
				path:set(valid)
			end
		end)
		local function back()
			local previous = table.clone(path:peek())
			if #previous == 0 then
				close()
			else
				pendingFocus = table.remove(previous)
				path:set(previous)
			end
		end
		local widths = Compose.cell({} :: { [string]: number })
		local function landing(items: { Nav.MenuItem<V> }): string?
			for _, item in items do
				if item.divider ~= true then
					local action = actionItem(item)
					local chosen = if action.selected ~= nil
						then read(action.selected) == action.value
						else read(action.marked) == true
					if chosen and read(action.enabled) ~= false then
						return tostring(item.id)
					end
				end
			end
			return nil
		end
		local entries = Compose.formula(function(use: ComposeTypes.Use): { MenuEntry<V> }
			local out: { MenuEntry<V> } = {}
			local afterRow = false
			for index, item in use(current) do
				local key = tostring(item.id or index)
				if item.divider ~= true then
					local heading = read(actionItem(item).sectionTitle, use)
					if heading ~= nil and heading ~= "" then
						table.insert(out, { key = "Section:" .. key, heading = heading })
						afterRow = false
					end
				end
				table.insert(out, { key = key, item = item, ruled = afterRow and item.divider ~= true })
				afterRow = item.divider ~= true
			end
			return out
		end)
		local rowState: MenuRows.RowState = {
			hitFloor = hitFloor,
			sheeted = sheeted,
			path = path,
			rowNodes = rowNodes,
			widths = widths,
			enter = function(id: string, node: GuiObject?, prefix: { string }?)
				enter(id, node, prefix)
			end,
			close = close,
		}
		local rows = Host.Frame "MenuRows" {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = D2.new(1, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
			Host.UIListLayout({
				FillDirection = E.FillDirection.Vertical,
				SortOrder = E.SortOrder.LayoutOrder,
				Padding = function(use: ComposeTypes.Use)
					return D.new(0, if use(sheeted) then 8 else 0)
				end,
			}) :: Types.Child,
			Compose.show(function()
				return spec.query ~= nil
			end, function()
				return UI.TextInput "Search" {
					value = assert(spec.query),
					placeholder = "Search",
					LayoutOrder = -2,
				}
			end),
			Compose.show(function(use: ComposeTypes.Use)
				return #use(path) > 0 and use(sheeted)
			end, function()
				return parts.back(ctx, UI, spec.backLabel, back, {
					LayoutOrder = -1,
					Size = D2.new(1, 0, 0, 44),
				})
			end),
			Compose.keyed({
				from = entries,
				key = function(entry: MenuEntry<V>)
					local item = entry.item
					return (if item and item.divider ~= true and item.description ~= nil then "D:" else "P:")
						.. entry.key
				end,
				render = function(
					entrySource: ComposeTypes.Readable<MenuEntry<V>>,
					index: ComposeTypes.Readable<number>
				)
					return menuRow.entry(entrySource, index, rowState)
				end,
			}),
			Host.UIPadding({
				PaddingTop = function(use: ComposeTypes.Use)
					return D.new(0, if use(sheeted) then 8 else ctx.metric("space.xs", use))
				end,
				PaddingBottom = function(use: ComposeTypes.Use)
					return D.new(0, if use(sheeted) then 8 else ctx.metric("space.xs", use))
				end,
				PaddingLeft = function(use: ComposeTypes.Use)
					return D.new(0, if use(sheeted) then 8 else ctx.metric("space.xs", use))
				end,
				PaddingRight = function(use: ComposeTypes.Use)
					return D.new(0, if use(sheeted) then 8 else ctx.metric("space.xs", use))
				end,
			}) :: Types.Child,
		}
		if closeCommand ~= nil and closeCommand ~= false then
			surfaces.attach(rows, {
				Compose.show(function(use: ComposeTypes.Use)
					return closeCommand == true or use(sheeted)
				end, function()
					return UI.Button "CloseCommand" {
						name = "Close",
						icon = "close",
						LayoutOrder = 2147483647,
						Size = D2.new(1, 0, 0, 44),
						AutomaticSize = E.AutomaticSize.None,
						onActivate = close,
					}
				end),
			})
		end
		local room = Compose.cell(0)
		local function panelWidth(use: ComposeTypes.Use): number
			local widest = 0
			for _, width in use(widths) do
				widest = math.max(widest, width)
			end
			local natural = math.clamp(widest + 48, 220, 400)
			local authored = read(spec.width, use)
			if authored == nil then
				return natural
			end
			local space = use(room)
			local resolved = resolveWidth(authored, natural, space, use)
			return if space > 0 then math.min(resolved, space) else resolved
		end
		runtime.decorate(rows, {
			Position = function(use: ComposeTypes.Use)
				local direction = use(levelDirection)
				if not use(sheeted) or direction == 0 or reduce(use) then
					return D2.fromOffset(0, 0)
				end
				return D2.fromOffset(direction * slide * (1 - level(use)), 0)
			end,
		})
		local scroller = Host.ScrollingFrame "MenuScroll" {
			Selectable = false,
			BackgroundTransparency = 1,
			Size = D2.fromScale(1, 1),
			BorderSizePixel = 0,
			AutomaticCanvasSize = E.AutomaticSize.Y,
			CanvasSize = D2.fromOffset(0, 0),
			ScrollingDirection = E.ScrollingDirection.Y,
			ScrollBarThickness = 4,
			VerticalScrollBarInset = E.ScrollBarInset.ScrollBar,
			rows,
		}
		local levelFade = ctx.fade({
			Name = "MenuLevel",
			BackgroundTransparency = 1,
			Size = D2.fromScale(1, 1),
			scroller,
		}, nil, false)
		ctx.fadeTo(levelFade, function(use: ComposeTypes.Use): number
			if not use(sheeted) then
				return 0
			end
			return 1 - level(use)
		end)
		local panel = Host.Frame "MenuPanel" {
			Size = D2.fromOffset(280, 0),
			BorderSizePixel = 0,
			if shown
				then ctx.styled(
					ctx.fade({
						Name = "MenuGroup",
						BackgroundTransparency = 1,
						Size = D2.fromScale(1, 1),
						GroupTransparency = function(use: ComposeTypes.Use)
							return 1 - shown.opacity(use)
						end,
						levelFade,
					}, true, false),
					"menu-group"
				)
				else levelFade,
		}
		if shown then
			surfaces.attach(panel, {
				Host.UIGradient "PresentationFade" {
					Transparency = function(use: ComposeTypes.Use)
						return ctx.types.NumberSequence.new(1 - (shown :: Nav.Presence).opacity(use))
					end,
				},
			})
		end
		ctx.styled(panel, "menu")
		surfaces.skin(panel, nil, {
			reserve = function(): number
				return 0
			end,
		})
		local restKey = ""
		local sizes, rested = surfaces.atRest(
			if shown
				then shown.travel
				else function(): number
					return 1
				end,
			entered,
			{ panel, rows },
			function(use: ComposeTypes.Use): string
				local key = table.concat(use(path), "/")
				if phase and use(phase.exiting) then
					return restKey
				end
				restKey = key
				return key
			end
		)
		local measured, rowSize = sizes[1], sizes[2]
		local rowExtent = Compose.cell(rowSize:peek())
		local rowRest = rest(ctx, function(): (string, boolean, boolean?)
			local size = rowSize:peek()
			local filled = size.X > 0 and size.Y > 0
			return tostring(size), filled, filled
		end, function(use: ComposeTypes.Use): string
			return tostring(use(rowSize))
		end, true)
		Compose.watch(function(use: ComposeTypes.Use)
			local size = use(rowSize)
			if not use(rested) or use(rowRest) then
				rowExtent:set(size)
			end
		end)
		enter = function(id: string, node: GuiObject?, prefix: { string }?)
			local nextPath = table.clone(prefix or path:peek())
			table.insert(nextPath, id)
			local row = node or rowNodes[id]
			local ys = table.clone(branchYs:peek())
			ys[#nextPath] = if row then row.AbsolutePosition.Y - panel.AbsolutePosition.Y else 0
			branchYs:set(ys)
			pendingFocus = nil
			path:set(nextPath)
		end
		Compose.watch(function(use: ComposeTypes.Use)
			levelReady:set(use(rested))
		end)
		local position = ctx.observe.AbsolutePosition(anchor)
		local size = ctx.observe.AbsoluteSize(anchor)
		local function anchorBounds(use: ComposeTypes.Use): (Vector2, Vector2)
			local point = if pointer then use(pointer) else nil
			return if point then point else use(position), if point then V2.zero else use(size)
		end
		local modal = if nonmodal
			then Host.Frame "SuggestionsOverlay" {
				BackgroundTransparency = 1,
				Size = D2.fromScale(1, 1),
				ZIndex = 100,
				panel,
			}
			else surfaces.modal(
				function()
					return panel
				end,
				back,
				{
					backgroundTransparency = function(use: ComposeTypes.Use): number
						return if use(sheeted) then 0.5 else 1
					end,
					appearance = if shown then shown.opacity else nil,
					onOutside = close,
					exiting = if phase then phase.exiting else nil,
					initialFocus = landing(current:peek()),
				}
			)
		if nonmodal then
			ctx.modalPortal(modal, anchor)
			runtime.decorate(panel, { ZIndex = 101 })
		end
		local extent = ctx.observe.AbsoluteSize(modal)
		local origin = ctx.observe.AbsolutePosition(modal)
		local input = surfaces.service("UserInputService")
		local preferred = if input
			then ctx.observe.PreferredInput(input) :: ComposeTypes.Readable<Enum.PreferredInput?>
			else Compose.cell(nil :: Enum.PreferredInput?)
		local surface = ctx.observe.Parent(modal)
		local asSheet = Compose.formula(function(use: ComposeTypes.Use)
			local presentation = read(spec.presentation, use)
			if presentation and presentation ~= "automatic" then
				return presentation == "sheet"
			end
			local layer = use(surface)
			if layer and layer:IsA("SurfaceGui") then
				return false
			end
			return (use(extent).X > 0 and use(extent).X < math.max(600, #use(path) * 288 + panelWidth(use) + 16))
				or use(preferred) == E.PreferredInput.Touch
				or use(preferred) == E.PreferredInput.Gamepad
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			local sheet = use(asSheet)
			sheeted:set(sheet)
			timing.enter = if sheet then sheetTiming.enter else popoverTiming.enter
			timing.exit = if sheet then sheetTiming.exit else popoverTiming.exit
		end)
		local guiService = surfaces.service("GuiService")
		local layerOf = ctx.observe.Parent(modal)
		local function originOf(use: ComposeTypes.Use): Vector2
			use(origin)
			use(layerOf)
			use(extent)
			use(position)
			return modal.AbsolutePosition
		end
		local function insets(use: ComposeTypes.Use): (number, number, number, number)
			use(layerOf)
			use(extent)
			local layer = modal:FindFirstAncestorWhichIsA("ScreenGui")
			if guiService == nil or layer == nil then
				return 0, 0, 0, 0
			end
			local screen = layer :: ScreenGui
			if not (screen.IgnoreGuiInset == true or screen.ScreenInsets == E.ScreenInsets.None) then
				return 0, 0, 0, 0
			end
			local ok, topLeft, bottomRight = pcall(function(): (Vector2, Vector2)
				return (guiService :: GuiService):GetGuiInset()
			end)
			if ok and typeof(topLeft) == "Vector2" and typeof(bottomRight) == "Vector2" then
				return topLeft.X, topLeft.Y, bottomRight.X, bottomRight.Y
			end
			return 0, 0, 0, 0
		end
		Compose.watch(function(use: ComposeTypes.Use)
			local left, _, right = insets(use)
			room:set(math.max(0, use(extent).X - left - right - 16))
		end)
		local presentedPlace: Vector2? = nil
		local presentedPivot = V2.zero
		local function place(use: ComposeTypes.Use): (Vector2, Vector2)
			if phase and use(phase.exiting) and presentedPlace then
				return presentedPlace, presentedPivot
			end
			local at, bounds = anchorBounds(use)
			local offer, panelSize, offset = use(extent), use(measured), originOf(use)
			local insetLeft, insetTop, insetRight, insetBottom = insets(use)
			local low, high =
				V2.new(insetLeft + 8, insetTop + 8), V2.new(offer.X - insetRight - 8, offer.Y - insetBottom - 8)
			if use(asSheet) then
				local at = V2.new(12 + insetLeft, math.max(12 + insetTop, offer.Y - insetBottom - panelSize.Y - 12))
				presentedPlace, presentedPivot = at, V2.zero
				return at, V2.zero
			end
			local x, y = at.X - offset.X, at.Y - offset.Y
			local depth = #use(path)
			local gap = if pointer and use(pointer) then 0 else 4
			local left, top = x + depth * 288, y + bounds.Y + gap
			local above, after = false, true
			local edge, align = spec.edge or "bottom", spec.align or "start"
			local function along(start: number, extentAcross: number, extentAlong: number): number
				return if align == "center"
					then start + (extentAcross - extentAlong) / 2
					elseif align == "end" then start + extentAcross - extentAlong
					else start
			end
			local vertical = depth > 0 or edge == "top" or edge == "bottom"
			if depth > 0 or (edge == "bottom" and align == "start") then
				if offer.Y > 0 and top + panelSize.Y > high.Y then
					top = y - panelSize.Y - gap
					above = true
				end
			elseif vertical then
				left = along(x, bounds.X, panelSize.X)
				local below, over = y + bounds.Y + gap, y - panelSize.Y - gap
				above = edge == "top"
				if edge == "bottom" and offer.Y > 0 and below + panelSize.Y > high.Y and over >= low.Y then
					above = true
				elseif edge == "top" and over < low.Y and (offer.Y <= 0 or below + panelSize.Y <= high.Y) then
					above = false
				end
				top = if above then over else below
			else
				top = along(y, bounds.Y, panelSize.Y)
				local beyond, before = x + bounds.X + 4, x - panelSize.X - 4
				after = edge == "trailing"
				if edge == "trailing" and offer.X > 0 and beyond + panelSize.X > high.X and before >= low.X then
					after = false
				elseif edge == "leading" and before < low.X and (offer.X <= 0 or beyond + panelSize.X <= high.X) then
					after = true
				end
				left = if after then beyond else before
				if offer.Y > 0 then
					top = math.clamp(top, low.Y, math.max(low.Y, high.Y - panelSize.Y))
				end
			end
			if offer.X > 0 then
				left = if depth > 0
					then math.clamp(x, low.X, math.max(low.X, high.X - panelSize.X - depth * 288)) + depth * 288
					else math.clamp(left, low.X, math.max(low.X, high.X - panelSize.X))
			end
			if offer.Y > 0 then
				top = math.clamp(top, low.Y, math.max(low.Y, high.Y - panelSize.Y))
			end
			top = math.max(low.Y, top)
			local pivot: Vector2
			local leaving = if phase then use(phase.exiting) else false
			if vertical and (depth > 0 or use(levelDirection) < 0) and not (leaving and depth == 0) then
				local back = use(levelDirection) < 0
				local y = use(branchYs)[if back then depth + 1 else depth] or 0
				pivot = V2.new(if back then panelSize.X else 0, math.clamp(y, 0, panelSize.Y))
			elseif vertical then
				local reach = if depth > 0 or align == "start"
					then x + depth * 288
					elseif align == "end" then x + bounds.X
					else x + bounds.X / 2
				pivot = V2.new(math.clamp(reach - left, 0, panelSize.X), if above then panelSize.Y else 0)
			else
				local reach = if align == "start" then y elseif align == "end" then y + bounds.Y else y + bounds.Y / 2
				pivot = V2.new(if after then 0 else panelSize.X, math.clamp(reach - top, 0, panelSize.Y))
			end
			local at = V2.new(left, top)
			presentedPlace, presentedPivot = at, pivot
			return at, pivot
		end
		local panelGeometry: Types.FrameNativeProps = {
			Size = function(use: ComposeTypes.Use)
				local function carve(side: string): number
					return surfaces.inset(0, side, nil, use)
				end
				local _, insetTop, _, insetBottom = insets(use)
				local height = math.min(
					use(rowExtent).Y + carve("top") + carve("bottom"),
					math.max(44, use(extent).Y - 24 - insetTop - insetBottom),
					if spec.maxHeight then math.max(60, spec.maxHeight) else math.huge
				)
				if use(asSheet) then
					local insetLeft, _, insetRight = insets(use)
					return D2.new(1, -24 - insetLeft - insetRight, 0, height)
				end
				return D2.fromOffset(panelWidth(use) + carve("left") + carve("right"), height)
			end,
		}
		runtime.decorate(panel, panelGeometry)
		if shown then
			surfaces.popover(panel, shown.travel, place, {
				pinned = true,
				from = materialize,
				rested = rested,
				size = measured,
				geometry = { Size = panelGeometry.Size, AutomaticSize = panelGeometry.AutomaticSize },
				rise = function(use: ComposeTypes.Use): number?
					if not use(asSheet) then
						return nil
					end
					local _, _, _, insetBottom = insets(use)
					return use(measured).Y + 12 + insetBottom
				end,
			})
		else
			runtime.decorate(panel, {
				Position = function(use: ComposeTypes.Use)
					local at = place(use)
					return D2.fromOffset(at.X, at.Y)
				end,
			})
		end
		local gui = surfaces.service("GuiService")
		local selected = if gui then ctx.observe.SelectedObject(gui) else Compose.cell(nil :: GuiObject?)
		local function selectedBranch(use: ComposeTypes.Use?): Nav.MenuAction<V>?
			local node = read(selected, use)
			for _, item in read(current, use) do
				if
					item.divider ~= true
					and node
					and item.id == node.Name
					and item.children
					and read(item.enabled, use) ~= false
				then
					return item
				end
			end
			return nil
		end
		surfaces.attach(modal, {
			Compose.show(function(use: ComposeTypes.Use)
				return selectedBranch(use) ~= nil or #use(path) > 0
			end, function()
				ctx.action(modal, "MenuRight", { E.KeyCode.Right, E.KeyCode.DPadRight }, function(use: ComposeTypes.Use)
					return selectedBranch(use) ~= nil
				end, function()
					local item = selectedBranch()
					if item then
						enter(assert(item.id))
					end
				end, { priority = 2100, capture = true })
				ctx.action(modal, "MenuLeft", { E.KeyCode.Left, E.KeyCode.DPadLeft }, function(use: ComposeTypes.Use)
					return #use(path) > 0
				end, back, { priority = 2100, capture = true })
				return Compose.fragment(function()
					return {}
				end)
			end),
		})
		local focusIn = surfaces.selecting()
		local placed = ctx.observe.Parent(modal)
		Compose.watch(function(use: ComposeTypes.Use)
			local rows = use(current)
			use(placed)
			if gui and not nonmodal and focusIn(use) then
				local target = if pendingFocus then surfaces.firstSelectable(panel, pendingFocus) else nil
				if not target then
					local chosen = landing(rows)
					target = if chosen then surfaces.firstSelectable(panel, chosen) else nil
				end
				if not target then
					for _, item in rows do
						if item.divider ~= true and read(item.enabled, use) ~= false then
							local live = actionItem(item)
							local chosen = if live.selected
								then live.selected:peek() == live.value
								else read(live.marked, use) == true
							if chosen then
								target = surfaces.firstSelectable(panel, tostring(live.id))
								if target then
									break
								end
							end
						end
					end
				end
				if not target then
					for _, item in rows do
						if not item.divider and read(item.enabled, use) ~= false then
							target = surfaces.firstSelectable(panel, tostring(item.id))
							if target then
								break
							end
						end
					end
				end
				if target and modal.Parent then
					gui.SelectedObject = target
				end
			end
		end)
		local centered: string? = nil
		local settling: RBXScriptConnection? = nil
		local function stopSettling()
			if settling then
				settling:Disconnect()
				settling = nil
			end
		end
		Compose.cleanup(stopSettling)
		local windowSize = ctx.observe.AbsoluteSize(scroller)
		local rowLayout = rows:FindFirstChildWhichIsA("UIListLayout")
		local laidOut = if rowLayout then ctx.observe.AbsoluteContentSize(rowLayout) else Compose.cell(V2.zero)
		Compose.watch(function(use: ComposeTypes.Use)
			local content = use(laidOut) :: Vector2?
			local level = table.concat(use(path), "/") .. "@" .. tostring(if content then content.Y else 0)
			if centered == level then
				return
			end
			local chosen = landing(use(current))
			if chosen == nil then
				centered = level
				return
			end
			use(windowSize)
			use(rowSize)
			local row = rows:FindFirstChild(chosen)
			if row == nil or not row:IsA("GuiObject") then
				return
			end
			local function target(): number?
				local window, canvas = scroller.AbsoluteSize.Y, rows.AbsoluteSize.Y
				if window <= 0 or canvas <= 0 or row.Parent ~= rows then
					return nil
				end
				local gap = if rowLayout then rowLayout.Padding.Offset else 0
				local top = rows.AbsolutePosition.Y - scroller.AbsolutePosition.Y + scroller.CanvasPosition.Y
				canvas = math.max(canvas + top, scroller.AbsoluteCanvasSize.Y)
				local inset = rows:FindFirstChildWhichIsA("UIPadding")
				if inset then
					local ok, styled = pcall(function(): UDim
						return inset:GetStyled("PaddingTop")
					end)
					top += if ok then styled.Offset else inset.PaddingTop.Offset
				end
				local offset = top
				for _, sibling in rows:GetChildren() do
					if
						sibling ~= row
						and sibling:IsA("GuiObject")
						and sibling.Visible
						and sibling.LayoutOrder < (row :: GuiObject).LayoutOrder
					then
						offset += sibling.AbsoluteSize.Y + gap
					end
				end
				return math.clamp(
					offset + (row :: GuiObject).AbsoluteSize.Y / 2 - window / 2,
					0,
					math.max(0, canvas - window)
				)
			end
			local first = target()
			if first == nil then
				return
			end
			scroller.CanvasPosition = V2.new(scroller.CanvasPosition.X, first)
			centered = level
			local services = ctx.config.services
			local frames = services and services.RunService
			if frames then
				local remaining = 2
				stopSettling()
				settling = frames.Heartbeat:Connect(function()
					remaining -= 1
					local fresh = target()
					if fresh and scroller.CanvasPosition.Y ~= fresh then
						scroller.CanvasPosition = V2.new(scroller.CanvasPosition.X, fresh)
					end
					if remaining <= 0 then
						stopSettling()
					end
				end)
			end
		end)
		surfaces.attach(modal, {
			Compose.keyed({
				from = function(use: ComposeTypes.Use)
					if use(asSheet) then
						return {}
					end
					local levels: { { id: string, items: { Nav.MenuItem<V> }, prefix: { string }, depth: number } } = {}
					local items = use(rootItems)
					local prefix: { string } = {}
					for depth, selectedId in use(path) do
						table.insert(levels, {
							id = table.concat(prefix, "/"),
							items = items,
							prefix = table.clone(prefix),
							depth = depth,
						})
						local found: Nav.MenuAction<V>?
						for _, item in items do
							if item.divider ~= true and item.id == selectedId then
								found = item
								break
							end
						end
						if not found or not found.children then
							break
						end
						items = read(found.children, use)
						table.insert(prefix, selectedId)
					end
					return levels
				end,
				key = function(level: { id: string, items: { Nav.MenuItem<V> }, prefix: { string }, depth: number })
					return level.id
				end,
				render = function(
					source: ComposeTypes.Readable<{ id: string, items: { Nav.MenuItem<V> }, prefix: { string }, depth: number }>
				)
					local ancestorHeight = Compose.cell(0)
					local ancestor = ctx.styled(
						Host.ScrollingFrame "AncestorMenu" {
							ZIndex = 103,
							CanvasSize = D2.fromOffset(0, 0),
							AutomaticCanvasSize = E.AutomaticSize.Y,
							ScrollingDirection = E.ScrollingDirection.Y,
							ScrollBarThickness = 4,
							Selectable = false,
							BorderSizePixel = 0,
							Size = D2.fromOffset(280, 0),
							AutomaticSize = E.AutomaticSize.Y,
							Position = function(use: ComposeTypes.Use)
								local at = place(use)
								local _, insetTop, _, insetBottom = insets(use)
								local height = use(ancestorHeight)
								return D2.fromOffset(
									at.X - (#use(path) - use(source).depth + 1) * 288,
									math.clamp(
										at.Y,
										insetTop + 8,
										math.max(insetTop + 8, use(extent).Y - insetBottom - 8 - height)
									)
								)
							end,
							Host.UISizeConstraint {
								MaxSize = function(use: ComposeTypes.Use)
									local _, top, _, bottom = insets(use)
									return V2.new(280, math.max(44, use(extent).Y - top - bottom - 16))
								end,
							} :: Types.Child,
							Host.UIListLayout({
								FillDirection = E.FillDirection.Vertical,
								SortOrder = E.SortOrder.LayoutOrder,
							}) :: Types.Child,
							Host.UIPadding({
								PaddingTop = function(use: ComposeTypes.Use)
									return D.new(0, ctx.metric("space.xs", use))
								end,
								PaddingBottom = function(use: ComposeTypes.Use)
									return D.new(0, ctx.metric("space.xs", use))
								end,
								PaddingLeft = function(use: ComposeTypes.Use)
									return D.new(0, ctx.metric("space.xs", use))
								end,
								PaddingRight = function(use: ComposeTypes.Use)
									return D.new(0, ctx.metric("space.xs", use))
								end,
							}) :: Types.Child,
							Compose.keyed({
								from = function(use: ComposeTypes.Use)
									return use(source).items
								end,
								key = function(item: Nav.MenuItem<V>, index: number)
									return item.id or index
								end,
								render = function(
									row: ComposeTypes.Readable<Nav.MenuItem<V>>,
									index: ComposeTypes.Readable<number>
								)
									return menuRow.ancestor(row, index, source, rowState)
								end,
							}),
						},
						"menu"
					)
					local ancestorSize = ctx.observe.AbsoluteSize(ancestor)
					Compose.watch(function(use: ComposeTypes.Use)
						ancestorHeight:set(use(ancestorSize).Y)
					end)
					return ancestor
				end,
			}),
		})
		return modal
	end
	return menuPanel
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="150">
            <Properties>
              <string name="Name">nav_menu_rows</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local Nav = require("./navigation_types")
local MenuItems = require("./nav_menu_items")
local Theme = require("./theme_types")

export type RowState = {
	hitFloor: (ComposeTypes.Use?) -> number,
	sheeted: ComposeTypes.Readable<boolean>,
	path: ComposeTypes.Readable<{ string }>,
	rowNodes: { [string]: GuiObject },
	widths: ComposeTypes.Cell<{ [string]: number }>,
	enter: (string, GuiObject?, { string }?) -> (),
	close: () -> (),
}
export type AncestorLevel<V> = { id: string, items: { Nav.MenuItem<V> }, prefix: { string }, depth: number }

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces)
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2, V2, D = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2, ctx.types.UDim
	local itemModel = MenuItems(ctx)
	local actionItem, commitItem = itemModel.actionItem, itemModel.commitItem
	local function trailingMark(
		row: GuiObject,
		name: string,
		selected: (ComposeTypes.Use) -> boolean,
		enabled: Types.Value<boolean>
	)
		row:AddTag("facet-menu-mark")
		local state = if ctx.iconVaries(name) then ctx.observe.GuiState(row) else nil
		runtime.mountFragment(function()
			return {
				Host.UIPadding({
					PaddingRight = if ctx.config.theme == nil
						then D.new(0, ctx.controlSize(nil, "iconSize") + 8)
						else nil,
				}),
				ctx.icon(
					name,
					{
						Name = "TrailingIcon",
						AnchorPoint = V2.new(1, 0.5),
						Position = function(use: ComposeTypes.Use): UDim2
							return D2.new(1, ctx.controlSize(nil, "iconSize", use) + 8, 0.5, 0)
						end,
					},
					if state
						then function(use: ComposeTypes.Use): Theme.SkinState
							return if read(enabled, use) == false
								then "disabled"
								elseif use(state) == E.GuiState.Press then "pressed"
								elseif use(state) == E.GuiState.Hover then "hover"
								elseif selected(use) then "selected"
								else "default"
						end
						else nil
				),
			}
		end, row)
	end
	local function fillTitle(button: GuiObject)
		local content = button:FindFirstChild("Content")
		local words = content and (content:FindFirstChild("Captions") or content:FindFirstChild("Title"))
		if content and content:IsA("GuiObject") and content.Size.X.Scale == 0 then
			content.Size = ctx.types.UDim2.new(1, 0, content.Size.Y.Scale, content.Size.Y.Offset)
			content.AutomaticSize = if content.AutomaticSize == ctx.types.Enum.AutomaticSize.None
				then ctx.types.Enum.AutomaticSize.None
				else ctx.types.Enum.AutomaticSize.Y
		end
		if words and not words:FindFirstChildWhichIsA("UIFlexItem") then
			runtime.mount(function()
				return Host.UIFlexItem({ FlexMode = ctx.types.Enum.UIFlexMode.Fill })
			end, words)
		end
	end
	local function entryRow<V>(
		entrySource: ComposeTypes.Readable<MenuItems.MenuEntry<V>>,
		index: ComposeTypes.Readable<number>,
		state: RowState
	): GuiObject
		local hitFloor, sheeted, rowNodes, widths, enter, close =
			state.hitFloor, state.sheeted, state.rowNodes, state.widths, state.enter, state.close
		local entry = entrySource:peek()
		if entry.heading then
			local title = ctx.text({
				Name = "SectionTitle",
				Text = function(use: ComposeTypes.Use): string
					return use(entrySource).heading or ""
				end,
			})
			title:AddTag("facet-type-caption")
			title:AddTag("facet-secondary")
			return Host.Frame(entry.key)({
				LayoutOrder = index,
				BackgroundTransparency = 1,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
				ctx.padding(12, 4) :: Types.Child,
				title :: Types.Child,
			})
		end
		local source = Compose.formula(function(use: ComposeTypes.Use): Nav.MenuItem<V>
			return assert(use(entrySource).item)
		end)
		local item = source:peek()
		if item.divider then
			return ctx.styled(Host.Frame "Divider" { Size = D2.new(1, 0, 0, 1), LayoutOrder = index }, "divider")
		end
		local rowKey = tostring(item.id or index:peek())
		local trailing = if item.children
			then "chevron.trailing"
			elseif item.checked ~= nil or item.selected ~= nil or item.marked ~= nil then "checkmark"
			else nil
		local simple = item.icon == nil
			and item.description == nil
			and item.avatar == nil
			and ctx.config.controlSize == nil
		local function selected(use: ComposeTypes.Use): boolean
			local live = actionItem(use(source))
			return if live.checked
				then use(live.checked)
				elseif live.selected then use(live.selected) == live.value
				else read(live.marked, use) == true
		end
		local function enabled(use: ComposeTypes.Use): boolean
			return read(actionItem(use(source)).enabled, use) ~= false
		end
		local row: TextButton
		row = UI.Button({
			Name = rowKey,
			LayoutOrder = index,
			AutomaticSize = E.AutomaticSize.Y,
			TextWrapped = true,
			TextTruncate = E.TextTruncate.None,
			Size = function(use: ComposeTypes.Use)
				return D2.new(1, 0, 0, hitFloor(use))
			end,
			label = function(use: ComposeTypes.Use)
				return read(actionItem(use(source)).label, use)
			end,
			icon = item.icon,
			role = item.role,
			trailingIcon = if simple then nil else trailing,
			subtitle = if item.description ~= nil or item.avatar ~= nil
				then function(use: ComposeTypes.Use)
					return read(actionItem(use(source)).description, use) or ""
				end
				else nil,
			TextXAlignment = E.TextXAlignment.Left,
			enabled = enabled,
			selected = selected,
			onActivate = function()
				local live = actionItem(source:peek())
				if read(live.enabled) == false then
					return
				end
				if live.children then
					enter(assert(live.id), row)
				elseif
					commitItem(live)
					and (live.dismiss == true or (live.dismiss ~= false and not live.checked and not live.selected))
				then
					close()
				end
			end,
		})
		if simple and trailing then
			trailingMark(row, trailing, selected, enabled)
		end
		row:AddTag("facet-menu-item")
		if simple then
			ctx.textLayout(row)
		end
		rowNodes[rowKey] = row
		Compose.cleanup(function()
			if rowNodes[rowKey] == row then
				rowNodes[rowKey] = nil
			end
		end)
		fillTitle(row)
		surfaces.attach(row, {
			ctx.styled(
				Host.Frame({
					Name = "Hairline",
					Size = D2.new(1, 0, 0, 1),
					ZIndex = 3,
					Visible = function(use: ComposeTypes.Use)
						return use(entrySource).ruled == true and not use(sheeted)
					end,
				}),
				"menu-hairline"
			) :: Types.Child,
		})
		Compose.watch(function(use: ComposeTypes.Use)
			if hitFloor(use) < ctx.metric("targetSizes.minimum", use) then
				row:AddTag("facet-menu-dense")
			elseif row:HasTag("facet-menu-dense") then
				row:RemoveTag("facet-menu-dense")
			end
		end)
		local accessories: { Types.Child } = {}
		if item.badge ~= nil then
			table.insert(
				accessories,
				UI.Badge({
					Name = "Count",
					LayoutOrder = 1,
					label = function(use: ComposeTypes.Use): string
						local badge = read(actionItem(use(source)).badge, use)
						return if badge == nil then "" else tostring(badge)
					end,
				}) :: Types.Child
			)
		end
		if item.meta ~= nil then
			local meta = ctx.text({
				Name = "Meta",
				LayoutOrder = 0,
				Text = function(use: ComposeTypes.Use): string
					return read(actionItem(use(source)).meta, use) or ""
				end,
			})
			meta:AddTag("facet-secondary")
			table.insert(accessories, meta :: Types.Child)
		end
		if item.shortcutLabel ~= nil then
			local shortcut = ctx.text({
				Name = "Shortcut",
				LayoutOrder = 2,
				Text = function(use: ComposeTypes.Use): string
					return read(actionItem(use(source)).shortcutLabel, use) or ""
				end,
			})
			shortcut:AddTag("facet-secondary")
			table.insert(accessories, shortcut :: Types.Child)
		end
		if #accessories > 0 then
			surfaces.attach(row, {
				Host.Frame "Accessories" {
					BackgroundTransparency = 1,
					AnchorPoint = V2.new(1, 0.5),
					Position = D2.new(1, if item.checked or item.selected or item.marked then -32 else 0, 0.5, 0),
					Size = D2.fromOffset(0, 0),
					AutomaticSize = E.AutomaticSize.XY,
					ZIndex = 2,
					Host.UIListLayout({
						FillDirection = E.FillDirection.Horizontal,
						SortOrder = E.SortOrder.LayoutOrder,
						VerticalAlignment = E.VerticalAlignment.Center,
						Padding = D.new(0, 8),
					}),
					table.unpack(accessories),
				} :: Types.Child,
			})
		end
		local avatar = item.avatar
		local rowContent = row:FindFirstChild("Content")
		if avatar and rowContent then
			runtime.mount(function()
				return UI.Avatar({
					Name = "Avatar",
					LayoutOrder = 0,
					name = avatar.name,
					image = avatar.image,
					userId = avatar.userId,
					controlSize = "compact" :: Types.ControlSize,
					Selectable = false,
					Active = false,
					Interactable = false,
				})
			end, rowContent)
		end
		local check = if item.children then nil else row:FindFirstChild("TrailingIcon", true)
		if check and check:IsA("GuiObject") then
			Compose.watch(function(use: ComposeTypes.Use)
				local live = actionItem(use(source))
				check.Visible = if live.checked
					then use(live.checked) == true
					elseif live.selected then use(live.selected) == live.value
					else read(live.marked, use) == true
			end)
		end
		if item.role == "destructive" then
			row:AddTag("facet-menu-destructive")
		end
		local content = row:FindFirstChild("Content") or row
		if content:IsA("GuiObject") then
			local layout = content:FindFirstChildWhichIsA("UIListLayout")
			if layout then
				layout.HorizontalAlignment = E.HorizontalAlignment.Left
			end
			local natural: ComposeTypes.Readable<Vector2> = if content == row
				then ctx.observe.TextBounds(row)
				else ctx.observe.AbsoluteSize(content)
			local words = content:FindFirstChild("Captions") or content:FindFirstChild("Title")
			local wordsBox: ComposeTypes.Readable<Vector2>? = nil
			local wordsNatural: ComposeTypes.Readable<Vector2>? = nil
			if words and words:IsA("TextLabel") then
				wordsBox, wordsNatural = ctx.observe.AbsoluteSize(words), ctx.observe.TextBounds(words)
			elseif words and words:IsA("GuiObject") then
				local stack = words:FindFirstChildWhichIsA("UIListLayout")
				if stack then
					wordsBox, wordsNatural = ctx.observe.AbsoluteSize(words), ctx.observe.AbsoluteContentSize(stack)
				end
			end
			Compose.watch(function(use: ComposeTypes.Use)
				local width = use(natural).X
				if simple and trailing then
					width += ctx.controlSize(nil, "iconSize", use) + 8
				end
				if wordsBox and wordsNatural then
					width = width - use(wordsBox).X + use(wordsNatural).X
				end
				local next = table.clone(widths:peek())
				next[rowKey] = width
				widths:set(next)
			end)
			Compose.cleanup(function()
				local next = table.clone(widths:peek())
				next[rowKey] = nil
				widths:set(next)
			end)
		end
		return row
	end
	local function ancestorRow<V>(
		row: ComposeTypes.Readable<Nav.MenuItem<V>>,
		index: ComposeTypes.Readable<number>,
		source: ComposeTypes.Readable<AncestorLevel<V>>,
		state: RowState
	): GuiObject
		local hitFloor, path, enter, close = state.hitFloor, state.path, state.enter, state.close
		local item = row:peek()
		if item.divider then
			return ctx.styled(Host.Frame({ Size = D2.new(1, 0, 0, 1), LayoutOrder = index }), "divider")
		end
		local button: GuiObject
		button = UI.Button({
			Name = item.id,
			label = item.label,
			enabled = item.enabled,
			icon = item.icon,
			subtitle = item.description,
			TextXAlignment = E.TextXAlignment.Left,
			LayoutOrder = index,
			Size = function(use: ComposeTypes.Use)
				return D2.new(1, 0, 0, hitFloor(use))
			end,
			selected = function(use: ComposeTypes.Use)
				if use(path)[use(source).depth] == item.id then
					return true
				end
				local live = actionItem(item)
				return if live.checked
					then use(live.checked)
					elseif live.selected then use(live.selected) == live.value
					else read(live.marked, use) == true
			end,
			trailingIcon = if item.children
				then "chevron.trailing"
				elseif item.checked ~= nil or item.selected ~= nil or item.marked ~= nil then "checkmark"
				else nil,
			onActivate = function()
				if item.children then
					enter(assert(item.id), button, source:peek().prefix)
				elseif
					commitItem(item)
					and (item.dismiss == true or (item.dismiss ~= false and not item.checked and not item.selected))
				then
					close()
				end
			end,
		})
		button:AddTag("facet-menu-item")
		fillTitle(button)
		if item.role == "destructive" then
			button:AddTag("facet-menu-destructive")
		end
		local mark = if item.children then nil else button:FindFirstChild("TrailingIcon", true)
		if mark and mark:IsA("GuiObject") then
			Compose.watch(function(use: ComposeTypes.Use)
				local live = actionItem(item)
				mark.Visible = if live.checked
					then use(live.checked) == true
					elseif live.selected then use(live.selected) == live.value
					else read(live.marked, use) == true
			end)
		end
		local content = button:FindFirstChild("Content")
		local layout = if content then content:FindFirstChildWhichIsA("UIListLayout") else nil
		if layout then
			layout.HorizontalAlignment = E.HorizontalAlignment.Left
		end
		surfaces.attach(button, {
			ctx.styled(
				Host.Frame({
					Name = "Hairline",
					Size = D2.new(1, 0, 0, 1),
					ZIndex = 3,
					Visible = function(use: ComposeTypes.Use)
						local before = use(source).items[use(index) - 1]
						return before ~= nil and before.divider ~= true
					end,
				}),
				"menu-hairline"
			) :: Types.Child,
		})
		return button
	end
	return { entry = entryRow, ancestor = ancestorRow }
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="151">
            <Properties>
              <string name="Name">nav_modal</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local surfaceKit = require("./nav_surface_kit")
local overlayPresence = require("./nav_overlay_presence")
local popoverPlacement = require("./nav_popover_placement")
local modalStack = require("./nav_modal_stack")
local overlayPortal = require("./nav_overlay_portal")
local navHelp = require("./nav_help")

return function(ctx: Types.Context): Nav.Surfaces
	local runtime = ctx.runtime
	local function attach<N>(node: N & Instance, children: { Types.Child }): N & Instance
		runtime.mountFragment(function()
			return children
		end, node)
		return node
	end
	local kit = surfaceKit(ctx, attach)
	local presence = overlayPresence(ctx)
	local popover = popoverPlacement(ctx)
	local modal = modalStack(ctx, kit)
	local portal = overlayPortal(ctx, presence)
	navHelp(ctx, kit, presence, portal, popover)
	return {
		modal = modal,
		skin = kit.skin,
		inset = kit.inset,
		centered = kit.centered,
		attach = attach,
		service = kit.service,
		within = kit.within,
		keep = kit.keep,
		firstSelectable = kit.firstSelectable,
		preference = kit.preference,
		selecting = kit.selecting,
		overlay = portal.overlay,
		parent = portal.parent,
		available = portal.available,
		appearance = presence.appearance,
		atRest = presence.atRest,
		popover = popover,
		sheetModal = nil,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="152">
            <Properties>
              <string name="Name">nav_modal_stack</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local scrollLock = require("./scroll_lock")
local surfaceKit = require("./nav_surface_kit")

export type Modal = (() -> GuiObject, (string?) -> (), Nav.ModalOptions?) -> Frame
local screens = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [ScreenGui]: { count: number, clipped: boolean } }

return function(ctx: Types.Context, kit: surfaceKit.Kit): Modal
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local gui = kit.gui
	local within, displayed, firstSelectable = kit.within, kit.displayed, kit.firstSelectable
	local function modal(content: () -> GuiObject, dismiss: (string?) -> (), options: Nav.ModalOptions?): Frame
		local spec: Nav.ModalOptions = options or {}
		local exiting = spec.exiting
		local shown = spec.appearance
		local previous = if gui then gui.SelectedObject else nil
		local preferred = kit.preference()
		local focusIn = kit.selecting()
		local panel = content()
		runtime.decorate(panel, {
			SelectionGroup = true,
			SelectionBehaviorUp = E.SelectionBehavior.Stop,
			SelectionBehaviorDown = E.SelectionBehavior.Stop,
			SelectionBehaviorLeft = E.SelectionBehavior.Stop,
			SelectionBehaviorRight = E.SelectionBehavior.Stop,
			ZIndex = spec.ZIndex or 101,
		})
		local root: Frame
		local function near(point: Vector2): boolean
			local margin = spec.outsideMargin or 24
			local boxes: { GuiObject } = { panel }
			if root and root.AbsoluteSize.X > 0 then
				local full = panel.AbsoluteSize.X >= root.AbsoluteSize.X - 1
					and panel.AbsoluteSize.Y >= root.AbsoluteSize.Y - 1
				if full then
					boxes = {}
					for _, child in panel:GetChildren() do
						if child:IsA("GuiObject") and child.Visible then
							table.insert(boxes, child)
						end
					end
				end
			end
			for _, box in boxes do
				local at, size = box.AbsolutePosition, box.AbsoluteSize
				if
					size.X > 0
					and size.Y > 0
					and point.X >= at.X - margin
					and point.X <= at.X + size.X + margin
					and point.Y >= at.Y - margin
					and point.Y <= at.Y + size.Y + margin
				then
					return true
				end
			end
			return false
		end
		local back = function()
			if root and not ctx.available(root) then
				return
			end
			if ctx.read(spec.canDismiss) ~= false then
				dismiss("cancel")
			end
		end
		local props: Types.FrameNativeProps = {
			Name = spec.Name or "Modal",
			BorderSizePixel = 0,
			Size = D2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Active = true,
			ZIndex = spec.ZIndex or 100,
			Host.TextButton "DismissOutside" {
				BorderSizePixel = 0,
				Size = D2.fromScale(1, 1),
				Active = true,
				Text = "",
				BackgroundTransparency = if spec.backgroundTransparency == nil
					then nil
					else function(use: ComposeTypes.Use)
						local authored = ctx.read(spec.backgroundTransparency, use)
						local value = if type(authored) == "number" then math.clamp(authored, 0, 1) else 1
						local amount = if shown then shown(use) else 1
						return if value >= 1 then 1 else 1 - (1 - value * preferred(use)) * amount
					end,
				BackgroundColor3 = if spec.backgroundTransparency == nil then nil else ctx.types.Color3.new(0, 0, 0),
				AutoButtonColor = false,
				Selectable = false,
				ZIndex = spec.ZIndex or 100,
				Activated = function(input)
					if root and not ctx.available(root) then
						return
					end
					if input and input.Position and near(V2.new(input.Position.X, input.Position.Y)) then
						return
					end
					if ctx.read(spec.outsideDismiss) ~= false and ctx.read(spec.canDismiss) ~= false then
						if spec.onOutside then
							spec.onOutside()
						else
							back()
						end
					end
				end,
			} :: Instance,
			panel,
		}
		if exiting then
			props.Interactable = function(use: ComposeTypes.Use)
				return not use(exiting)
			end
		end
		root = Host.Frame(props)
		local heldScreen: ScreenGui? = nil
		local function releaseScreen()
			local screen = heldScreen
			heldScreen = nil
			local lease = if screen then screens[screen] else nil
			if screen and lease then
				lease.count -= 1
				if lease.count == 0 then
					screens[screen] = nil
					screen.ClipToDeviceSafeArea = lease.clipped
				end
			end
		end
		local function acquireScreen()
			local screen = root:FindFirstAncestorWhichIsA("ScreenGui")
			if screen == heldScreen then
				return
			end
			releaseScreen()
			if screen then
				local lease = screens[screen]
				if lease == nil then
					lease = { count = 0, clipped = screen.ClipToDeviceSafeArea == true }
					screens[screen] = lease
				end
				lease.count += 1
				heldScreen = screen
				screen.ClipToDeviceSafeArea = false
			end
		end
		runtime.connect(root, "AncestryChanged", acquireScreen)
		acquireScreen()
		Compose.cleanup(releaseScreen)
		local catcher = root:FindFirstChild("DismissOutside")
		if spec.backgroundTransparency == nil and catcher then
			catcher:AddTag("facet-scrim")
			if shown then
				kit.attach(catcher, {
					Compose.show(function(use: ComposeTypes.Use): boolean
						return shown(use) < 1
					end, function()
						return Host.UIGradient "ScrimFade" {
							Transparency = function(use: ComposeTypes.Use)
								return ctx.types.NumberSequence.new(1 - shown(use))
							end,
						}
					end),
				})
			end
		end
		if catcher and catcher:IsA("GuiObject") and gui then
			local service: GuiService = gui
			local band = ctx.observe.TopbarInset(service)
			local parent = ctx.observe.Parent(root)
			local bounds = ctx.observe.AbsoluteSize(root)
			local unit = ctx.layoutUnit(root)
			local expansion = Compose.cell({ near = V2.zero, far = V2.zero, scale = 1 })
			Compose.watch(function(use: ComposeTypes.Use)
				use(band)
				use(parent)
				use(bounds)
				local scale = math.max(use(unit), 0.001)
				local screen = root:FindFirstAncestorWhichIsA("ScreenGui")
				local near, far = V2.zero, V2.zero
				if screen then
					local measured = false
					if service.GetInsetArea then
						local ok, full, content = pcall(function(): (Rect, Rect)
							return service:GetInsetArea(E.ScreenInsets.None), service:GetInsetArea(screen.ScreenInsets)
						end)
						if ok then
							near, far = content.Min - full.Min, full.Max - content.Max
							measured = true
						end
					end
					if
						not measured
						and not screen.IgnoreGuiInset
						and screen.ScreenInsets == E.ScreenInsets.CoreUISafeInsets
					then
						local ok, topLeft, bottomRight = pcall(service.GetGuiInset, service)
						if ok and typeof(topLeft) == "Vector2" then
							near = topLeft
							far = if typeof(bottomRight) == "Vector2" then bottomRight else V2.zero
						end
					end
				end
				expansion:set({ near = near, far = far, scale = scale })
			end)
			runtime.decorate(catcher, {
				Position = function(use: ComposeTypes.Use): UDim2
					local value = use(expansion)
					return D2.fromOffset(-value.near.X / value.scale, -value.near.Y / value.scale)
				end,
				Size = function(use: ComposeTypes.Use): UDim2
					local value = use(expansion)
					return D2.new(
						1,
						(value.near.X + value.far.X) / value.scale,
						1,
						(value.near.Y + value.far.Y) / value.scale
					)
				end,
			})
		end
		local released = false
		local landed = false
		local owned = false
		local function reclaimable(selected: Instance?): boolean
			if selected == nil or selected.Parent == nil or within(selected, root) then
				return true
			end
			if not owned or selected == previous then
				return false
			end
			for _, scope in ctx.modalScopes:peek() do
				if scope ~= root and within(selected, scope) then
					return false
				end
			end
			return true
		end
		local locked: Instance? = nil
		local function unlock()
			local layer = locked
			locked = nil
			if layer then
				scrollLock.release(layer, root)
			end
		end
		local function lock()
			local layer = if released then nil else root:FindFirstAncestorWhichIsA("LayerCollector")
			if layer == locked then
				return
			end
			unlock()
			if layer then
				locked = layer
				scrollLock.acquire(layer, root)
			end
		end
		runtime.connect(root, "AncestryChanged", lock)
		local function claim()
			local modals = table.clone(ctx.modalScopes:peek())
			table.insert(modals, root)
			ctx.modalScopes:set(modals)
			released = false
			lock()
		end
		claim()
		local function release()
			if released then
				return
			end
			released = true
			unlock()
			local remaining = {}
			for _, modal in ctx.modalScopes:peek() do
				if modal ~= root then
					table.insert(remaining, modal)
				end
			end
			ctx.modalScopes:set(remaining)
			if gui then
				if reclaimable(gui.SelectedObject) then
					gui.SelectedObject = if previous
							and previous.Parent ~= nil
							and not within(previous, root)
						then previous
						else nil
				end
			end
		end
		Compose.cleanup(release)
		if exiting then
			Compose.watch(function(use: ComposeTypes.Use)
				if use(exiting) then
					release()
				elseif released then
					local selected = if gui then gui.SelectedObject else nil
					if selected and not within(selected, root) then
						previous = selected
					end
					claim()
					landed = false
					owned = false
					if gui and selected then
						gui.SelectedObject = firstSelectable(panel, spec.initialFocus) or firstSelectable(panel)
					end
				end
			end)
		end
		ctx.action(
			root,
			"ModalBack",
			{ E.KeyCode.Escape, E.KeyCode.ButtonB },
			true,
			back,
			{ priority = spec.priority or 2000 }
		)
		if gui then
			local guiService: GuiService = gui
			local mounted = ctx.observe.Parent(root)
			local ancestry = Compose.cell(0)
			runtime.connect(root, "AncestryChanged", function()
				ancestry:set(ancestry:peek() + 1)
			end)
			local rootInteractive = ctx.observe.Interactable(root)
			local rootVisible = ctx.observe.Visible(root)
			local panelInteractive = ctx.observe.Interactable(panel)
			Compose.watch(function(use: ComposeTypes.Use)
				if not use(rootInteractive) or not use(panelInteractive) then
					if reclaimable(guiService.SelectedObject) then
						guiService.SelectedObject = if previous
								and previous.Parent ~= nil
								and not within(previous, root)
							then previous
							else nil
					end
				elseif
					use(mounted)
					and use(rootVisible)
					and use(ancestry) >= 0
					and not (exiting and use(exiting))
					and focusIn(use)
					and not within(guiService.SelectedObject, root)
				then
					local target = firstSelectable(panel, spec.initialFocus) or firstSelectable(panel)
					if target and displayed(target) then
						pcall(function()
							guiService.SelectedObject = target
						end)
					end
				end
			end)
			local selection = ctx.observe.SelectedObject(gui)
			local extent = ctx.observe.AbsoluteSize(panel)
			Compose.watch(function(use: ComposeTypes.Use)
				local selected = use(selection) :: Instance?
				use(extent)
				local scopes = use(ctx.modalScopes)
				if within(selected, root) then
					landed = true
					owned = true
					return
				end
				if
					selected ~= nil
					and scopes[#scopes] == root
					and use(mounted)
					and use(rootVisible)
					and not (exiting and use(exiting))
					and not focusIn(use)
				then
					guiService.SelectedObject = nil
					return
				end
				if not released and not (exiting and exiting:peek()) and root.Interactable and panel.Interactable then
					owned = false
				end
				if
					landed
					or scopes[#scopes] ~= root
					or not use(mounted)
					or not use(rootVisible)
					or (exiting and use(exiting))
					or not use(rootInteractive)
					or not use(panelInteractive)
					or not focusIn(use)
				then
					return
				end
				local target = firstSelectable(panel, spec.initialFocus) or firstSelectable(panel)
				if target and target.AbsoluteSize.X > 0 and target.AbsoluteSize.Y > 0 and displayed(target) then
					pcall(function()
						guiService.SelectedObject = target
					end)
				end
			end)
		end
		return root
	end
	return modal
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="153">
            <Properties>
              <string name="Name">nav_notice</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local Overlay = require("./overlay_types")
local ComposeTypes = require("../vendor/compose/core")
local Theme = require("./theme_types")
local parts = require("./overlay_parts")
local reservations = require("./reservations")
local motion = require("./motion")
local freeze = require("./freeze")
local OverlayProps = require("./overlay_props")

local NOTICE_KEYS = {
	"message",
	"title",
	"severity",
	"appearance",
	"placement",
	"icon",
	"link",
	"actions",
	"onDismiss",
	"controlSize",
}
local NAV_KEYS = {
	"onBack",
	"backLabel",
	"title",
	"titleSize",
	"leading",
	"center",
	"trailing",
	"gap",
	"padding",
	"surface",
}
local SEVERITIES: { [string]: string } = freeze({
	info = "status.info",
	success = "status.success",
	warning = "status.warning",
	error = "status.error",
})

local ICON_TAGS: { [string]: string } = freeze({
	info = "facet-icon-info",
	success = "facet-icon-success",
	warning = "facet-icon-warning",
	error = "facet-icon-error",
})

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces): ()
	local Compose, Host, runtime, read = ctx.Compose, ctx.Host, ctx.runtime, ctx.read
	local E, D2, UD = ctx.types.Enum, ctx.types.UDim2, ctx.types.UDim

	local function space(value: (number | string)?, fallback: string, use: ComposeTypes.Use?): number
		if type(value) == "number" then
			return value
		end
		return ctx.metric("space." .. (value or fallback), use)
	end

	UI.Notice = ctx.construct("Notice", function(spec: OverlayProps.NoticeSpec): Frame
		local where = "UI.Notice"
		if not parts.bound(ctx, spec.message, "string") then
			error(`Facet {where}: message is required; it is a string or a bound string`, 0)
		end
		if spec.title ~= nil and not parts.bound(ctx, spec.title, "string") then
			error(`Facet {where}: title must be a string or a bound string`, 0)
		end
		local severity = spec.severity or "info"
		if SEVERITIES[severity] == nil then
			error(`Facet {where}: severity must be info, success, warning or error`, 0)
		end
		local appearance = spec.appearance or "standard"
		if appearance ~= "standard" and appearance ~= "emphasis" then
			error(`Facet {where}: appearance must be standard or emphasis`, 0)
		end
		local placement = spec.placement or "inline"
		if placement ~= "inline" and placement ~= "affixed" then
			error(`Facet {where}: placement must be inline or affixed`, 0)
		end
		if spec.icon ~= nil and type(spec.icon) ~= "boolean" and (type(spec.icon) ~= "string" or spec.icon == "") then
			error(`Facet {where}: icon must be true, false, or an icon name or image source`, 0)
		end
		local link = spec.link
		if link ~= nil then
			if type(link) ~= "table" then
				error(`Facet {where}: link must be \{ label, onActivate }`, 0)
			end
			parts.known(where, (link :: unknown) :: { [string]: unknown }, { "label", "onActivate" }, "link")
			if not parts.bound(ctx, link.label, "string") or type(link.onActivate) ~= "function" then
				error(`Facet {where}: link needs a label and an onActivate function`, 0)
			end
		end
		if spec.onDismiss ~= nil and type(spec.onDismiss) ~= "function" then
			error(`Facet {where}: onDismiss must be a function`, 0)
		end
		local size = ctx.read(spec.controlSize)
		if size ~= nil and size ~= "xsmall" and size ~= "compact" and size ~= "regular" and size ~= "large" then
			error(`Facet {where}: controlSize must be xsmall, compact, regular or large`, 0)
		end
		local actions: { Overlay.Action } = spec.actions or {}
		parts.checkActions(ctx, where, spec.actions, 2, { "Link", "Close" })
		local level = motion.level(ctx)
		local reveal = ctx.motionTiming("reveal")
		local present = Compose.cell(false)
		local leaving = Compose.cell(false)
		local travel = runtime.tween(function(use: ComposeTypes.Use): number
			return if use(present) then 1 else 0
		end, {
			seconds = function(_: ComposeTypes.Use): number
				return if present:peek() then reveal.enter else reveal.exit
			end,
			ease = ctx.motionEase("present"),
		})
		local shade = runtime.tween(function(use: ComposeTypes.Use): number
			return if use(present) then 1 else 0
		end, { seconds = ctx.metric("motion.reducedFade"), ease = ctx.motionEase("fade") })
		local function progress(use: ComposeTypes.Use?): number
			local current = level(use)
			if current == "limited" then
				return 1
			elseif current == "none" then
				return if read(present, use) then 1 else 0
			end
			return read(travel, use)
		end
		local emphasis = appearance == "emphasis"
		local status = "facet-status-" .. severity
		local offered = Compose.cell(0)
		local copyNatural = Compose.cell(0)
		local accessoryWidth = Compose.cell(0)
		local function panelCarve(use: ComposeTypes.Use?): { left: number, right: number, top: number, bottom: number }
			local package = if emphasis then nil else read(ctx.config.theme, use)
			local chrome: { [string]: Theme.SkinLayer } = if package then package.chrome or {} else {}
			local recipe = chrome.panel
			local inset: Theme.Insets = if recipe then recipe.contentInsets or {} else {}
			return {
				left = math.max(8, inset.left or 0),
				right = math.max(8, inset.right or 0),
				top = math.max(8, inset.top or 0),
				bottom = math.max(8, inset.bottom or 0),
			}
		end
		local beside = Compose.formula(function(use: ComposeTypes.Use): boolean
			if link == nil and #actions == 0 then
				return true
			end
			local carve = panelCarve(use)
			local chrome = ctx.metric("targetSizes.minimum", use) * 2 + 4 * 8 + carve.left + carve.right - 16
			return use(copyNatural) + use(accessoryWidth) + chrome <= use(offered)
		end)
		local function lettering<N>(node: N & Instance): N & Instance
			if emphasis then
				node:AddTag(status)
			end
			return node
		end
		local copy: { Types.Child } = {}
		if spec.title ~= nil then
			local title = spec.title
			local heading = lettering(ctx.text({
				Name = "Title",
				Text = function(use: ComposeTypes.Use)
					return read(title, use) or ""
				end,
				TextWrapped = true,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
			}))
			heading:AddTag("facet-type-label")
			heading:AddTag("facet-strong")
			table.insert(copy, heading)
		end
		local message = lettering(ctx.text({
			Name = "Message",
			Text = function(use: ComposeTypes.Use)
				return read(spec.message, use) or ""
			end,
			TextWrapped = true,
			Size = D2.new(1, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
		}))
		table.insert(copy, message)
		local textService = ctx.config.services and ctx.config.services.TextService
		if textService then
			local width, unit = ctx.observe.AbsoluteSize(message), ctx.layoutUnit(message)
			local face = ctx.observeStyled.FontFace(message)
			local points = ctx.observeStyled.TextSize(message)
			local serial, last = 0, ""
			Compose.watch(function(use: ComposeTypes.Use)
				local wide = use(width).X / use(unit)
				local text: string = read(spec.message, use) or ""
				local font, size = use(face) :: Font, use(points) :: number
				local key = `{wide}|{text}|{size}|{font.Family}|{font.Weight.Name}`
				if wide <= 0 or text == "" or key == last then
					return
				end
				last = key
				serial += 1
				local ticket = serial
				task.spawn(function()
					local ok, bounds = pcall(function()
						local params = ((Host :: unknown) :: { [string]: (props: { [string]: unknown }) -> Instance }).GetTextBoundsParams({
							Text = text,
							Font = font,
							Size = size,
							Width = wide,
						})
						return (textService :: TextService):GetTextBoundsAsync(params :: GetTextBoundsParams)
					end)
					if ok and ticket == serial and message.Parent ~= nil and bounds.Y > 0 then
						message.AutomaticSize = E.AutomaticSize.None
						message.Size = D2.new(1, 0, 0, bounds.Y)
					end
				end)
			end)
		end
		local measure = ctx.text({
			Name = "MessageMeasure",
			Text = function(use: ComposeTypes.Use)
				return read(spec.message, use) or ""
			end,
			TextWrapped = false,
			TextTransparency = 1,
			Size = D2.fromOffset(0, 0),
			AutomaticSize = E.AutomaticSize.None,
			Visible = false,
		})
		local natural = ctx.observe.TextBounds(measure)
		Compose.watch(function(use: ComposeTypes.Use)
			copyNatural:set(math.ceil(use(natural).X))
		end)
		table.insert(copy, measure)
		local copyFrame = ctx.column(copy, {
			Name = "Copy",
			Size = D2.new(1, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
			Host.UIFlexItem({
				FlexMode = function(use: ComposeTypes.Use)
					return if use(beside) then E.UIFlexMode.Fill else E.UIFlexMode.None
				end,
			}) :: Instance,
		})
		local bodyChildren: { Types.Child } = { copyFrame }
		if link ~= nil or #actions > 0 then
			local accessories: { Types.Child } = {}
			if link then
				table.insert(
					accessories,
					UI.Button "Link" {
						label = link.label,
						appearance = if emphasis then nil else "link",
						controlSize = spec.controlSize,
						onActivate = link.onActivate,
					}
				)
			end
			for _, action in actions do
				table.insert(
					accessories,
					UI.Button({
						Name = action.id,
						label = action.label,
						enabled = action.enabled,
						busy = action.busy,
						role = if action.role == "destructive" then "destructive" :: "destructive" else nil,
						appearance = if action.role == "default" and not emphasis then "emphasis" else nil,
						controlSize = spec.controlSize,
						onActivate = action.onActivate,
					})
				)
			end
			local row = ctx.row(accessories, { Name = "Accessories" })
			local list = row:FindFirstChildWhichIsA("UIListLayout") :: UIListLayout?
			if list then
				list.Wraps = true
				list.VerticalAlignment = E.VerticalAlignment.Center
			end
			local rowSize = ctx.observe.AbsoluteSize(row)
			Compose.watch(function(use: ComposeTypes.Use)
				accessoryWidth:set(use(rowSize).X)
			end)
			table.insert(bodyChildren, row)
		end
		local bodyProps: Types.CanvasGroupNativeProps = {
			Name = "Body",
			GroupTransparency = function(use: ComposeTypes.Use)
				return if level(use) == "limited" then 1 - use(shade) else 0
			end,
			BackgroundTransparency = 1,
			Size = D2.new(0, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
		}
		bodyProps[#bodyProps + 1] = Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill })
		bodyProps[#bodyProps + 1] = Host.UIListLayout({
			FillDirection = function(use: ComposeTypes.Use)
				return if use(beside) then E.FillDirection.Horizontal else E.FillDirection.Vertical
			end,
			VerticalAlignment = E.VerticalAlignment.Center,
			SortOrder = E.SortOrder.LayoutOrder,
			Padding = UD.new(0, 8),
		})
		for index, child in bodyChildren do
			runtime.decorate(child :: Instance, { LayoutOrder = index })
			bodyProps[#bodyProps + 1] = child
		end
		local rowChildren: { Types.Child } = {}
		if spec.icon ~= false then
			local mark = ctx.icon(if type(spec.icon) == "string" then spec.icon else SEVERITIES[severity], {
				Name = "Icon",
				LayoutOrder = 1,
			})
			if not emphasis then
				mark:AddTag(ICON_TAGS[severity])
			end
			table.insert(rowChildren, mark)
		end
		local body = ctx.fade(bodyProps)
		table.insert(rowChildren, body)
		local gui = surfaces.service("GuiService")
		local frames = runtime.host.frames
		local noticeOwner = assert(Compose.currentOwner())
		local root: Frame
		local stopWaiting: (() -> ())? = nil
		local function stopWatching()
			local stop = stopWaiting
			stopWaiting = nil
			if stop then
				stop()
			end
		end
		Compose.cleanup(stopWatching)
		local function collapse(report: () -> ())
			if leaving:peek() then
				return
			end
			local function finish()
				leaving:set(false)
				report()
				if not noticeOwner.isDisposed() then
					present:set(true)
				end
			end
			if frames == nil or level() == "none" or progress() <= 0 then
				finish()
				return
			end
			leaving:set(true)
			if gui and surfaces.within(gui.SelectedObject, root) then
				gui.SelectedObject = nil
			end
			present:set(false)
			stopWaiting = frames.onFrame(function()
				local current = level()
				if (current == "normal" and progress() > 0) or (current == "limited" and shade:peek() > 0) then
					return
				end
				stopWatching()
				finish()
			end)
		end
		if spec.onDismiss then
			local dismiss = spec.onDismiss
			table.insert(
				rowChildren,
				UI.Button "Close" {
					name = "Close",
					icon = "close",
					controlSize = spec.controlSize,
					Size = D2.fromOffset(44, 44),
					AutomaticSize = E.AutomaticSize.None,
					LayoutOrder = 3,
					onActivate = function()
						collapse(dismiss)
					end,
				}
			)
		end
		local defaults: Types.FrameNativeProps = {
			Name = "Notice",
			Size = D2.new(1, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			ZIndex = if placement == "affixed" then 50 else nil,
		}
		local native = (ctx.props(spec, NOTICE_KEYS, defaults) :: unknown) :: { [unknown]: unknown }
		local restSize, restAutomatic, restClip, restInteractable =
			native.Size, native.AutomaticSize, native.ClipsDescendants, native.Interactable
		local inset = Host.UIPadding({
			PaddingLeft = function(use: ComposeTypes.Use)
				return UD.new(0, panelCarve(use).left)
			end,
			PaddingRight = function(use: ComposeTypes.Use)
				return UD.new(0, panelCarve(use).right)
			end,
			PaddingTop = function(use: ComposeTypes.Use)
				return UD.new(0, panelCarve(use).top)
			end,
			PaddingBottom = function(use: ComposeTypes.Use)
				return UD.new(0, panelCarve(use).bottom)
			end,
		})
		local bodyExtent = ctx.observe.AbsoluteSize(body)
		local function settled(use: ComposeTypes.Use): boolean
			return progress(use) >= 1
		end
		native.AutomaticSize = function(use: ComposeTypes.Use): unknown
			return if settled(use) then read(restAutomatic, use) else E.AutomaticSize.None
		end
		native.Size = function(use: ComposeTypes.Use): unknown
			local rest = read(restSize, use)
			if settled(use) then
				return rest
			end
			local width = if typeof(rest) == "UDim2" then (rest :: UDim2).X else UD.new(1, 0)
			local tallest = use(bodyExtent).Y
			for _, child in rowChildren do
				if typeof(child) == "Instance" and child ~= body and (child :: Instance):IsA("GuiObject") then
					tallest = math.max(tallest, (child :: GuiObject).Size.Y.Offset)
				end
			end
			local height = tallest + inset.PaddingTop.Offset + inset.PaddingBottom.Offset
			return D2.new(width.Scale, width.Offset, 0, math.floor(height * progress(use) + 0.5))
		end
		native.ClipsDescendants = function(use: ComposeTypes.Use): unknown
			return if settled(use) then read(restClip, use) == true else true
		end
		native.Interactable = function(use: ComposeTypes.Use): unknown
			return not use(leaving) and read(restInteractable, use) ~= false
		end
		root = Host.Frame((native :: unknown) :: Types.FrameNativeProps)
		present:set(true)
		surfaces.attach(root, {
			inset,
			ctx.corner(),
			Host.UIListLayout({
				FillDirection = E.FillDirection.Horizontal,
				VerticalAlignment = E.VerticalAlignment.Top,
				SortOrder = E.SortOrder.LayoutOrder,
				Padding = UD.new(0, 8),
			}),
		})
		surfaces.attach(root, rowChildren)
		ctx.styled(root, "notice")
		ctx.styled(root, if emphasis then "status-" .. severity else "panel")
		if not emphasis then
			ctx.skin(root, "panel")
		end
		root:SetAttribute("NoticeSeverity", severity)
		local extent = ctx.observe.AbsoluteSize(root)
		Compose.watch(function(use: ComposeTypes.Use)
			offered:set(use(extent).X)
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			root:SetAttribute("NoticeAccessories", if use(beside) then "beside" else "below")
		end)
		if placement == "affixed" then
			local owner = assert(Compose.currentOwner())
			local token = {}
			local at = ctx.observe.AbsolutePosition(root)
			local layerOwner: ComposeTypes.Owner? = nil
			local current: Instance? = nil
			local function locate()
				if owner.isDisposed() then
					return
				end
				if layerOwner then
					layerOwner.dispose()
				end
				if current then
					reservations.clear(current, token)
					current = nil
				end
				local child = owner.createChild()
				layerOwner = child
				Compose.withOwner(child, function()
					local layer = root:FindFirstAncestorWhichIsA("LayerCollector")
					if layer == nil then
						return
					end
					current = layer
					local origin = ctx.observe.AbsolutePosition(layer)
					local height = ctx.observe.AbsoluteSize(layer)
					local function publish()
						local box = root.AbsoluteSize
						local paints = box.X > 0 and box.Y > 0 and root.Visible
						local top = root.AbsolutePosition.Y - (layer :: GuiBase2d).AbsolutePosition.Y
						reservations.set(
							layer,
							token,
							"top",
							if paints then top else nil,
							if paints then box.Y else nil
						)
					end
					local services = ctx.config.services
					local frames = services and services.RunService
					local connection: RBXScriptConnection? = nil
					local function release()
						if connection then
							connection:Disconnect()
							connection = nil
						end
					end
					Compose.cleanup(release)
					Compose.watch(function(use: ComposeTypes.Use)
						use(height)
						use(at)
						use(origin)
						use(extent)
						publish()
						if frames then
							release()
							connection = frames.Heartbeat:Connect(function()
								release()
								publish()
							end)
						end
					end)
				end)
			end
			runtime.connect(root, "AncestryChanged", locate)
			locate()
			Compose.cleanup(function()
				if current then
					reservations.clear(current, token)
				end
			end)
		end
		return root
	end)

	UI.NavBar = ctx.construct("NavBar", function(spec: OverlayProps.NavBarSpec): Frame
		local where = "UI.NavBar"
		if spec.onBack ~= nil and type(spec.onBack) ~= "function" then
			error(`Facet {where}: onBack must be a function`, 0)
		end
		if spec.trailing ~= nil and not parts.instance(spec.trailing) then
			error(`Facet {where}: trailing is one GuiObject; put a cluster in a frame`, 0)
		end
		for _, key in { "leading", "center" } do
			local slot = (spec :: { [unknown]: unknown })[key]
			if slot ~= nil and not parts.instance(slot) then
				error(`Facet {where}: {key} must be a GuiObject`, 0)
			end
		end
		if spec.title ~= nil and not parts.bound(ctx, spec.title, "string") then
			error(`Facet {where}: title must be a string or a bound string`, 0)
		end
		local plate = ({ surface = "facet-surface", panel = "facet-panel", pane = "facet-pane" })[spec.surface or ""]
		if spec.surface ~= nil and plate == nil then
			error(`Facet {where}: surface must be surface, panel or pane`, 0)
		end
		local gap = function(use: ComposeTypes.Use?): number
			return space(spec.gap, "s", use)
		end
		local primary: { Types.Child } = {}
		if spec.onBack then
			table.insert(primary, parts.back(ctx, UI, spec.backLabel, spec.onBack))
			table.insert(
				primary,
				Host.Frame "BackGap" {
					BackgroundTransparency = 1,
					Size = function(use: ComposeTypes.Use)
						return D2.fromOffset(ctx.metric("space.s", use), 0)
					end,
				}
			)
		end
		if spec.leading then
			table.insert(primary, ctx.row({ spec.leading }, { Name = "Leading" }))
		end
		local center: Instance? = spec.center
		local titleMeasure: TextLabel? = nil
		if center == nil and spec.title ~= nil then
			local title = spec.title
			local label = ctx.text({
				Name = "Title",
				Text = function(use: ComposeTypes.Use)
					return read(title, use) or ""
				end,
				TextWrapped = false,
				TextTruncate = E.TextTruncate.AtEnd,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
			})
			label:AddTag("facet-type-" .. (spec.titleSize or "title"))
			center = label
			local measure = ctx.text({
				Name = "TitleMeasure",
				Text = function(use: ComposeTypes.Use)
					return read(title, use) or ""
				end,
				Visible = false,
				TextWrapped = false,
				Size = D2.fromOffset(0, 0),
				AutomaticSize = E.AutomaticSize.XY,
			})
			measure:AddTag("facet-type-" .. (spec.titleSize or "title"))
			titleMeasure = measure
		end
		local centerProps: Types.FrameNativeProps = {
			Name = "Center",
			BackgroundTransparency = 1,
			Size = D2.new(0, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
		}
		centerProps[#centerProps + 1] = Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill })
		centerProps[#centerProps + 1] = Host.UIListLayout({
			FillDirection = E.FillDirection.Horizontal,
			VerticalAlignment = E.VerticalAlignment.Center,
			SortOrder = E.SortOrder.LayoutOrder,
		})
		if center then
			centerProps[#centerProps + 1] = center
		end
		if titleMeasure then
			centerProps[#centerProps + 1] = titleMeasure
		end
		local centerFrame = Host.Frame(centerProps)
		table.insert(primary, centerFrame)
		local primaryFrame = ctx.row(primary, {
			Name = "Primary",
			Size = D2.new(1, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
		})
		local stacked = Compose.cell(false)
		local rootChildren: { Types.Child } = { primaryFrame }
		local trailingFrame: GuiObject? = nil
		if spec.trailing then
			local trailing = Host.ScrollingFrame "Trailing" {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = D2.fromOffset(0, 0),
				AutomaticSize = E.AutomaticSize.XY,
				AutomaticCanvasSize = E.AutomaticSize.X,
				CanvasSize = D2.fromOffset(0, 0),
				CanvasPosition = ctx.types.Vector2.zero,
				ScrollingDirection = E.ScrollingDirection.X,
				ScrollBarThickness = 0,
				ClipsDescendants = true,
				Host.UIListLayout {
					FillDirection = E.FillDirection.Horizontal,
					HorizontalAlignment = E.HorizontalAlignment.Left,
					SortOrder = E.SortOrder.LayoutOrder,
				},
				spec.trailing,
			}
			trailingFrame = trailing
			table.insert(rootChildren, trailing)
		end
		local root = ctx.row(
			rootChildren,
			ctx.props(spec, NAV_KEYS, {
				Name = "NavBar",
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
			})
		)
		if plate then
			root:AddTag(plate)
		end
		local list = root:FindFirstChildWhichIsA("UIListLayout") :: UIListLayout?
		if list then
			runtime.decorate(list, {
				FillDirection = function(use: ComposeTypes.Use)
					return if use(stacked) then E.FillDirection.Vertical else E.FillDirection.Horizontal
				end,
				HorizontalAlignment = E.HorizontalAlignment.Right,
				VerticalAlignment = E.VerticalAlignment.Center,
				Padding = function(use: ComposeTypes.Use)
					return UD.new(0, gap(use))
				end,
			})
		end
		local rows: { GuiObject } = { primaryFrame }
		if trailingFrame then
			table.insert(rows, trailingFrame)
		end
		for _, frame in rows do
			local layout = frame:FindFirstChildWhichIsA("UIListLayout") :: UIListLayout?
			if layout then
				runtime.decorate(layout, {
					VerticalAlignment = E.VerticalAlignment.Center,
					Padding = function(use: ComposeTypes.Use)
						return UD.new(0, gap(use))
					end,
				})
			end
		end
		local primaryFlex = Host.UIFlexItem({
			FlexMode = function(use: ComposeTypes.Use)
				return if use(stacked) then E.UIFlexMode.None else E.UIFlexMode.Fill
			end,
		})
		surfaces.attach(primaryFrame, { primaryFlex })
		runtime.decorate(primaryFrame, {
			Size = function(use: ComposeTypes.Use)
				return if use(stacked) then D2.new(1, 0, 0, 0) else D2.new(0, 0, 0, 0)
			end,
		})
		if spec.padding ~= nil then
			surfaces.attach(root, { ctx.padding(space(spec.padding, "s"), space(spec.padding, "s")) })
		end
		if trailingFrame then
			local available = ctx.layoutSize(root)
			local unit = ctx.layoutUnit(root :: GuiObject)
			local trailingLayout = assert(trailingFrame:FindFirstChildWhichIsA("UIListLayout")) :: UIListLayout
			local content = ctx.observe.AbsoluteContentSize(trailingLayout)
			local scrollStyle = (ctx.observeStyled :: unknown) :: {
				ScrollBarThickness: (ScrollingFrame) -> ComposeTypes.Cell<number>,
			}
			local thickness = scrollStyle.ScrollBarThickness(trailingFrame :: ScrollingFrame)
			local function offered(use: ComposeTypes.Use): number
				local width = use(available).X
				return if width > 0
					then math.max(0, width - (if spec.padding ~= nil then 2 * space(spec.padding, "s", use) else 0))
					else math.huge
			end
			runtime.decorate(trailingFrame, {
				AutomaticSize = E.AutomaticSize.None,
				Size = function(use: ComposeTypes.Use): UDim2
					local size = use(content) / use(unit)
					return D2.fromOffset(size.X, size.Y + (if size.X > offered(use) then use(thickness) else 0))
				end,
			})
			runtime.mount(function()
				return Host.UISizeConstraint "ViewportBounds" {
					MaxSize = function(use: ComposeTypes.Use): Vector2
						return ctx.types.Vector2.new(offered(use), math.huge)
					end,
				}
			end, trailingFrame)
			local box = ctx.observe.AbsoluteSize(root)
			local sides = ctx.observe.AbsoluteSize(trailingFrame)
			local before: { ComposeTypes.Readable<Vector2> } = {}
			for _, child in primaryFrame:GetChildren() do
				if child:IsA("GuiObject") and child ~= centerFrame then
					table.insert(before, ctx.observe.AbsoluteSize(child))
				end
			end
			local natural = if titleMeasure then ctx.observe.TextBounds(titleMeasure) else nil
			Compose.watch(function(use: ComposeTypes.Use)
				local scale = use(unit)
				local width = use(box).X / scale
				if width <= 0 or use(sides).X <= 0 then
					return
				end
				local fixed = 0
				for _, size in before do
					fixed += use(size).X / scale + gap(use)
				end
				local room = width - fixed - use(sides).X / scale - gap(use)
				local wanted = if natural then use(natural).X / scale else ctx.metric("controls.popup.panelWidth", use)
				local floor = math.min(wanted, width - fixed)
				local next = room < floor
				if next ~= stacked:peek() then
					stacked:set(next)
				end
			end)
		end
		return root
	end)
end
]]></string>
