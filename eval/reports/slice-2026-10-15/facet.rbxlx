          <Item class="Folder" referent="241">
            <Properties>
              <string name="Name">compose</string>
            </Properties>
            <Item class="ModuleScript" referent="242">
              <Properties>
                <string name="Name">core</string>
                <string name="Source"><![CDATA[--!strict

local AccumulatorModule = require "@self/accumulator"
local Active = require "@self/ownership/active"
local AnimationCodec = require "@self/animation/codec"
local AnimationEasing = require "@self/animation/easing"
local AnimationSpring = require "@self/animation/spring"
local AsyncBoundary = require "@self/async/boundary"
local AsyncShared = require "@self/async/shared"
local Diagnostics = require "@self/diagnostics"
local FocusScope = require "@self/focus-scope"
local Geometry = require "@self/geometry"
local FocusNeighbor = require "@self/focus-neighbor"
local Graph = require "@self/reactive/graph"
local Inspect = require "@self/ownership/inspect"
local InspectReport = require "@self/ownership/report"
local HostProtocol = require "@self/host"
local KeyedCacheModule = require "@self/keyed-cache"
local Keys = require "@self/runtime/keys"
local OwnerModule = require "@self/ownership/owner"
local PoolModule = require "@self/pool"
local Root = require "@self/ownership/root"
local RootScopeModule = require "@self/ownership/root-scope"
local SlotModule = require "@self/slot"
local RuntimeModule = require "@self/runtime"
local StructureFragment = require "@self/structure/fragment"
local StructureIndexes = require "@self/structure/indexes"
local StructureKeyed = require "@self/structure/keyed"
local StructureLayerStack = require "@self/structure/layer-stack"
local StructureLayout = require "@self/collection/layout"
local StructurePortal = require "@self/structure/portal"
local StructurePresence = require "@self/structure/presence"
local StructureOrderedCollection = require "@self/structure/ordered-collection"
local StructureMountBudget = require "@self/structure/mount-budget"
local StructureShow = require "@self/structure/show"
local StructureSpatialCollection = require "@self/structure/spatial-collection"
local StructureTileCollection = require "@self/structure/tile-collection"
local StructureSwitch = require "@self/structure/switch"
local Types = require "@self/reactive/types"
local clock = require "@self/reactive/clock"
local cellModule = require "@self/reactive/cell"
local nodes = require "@self/ownership/nodes"
local profileModule = require "@self/reactive/profile"
local formulaModule = require "@self/reactive/formula"
local reactorModule = require "@self/reactive/reactor"
local stats = require "@self/reactive/stats"
local watchModule = require "@self/reactive/watch"
local userSpace = require "@self/reactive/userSpace"

export type Dispose = Types.Dispose
export type Use = Types.Use
export type Readable<T> = Types.Readable<T>
export type Cell<T> = Types.Cell<T>
export type Formula<T> = Types.Formula<T>
export type Body<T> = Types.Body<T>
export type Source<T> = Types.Source<T>
export type Value<T> = Types.Value<T>
export type Equals<T> = Types.Equals<T>
export type Reactor = reactorModule.Reactor
export type AccumulatorOptions<T, E> = AccumulatorModule.Options<T, E>

export type Owner = OwnerModule.Owner
export type RootScope = RootScopeModule.RootScope
export type Custody = nodes.Custody

export type Node = HostProtocol.Node
export type Host = HostProtocol.Host
export type Renderer = HostProtocol.Renderer
export type Events = HostProtocol.Events
export type Observation = HostProtocol.Observation
export type Frames = HostProtocol.Frames
export type Naming = HostProtocol.Naming
export type KeyKind = HostProtocol.KeyKind
export type Unsubscribe = HostProtocol.Unsubscribe

export type Runtime = RuntimeModule.Runtime
export type Constructor = RuntimeModule.Constructor
export type Component = RuntimeModule.Component
export type Fragment = RuntimeModule.Fragment
export type Child = RuntimeModule.Child
export type Props = RuntimeModule.Props
export type Directive = RuntimeModule.Directive
export type PresenceOptions = StructurePresence.Options
export type Exiting = StructurePresence.Exiting
export type MountPoint = RuntimeModule.MountPoint

export type FocusScope<K> = FocusScope.FocusScope<K>
export type FocusScopeOptions<V, K> = FocusScope.Options<V, K>
export type FocusDirection = FocusScope.Direction
export type FocusRect = FocusNeighbor.FocusRect

export type Pool<T> = PoolModule.Pool<T>
export type PoolLease<T> = PoolModule.Lease<T>
export type PoolOptions<T> = PoolModule.Options<T>

export type KeyedCache<K, T> = KeyedCacheModule.Cache<K, T>
export type KeyedCacheOptions<K, T> = KeyedCacheModule.Options<K, T>

export type Easing = AnimationEasing.Easing
export type Codec<T> = AnimationCodec.Codec<T>
export type SpringState = AnimationSpring.State
export type SpringOptions = RuntimeModule.SpringOptions
export type TweenOptions = RuntimeModule.TweenOptions
export type RampOptions = RuntimeModule.RampOptions
export type Ramp<T> = RuntimeModule.Ramp<T>
export type Scheduler = RuntimeModule.Scheduler
export type Slot = SlotModule.Slot

export type GeometrySize = Geometry.Size
export type GeometryInsets = Geometry.Insets
export type GeometryAnchor = Geometry.Anchor
export type GeometryFrame = Geometry.Frame
export type GeometryBounds = Geometry.Bounds
export type GeometryFitOptions = Geometry.FitOptions
export type GeometryClearOptions<R> = Geometry.ClearOptions<R>

export type SharedResourceFactory<T> = AsyncShared.Factory<T>
export type AcquireSharedResource<T> = AsyncShared.Acquire<T>

export type KeyedRender<V, K> = StructureKeyed.Render<V, K>
export type IndexedRender<V> = StructureIndexes.Render<V>

export type Placement = StructureLayout.Placement
export type OrderedCollectionMode = StructureOrderedCollection.Mode
export type OrderedCollectionDirection = StructureOrderedCollection.Direction
export type OrderedCollectionLayoutKind = StructureOrderedCollection.LayoutKind
export type OrderedCollectionAlign = StructureOrderedCollection.Align
export type OrderedCollectionLayout = StructureOrderedCollection.LayoutOptions
export type OrderedCollectionViewport = StructureOrderedCollection.Viewport
export type OrderedCollectionStatus = StructureOrderedCollection.Status
export type OrderedCollectionControls<K> = StructureOrderedCollection.Controls<K>
export type OrderedCollectionOptions<V, K> = StructureOrderedCollection.Options<V, K>
export type SpatialCollectionTier = StructureSpatialCollection.Tier
export type SpatialCollectionPoint = StructureSpatialCollection.Point
export type Representation = StructureSpatialCollection.Representation
export type SpatialCollectionBudget = StructureSpatialCollection.Budget
export type SpatialCollectionStatus = StructureSpatialCollection.Status
export type SpatialCollectionOptions<V, K> = StructureSpatialCollection.Options<V, K>
export type TileCollectionViewport = StructureTileCollection.Viewport
export type TileCollectionSize = StructureTileCollection.Size
export type TileCollectionPlacement = StructureTileCollection.Placement
export type TileCollectionOptions<V> = StructureTileCollection.Options<V>
export type LayerStackRetention = StructureLayerStack.Retention
export type LayerStackState = StructureLayerStack.State
export type LayerStackOptions<V, K> = StructureLayerStack.Options<V, K>
export type MountBudgetStatus = StructureMountBudget.Status
export type MountBudgetOptions<V, K> = StructureMountBudget.Options<V, K>

export type WorkCounters = stats.Counters
export type Diagnostic = Diagnostics.Parsed
export type ProfileOptions = profileModule.Options
export type ProfileReport = profileModule.Report
export type ProfileNode = profileModule.NodeRow
export type ProfileDrain = profileModule.DrainRow
export type ProfileData = profileModule.Data
export type InspectOptions = Inspect.Options
export type InspectReport = Inspect.Report
export type InspectOwner = Inspect.OwnerReport
export type InspectNode = Inspect.NodeReport
export type InspectOwnedCounts = InspectReport.OwnedCounts
export type InspectData = InspectReport.Data

local function formula<T>(body: Types.Body<T>, equals: Types.Equals<T>?): Types.Formula<T>
	local value = formulaModule(body, equals)
	local owner = Active.current()
	if owner ~= nil then
		local dispose = value.dispose
		local release = owner.own(function()
			dispose(value)
		end)
		value.dispose = function(_self: Types.Formula<T>)
			release()
		end
	end
	return value
end

local function watch(body: (use: Types.Use) -> (), label: string?): Types.Dispose
	local owner = Active.current()
	if owner == nil then
		Diagnostics.raise("owner/no-active-owner", "watch ran with no owner to hold it", {
			contract = "a watch lives exactly as long as the owner that created it",
			fix = "call it inside a component, or use owner.watch(...) with an explicit owner",
		})
	end
	return (owner :: OwnerModule.Owner).watch(body, label)
end

local function cleanup(value: unknown): Types.Dispose
	local teardown: Types.Dispose
	if type(value) == "function" then
		teardown = value :: Types.Dispose
	elseif type(value) == "table" then
		local object = (value :: unknown) :: { destroy: unknown, dispose: unknown }
		if type(object.destroy) == "function" then
			teardown = function()
				(object.destroy :: (unknown) -> ())(object)
			end
		elseif type(object.dispose) == "function" then
			teardown = function()
				(object.dispose :: (unknown) -> ())(object)
			end
		else
			Diagnostics.raise("owner/uncleanable", "cleanup was given a table it cannot tear down", {
				actual = "table with neither destroy nor dispose",
				expected = "a function, or a table with a destroy or dispose method",
			})
		end
	else
		Diagnostics.raise("owner/uncleanable", "cleanup was given something it cannot tear down", {
			actual = Diagnostics.describe(value),
			expected = "a function, or a table with a destroy or dispose method",
		})
	end
	local holder = Active.current()
	if holder ~= nil and Inspect.isActive() then
		Inspect.cleanup(holder)
	end
	return Active.own(teardown, "cleanup")
end

local function sampleRead<T>(node: Types.Readable<T>): T
	if cellModule.isReadable(node) then
		return node:peek()
	end
	return Graph.notANode("the reader Compose.sample passes to a body", node)
end

local function sample<T>(source: Types.Source<T>): T
	if cellModule.isReadable(source) then
		return (source :: Types.Readable<T>):peek()
	end
	if type(source) ~= "function" then
		local actual = Diagnostics.describe(source)
		Diagnostics.raise("reactive/not-a-source", ("Compose.sample was given a %s it cannot read"):format(actual), {
			actual = actual,
			expected = "a cell, a formula, or a function taking `use`",
			contract = "sample reads a source's current value once, without recording a dependency",
			fix = "pass the cell or formula itself, or a body that reads one",
		})
	end
	local body = source :: Types.Body<T>
	return watchModule.sample(function(): T
		return body(sampleRead)
	end)
end

local withOwner = Active.withOwner

local function bindOwner<Args..., Rets...>(body: (Args...) -> Rets...): (Args...) -> Rets...
	if type(body) ~= "function" then
		Diagnostics.raise("owner/bind-body-not-a-function", "bindOwner expects the function to bind", {
			actual = Diagnostics.describe(body),
			expected = "a function to run later under the owner active now",
			contract = "bindOwner exists to carry one callback back into its owner; there is nothing else to bind",
		})
	end
	local owner = Active.current()
	if owner == nil then
		Diagnostics.raise("owner/no-active-owner", "bindOwner has no owner to bind to", {
			contract = "a bound callback re-enters the owner that created it, so there has to be one to capture",
			fix = "call Compose.bindOwner inside the component or mount whose owner the callback belongs to",
		})
	end
	return Active.bind(owner :: OwnerModule.Owner, body)
end

local function resetForTests()
	Active.resetForTests()
	Root.disposeAll()
	nodes.resetForTests()
	clock.reset()
	stats.reset()
end

local inspect = {
	start = Inspect.start,
	stop = Inspect.stop,
	active = Inspect.isActive,
	label = Inspect.label,
	snapshot = InspectReport.snapshot,
	owner = InspectReport.owner,
	owned = InspectReport.owned,
	node = InspectReport.node,
	format = InspectReport.format,
	data = InspectReport.data,
}

local profile = {
	start = profileModule.start,
	stop = profileModule.stop,
	label = profileModule.label,
	active = profileModule.isActive,
	format = profileModule.format,
	data = profileModule.data,
}

return {
	cell = cellModule.cell,
	sharedCell = cellModule.sharedCell,
	formula = formula,
	accumulator = AccumulatorModule,
	watch = watch,
	sample = sample,
	isReadable = cellModule.isReadable,
	reactor = reactorModule.create,

	createOwner = OwnerModule.createOwner,
	withOwner = withOwner,
	bindOwner = bindOwner,
	withRootOwner = RootScopeModule.withRootOwner,
	createRootOwner = RootScopeModule.createRootOwner,
	currentOwner = Active.current,
	cleanup = cleanup,
	custodyOf = nodes.custodyOf,
	labelOf = nodes.labelOf,

	createRuntime = RuntimeModule.createRuntime,
	event = Keys.event,
	group = Keys.group,
	property = Keys.property,
	static = Keys.static,

	presence = StructurePresence,
	show = StructureShow,
	switch = StructureSwitch,
	keyed = StructureKeyed,
	indexes = StructureIndexes,
	OrderedCollection = StructureOrderedCollection,
	SpatialCollection = StructureSpatialCollection,
	TileCollection = StructureTileCollection,
	LayerStack = StructureLayerStack,
	MountBudget = StructureMountBudget,
	fragment = StructureFragment,
	portal = StructurePortal,

	createFocusScope = FocusScope,
	focusNeighbor = FocusNeighbor,
	createPool = PoolModule,
	createKeyedCache = KeyedCacheModule,
	createSlot = SlotModule,
	geometry = Geometry,

	easing = AnimationEasing,
	registerCodec = AnimationCodec.register,
	registeredCodecs = AnimationCodec.registered,
	createSpringState = AnimationSpring.createState,
	stepSpring = AnimationSpring.step,
	springAtRest = AnimationSpring.atRest,
	springCoefficients = AnimationSpring.coefficients,

	createSharedResource = AsyncShared,
	boundary = AsyncBoundary,

	formatDiagnostic = Diagnostics.format,
	parseDiagnostic = Diagnostics.parse,
	setWorkCounters = stats.setEnabled,
	readWorkCounters = stats.read,
	resetWorkCounters = stats.reset,
	setYieldChecking = userSpace.setValidating,
	profile = profile,
	inspect = inspect,
	outstandingMounts = Root.size,

	__resetForTests = resetForTests,
}
]]></string>
              </Properties>
              <Item class="ModuleScript" referent="243">
                <Properties>
                  <string name="Name">accumulator</string>
                  <string name="Source"><![CDATA[--!strict

local Active = require "./ownership/active"
local Diagnostics = require "./diagnostics"
local OwnerModule = require "./ownership/owner"
local Support = require "./structure/support"
local Types = require "./reactive/types"
local cellModule = require "./reactive/cell"
local userSpace = require "./reactive/userSpace"

export type Options<T, E> = {
	from: Types.Readable<E>,
	reduce: (previous: T, event: E) -> T,
	initial: T?,
	equals: Types.Equals<T>?,
}

local KNOWN_FIELDS: { [string]: true } = {
	from = true,
	reduce = true,
	initial = true,
	equals = true,
}

local function accumulator<T, E>(options: Options<T, E>): Types.Readable<T>
	local settings = Support.optionsOf(options, "accumulator", "from = ..., reduce = ..., initial = ...")
	Support.noUnknownFields(settings, "accumulator", KNOWN_FIELDS)

	local owner = Active.current()
	if owner == nil then
		Diagnostics.raise("accumulator/no-active-owner", "accumulator ran with no owner to hold it", {
			contract = "an accumulator subscribes to its source, and the subscription lives exactly "
				.. "as long as the owner that created it",
			fix = "create it inside a component or Compose.withOwner(owner, ...); a process-wide "
				.. "accumulator is one created in a root owner kept for the life of the process",
		})
	end

	local source = settings.from
	if not cellModule.isReadable(source) then
		Diagnostics.raise("accumulator/from-not-readable", "accumulator was given a source it cannot track", {
			actual = Diagnostics.describe(source),
			expected = "a cell or a formula",
			contract = "an accumulator tracks exactly one readable source and reduces each of its "
				.. "changes into its own state",
			fix = "pass the cell or formula that carries the events: from = castFired",
		})
	end

	local reduce = settings.reduce
	if type(reduce) ~= "function" then
		Diagnostics.raise("accumulator/reduce-not-a-function", "accumulator was given a reduce it cannot call", {
			actual = Diagnostics.describe(reduce),
			expected = "a function (previous, event) -> next",
			fix = "pass the reducer that merges one event into the running state",
		})
	end

	local state = cellModule.cell(settings.initial, settings.equals)

	local holder = owner :: OwnerModule.Owner
	holder.watchStatic(source, function(event: E)
		state:set(userSpace.call(reduce, state:peek(), event))
	end)

	return state
end

return accumulator
]]></string>
                </Properties>
              </Item>
              <Item class="Folder" referent="244">
                <Properties>
                  <string name="Name">animation</string>
                </Properties>
                <Item class="ModuleScript" referent="245">
                  <Properties>
                    <string name="Name">codec</string>
                    <string name="Source"><![CDATA[--!strict

local Diagnostics = require "../diagnostics"

export type Codec<T> = {
	arity: number,

	encode: (value: T, out: { number }) -> (),
	decode: (components: { number }) -> T,

	normalise: ((components: { number }) -> ())?,
}

local registry: { [string]: unknown } = {}

local function register<T>(typeName: string, codec: Codec<T>)
	if type(typeName) ~= "string" or typeName == "" then
		Diagnostics.raise("animation/codec-unnamed", "registerCodec expects a type name", {
			actual = Diagnostics.describe(typeName),
			expected = "the string typeof() returns for the values this codec handles",
		})
	end
	if type(codec) ~= "table" or type(codec.arity) ~= "number" or codec.arity < 1 then
		Diagnostics.raise("animation/codec-invalid", ("the codec for %s is not usable"):format(typeName), {
			contract = "a codec needs a positive arity, an encode, and a decode",
		})
	end
	if type(codec.encode) ~= "function" or type(codec.decode) ~= "function" then
		Diagnostics.raise("animation/codec-invalid", ("the codec for %s is not usable"):format(typeName), {
			contract = "a codec needs a positive arity, an encode, and a decode",
		})
	end
	registry[typeName] = codec
end

local function codecFor<T>(typeName: string): Codec<T>
	local codec = registry[typeName]
	if codec == nil then
		Diagnostics.raise("animation/no-codec", ("nothing knows how to animate a %s"):format(typeName), {
			actual = typeName,
			contract = "animating a value requires a registered codec",
			fix = ("call Compose.registerCodec(%q, ...), or animate the numbers inside it"):format(typeName),
		})
	end
	return codec :: Codec<T>
end

local function registered(): { string }
	local names: { string } = {}
	for name in registry do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

register("number", {
	arity = 1,
	encode = function(value: number, out: { number })
		out[1] = value
	end,
	decode = function(components: { number }): number
		return components[1]
	end,
})

return {
	register = register,
	codecFor = codecFor,
	registered = registered,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="246">
                  <Properties>
                    <string name="Name">easing</string>
                    <string name="Source"><![CDATA[--!strict
--!native

export type Easing = (t: number) -> number

local function linear(t: number): number
	return t
end

local function flip(ease: Easing): Easing
	return function(t: number): number
		return 1 - ease(1 - t)
	end
end

local function mirror(ease: Easing): Easing
	return function(t: number): number
		if t < 0.5 then
			return ease(t * 2) / 2
		end
		return 1 - ease((1 - t) * 2) / 2
	end
end

local function power(exponent: number): Easing
	return function(t: number): number
		return t ^ exponent
	end
end

local function inSine(t: number): number
	return 1 - math.cos((t * math.pi) / 2)
end

local function inExpo(t: number): number
	if t <= 0 then
		return 0
	end
	return 2 ^ (10 * (t - 1))
end

local function inCirc(t: number): number
	return 1 - math.sqrt(math.max(0, 1 - t * t))
end

local function inBack(t: number): number
	local overshoot = 1.70158
	return t * t * ((overshoot + 1) * t - overshoot)
end

local function inElastic(t: number): number
	if t <= 0 then
		return 0
	end
	if t >= 1 then
		return 1
	end
	return -(2 ^ (10 * (t - 1))) * math.sin(((t - 1) * 10 - 0.75) * ((2 * math.pi) / 3))
end

local function outBounce(t: number): number
	local n, d = 7.5625, 2.75
	if t < 1 / d then
		return n * t * t
	elseif t < 2 / d then
		local shifted = t - 1.5 / d
		return n * shifted * shifted + 0.75
	elseif t < 2.5 / d then
		local shifted = t - 2.25 / d
		return n * shifted * shifted + 0.9375
	end
	local shifted = t - 2.625 / d
	return n * shifted * shifted + 0.984375
end

local inQuad, inCubic, inQuart, inQuint = power(2), power(3), power(4), power(5)
local inBounce = flip(outBounce)

local easing = table.freeze {
	linear = linear,

	inQuad = inQuad,
	outQuad = flip(inQuad),
	inOutQuad = mirror(inQuad),

	inCubic = inCubic,
	outCubic = flip(inCubic),
	inOutCubic = mirror(inCubic),

	inQuart = inQuart,
	outQuart = flip(inQuart),
	inOutQuart = mirror(inQuart),

	inQuint = inQuint,
	outQuint = flip(inQuint),
	inOutQuint = mirror(inQuint),

	inSine = inSine,
	outSine = flip(inSine),
	inOutSine = mirror(inSine),

	inExpo = inExpo,
	outExpo = flip(inExpo),
	inOutExpo = mirror(inExpo),

	inCirc = inCirc,
	outCirc = flip(inCirc),
	inOutCirc = mirror(inCirc),

	inBack = inBack,
	outBack = flip(inBack),
	inOutBack = mirror(inBack),

	inElastic = inElastic,
	outElastic = flip(inElastic),
	inOutElastic = mirror(inElastic),

	inBounce = inBounce,
	outBounce = outBounce,
	inOutBounce = mirror(inBounce),
}

return easing
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="247">
                  <Properties>
                    <string name="Name">motion</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local Codec = require "./codec"
local Diagnostics = require "../diagnostics"
local Easing = require "./easing"
local Host = require "../host"
local Owner = require "../ownership/owner"
local Reactor = require "../reactive/reactor"
local Spring = require "./spring"
local Types = require "../reactive/types"
local cellModule = require "../reactive/cell"
local watchModule = require "../reactive/watch"

export type ReducedMotion = Types.Cell<boolean> | Types.Formula<boolean> | Types.Source<boolean>

export type SpringOptions = {
	period: number?,
	damping: number?,
	tolerance: number?,
	reducedMotion: ReducedMotion?,
}

export type Duration = Types.Value<number>

export type TweenOptions = {
	seconds: Duration?,
	ease: Easing.Easing?,
	reducedMotion: ReducedMotion?,
}

export type Motion = {
	spring: <T>(source: Types.Body<T>, options: SpringOptions?) -> Types.Readable<T>,
	tween: <T>(source: Types.Body<T>, options: TweenOptions?) -> Types.Readable<T>,
}

local DEFAULT_PERIOD = 0.5
local DEFAULT_DAMPING = 1
local DEFAULT_TOLERANCE = 1e-4
local DEFAULT_SECONDS = 0.25

local function framesOf(host: Host.Host, primitive: string): Host.Frames
	local frames = host.frames
	if frames == nil then
		Diagnostics.raise("animation/no-frames", ("host %q cannot drive %s"):format(host.name, primitive), {
			contract = "animation needs a frame loop, which is the host frames capability",
			fix = "implement host.frames.onFrame and host.frames.now, or animate outside Compose",
		})
	end
	return frames :: Host.Frames
end

local function policyOf(value: ReducedMotion?, primitive: string): Types.Body<boolean>?
	if value == nil then
		return nil
	end
	if type(value) == "function" then
		return value :: Types.Body<boolean>
	end
	if cellModule.isReadable(value) then
		local readable = value :: Types.Readable<boolean>
		return function(use: Types.Use): boolean
			return use(readable)
		end
	end
	Diagnostics.raise("animation/bad-reduced-motion", ("%s cannot read this reduced motion policy"):format(primitive), {
		key = "reducedMotion",
		actual = Diagnostics.describe(value),
		expected = "a cell, a formula or a body returning a boolean",
		contract = "the policy is read reactively, because the setting changes while the application runs",
	})
	return nil
end

type HubMember = {
	active: boolean,
	callback: (delta: number) -> (),
}

local function createMotion(
	host: Host.Host,
	ownerOf: (primitive: string) -> Owner.Owner,
	reactor: Reactor.Reactor
): Motion
	local hubMembers: { HubMember } = {}
	local hubLive = 0
	local hubUnsubscribe: Host.Unsubscribe? = nil
	local hubDispatching = false
	local hubDelta = 0

	local function runMembers(): ...unknown
		local count = #hubMembers
		for index = 1, count do
			local member = hubMembers[index]
			if member.active then
				member.callback(hubDelta)
			end
		end
	end

	local function hubCompact()
		if hubLive == #hubMembers then
			return
		end
		local write = 0
		for read = 1, #hubMembers do
			local member = hubMembers[read]
			if member.active then
				write += 1
				hubMembers[write] = member
			end
		end
		for index = #hubMembers, write + 1, -1 do
			hubMembers[index] = nil
		end
	end

	local function hubStop()
		if hubLive > 0 then
			return
		end
		local active = hubUnsubscribe
		if active ~= nil then
			hubUnsubscribe = nil
			active()
		end
	end

	local function hubStep(delta: number)
		hubDelta = delta
		hubDispatching = true
		local ok, err: unknown = pcall(reactor.batch, reactor, runMembers)
		hubDispatching = false
		hubCompact()
		hubStop()
		if not ok then
			error(err, 0)
		end
	end

	local function hubAdd(frames: Host.Frames, callback: (delta: number) -> ()): HubMember
		local member: HubMember = { active = true, callback = callback }
		table.insert(hubMembers, member)
		hubLive += 1
		if hubUnsubscribe == nil then
			hubUnsubscribe = frames.onFrame(hubStep)
		end
		return member
	end

	local function hubRemove(member: HubMember)
		if not member.active then
			return
		end
		member.active = false
		hubLive -= 1
		if not hubDispatching then
			hubCompact()
			hubStop()
		end
	end
	local function animate<T>(
		primitive: string,
		source: Types.Body<T>,
		makeAdvance: (
			codec: Codec.Codec<T>,
			current: { number },
			target: { number },
			reference: { number }
		) -> ((delta: number) -> boolean, (() -> ())?),
		onRetarget: (() -> ())?,
		reducedMotion: Types.Body<boolean>?
	): Types.Readable<T>
		local frames = framesOf(host, primitive)
		local owner = ownerOf(primitive)

		local codec: Codec.Codec<T>
		local arity = 0
		local current: { number }
		local target: { number }
		local reference: { number }
		local advance: (delta: number) -> boolean
		local settleNow: (() -> ())?
		local output: Types.Cell<T>
		local typeName = ""

		local hubMember: HubMember? = nil
		local disposed = false

		local function publish()
			local normalise = codec.normalise
			if normalise ~= nil then
				normalise(current)
			end
			output:set(codec.decode(current))
		end

		local function stop()
			local active = hubMember
			if active ~= nil then
				hubMember = nil
				hubRemove(active)
			end
		end

		local function onFrame(delta: number)
			if disposed then
				return
			end
			local arrived = advance(delta)
			publish()
			if arrived then
				stop()
			end
		end

		local function start()
			if disposed or hubMember ~= nil then
				return
			end
			hubMember = hubAdd(frames, onFrame)
		end

		owner.own(function()
			disposed = true
			stop()
		end)

		owner.watch(function(use)
			local wanted = source(use)
			local reduced = reducedMotion ~= nil and reducedMotion(use) == true

			if arity == 0 then
				typeName = Host.typeNameOf(host, wanted)
				codec = Codec.codecFor(typeName)
				arity = codec.arity
				current = table.create(arity, 0)
				target = table.create(arity, 0)
				reference = table.create(arity, 0)
				codec.encode(wanted, current)
				codec.encode(wanted, target)
				codec.encode(wanted, reference)
				output = cellModule.cell(wanted)
				advance, settleNow = makeAdvance(codec, current, target, reference)

				return
			end

			if Host.typeNameOf(host, wanted) ~= typeName then
				Diagnostics.raise(
					"animation/type-changed",
					("%s was given a different type mid-flight"):format(primitive),
					{
						expected = typeName,
						actual = Host.typeNameOf(host, wanted),
						contract = "an animated value keeps one type for its lifetime",
						fix = "use show or switch to swap between differently-typed values",
					}
				)
			end

			for index = 1, arity do
				reference[index] = current[index]
			end
			codec.encode(wanted, target)
			if reduced then
				stop()
				if settleNow ~= nil then
					settleNow()
				end
				for index = 1, arity do
					current[index] = target[index]
					reference[index] = target[index]
				end
				publish()
				return
			end
			if onRetarget ~= nil then
				onRetarget()
			end
			start()
		end)

		return output
	end

	local function spring<T>(source: Types.Body<T>, options: SpringOptions?): Types.Readable<T>
		local period = if options ~= nil and options.period ~= nil then options.period else DEFAULT_PERIOD
		local damping = if options ~= nil and options.damping ~= nil then options.damping else DEFAULT_DAMPING
		local tolerance = if options ~= nil and options.tolerance ~= nil then options.tolerance else DEFAULT_TOLERANCE

		if period <= 0 then
			Diagnostics.raise("animation/bad-period", "a spring needs a positive period", {
				actual = tostring(period),
				expected = "seconds for one undamped oscillation, e.g. 0.4",
			})
		end

		return animate("spring", source, function(codec, current, target, reference)
			local live = Spring.createState(current, codec.arity)
			local function settle()
				Spring.settle(live, target)
			end
			return function(delta: number): boolean
				Spring.step(live, target, delta, period, damping)
				for index = 1, codec.arity do
					current[index] = live.position[index]
				end
				if Spring.atRest(live, target, reference, tolerance) then
					Spring.settle(live, target)
					for index = 1, codec.arity do
						current[index] = target[index]
					end
					return true
				end
				return false
			end,
				settle
		end, nil, policyOf(if options ~= nil then options.reducedMotion else nil, "spring"))
	end

	local function tween<T>(source: Types.Body<T>, options: TweenOptions?): Types.Readable<T>
		local wanted: Duration = if options ~= nil and options.seconds ~= nil then options.seconds else DEFAULT_SECONDS
		local ease: Easing.Easing
		if options ~= nil and options.ease ~= nil then
			ease = options.ease
		else
			ease = Easing.linear
		end

		local durations: (() -> number)? = nil
		local seconds = DEFAULT_SECONDS
		if type(wanted) == "number" then
			seconds = wanted
			if seconds <= 0 then
				Diagnostics.raise("animation/bad-duration", "a tween needs a positive duration", {
					actual = tostring(seconds),
					expected = "seconds, e.g. 0.25",
				})
			end
		elseif cellModule.isReadable(wanted) then
			local readable = wanted :: Types.Readable<number>
			durations = function(): number
				return readable:peek()
			end
		elseif type(wanted) == "function" then
			local body = wanted :: Types.Body<number>
			durations = function(): number
				return watchModule.sample(function()
					return ((body :: unknown) :: (nil) -> number)(nil)
				end)
			end
		else
			Diagnostics.raise("animation/bad-duration", "a tween duration must be seconds or a source of seconds", {
				actual = type(wanted),
				expected = "a number, a cell, a formula, or a body, e.g. 0.25",
				contract = "TweenOptions.seconds is a number or a source of one",
			})
		end

		local elapsed = 0
		local onRetarget: () -> ()
		if durations == nil then
			onRetarget = function()
				elapsed = 0
			end
		else
			local sampleSeconds = durations :: () -> number
			onRetarget = function()
				local length = sampleSeconds()
				if type(length) ~= "number" or length <= 0 then
					Diagnostics.raise("animation/bad-duration", "a tween's duration source produced a bad length", {
						actual = tostring(length),
						expected = "positive seconds, e.g. 0.25",
						contract = "a duration source yields positive seconds at every retarget",
					})
				end
				seconds = length
				elapsed = 0
			end
		end

		return animate("tween", source, function(codec, current, target, reference)
			return function(delta: number): boolean
				elapsed = math.min(elapsed + delta, seconds)
				local t = ease(elapsed / seconds)
				for index = 1, codec.arity do
					current[index] = reference[index] + (target[index] - reference[index]) * t
				end
				if elapsed >= seconds then
					for index = 1, codec.arity do
						current[index] = target[index]
					end
					return true
				end
				return false
			end,
				nil
		end, onRetarget, policyOf(if options ~= nil then options.reducedMotion else nil, "tween"))
	end

	return {
		spring = spring,
		tween = tween,
	}
end

return {
	createMotion = createMotion,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="248">
                  <Properties>
                    <string name="Name">ramp</string>
                    <string name="Source"><![CDATA[--!strict

local Diagnostics = require "../diagnostics"
local Easing = require "./easing"
local Motion = require "./motion"
local Owner = require "../ownership/owner"
local Types = require "../reactive/types"
local cellModule = require "../reactive/cell"

export type Options = {
	ease: Easing.Easing?,
}

export type Ramp<T> = {
	value: Types.Readable<T>,
	retarget: (target: T, seconds: number) -> (),
}

local DEFAULT_SECONDS = 0.25

local function createRamps(
	tween: <T>(source: Types.Body<T>, options: Motion.TweenOptions?) -> Types.Readable<T>,
	requireOwner: (operation: string) -> Owner.Owner
): <T>(initial: T, options: Options?) -> Ramp<T>
	return function<T>(initial: T, options: Options?): Ramp<T>
		local owner = requireOwner "ramp"
		local target = cellModule.cell(initial)
		local seconds = cellModule.cell(DEFAULT_SECONDS)
		local instant = cellModule.cell(false)
		local value = tween(function(use: Types.Use): T
			return use(target)
		end, {
			seconds = seconds,
			ease = if options ~= nil then options.ease else nil,
			reducedMotion = instant,
		})
		return {
			value = value,
			retarget = function(next: T, duration: number)
				if type(duration) ~= "number" or duration ~= duration or duration == math.huge then
					Diagnostics.raise("ramp/invalid-seconds", "a ramp needs a finite duration", {
						actual = Diagnostics.describe(duration),
						expected = "seconds; zero or less jumps to the target at once",
					})
				end
				owner.reactor:batch(function()
					if duration > 0 then
						seconds:set(duration)
					end
					instant:set(duration <= 0)
					target:set(next)
				end)
			end,
		}
	end
end

return {
	createRamps = createRamps,
}
]]></string>
                  </Properties>
