	ZIndex: typeof(frame.ZIndex),
	Style: typeof(frame.Style),
	ref: typeof(frame.ref),
	destination: typeof(travel.destination),
	content: typeof(travel.content),
	path: typeof(travel.path),
	motion: typeof(travel.motion),
	transparency: typeof(travel.transparency),
	stagger: typeof(travel.stagger),
	lift: typeof(travel.lift),
