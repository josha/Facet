          <Item class="ModuleScript" referent="201">
            <Properties>
              <string name="Name">reservations</string>
              <string name="Source"><![CDATA[--!strict
local reservations = {}

export type Edge = "top" | "bottom"
type Entry = { edge: Edge, y: number, h: number }

local layers = setmetatable({} :: { [Instance]: { [unknown]: Entry } }, { __mode = "k" })

local function publish(layer: Instance)
	local entries: { [unknown]: Entry } = layers[layer] or {}
	local height = if layer:IsA("GuiBase2d") then (layer :: GuiBase2d).AbsoluteSize.Y else 0
	local top, bottom = 0, 0
	for _, entry in entries do
		if entry.edge == "top" then
			top = math.max(top, entry.y + entry.h)
		else
			bottom = math.max(bottom, height - entry.y)
		end
	end
	layer:SetAttribute("FacetInsetTop", top)
	layer:SetAttribute("FacetInsetBottom", bottom)
end

function reservations.set(layer: Instance, token: unknown, edge: Edge, y: number?, h: number?)
	local entries = layers[layer]
	if entries == nil then
		entries = {}
		layers[layer] = entries
	end
	local list = assert(entries)
	if y == nil or h == nil or h <= 0 then
		list[token] = nil
	else
		list[token] = { edge = edge, y = y, h = h }
	end
	publish(layer)
end

function reservations.reserved(layer: GuiBase2d, edge: Edge, skip: { [unknown]: boolean }?): number
	local parent = layer.Parent
	local candidates: { Instance } = if parent then parent:GetChildren() else { layer }
	local top, bottom = layer.AbsolutePosition.Y, layer.AbsolutePosition.Y + layer.AbsoluteSize.Y
	local reserved = 0
	for _, candidate in candidates do
		local entries = layers[candidate]
		local shown = candidate == layer or not candidate:IsA("LayerCollector") or (candidate :: LayerCollector).Enabled
		if entries and shown and candidate:IsA("GuiBase2d") then
			local origin = (candidate :: GuiBase2d).AbsolutePosition.Y
			for token, entry in entries do
				if entry.edge == edge and not (skip and skip[token]) then
					reserved = math.max(
						reserved,
						if edge == "top" then origin + entry.y + entry.h - top else bottom - origin - entry.y
					)
				end
			end
		end
	end
	return reserved
end

function reservations.clear(layer: Instance, token: unknown)
	local entries = layers[layer]
	if entries and entries[token] then
		entries[token] = nil
		publish(layer)
	end
end

return reservations
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="202">
            <Properties>
              <string name="Name">reserved_keys</string>
              <string name="Source"><![CDATA[--!strict
local Shared = require("./types")

type Handler = Shared.ReservedKeyHandler
type Dispatcher = {
	handlers: { Handler },
	order: { [Handler]: number },
	count: number,
	began: RBXScriptConnection?,
	ending: { [string]: RBXScriptConnection },
	keyCodes: { [string]: Enum.KeyCode },
}

local KEYS = table.freeze({ Tab = true, Escape = true })
local MODIFIERS = table.freeze({
	"LeftControl",
	"RightControl",
	"LeftAlt",
	"RightAlt",
	"LeftMeta",
	"RightMeta",
	"LeftSuper",
	"RightSuper",
})

local dispatchers = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [UserInputService]: Dispatcher }

local function holds(handler: Handler, selected: Instance?): boolean
	local node = handler.node
	return node ~= nil and selected ~= nil and (selected == node or selected:IsDescendantOf(node))
end

local function dispatch(input: UserInputService, dispatcher: Dispatcher, event: InputObject): ()
	local name = if event.KeyCode then event.KeyCode.Name else nil
	if name == nil or not KEYS[name] then
		return
	end
	local probe = (input :: unknown) :: {
		GetFocusedTextBox: ((UserInputService) -> TextBox?)?,
		IsKeyDown: ((UserInputService, Enum.KeyCode) -> boolean)?,
	}
	if not dispatcher.ending[name] then
		local code = event.KeyCode
		local connection: RBXScriptConnection
		connection = input.InputEnded:Connect(function(ended: InputObject)
			if ended.KeyCode == code then
				connection:Disconnect()
				dispatcher.ending[name] = nil
				for _, handler in table.clone(dispatcher.handlers) do
					if handler.keys[name] then
						handler.release()
					end
				end
			end
		end)
		dispatcher.ending[name] = connection
	end
	if probe.IsKeyDown then
		for _, modifier in MODIFIERS do
			local key = dispatcher.keyCodes[modifier]
			if key and input:IsKeyDown(key) then
				return
			end
		end
	end
	local box = if probe.GetFocusedTextBox then input:GetFocusedTextBox() else nil
	local ordered = table.clone(dispatcher.handlers)
	local selected: { [Handler]: boolean } = {}
	for _, handler in ordered do
		local gui = handler.gui
		selected[handler] = holds(handler, if gui then gui.SelectedObject else nil)
	end
	table.sort(ordered, function(a: Handler, b: Handler): boolean
		if a.priority ~= b.priority then
			return a.priority > b.priority
		end
		if selected[a] ~= selected[b] then
			return selected[a]
		end
		return dispatcher.order[a] > dispatcher.order[b]
	end)
	for _, handler in ordered do
		local gui = handler.gui
		local menuOpen = name == "Escape" and gui ~= nil and gui.MenuIsOpen == true
		local typing = box ~= nil and not (handler.editing ~= nil and handler.editing(box))
		if handler.keys[name] and not menuOpen and not typing and handler.enabled() then
			handler.press()
			if handler.sink then
				return
			end
		end
	end
end

local function add(input: UserInputService, keyCodes: { [string]: Enum.KeyCode }, handler: Handler): () -> ()
	local dispatcher = dispatchers[input]
	if dispatcher == nil then
		local created: Dispatcher =
			{ handlers = {}, order = {}, count = 0, began = nil, ending = {}, keyCodes = keyCodes }
		dispatcher = created
		dispatchers[input] = created
	end
	local current = dispatcher :: Dispatcher
	current.count += 1
	current.order[handler] = current.count
	table.insert(current.handlers, handler)
	if current.began == nil then
		current.began = input.InputBegan:Connect(function(event: InputObject)
			dispatch(input, current, event)
		end)
	end
	return function()
		local index = table.find(current.handlers, handler)
		if index then
			table.remove(current.handlers, index)
		end
		current.order[handler] = nil
		if #current.handlers == 0 then
			if current.began then
				current.began:Disconnect()
				current.began = nil
			end
			for _, connection in current.ending do
				connection:Disconnect()
			end
			table.clear(current.ending)
		end
	end
end

return table.freeze({ KEYS = KEYS, add = add })
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="203">
            <Properties>
              <string name="Name">rest</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")

return function(
	ctx: Types.Context,
	sample: () -> (string, boolean, boolean?),
	restart: ((ComposeTypes.Use) -> string)?,
	stableOnly: boolean?
): ComposeTypes.Readable<boolean>
	local Compose = ctx.Compose
	local frames: { onFrame: ((number) -> ()) -> () -> () }? = ctx.runtime.host.frames
	local render = ctx.config.services.RunService and ctx.config.services.RunService.PreRender
	if render then
		frames = {
			onFrame = function(callback: (number) -> ()): () -> ()
				local connection = render:Connect(callback)
				return function()
					connection:Disconnect()
				end
			end,
		}
	end
	local limit = ctx.metric("motion.restLimit")
	local rested = Compose.cell(false)
	local stop: (() -> ())? = nil
	local function halt()
		local current = stop
		stop = nil
		if current then
			current()
		end
	end
	local function track()
		halt()
		if frames == nil then
			rested:set(true)
			return
		end
		rested:set(false)
		local last: string? = nil
		local waited = 0
		local mine: (() -> ())? = nil
		mine = frames.onFrame(function(delta: number)
			if stop ~= mine then
				return
			end
			local now, filled, allowed = sample()
			waited = if allowed ~= false then waited + delta else 0
			if allowed ~= false and ((filled and now == last) or (not stableOnly and waited > limit)) then
				halt()
				rested:set(true)
			end
			last = if allowed ~= false then now else nil
		end)
		stop = mine
	end
	if restart then
		local seen: string? = nil
		Compose.watch(function(use: ComposeTypes.Use)
			local key = restart(use)
			if key ~= seen then
				seen = key
				track()
			end
		end)
	else
		track()
	end
	Compose.cleanup(halt)
	return rested
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="204">
            <Properties>
              <string name="Name">rich_text</string>
              <string name="Source"><![CDATA[--!strict
local richText = {}

local ENTITIES: { [string]: string } = {
	["&"] = "&amp;",
	["<"] = "&lt;",
	[">"] = "&gt;",
	['"'] = "&quot;",
	["'"] = "&apos;",
}

function richText.escape(words: string): string
	assert(type(words) == "string", "Facet richText.escape takes a string")
	return (string.gsub(words, "[&<>\"']", ENTITIES))
end

return table.freeze(richText)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="205">
            <Properties>
              <string name="Name">scroll_chain</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local gestureOf = require("./gesture_service")

type Gesture = {
	origin: ScrollingFrame,
	start: Vector3,
	previous: Vector3,
	held: { [ScrollingFrame]: () -> () },
	connections: { RBXScriptConnection },
}
local gestures: { [InputObject]: Gesture } = {}
type Listener = {
	frames: { [ScrollingFrame]: (InputObject) -> () },
	connection: RBXScriptConnection?,
}
local listeners: { [UserInputService]: Listener } = {}

local function listen(
	service: UserInputService,
	frame: ScrollingFrame,
	begin: (InputObject) -> (),
	touchType: Enum.UserInputType
): () -> ()
	local listener = listeners[service]
	if not listener then
		local created: Listener = { frames = {}, connection = nil }
		listeners[service] = created
		listener = created
		created.connection = service.InputBegan:Connect(function(input: InputObject)
			if input.UserInputType ~= touchType then
				return
			end
			local checked: { [Instance]: boolean } = {}
			for candidate in created.frames do
				local host = candidate:FindFirstAncestorWhichIsA("BasePlayerGui")
				if host and not checked[host] then
					checked[host] = true
					local hits = (host :: PlayerGui):GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)
					for _, hit in hits do
						local node: Instance? = hit
						while node do
							if node:IsA("ScrollingFrame") then
								local start = created.frames[node]
								if start then
									start(input)
								end
								return
							end
							node = node.Parent
						end
						if hit.Active or hit:IsA("GuiButton") or hit:IsA("TextBox") then
							return
						end
					end
				end
			end
		end)
	end
	local current = assert(listener)
	current.frames[frame] = begin
	return function()
		current.frames[frame] = nil
		if next(current.frames) == nil then
			if current.connection then
				current.connection:Disconnect()
			end
			listeners[service] = nil
		end
	end
end

local function finish(input: InputObject)
	local gesture = gestures[input]
	if not gesture then
		return
	end
	gestures[input] = nil
	for _, connection in gesture.connections do
		connection:Disconnect()
	end
	for _, release in gesture.held do
		release()
	end
end

return function(
	ctx: Types.Context,
	frame: ScrollingFrame,
	isOwned: (ScrollingFrame) -> boolean,
	hold: (ScrollingFrame) -> () -> ()
)
	local service = ctx.config.userInputService
	if not service then
		return
	end
	local E = ctx.types.Enum
	local arbiter = gestureOf(ctx)
	local function begin(input: InputObject)
		if input.UserInputType ~= E.UserInputType.Touch or not frame.ScrollingEnabled then
			return
		end
		local current = gestures[input]
		if current then
			if frame:IsDescendantOf(current.origin) then
				current.origin = frame
			end
			return
		end
		local gesture: Gesture = {
			origin = frame,
			start = input.Position,
			previous = input.Position,
			held = {},
			connections = {},
		}
		gestures[input] = gesture
		table.insert(
			gesture.connections,
			service.InputChanged:Connect(function(changed: InputObject)
				if changed ~= input then
					return
				end
				if input.UserInputState == E.UserInputState.Cancel then
					finish(input)
					return
				end
				local kind = arbiter.move(input, ctx.types.Vector2.new(input.Position.X, input.Position.Y))
				if kind == "drag" or kind == "cancelled" then
					return
				end
				local travel, delta = input.Position - gesture.start, gesture.previous - input.Position
				gesture.previous = input.Position
				local horizontal = math.abs(travel.X) > math.abs(travel.Y)
				if math.max(math.abs(travel.X), math.abs(travel.Y)) < 6 then
					return
				end
				local direction = if horizontal then delta.X else delta.Y
				if direction == 0 then
					return
				end
				local pending: { ScrollingFrame } = {}
				local node: Instance? = gesture.origin
				while node do
					if node:IsA("ScrollingFrame") and not gesture.held[node] then
						if not node.ScrollingEnabled then
							return
						end
						local axis = node.ScrollingDirection
						local allowed = axis == E.ScrollingDirection.XY
							or axis == (if horizontal then E.ScrollingDirection.X else E.ScrollingDirection.Y)
						local position = if horizontal then node.CanvasPosition.X else node.CanvasPosition.Y
						local extent = node.AbsoluteCanvasSize - node.AbsoluteWindowSize
						local limit = math.max(0, if horizontal then extent.X else extent.Y)
						local movable = allowed
							and limit > 0
							and (if direction < 0 then position > 0.5 else position < limit - 0.5)
						if movable then
							for _, exhausted in pending do
								gesture.held[exhausted] = hold(exhausted)
							end
							return
						end
						if not isOwned(node) then
							return
						end
						table.insert(pending, node)
					end
					node = node.Parent
				end
			end)
		)
		table.insert(
			gesture.connections,
			service.InputEnded:Connect(function(ended: InputObject)
				if ended == input then
					finish(input)
				end
			end)
		)
		table.insert(
			gesture.connections,
			service.WindowFocusReleased:Connect(function()
				finish(input)
			end)
		)
	end
	local stop = listen(service, frame, begin, E.UserInputType.Touch)
	ctx.runtime.connect(frame, "InputBegan", begin)
	ctx.Compose.cleanup(function()
		stop()
		for input, gesture in gestures do
			if gesture.origin == frame or gesture.held[frame] then
				finish(input)
			end
		end
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="206">
            <Properties>
              <string name="Name">scroll_initial</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")

return function(ctx: Types.Context, frame: ScrollingFrame, source: Types.Value<Vector2>?)
	if source == nil then
		return
	end
	local pending: Vector2? = ctx.read(source)
	local canvas = ctx.observe.AbsoluteCanvasSize(frame)
	local window = ctx.observe.AbsoluteWindowSize(frame)
	local function cancel(input: InputObject)
		local kind = input.UserInputType
		local E = ctx.types.Enum
		if
			kind == E.UserInputType.Touch
			or kind == E.UserInputType.MouseButton1
			or kind == E.UserInputType.MouseWheel
		then
			pending = nil
		end
	end
	ctx.runtime.connect(frame, "InputBegan", cancel)
	ctx.runtime.connect(frame, "InputChanged", cancel)
	ctx.Compose.watch(function(use)
		local extent, view = use(canvas), use(window)
		local goal = pending
		if goal == nil or view.X <= 0 or view.Y <= 0 then
			return
		end
		if (goal.X ~= 0 and extent.X <= view.X) or (goal.Y ~= 0 and extent.Y <= view.Y) then
			return
		end
		frame.CanvasPosition = goal
		if frame.CanvasPosition == goal then
			pending = nil
		end
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="207">
            <Properties>
              <string name="Name">scroll_lock</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local chain = require("./scroll_chain")
local scrollLock = {}

type Layer = {
	stack: { Instance },
	held: { [ScrollingFrame]: boolean },
	connections: { RBXScriptConnection },
}

type Hold = { count: number, saved: boolean, watch: RBXScriptConnection }

local layers = setmetatable({} :: { [Instance]: Layer }, { __mode = "k" })
local holds = setmetatable({} :: { [ScrollingFrame]: Hold }, { __mode = "k" })
local owned = setmetatable({} :: { [ScrollingFrame]: boolean }, { __mode = "k" })

local function take(frame: ScrollingFrame)
	local current = holds[frame]
	if current then
		current.count += 1
		return
	end
	local created: Hold = {
		count = 1,
		saved = frame.ScrollingEnabled,
		watch = frame:GetPropertyChangedSignal("ScrollingEnabled"):Connect(function()
			local held = holds[frame]
			if held and frame.ScrollingEnabled then
				held.saved = true
				frame.ScrollingEnabled = false
			end
		end),
	}
	holds[frame] = created
	frame.ScrollingEnabled = false
end

local function give(frame: ScrollingFrame)
	local current = holds[frame]
	if current == nil then
		return
	end
	current.count -= 1
	if current.count == 0 then
		holds[frame] = nil
		current.watch:Disconnect()
		frame.ScrollingEnabled = current.saved
	end
end

local function within(node: Instance?, ancestor: Instance): boolean
	return node ~= nil and (node == ancestor or node:IsDescendantOf(ancestor))
end

local function exempt(state: Layer, node: Instance): boolean
	local count = #state.stack
	return count == 0 or within(node, state.stack[count])
end

local function hold(state: Layer, frame: ScrollingFrame)
	if state.held[frame] then
		return
	end
	state.held[frame] = true
	take(frame)
end

local function free(state: Layer, frame: ScrollingFrame)
	if not state.held[frame] then
		return
	end
	state.held[frame] = nil
	give(frame)
end

local function refresh(layer: Instance, state: Layer)
	local held: { ScrollingFrame } = {}
	for frame in state.held do
		table.insert(held, frame)
	end
	for _, frame in held do
		if exempt(state, frame) or not within(frame, layer) then
			free(state, frame)
		end
	end
	if #state.stack == 0 then
		for _, connection in state.connections do
			connection:Disconnect()
		end
		table.clear(state.connections)
		if next(state.held) == nil then
			layers[layer] = nil
		end
		return
	end
	for _, node in layer:GetDescendants() do
		if node:IsA("ScrollingFrame") and not exempt(state, node) then
			hold(state, node)
		end
	end
	if #state.connections == 0 then
		table.insert(
			state.connections,
			layer.DescendantAdded:Connect(function(node: Instance)
				if node:IsA("ScrollingFrame") and #state.stack > 0 and not exempt(state, node) then
					hold(state, node)
				end
			end)
		)
		table.insert(
			state.connections,
			layer.DescendantRemoving:Connect(function(node: Instance)
				if node:IsA("ScrollingFrame") then
					free(state, node)
				end
			end)
		)
	end
end

function scrollLock.acquire(layer: Instance, root: Instance)
	local state = layers[layer]
	if state == nil then
		local created: Layer = { stack = {}, held = {}, connections = {} }
		layers[layer] = created
		state = created
	end
	local current = assert(state)
	if table.find(current.stack, root) then
		return
	end
	table.insert(current.stack, root)
	refresh(layer, current)
end

function scrollLock.release(layer: Instance, root: Instance)
	local state = layers[layer]
	if state == nil then
		return
	end
	local index = table.find(state.stack, root)
	if index == nil then
		return
	end
	table.remove(state.stack, index)
	refresh(layer, state)
end

function scrollLock.own(frame: ScrollingFrame, ctx: Types.Context?)
	owned[frame] = true
	if ctx then
		chain(ctx, frame, function(candidate: ScrollingFrame): boolean
			return owned[candidate] == true
		end, function(exhausted: ScrollingFrame): () -> ()
			take(exhausted)
			return function()
				give(exhausted)
			end
		end)
	end
end

local function holdAncestors(node: Instance, ownedOnly: boolean): () -> ()
	local held: { ScrollingFrame } = {}
	local at = node.Parent
	while at do
		if at:IsA("ScrollingFrame") and (not ownedOnly or owned[at]) then
			take(at)
			table.insert(held, at)
		end
		at = at.Parent
	end
	return function()
		for _, frame in held do
			give(frame)
		end
		table.clear(held)
	end
end

function scrollLock.holdOwnedAncestors(node: Instance): () -> ()
	return holdAncestors(node, true)
end

function scrollLock.holdAncestors(node: Instance): () -> ()
	return holdAncestors(node, false)
end

return scrollLock
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="208">
            <Properties>
              <string name="Name">scrolling</string>
              <string name="Source"><![CDATA[--!strict
local Shared = require("./types")
local Env = require("./environment_types")
local motion = require("./motion")

type Playback = { Play: (Playback) -> (), Cancel: (Playback) -> () }
type Tweens = { Create: (Tweens, Instance, TweenInfo, { [string]: unknown }) -> Playback }

return function(ctx: Shared.Context, UI: Env.EnvironmentControls)
	local config = ctx.config
	local types = ctx.types
	local V2 = types.Vector2
	local E = types.Enum
	local running: { [Instance]: Playback } = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [Instance]: Playback }

	local function reduced(): boolean
		local gui = config.guiService
		local ok, value = pcall(function()
			return gui ~= nil and gui.ReducedMotionEnabled
		end)
		return motion.resolve(ctx.read(config.motionLevel), ok and value == true) ~= "normal"
	end

	local function limit(frame: ScrollingFrame): Vector2
		local canvas, window = frame.AbsoluteCanvasSize, frame.AbsoluteWindowSize
		return V2.new(math.max(0, canvas.X - window.X), math.max(0, canvas.Y - window.Y))
	end

	local function move(frame: ScrollingFrame, target: Vector2, options: Env.ScrollOptions?): boolean
		local most = limit(frame)
		local goal = V2.new(math.clamp(target.X, 0, most.X), math.clamp(target.Y, 0, most.Y))
		local previous = running[frame]
		if previous then
			running[frame] = nil
			previous:Cancel()
		end
		if goal == frame.CanvasPosition then
			return false
		end
		local tweens = (config.services :: unknown) :: { TweenService: Tweens? }
		local service = tweens.TweenService
		if service and not (options and options.animated == false) and not reduced() then
			local playback = service:Create(
				frame,
				types.TweenInfo.new(
					ctx.metric("motion.durations.scrollReveal"),
					ctx.motionStyle("scroll"),
					E.EasingDirection.Out
				),
				{ CanvasPosition = goal }
			)
			running[frame] = playback
			playback:Play()
		else
			frame.CanvasPosition = goal
		end
		return true
	end

	UI.scrollTo = function(frame: ScrollingFrame, position: Env.ScrollPosition, options: Env.ScrollOptions?): boolean
		assert(
			type(frame) ~= "string" and (frame :: unknown) ~= nil and frame:IsA("ScrollingFrame"),
			"Facet UI.scrollTo expects a ScrollingFrame"
		)
		local current = frame.CanvasPosition
		local target: Vector2
		if position == "top" then
			target = V2.new(current.X, 0)
		elseif position == "bottom" then
			target = V2.new(current.X, limit(frame).Y)
		elseif typeof(position) == "Vector2" then
			target = position :: Vector2
		else
			assert(type(position) == "table", "Facet UI.scrollTo expects top, bottom, a Vector2 or { x, y }")
			local point = position :: { x: number?, y: number? }
			target = V2.new(point.x or current.X, point.y or current.Y)
		end
		return move(frame, target, options)
	end

	local function keep(start: number, size: number, band: number): number
		if start < 0 or size > band then
			return start
		elseif start + size > band then
			return start + size - band
		end
		return 0
	end

	UI.scrollToVisible = function(node: GuiObject, rect: Env.ScrollRect?, options: Env.ScrollOptions?): boolean
		assert(
			type(node) ~= "string" and (node :: unknown) ~= nil and node:IsA("GuiObject"),
			"Facet UI.scrollToVisible expects a GuiObject"
		)
		local origin, extent = node.AbsolutePosition, node.AbsoluteSize
		local left, top, width, height = origin.X, origin.Y, extent.X, extent.Y
		if rect then
			left, top, width, height = left + rect.x, top + rect.y, rect.w, rect.h
		end
		local shiftX, shiftY = 0, 0
		local moved = false
		local host = node.Parent
		while host do
			if host:IsA("ScrollingFrame") then
				local frame = host :: ScrollingFrame
				local view, window, canvas = frame.AbsolutePosition, frame.AbsoluteWindowSize, frame.CanvasPosition
				local direction = frame.ScrollingDirection
				local dx = if direction == E.ScrollingDirection.Y
					then 0
					else keep(left - shiftX - view.X, width, window.X)
				local dy = if direction == E.ScrollingDirection.X
					then 0
					else keep(top - shiftY - view.Y, height, window.Y)
				if dx ~= 0 or dy ~= 0 then
					local most = limit(frame)
					local goal = V2.new(math.clamp(canvas.X + dx, 0, most.X), math.clamp(canvas.Y + dy, 0, most.Y))
					if move(frame, goal, options) then
						moved = true
						shiftX += goal.X - canvas.X
						shiftY += goal.Y - canvas.Y
					end
				end
			end
			host = host.Parent
		end
		return moved
	end

	local function keyed(): boolean
		local input = config.userInputService
		if input == nil then
			return false
		end
		local ok, last = pcall(function()
			return input:GetLastInputType()
		end)
		if not ok or last == nil then
			return false
		end
		return last == E.UserInputType.Keyboard or string.find(last.Name, "^Gamepad") ~= nil
	end

	table.insert(ctx.selectionHooks, function(selected: unknown)
		if typeof(selected) ~= "Instance" and type(selected) ~= "table" then
			return
		end
		local target = selected :: GuiObject
		if not target:IsA("GuiObject") or not keyed() then
			return
		end
		local scroller = target:FindFirstAncestorWhichIsA("ScrollingFrame")
		if scroller == nil then
			return
		end
		local height, window = target.AbsoluteSize.Y, scroller.AbsoluteWindowSize.Y
		local room = math.clamp((window - height) / 2, 0, height)
		UI.scrollToVisible(target, { x = 0, y = -room, w = target.AbsoluteSize.X, h = height + 2 * room }, {
			animated = false,
		})
	end)
end
]]></string>
