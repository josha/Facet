        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">ui</string>
            <string name="Source"><![CDATA[--!strict
local context = require("@self/context")
local Types = require("@self/control_types")
local freeze = require("@self/freeze")
return function(Compose: Types.ComposeModule, runtime: Types.Runtime, options: Types.Config?): Types.Controls
	local ctx = context(Compose, runtime, options)
	local UI = ({} :: unknown) :: Types.Controls
	require("@self/layout")(ctx, UI)
	require("@self/composition")(ctx, UI)
	require("@self/inputs")(ctx, UI)
	require("@self/command_scope")(ctx, UI)
	local surfaces = require("@self/nav_modal")(ctx)
	require("@self/nav_menu")(ctx, UI, surfaces)
	require("@self/nav_surfaces")(ctx, UI, surfaces)
	require("@self/nav_sheet")(ctx, UI, surfaces)
	require("@self/nav_dialog")(ctx, UI, surfaces)
	require("@self/nav_popover")(ctx, UI, surfaces)
	require("@self/nav_notice")(ctx, UI, surfaces)
	require("@self/nav_toast")(ctx, UI, surfaces)
	require("@self/nav_pages")(ctx, UI, surfaces)
	require("@self/nav_radial")(ctx, UI, surfaces)
	local buildList = require("@self/collections")(ctx, UI)
	require("@self/collection_row_actions")(ctx, UI)
	require("@self/collection_table")(ctx, UI, buildList)
	require("@self/media")(ctx, UI)
	require("@self/timer")(ctx, UI)
	require("@self/typewriter")(ctx, UI)
	require("@self/pagination")(ctx, UI)
	require("@self/step_indicator")(ctx, UI)
	require("@self/vote")(ctx, UI)
	require("@self/card")(ctx, UI)
	require("@self/badge_seal")(ctx, UI)
	require("@self/date_time_picker")(ctx, UI, surfaces)
	require("@self/color_picker")(ctx, UI, surfaces)
	require("@self/environment")(ctx, UI)
	require("@self/drag")(ctx, UI)
	require("@self/scrolling")(ctx, UI)
	require("@self/navigation_split_view")(ctx, UI, surfaces)
	require("@self/effect_sequence")(ctx, UI)
	require("@self/effect_flash")(ctx, UI, surfaces)
	require("@self/zoom_view")(ctx, UI)
	require("@self/travel")(ctx, UI, surfaces)
	return freeze(UI)
end
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="5">
            <Properties>
              <string name="Name">activation</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local InputTypes = require("./input_types")
local activation = {}

export type EditAction = {
	id: string?,
	label: Types.ValueString,
	icon: Types.ValueString?,
	role: InputTypes.ButtonRole?,
	enabled: (Types.Use?) -> boolean,
	onActivate: () -> (),
}

local editors = setmetatable({} :: { [Instance]: EditAction }, { __mode = "k" })

function activation.provideEdit(node: Instance, action: EditAction): () -> ()
	editors[node] = action
	return function()
		editors[node] = nil
	end
end

function activation.edits(root: Instance): { EditAction }
	local result = {}
	if editors[root] then
		table.insert(result, editors[root])
	end
	for _, node in root:GetDescendants() do
		if editors[node] then
			table.insert(result, editors[node])
		end
	end
	return result
end

type Listener = (...unknown) -> ()

local owned = setmetatable({} :: { [Instance]: { Listener } }, { __mode = "k" })

function activation.mark(node: Instance)
	if owned[node] == nil then
		owned[node] = {}
	end
end

function activation.marked(node: Instance): boolean
	return owned[node] ~= nil
end

function activation.listen(node: Instance, listener: Listener): () -> ()
	local list = owned[node]
	if list == nil then
		list = {}
		owned[node] = list
	end
	table.insert(list, listener)
	return function()
		local current = owned[node]
		if current then
			local index = table.find(current, listener)
			if index then
				table.remove(current, index)
			end
		end
	end
end

local interceptors = setmetatable({} :: { [Instance]: (unknown) -> boolean }, { __mode = "k" })

function activation.intercept(node: Instance, listener: (unknown) -> boolean): () -> ()
	interceptors[node] = listener
	return function()
		if interceptors[node] == listener then
			interceptors[node] = nil
		end
	end
end

function activation.intercepted(node: Instance, input: unknown): boolean
	local listener = interceptors[node]
	return listener ~= nil and listener(input)
end

local activators = setmetatable({} :: { [Instance]: Listener }, { __mode = "k" })

function activation.provide(node: Instance, activate: Listener): () -> ()
	activators[node] = activate
	return function()
		if activators[node] == activate then
			activators[node] = nil
		end
	end
end

function activation.trigger(node: Instance, ...: unknown): boolean
	local activate = activators[node]
	if activate == nil then
		return false
	end
	activate(...)
	return true
end

function activation.notify(node: Instance, ...: unknown)
	local list = owned[node]
	if list == nil then
		return
	end
	for _, listener in table.clone(list) do
		listener(...)
	end
end

local consumed = setmetatable({} :: { [unknown]: boolean }, { __mode = "k" })

function activation.consume(input: unknown)
	if input ~= nil then
		consumed[input] = true
	end
end

function activation.release(input: unknown)
	if input ~= nil then
		consumed[input] = nil
	end
end

function activation.consumed(input: unknown): boolean
	return input ~= nil and consumed[input] == true
end

local pressers = setmetatable({} :: { [Instance]: (InputObject) -> () }, { __mode = "k" })

function activation.providePress(node: Instance, press: (InputObject) -> ()): () -> ()
	pressers[node] = press
	return function()
		if pressers[node] == press then
			pressers[node] = nil
		end
	end
end

function activation.press(node: Instance, input: InputObject)
	local press = pressers[node]
	if press then
		press(input)
	end
end

local drags = setmetatable({} :: { [Instance]: (string, Vector2?) -> boolean }, { __mode = "k" })

function activation.provideDrag(node: Instance, listener: (string, Vector2?) -> boolean): () -> ()
	drags[node] = listener
	return function()
		drags[node] = nil
	end
end

function activation.drag(node: Instance?, phase: string, position: Vector2?): boolean
	while node do
		local listener = drags[node]
		if listener then
			return listener(phase, position)
		end
		node = node.Parent
	end
	return false
end

return activation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6">
            <Properties>
              <string name="Name">adaptive</string>
              <string name="Source"><![CDATA[--!strict
local freeze = require("./freeze")
export type SizeClass = "compact" | "regular" | "wide"
export type HeightClass = "short" | "medium" | "tall"
export type Orientation = "landscape" | "portrait" | "square"
export type Breakpoints = { regular: number, wide: number }
export type AxisOptions = { stackAbove: number? }
export type NavPlacement = "topBar" | "sidebar" | "bottomBar" | "bottomBarCompact"
export type NavFacts = {
	sizeClass: string,
	heightClass: string,
	primary: string?,
	displaySize: string?,
	tenFoot: boolean?,
}
export type ViewingDistance = "automatic" | "near" | "ten-foot"
export type TenFootFacts = {
	displaySize: string?,
	touch: boolean?,
	mouse: boolean?,
	tenFootInterface: boolean?,
	viewingDistance: string?,
}
export type Insets = { top: number, left: number, bottom: number, right: number }
export type Adaptive = {
	BREAKPOINTS: Breakpoints,
	HEIGHT_BREAKPOINTS: Breakpoints,
	DEFAULT_STACK_ABOVE: number,
	sizeClass: (width: number?) -> SizeClass,
	heightClass: (height: number?) -> HeightClass,
	orientationFor: (width: number, height: number) -> Orientation,
	axisFor: (width: number?, options: AxisOptions?) -> "x" | "y",
	columnsFor: (available: number, minColumnWidth: number, gap: number?) -> number,
	sizeClassAtLeast: (value: string, target: string) -> boolean,
	navPlacement: (facts: NavFacts) -> NavPlacement,
	isTenFoot: (facts: TenFootFacts) -> boolean,
	TEN_FOOT_SCALE: number,
	overscanInsets: (width: number, height: number) -> Insets,
}

local BREAKPOINTS: Breakpoints = freeze({ regular = 600, wide = 1000 })
local RANK: { [string]: number } = { compact = 1, regular = 2, wide = 3 }

local function real(value: number?): number?
	if type(value) ~= "number" or value ~= value then
		return nil
	end
	return value
end

local function sizeClass(width: number?): SizeClass
	local measured = real(width)
	if measured == nil or measured < BREAKPOINTS.regular then
		return "compact"
	end
	return if measured < BREAKPOINTS.wide then "regular" else "wide"
end

local function heightClass(height: number?): HeightClass
	local measured = real(height)
	if measured == nil or measured < BREAKPOINTS.regular then
		return "short"
	end
	return if measured < BREAKPOINTS.wide then "medium" else "tall"
end

local function orientationFor(width: number, height: number): Orientation
	if width > height then
		return "landscape"
	end
	return if height > width then "portrait" else "square"
end

local function axisFor(width: number?, options: AxisOptions?): "x" | "y"
	local above = if options and options.stackAbove then options.stackAbove else BREAKPOINTS.regular
	local measured = real(width)
	return if measured ~= nil and measured >= above then "x" else "y"
end

local function columnsFor(available: number, minColumnWidth: number, gap: number?): number
	assert(
		type(minColumnWidth) == "number" and minColumnWidth > 0,
		"Facet adaptive.columnsFor: minColumnWidth must be a positive number"
	)
	local spacing = math.max(0, gap or 0)
	local room = real(available)
	if room == nil or room <= minColumnWidth then
		return 1
	end
	return math.max(1, math.floor((room + spacing) / (minColumnWidth + spacing)))
end

local function sizeClassAtLeast(value: string, target: string): boolean
	local have, need = RANK[value], RANK[target]
	assert(have ~= nil and need ~= nil, "Facet adaptive.sizeClassAtLeast: expected compact, regular or wide")
	return have >= need
end

local function navPlacement(facts: NavFacts): NavPlacement
	if facts.tenFoot then
		return "topBar"
	end
	if facts.sizeClass == "compact" then
		return "bottomBar"
	end
	if facts.heightClass == "short" then
		return "bottomBarCompact"
	end
	if facts.primary == "pointer" then
		return "sidebar"
	end
	if facts.primary == "gamepad" and facts.displaySize == "Small" then
		return "bottomBar"
	end
	return "topBar"
end

local function isTenFoot(facts: TenFootFacts): boolean
	if facts.viewingDistance == "ten-foot" or facts.viewingDistance == "near" then
		return facts.viewingDistance == "ten-foot"
	end
	return (facts.tenFootInterface == true or facts.displaySize == "Large")
		and facts.touch ~= true
		and facts.mouse ~= true
end

local function overscanInsets(width: number, height: number): Insets
	local x = math.floor((real(width) or 0) * 90 / 1920 + 0.5)
	local y = math.floor((real(height) or 0) * 60 / 1080 + 0.5)
	return freeze({ top = y, left = x, bottom = y, right = x })
end

local adaptive: Adaptive = freeze({
	BREAKPOINTS = BREAKPOINTS,
	HEIGHT_BREAKPOINTS = BREAKPOINTS,
	DEFAULT_STACK_ABOVE = BREAKPOINTS.regular,
	sizeClass = sizeClass,
	heightClass = heightClass,
	orientationFor = orientationFor,
	axisFor = axisFor,
	columnsFor = columnsFor,
	sizeClassAtLeast = sizeClassAtLeast,
	navPlacement = navPlacement,
	isTenFoot = isTenFoot,
	TEN_FOOT_SCALE = 1.5,
	overscanInsets = overscanInsets,
})
return adaptive
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="7">
            <Properties>
              <string name="Name">app</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local ControlTypes = require("./control_types")
local ThemeTypes = require("./theme_types")
local Engine = require("./engine_types")
local Overlay = require("./overlay_types")
local freeze = require("./freeze")
local OverlayProps = require("./overlay_props")

export type Component = () -> ComposeTypes.Child
export type AppOptions = {
	types: Types.RobloxTypes?,
	services: Types.Services?,
	guiService: GuiService?,
	userInputService: UserInputService?,
	inputParent: Instance?,
	overlayParent: Instance?,
	controlSize: Types.Value<Types.ControlSize?>?,
	theme: Types.Value<ThemeTypes.ThemePackage>?,
	icons: Types.Value<{ [string]: ThemeTypes.IconEntry }>?,
	motionLevel: (Types.Value<Types.MotionLevel> | Types.Value<Types.MotionLevel?>)?,
	environment: Types.EnvironmentPreview?,
	keyboardNavigation: boolean?,
	translator: Types.Value<Translator?>?,
	pressHaptic: (HapticEffect | Types.HapticKind)?,
	onError: ((unknown) -> ())?,
	runtime: Types.Runtime?,
	parent: Instance?,
	name: string?,
	screen: Engine.ScreenGuiNativeProps?,
	sheet: ThemeTypes.ThemeOptions?,
	focusRing: boolean?,
}
export type AnchoredOptions = {
	source: Overlay.PopoverSource,
	edge: Overlay.Edge?,
	align: Overlay.Align?,
	gap: number?,
	crossOffset: number?,
	tail: boolean?,
	maxWidth: number?,
	maxHeight: number?,
	modal: boolean?,
	cancelPolicy: ("dismiss" | "none")?,
	onDismiss: ((Overlay.PopoverDismissReason) -> ())?,
}
export type ToastOptions = {
	key: string?,
	priority: number?,
	duration: number?,
	readFloor: number?,
	position: ("top" | "bottom")?,
	width: ("fill" | "hug")?,
	fade: boolean?,
	onDismiss: ((Overlay.ToastDismissReason) -> ())?,
}
export type Toast = { id: number, dismiss: () -> boolean }
export type App = {
	runtime: Types.Runtime,
	UI: ControlTypes.Controls,
	mount: (component: Component, parent: Instance?) -> (() -> (), ScreenGui),
	refusal: (control: string, spec: unknown) -> string?,
	construct: (control: string, spec: unknown) -> Instance,
	controlNames: () -> { string },
	presentAnchored: (
		component: (ControlTypes.Controls) -> Instance,
		options: AnchoredOptions
	) -> (() -> (), ScreenGui),
	presentToast: (component: (ControlTypes.Controls) -> Instance, options: ToastOptions?) -> Toast,
	dispose: () -> (),
}
type RobloxModule = { createRuntime: () -> Types.Runtime }
type StyleLinkHost = { StyleLink: ({ StyleSheet: unknown }) -> Instance }

local function playerGui(): Instance
	local game = getfenv(0).game
	local players = game and game:GetService("Players")
	local player = players and players.LocalPlayer
	if player == nil then
		error("Facet app.mount: there is no PlayerGui here. Give a parent to Facet.app or to app.mount.", 3)
	end
	return player:WaitForChild("PlayerGui")
end

return function(
	Compose: Types.ComposeModule,
	roblox: RobloxModule,
	controls: ControlTypes.Factory,
	themes: ThemeTypes.Themes,
	options: AppOptions?
): App
	local settings: AppOptions = options or {}
	local owned = settings.runtime == nil
	local runtime = settings.runtime or roblox.createRuntime()
	local UI = controls(Compose, runtime, (settings :: unknown) :: Types.Config)
	local Host = (runtime.constructors :: unknown) :: Engine.Host
	local Links = (runtime.constructors :: unknown) :: StyleLinkHost
	local stops: { () -> () } = {}
	local disposed = false
	local function mount(component: Component, parent: Instance?): (() -> (), ScreenGui)
		assert(not disposed, "Facet app.mount: the app is disposed")
		assert(type(component) == "function", "Facet app.mount: expected a component function")
		local target = parent or settings.parent or playerGui()
		local stop, root = runtime.mount(function(): ComposeTypes.Child
			local sheetOptions: ThemeTypes.ThemeOptions = table.clone(settings.sheet or {})
			if sheetOptions.types == nil then
				sheetOptions.types = settings.types
			end
			if sheetOptions.motionLevel == nil then
				sheetOptions.motionLevel = settings.motionLevel
			end
			if sheetOptions.tenFoot == nil then
				sheetOptions.tenFoot = UI.environment().isTenFoot
			end
			local sheet = themes.createStyleSheet(runtime, settings.theme, sheetOptions)
			local props: { [unknown]: unknown } = {}
			for key, value in ((settings.screen or {}) :: unknown) :: { [unknown]: unknown } do
				assert(type(key) == "string", "Facet app: screen takes native ScreenGui properties only")
				props[key] = value
			end
			props.Name = props.Name or settings.name or "Facet"
			if props.ResetOnSpawn == nil then
				props.ResetOnSpawn = false
			end
			if props.ZIndexBehavior == nil then
				local enums = if settings.types then settings.types.Enum else Enum
				props.ZIndexBehavior = enums.ZIndexBehavior.Sibling
			end
			props[1] = sheet
			props[2] = Links.StyleLink({ StyleSheet = Compose.static(sheet) })
			props[3] = component()
			if target:IsA("PlayerGui") and settings.focusRing ~= false then
				props[4] = UI.focusRing(target :: PlayerGui)
			end
			return Host.ScreenGui((props :: unknown) :: Engine.ScreenGuiNativeProps)
		end, target)
		local stopped = false
		local function release()
			if not stopped then
				stopped = true
				local index = table.find(stops, release)
				if index then
					table.remove(stops, index)
				end
				stop()
			end
		end
		table.insert(stops, release)
		return release, (root :: unknown) :: ScreenGui
	end
	local members = (UI :: unknown) :: { [string]: unknown }
	local function refusal(control: string, spec: unknown): string?
		assert(not disposed, "Facet app.refusal: the app is disposed")
		local construct = ((UI :: unknown) :: { [string]: (unknown) -> Instance })[control]
		if construct == nil then
			error(`Facet app.refusal: there is no control named '{tostring(control)}'`, 2)
		end
		local ok, failure = pcall(function()
			Compose.withRootOwner(function()
				Host.ScreenGui({ construct(spec) } :: Engine.ScreenGuiNativeProps)
			end)
		end)
		if ok then
			return nil
		end
		local text = tostring(failure)
		return string.match(text, "^[^\n]-:%d+: (.*)$") or text
	end
	local function construct(control: string, spec: unknown): Instance
		assert(not disposed, "Facet app.construct: the app is disposed")
		local member = if type(control) == "string" and string.match(control, "^%u") ~= nil
			then members[control]
			else nil
		if type(member) ~= "function" then
			error(`Facet app.construct: there is no control named '{tostring(control)}'`, 2)
		end
		return (member :: (unknown) -> Instance)(spec)
	end
	local function controlNames(): { string }
		local names: { string } = {}
		for name in members do
			table.insert(names, name)
		end
		table.sort(names)
		return names
	end
	local function presentAnchored(
		component: (ControlTypes.Controls) -> Instance,
		options: AnchoredOptions
	): (() -> (), ScreenGui)
		assert(type(component) == "function", "Facet app.presentAnchored: expected a component function")
		assert(
			type(options) == "table" and options.source ~= nil,
			"Facet app.presentAnchored: options.source is required"
		)
		local open = Compose.cell(true)
		local release: () -> () = function() end
		local released = false
		local spec: { [string]: unknown } = {}
		for key, value in (options :: unknown) :: { [string]: unknown } do
			spec[key] = value
		end
		spec.compact = "popover"
		spec.isPresented = open
		spec.onPresentedChange = function(value: boolean)
			open:set(value)
		end
		spec.onDismiss = function(reason: Overlay.PopoverDismissReason)
			if options.onDismiss then
				options.onDismiss(reason)
			end
			if not released then
				released = true
				release()
			end
		end
		spec.content = function(): Instance
			return component(UI)
		end
		spec.Name = "Anchored"
		local stop, screen = mount(function(): ComposeTypes.Child
			return UI.Popover((spec :: unknown) :: OverlayProps.PopoverSpec)
		end)
		release = stop
		local function close()
			if not released then
				released = true
				stop()
			end
		end
		return close, screen
	end
	local toasts = 0
	local toastLayer: ScreenGui? = nil
	local function presentToast(component: (ControlTypes.Controls) -> Instance, options: ToastOptions?): Toast
		assert(type(component) == "function", "Facet app.presentToast: expected a component function")
		local spec: { [string]: unknown } = {}
		for key, value in ((options or {}) :: unknown) :: { [string]: unknown } do
			spec[key] = value
		end
		local stop: () -> () = function() end
		local live = true
		local function finish()
			if live then
				live = false
				stop()
			end
		end
		spec.onDismiss = function(reason: Overlay.ToastDismissReason)
			if options and options.onDismiss then
				options.onDismiss(reason)
			end
			finish()
		end
		spec.content = function(): Instance
			return component(UI)
		end
		toasts += 1
		local id = toasts
		if toastLayer == nil or toastLayer.Parent == nil then
			local _, layer = mount(function(): ComposeTypes.Child
				return Host.Folder({ Name = "Toasts" })
			end)
			layer.Name = (settings.name or "Facet") .. "Toasts"
			toastLayer = layer
		end
		stop = runtime.mountFragment(function(): { ComposeTypes.Child }
			spec.Name = `Toast{id}`
			return { UI.Toast((spec :: unknown) :: OverlayProps.ToastSpec) }
		end, assert(toastLayer))
		if not live then
			stop()
		end
		return freeze({
			id = id,
			dismiss = function(): boolean
				local was = live
				finish()
				return was
			end,
		})
	end
	local function dispose()
		if disposed then
			return
		end
		disposed = true
		for index = #stops, 1, -1 do
			stops[index]()
		end
		if owned then
			runtime:dispose()
		end
	end
	return freeze({
		runtime = runtime,
		UI = UI,
		mount = mount,
		refusal = refusal,
		construct = construct,
		controlNames = controlNames,
		presentAnchored = presentAnchored,
		presentToast = presentToast,
		dispose = dispose,
	})
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="8">
            <Properties>
              <string name="Name">arithmetic</string>
              <string name="Source"><![CDATA[--!strict
local arithmetic = {}

local function readNumber(text: string, at: number): (number?, number)
	local digits, nextAt = string.match(text, "^(%d*%.?%d*)()", at)
	if digits == nil or digits == "" or digits == "." then
		return nil, at
	end
	local value = tonumber(digits)
	if value == nil or value ~= value then
		return nil, at
	end
	return value, nextAt :: number
end

local TIMES = { "*", "\u{00D7}", "\u{2715}" }
local OVER = { "/", "\u{00F7}" }
local MINUS = { "-", "\u{2212}" }
local PLUS = { "+" }

local function matchAny(text: string, at: number, tokens: { string }): string?
	for _, token in tokens do
		if string.sub(text, at, at + #token - 1) == token then
			return token
		end
	end
	return nil
end

function arithmetic.number(text: unknown): number?
	if type(text) ~= "string" then
		return nil
	end
	local sign = matchAny(text, 1, MINUS) or matchAny(text, 1, PLUS)
	local rest = if sign ~= nil then string.sub(text, #sign + 1) else text
	local value, at = readNumber(rest, 1)
	if value == nil or at ~= #rest + 1 then
		return nil
	end
	return if sign ~= nil and sign ~= "+" then -value else value
end

function arithmetic.incomplete(text: unknown): boolean
	if type(text) ~= "string" then
		return true
	end
	local sign = matchAny(text, 1, MINUS) or matchAny(text, 1, PLUS)
	local rest = if sign ~= nil then string.sub(text, #sign + 1) else text
	return rest == "" or rest == "."
end

local function skipBlanks(text: string, at: number): number
	local _, stop = string.find(text, "^%s*", at)
	return (stop :: number) + 1
end

local MAX_LENGTH = 256
local MAX_DEPTH = 32

type State = { text: string, at: number, failed: boolean, depth: number }

local parseExpr

local function parsePrimary(s: State): number
	s.at = skipBlanks(s.text, s.at)
	if string.sub(s.text, s.at, s.at) == "(" then
		s.depth += 1
		if s.depth > MAX_DEPTH then
			s.failed = true
			return 0
		end
		s.at += 1
		local inner = parseExpr(s)
		s.depth -= 1
		s.at = skipBlanks(s.text, s.at)
		if string.sub(s.text, s.at, s.at) ~= ")" then
			s.failed = true
			return 0
		end
		s.at += 1
		return inner
	end
	local value, nextAt = readNumber(s.text, s.at)
	if value == nil then
		s.failed = true
		return 0
	end
	s.at = nextAt
	return value
end

local function parseFactor(s: State): number
	s.at = skipBlanks(s.text, s.at)
	local plus = matchAny(s.text, s.at, PLUS)
	local minus = if plus == nil then matchAny(s.text, s.at, MINUS) else nil
	local sign = plus or minus
	if sign == nil then
		return parsePrimary(s)
	end

	s.depth += 1
	if s.depth > MAX_DEPTH then
		s.failed = true
		return 0
	end
	s.at += #sign
	local inner = parseFactor(s)
	s.depth -= 1
	return if minus ~= nil then -inner else inner
end

local function parseTerm(s: State): number
	local value = parseFactor(s)
	while not s.failed do
		s.at = skipBlanks(s.text, s.at)
		local times = matchAny(s.text, s.at, TIMES)
		local over = if times == nil then matchAny(s.text, s.at, OVER) else nil
		local token = times or over
		if token == nil then
			break
		end
		s.at += #token
		local rhs = parseFactor(s)
		if s.failed then
			return 0
		end
		if over ~= nil then
			if rhs == 0 then
				s.failed = true
				return 0
			end
			value /= rhs
		else
			value *= rhs
		end
	end
	return value
end

function parseExpr(s: State): number
	local value = parseTerm(s)
	while not s.failed do
		s.at = skipBlanks(s.text, s.at)
		local minus = matchAny(s.text, s.at, MINUS)
		local plus = if minus == nil then matchAny(s.text, s.at, PLUS) else nil
		local token = minus or plus
		if token == nil then
			break
		end
		s.at += #token
		local rhs = parseTerm(s)
		if s.failed then
			return 0
		end
		value = if minus ~= nil then value - rhs else value + rhs
	end
	return value
end

function arithmetic.parse(text: unknown): number?
	if type(text) ~= "string" then
		return nil
	end
	if #text > MAX_LENGTH then
		return nil
	end
	local s: State = { text = text, at = 1, failed = false, depth = 0 }
	local value = parseExpr(s)
	s.at = skipBlanks(s.text, s.at)
	if s.failed or s.at ~= #s.text + 1 then
		return nil
	end
	if value ~= value or math.abs(value) == math.huge then
		return nil
	end
	return value
end

return arithmetic
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9">
            <Properties>
              <string name="Name">badge_seal</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Content = require("./content_types")
local ComposeTypes = require("../vendor/compose/core")

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls): ()
	local Host, Compose, read = ctx.Host, ctx.Compose, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local function words(value: Content.BadgeValue?): string
		if value == true then
			return "•"
		elseif type(value) == "number" then
			assert(
				value == value and value % 1 == 0 and value >= 0,
				"Facet UI.badged: a count must be a whole number of 0 or more"
			)
			return if value > 99 then "99+" elseif value == 0 then "" else tostring(value)
		elseif type(value) == "string" then
			return value
		end
		assert(value == nil or value == false, "Facet UI.badged: value must be a string, a count, true, false or nil")
		return ""
	end
	UI.badged = function(host: GuiObject, value: Types.Value<Content.BadgeValue?>, direction: ("ltr" | "rtl")?): Frame
		assert((host :: Instance?) and host:IsA("GuiObject"), "Facet UI.badged: host must be a GuiObject")
		assert(
			direction == nil or direction == "ltr" or direction == "rtl",
			"Facet UI.badged: direction must be ltr or rtl"
		)
		assert(Compose.currentOwner() ~= nil, "Facet UI.badged: build a badged host inside runtime.mount")
		words(read(value))
		local text = function(use: ComposeTypes.Use): string
			return words(read(value, use))
		end
		local wrapper = Host.Frame(host.Name .. "+badge")({
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			LayoutOrder = host.LayoutOrder,
			Size = D2.fromOffset(0, 0),
			AutomaticSize = E.AutomaticSize.XY,
			host :: Types.Child,
			Host.Frame "Corner" {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = D2.fromOffset(0, 0),
				Position = D2.fromScale(if direction == "rtl" then 0 else 1, 0),
				ZIndex = host.ZIndex + 2,
				Compose.show(function(use: ComposeTypes.Use): boolean
					return text(use) ~= ""
				end, function()
					return UI.Badge({
						Name = "CornerBadge",
						label = text,
						AnchorPoint = V2.new(0.7, 0.4),
						Position = D2.fromScale(0, 0),
						ZIndex = host.ZIndex + 2,
					})
				end),
			} :: Types.Child,
		})
		return wrapper
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="10">
            <Properties>
              <string name="Name">card</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local ComposeTypes = require("../vendor/compose/core")
local values = require("./content_values")
local parts = require("./overlay_parts")
local ContentProps = require("./content_props")
local ControlTypes = require("./control_types")
local InputProps = require("./input_props")
local reducedMotion = require("./motion").reduced

local ACTION_KEYS: { [string]: boolean } = { label = true, icon = true, onActivate = true, enabled = true, busy = true }
local MENU_KEYS: { [string]: boolean } = { items = true, label = true }

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls): ()
	local Host, Compose, read, runtime = ctx.Host, ctx.Compose, ctx.read, ctx.runtime
	local E, D2, D = ctx.types.Enum, ctx.types.UDim2, ctx.types.UDim
	local function nonempty(value: unknown): boolean
		return type(value) == "string" and string.find(value, "%S") ~= nil
	end
	local function text(value: unknown): boolean
		return type(value) == "string"
	end
	local function within(node: Instance?, ancestor: Instance): boolean
		return node ~= nil and (node == ancestor or node:IsDescendantOf(ancestor))
	end

	UI.Card = ctx.construct("Card", function(spec: ContentProps.CardSpec): Frame
		assert(
			spec.artwork == nil or type(spec.artwork) == "function",
			"Facet UI.Card: artwork must be a function that returns a GuiObject"
		)
		assert(
			nonempty(read(spec.image)) or (spec.artwork ~= nil and spec.image == nil),
			"Facet UI.Card: image is required: a nonempty image string, or artwork"
		)
		assert(nonempty(read(spec.title)), "Facet UI.Card: title is required: a nonempty string")
		assert(spec.caption == nil or text(read(spec.caption)), "Facet UI.Card: caption must be a string")
		local ratio = spec.imageAspectRatio or 16 / 9
		assert(
			type(ratio) == "number" and ratio > 0 and ratio < math.huge,
			"Facet UI.Card: imageAspectRatio must be a positive finite number"
		)
		assert(
			spec.imageFraming == nil or spec.imageFraming == "fit" or spec.imageFraming == "crop",
			"Facet UI.Card: imageFraming must be fit or crop"
		)
		assert(
			spec.ringTarget == nil or spec.ringTarget == "card" or spec.ringTarget == "media",
			"Facet UI.Card: ringTarget must be card or media"
		)
		local reveal = spec.reveal or "automatic"
		assert(reveal == "automatic" or reveal == "always", "Facet UI.Card: reveal must be automatic or always")
		assert(
			spec.onActivate == nil or type(spec.onActivate) == "function",
			"Facet UI.Card: onActivate must be a function"
		)
		assert(
			spec.browseTarget == nil or type(spec.browseTarget) == "function",
			"Facet UI.Card: browseTarget must be a function that returns the browse stop"
		)
		local primary = spec.primaryAction
		if primary ~= nil then
			assert(type(primary) == "table", "Facet UI.Card: primaryAction must be a table")
			for key in (primary :: unknown) :: { [string]: unknown } do
				assert(ACTION_KEYS[key], `Facet UI.Card: primaryAction has the unknown field '{key}'`)
			end
			assert(nonempty(read(primary.label)), "Facet UI.Card: primaryAction.label must be a nonempty string")
			assert(type(primary.onActivate) == "function", "Facet UI.Card: primaryAction.onActivate is required")
		end
		local menu = spec.menu
		if menu ~= nil then
			assert(type(menu) == "table", "Facet UI.Card: menu must be a table")
			for key in (menu :: unknown) :: { [string]: unknown } do
				assert(MENU_KEYS[key], `Facet UI.Card: menu has the unknown field '{key}'`)
			end
			assert(menu.items ~= nil, "Facet UI.Card: menu.items is required")
		end
		local checks = values(ctx, "Card")
		local title = checks.legal("title", spec.title, nonempty, "must be a nonempty string")
		local image = if spec.image == nil
			then ""
			else checks.legal("image", spec.image, nonempty, "must be a nonempty image string")
		local caption = checks.legal("caption", spec.caption or "", text, "must be a string")
		local enabled = function(use: ComposeTypes.Use?): boolean
			return read(spec.enabled, use) ~= false
		end
		local gui = ctx.config.services.GuiService
		local input = ctx.config.services.UserInputService
		local selected = if gui then ctx.observe.SelectedObject(gui) else Compose.cell(nil :: GuiObject?)
		local touchEnabled = if input then ctx.observe.TouchEnabled(input) else Compose.cell(false)
		local preferred = if input then ctx.observe.PreferredInput(input) else nil
		local function prefersTouch(use: ComposeTypes.Use): boolean
			return preferred ~= nil and use(preferred) == E.PreferredInput.Touch
		end
		local hovered, entered, menuOpen = Compose.cell(false), Compose.cell(false), Compose.cell(false)
		local pressingBody = Compose.cell(false)
		local reduced = reducedMotion(ctx)
		local root: Frame? = nil
		local primaryButton: TextButton?
		local moreTrigger: GuiObject?
		local actionStates = Compose.cell({} :: { ComposeTypes.Readable<boolean> })
		local function holding(button: GuiObject): ComposeTypes.Readable<boolean>
			local down = Compose.cell(false)
			local state = ctx.observe.GuiState(button)
			local function pointer(input: InputObject): boolean
				return input.UserInputType == E.UserInputType.MouseButton1
					or input.UserInputType == E.UserInputType.Touch
			end
			runtime.connect(button, "InputBegan", function(input: InputObject)
				if pointer(input) then
					down:set(true)
				end
			end)
			runtime.connect(button, "InputEnded", function(input: InputObject)
				if pointer(input) then
					down:set(false)
				end
			end)
			return Compose.formula(function(use: ComposeTypes.Use): boolean
				return use(down) or use(state) == E.GuiState.Press
			end)
		end
		local hasStop = spec.onActivate ~= nil or spec.browseTarget ~= nil
		local focusWithin = Compose.formula(function(use: ComposeTypes.Use): boolean
			local node, card = use(selected), root
			return node ~= nil and card ~= nil and within(node, card)
		end)
		local browsing = Compose.formula(function(use: ComposeTypes.Use): boolean
			local node = use(selected)
			local target: Instance? = if spec.browseTarget then spec.browseTarget() else nil
			return node ~= nil and target ~= nil and (node :: Instance) == target
		end)
		local pressing = Compose.formula(function(use: ComposeTypes.Use): boolean
			if use(pressingBody) then
				return true
			end
			for _, state in use(actionStates) do
				if use(state) then
					return true
				end
			end
			return false
		end)
		local engaged = Compose.formula(function(use: ComposeTypes.Use): boolean
			return use(hovered) or use(focusWithin) or use(pressing) or use(menuOpen) or use(entered) or use(browsing)
		end)
		local touch = function(use: ComposeTypes.Use): boolean
			return use(touchEnabled) == true or prefersTouch(use)
		end
		local revealed = Compose.formula(function(use: ComposeTypes.Use): boolean
			return reveal == "always" or not hasStop or touch(use) or use(engaged)
		end)
		local lifting = Compose.formula(function(use: ComposeTypes.Use): boolean
			if prefersTouch(use) then
				return false
			end
			return use(engaged)
		end)
		local liftTarget = Compose.formula(function(use: ComposeTypes.Use): number
			return if use(lifting) then ctx.metric("motion.materialize.lift", use) else 1
		end)
		local liftSpring = ctx.motionSpring("snappy")
		local spring = runtime.spring(function(use: ComposeTypes.Use)
			return use(liftTarget)
		end, { period = liftSpring.period, damping = liftSpring.damping })
		local scale = Compose.formula(function(use: ComposeTypes.Use): number
			return if reduced(use) then 1 else use(spring)
		end)
		local fade = runtime.tween(function(use: ComposeTypes.Use)
			return if use(revealed) then 1 else 0
		end, { seconds = ctx.metric("motion.durations.cardFade") })
		local function eligible(): GuiObject?
			local card = root
			if not enabled() or card == nil or card.Parent == nil then
				return nil
			end
			if primaryButton and primary and read(primary.enabled) ~= false and read(primary.busy) ~= true then
				return primaryButton
			end
			if moreTrigger then
				return moreTrigger
			end
			return nil
		end
		local function restore()
			if not gui then
				return
			end
			local target = if spec.browseTarget then spec.browseTarget() else nil
			if target and target.Parent then
				gui.SelectedObject = target
			elseif root and (root :: Frame).Parent then
				local body = (root :: Frame):FindFirstChild("Body")
				if body and body:IsA("GuiObject") and body.Selectable then
					gui.SelectedObject = body
				end
			end
		end
		local function enterActions(): boolean
			local first = eligible()
			if first == nil then
				return false
			end
			entered:set(true)
			if gui then
				gui.SelectedObject = first
			end
			return true
		end
		local function leaveActions()
			if not entered:peek() then
				return
			end
			entered:set(false)
			if gui and root and within(gui.SelectedObject, root :: Frame) then
				restore()
			end
		end
		if spec.controls then
			spec.controls.enterActions = enterActions
			spec.controls.leaveActions = leaveActions
			spec.controls.engaged = engaged
			spec.controls.revealed = revealed
			spec.controls.scale = scale
			spec.controls.lifting = lifting
			spec.controls.diagnostics = checks.list
		end
		local artwork = Host.ImageLabel({
			Name = "Artwork",
			LayoutOrder = 1,
			BackgroundTransparency = 1,
			Image = image,
			Size = D2.new(1, 0, 0, 100000),
			ScaleType = if spec.imageFraming == "fit" then E.ScaleType.Fit else E.ScaleType.Crop,
			Host.UIAspectRatioConstraint {
				AspectRatio = ratio,
				AspectType = E.AspectType.FitWithinMaxSize,
				DominantAxis = E.DominantAxis.Width,
			},
		})
		if spec.artwork then
			local build = spec.artwork
			runtime.mount(function()
				local live = build()
				assert(parts.instance(live) and live:IsA("GuiObject"), "Facet UI.Card: artwork must return a GuiObject")
				runtime.decorate(live, { Size = D2.fromScale(1, 1) })
				return live
			end, artwork)
		end
		local titleLabel = ctx.text({
			Name = "Title",
			LayoutOrder = 2,
			Text = title,
			Size = D2.fromScale(1, 0),
			AutomaticSize = E.AutomaticSize.Y,
			TextWrapped = true,
		})
		titleLabel:AddTag("facet-type-label")
		local function inset(bottom: boolean): UIPadding
			local function side(use: ComposeTypes.Use): UDim
				return D.new(0, ctx.metric("space.s", use))
			end
			return Host.UIPadding({
				PaddingLeft = side,
				PaddingRight = side,
				PaddingBottom = if bottom then side else nil,
			})
		end
		runtime.mount(function()
			return inset(false)
		end, titleLabel)
		local captionLabel: TextLabel?
		if spec.caption ~= nil then
			local label = ctx.text({
				Name = "Caption",
				LayoutOrder = 3,
				Text = caption,
				Visible = function(use: ComposeTypes.Use): boolean
					return use(caption) ~= ""
				end,
				Size = D2.fromScale(1, 0),
				AutomaticSize = E.AutomaticSize.Y,
				TextWrapped = true,
			})
			label:AddTag("facet-type-caption")
			label:AddTag("facet-secondary")
			runtime.mount(function()
				return inset(true)
			end, label)
			captionLabel = label
		end
		local bodyChildren: { Types.Child } = {
			Host.UIPadding {
				PaddingLeft = D.new(0, 0),
				PaddingRight = D.new(0, 0),
				PaddingTop = D.new(0, 0),
				PaddingBottom = D.new(0, 0),
			} :: Types.Child,
			Host.UIListLayout({
				FillDirection = E.FillDirection.Vertical,
				SortOrder = E.SortOrder.LayoutOrder,
				Padding = function(use: ComposeTypes.Use)
					return D.new(0, ctx.metric("space.xs", use))
				end,
			}) :: Types.Child,
			artwork :: Types.Child,
			titleLabel :: Types.Child,
			captionLabel :: Types.Child,
		}
		local body: GuiObject
		if spec.onActivate then
			local onActivate = spec.onActivate
			local props: InputProps.ButtonProps = {
				Name = "Body",
				LayoutOrder = 1,
				label = "",
				name = title,
				Size = D2.fromScale(1, 0),
				AutomaticSize = E.AutomaticSize.Y,
				enabled = enabled,
				onActivate = function(input: InputObject?)
					onActivate(input)
				end,
				onPointerDown = function()
					pressingBody:set(true)
				end,
				onPointerUp = function()
					pressingBody:set(false)
				end,
				onPointerCancel = function()
					pressingBody:set(false)
				end,
			}
			for _, child in bodyChildren do
				props[#props + 1] = child
			end
			local button = UI.Button(props)
			button:AddTag("facet-panel")
			body = button
			runtime.mount(function()
				return Host.UIShadow({
					Name = "LiftShadow",
					Enabled = lifting,
				})
			end, button)
		else
			local props: Types.FrameNativeProps = {
				Name = "Body",
				LayoutOrder = 1,
				Size = D2.fromScale(1, 0),
				AutomaticSize = E.AutomaticSize.Y,
				Attributes = {
					label = function(use: ComposeTypes.Use): string
						return use(title)
					end,
				} :: Types.Attributes,
			}
			for _, child in bodyChildren do
				props[#props + 1] = child
			end
			body = ctx.styled(Host.Frame(props), "panel")
		end
		ctx.styled(body, "card-body")
		local actionEnabled = function(use: ComposeTypes.Use?): boolean
			return enabled(use) and read(revealed, use)
		end
		local rowChildren: { Types.Child } = {
			Host.UIListLayout({
				FillDirection = E.FillDirection.Horizontal,
				SortOrder = E.SortOrder.LayoutOrder,
				VerticalAlignment = E.VerticalAlignment.Center,
				Padding = function(use: ComposeTypes.Use)
					return D.new(0, ctx.metric("space.s", use))
				end,
			}) :: Types.Child,
		}
		if primary then
			local action = primary
			local button = UI.Button({
				Name = "Primary",
				LayoutOrder = 1,
				label = action.label,
				icon = action.icon,
				appearance = "emphasis",
				busy = action.busy,
				enabled = function(use: ComposeTypes.Use): boolean
					return enabled(use) and read(action.enabled, use) ~= false
				end,
				onActivate = function()
					if actionEnabled() then
						action.onActivate()
					end
				end,
				Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }) :: Types.Child,
			})
			primaryButton = button
			local states = table.clone(actionStates:peek())
			table.insert(states, holding(button))
			actionStates:set(states)
			table.insert(rowChildren, button :: Types.Child)
		end
		if menu then
			local more = UI.Menu({
				Name = "More",
				LayoutOrder = 2,
				trigger = UI.Button({ label = "", name = menu.label or "More", icon = "more", enabled = enabled }) :: GuiObject,
				items = menu.items,
				isPresented = menuOpen,
				enabled = enabled,
			})
			moreTrigger = more
			local states = table.clone(actionStates:peek())
			table.insert(states, holding(more))
			actionStates:set(states)
			table.insert(rowChildren, more :: Types.Child)
		end
		local rowProps: Types.FrameNativeProps = {
			Name = "Row",
			BackgroundTransparency = 1,
			Size = D2.fromScale(1, 0),
			AutomaticSize = E.AutomaticSize.Y,
			SelectionGroup = true,
		}
		for _, side in
			{ "SelectionBehaviorUp", "SelectionBehaviorDown", "SelectionBehaviorLeft", "SelectionBehaviorRight" }
		do
			(rowProps :: { [unknown]: unknown })[side] = function(use: ComposeTypes.Use): Enum.SelectionBehavior
				return if use(entered) then E.SelectionBehavior.Stop else E.SelectionBehavior.Escape
			end
		end
		for _, child in rowChildren do
			rowProps[#rowProps + 1] = child
		end
		rowProps.ZIndex = 2
		local function tuck(use: ComposeTypes.Use): number
			return 2 * ctx.metric("radii.panel", use)
		end
		if reveal == "automatic" then
			local function side(use: ComposeTypes.Use): UDim
				return D.new(0, ctx.metric("space.s", use))
			end
			rowProps[#rowProps + 1] = Host.UIPadding({
				PaddingLeft = side,
				PaddingRight = side,
				PaddingTop = function(use: ComposeTypes.Use): UDim
					return D.new(0, ctx.metric("space.s", use) + tuck(use))
				end,
				PaddingBottom = side,
			})
		end
		local row = Host.Frame(rowProps)
		local plateLayer = ctx.styled(
			Host.Frame({
				Name = "Plate",
				Size = D2.fromScale(1, 1),
				Visible = reveal == "automatic" and (primary ~= nil or menu ~= nil),
			}),
			"panel"
		)
		local plate = ctx.fade {
			Name = "Reveal",
			LayoutOrder = 2,
			ZIndex = 0,
			BackgroundTransparency = 1,
			Size = D2.fromScale(1, 0),
			AutomaticSize = E.AutomaticSize.Y,
			Interactable = revealed,
			GroupTransparency = function(use: ComposeTypes.Use): number
				if reduced(use) then
					return if use(revealed) then 0 else 1
				end
				return 1 - use(fade)
			end,
			plateLayer :: Types.Child,
			row :: Types.Child,
		}
		local liftScale = Host.UIScale({ Name = "Lift", Scale = scale })
		local card = Host.Frame(ctx.props(spec, {
			"image",
			"artwork",
			"title",
			"caption",
			"imageAspectRatio",
			"imageFraming",
			"onActivate",
			"primaryAction",
			"menu",
			"reveal",
			"browseTarget",
			"enabled",
			"controls",
			"ringTarget",
		}, {
			Name = "Card",
			BackgroundTransparency = 1,
			Size = D2.fromScale(1, 0),
			AutomaticSize = E.AutomaticSize.Y,
			MouseEnter = function()
				hovered:set(true)
			end,
			MouseLeave = function()
				hovered:set(false)
			end,
			Attributes = {
				FacetReveal = checks.attribute(reveal),
				FacetRevealed = checks.attribute(revealed),
				FacetEngaged = checks.attribute(engaged),
				FacetLifting = checks.attribute(lifting),
				FacetHovered = checks.attribute(hovered),
				FacetFocusWithin = checks.attribute(focusWithin),
				FacetPressing = checks.attribute(pressing),
				FacetBrowsing = checks.attribute(browsing),
				FacetEntered = checks.attribute(entered),
				FacetMenuOpen = checks.attribute(menuOpen),
				FacetBody = checks.attribute(if spec.onActivate then "button" else "informational"),
			} :: Types.Attributes,
			Host.UIListLayout({
				FillDirection = E.FillDirection.Vertical,
				SortOrder = E.SortOrder.LayoutOrder,
				Padding = function(use: ComposeTypes.Use)
					return D.new(0, if reveal == "always" then ctx.metric("space.s", use) else -tuck(use))
				end,
			}) :: Types.Child,
			liftScale :: Types.Child,
			body :: Types.Child,
			plate :: Types.Child,
		}))
		root = card
		local extent = ctx.observe.AbsoluteSize(card)
		if spec.onActivate then
			local bodyExtent = ctx.observe.AbsoluteSize(body)
			local ringed = if spec.ringTarget == "media" then ctx.observe.AbsoluteSize(artwork) else extent
			local ratio = Compose.formula(function(use: ComposeTypes.Use): number
				local bodyHeight = use(bodyExtent).Y
				return if bodyHeight > 0 then use(ringed).Y / bodyHeight else 1
			end)
			Compose.watch(function(use: ComposeTypes.Use)
				body:SetAttribute("FacetFocusHeight", use(ratio))
			end)
		end
		if (spec :: { [unknown]: unknown }).Position == nil then
			runtime.decorate(card, {
				AnchorPoint = function(use: ComposeTypes.Use): Vector2
					local factor = math.max(use(scale), 0.001)
					local anchor = read(spec.AnchorPoint, use) or ctx.types.Vector2.new(0, 0)
					local growth = (1 - 1 / factor) / 2
					return anchor + ctx.types.Vector2.new(growth, growth)
				end,
			})
		end
		local revealExtent = Compose.formula(function(use: ComposeTypes.Use): { body: number }
			return { body = use(extent).Y }
		end)
		if spec.controls then
			spec.controls.revealExtent = revealExtent
		end
		Compose.watch(function(use: ComposeTypes.Use)
			if not enabled(use) and entered:peek() then
				leaveActions()
			end
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			local node = use(selected)
			if entered:peek() and not menuOpen:peek() and node ~= nil and not within(node, card) then
				entered:set(false)
			end
		end)
		if spec.browseTarget then
			local browseTarget = spec.browseTarget
			local attachedTo: Instance? = nil
			local stopScale: (() -> ())? = nil
			Compose.watch(function(use: ComposeTypes.Use)
				use(selected)
				local target = browseTarget()
				if target == attachedTo then
					return
				end
				if stopScale then
					stopScale()
					stopScale = nil
				end
				attachedTo = target
				if target then
					stopScale = runtime.mount(function()
						return Host.UIScale({ Name = "CardLift", Scale = scale })
					end, target)
				end
			end)
			Compose.cleanup(function()
				if stopScale then
					stopScale()
				end
			end)
		end
		if primary or menu then
			ctx.action(card, "CardCancel", { E.KeyCode.Escape, E.KeyCode.ButtonB }, function(use: ComposeTypes.Use)
				return use(entered) and not use(menuOpen)
			end, leaveActions, { priority = 1500 })
		end
		if input then
			runtime.connect(input, "InputBegan", function(event: InputObject)
				if not entered:peek() or menuOpen:peek() then
					return
				end
				if
					event.UserInputType ~= E.UserInputType.MouseButton1
					and event.UserInputType ~= E.UserInputType.Touch
				then
					return
				end
				local at, size, point = card.AbsolutePosition, card.AbsoluteSize, event.Position
				if point.X < at.X or point.Y < at.Y or point.X > at.X + size.X or point.Y > at.Y + size.Y then
					entered:set(false)
				end
			end)
		end
		Compose.cleanup(function()
			if entered:peek() and gui and within(gui.SelectedObject, card) then
				entered:set(false)
				local target = if spec.browseTarget then spec.browseTarget() else nil
				gui.SelectedObject = if target and target.Parent and not within(target, card) then target else nil
			end
		end)
		return card
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="11">
            <Properties>
              <string name="Name">civil_date</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./civil_date_types")
local freeze = require("./freeze")
export type CivilDate = Types.CivilDate
export type Range = Types.Range
export type Locale = Types.Locale
export type Module = Types.Module
local civil_date = {} :: Module

local english: Locale = {
	months = table.freeze({
		"January",
		"February",
		"March",
		"April",
		"May",
		"June",
		"July",
		"August",
		"September",
		"October",
		"November",
		"December",
	}),
	weekdays = table.freeze({ "Su", "Mo", "Tu", "We", "Th", "Fr", "Sa" }),
	order = "mdy",
	separator = "/",
	hourCycle = 12,
}
civil_date.ENGLISH = freeze(english)

local function int(v: unknown): boolean
	return type(v) == "number" and v == v and v % 1 == 0 and math.abs(v) < 2 ^ 31
end

function civil_date.isLeap(year: number): boolean
	return (year % 4 == 0 and year % 100 ~= 0) or year % 400 == 0
end

local LENGTHS = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }
function civil_date.daysIn(year: number, month: number): number
	return if month == 2 and civil_date.isLeap(year) then 29 else LENGTHS[month]
end

function civil_date.problem(value: unknown, withTime: boolean?): string?
	if type(value) ~= "table" then
		return "is a { year, month, day } table"
	end
	local fields = value :: { [string]: unknown }
	if not (int(fields.year) and int(fields.month) and int(fields.day)) then
		return "has whole-number year, month and day"
	end
	if (fields.hour ~= nil and not int(fields.hour)) or (fields.minute ~= nil and not int(fields.minute)) then
		return "has an hour 0..23 and a minute 0..59"
	end
	local d = value :: CivilDate
	if d.month < 1 or d.month > 12 or d.day < 1 or d.day > civil_date.daysIn(d.year, d.month) then
		return `names no calendar day ({d.year}-{d.month}-{d.day})`
	end
	if (d.hour == nil) ~= (d.minute == nil) then
		return "gives hour and minute together or neither"
	end
	local hour, minute = d.hour, d.minute
	if hour ~= nil and minute ~= nil and not (hour >= 0 and hour < 24 and minute >= 0 and minute < 60) then
		return "has an hour 0..23 and a minute 0..59"
	end
	if withTime == true and d.hour == nil then
		return "carries hour and minute when `time = true`"
	end
	return nil
end

function civil_date.toDays(d: CivilDate): number
	local y = if d.month <= 2 then d.year - 1 else d.year
	local era = (if y >= 0 then y else y - 399) // 400
	local yoe = y - era * 400
	local mp = (d.month + 9) % 12
	local doy = (153 * mp + 2) // 5 + d.day - 1
	local doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
	return era * 146097 + doe - 719468
end

function civil_date.fromDays(n: number): CivilDate
	local z = n + 719468
	local era = (if z >= 0 then z else z - 146096) // 146097
	local doe = z - era * 146097
	local yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
	local doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
	local mp = (5 * doy + 2) // 153
	local day = doy - (153 * mp + 2) // 5 + 1
	local month = if mp < 10 then mp + 3 else mp - 9
	return { year = yoe + era * 400 + (if month <= 2 then 1 else 0), month = month, day = day }
end

function civil_date.dateOf(d: CivilDate): CivilDate
	return { year = d.year, month = d.month, day = d.day }
end

function civil_date.addDays(d: CivilDate, n: number): CivilDate
	local out = civil_date.fromDays(civil_date.toDays(d) + n)
	out.hour, out.minute = d.hour, d.minute
	return out
end

function civil_date.addMonths(d: CivilDate, n: number): CivilDate
	local index = d.year * 12 + (d.month - 1) + n
	local year, month = index // 12, index % 12 + 1
	return {
		year = year,
		month = month,
		day = math.min(d.day, civil_date.daysIn(year, month)),
		hour = d.hour,
		minute = d.minute,
	}
end

function civil_date.compare(a: CivilDate, b: CivilDate): number
	local x, y = civil_date.toDays(a), civil_date.toDays(b)
	return if x < y then -1 elseif x > y then 1 else 0
end

function civil_date.same(a: CivilDate?, b: CivilDate?): boolean
	if a == nil or b == nil then
		return a == b
	end
	return a.year == b.year and a.month == b.month and a.day == b.day and a.hour == b.hour and a.minute == b.minute
end

function civil_date.weekday(d: CivilDate): number
	return (civil_date.toDays(d) + 4) % 7 + 1
end

function civil_date.monthGrid(year: number, month: number, weekStart: number): { CivilDate }
	local first: CivilDate = { year = year, month = month, day = 1 }
	local lead = (civil_date.weekday(first) - weekStart) % 7
	local start = civil_date.toDays(first) - lead
	local out = {}
	for i = 0, 41 do
		table.insert(out, civil_date.fromDays(start + i))
	end
	return out
end

function civil_date.within(d: CivilDate, min: CivilDate?, max: CivilDate?): boolean
	return (min == nil or civil_date.compare(d, min) >= 0) and (max == nil or civil_date.compare(d, max) <= 0)
end

function civil_date.clampRange(range: Range, min: CivilDate?, max: CivilDate?): Range?
	local s, f = range.start, range.finish
	if s == nil or f == nil then
		return range
	end
	if (max ~= nil and civil_date.compare(s, max) > 0) or (min ~= nil and civil_date.compare(f, min) < 0) then
		return nil
	end
	if min ~= nil and civil_date.compare(s, min) < 0 then
		s = civil_date.dateOf(min)
	end
	if max ~= nil and civil_date.compare(f, max) > 0 then
		f = civil_date.dateOf(max)
	end
	return { start = s, finish = f }
end

function civil_date.fromUnix(seconds: number, offsetMinutes: number): CivilDate
	local local_ = math.floor(seconds) + offsetMinutes * 60
	local days = local_ // 86400
	local rest = local_ - days * 86400
	local out = civil_date.fromDays(days)
	out.hour = rest // 3600
	out.minute = (rest % 3600) // 60
	return out
end

function civil_date.toUnix(d: CivilDate, offsetMinutes: number): number
	return civil_date.toDays(d) * 86400 + ((d.hour or 0) * 60 + (d.minute or 0) - offsetMinutes) * 60
end

function civil_date.systemClock(offsetMinutes: number?): () -> CivilDate
	return function(): CivilDate
		local engine = (DateTime :: unknown) :: typeof(DateTime)?
		if offsetMinutes ~= nil or engine == nil then
			local seconds = if engine ~= nil then engine.now().UnixTimestamp else os.time()
			if offsetMinutes ~= nil then
				return civil_date.fromUnix(seconds, offsetMinutes)
			end
			local t = os.date("*t", seconds)
			return { year = t.year, month = t.month, day = t.day, hour = t.hour, minute = t.min }
		end
		local t = (engine.now():ToLocalTime() :: unknown) :: { [string]: number }
		return { year = t.Year, month = t.Month, day = t.Day, hour = t.Hour, minute = t.Minute }
	end
end

local function pad(n: number, width: number): string
	return string.format(`%0{width}d`, n)
end

function civil_date.formatTime(d: CivilDate, hourCycle: number): string
	if d.hour == nil then
		return ""
	end
	local minute = pad(d.minute :: number, 2)
	if hourCycle == 24 then
		return `{pad(d.hour, 2)}:{minute}`
	end
	local h = (d.hour :: number) % 12
	return `{if h == 0 then 12 else h}:{minute} {if (d.hour :: number) < 12 then "AM" else "PM"}`
end

function civil_date.format(d: CivilDate, locale: Locale?): string
	local l: Locale = locale or civil_date.ENGLISH
	local order = l.order or "mdy"
	local sep = l.separator or "/"
	local fields: { [string]: string } = {
		m = pad(d.month, 2),
		d = pad(d.day, 2),
		y = pad(d.year, 4),
	}
	local out = fields[string.sub(order, 1, 1)]
		.. sep
		.. fields[string.sub(order, 2, 2)]
		.. sep
		.. fields[string.sub(order, 3, 3)]
	if d.hour ~= nil then
		out ..= " " .. civil_date.formatTime(d, l.hourCycle or 12)
	end
	return out
end

function civil_date.parse(text: string, locale: Locale?, withTime: boolean?): (CivilDate?, string?)
	local l: Locale = locale or civil_date.ENGLISH
	local order = l.order or "mdy"
	local a, b, c, rest = string.match(text, "^%s*(%d+)%D(%d+)%D(%d+)(.*)$")
	if a == nil then
		return nil, "Enter a date like " .. civil_date.format({ year = 2026, month = 12, day = 31 }, l)
	end
	local texts = { a, b :: string, c :: string }
	local parts: { [string]: number } = {}
	local names: { [string]: string } = { m = "month", d = "day", y = "year" }
	for i = 1, 3 do
		local field = names[string.sub(order, i, i)]
		if field == "year" and #texts[i] < 4 then
			return nil, "Enter a date like " .. civil_date.format({ year = 2026, month = 12, day = 31 }, l)
		end
		parts[field] = tonumber(texts[i]) :: number
	end
	local d: CivilDate = { year = parts.year, month = parts.month, day = parts.day }
	local trailing: string = string.gsub(rest or "", "^%s+", "")
	trailing = string.gsub(trailing, "%s+$", "")
	if trailing ~= "" then
		local h, m, meridiem = string.match(string.upper(trailing), "^(%d%d?):(%d%d)%s*([AP]?M?)$")
		if h == nil then
			return nil, "Enter a time like 9:30 AM or 21:30."
		end
		local hour, minute = tonumber(h) :: number, tonumber(m) :: number
		if meridiem == "AM" or meridiem == "PM" then
			if hour < 1 or hour > 12 then
				return nil, "A 12-hour time runs from 1 to 12."
			end
			hour = hour % 12 + (if meridiem == "PM" then 12 else 0)
		elseif meridiem ~= "" then
			return nil, "Enter a time like 9:30 AM or 21:30."
		elseif (l.hourCycle or 12) == 12 and hour >= 1 and hour <= 12 then
			return nil, "Add AM or PM, or write the 24-hour time like 21:30."
		end
		d.hour, d.minute = hour, minute
	elseif withTime == true then
		return nil, "Add a time, like 9:30 AM."
	end
	local why = civil_date.problem(d)
	if why ~= nil then
		return nil, "That date is not on the calendar."
	end
	return d, nil
end

return (table.freeze(civil_date) :: unknown) :: Module
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="12">
            <Properties>
              <string name="Name">civil_date_types</string>
              <string name="Source"><![CDATA[--!strict
export type CivilDate = { year: number, month: number, day: number, hour: number?, minute: number? }
export type Range = { start: CivilDate?, finish: CivilDate? }
export type Order = "mdy" | "dmy" | "ymd"
export type Locale = {
	months: { string }?,
	weekdays: { string }?,
	order: Order?,
	separator: string?,
	hourCycle: number?,
}
export type Module = {
	ENGLISH: Locale,
	isLeap: (number) -> boolean,
	daysIn: (number, number) -> number,
	problem: (unknown, boolean?) -> string?,
	toDays: (CivilDate) -> number,
	fromDays: (number) -> CivilDate,
	dateOf: (CivilDate) -> CivilDate,
	addDays: (CivilDate, number) -> CivilDate,
	addMonths: (CivilDate, number) -> CivilDate,
	compare: (CivilDate, CivilDate) -> number,
	same: (CivilDate?, CivilDate?) -> boolean,
	weekday: (CivilDate) -> number,
	monthGrid: (number, number, number) -> { CivilDate },
	within: (CivilDate, CivilDate?, CivilDate?) -> boolean,
	clampRange: (Range, CivilDate?, CivilDate?) -> Range?,
	fromUnix: (number, number) -> CivilDate,
	toUnix: (CivilDate, number) -> number,
	systemClock: (number?) -> () -> CivilDate,
	formatTime: (CivilDate, number) -> string,
	format: (CivilDate, Locale?) -> string,
	parse: (string, Locale?, boolean?) -> (CivilDate?, string?),
}
return {}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="13">
            <Properties>
              <string name="Name">collection_fling</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local State = require("./collection_state")
local FLING_MINIMUM = 200
local FLING_STOP = 20
local FLING_WINDOW = 0.1
return function<V, K>(ctx: Types.Context, view: State.View<V, K>, root: ScrollingFrame): ()
	local runtime = ctx.runtime
	local V2, E = ctx.types.Vector2, ctx.types.Enum
	local gui = ctx.config.guiService
	local spec, frames = view.spec, view.frames
	local input = ctx.config.userInputService
	if view.horizontal and input and not spec.reorderable then
		local pressAt: number? = nil
		local startOffset, dragging = 0, false
		local samples: { Vector2 } = {}
		local velocity = 0
		local stopFling: (() -> ())? = nil
		local function halt(): ()
			if stopFling then
				stopFling()
				stopFling = nil
			end
		end
		ctx.Compose.cleanup(halt)
		local function limit(): number
			return math.max(0, root.CanvasSize.X.Offset - root.AbsoluteWindowSize.X)
		end
		local function items(): Instance?
			return root:FindFirstChild("Items")
		end
		local function inside(position: Vector3): boolean
			local point = V2.new(position.X, position.Y)
			local layer = root:FindFirstAncestorWhichIsA("LayerCollector")
			if layer and layer:IsA("ScreenGui") and layer.IgnoreGuiInset and gui then
				point += gui:GetGuiInset()
			end
			local at, size = root.AbsolutePosition, root.AbsoluteSize
			return point.X >= at.X and point.Y >= at.Y and point.X <= at.X + size.X and point.Y <= at.Y + size.Y
		end
		runtime.connect(input, "InputBegan", function(value: InputObject)
			if
				value.UserInputType == E.UserInputType.MouseButton1
				and inside(value.Position)
				and ctx.available(root)
			then
				halt()
				pressAt, startOffset, dragging = value.Position.X, root.CanvasPosition.X, false
				samples = { V2.new(frames.now(), value.Position.X) }
			end
		end)
		runtime.connect(input, "InputChanged", function(value: InputObject)
			if pressAt == nil or value.UserInputType ~= E.UserInputType.MouseMovement then
				return
			end
			local travel = value.Position.X - pressAt
			if not dragging and math.abs(travel) >= 6 then
				dragging = true
				local node = items()
				if node and node:IsA("GuiObject") then
					node.Interactable = false
				end
			end
			local now = frames.now()
			table.insert(samples, V2.new(now, value.Position.X))
			while #samples > 2 and now - samples[1].X > FLING_WINDOW do
				table.remove(samples, 1)
			end
			if dragging then
				root.CanvasPosition = V2.new(math.clamp(startOffset - travel, 0, limit()), root.CanvasPosition.Y)
			end
		end)
		runtime.connect(input, "InputEnded", function(value: InputObject)
			if value.UserInputType ~= E.UserInputType.MouseButton1 or pressAt == nil then
				return
			end
			pressAt = nil
			if dragging then
				dragging = false
				local stop: (() -> ())? = nil
				stop = frames.onFrame(function()
					if stop then
						stop()
					end
					local node = items()
					if node and node:IsA("GuiObject") then
						node.Interactable = true
					end
				end)
				local first, last = samples[1], samples[#samples]
				local span = last.X - first.X
				velocity = if span > 0 then (first.Y - last.Y) / span else 0
				if frames.now() - last.X < FLING_WINDOW and math.abs(velocity) > FLING_MINIMUM then
					local friction = ctx.metric("motion.fling.friction")
					stopFling = frames.onFrame(function(step: number)
						velocity *= math.exp(-friction * step)
						local at = root.CanvasPosition.X
						local nextX = math.clamp(at + velocity * step, 0, limit())
						root.CanvasPosition = V2.new(nextX, root.CanvasPosition.Y)
						if math.abs(velocity) < FLING_STOP or nextX == at then
							halt()
						end
					end)
				end
			end
		end)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="14">
            <Properties>
              <string name="Name">collection_focus</string>
              <string name="Source"><![CDATA[--!strict
local activation = require("./activation")
local reorder = require("./collection_reorder")
local policy = require("./collection_policy")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local State = require("./collection_state")
return function<V, K>(
	ctx: Types.Context,
	view: State.View<V, K>,
	editor: reorder.Editor<V, K>?,
	root: ScrollingFrame,
	setOffset: (number) -> ()
): (ComposeTypes.FocusScope<K>, (ComposeTypes.Use) -> boolean)
	local Compose = ctx.Compose
	local read = ctx.read
	local readSource = ctx.readSource
	local observe = ctx.observe
	local E = ctx.types.Enum
	local gui = ctx.config.guiService
	local input = ctx.config.userInputService
	local belongsTo, findSelectable = State.belongsTo, State.findSelectable
	local spec, kind, keyOf, tree = view.spec, view.kind, view.keyOf, view.tree
	local source, viewport, mountedVersion = view.source, view.viewport, view.mountedVersion
	local status, controls = view.status, view.controls
	local horizontal, focusActive = view.horizontal, view.focusActive
	local mounted = view.mounted
	local restoring = false
	local focusGeometry = Compose.formula(function(use: ComposeTypes.Use)
		use(mountedVersion)
		for _, placement in view.placed do
			use(placement)
		end
		local current = use(status)
		if current.total == 0 then
			return ""
		end
		local at = assert(controls.placementOf)(math.max(1, current.total or 1))
		return table.concat({
			tostring(current.extent),
			tostring(current.rowCount),
			tostring(current.total),
			tostring(at.column),
			tostring(at.crossSize),
			tostring(at.crossOffset),
		}, ":")
	end)
	local focusScope = Compose.createFocusScope({
		from = function(use: ComposeTypes.Use)
			if not use(focusActive) then
				return view.noFocusCandidates
			end
			if kind == "list" then
				return source(use)
			end
			use(focusGeometry)
			use(view.cross)
			use(view.measured)
			read(spec.measured, use)
			read(spec.columns, use)
			read(spec.itemSize, use)
			read(spec.gap, use)
			return source(use)
		end,
		key = keyOf,
		disabled = function(item)
			return (tree ~= nil and not tree.visible(keyOf(item, 1))) or policy.disabled(spec.disabled, item)
		end,
		initial = spec.initialFocus,
		autoFocus = spec.autoFocus,
		wrap = spec.wrapFocus,
		position = function(_, index)
			if kind == "list" then
				return if horizontal then index else 0, if horizontal then 0 else index
			end
			local current = status:peek()
			if current == nil or current.total == nil or current.total == 0 then
				return 0, 0
			end
			local at = assert(controls.placementOf)(math.min(index, current.total))
			return if horizontal then at.offset else at.crossOffset, if horizontal then at.crossOffset else at.offset
		end,
	})
	view.scope = focusScope
	local knownKeys: { K } = {}
	local priorKeys: { K } = {}
	local function liveKeys(rows: { V }?): ({ K }, { [K]: boolean })
		local keys, present = {}, {}
		local list: { V } = rows or {}
		for index, item in list do
			local key = keyOf(item, index)
			table.insert(keys, key)
			if not policy.disabled(spec.disabled, item) then
				present[key] = true
			end
		end
		return keys, present
	end
	Compose.watch(function(use: ComposeTypes.Use)
		local keys = liveKeys(source(use))
		priorKeys, knownKeys = knownKeys, keys
	end)
	local function peekRows(): { V }
		return source(function<T>(value: ComposeTypes.Readable<T>): T
			return value:peek()
		end)
	end
	local function neighbourOf(lost: K): K?
		local ancestor = if tree then tree.ancestor(lost) else nil
		if ancestor ~= nil then
			return ancestor
		end
		local keys, present = liveKeys(peekRows())
		if table.find(keys, lost) then
			return nil
		end
		local before = if table.find(knownKeys, lost) then knownKeys else priorKeys
		local at = table.find(before, lost)
		if at == nil then
			return nil
		end
		for index = at + 1, #before do
			if present[before[index]] then
				return before[index]
			end
		end
		for index = at - 1, 1, -1 do
			if present[before[index]] then
				return before[index]
			end
		end
		return nil
	end
	local focusPolicy = spec.focusPolicy or "key"
	assert(focusPolicy == "key" or focusPolicy == "index", "Facet collection focusPolicy must be key or index")
	if focusPolicy == "index" then
		local slot: number? = nil
		local function indexOf(rows: { V }, wanted: K): number?
			for index, item in rows do
				if keyOf(item, index) == wanted then
					return index
				end
			end
			return nil
		end
		Compose.watch(function(use: ComposeTypes.Use)
			local key = use(focusScope.current)
			slot = if key ~= nil then indexOf(peekRows(), key) else nil
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			local rows = source(use)
			local key = focusScope.current:peek()
			if key == nil or slot == nil or (editor and editor.busy()) or indexOf(rows, key) == slot then
				return
			end
			local at = math.min(slot :: number, #rows)
			if rows[at] ~= nil and not policy.disabled(spec.disabled, rows[at]) then
				focusScope.focus(keyOf(rows[at], at))
			end
		end)
	end
	local lastFocused: K? = nil
	Compose.watch(function(use: ComposeTypes.Use)
		local key = use(focusScope.current)
		local lost = lastFocused
		lastFocused = key
		if lost == nil or key == lost or not view.focusOwned then
			return
		end
		local neighbour = neighbourOf(lost)
		if neighbour ~= nil and neighbour ~= key then
			focusScope.focus(neighbour)
		end
	end)
	if spec.focus then
		spec.focus.current = focusScope.current
		spec.focus.focus = focusScope.focus
		spec.focus.clear = focusScope.clear
		spec.focus.next = focusScope.next
		spec.focus.previous = focusScope.previous
		spec.focus.move = focusScope.move
		spec.focus.first = focusScope.first
		spec.focus.last = focusScope.last
		spec.focus.isFocused = focusScope.isFocused
	end
	if tree then
		tree.bind(root, focusScope)
	end
	local parent = observe.Parent(root)
	local focusPosition = observe.AbsolutePosition(root)
	local focusSize = observe.AbsoluteSize(root)
	local function restoreFocus(key: K?): ()
		if
			gui == nil
			or root.Parent == nil
			or not view.focusOwned
			or key == nil
			or mounted[key] == nil
			or not belongsTo(mounted[key], root)
		then
			return
		end
		local node = findSelectable(assert(mounted[key]), view.focusedPath, 1)
		if node and policy.selectionVisible(node) then
			restoring = true
			pcall(function()
				gui.SelectedObject = node
			end)
			restoring = false
		end
	end
	local ready = Compose.formula(function(use: ComposeTypes.Use)
		local current = use(status)
		return current.total > 0
	end)
	Compose.watch(function(use: ComposeTypes.Use)
		use(ready)
		local key = use(focusScope.current)
		if key == nil then
			return
		end
		view.focusOwned = true
		local currentStatus = status:peek()
		local index = if currentStatus.total > 0 then assert(controls.indexOfKey)(key) else nil
		if index then
			local at, current = assert(controls.placementOf)(index), viewport:peek()
			if at.offset < current.offset then
				setOffset(assert(controls.offsetOf)(index, "start", current.size))
			elseif at.offset + at.size > current.offset + current.size then
				setOffset(assert(controls.offsetOf)(index, "end", current.size))
			end
		end
		restoreFocus(key)
	end)
	Compose.watch(function(use: ComposeTypes.Use)
		use(mountedVersion)
		use(parent)
		use(focusPosition)
		use(focusSize)
		restoreFocus(focusScope.current:peek())
	end)
	local selected: ComposeTypes.Cell<GuiObject?> = if gui
		then observe.SelectedObject(gui)
		else Compose.cell(nil :: GuiObject?)
	Compose.watch(function(use: ComposeTypes.Use)
		local field = use(selected)
		if
			field == nil
			or not field:IsA("TextBox")
			or not belongsTo(field, root)
			or read(spec.ScrollingEnabled, use) == false
		then
			return
		end
		local current = use(viewport)
		if current.size <= 0 then
			return
		end
		use(status)
		for key, node in mounted do
			if node and field:IsDescendantOf(node) then
				local index = assert(controls.indexOfKey)(key)
				local at = index and assert(controls.placementOf)(index)
				if at and at.offset < current.offset then
					setOffset(at.offset)
				elseif at and at.offset + at.size > current.offset + current.size then
					setOffset(math.max(at.offset, at.offset + at.size - current.size))
				end
				break
			end
		end
	end)
	local function renameAction(use: ComposeTypes.Use?): activation.EditAction?
		readSource(mountedVersion, use)
		local focused = readSource(selected, use)
		if
			(focused and not belongsTo(focused, root))
			or not readSource(focusActive, use)
			or (editor and editor.busy())
			or (input and input.GetFocusedTextBox and input:GetFocusedTextBox())
		then
			return nil
		end
		local key: K? = nil
		for candidate in readSource(view.selection, use) do
			if key ~= nil then
				return nil
			end
			key = candidate
		end
		key = key or readSource(focusScope.current, use)
		local edits = if key ~= nil then view.cellEdits[key] else nil
		if edits then
			for _, action in edits do
				if action.enabled(use) then
					return action
				end
			end
		end
		return nil
	end
	ctx.action(root, "RenameCell", { E.KeyCode.F2 }, function(use: ComposeTypes.Use): boolean
		return renameAction(use) ~= nil
	end, function()
		local action = renameAction()
		if action then
			action.onActivate()
		end
	end)
	Compose.watch(function(use: ComposeTypes.Use)
		local node = use(selected)
		if node and not restoring then
			if belongsTo(node, root) then
				focusActive:set(true)
				for key, row in mounted do
					if row and belongsTo(node, row) then
						local neighbour = neighbourOf(key)
						if neighbour ~= nil then
							view.focusOwned = true
							focusScope.focus(neighbour)
							restoreFocus(neighbour)
						end
						break
					end
				end
			else
				local lost = lastFocused or focusScope.current:peek()
				local neighbour = if view.focusOwned and lost ~= nil then neighbourOf(lost) else nil
				if neighbour ~= nil and mounted[neighbour] then
					focusScope.focus(neighbour)
					restoreFocus(neighbour)
				else
					view.focusOwned = false
				end
			end
		end
	end)
	Compose.watch(function(use: ComposeTypes.Use)
		use(mountedVersion)
		if gui == nil or use(selected) ~= root then
			return
		end
		local target: GuiObject? = nil
		local key = focusScope.current:peek()
		if key ~= nil and mounted[key] then
			target = findSelectable(assert(mounted[key]), nil, 1)
		end
		if target == nil then
			local rows: { V } = read(spec.from) or {}
			for index, item in rows do
				local candidate = keyOf(item, index)
				if mounted[candidate] and not policy.disabled(spec.disabled, item) then
					target = findSelectable(assert(mounted[candidate]), nil, 1)
					if target then
						break
					end
				end
			end
		end
		if target and policy.selectionVisible(target) then
			gui.SelectedObject = target
		end
	end)
	local function eligible(use: ComposeTypes.Use): boolean
		local node = readSource(selected, use)
		if node == nil or not belongsTo(node, root) then
			return false
		end
		local input = ctx.config.userInputService
		return not (input and input:GetFocusedTextBox()) and not (node:IsA("TextBox") and node:IsFocused())
	end
	return focusScope, eligible
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="15">
            <Properties>
              <string name="Name">collection_navigation</string>
              <string name="Source"><![CDATA[--!strict
local policy = require("./collection_policy")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local State = require("./collection_state")
return function<V, K>(
	ctx: Types.Context,
	view: State.View<V, K>,
	root: ScrollingFrame,
	focusScope: ComposeTypes.FocusScope<K>,
	eligible: (ComposeTypes.Use) -> boolean
): ()
	local read = ctx.read
	local E = ctx.types.Enum
	local spec, kind, keyOf, horizontal = view.spec, view.kind, view.keyOf, view.horizontal
	local extendSelection = view.extendSelection
	local directions: { { name: string, direction: ComposeTypes.FocusDirection, keys: { Enum.KeyCode } } } = {
		{ name = "Left", direction = "left", keys = { E.KeyCode.Left, E.KeyCode.DPadLeft } },
		{ name = "Right", direction = "right", keys = { E.KeyCode.Right, E.KeyCode.DPadRight } },
		{ name = "Up", direction = "up", keys = { E.KeyCode.Up, E.KeyCode.DPadUp } },
		{ name = "Down", direction = "down", keys = { E.KeyCode.Down, E.KeyCode.DPadDown } },
	}
	local function atEdge(key: K, step: number): boolean
		local rows = read(spec.from)
		local at: number? = nil
		for index, item in rows do
			if keyOf(item, index) == key then
				at = index
				break
			end
		end
		if at == nil then
			return false
		end
		local index = at + step
		while index >= 1 and index <= #rows do
			if not policy.disabled(spec.disabled, rows[index]) then
				return false
			end
			index += step
		end
		return true
	end
	local function wrapStep(direction: ComposeTypes.FocusDirection): number
		local along = if kind == "grid"
			then true
			elseif horizontal then direction == "left" or direction == "right"
			else direction == "up" or direction == "down"
		if not along then
			return 0
		end
		return if direction == "right" or direction == "down" then 1 else -1
	end
	for _, binding in directions do
		local along = binding.direction == (if horizontal then "left" else "up")
			or binding.direction == (if horizontal then "right" else "down")
		local function enabled(use: ComposeTypes.Use): boolean
			return (along or kind == "grid") and eligible(use)
		end
		ctx.action(root, "Collection" .. binding.name, binding.keys, enabled, function()
			local before = focusScope.current:peek()
			local after = focusScope.move(binding.direction)
			if kind == "grid" and spec.wrapFocus and before ~= nil and after == before then
				local rows = read(spec.from)
				local columns = math.max(1, math.floor(read(spec.columns or 1)))
				local at: number? = nil
				for index, item in rows do
					if keyOf(item, index) == before then
						at = index
						break
					end
				end
				if at ~= nil then
					local column = (at - 1) % columns
					local rowStart = at - column
					local rowEnd = math.min(rowStart + columns - 1, #rows)
					local target = if binding.direction == "right"
						then rowStart
						elseif binding.direction == "left" then rowEnd
						elseif binding.direction == "down" then column + 1
						else column + 1 + math.floor((#rows - 1 - column) / columns) * columns
					if target ~= at and rows[target] ~= nil then
						focusScope.focus(keyOf(rows[target], target))
					end
				end
				return
			end
			local step = if spec.wrapFocus and before ~= nil and after == before then wrapStep(binding.direction) else 0
			if step ~= 0 and not atEdge(assert(before), step) then
				step = 0
			end
			if step > 0 then
				focusScope.next()
			elseif step < 0 then
				focusScope.previous()
			end
			local landed = focusScope.current:peek()
			if landed ~= nil then
				extendSelection(before, landed)
			end
		end, { priority = 200 })
	end
	local function jump(move: () -> ()): () -> ()
		return function()
			local before = focusScope.current:peek()
			move()
			local landed = focusScope.current:peek()
			if landed ~= nil then
				extendSelection(before, landed)
			end
		end
	end
	ctx.action(root, "CollectionFirst", { E.KeyCode.Home }, eligible, jump(focusScope.first), { priority = 200 })
	ctx.action(root, "CollectionLast", { E.KeyCode.End }, eligible, jump(focusScope.last), { priority = 200 })
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="16">
            <Properties>
              <string name="Name">collection_paint</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local ComposeTypes = require("../vendor/compose/core")

return function(ctx: Types.Context, root: GuiObject): ComposeTypes.Readable<boolean>
	local size = ctx.observe.AbsoluteSize(root)
	local ready = ctx.Compose.cell(false)
	local owner = assert(ctx.Compose.currentOwner())
	local scope: ComposeTypes.Owner? = nil
	ctx.Compose.watch(function(use: ComposeTypes.Use)
		local box = use(size)
		if box.X <= 0 or box.Y <= 0 then
			if scope then
				scope.dispose()
				scope = nil
			end
			ready:set(false)
		end
		if scope then
			return
		end
		local nextScope = owner.createChild()
		scope = nextScope
		ctx.Compose.withOwner(nextScope, function()
			local function sample(): boolean
				local box = root.AbsoluteSize
				if box.X <= 0 or box.Y <= 0 then
					return false
				end
				local filled = true
				for _, node in root:GetDescendants() do
					if node:IsA("GuiObject") then
						local visible = node.Visible
						local parent = node.Parent
						while visible and parent and parent ~= root do
							if parent:IsA("GuiObject") then
								visible = parent.Visible
							end
							parent = parent.Parent
						end
						if visible then
							filled = filled
								and node:GetAttribute("FacetBuilt") ~= false
								and (not node:IsA("ViewportFrame") or node:GetAttribute("FacetMediaReady") ~= false)
							if
								(node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox"))
								and node.Text ~= ""
								and node.TextTransparency < 1
							then
								filled = filled
									and node.AbsoluteSize.X > 0
									and node.AbsoluteSize.Y > 0
									and node.TextBounds.X > 0
									and node.TextBounds.Y > 0
							end
						end
					end
				end
				return filled
			end
			local render = ctx.config.services.RunService and ctx.config.services.RunService.PreRender
			local frames = ctx.runtime.host.frames
			local stop: (() -> ())? = nil
			local geometry: { RBXScriptConnection } = {}
			local function halt()
				for _, connection in geometry do
					connection:Disconnect()
				end
				table.clear(geometry)
				local current = stop
				stop = nil
				if current then
					current()
				end
			end
			local function prepare()
				if not ready:peek() and sample() then
					halt()
					ready:set(true)
				end
			end
			ctx.Compose.cleanup(halt)
			prepare()
			if ready:peek() then
				return
			end
			local function listen(node: Instance)
				if node:IsA("GuiObject") then
					table.insert(geometry, node:GetPropertyChangedSignal("AbsoluteSize"):Connect(prepare))
					table.insert(geometry, node:GetPropertyChangedSignal("Visible"):Connect(prepare))
					if node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox") then
						table.insert(geometry, node:GetPropertyChangedSignal("TextBounds"):Connect(prepare))
					end
				end
			end
			listen(root)
			for _, node in root:GetDescendants() do
				listen(node)
			end
			if render then
				local connection = render:Connect(prepare)
				stop = function()
					connection:Disconnect()
				end
			elseif frames then
				stop = frames.onFrame(prepare)
			else
				prepare()
			end
		end)
	end)
	return ready
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="17">
            <Properties>
              <string name="Name">collection_policy</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local CollectionTypes = require("./collection_types")
local ComposeTypes = require("../vendor/compose/core")
local sessionOf = require("./drag_session")
local DragTypes = require("./drag_types")
local activation = require("./activation")
local CollectionProps = require("./collection_props")
local policy = {}
function policy.allows<V>(predicate: ((V) -> boolean)?, item: V): boolean
	if predicate == nil then
		return true
	end
	local ok, allowed = pcall(predicate, item)
	return ok and allowed == true
end
function policy.disabled<V>(predicate: ((V) -> boolean)?, item: V): boolean
	if predicate == nil then
		return false
	end
	local ok, disabled = pcall(predicate, item)
	return not ok or disabled == true
end
function policy.selectionVisible(node: GuiObject): boolean
	local position, size = node.AbsolutePosition, node.AbsoluteSize
	local left, top = position.X, position.Y
	local right, bottom = left + size.X, top + size.Y
	local measured = size.X > 0 and size.Y > 0
	local ancestor: Instance? = node
	while ancestor do
		if ancestor:IsA("GuiObject") then
			if not ancestor.Visible or not ancestor.Interactable then
				return false
			end
			if measured and ancestor.ClipsDescendants then
				local p, s = ancestor.AbsolutePosition, ancestor.AbsoluteSize
				left, top = math.max(left, p.X), math.max(top, p.Y)
				right, bottom = math.min(right, p.X + s.X), math.min(bottom, p.Y + s.Y)
				if right <= left or bottom <= top then
					return false
				end
			end
		elseif ancestor:IsA("LayerCollector") and not ancestor.Enabled then
			return false
		end
		ancestor = ancestor.Parent
	end
	return true
end
function policy.actions<V, K>(
	ctx: Types.Context,
	spec: {
		rowActions: ((ComposeTypes.Readable<V>, K) -> CollectionTypes.RowActionsShape?)?,
		rowDeletable: ((V) -> boolean)?,
		disabled: ((V) -> boolean)?,
		reducedMotion: Types.ValueBoolean?,
		editing: Types.ValueBoolean?,
	},
	current: ComposeTypes.Readable<V>,
	key: K,
	row: GuiObject,
	constructor: Types.Constructor<CollectionProps.RowActionsSpec, Frame>,
	coordinator: ComposeTypes.Cell<{}?>,
	tiled: boolean?
): (GuiObject, ComposeTypes.Readable<number>?)
	local authored = if spec.rowActions then spec.rowActions(current, key) else nil
	local edits = activation.edits(row)
	if authored == nil and #edits == 0 then
		return row, nil
	end
	local actions: CollectionTypes.RowActionsShape = authored or {}
	local actionSpec = table.clone(actions) :: CollectionProps.RowActionsSpec
	local function gated(list: Types.Value<{ CollectionTypes.RowAction }>?): Types.Value<{ CollectionTypes.RowAction }>?
		if list == nil then
			return nil
		end
		return function(use: ComposeTypes.Use): { CollectionTypes.RowAction }
			local allowed = policy.allows(spec.rowDeletable, use(current))
			local kept = {}
			for _, action in ctx.read(list, use) do
				if allowed or action.role ~= "destructive" then
					table.insert(kept, action)
				end
			end
			return kept
		end
	end
	actionSpec.leading, actionSpec.trailing = gated(actions.leading), gated(actions.trailing)
	if #edits > 0 then
		local trailing = actionSpec.trailing
		actionSpec.trailing = function(use: ComposeTypes.Use): { CollectionTypes.RowAction }
			local result = table.clone(ctx.read(trailing, use) or {})
			for index, edit in edits do
				local action = table.clone(edit)
				action.id = "edit:" .. index
				table.insert(result, (action :: unknown) :: CollectionTypes.RowAction)
			end
			return result
		end
	end
	actionSpec.enabled = function(use: ComposeTypes.Use): boolean
		return ctx.read(actions.enabled, use) ~= false and not policy.disabled(spec.disabled, use(current))
	end
	actionSpec.actionPlacement = actions.actionPlacement or (if tiled then "bottom" else "trailing")
	actionSpec.content, actionSpec.coordinator = row, actions.coordinator or coordinator
	actionSpec.Size = ctx.types.UDim2.fromScale(1, 1)
	actionSpec.reducedMotion = spec.reducedMotion
	actionSpec.swipeEnabled = function(use: ComposeTypes.Use): boolean
		return ctx.read(actions.swipeEnabled, use) ~= false and ctx.read(spec.editing, use) ~= true
	end
	local root = constructor(actionSpec)
	local button = root:FindFirstChild("CellActions")
	local footer = if tiled
			and actionSpec.actionPlacement == "bottom"
			and button
			and button:IsA("GuiObject")
		then button
		else nil
	if footer then
		local size, visible = ctx.layoutSize(footer), ctx.observe.Visible(footer)
		return root,
			ctx.Compose.formula(function(use: ComposeTypes.Use): number
				return if use(visible) then use(size).Y else 0
			end)
	end
	return root, nil
end
function policy.drop<V, K>(
	ctx: Types.Context,
	spec: CollectionTypes.ReorderShape<V, K>,
	current: ComposeTypes.Readable<V>,
	key: K,
	row: GuiObject,
	horizontal: boolean
)
	if not spec.rowDrop then
		return
	end
	local authored = spec.rowDrop(current, key)
	if authored == nil then
		return
	end
	local destination: DragTypes.TargetSpec = (table.clone(authored) :: unknown) :: DragTypes.TargetSpec
	local service = sessionOf(ctx)
	destination.collectionAxis = if horizontal then "X" else "Y"
	destination.accepts = function(payload, info): (boolean, string?)
		if policy.disabled(spec.disabled, current:peek()) then
			return false, "This item is unavailable"
		end
		if authored.accepts then
			return authored.accepts(payload, info)
		end
		return true, nil
	end
	service.register(row, destination)
	ctx.runtime.connect(row, "InputBegan", function(input: InputObject)
		local session = service.state:peek()
		if
			session
			and session.mode == "armed"
			and (
				input.UserInputType == ctx.types.Enum.UserInputType.Touch
				or input.UserInputType == ctx.types.Enum.UserInputType.MouseButton1
			)
		then
			local target = service.targetOf(row)
			if target then
				activation.consume(input)
				service.commit(target)
			end
		end
	end)
	local hit = row:FindFirstChild("RowHit")
	if hit then
		ctx.Compose.cleanup(activation.intercept(hit :: GuiObject, function(): boolean
			local session = service.state:peek()
			if not session or session.mode ~= "armed" then
				return false
			end
			local target = service.targetOf(row)
			if target then
				service.commit(target)
				return true
			end
			return false
		end))
	end
end
return policy
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="18">
            <Properties>
              <string name="Name">collection_props</string>
              <string name="Source"><![CDATA[--!strict
local Compose = require("../vendor/compose/core")
local Engine = require("./engine_types")
local Collections = require("./collection_types")

local scrollingFrame = (nil :: unknown) :: Engine.ScrollingFrameProps
local identity = (nil :: unknown) :: Collections.Identity
local frame = (nil :: unknown) :: Engine.FrameProps
local rowActionsFields = (nil :: unknown) :: Collections.RowActionsFields
local rowActionsContent = (nil :: unknown) :: Collections.RowActionsContent
local cellEditor = (nil :: unknown) :: Collections.CellEditorOptions

export type KeyedCollectionSpec<V, K> = {
	Changed: typeof(scrollingFrame.Changed),
	Attributes: typeof(scrollingFrame.Attributes),
	AncestryChanged: typeof(scrollingFrame.AncestryChanged),
	Archivable: typeof(scrollingFrame.Archivable),
	AttributeChanged: typeof(scrollingFrame.AttributeChanged),
	Capabilities: typeof(scrollingFrame.Capabilities),
	ChildAdded: typeof(scrollingFrame.ChildAdded),
	ChildRemoved: typeof(scrollingFrame.ChildRemoved),
	DescendantAdded: typeof(scrollingFrame.DescendantAdded),
	DescendantRemoving: typeof(scrollingFrame.DescendantRemoving),
	Destroying: typeof(scrollingFrame.Destroying),
	Name: typeof(scrollingFrame.Name),
	Parent: typeof(scrollingFrame.Parent),
	Sandboxed: typeof(scrollingFrame.Sandboxed),
	StyledPropertiesChanged: typeof(scrollingFrame.StyledPropertiesChanged),
	AutoLocalize: typeof(scrollingFrame.AutoLocalize),
	RootLocalizationTable: typeof(scrollingFrame.RootLocalizationTable),
	SelectionBehaviorDown: typeof(scrollingFrame.SelectionBehaviorDown),
	SelectionBehaviorLeft: typeof(scrollingFrame.SelectionBehaviorLeft),
	SelectionBehaviorRight: typeof(scrollingFrame.SelectionBehaviorRight),
	SelectionBehaviorUp: typeof(scrollingFrame.SelectionBehaviorUp),
	SelectionChanged: typeof(scrollingFrame.SelectionChanged),
	SelectionGroup: typeof(scrollingFrame.SelectionGroup),
	Active: typeof(scrollingFrame.Active),
	AnchorPoint: typeof(scrollingFrame.AnchorPoint),
	AutomaticSize: typeof(scrollingFrame.AutomaticSize),
	BackgroundColor3: typeof(scrollingFrame.BackgroundColor3),
	BackgroundTransparency: typeof(scrollingFrame.BackgroundTransparency),
	BorderColor3: typeof(scrollingFrame.BorderColor3),
	BorderMode: typeof(scrollingFrame.BorderMode),
	BorderSizePixel: typeof(scrollingFrame.BorderSizePixel),
	ClipsDescendants: typeof(scrollingFrame.ClipsDescendants),
	InputBegan: typeof(scrollingFrame.InputBegan),
	InputChanged: typeof(scrollingFrame.InputChanged),
	InputEnded: typeof(scrollingFrame.InputEnded),
	InputSink: typeof(scrollingFrame.InputSink),
	Interactable: typeof(scrollingFrame.Interactable),
	LayoutOrder: typeof(scrollingFrame.LayoutOrder),
	MouseEnter: typeof(scrollingFrame.MouseEnter),
	MouseLeave: typeof(scrollingFrame.MouseLeave),
	MouseMoved: typeof(scrollingFrame.MouseMoved),
	MouseWheelBackward: typeof(scrollingFrame.MouseWheelBackward),
	MouseWheelForward: typeof(scrollingFrame.MouseWheelForward),
	NextSelectionDown: typeof(scrollingFrame.NextSelectionDown),
	NextSelectionLeft: typeof(scrollingFrame.NextSelectionLeft),
	NextSelectionRight: typeof(scrollingFrame.NextSelectionRight),
	NextSelectionUp: typeof(scrollingFrame.NextSelectionUp),
	Position: typeof(scrollingFrame.Position),
	Rotation: typeof(scrollingFrame.Rotation),
	Selectable: typeof(scrollingFrame.Selectable),
	SelectionGained: typeof(scrollingFrame.SelectionGained),
	SelectionImageObject: typeof(scrollingFrame.SelectionImageObject),
	SelectionLost: typeof(scrollingFrame.SelectionLost),
	SelectionOrder: typeof(scrollingFrame.SelectionOrder),
	Size: typeof(scrollingFrame.Size),
	SizeConstraint: typeof(scrollingFrame.SizeConstraint),
	TouchLongPress: typeof(scrollingFrame.TouchLongPress),
	TouchPan: typeof(scrollingFrame.TouchPan),
	TouchPinch: typeof(scrollingFrame.TouchPinch),
	TouchRotate: typeof(scrollingFrame.TouchRotate),
	TouchSwipe: typeof(scrollingFrame.TouchSwipe),
	TouchTap: typeof(scrollingFrame.TouchTap),
	Visible: typeof(scrollingFrame.Visible),
	ZIndex: typeof(scrollingFrame.ZIndex),
	AutomaticCanvasSize: typeof(scrollingFrame.AutomaticCanvasSize),
	BottomImage: typeof(scrollingFrame.BottomImage),
	BottomImageContent: typeof(scrollingFrame.BottomImageContent),
	CanvasPosition: typeof(scrollingFrame.CanvasPosition),
	CanvasSize: typeof(scrollingFrame.CanvasSize),
	ElasticBehavior: typeof(scrollingFrame.ElasticBehavior),
	HorizontalScrollBarInset: typeof(scrollingFrame.HorizontalScrollBarInset),
	MidImage: typeof(scrollingFrame.MidImage),
	MidImageContent: typeof(scrollingFrame.MidImageContent),
	ScrollBarImageColor3: typeof(scrollingFrame.ScrollBarImageColor3),
	ScrollBarImageTransparency: typeof(scrollingFrame.ScrollBarImageTransparency),
	ScrollBarThickness: typeof(scrollingFrame.ScrollBarThickness),
	ScrollingDirection: typeof(scrollingFrame.ScrollingDirection),
	ScrollingEnabled: typeof(scrollingFrame.ScrollingEnabled),
	TopImage: typeof(scrollingFrame.TopImage),
	TopImageContent: typeof(scrollingFrame.TopImageContent),
	VerticalScrollBarInset: typeof(scrollingFrame.VerticalScrollBarInset),
	VerticalScrollBarPosition: typeof(scrollingFrame.VerticalScrollBarPosition),
	ref: typeof(scrollingFrame.ref),
	selection: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, K>).selection),
	selectionFrom: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, K>).selectionFrom),
	selectionIndicator: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, K>).selectionIndicator),
	selectionMode: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, K>).selectionMode),
	selectable: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, K>).selectable),
	disabled: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, K>).disabled),
	onSelectionChange: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, K>).onSelectionChange),
	editing: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, K>).editing),
	collectionId: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, K>).collectionId),
	drag: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, K>).drag),
	drop: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, K>).drop),
	rowDrop: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, K>).rowDrop),
	reorderable: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, K>).reorderable),
	movable: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, K>).movable),
	onReorder: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, K>).onReorder),
