              <Item class="Folder" referent="268">
                <Properties>
                  <string name="Name">ownership</string>
                </Properties>
                <Item class="ModuleScript" referent="269">
                  <Properties>
                    <string name="Name">active</string>
                    <string name="Source"><![CDATA[--!strict

local Diagnostics = require "../diagnostics"
local Owner = require "./owner"
local Graph = require "../reactive/graph"
local Types = require "../reactive/types"

type Dispose = Types.Dispose

type Activation = { owner: Owner.Owner, thread: thread }

local activations: { Activation } = {}

local function depth(): number
	local running = coroutine.running()
	local count = 0
	for _, activation in activations do
		if activation.thread == running or coroutine.status(activation.thread) == "normal" then
			count += 1
		end
	end
	return count
end

local function current(): Owner.Owner?
	local running = coroutine.running()
	local explicit: Owner.Owner? = nil
	local inherited: Owner.Owner? = nil
	local seen: { [thread]: boolean }? = nil
	local ambiguous = false
	for index = #activations, 1, -1 do
		local activation = activations[index]
		if activation.thread == running then
			explicit = activation.owner
			break
		else
			local status = coroutine.status(activation.thread)
			if status == "normal" and (seen == nil or not seen[activation.thread]) then
				local visited = seen or {}
				seen = visited
				visited[activation.thread] = true
				if inherited == nil then
					inherited = activation.owner
				elseif inherited ~= activation.owner then
					ambiguous = true
				end
			elseif status == "dead" then
				table.remove(activations, index)
			end
		end
	end
	if explicit == nil and ambiguous then
		Diagnostics.raise("owner/no-active-owner", "resumer owners are ambiguous", {
			contract = "a callback cannot infer the order of distinct resumer owners",
			fix = "bind the child callback with Compose.bindOwner or activate its owner with Compose.withOwner",
		})
	end
	local context = Graph.evaluationContext()
	if context ~= nil then
		local record = Owner.runScopeOf(context)
		if record ~= nil and depth() <= record.base then
			return (record :: unknown) :: Owner.Owner
		end
	end
	return explicit or inherited
end

local function push(owner: Owner.Owner): Activation
	local activation: Activation = { owner = owner, thread = coroutine.running() }
	table.insert(activations, activation)
	return activation
end

local function pop(activation: Activation)
	local last = #activations
	if activations[last] == activation then
		activations[last] = nil
		return
	end
	local index = table.find(activations, activation)
	if index ~= nil then
		table.remove(activations, index)
	end
end

local function release<T...>(activation: Activation, ok: boolean, ...: T...): T...
	pop(activation)
	if not ok then
		error(select(1, ...), 0)
	end
	return ...
end

local function withOwner<T...>(owner: Owner.Owner, body: () -> T...): T...
	local activation = push(owner)
	return release(activation, pcall(body))
end

local function bind<Args..., Rets...>(owner: Owner.Owner, body: (Args...) -> Rets...): (Args...) -> Rets...
	return function(...: Args...): Rets...
		local activation = push(owner)
		return release(activation, pcall(body, ...))
	end
end

local function own(dispose: Dispose, operation: string): Dispose
	local owner = current()
	if owner == nil then
		Diagnostics.raise("owner/no-active-owner", ("%s has no owner to register with"):format(operation), {
			contract = "resources must be created inside a mount, so something can release them",
			fix = "wrap the caller in runtime.mount(component, target), or pass an explicit owner",
		})
	end
	return (owner :: Owner.Owner).own(dispose)
end

local function runWith<A...>(owner: Owner.Owner, body: (A...) -> (), ...: A...)
	local activation = push(owner)
	local ok, err: unknown = pcall(body, ...)
	pop(activation)
	if not ok then
		error(err, 0)
	end
end

local function runWith1<T>(owner: Owner.Owner, body: () -> T): T
	local activation = push(owner)
	local ok, result = pcall(body)
	pop(activation)
	if not ok then
		error(result, 0)
	end
	return result
end

Owner.installActivationDepth(depth)

local function resetForTests()
	table.clear(activations)
end

return {
	current = current,
	depth = depth,
	withOwner = withOwner,
	bind = bind,
	runWith = runWith,
	runWith1 = runWith1,
	own = own,
	resetForTests = resetForTests,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="270">
                  <Properties>
                    <string name="Name">inspect</string>
                    <string name="Source"><![CDATA[--!strict

local Nodes = require "./nodes"
local Weak = require "../weak"

export type Options = {
	maxOwners: number?,
	maxNodes: number?,
}

export type OwnerReport = {
	id: number,
	label: string?,
	holding: number,
	disposed: boolean,
	owned: number,
	adopted: number,
	borrowed: number,
	watches: number,
	cleanups: number,
	children: { OwnerReport },
	totalHolding: number,
	totalOwned: number,
	totalAdopted: number,
	totalBorrowed: number,
	totalWatches: number,
	totalCleanups: number,
	descendants: number,
	unclassified: number,
}

export type NodeReport = {
	custody: string,
	label: string?,
	ownerId: number?,
	ownerLabel: string?,
	because: string,
}

export type Report = {
	active: boolean,
	mounts: { OwnerReport },
	detached: { OwnerReport },
	outstandingMounts: number,

	trackedNodes: number,
	pending: number,
	droppedOwners: number,
	droppedNodes: number,
}

local DEFAULT_MAX_OWNERS = 4096
local DEFAULT_MAX_NODES = 16384

export type Record = {
	id: number,
	label: string?,
	owned: number,
	adopted: number,
	borrowed: number,
	watches: number,
	cleanups: number,

	children: { [unknown]: true },
	childCount: number,
	isChild: boolean,
	isMount: boolean,
}

export type State = {
	records: { [unknown]: Record },

	ordered: { [number]: unknown },
	orderedCount: number,
	nextId: number,
	maxOwners: number,
	maxNodes: number,
	droppedOwners: number,
	droppedNodes: number,
	nodes: number,
	nodeOwner: { [unknown]: Record },
	broken: boolean,
}

local state: State? = nil

local function isActive(): boolean
	return state ~= nil
end

local function guarded(body: () -> ())
	local held = state
	if held == nil or held.broken then
		return
	end
	local ok = pcall(body)
	if not ok then
		held.broken = true
	end
end

local function recordFor(owner: unknown): Record?
	local held = state
	if held == nil then
		return nil
	end
	local existing = held.records[owner]
	if existing ~= nil then
		return existing
	end
	if held.orderedCount >= held.maxOwners then
		held.droppedOwners += 1
		return nil
	end
	held.nextId += 1
	local record: Record = {
		id = held.nextId,
		label = nil,
		owned = 0,
		adopted = 0,
		borrowed = 0,
		watches = 0,
		cleanups = 0,
		children = Weak.keys() :: { [unknown]: true },
		childCount = 0,
		isChild = false,
		isMount = false,
	}
	held.records[owner] = record
	held.orderedCount += 1
	held.ordered[held.orderedCount] = owner
	return record
end

local function node(owner: unknown, subject: unknown, custody: string)
	guarded(function()
		local held = state :: State
		local record = recordFor(owner)
		if record == nil then
			return
		end
		if custody == "owned" then
			record.owned += 1
		elseif custody == "adopted" then
			record.adopted += 1
		else
			record.borrowed += 1
		end
		if held.nodes >= held.maxNodes then
			held.droppedNodes += 1
			return
		end
		held.nodes += 1
		held.nodeOwner[subject] = record
	end)
end

local function mount(owner: unknown)
	guarded(function()
		local record = recordFor(owner)
		if record ~= nil then
			record.isMount = true
		end
	end)
end

local function watch(owner: unknown)
	guarded(function()
		local record = recordFor(owner)
		if record ~= nil then
			record.watches += 1
		end
	end)
end

local function cleanup(owner: unknown)
	guarded(function()
		local record = recordFor(owner)
		if record ~= nil then
			record.cleanups += 1
		end
	end)
end

local function child(parent: unknown, subject: unknown)
	guarded(function()
		local parentRecord = recordFor(parent)
		local childRecord = recordFor(subject)
		if parentRecord == nil or childRecord == nil then
			return
		end
		if parentRecord.children[subject] == nil then
			parentRecord.children[subject] = true
			parentRecord.childCount += 1
		end
		childRecord.isChild = true
	end)
end

local function label(owner: unknown, name: string)
	guarded(function()
		local record = recordFor(owner)
		if record ~= nil then
			record.label = name
		end
	end)
end

local function start(options: Options?)
	local settings: Options = options or ({} :: Options)
	state = {
		records = Weak.keys() :: { [unknown]: Record },
		ordered = Weak.values() :: { [number]: unknown },
		orderedCount = 0,
		nextId = 0,
		maxOwners = settings.maxOwners or DEFAULT_MAX_OWNERS,
		maxNodes = settings.maxNodes or DEFAULT_MAX_NODES,
		droppedOwners = 0,
		droppedNodes = 0,
		nodes = 0,
		nodeOwner = Weak.keys() :: { [unknown]: Record },
		broken = false,
	}
end

local function stop()
	state = nil
	Nodes.resetCharges()
end

return {
	isActive = isActive,
	start = start,
	stop = stop,
	label = label,

	node = node,
	mount = mount,
	watch = watch,
	cleanup = cleanup,
	child = child,

	__state = function(): State?
		return state
	end,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="271">
                  <Properties>
                    <string name="Name">nodes</string>
                    <string name="Source"><![CDATA[--!strict

local Diagnostics = require "../diagnostics"
local Host = require "../host"
local Weak = require "../weak"

type Node = Host.Node

export type Custody = "owned" | "adopted" | "borrowed"

type Counts = { owned: number, adopted: number, borrowed: number }

local custody = Weak.keys() :: { [Node]: Custody }

local function assertReference(node: Node, operation: string)
	local kind = type(node)
	if kind == "table" or kind == "userdata" then
		return
	end
	Diagnostics.raise(
		"host/node-not-a-reference",
		("%s received a node that is not a reference value"):format(operation),
		{
			actual = Diagnostics.describe(node),
			expected = "a table or userdata",
			contract = "host nodes must be reference values so custody and identity can be tracked",
		}
	)
end

local function mark(node: Node, kind: Custody)
	custody[node] = kind
end

local function markOwned(node: Node)
	assertReference(node, "createNode")
	custody[node] = "owned"
end

local function markAdopted(node: Node)
	assertReference(node, "adopt")
	custody[node] = "adopted"
end

local function markBorrowed(node: Node)
	assertReference(node, "borrow")
	custody[node] = "borrowed"
end

local function custodyOf(node: Node): Custody
	local known: Custody? = custody[node]
	if known ~= nil then
		return known
	end
	return "borrowed"
end

local function isDestructible(node: Node): boolean
	local known = custody[node]
	return known == "owned" or known == "adopted"
end

local dependents = Weak.keys() :: { [Node]: { () -> () } }

local function attachDependent(node: Node, dispose: () -> ()): () -> ()
	assertReference(node, "mount")
	local list = dependents[node]
	if list == nil then
		list = {}
		dependents[node] = list
	end
	table.insert(list, dispose)

	local detached = false
	return function()
		if detached then
			return
		end
		detached = true
		local current = dependents[node]
		if current == nil then
			return
		end
		local index = table.find(current, dispose)
		if index ~= nil then
			table.remove(current, index)
		end
	end
end

local function releaseDependents(node: Node)
	local list = dependents[node]
	if list == nil then
		return
	end
	dependents[node] = nil
	local failure: string? = nil
	for index = #list, 1, -1 do
		local ok, err: unknown = pcall(list[index])
		if not ok and failure == nil then
			failure = tostring(err)
		end
	end
	if failure ~= nil then
		error(failure, 0)
	end
end

local labels = Weak.keys() :: { [Node]: string }

local function label(node: Node, name: string)
	labels[node] = name
end

local function labelOf(node: Node): string?
	return labels[node]
end

export type OwnedCounts = { ownedNodes: number, borrowedNodes: number }

local charge = Weak.keys() :: { [Node]: { owner: unknown, custody: Custody } }

local ownerCounts = Weak.keys() :: { [unknown]: Counts }

local function bucketFor(owner: unknown): Counts
	local existing = ownerCounts[owner]
	if existing ~= nil then
		return existing
	end
	local bucket: Counts = { owned = 0, adopted = 0, borrowed = 0 }
	ownerCounts[owner] = bucket
	return bucket
end

local function adjust(bucket: Counts, kind: Custody, delta: number)
	if kind == "owned" then
		bucket.owned += delta
	elseif kind == "adopted" then
		bucket.adopted += delta
	else
		bucket.borrowed += delta
	end
end

local function chargeToOwner(owner: unknown, node: Node, kind: Custody)
	if owner == nil then
		return
	end
	local previous = charge[node]
	if previous ~= nil then
		local previousBucket = ownerCounts[previous.owner]
		if previousBucket ~= nil then
			adjust(previousBucket, previous.custody, -1)
		end
	end
	charge[node] = { owner = owner, custody = kind }
	adjust(bucketFor(owner), kind, 1)
end

local function releaseCharge(node: Node)
	local previous = charge[node]
	if previous == nil then
		return
	end
	charge[node] = nil
	local bucket = ownerCounts[previous.owner]
	if bucket ~= nil then
		adjust(bucket, previous.custody, -1)
	end
end

local function resetCharges()
	table.clear(charge)
	table.clear(ownerCounts)
end

local function ownedCounts(owner: unknown): OwnedCounts
	local bucket = ownerCounts[owner]
	if bucket == nil then
		return { ownedNodes = 0, borrowedNodes = 0 }
	end
	return { ownedNodes = bucket.owned + bucket.adopted, borrowedNodes = bucket.borrowed }
end

local function forget(node: Node)
	custody[node] = nil
	labels[node] = nil
	releaseCharge(node)
	releaseDependents(node)
end

local function trackedCount(): number
	local total = 0
	for _ in custody do
		total += 1
	end
	return total
end

local function resetForTests()
	table.clear(custody)
	table.clear(dependents)
	table.clear(labels)
	resetCharges()
end

return {
	mark = mark,
	markOwned = markOwned,
	markAdopted = markAdopted,
	markBorrowed = markBorrowed,
	custodyOf = custodyOf,
	label = label,
	labelOf = labelOf,
	isDestructible = isDestructible,
	attachDependent = attachDependent,
	releaseDependents = releaseDependents,
	forget = forget,
	trackedCount = trackedCount,
	chargeToOwner = chargeToOwner,
	releaseCharge = releaseCharge,
	resetCharges = resetCharges,
	ownedCounts = ownedCounts,
	resetForTests = resetForTests,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="272">
                  <Properties>
                    <string name="Name">owner</string>
                    <string name="Source"><![CDATA[--!strict

local Types = require "../reactive/types"
local Inspect = require "./inspect"
local Reactor = require "../reactive/reactor"
local watchModule = require "../reactive/watch"
local Graph = require "../reactive/graph"

type Dispose = Types.Dispose
type Scope = Types.Use

export type Boundary = {
	report: (failure: unknown) -> (),
}

export type Owner = {
	own: (dispose: Dispose, afterDispose: Dispose?) -> Dispose,
	watch: (body: (use: Types.Use) -> (), label: string?, afterDispose: Dispose?) -> Dispose,
	watchStatic: <T>(producer: Types.Readable<T>, body: (value: T) -> (), afterDispose: Dispose?) -> Dispose,
	watchTerminal: (body: (use: Types.Use) -> (), afterDispose: Dispose?) -> Dispose,
	reactor: Reactor.Reactor,
	createChild: () -> Owner,

	dispose: Dispose,
	isDisposed: () -> boolean,
	size: () -> number,
	checkpoint: () -> unknown,
	rollbackTo: (token: unknown) -> (),

	boundary: Boundary?,
	guardWith: (boundary: Boundary) -> (),

	__attachTo: (detach: Dispose) -> (),
}

local DISPOSE, PREVIOUS, NEXT, ATTACHED, AFTER_DISPOSE = 1, 2, 3, 4, 5

type Entry = { Dispose | Entry | boolean | nil }

local function noop() end

local function raiseAll(failures: { unknown })
	local count = #failures
	if count == 0 then
		return
	end
	if count == 1 then
		error(failures[1], 0)
	end
	local parts = { ("Compose: %d errors while disposing an owner:"):format(count) }
	for index, failure in failures do
		table.insert(parts, ("  [%d] %s"):format(index, tostring(failure)))
	end
	error(table.concat(parts, "\n"), 0)
end

local function releaseEntry(entry: Entry, failures: { unknown })
	local dispose = entry[DISPOSE] :: Dispose?
	entry[DISPOSE] = nil
	local afterDispose = entry[AFTER_DISPOSE] :: Dispose?
	if afterDispose == nil then
		(dispose :: Dispose)()
		dispose = nil
		return
	end
	entry[AFTER_DISPOSE] = nil
	local ok, failure: unknown = pcall(dispose :: Dispose)
	dispose = nil
	if not ok then
		table.insert(failures, failure)
	end
	local settled, later: unknown = pcall(afterDispose)
	afterDispose = nil
	if not settled then
		table.insert(failures, later)
	end
end

export type RunScope = { child: Owner | false, create: () -> Owner, base: number }

local RUN_SCOPE = {
	__index = function(scope: RunScope, key: string): unknown
		local child = scope.child
		if child == false then
			child = scope.create()
			scope.child = child
		end
		return ((child :: unknown) :: { [string]: unknown })[key]
	end,
}

local runScopes = (setmetatable({} :: { [unknown]: RunScope }, { __mode = "k" }) :: unknown) :: { [unknown]: RunScope }
local activationDepth: () -> number = function(): number
	return 0
end

local function installActivationDepth(depth: () -> number)
	activationDepth = depth
end

local function runScopeOf(consumer: unknown): RunScope?
	return runScopes[consumer]
end

local function createOwner(inherited: Reactor.Reactor?): Owner
	local reactor = inherited or Reactor.create()
	local head: Entry? = nil
	local count = 0
	local disposed = false
	local detachFromParent: Dispose? = nil

	local function unlink(entry: Entry)
		local previous = entry[PREVIOUS] :: Entry?
		local following = entry[NEXT] :: Entry?
		if previous ~= nil then
			previous[NEXT] = following
		else
			head = following
		end
		if following ~= nil then
			following[PREVIOUS] = previous
		end
		entry[PREVIOUS] = nil
		entry[NEXT] = nil
		entry[ATTACHED] = false
		count -= 1
	end

	local function own(dispose: Dispose, afterDispose: Dispose?): Dispose
		if disposed then
			dispose()
			if afterDispose ~= nil then
				afterDispose()
			end
			return noop
		end

		local first = head
		local entry: Entry = { dispose, nil, first, true, afterDispose }
		if first ~= nil then
			first[PREVIOUS] = entry
		end
		head = entry
		count += 1

		return function()
			if disposed or not entry[ATTACHED] then
				return
			end
			unlink(entry)
			if entry[AFTER_DISPOSE] == nil then
				local cleanup = entry[DISPOSE] :: Dispose?
				entry[DISPOSE] = nil
				(cleanup :: Dispose)()
				cleanup = nil
				return
			end
			local failures: { unknown } = {}
			releaseEntry(entry, failures)
			raiseAll(failures)
		end
	end

	local function checkpoint(): unknown
		return head
	end

	local function rollbackTo(token: unknown)
		local boundaryEntry = token :: Entry?
		local failures: { unknown } = {}
		local pending = head

		local function releaseRest()
			while true do
				local entry = pending
				if entry == nil or entry == boundaryEntry then
					break
				end
				pending = entry[NEXT] :: Entry?
				unlink(entry)
				releaseEntry(entry, failures)
			end
		end

		while pending ~= nil and pending ~= boundaryEntry do
			local ok, failure: unknown = pcall(releaseRest)
			if not ok then
				table.insert(failures, failure)
			end
		end
		raiseAll(failures)
	end

	local function disposeOwner()
		if disposed then
			return
		end

		local detach = detachFromParent
		if detach ~= nil then
			detachFromParent = nil
			detach()
			if disposed then
				return
			end
		end

		disposed = true

		local pending = head
		head = nil
		count = 0

		if pending == nil then
			return
		end

		local failures: { unknown } = {}
		local function releaseRest()
			while pending ~= nil do
				local entry = pending
				pending = entry[NEXT] :: Entry?
				entry[PREVIOUS] = nil
				entry[NEXT] = nil
				entry[ATTACHED] = false
				releaseEntry(entry, failures)
			end
		end

		repeat
			local ok, failure: unknown = pcall(releaseRest)
			if not ok then
				table.insert(failures, failure)
			end
		until pending == nil
		raiseAll(failures)
	end

	local owner: Owner

	local function createChild(): Owner
		local child = createOwner(reactor)
		child.__attachTo(own(function()
			child.dispose()
		end))
		if Inspect.isActive() then
			Inspect.child(owner, child)
		end
		if owner.boundary ~= nil then
			child.guardWith(owner.boundary :: Boundary)
		end
		return child
	end

	local function startWatch<A, B>(
		factory: (reactor: Reactor.Reactor, first: A, second: B) -> Dispose,
		first: A,
		second: B,
		afterDispose: Dispose?
	): Dispose
		if afterDispose == nil then
			return own(factory(reactor, first, second))
		end
		local ok, dispose = pcall(factory, reactor, first, second)
		if not ok then
			afterDispose()
			error(dispose, 0)
		end
		return own(dispose, afterDispose)
	end

	local function ownedWatchStatic<T>(
		producer: Types.Readable<T>,
		body: (value: T) -> (),
		afterDispose: Dispose?
	): Dispose
		if Inspect.isActive() then
			Inspect.watch(owner)
		end
		local boundary = owner.boundary
		if boundary == nil then
			return startWatch(watchModule.watchStatic, producer, body, afterDispose)
		end
		return startWatch(watchModule.watchGuarded, function(use: Types.Use)
			local ok, err: unknown = pcall(function()
				body(use(producer))
			end)
			if not ok then
				boundary.report(err)
			end
		end, nil, afterDispose)
	end

	local function ownedWatchTerminal(body: (use: Types.Use) -> (), afterDispose: Dispose?): Dispose
		if Inspect.isActive() then
			Inspect.watch(owner)
		end
		local boundary = owner.boundary
		if boundary == nil then
			return startWatch(watchModule.watchTerminal, body, nil, afterDispose)
		end
		return startWatch(watchModule.watchTerminal, function(use: Types.Use)
			local ok, err: unknown = pcall(body, use)
			if not ok then
				boundary.report(err)
			end
		end, nil, afterDispose)
	end

	local function scopedRuns(body: (use: Types.Use) -> (), afterDispose: Dispose?): ((use: Types.Use) -> (), Dispose)
		local record = (
			setmetatable({ child = false, create = createChild, base = 0 }, RUN_SCOPE) :: unknown
		) :: RunScope
		local function release()
			local current = record.child
			if type(current) == "table" then
				record.child = false
				current.dispose()
			end
		end
		local registered = false
		local function scoped(use: Types.Use)
			if record.child ~= false then
				release()
			end
			if not registered then
				local consumer = Graph.evaluationContext()
				if consumer ~= nil then
					runScopes[consumer] = record
					registered = true
				end
			end
			record.base = activationDepth()
			body(use)
		end
		local function released()
			release()
			if afterDispose ~= nil then
				afterDispose()
			end
		end
		return scoped, released
	end

	local function ownedWatch(body: (use: Types.Use) -> (), label: string?, afterDispose: Dispose?): Dispose
		if Inspect.isActive() then
			Inspect.watch(owner)
		end
		local scoped, released = scopedRuns(body, afterDispose)
		local boundary = owner.boundary
		if boundary == nil then
			return startWatch(watchModule.watch, scoped, label, released)
		end
		return startWatch(watchModule.watchGuarded, function(use: Types.Use)
			local ok, err: unknown = pcall(scoped, use)
			if not ok then
				boundary.report(err)
			end
		end, label, released)
	end

	owner = {
		own = own,
		watch = ownedWatch,
		watchStatic = ownedWatchStatic,
		watchTerminal = ownedWatchTerminal,
		reactor = reactor,
		createChild = createChild,
		dispose = disposeOwner,
		isDisposed = function(): boolean
			return disposed
		end,
		size = function(): number
			return count
		end,
		checkpoint = checkpoint,
		rollbackTo = rollbackTo,
		boundary = nil :: Boundary?,
		guardWith = function(boundary: Boundary): ()
			owner.boundary = boundary
		end,
		__attachTo = function(detach: Dispose): ()
			detachFromParent = detach
		end,
	}

	return owner
end

return {
	createOwner = createOwner,
	raiseAll = raiseAll,
	installActivationDepth = installActivationDepth,
	runScopeOf = runScopeOf,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="273">
                  <Properties>
                    <string name="Name">report</string>
                    <string name="Source"><![CDATA[--!strict

local Inspect = require "./inspect"
local Host = require "../host"
local Nodes = require "./nodes"
local Owner = require "./owner"
local Root = require "./root"

export type OwnerReport = Inspect.OwnerReport
export type NodeReport = Inspect.NodeReport
export type Report = Inspect.Report
export type OwnedCounts = Nodes.OwnedCounts

export type Data = {
	schemaVersion: number,
	active: boolean,
	outstandingMounts: number,
	trackedNodes: number,
	pending: number,
	droppedOwners: number,
	droppedNodes: number,
	mounts: { OwnerReport },
	detached: { OwnerReport },
}

local EMPTY: Report = {
	active = false,
	mounts = {},
	detached = {},
	outstandingMounts = 0,
	trackedNodes = 0,
	pending = 0,
	droppedOwners = 0,
	droppedNodes = 0,
}

local function describe(owner: Owner.Owner, record: Inspect.Record, seen: { [unknown]: true }): OwnerReport
	if seen[owner] then
		return {
			id = record.id,
			label = record.label,
			holding = 0,
			disposed = false,
			owned = 0,
			adopted = 0,
			borrowed = 0,
			watches = 0,
			cleanups = 0,
			children = {},
			totalHolding = 0,
			totalOwned = 0,
			totalAdopted = 0,
			totalBorrowed = 0,
			totalWatches = 0,
			totalCleanups = 0,
			descendants = 0,
			unclassified = 0,
		}
	end
	seen[owner] = true

	local held = Inspect.__state()
	local holding = 0
	local disposed = false
	local ok = pcall(function()
		holding = owner.size()
		disposed = owner.isDisposed()
	end)
	if not ok then
		holding = 0
	end

	local children: { OwnerReport } = {}
	if held ~= nil then
		local sorted: { unknown } = {}
		for candidate in record.children do
			table.insert(sorted, candidate)
		end
		table.sort(sorted, function(left: unknown, right: unknown): boolean
			local leftRecord, rightRecord = held.records[left], held.records[right]
			local leftId = if leftRecord ~= nil then leftRecord.id else 0
			local rightId = if rightRecord ~= nil then rightRecord.id else 0
			return leftId < rightId
		end)
		for _, candidate in sorted do
			local childRecord = held.records[candidate]
			if childRecord ~= nil then
				table.insert(children, describe(candidate :: Owner.Owner, childRecord, seen))
			end
		end
	end

	local classified = record.owned
		+ record.adopted
		+ record.borrowed
		+ record.watches
		+ record.cleanups
		+ record.childCount

	local totalHolding = holding
	local totalOwned = record.owned
	local totalAdopted = record.adopted
	local totalBorrowed = record.borrowed
	local totalWatches = record.watches
	local totalCleanups = record.cleanups
	local descendants = #children
	for _, subject in children do
		totalHolding += subject.totalHolding
		totalOwned += subject.totalOwned
		totalAdopted += subject.totalAdopted
		totalBorrowed += subject.totalBorrowed
		totalWatches += subject.totalWatches
		totalCleanups += subject.totalCleanups
		descendants += subject.descendants
	end

	return {
		id = record.id,
		label = record.label,
		holding = holding,
		disposed = disposed,
		owned = record.owned,
		adopted = record.adopted,
		borrowed = record.borrowed,
		watches = record.watches,
		cleanups = record.cleanups,
		children = children,
		totalHolding = totalHolding,
		totalOwned = totalOwned,
		totalAdopted = totalAdopted,
		totalBorrowed = totalBorrowed,
		totalWatches = totalWatches,
		totalCleanups = totalCleanups,
		descendants = descendants,
		unclassified = math.max(0, holding - classified),
	}
end

local function snapshot(): Report
	local held = Inspect.__state()
	if held == nil then
		return EMPTY
	end

	local mounts: { OwnerReport } = {}
	local detached: { OwnerReport } = {}
	local seen: { [unknown]: true } = {}
	for index = 1, held.orderedCount do
		local entry = held.ordered[index]
		if entry == nil then
			continue
		end
		local owner = entry :: Owner.Owner
		local record = held.records[owner]
		if record == nil or seen[owner] then
			continue
		end
		if record.isMount then
			table.insert(mounts, describe(owner, record, seen))
		elseif not record.isChild then
			table.insert(detached, describe(owner, record, seen))
		end
	end

	return {
		active = true,
		mounts = mounts,
		detached = detached,
		outstandingMounts = Root.size(),
		trackedNodes = Nodes.trackedCount(),
		pending = 0,
		droppedOwners = held.droppedOwners,
		droppedNodes = held.droppedNodes,
	}
end

local function node(subject: Host.Node): NodeReport
	local custody = Nodes.custodyOf(subject)
	local label = Nodes.labelOf(subject)
	local held = Inspect.__state()
	local record = if held ~= nil then held.nodeOwner[subject] else nil
	local subjectName = if label ~= nil then ("%q"):format(label) else "this node"

	if custody == "borrowed" then
		return {
			custody = custody,
			label = label,
			ownerId = if record ~= nil then record.id else nil,
			ownerLabel = if record ~= nil then record.label else nil,
			because = ("Compose will never destroy %s: it is borrowed. Whatever created it "):format(subjectName)
				.. "is what has to end it.",
		}
	end

	if record == nil then
		return {
			custody = custody,
			label = label,
			ownerId = nil,
			ownerLabel = nil,
			because = ("Compose will destroy this node when its owner is disposed (custody %q), but "):format(custody)
				.. "which owner holds it was not recorded -- the inspector was not running when it was taken on.",
		}
	end

	local name = record.label or ("owner#%d"):format(record.id)
	return {
		custody = custody,
		label = label,
		ownerId = record.id,
		ownerLabel = record.label,
		because = ("Compose will destroy this node when %s is disposed (custody %q). It is alive "):format(
			name,
			custody
		) .. "because that owner is.",
	}
end

local function owner(subject: Owner.Owner): OwnerReport?
	local held = Inspect.__state()
	if held == nil then
		return nil
	end
	local record = held.records[subject]
	if record == nil then
		return nil
	end
	return describe(subject, record, {})
end

local function owned(subject: Owner.Owner): OwnedCounts?
	if Inspect.__state() == nil then
		return nil
	end
	return Nodes.ownedCounts(subject)
end

local function indent(depth: number): string
	return string.rep("  ", depth)
end

local function line(out: { string }, text: string)
	table.insert(out, text)
end

local function renderOwner(out: { string }, entry: OwnerReport, depth: number)
	local name = entry.label or ("owner#%d"):format(entry.id)
	line(
		out,
		("%s%s  holding %d%s"):format(indent(depth), name, entry.holding, if entry.disposed then "  (disposed)" else "")
	)

	if depth == 1 and entry.descendants > 0 then
		line(
			out,
			("%s  tree: %d node%s owned, %d adopted, %d borrowed, %d watch%s, %d cleanup%s, %d owner%s"):format(
				indent(depth),
				entry.totalOwned,
				if entry.totalOwned == 1 then "" else "s",
				entry.totalAdopted,
				entry.totalBorrowed,
				entry.totalWatches,
				if entry.totalWatches == 1 then "" else "es",
				entry.totalCleanups,
				if entry.totalCleanups == 1 then "" else "s",
				entry.descendants,
				if entry.descendants == 1 then "" else "s"
			)
		)
	end

	local parts: { string } = {}
	if entry.owned > 0 then
		table.insert(parts, ("%d owned node%s"):format(entry.owned, if entry.owned == 1 then "" else "s"))
	end
	if entry.adopted > 0 then
		table.insert(parts, ("%d adopted"):format(entry.adopted))
	end
	if entry.borrowed > 0 then
		table.insert(parts, ("%d borrowed"):format(entry.borrowed))
	end
	if entry.watches > 0 then
		table.insert(parts, ("%d watch%s"):format(entry.watches, if entry.watches == 1 then "" else "es"))
	end
	if entry.cleanups > 0 then
		table.insert(parts, ("%d cleanup%s"):format(entry.cleanups, if entry.cleanups == 1 then "" else "s"))
	end
	if #entry.children > 0 then
		table.insert(parts, ("%d child owner%s"):format(#entry.children, if #entry.children == 1 then "" else "s"))
	end
	if #parts > 0 then
		line(out, ("%s  %s"):format(indent(depth), table.concat(parts, ", ")))
	end
	if entry.unclassified > 0 then
		line(
			out,
			("%s  %d unclassified -- registered before the inspector started, or a kind it does "):format(
				indent(depth),
				entry.unclassified
			) .. "not track"
		)
	end

	for _, subject in entry.children do
		renderOwner(out, subject, depth + 1)
	end
end

local function format(report: Report): string
	if not report.active then
		return "compose inspect: not running\n"
	end

	local out: { string } = {}
	line(
		out,
		("compose inspect: %d outstanding mount(s), %d node(s) with recorded custody, %d pending"):format(
			report.outstandingMounts,
			report.trackedNodes,
			report.pending
		)
	)
	if report.droppedOwners > 0 or report.droppedNodes > 0 then
		line(
			out,
			("  capture dropped at the cap: %d owner(s), %d node(s); counts below are incomplete"):format(
				report.droppedOwners,
				report.droppedNodes
			)
		)
	end
	line(out, "")

	if #report.mounts == 0 then
		line(out, "mounts: none")
	else
		line(out, "mounts:")
		for _, entry in report.mounts do
			renderOwner(out, entry, 1)
		end
	end

	if #report.detached > 0 then
		line(out, "")
		line(out, "owners held outside any mount:")
		for _, entry in report.detached do
			renderOwner(out, entry, 1)
		end
	end

	return table.concat(out, "\n") .. "\n"
end

local function data(report: Report): Data
	local function shape(entry: OwnerReport): OwnerReport
		local children = table.create(#entry.children) :: { OwnerReport }
		for index, subject in entry.children do
			children[index] = shape(subject)
		end
		return {
			id = entry.id,
			label = entry.label,
			holding = entry.holding,
			disposed = entry.disposed,
			owned = entry.owned,
			adopted = entry.adopted,
			borrowed = entry.borrowed,
			watches = entry.watches,
			cleanups = entry.cleanups,
			unclassified = entry.unclassified,
			totalHolding = entry.totalHolding,
			totalOwned = entry.totalOwned,
			totalAdopted = entry.totalAdopted,
			totalBorrowed = entry.totalBorrowed,
			totalWatches = entry.totalWatches,
			totalCleanups = entry.totalCleanups,
			descendants = entry.descendants,
			children = children,
		}
	end
	local mounts = table.create(#report.mounts) :: { OwnerReport }
	for index, entry in report.mounts do
		mounts[index] = shape(entry)
	end
	local detached = table.create(#report.detached) :: { OwnerReport }
	for index, entry in report.detached do
		detached[index] = shape(entry)
	end
	return {
		schemaVersion = 1,
		active = report.active,
		outstandingMounts = report.outstandingMounts,
		trackedNodes = report.trackedNodes,
		pending = report.pending,
		droppedOwners = report.droppedOwners,
		droppedNodes = report.droppedNodes,
		mounts = mounts,
		detached = detached,
	}
end

return {
	snapshot = snapshot,
	node = node,
	owner = owner,
	owned = owned,
	format = format,
	data = data,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="274">
                  <Properties>
                    <string name="Name">root-scope</string>
                    <string name="Source"><![CDATA[--!strict

local Active = require "./active"
local Diagnostics = require "../diagnostics"
local Owner = require "./owner"
local Reactor = require "../reactive/reactor"
local Types = require "../reactive/types"

type Dispose = Types.Dispose

export type RootScope = {
	owner: Owner.Owner,

	dispose: Dispose,
}

local function requireBody(body: unknown, operation: string)
	if type(body) ~= "function" then
		Diagnostics.raise(
			"owner/root-body-not-a-function",
			("%s expects a function to run in the root scope"):format(operation),
			{
				actual = Diagnostics.describe(body),
				expected = "a function taking the root owner",
				contract = "a root scope exists to give one body an owner; there is nothing else to run",
			}
		)
	end
end

local function unwind(owner: Owner.Owner, failure: unknown): never
	local ok, disposeError: unknown = pcall(owner.dispose)
	if ok then
		return error(failure, 0) :: never
	end
	return error(
		("%s\nCompose: the root scope also raised while unwinding it:\n%s"):format(
			tostring(failure),
			tostring(disposeError)
		),
		0
	) :: never
end

local function settle<T...>(owner: Owner.Owner, ok: boolean, ...: T...): T...
	if not ok then
		unwind(owner, (select(1, ...)))
	end
	owner.dispose()
	return ...
end

local function withRootOwner<T...>(body: (owner: Owner.Owner) -> T..., reactor: Reactor.Reactor?): T...
	requireBody(body, "withRootOwner")
	local owner = Owner.createOwner(reactor)
	return settle(
		owner,
		pcall(Active.withOwner, owner, function(): T...
			return body(owner)
		end)
	)
end

local function createRootOwner(body: (owner: Owner.Owner) -> (), reactor: Reactor.Reactor?): RootScope
	requireBody(body, "createRootOwner")
	local owner = Owner.createOwner(reactor)
	local ok, err: unknown = pcall(Active.runWith, owner, body, owner)
	if not ok then
		unwind(owner, err)
	end
	return {
		owner = owner,
		dispose = owner.dispose,
	}
end

return {
	withRootOwner = withRootOwner,
	createRootOwner = createRootOwner,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="275">
                  <Properties>
                    <string name="Name">root</string>
                    <string name="Source"><![CDATA[--!strict

local Owner = require "./owner"

local root = Owner.createOwner()

local function hold(dispose: () -> ()): () -> ()
	return root.own(dispose)
end

local function size(): number
	return root.size()
end

local function disposeAll()
	root.dispose()
	root = Owner.createOwner()
end

return {
	hold = hold,
	size = size,
	disposeAll = disposeAll,
}
]]></string>
                  </Properties>
                </Item>
              </Item>
              <Item class="ModuleScript" referent="276">
                <Properties>
                  <string name="Name">pool</string>
                  <string name="Source"><![CDATA[--!strict

local Active = require "./ownership/active"
local Diagnostics = require "./diagnostics"
local Owner = require "./ownership/owner"

export type Lease<T> = {
	value: T,
	release: () -> (),
}

export type Pool<T> = {
	acquire: () -> Lease<T>,
	idle: () -> number,
	active: () -> number,
}

export type Options<T> = {
	create: () -> T,
	destroy: (value: T) -> (),
	reset: ((value: T) -> ())?,
	maxRetained: number,
}

local KNOWN_FIELDS: { [string]: true } = {
	create = true,
	destroy = true,
	reset = true,
	maxRetained = true,
}

local function createPool<T>(options: Options<T>): Pool<T>
	if type(options) ~= "table" or type(options.create) ~= "function" or type(options.destroy) ~= "function" then
		Diagnostics.raise("pool/invalid-options", "createPool needs create and destroy functions", {
			expected = "{ create = function, destroy = function, maxRetained = finite number, reset? = function }",
		})
	end
	for field in (options :: unknown) :: { [string]: unknown } do
		if KNOWN_FIELDS[field] == nil then
			Diagnostics.raise("pool/unknown-option", "createPool was given an option it does not have", {
				option = tostring(field),
				expected = "create, destroy, maxRetained, reset",
			})
		end
	end
	if options.reset ~= nil and type(options.reset) ~= "function" then
		Diagnostics.raise("pool/invalid-reset", "createPool.reset must be a function", {
			actual = Diagnostics.describe(options.reset),
		})
	end
	local owner = Active.current()
	if owner == nil then
		Diagnostics.raise("pool/no-active-owner", "createPool ran outside an owner", {
			contract = "a pool cannot outlive the owner responsible for its resources",
			fix = "create it inside a component or Compose.withOwner(owner, ...)",
		})
	end
	if
		type(options.maxRetained) ~= "number"
		or options.maxRetained ~= options.maxRetained
		or options.maxRetained < 0
		or math.abs(options.maxRetained) == math.huge
	then
		Diagnostics.raise("pool/invalid-limit", "createPool.maxRetained must be a finite non-negative number", {
			actual = Diagnostics.describe(options.maxRetained),
			contract = "a pool always has an explicit retained-memory bound",
		})
	end
	local maximum = math.floor(options.maxRetained)
	local idle: { T } = {}
	local active: { [Lease<T>]: T } = {}
	local disposed = false

	local function destroyAll()
		disposed = true
		local errors: { string } = {}
		for _, value in idle do
			local ok, err = pcall(function(): unknown?
				options.destroy(value)
				return nil
			end)
			if not ok then
				errors[#errors + 1] = tostring(err)
			end
		end
		for _, value in active do
			local ok, err = pcall(function(): unknown?
				options.destroy(value)
				return nil
			end)
			if not ok then
				errors[#errors + 1] = tostring(err)
			end
		end
		table.clear(idle)
		table.clear(active)
		if #errors > 0 then
			error(("Compose: %d pool resource destroy failures: %s"):format(#errors, table.concat(errors, "; ")), 0)
		end
	end
	(owner :: Owner.Owner).own(destroyAll)

	local function acquire(): Lease<T>
		if disposed then
			Diagnostics.raise("pool/disposed", "a disposed pool cannot acquire resources", {
				contract = "the pool shares its owner's lifetime",
			})
		end
		local value: T
		if #idle > 0 then
			value = table.remove(idle) :: T
		else
			value = options.create()
		end
		local lease: Lease<T>
		local released = false
		local function release()
			if released then
				return
			end
			released = true
			active[lease] = nil
			if disposed then
				return
			end
			if options.reset ~= nil then
				local ok, err = pcall(function(): unknown?
					(options.reset :: (T) -> ())(value)
					return nil
				end)
				if not ok then
					options.destroy(value)
					error(err, 0)
				end
			end
			if #idle < maximum then
				idle[#idle + 1] = value
			else
				options.destroy(value)
			end
		end
		lease = { value = value, release = release }
		active[lease] = value
		return lease
	end

	return {
		acquire = acquire,
		idle = function()
			return #idle
		end,
		active = function()
			local count = 0
			for _ in active do
				count += 1
			end
			return count
		end,
	}
end

return createPool
]]></string>
                </Properties>
              </Item>
              <Item class="Folder" referent="277">
                <Properties>
                  <string name="Name">reactive</string>
                </Properties>
                <Item class="ModuleScript" referent="278">
                  <Properties>
                    <string name="Name">cell</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local Graph = require "./graph"
local Types = require "./types"
local clock = require "./clock"
local stats = require "./stats"
local statsOn = stats.state
local EDGE_CONSUMER = Graph.CONSUMER
local EDGE_NEXT = Graph.NEXT
local CLEAN = Graph.CLEAN
local CHECK = Graph.CHECK
local DIRTY = Graph.DIRTY
local markStale = Graph.markStale
local settleTouched = Graph.settleTouched
local clockState = clock.state
local profile = require "./profile"
local userSpace = require "./userSpace"

type Cell<T> = Types.Cell<T>
type Equals<T> = Types.Equals<T>
type Initial<T> = Types.Initial<T>
type Edge = Graph.Edge
type Consumer = Graph.Consumer
type Producer = Graph.Producer

type CellNode = {
	version: number,
	subscribers: Edge?,
	lastSubscriber: Edge?,
	refresh: ((Producer) -> ()) | false,
	derived: boolean?,
	value: unknown,
	initial: Initial<unknown>?,
	compare: Equals<unknown> | false,
}

local function defaultEquals<T>(current: T, incoming: T): boolean
	return current == incoming
end

local CELL = {}
CELL.__index = CELL
CELL.derived = false

local READABLE = CELL

local UNSET = newproxy(false)

local validationState = userSpace.state

local function cell<T>(initial: Initial<T>, equals: Equals<T>?): Cell<T>
	local self = setmetatable({
		version = 0,
		subscribers = false :: false | Edge?,
		lastSubscriber = false :: false | Edge?,
		refresh = CELL.refresh,
		set = CELL.set,
		value = UNSET :: unknown,
		initial = initial :: Initial<unknown>,
		compare = (equals :: Equals<unknown>?) or false,
	}, CELL)

	self.subscribers = nil
	self.lastSubscriber = nil
	local node = (self :: unknown) :: CellNode
	return (node :: unknown) :: Cell<T>
end

local function start(self: CellNode)
	local initial = self.initial
	self.initial = nil
	self.value = if type(initial) == "function" then userSpace.call(initial :: () -> unknown) else initial
	self.version = clock.next()

	self.refresh = false
end

function CELL.refresh(producer: Producer)
	local self = producer :: CellNode
	if self.value == UNSET then
		start(self)
	end
end

function CELL.peek(self: CellNode): unknown
	if self.value == UNSET then
		start(self)
	end
	return self.value
end

function CELL.set(self: CellNode, incoming: unknown)
	local current = self.value
	if current == UNSET then
		start(self)
		current = self.value
	end

	local compare = self.compare
	local unchanged = if not compare and not validationState.validating
		then current == incoming
		else userSpace.call((compare or defaultEquals) :: Equals<unknown>, current, incoming)

	local statsEnabled = statsOn.enabled
	if unchanged then
		if statsEnabled then
			stats.bump "cellWritesSuppressed"
			profile.write(self, true)
		end
		return
	end

	self.value = incoming
	local version = clockState.now + 1
	clockState.now = version
	self.version = version
	if statsEnabled then
		stats.bump "cellWrites"
		Graph.countNotification(self)
		profile.write(self, false)
	end

	local edge = self.subscribers
	if edge == nil then
		return
	end

	if edge[EDGE_NEXT] == nil and not statsEnabled then
		local node = edge[EDGE_CONSUMER] :: Consumer
		local consumer: Consumer = node
		local state = consumer.state
		if state == CLEAN or consumer.retry then
			consumer.retry = false
			consumer.state = DIRTY

			local settleQueue = consumer.enqueueSettle
			if settleQueue then
				(settleQueue :: (Consumer) -> ())(consumer)
				return
			end
			if consumer.derived then
				markStale((node :: unknown) :: Producer, CHECK)
			end

			local enqueue = consumer.enqueue
			if enqueue then
				(enqueue :: (Consumer) -> ())(consumer)
			end
			settleTouched()
		elseif state == CHECK then
			consumer.state = DIRTY
		end
		return
	end

	Graph.markStale(self, Graph.DIRTY)
	Graph.settleTouched()
end

function CELL.update(self: CellNode, change: (unknown) -> unknown)
	if self.value == UNSET then
		start(self)
	end
	CELL.set(self, userSpace.call(change, self.value))
end

CELL.__isComposeReadable = true

local SHARED = table.clone(CELL)
SHARED.__index = SHARED
SHARED.shared = true

local function sharedCell<T>(initial: Initial<T>, equals: Equals<T>?): Cell<T>
	local self: Cell<T> = cell(initial, equals)
	setmetatable(self, SHARED)
	return (self :: unknown) :: Cell<T>
end

local function isReadable(value: unknown): boolean
	if type(value) ~= "table" then
		return false
	end
	local metatableOf = (getmetatable :: unknown) :: (unknown) -> { [string]: unknown }?
	local meta = metatableOf(value)
	return meta ~= nil and rawget(meta, "__isComposeReadable") == true
end

return {
	cell = cell,
	sharedCell = sharedCell,
	defaultEquals = defaultEquals,
	isReadable = isReadable,
	READABLE = READABLE,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="279">
                  <Properties>
                    <string name="Name">clock</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local state = { now = 0 }

local function next(): number
	local value = state.now + 1
	state.now = value
	return value
end

local function current(): number
	return state.now
end

local function reset()
	state.now = 0
end

return {
	next = next,
	current = current,
	reset = reset,
	state = state,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="280">
                  <Properties>
                    <string name="Name">formula</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local Graph = require "./graph"
local Diagnostics = require "../diagnostics"
local Types = require "./types"
local cellModule = require "./cell"
local clock = require "./clock"
local stats = require "./stats"
local statsOn = stats.state
local profile = require "./profile"
local userSpace = require "./userSpace"

type Formula<T> = Types.Formula<T>
type Equals<T> = Types.Equals<T>
type Body<T> = Types.Body<T>
type Edge = Graph.Edge
type Consumer = Graph.Consumer
type Producer = Graph.Producer

type FormulaNode = {
	version: number,
	subscribers: Edge?,
	lastSubscriber: Edge?,
	refresh: ((Producer) -> ()) | false,
	derived: boolean?,

	state: number,
	dependencies: { Edge },
	reads: number,
	enqueue: ((Consumer) -> ()) | false | nil,
	enqueueSettle: ((Consumer) -> ()) | false | nil,
	released: boolean,
	retry: boolean?,

	value: unknown,
	body: Body<unknown>?,
	compare: Equals<unknown> | false | nil,
}

local FORMULA = {}
FORMULA.__index = FORMULA
FORMULA.__isComposeReadable = true
FORMULA.derived = true

FORMULA.compare = false

local validationState = userSpace.state

local function requireLive(self: FormulaNode)
	if self.released then
		Diagnostics.raise("reactive/disposed-formula", "a disposed formula cannot be read", {
			contract = "formula disposal permanently releases its dependencies",
			fix = "keep reads within the formula lifetime, or create a new formula",
		})
	end
end

function FORMULA.dispose(self: FormulaNode)
	Graph.release(self)
	self.body = nil
	self.compare = nil
	self.value = nil
end

function FORMULA.refresh(producer: Producer)
	local self = producer :: FormulaNode
	requireLive(self)
	local state = self.state
	if state == Graph.CLEAN then
		return
	end

	if state == Graph.CHECK then
		self.state = Graph.DIRTY
		self.retry = true
		local moved = Graph.dependenciesMoved(self)
		self.retry = false
		if not moved then
			self.state = Graph.CLEAN
			return
		end
	end

	self.state = Graph.CLEAN
	local incoming = Graph.evaluate(self, FORMULA.invoke, self)
	requireLive(self)
	if statsOn.enabled then
		stats.bump "formulaRecomputations"
		profile.recompute(self)
	end

	local compare = self.compare
	local unchanged = if not compare and not validationState.validating
		then self.value == incoming
		else userSpace.call((compare or cellModule.defaultEquals) :: Equals<unknown>, self.value, incoming)
	if unchanged then
		if statsOn.enabled then
			stats.bump "formulaRecomputationsSuppressed"
			profile.suppressedRecompute(self)
		end
		return
	end

	self.value = incoming
	self.version = clock.next()
end

function FORMULA.invoke(self: FormulaNode): unknown
	return (self.body :: Body<unknown>)(Graph.use)
end

function FORMULA.peek(self: FormulaNode): unknown
	FORMULA.refresh(self)
	return self.value
end

local function formula<T>(body: Body<T>, equals: Equals<T>?): Formula<T>
	local self = setmetatable({
		version = 0,
		subscribers = false :: false | Graph.Edge?,
		lastSubscriber = false :: false | Graph.Edge?,
		state = Graph.DIRTY,
		released = false,
		dependencies = {} :: { Graph.Edge },
		reads = 0,
		value = false :: unknown,
		body = body :: Body<unknown>,
	}, FORMULA)
	self.subscribers = nil
	self.lastSubscriber = nil
	self.value = nil
	if equals ~= nil then
		((self :: unknown) :: FormulaNode).compare = equals :: Equals<unknown>
	end
	local node = (self :: unknown) :: FormulaNode
	return (node :: unknown) :: Formula<T>
end

return formula
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="281">
                  <Properties>
                    <string name="Name">graph</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local Diagnostics = require "../diagnostics"
local Types = require "./types"
local profile = require "./profile"
local stats = require "./stats"
local statsOn = stats.state
local userSpace = require "./userSpace"
local validationState = userSpace.state
local metatableOf = (getmetatable :: unknown) :: (unknown) -> unknown

local CLEAN = 0
local CHECK = 1
local DIRTY = 2

export type Edge = { Producer | Consumer | number | Edge | nil }

export type Producer = {

	version: number,

	subscribers: Edge?,
	lastSubscriber: Edge?,

	refresh: ((Producer) -> ()) | false,

	derived: boolean?,
}

export type Held<T> = Producer & {
	value: T,
}

export type Consumer = {
	state: number,

	dependencies: { Edge },
	reads: number,
	enqueue: ((Consumer) -> ()) | false | nil,
	enqueueSettle: ((Consumer) -> ()) | false | nil,
	released: boolean,
	retry: boolean?,
	derived: boolean?,
}

export type Scheduled = Consumer & {
	queued: boolean,
	run: (self: Scheduled) -> ...unknown,
}

export type Tracked = Consumer & {
	body: (use: Types.Use) -> (),
}

export type Reactor = {

	batch: <T...>(self: Reactor, body: () -> T...) -> T...,

	settle: (self: Reactor) -> (),
	pending: (self: Reactor) -> number,
	__enqueue: (self: Reactor, consumer: Consumer) -> (),
	__enqueueConsumer: (consumer: Consumer) -> (),
	__enqueueSettleConsumer: (consumer: Consumer) -> (),

	__reset: (self: Reactor) -> (),
}

local PRODUCER, CONSUMER, OBSERVED, PREVIOUS, NEXT = 1, 2, 3, 4, 5

type Evaluation = { consumer: Consumer?, order: number }

local evaluations = (
	setmetatable({} :: { [thread]: Evaluation? }, { __mode = "k" }) :: unknown
) :: { [thread]: Evaluation? }
local evaluationOrder = 0

local function evaluationContext(): Consumer?
	local running = coroutine.running()
	local own = evaluations[running]
	if own ~= nil then
		return own.consumer
	end
	local inherited: Evaluation? = nil
	for thread, context in evaluations do
		if
			context ~= nil
			and coroutine.status(thread) == "normal"
			and (inherited == nil or context.order > inherited.order)
		then
			inherited = context
		end
	end
	return if inherited ~= nil then inherited.consumer else nil
end

local function activateEvaluation(consumer: Consumer?)
	evaluationOrder += 1
	evaluations[coroutine.running()] = { consumer = consumer, order = evaluationOrder }
end

local function captureEvaluationContext(): Evaluation?
	return evaluations[coroutine.running()]
end

local function restoreEvaluationContext(previous: Evaluation?)
	evaluations[coroutine.running()] = previous
end

local touched: { Reactor } = {}
local touchedCount = 0

local function attach(producer: Producer, consumer: Consumer): Edge
	local tail = producer.lastSubscriber
	local edge: Edge = { producer, consumer, producer.version, tail, nil }
	if tail ~= nil then
		tail[NEXT] = edge
	else
		producer.subscribers = edge
	end
	producer.lastSubscriber = edge
	return edge
end

local function detach(edge: Edge)
	local previous = edge[PREVIOUS] :: Edge?
	local following = edge[NEXT] :: Edge?
	local producer = edge[PRODUCER] :: Producer
	if previous ~= nil then
		previous[NEXT] = following
	else
		producer.subscribers = following
	end
	if following ~= nil then
		following[PREVIOUS] = previous
	else
		producer.lastSubscriber = previous
	end
	edge[PREVIOUS] = nil
	edge[NEXT] = nil
end

local function trim(consumer: Consumer, from: number)
	local dependencies = consumer.dependencies
	for index = #dependencies, from, -1 do
		detach(dependencies[index])
		dependencies[index] = nil
	end
end

local function markStale(producer: Producer, state: number)
	if statsOn.enabled then
		local kind = if producer.derived then "formula" else "cell"
		local recorded = producer.subscribers
		while recorded ~= nil do
			profile.edge(producer, kind, recorded[CONSUMER] :: Consumer)
			recorded = recorded[NEXT] :: Edge?
		end
	end

	local edge = producer.subscribers
	while edge ~= nil do
		local consumer: Consumer = edge[CONSUMER] :: Consumer
		if consumer.state < state or consumer.retry then
			local wasClean = consumer.state == CLEAN or consumer.retry
			consumer.retry = false
			consumer.state = state
			if wasClean then
				if consumer.derived then
					markStale(edge[CONSUMER] :: Producer, CHECK)
				end
				local enqueue = consumer.enqueue

				if enqueue then
					(enqueue :: (Consumer) -> ())(consumer)
				end
			end
		end
		edge = edge[NEXT] :: Edge?
	end
end

local function touch(reactor: Reactor)
	for index = 1, touchedCount do
		if touched[index] == reactor then
			return
		end
	end
	touchedCount += 1
	touched[touchedCount] = reactor
end

local function settleTouched()
	if touchedCount == 0 then
		return
	end
	local count = touchedCount
	touchedCount = 0

	if count == 1 then
		local only = touched[1]
		touched[1] = nil
		only:settle()
		return
	end

	local errors: { string }? = nil
	for index = 1, count do
		local reactor = touched[index]
		touched[index] = nil
		local ok, err: unknown = pcall(reactor.settle, reactor)
		if not ok then
			if errors == nil then
				errors = {}
			end
			table.insert(errors :: { string }, tostring(err))
		end
	end

	local failures = errors
	if failures == nil then
		return
	end
	if #failures == 1 then
		error(failures[1], 0)
	end
	local parts = { ("Compose: %d scheduling domains failed while settling one write:"):format(#failures) }
	for index, message in failures do
		table.insert(parts, ("  [%d] %s"):format(index, message))
	end
	error(table.concat(parts, "\n"), 0)
end

local function recordThenRefresh(consumer: Consumer, producer: Producer)
	if consumer.released then
		local refresh = producer.refresh
		if refresh then
			(refresh :: (Producer) -> ())(producer)
		end
		return
	end

	local at = consumer.reads
	local dependencies = consumer.dependencies
	local edge = dependencies[at]
	if edge == nil or edge[PRODUCER] ~= producer then
		at += 1
		consumer.reads = at
		edge = dependencies[at]
		if edge == nil or edge[PRODUCER] ~= producer then
			trim(consumer, at)
			edge = attach(producer, consumer)
			dependencies[at] = edge
		end
	end

	local refresh = producer.refresh
	if refresh then
		(refresh :: (Producer) -> ())(producer)
	end
	edge[OBSERVED] = producer.version
end

local function observe(producer: Producer)
	local consumer = evaluationContext()
	if consumer == nil then
		Diagnostics.raise("reactive/no-evaluation", "use() was called outside a reactive body", {
			contract = "use reads a cell or formula and records a dependency, which only means "
				.. "something while a formula, watch, or bound property is evaluating",
			fix = "read it with :peek() outside a reactive body, or move the read inside one",
		})
		return
	end

	recordThenRefresh(consumer :: Consumer, producer)
end

local function dependenciesMoved(consumer: Consumer): boolean
	local dependencies = consumer.dependencies
	for index = 1, #dependencies do
		local edge = dependencies[index]
		local producer: Producer = edge[PRODUCER] :: Producer
		local refresh = producer.refresh
		if refresh then
			(refresh :: (Producer) -> ())(producer)
		end
		if producer.version ~= edge[OBSERVED] then
			return true
		end
	end
	return false
end

local function evaluate<A, T>(consumer: Consumer, body: (A) -> T, argument: A): T
	local running = coroutine.running()
	local previous = evaluations[running]
	activateEvaluation(consumer)
	consumer.reads = 0

	local ok, result
	if validationState.validating then
		ok, result = pcall(userSpace.call, body, argument)
	else
		ok, result = pcall(body, argument)
	end

	evaluations[running] = previous
	if not ok then
		if consumer.derived then
			consumer.state = DIRTY
			consumer.retry = true
		end
		error(result, 0)
	end

	trim(consumer, consumer.reads + 1)
	return result :: T
end

local function beginEvaluation(consumer: Consumer): Evaluation?
	local previous = captureEvaluationContext()
	activateEvaluation(consumer)
	consumer.reads = 0
	return previous
end

local function finishEvaluation(consumer: Consumer, previous: Evaluation?)
	restoreEvaluationContext(previous)
	local dependencies = consumer.dependencies
	local from = consumer.reads + 1
	for index = #dependencies, from, -1 do
		detach(dependencies[index])
		dependencies[index] = nil
	end
end

local function release(consumer: Consumer)
	if consumer.released then
		return
	end
	consumer.released = true
	trim(consumer, 1)
	consumer.state = CLEAN
end

local function rearm(consumer: Consumer)
	if consumer.released or consumer.retry then
		return
	end
	consumer.retry = true
	for _, edge in consumer.dependencies do
		local producer = edge[PRODUCER] :: Producer
		if producer.derived then
			rearm((producer :: unknown) :: Consumer)
		end
	end
end

local function subscriberCount(producer: Producer): number
	local total = 0
	local edge = producer.subscribers
	while edge ~= nil do
		total += 1
		edge = edge[NEXT] :: Edge?
	end
	return total
end

local function untracked<T>(body: () -> T): T
	local running = coroutine.running()
	local previous = evaluations[running]
	activateEvaluation(nil)
	local ok, result = pcall(body)
	evaluations[running] = previous
	if not ok then
		error(result, 0)
	end
	return result :: T
end

local function notANode(api: string, value: unknown): never
	local actual = Diagnostics.describe(value)
	Diagnostics.raise(
		"reactive/not-a-node",
		("%s was given a %s where a cell or formula was expected"):format(api, actual),
		{
			actual = actual,
			expected = "a cell or a formula",
			contract = ("%s records a dependency on a node the graph owns, and only a cell or a formula is one"):format(
				api
			),
			fix = "a body is called, not read: write source(use) rather than use(source), or wrap it once with Compose.formula(source)",
		}
	)
	error("unreachable", 0)
end

local function use<T>(readable: Types.Readable<T>): T
	local producer = (readable :: unknown) :: Held<T>
	if type(producer) ~= "table" or metatableOf(readable) == nil then
		notANode("use", producer)
	end
	local consumer = evaluationContext()
	if consumer == nil then
		observe(producer)
		return producer.value
	end

	recordThenRefresh(consumer, producer)
	return producer.value
end

local function runTracked(consumer: Tracked)
	local previous = captureEvaluationContext()
	activateEvaluation(consumer)
	consumer.reads = 0

	if validationState.validating then
		userSpace.call(consumer.body, use)
	else
		consumer.body(use)
	end

	restoreEvaluationContext(previous)
	local dependencies = consumer.dependencies
	for index = #dependencies, consumer.reads + 1, -1 do
		detach(dependencies[index])
		dependencies[index] = nil
	end
end

local function countNotification(producer: Producer)
	if statsOn.enabled then
		local count = subscriberCount(producer)
		stats.bump("notifications", count)
		profile.wake(producer, if producer.derived then "formula" else "cell", count)
	end
end

return {
	PRODUCER = PRODUCER,
	CONSUMER = CONSUMER,
	OBSERVED = OBSERVED,
	PREVIOUS = PREVIOUS,
	NEXT = NEXT,
	CLEAN = CLEAN,
	CHECK = CHECK,
	DIRTY = DIRTY,
	attach = attach,
	detach = detach,
	trim = trim,
	markStale = markStale,
	notANode = notANode,
	observe = observe,
	dependenciesMoved = dependenciesMoved,
	evaluate = evaluate,
	beginEvaluation = beginEvaluation,
	finishEvaluation = finishEvaluation,
	evaluationContext = evaluationContext,
	captureEvaluationContext = captureEvaluationContext,
	restoreEvaluationContext = restoreEvaluationContext,
	runTracked = runTracked,
	release = release,
	rearm = rearm,
	subscriberCount = subscriberCount,
	untracked = untracked,
	use = use,
	touch = touch,
	settleTouched = settleTouched,
	countNotification = countNotification,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="282">
                  <Properties>
                    <string name="Name">profile</string>
                    <string name="Source"><![CDATA[--!strict

local Weak = require "../weak"
local stats = require "./stats"

export type Options = {
	maxNodes: number?,
	maxDrains: number?,
}

export type NodeRow = {
	id: number,
	kind: string,
	label: string?,
	writes: number,
	writesSuppressed: number,
	recomputations: number,
	recomputationsSuppressed: number,
	runs: number,
	schedules: number,
	schedulesCoalesced: number,
	hostWrites: number,
	peakFanOut: number,

	wakes: { [number]: number },
}

export type DrainRow = {
	runs: number,
	seconds: number,
	cause: string?,
}

export type Report = {
	active: boolean,
	seconds: number,
	nodes: { NodeRow },
	drains: { DrainRow },

	droppedRecords: number,
	totals: { [string]: number },
}

export type WakeData = {
	to: number,
	count: number,
}

export type NodeData = {
	id: number,
	kind: string,
	label: string?,
	name: string,
	writes: number,
	writesSuppressed: number,
	recomputations: number,
	recomputationsPublished: number,
	runs: number,
	schedules: number,
	schedulesCoalesced: number,
	hostWrites: number,
	peakFanOut: number,
	wakes: { WakeData },
}

export type DrainData = {
	runs: number,
	seconds: number,
	cause: string?,
}

export type Data = {
	schemaVersion: number,
	active: boolean,
	seconds: number,
	droppedRecords: number,
	totals: { [string]: number },
	nodes: { NodeData },
	drains: { DrainData },
}

type Shape = {
	derived: boolean?,
	enqueue: unknown,
}

local DEFAULT_MAX_NODES = 4096
local DEFAULT_MAX_DRAINS = 256
local MAX_WAKE_TARGETS = 32

local UNKNOWN_KIND = "node"

local function kindOf(node: unknown): string
	local shape = node :: Shape
	local derived = shape.derived
	if derived == true then
		return "formula"
	elseif derived == false then
		return "cell"
	elseif shape.enqueue ~= nil then
		return "watch"
	end
	return UNKNOWN_KIND
end

type State = {
	rows: { [unknown]: NodeRow },
	ordered: { NodeRow },
	nextId: number,
	droppedRecords: number,
	maxNodes: number,
	maxDrains: number,
	drains: { DrainRow },
	drainCursor: number,
	startedAt: number,
	cause: string?,
	running: NodeRow?,
	pendingLabel: string?,

	broken: boolean,
}

local state: State? = nil

local restoreCounters = false
local clock: (() -> number)? = nil

local function rowFor(node: unknown, kind: string): NodeRow?
	local held = state
	if held == nil then
		return nil
	end
	local existing = held.rows[node]
	if existing ~= nil then
		if existing.kind == UNKNOWN_KIND and kind ~= UNKNOWN_KIND then
			existing.kind = kind
		end
		return existing
	end
	if #held.ordered >= held.maxNodes then
		held.droppedRecords += 1
		return nil
	end
	held.nextId += 1
	local row: NodeRow = {
		id = held.nextId,
		kind = kind,
		label = nil,
		writes = 0,
		writesSuppressed = 0,
		recomputations = 0,
		recomputationsSuppressed = 0,
		runs = 0,
		schedules = 0,
		schedulesCoalesced = 0,
		hostWrites = 0,
		peakFanOut = 0,
		wakes = {},
	}
	held.rows[node] = row
	table.insert(held.ordered, row)
	return row
end

local function guarded(body: () -> ())
	local held = state
	if held == nil or held.broken then
		return
	end
	local ok = pcall(body)
	if not ok then
		held.broken = true
	end
end

local function write(cell: unknown, suppressed: boolean)
	guarded(function()
		local row = rowFor(cell, "cell")
		if row == nil then
			return
		end
		if suppressed then
			row.writesSuppressed += 1
		else
			row.writes += 1
			(state :: State).cause = row.label or ("cell#%d"):format(row.id)
		end
	end)
end

local function wake(producer: unknown, kind: string, count: number)
	guarded(function()
		local row = rowFor(producer, kind)
		if row == nil then
			return
		end
		if count > row.peakFanOut then
			row.peakFanOut = count
		end
	end)
end

local function edge(producer: unknown, producerKind: string, consumer: unknown)
	guarded(function()
		local from = rowFor(producer, producerKind)
		local to = rowFor(consumer, kindOf(consumer))
		if from == nil or to == nil then
			return
		end
		local seen = from.wakes[to.id]
		if seen == nil then
			local count = 0
			for _ in from.wakes do
				count += 1
			end
			if count >= MAX_WAKE_TARGETS then
				return
			end
		end
		from.wakes[to.id] = (seen or 0) + 1
	end)
end

local function recompute(formula: unknown)
	guarded(function()
		local row = rowFor(formula, "formula")
		if row ~= nil then
			row.recomputations += 1
		end
	end)
end

local function suppressedRecompute(formula: unknown)
	guarded(function()
		local row = rowFor(formula, "formula")
		if row ~= nil then
			row.recomputationsSuppressed += 1
		end
	end)
end

local function schedule(watch: unknown, coalesced: boolean)
	guarded(function()
		local row = rowFor(watch, "watch")
		if row == nil then
			return
		end
		if coalesced then
			row.schedulesCoalesced += 1
		else
			row.schedules += 1
		end
	end)
end

local function enterRun(watch: unknown)
	local held = state
	if held == nil or held.broken then
		return
	end
	guarded(function()
		local row = rowFor(watch, "watch")
		if row == nil then
			return
		end
		row.runs += 1
		held.running = row
	end)
end

local function hostWrite()
	local held = state
	if held == nil or held.broken then
		return
	end
	local row = held.running
	if row ~= nil then
		row.hostWrites += 1
	end
end

local function drain(runs: number, seconds: number)
	guarded(function()
		local held = state :: State
		local row: DrainRow = { runs = runs, seconds = seconds, cause = held.cause }
		held.cause = nil
		if #held.drains < held.maxDrains then
			table.insert(held.drains, row)
		else
			held.drainCursor = (held.drainCursor % held.maxDrains) + 1
			held.drains[held.drainCursor] = row
		end
	end)
end

local function label(node: unknown, name: string)
	guarded(function()
		local row = rowFor(node, kindOf(node))
		if row ~= nil then
			row.label = name
		end
	end)
end

local function naming(name: string?)
	local held = state
	if held ~= nil and not held.broken then
		held.pendingLabel = name
	end
end

local function born(node: unknown, name: string?)
	guarded(function()
		local held = state :: State
		local row = rowFor(node, "watch")
		if row ~= nil and row.label == nil then
			row.label = name or held.pendingLabel
		end
	end)
end

local function isActive(): boolean
	return state ~= nil
end

local function start(now: () -> number, options: Options?)
	local settings: Options = options or ({} :: Options)
	restoreCounters = stats.state.enabled
	stats.setEnabled(true)
	clock = now
	state = {
		rows = Weak.keys() :: { [unknown]: NodeRow },
		ordered = {},
		nextId = 0,
		droppedRecords = 0,
		maxNodes = settings.maxNodes or DEFAULT_MAX_NODES,
		maxDrains = settings.maxDrains or DEFAULT_MAX_DRAINS,
		drains = {},
		drainCursor = 0,
		startedAt = now(),
		cause = nil,
		running = nil,
		pendingLabel = nil,
		broken = false,
	}
end

local function nowOrNil(): number?
	local reading = clock
	if state == nil or reading == nil then
		return nil
	end
	return reading()
end

local function stop(): Report
	local held = state
	local reading = clock
	state = nil
	clock = nil
	stats.setEnabled(restoreCounters)
	if held == nil then
		return {
			active = false,
			seconds = 0,
			nodes = {},
			drains = {},
			droppedRecords = 0,
			totals = {},
		}
	end

	local totals: { [string]: number } = {
		writes = 0,
		writesSuppressed = 0,
		recomputations = 0,
		recomputationsSuppressed = 0,
		runs = 0,
		schedules = 0,
		schedulesCoalesced = 0,
		hostWrites = 0,
	}
	for _, row in held.ordered do
		totals.writes += row.writes
		totals.writesSuppressed += row.writesSuppressed
		totals.recomputations += row.recomputations
		totals.recomputationsSuppressed += row.recomputationsSuppressed
		totals.runs += row.runs
		totals.schedules += row.schedules
		totals.schedulesCoalesced += row.schedulesCoalesced
		totals.hostWrites += row.hostWrites
	end
	totals.broken = if held.broken then 1 else 0

	return {
		active = true,
		seconds = if reading ~= nil then reading() - held.startedAt else 0,
		nodes = held.ordered,
		drains = held.drains,
		droppedRecords = held.droppedRecords,
		totals = totals,
	}
end

local function nameOf(row: NodeRow): string
	return row.label or ("%s#%d"):format(row.kind, row.id)
end

local function weight(row: NodeRow): number
	return row.writes + row.recomputations + row.runs + row.hostWrites
end

local function format(report: Report, limit: number?): string
	local out: { string } = {}
	local function line(text: string)
		table.insert(out, text)
	end

	if not report.active then
		return "compose profile: not running\n"
	end

	line(("compose profile: %.3f s, %d node(s) tracked"):format(report.seconds, #report.nodes))
	if report.droppedRecords > 0 then
		line(("  capture dropped %d time(s) at the node cap; counts are incomplete"):format(report.droppedRecords))
	end
	if (report.totals.broken or 0) > 0 then
		line "  the recorder failed part-way and stopped; counts below are incomplete"
	end
	line ""
	line(
		("  writes %d (%d suppressed) | recomputations %d (%d published) | watch runs %d | host writes %d"):format(
			report.totals.writes,
			report.totals.writesSuppressed,
			report.totals.recomputations,
			report.totals.recomputations - report.totals.recomputationsSuppressed,
			report.totals.runs,
			report.totals.hostWrites
		)
	)
	line(("  schedules %d (%d coalesced)"):format(report.totals.schedules, report.totals.schedulesCoalesced))
	line ""

	local ranked = table.clone(report.nodes)
	table.sort(ranked, function(left: NodeRow, right: NodeRow): boolean
		local a, b = weight(left), weight(right)
		if a == b then
			return left.id < right.id
		end
		return a > b
	end)

	local byId: { [number]: NodeRow } = {}
	for _, row in report.nodes do
		byId[row.id] = row
	end

	line "hottest:"
	local shown = limit or 12
	for index = 1, math.min(shown, #ranked) do
		local row = ranked[index]
		local parts: { string } = {}
		if row.writes > 0 then
			table.insert(parts, ("%d write%s"):format(row.writes, if row.writes == 1 then "" else "s"))
		end
		if row.writesSuppressed > 0 then
			table.insert(parts, ("%d suppressed"):format(row.writesSuppressed))
		end
		if row.recomputations > 0 then
			table.insert(
				parts,
				("%d recompute%s (%d published)"):format(
					row.recomputations,
					if row.recomputations == 1 then "" else "s",
					row.recomputations - row.recomputationsSuppressed
				)
			)
		end
		if row.runs > 0 then
			table.insert(parts, ("%d run%s"):format(row.runs, if row.runs == 1 then "" else "s"))
		end
		if row.schedulesCoalesced > 0 then
			table.insert(parts, ("%d coalesced"):format(row.schedulesCoalesced))
		end
		if row.hostWrites > 0 then
			table.insert(parts, ("%d host write%s"):format(row.hostWrites, if row.hostWrites == 1 then "" else "s"))
		end
		if row.peakFanOut > 0 then
			table.insert(parts, ("fan-out %d"):format(row.peakFanOut))
		end
		if #parts == 0 then
			table.insert(parts, "no recorded work")
		end
		line(("  %-34s %s"):format(nameOf(row), table.concat(parts, ", ")))

		local targets: { number } = {}
		for id in row.wakes do
			table.insert(targets, id)
		end
		table.sort(targets)
		for _, id in targets do
			local target = byId[id]
			if target ~= nil then
				line(("      -> %-30s x%d"):format(nameOf(target), row.wakes[id]))
			end
		end
	end

	if #report.drains > 0 then
		local sorted = table.clone(report.drains)
		table.sort(sorted, function(left: DrainRow, right: DrainRow): boolean
			return left.seconds > right.seconds
		end)
		line ""
		line(("longest drains (of %d recorded):"):format(#report.drains))
		for index = 1, math.min(5, #sorted) do
			local row = sorted[index]
			line(
				("  %8.3f ms  %d run%s  %s"):format(
					row.seconds * 1000,
					row.runs,
					if row.runs == 1 then "" else "s",
					row.cause or "cause not recorded"
				)
			)
		end
	end

	return table.concat(out, "\n") .. "\n"
end

local function data(report: Report): Data
	local nodes = table.create(#report.nodes) :: { NodeData }
	for index, row in report.nodes do
		local wakes: { WakeData } = {}
		local targets: { number } = {}
		for id in row.wakes do
			table.insert(targets, id)
		end
		table.sort(targets)
		for _, id in targets do
			table.insert(wakes, { to = id, count = row.wakes[id] })
		end
		nodes[index] = {
			id = row.id,
			kind = row.kind,
			label = row.label,
			name = nameOf(row),
			writes = row.writes,
			writesSuppressed = row.writesSuppressed,
			recomputations = row.recomputations,
			recomputationsPublished = row.recomputations - row.recomputationsSuppressed,
			runs = row.runs,
			schedules = row.schedules,
			schedulesCoalesced = row.schedulesCoalesced,
			hostWrites = row.hostWrites,
			peakFanOut = row.peakFanOut,
			wakes = wakes,
		}
	end
	local drains = table.create(#report.drains) :: { DrainData }
	for index, row in report.drains do
		drains[index] = { runs = row.runs, seconds = row.seconds, cause = row.cause }
	end
	return {
		schemaVersion = 1,
		active = report.active,
		seconds = report.seconds,
		droppedRecords = report.droppedRecords,
		totals = report.totals,
		nodes = nodes,
		drains = drains,
	}
end

return {
	start = start,
	stop = stop,
	label = label,
	isActive = isActive,
	format = format,
	data = data,

	write = write,
	wake = wake,
	edge = edge,
	recompute = recompute,
	suppressedRecompute = suppressedRecompute,
	schedule = schedule,
	enterRun = enterRun,
	hostWrite = hostWrite,
	drain = drain,
	naming = naming,
	born = born,
	nowOrNil = nowOrNil,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="283">
                  <Properties>
                    <string name="Name">reactor</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local Graph = require "./graph"
local profile = require "./profile"
local stats = require "./stats"
local statsOn = stats.state

export type Reactor = Graph.Reactor
type Consumer = Graph.Consumer
type Scheduled = Graph.Scheduled

local MAX_RUNS_PER_DRAIN = 1_000_000

local traceback = debug.traceback :: (message: string) -> string

local function describeErrors(errors: { string }): string
	if #errors == 1 then
		return errors[1]
	end
	local parts = { ("Compose: %d errors while running watches:"):format(#errors) }
	for index, message in errors do
		table.insert(parts, ("  [%d] %s"):format(index, message))
	end
	return table.concat(parts, "\n")
end

local function create(): Reactor
	local queue: { Scheduled } = {}
	local queueCount = 0
	local cursor = 0
	local batching = false
	local reactor: Reactor

	local drainErrors: { string }? = nil
	local drainAbandoned = false

	local function runRest(): ...unknown
		while cursor < queueCount do
			local limit = queueCount
			if limit > MAX_RUNS_PER_DRAIN then
				limit = MAX_RUNS_PER_DRAIN
			end
			while cursor < limit do
				cursor += 1
				local watch = queue[cursor]
				watch.queued = false
				watch.run(watch)
			end
			if cursor >= MAX_RUNS_PER_DRAIN then
				local errors: { string } = drainErrors or {}
				drainErrors = errors
				table.insert(
					errors,
					(
						"Compose: watch cascade did not settle after %d runs. A watch is very likely "
						.. "writing to a cell it also reads; break the loop, or write inside a batch "
						.. "that ends."
					):format(MAX_RUNS_PER_DRAIN)
				)
				drainAbandoned = true
				return
			end
		end
	end

	local function drain(): { string }?
		drainErrors = nil
		drainAbandoned = false
		local openedAt = if statsOn.enabled then profile.nowOrNil() else nil

		local context = Graph.captureEvaluationContext()
		repeat
			local ok, err = xpcall(runRest, traceback)
			if not ok then
				Graph.restoreEvaluationContext(context)
				local errors: { string } = drainErrors or {}
				drainErrors = errors
				table.insert(errors, tostring(err))
			end
		until drainAbandoned or cursor >= queueCount

		if statsOn.enabled then
			stats.bump("continuationPasses", cursor)
			if openedAt ~= nil then
				local closedAt = profile.nowOrNil()
				profile.drain(cursor, if closedAt ~= nil then closedAt - openedAt else 0)
			end
		end

		if drainAbandoned then
			for index = cursor + 1, queueCount do
				Graph.rearm(queue[index])
			end
			for index = queueCount, 1, -1 do
				queue[index].queued = false
				queue[index] = nil
			end
		else
			table.clear(queue)
		end
		queueCount = 0
		cursor = 0
		return drainErrors
	end

	local function finishBatch<T...>(ok: boolean, ...: T...): T...
		local errors = drain()
		batching = false

		if not ok then
			error(select(1, ...), 0)
		end
		if errors ~= nil then
			error(describeErrors(errors), 0)
		end
		return ...
	end

	local function batch<T...>(_self: Reactor, body: () -> T...): T...
		if batching then
			return body()
		end

		batching = true
		if statsOn.enabled then
			stats.bump "drains"
		end

		return finishBatch(xpcall(body, traceback))
	end

	local function settle(_self: Reactor)
		if batching or queueCount == 0 then
			return
		end

		batching = true
		if statsOn.enabled then
			stats.bump "drains"
		end
		local errors = drain()
		batching = false

		if errors ~= nil then
			error(describeErrors(errors), 0)
		end
	end

	local function pending(_self: Reactor): number
		return queueCount - cursor
	end

	local function enqueueConsumer(consumer: Consumer)
		local watch = consumer :: Scheduled
		if watch.queued then
			if statsOn.enabled then
				stats.bump "watchSchedulesCoalesced"
				profile.schedule(watch, true)
			end
			return
		end
		watch.queued = true
		queueCount += 1
		queue[queueCount] = watch
		if statsOn.enabled then
			stats.bump "watchSchedules"
			profile.schedule(watch, false)
		end

		if not batching then
			Graph.touch(reactor)
		end
	end

	local function enqueue(_self: Reactor, consumer: Consumer)
		enqueueConsumer(consumer)
	end

	local function enqueueSettleConsumer(consumer: Consumer)
		local watch = consumer :: Scheduled
		if batching or queueCount > 0 then
			if not watch.queued then
				watch.queued = true
				queueCount += 1
				queue[queueCount] = watch
			end
			return
		end

		batching = true
		local context = Graph.captureEvaluationContext()
		local ok, err = xpcall(watch.run, traceback, watch)
		if not ok then
			Graph.restoreEvaluationContext(context)
		end
		local errors: { string }? = nil
		if queueCount > 0 then
			errors = drain()
		end
		batching = false
		if not ok then
			if errors == nil then
				errors = { tostring(err) }
			else
				table.insert(errors, 1, tostring(err))
			end
		end
		if errors ~= nil then
			error(describeErrors(errors), 0)
		end
	end

	local function reset(_self: Reactor)
		for index = queueCount, 1, -1 do
			queue[index].queued = false
			queue[index] = nil
		end
		queueCount = 0
		cursor = 0
		batching = false
	end

	reactor = {
		batch = batch,
		settle = settle,
		pending = pending,
		__enqueue = enqueue,
		__enqueueConsumer = enqueueConsumer,
		__enqueueSettleConsumer = enqueueSettleConsumer,
		__reset = reset,
	}
	return reactor
end

return {
	create = create,
	MAX_RUNS_PER_DRAIN = MAX_RUNS_PER_DRAIN,
}
]]></string>
                  </Properties>
