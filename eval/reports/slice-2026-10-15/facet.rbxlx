      <Item class="ModuleScript" referent="373">
        <Properties>
          <string name="Name">Hub</string>
          <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shop = require(script.Shop)
local Inventory = require(script.Inventory)
local Settings = require(script.Settings)
local Codes = require(script.Codes)
local DailyRewards = require(script.DailyRewards)
local Dialogue = require(script.Dialogue)
local Crates = require(script.Crates)
local Garage = require(script.Garage)
local Drivers = require(script.Drivers)
local Round = require(script.Round)
local Lobby = require(script.Lobby)
local Economy = require(script.Economy)

export type State = {
	wallet: { Coins: number, Gems: number },
	xp: number,
	level: number,
	races: number,
	crates: number,
	kart: string,
	driver: string,
	raceKart: string,
	raceDriver: string,
	positions: { string },
}
export type Client = {
	getState: () -> State,
	onStateChanged: ((State) -> ()) -> RBXScriptConnection,
	serverNow: () -> number,
	returnToHub: () -> boolean,
}
export type Context = {
	player: Player,
	playerGui: PlayerGui,
	hub: Client,
	shop: Shop.Client,
	inventory: Inventory.Client,
	settings: Settings.Client,
	codes: Codes.Client,
	rewards: DailyRewards.Client,
	dialogue: Dialogue.Client,
	crates: Crates.Client,
	garage: Garage.Client,
	drivers: Drivers.Client,
	round: Round.Client,
	lobby: Lobby.Client,
	economy: Economy.Client,
}
local function client(): Client
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local get = remotes:WaitForChild("GetHubState") :: RemoteFunction
	local changed = remotes:WaitForChild("HubStateChanged") :: RemoteEvent
	return {
		returnToHub = function(): boolean
			return (remotes:WaitForChild("ReturnToHub") :: RemoteFunction):InvokeServer()
		end,
		getState = function(): State
			return get:InvokeServer()
		end,
		onStateChanged = function(callback: (State) -> ()): RBXScriptConnection
			return changed.OnClientEvent:Connect(callback)
		end,
		serverNow = function(): number
			return workspace:GetServerTimeNow()
		end,
	}
end
local function context(player: Player): Context
	return {
		player = player,
		playerGui = player:WaitForChild("PlayerGui") :: PlayerGui,
		hub = client(),
		shop = Shop.client(),
		inventory = Inventory.client(),
		settings = Settings.client(),
		codes = Codes.client(),
		rewards = DailyRewards.client(),
		dialogue = Dialogue.client(),
		crates = Crates.client(),
		garage = Garage.client(),
		drivers = Drivers.client(),
		round = Round.client(),
		lobby = Lobby.client(),
		economy = Economy.client(),
	}
end
return { context = context }
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="374">
          <Properties>
            <string name="Name">Catalog</string>
            <string name="Source"><![CDATA[--!strict

export type Currency = "Coins" | "Gems"

export type Category = "Motors" | "Boosts" | "Wheels" | "Cosmetics"

export type Item = {
	id: string,
	name: string,
	category: Category,
	price: number,
	currency: Currency,
	description: string,
}

local items: { Item } = {
	{
		id = "starter_motor",
		name = "Starter Motor",
		category = "Motors",
		price = 50,
		currency = "Coins",
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "sport_motor",
		name = "Sport Motor",
		category = "Motors",
		price = 250,
		currency = "Coins",
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "crystal_motor",
		name = "Crystal Motor",
		category = "Motors",
		price = 75,
		currency = "Gems",
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "turbo_kit",
		name = "Turbo Kit",
		category = "Boosts",
		price = 400,
		currency = "Coins",
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "lucky_charm",
		name = "Lucky Charm",
		category = "Boosts",
		price = 10,
		currency = "Gems",
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "amber_wheels",
		name = "Amber Wheels",
		category = "Wheels",
		price = 25,
		currency = "Gems",
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "road_wheels",
		name = "Road Wheels",
		category = "Wheels",
		price = 150,
		currency = "Coins",
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "gold_paint",
		name = "Gold Paint",
		category = "Cosmetics",
		price = 120,
		currency = "Gems",
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
	{
		id = "rainbow_trail",
		name = "Rainbow Trail",
		category = "Cosmetics",
		price = 900,
		currency = "Coins",
		description = "A tested racing part. Fit it in the garage before the next race.",
	},
}

local byId: { [string]: Item } = {}
for _, item in items do
	byId[item.id] = item
end

local categories: { Category } = { "Motors", "Boosts", "Wheels", "Cosmetics" }

return {
	items = items,
	byId = byId,
	categories = categories,
}
]]></string>
