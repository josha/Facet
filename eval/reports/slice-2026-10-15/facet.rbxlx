          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">materialize</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local ComposeTypes = require("../vendor/compose/core")

local function materialize(
	ctx: Types.Context,
	panel: GuiObject,
	geometry: { Size: Types.Value<UDim2>?, AutomaticSize: Types.Value<Enum.AutomaticSize>? },
	scale: (ComposeTypes.Use) -> number,
	pivot: ((ComposeTypes.Use) -> Vector2)?,
	paintOnly: boolean?,
	supplied: ComposeTypes.Readable<Vector2>?
)
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local D2, V2, E = ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	if paintOnly then
		return
	end
	local measured = supplied or ctx.layoutSize(panel)
	local clips = panel.ClipsDescendants
	local natural = Compose.cell(V2.zero)
	local function moving(use: ComposeTypes.Use): boolean
		return scale(use) ~= 1 and use(natural).X > 0 and use(natural).Y > 0
	end
	Compose.watch(function(use: ComposeTypes.Use)
		local size = use(measured)
		if scale(use) == 1 or natural:peek().X <= 0 or natural:peek().Y <= 0 then
			natural:set(size)
		end
	end)
	local function origin(use: ComposeTypes.Use): Vector2
		return if pivot then pivot(use) else V2.new(0.5, 0.5)
	end
	runtime.decorate(panel, {
		ClipsDescendants = function(use: ComposeTypes.Use)
			return clips or moving(use)
		end,
		Size = function(use: ComposeTypes.Use)
			local size = use(natural) * scale(use)
			return if moving(use) then D2.fromOffset(size.X, size.Y) else ctx.read(geometry.Size, use)
		end,
		AutomaticSize = function(use: ComposeTypes.Use)
			return if moving(use)
				then E.AutomaticSize.None
				else ctx.read(geometry.AutomaticSize, use) or E.AutomaticSize.None
		end,
	})
	local function keepSelection(move: () -> ())
		local gui = ctx.config.guiService
		local selected = if gui then gui.SelectedObject else nil
		move()
		if gui and selected and gui.SelectedObject ~= selected and selected:IsDescendantOf(panel) then
			gui.SelectedObject = selected
		end
	end
	runtime.mountFragment(function()
		return {
			Compose.show(moving, function()
				local suspended = {}
				local _, holder = runtime.mount(function()
					return Host.Folder "PresentationConstraints" {}
				end, panel)
				for _, child in panel:GetChildren() do
					if child:IsA("UISizeConstraint") then
						table.insert(suspended, child)
						child.Parent = holder :: Instance
					end
				end
				runtime.mount(function()
					local function extent(use: ComposeTypes.Use): Vector2
						return use(natural) * scale(use)
					end
					return Host.UISizeConstraint "PresentationBounds" { MinSize = extent, MaxSize = extent }
				end, panel)
				Compose.cleanup(function()
					for _, child in suspended do
						if child.Parent == holder then
							child.Parent = panel
						end
					end
				end)
				local parent = panel:FindFirstChild("Fade") or panel
				local children = parent:GetChildren()
				local padding = panel:FindFirstChildWhichIsA("UIPadding")
				local sides = {}
				if padding then
					for _, side in { "Left", "Right", "Top", "Bottom" } do
						sides[side] = padding:GetStyled("Padding" .. side) :: UDim
					end
				end
				local stop, made = runtime.mount(function()
					local function contentSize(use: ComposeTypes.Use): Vector2
						local size = use(natural)
						local function inset(side: string, length: number): number
							local value = sides[side]
							return if value then value.Offset + value.Scale * length else 0
						end
						return V2.new(
							math.max(0, size.X - inset("Left", size.X) - inset("Right", size.X)),
							math.max(0, size.Y - inset("Top", size.Y) - inset("Bottom", size.Y))
						)
					end
					return Host.Frame "PresentationContent" {
						Host.UISizeConstraint { MinSize = contentSize, MaxSize = contentSize },
						BackgroundTransparency = 1,
						Size = function(use: ComposeTypes.Use)
							local size = contentSize(use)
							return D2.fromOffset(size.X, size.Y)
						end,
						AnchorPoint = origin,
						Position = function(use: ComposeTypes.Use)
							local at = origin(use)
							return D2.fromScale(at.X, at.Y)
						end,
					}
				end, parent)
				local content = made :: Frame
				local function freeze(group: Instance)
					if not group:IsA("CanvasGroup") then
						return
					end
					local size, automatic = group.Size, group.AutomaticSize
					runtime.decorate(group, {
						Size = function(use: ComposeTypes.Use)
							return if moving(use) then content.Size else size
						end,
						AutomaticSize = function(use: ComposeTypes.Use)
							return if moving(use) then E.AutomaticSize.None else automatic
						end,
						AnchorPoint = origin,
						Position = function(use: ComposeTypes.Use)
							local at = origin(use)
							return D2.fromScale(at.X, at.Y)
						end,
					})
				end
				freeze(parent)
				runtime.connect(panel, "ChildAdded", function(child: Instance)
					if child.Name == "Fade" then
						freeze(child)
					end
				end)
				keepSelection(function()
					for _, child in children do
						if
							(
								child:IsA("GuiObject")
								and not string.match(child.Name, "Boundary$")
								and child.Name ~= "ChromeShadow"
							) or child:IsA("UIGridStyleLayout")
						then
							(child :: Instance).Parent = content
						end
					end
				end)
				Compose.cleanup(function()
					keepSelection(function()
						for _, child in content:GetChildren() do
							(child :: Instance).Parent = content.Parent
						end
					end)
					stop()
				end)
				return Compose.fragment(function()
					return {}
				end)
			end),
		}
	end, panel)
end

return materialize
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">measured_scroll</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local rest = require("./rest")
local scrollLock = require("./scroll_lock")

local MEASURE = 100000

return function(
	ctx: Types.Context,
	props: Types.ScrollingFrameNativeProps,
	children: { Types.Child },
	options: { hug: boolean?, name: string?, rest: boolean? }?
): (
	ScrollingFrame,
	Frame,
	ComposeTypes.Readable<Vector2>,
	ComposeTypes.Readable<number>,
	ComposeTypes.Readable<boolean>
)
	local Host, Compose, E, D2 = ctx.Host, ctx.Compose, ctx.types.Enum, ctx.types.UDim2
	local hug = options ~= nil and options.hug == true
	local flowProps: Types.FrameNativeProps = {
		Name = if options and options.name then options.name else "Flow",
		BackgroundTransparency = 1,
		Size = if hug then D2.fromOffset(0, 0) else D2.new(1, 0, 0, 0),
		AutomaticSize = if hug then E.AutomaticSize.XY else E.AutomaticSize.Y,
	}
	for _, child in children do
		flowProps[#flowProps + 1] = child
	end
	local flow = Host.Frame(flowProps)
	local size = ctx.observe.AbsoluteSize(flow)
	local extent = Compose.cell(0)
	props.AutomaticCanvasSize = E.AutomaticSize.None
	props.CanvasSize = function(use: ComposeTypes.Use)
		return D2.fromOffset(0, use(extent))
	end
	props[#props + 1] = Host.Frame "Measure" {
		BackgroundTransparency = 1,
		Size = if hug then D2.fromOffset(0, MEASURE) else D2.new(1, 0, 0, MEASURE),
		AutomaticSize = if hug then E.AutomaticSize.X else E.AutomaticSize.None,
		flow,
	}
	local scroller = Host.ScrollingFrame(props)
	scrollLock.own(scroller, ctx)
	local laidOut = ctx.layoutSize(flow, ctx.layoutUnit(scroller))
	Compose.watch(function(use: ComposeTypes.Use)
		extent:set(math.ceil(use(laidOut).Y - 0.01))
	end)
	local rested = if options and options.rest
		then rest(ctx, function(): (string, boolean)
			local now = extent:peek()
			return tostring(now), now > 0 or size:peek().X > 0
		end)
		else Compose.cell(true)
	return scroller, flow, size, extent, rested
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">media</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local ControlTypes = require("./control_types")
local mediaShared = require("./media_shared")
local registerText = require("./media_text")
local registerImage = require("./media_image")
local registerBadge = require("./media_badge")
local registerPath = require("./media_path")
local registerProgress = require("./media_progress")
local registerSkeleton = require("./media_skeleton")
local registerAsyncImage = require("./media_async_image")
local registerAvatar = require("./media_avatar")
local registerStage = require("./media_stage")
export type MediaControls = ControlTypes.Controls

return function(ctx: Types.Context, controls: ControlTypes.Controls?): ControlTypes.Controls
	local UI: ControlTypes.Controls = controls or ({} :: ControlTypes.Controls)
	local shared = mediaShared(ctx)
	registerText(ctx, UI, shared)
	registerImage(ctx, UI, shared)
	registerBadge(ctx, UI, shared)
	registerPath(ctx, UI)
	registerProgress(ctx, UI, shared)
	registerSkeleton(ctx, UI)
	registerAsyncImage(ctx, UI, shared)
	registerAvatar(ctx, UI)
	registerStage(ctx, UI, shared)
	return UI
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">media_async_image</string>
              <string name="Source"><![CDATA[--!strict
local Engine = require("./engine_types")
local Types = require("./types")
local Media = require("./media_types")
local ComposeTypes = require("../vendor/compose/core")
local ControlTypes = require("./control_types")
local MediaProps = require("./media_props")
local MediaShared = require("./media_shared")

return function(ctx: Types.Context, UI: ControlTypes.Controls, shared: MediaShared.Shared)
	local Host, runtime, Compose = ctx.Host, ctx.runtime, ctx.Compose
	local types, read = ctx.types, ctx.read
	local E, D2 = types.Enum, types.UDim2
	local bind = shared.bind
	UI.AsyncImage = ctx.construct("AsyncImage", function(spec: MediaProps.AsyncImageProps): Frame
		local state: ComposeTypes.Cell<Media.ImageState> = Compose.cell("loading" :: Media.ImageState)
		local loaded = Compose.cell("")
		local failure = Compose.cell(nil :: unknown)
		local root = Host.Frame(ctx.props(spec, {
			"image",
			"source",
			"resource",
			"loader",
			"onStatus",
			"failureLabel",
			"placeholder",
			"dimmed",
			"imageProperties",
		}, { BackgroundTransparency = 1, Size = D2.fromOffset(48, 48) }))
		local imageProperties: Engine.ImageLabelProps = spec.imageProperties or {}
		local imageOptions: Engine.ImageLabelProps = ctx.props(imageProperties, {}, {
			Name = "Image",
			Size = D2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Image = loaded,
			ImageTransparency = function(use: ComposeTypes.Use)
				return if read(spec.dimmed, use) then 0.35 else 0
			end,
			Visible = function(use: ComposeTypes.Use)
				return use(state) == "ready"
			end,
		})
		local image = Host.ImageLabel(imageOptions)
		runtime.mount(function()
			return image
		end, root)
		runtime.mount(function()
			local placeholder: Engine.FrameNativeProps = {
				Name = "Placeholder",
				Size = D2.fromScale(1, 1),
				BackgroundTransparency = if spec.placeholder then 1 else 0,
				Visible = function(use: ComposeTypes.Use)
					return use(state) ~= "ready"
				end,
			}
			local custom = spec.placeholder
			if custom then
				placeholder[#placeholder + 1] = Compose.show(function(use: ComposeTypes.Use)
					return use(state) ~= "ready"
				end, function()
					return custom(state)
				end)
			end
			if spec.failureLabel ~= nil then
				placeholder[#placeholder + 1] = Compose.show(function(use: ComposeTypes.Use)
					return use(state) == "failed"
				end, function()
					return ctx.text({ Text = bind(spec.failureLabel, ""), Size = D2.fromScale(1, 1) })
				end)
			end
			local node = Host.Frame(placeholder)
			return if spec.placeholder then node else ctx.styled(node, "skeleton")
		end, root)
		local generation, cancel: (() -> ())? = 0, nil
		Compose.cleanup(function()
			generation += 1
			if cancel then
				cancel()
			end
		end)
		if spec.resource then
			local resource = spec.resource()
			Compose.watch(function(use: ComposeTypes.Use)
				state:set(read(resource.state or resource.status, use) :: Media.ImageState)
				loaded:set(read(resource.value, use) or "")
			end)
		else
			Compose.watch(function(use: ComposeTypes.Use)
				local source = read(spec.source or spec.image, use) or ""
				generation += 1
				local ticket = generation
				if cancel then
					cancel()
					cancel = nil
				end
				state:set("loading")
				failure:set(nil)
				loaded:set(source)
				local function resolve(value: string?)
					if ticket == generation then
						loaded:set(value or source)
						state:set("ready")
					end
				end
				local function reject(reason: unknown)
					if ticket == generation then
						failure:set(reason)
						state:set("failed")
					end
				end
				if source == "" then
					reject("empty content")
				elseif spec.loader then
					local ok, teardown = pcall(spec.loader, source, resolve, reject)
					if ok then
						cancel = teardown
					elseif ticket == generation then
						reject(teardown)
					end
				elseif ctx.config.services and ctx.config.services.ContentProvider and task then
					local contentProvider = ctx.config.services.ContentProvider
					local thread = task.defer(function()
						local succeeded, reason = pcall(function()
							contentProvider:PreloadAsync({ image }, function(_, fetchStatus)
								if fetchStatus == E.AssetFetchStatus.Success then
									resolve(source)
								else
									reject(tostring(fetchStatus))
								end
							end)
						end)
						if not succeeded then
							reject(reason)
						end
					end)
					cancel = function()
						if coroutine.status(thread) ~= "dead" then
							task.cancel(thread)
						end
					end
				else
					resolve(source)
				end
			end)
		end
		if spec.onStatus then
			Compose.watch(function(use: ComposeTypes.Use)
				spec.onStatus(use(state) :: Media.ImageState, use(failure))
			end)
		end
		return root
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="126">
            <Properties>
              <string name="Name">media_avatar</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Engine = require("./engine_types")
local Media = require("./media_types")
local ComposeTypes = require("../vendor/compose/core")
local ControlTypes = require("./control_types")
local MediaProps = require("./media_props")

return function(ctx: Types.Context, UI: ControlTypes.Controls)
	local Host, runtime, Compose = ctx.Host, ctx.runtime, ctx.Compose
	local types, read = ctx.types, ctx.read
	local E, D2, D, V2 = types.Enum, types.UDim2, types.UDim, types.Vector2
	local metric, controlSize = ctx.metric, ctx.controlSize
	local function initials(name: string?): string
		local first: string?, last: string?, count = nil, nil, 0
		for word in string.gmatch(name or "", "%S+") do
			first = first or word
			last = word
			count += 1
		end
		local function character(word: string): string
			return string.sub(word, 1, (utf8.offset(word, 2) or (#word + 1)) - 1)
		end
		return if first == nil
			then ""
			elseif count == 1 then character(first)
			else character(first) .. character(last :: string)
	end

	UI.Avatar = ctx.construct("Avatar", function(spec: MediaProps.AvatarProps): TextButton
		assert(spec.form == nil or spec.form == "standard" or spec.form == "icon", "Facet Avatar invalid form")
		local diameter = function(use: ComposeTypes.Use)
			return read(spec.diameter, use)
				or controlSize(spec.controlSize, if spec.form == "icon" then "iconSize" else "height", use)
		end
		local native = ctx.props(spec, {
			"name",
			"image",
			"userId",
			"presence",
			"presenceLabel",
			"diameter",
			"onActivate",
			"form",
			"controlSize",
			"backplate",
			"presenceMark",
			"loader",
			"onStatus",
			"resource",
			"icon",
			"background",
		}, {
			Size = function(use: ComposeTypes.Use)
				local pixels = diameter(use)
				return D2.fromOffset(pixels, pixels)
			end,
			Text = "",
			AutoButtonColor = false,
			Selectable = spec.onActivate ~= nil,
			Interactable = spec.onActivate ~= nil,
			Host.UICorner({ CornerRadius = ctx.round }),
		})
		local onActivate = spec.onActivate
		if onActivate then
			native.Activated = function()
				onActivate()
			end
		end
		assert(spec.background == nil or table.find({
			"surface",
			"surfaceStrong",
			"control",
			"contentStrong",
			"accent",
			"success",
			"warning",
			"danger",
		}, spec.background) ~= nil, "Facet Avatar background must be a palette role such as accent or success")
		assert(
			spec.icon == nil or not (spec.image or spec.userId or spec.resource),
			"Facet Avatar takes one face: image, userId, resource or icon"
		)
		local root = ctx.styled(Host.TextButton(native), "avatar")
		local function ringWidth(use: ComposeTypes.Use): number
			return 2 * metric("strokes.hairline", use)
		end
		if onActivate then
			local state = ctx.observe.GuiState(root)
			runtime.mountFragment(function()
				local ring = Host.UIStroke({
					Name = "HoverRing",
					ApplyStrokeMode = E.ApplyStrokeMode.Border,
					Thickness = ringWidth,
					Transparency = function(use: ComposeTypes.Use): number
						return if use(state) == E.GuiState.Hover then 0 else 1
					end,
				})
				ring:AddTag("facet-avatar-hover")
				return { ring }
			end, root)
		end
		if spec.backplate then
			ctx.styled(root, "accent")
		end
		if spec.background then
			root:AddTag("facet-avatar-background-" .. spec.background)
		end
		local function facts(use: ComposeTypes.Use)
			local name, presence = read(spec.name, use), read(spec.presence, use)
			assert(type(name) == "string" and name ~= "", "Facet Avatar name must be nonempty")
			assert(
				presence == nil
					or ({ online = true, away = true, busy = true, offline = true, inExperience = true })[presence],
				"Facet Avatar invalid presence"
			)
			return {
				name = name,
				presence = presence,
				label = if presence then name .. ", " .. (read(spec.presenceLabel, use) or presence) else name,
			}
		end
		runtime.decorate(root, {
			Attributes = {
				AccessibleLabel = function(use: ComposeTypes.Use): string
					return facts(use).label
				end,
			},
		})
		local pictured = Compose.cell(false)
		runtime.mount(function()
			return ctx.text({
				Name = "Initials",
				Visible = function(use: ComposeTypes.Use)
					return not use(pictured) and read(spec.icon, use) == nil
				end,
				Size = D2.fromScale(1, 1),
				Text = function(use: ComposeTypes.Use)
					return initials(facts(use).name)
				end,
				TextScaled = true,
				TextXAlignment = E.TextXAlignment.Center,
				TextYAlignment = E.TextYAlignment.Center,
				Host.UITextSizeConstraint({
					MaxTextSize = function(use: ComposeTypes.Use)
						return math.max(8, math.floor(diameter(use) * 0.4 + 0.5))
					end,
				}),
			})
		end, root)
		if spec.icon ~= nil then
			runtime.mount(function()
				return ctx.icon(function(use: ComposeTypes.Use)
					return read(spec.icon, use) or ""
				end, {
					Name = "Face",
					AnchorPoint = V2.new(0.5, 0.5),
					Position = D2.fromScale(0.5, 0.5),
					Size = D2.fromScale(0.6, 0.6),
				})
			end, root)
		end
		if spec.presence then
			runtime.mount(function()
				return Host.Frame "PresenceRing" {
					BackgroundTransparency = 1,
					Size = D2.fromScale(1, 1),
					ZIndex = 2,
					Visible = function(use: ComposeTypes.Use)
						return facts(use).presence == "inExperience"
					end,
					Host.UICorner({ CornerRadius = ctx.round }),
					ctx.styled(
						Host.UIStroke({
							ApplyStrokeMode = E.ApplyStrokeMode.Border,
							BorderStrokePosition = E.BorderStrokePosition.Inner,
							Thickness = ringWidth,
						}),
						"avatar-ring"
					),
					Host.Frame "Gap" {
						BackgroundTransparency = 1,
						AnchorPoint = V2.new(0.5, 0.5),
						Position = D2.fromScale(0.5, 0.5),
						Size = function(use: ComposeTypes.Use)
							local inset = 2 * ringWidth(use)
							return D2.new(1, -inset, 1, -inset)
						end,
						Host.UICorner({ CornerRadius = ctx.round }),
						ctx.styled(
							Host.UIStroke({
								ApplyStrokeMode = E.ApplyStrokeMode.Border,
								BorderStrokePosition = E.BorderStrokePosition.Inner,
								Thickness = ringWidth,
							}),
							"avatar-ring-gap"
						),
					},
				}
			end, root)
		end
		local image, userId, onStatus = spec.image, spec.userId, spec.onStatus
		if image or userId or spec.resource then
			runtime.mount(function()
				return UI.AsyncImage({
					imageProperties = { Host.UICorner({ CornerRadius = ctx.round }) },
					Name = "Portrait",
					loader = spec.loader,
					onStatus = function(state: Media.ImageState, failure: unknown)
						pictured:set(state == "ready")
						if onStatus then
							onStatus(state, failure)
						end
					end,
					resource = spec.resource,
					Size = D2.fromScale(1, 1),
					image = function(use: ComposeTypes.Use)
						return if image
							then read(image, use)
							else "rbxthumb://type=AvatarHeadShot&id=" .. tostring(read(userId, use)) .. "&w=150&h=150"
					end,
					placeholder = function(_state: ComposeTypes.Readable<Media.ImageState>): Instance
						return Host.Frame({ BackgroundTransparency = 1, Size = D2.fromScale(1, 1) })
					end,
					Host.UICorner({ CornerRadius = ctx.round }),
				})
			end, root)
		end
		local presence = spec.presence
		if presence and spec.presenceMark ~= false and spec.form ~= "icon" then
			local marks: { [string]: "dot" | "ring" | "square" | "dash" } =
				{ online = "dot", away = "dash", busy = "square", offline = "ring" }
			local statuses: { [string]: Media.Status } =
				{ online = "success", away = "warning", busy = "error", offline = "neutral" }
			runtime.mount(function()
				return UI.StatusIndicator "Presence" {
					diameter = 12,
					cutout = true,
					Visible = function(use: ComposeTypes.Use)
						local presence = facts(use).presence
						return presence ~= nil and presence ~= "inExperience"
					end,
					form = function(use: ComposeTypes.Use): "dot" | "ring" | "square" | "dash"
						local current = facts(use).presence
						return if current then marks[current] or "dot" else "dot"
					end,
					AnchorPoint = V2.new(1, 1),
					Position = D2.fromScale(1, 1),
					status = function(use: ComposeTypes.Use): Media.Status
						local current = read(presence, use)
						return if current then statuses[current] or "neutral" else "neutral"
					end,
				}
			end, root)
		end
		return root
	end)

	UI.AvatarGroup = ctx.construct("AvatarGroup", function(spec: MediaProps.AvatarGroupProps): Frame
		local items = Compose.formula(function(use: ComposeTypes.Use)
			local members = read(spec.items, use)
			assert(type(members) == "table", "Facet AvatarGroup items must be an array")
			local seen: { [string]: boolean }, count = {}, 0
			for key, member in members do
				assert(
					type(key) == "number" and key >= 1 and key % 1 == 0 and key <= #members,
					"Facet AvatarGroup items must be dense"
				)
				assert(
					type(member) == "table" and type(member.id) == "string" and member.id ~= "" and not seen[member.id],
					"Facet AvatarGroup needs unique nonempty ids"
				)
				assert(type(member.name) == "string" and member.name ~= "", "Facet AvatarGroup needs member names")
				seen[member.id] = true
				count += 1
			end
			assert(count == #members, "Facet AvatarGroup items must be dense")
			return members
		end)
		assert(
			spec.layout == nil or spec.layout == "stacked" or spec.layout == "spread",
			"Facet AvatarGroup invalid layout"
		)
		assert(
			spec.overflow == nil or spec.overflow == "count" or spec.overflow == "ellipsis",
			"Facet AvatarGroup invalid overflow"
		)
		assert(spec.form == nil or spec.form == "standard" or spec.form == "icon", "Facet AvatarGroup invalid form")
		assert(
			spec.onOverflow == nil or type(spec.onOverflow) == "function",
			"Facet AvatarGroup onOverflow must be a function"
		)
		local maximum = spec.max or 4
		assert(maximum >= 1 and maximum % 1 == 0, "Facet AvatarGroup max must be positive")
		local size = function(use: ComposeTypes.Use)
			return read(spec.diameter, use)
				or controlSize(spec.controlSize, if spec.form == "icon" then "iconSize" else "height", use)
		end
		local spacing = if spec.layout == "spread" then 8 else -10
		local floor = ctx.touchFloor()
		local native = ctx.props(spec, {
			"items",
			"max",
			"diameter",
			"layout",
			"onOverflow",
			"overflow",
			"controlSize",
			"form",
			"overflowLabel",
		}, {
			BackgroundTransparency = 1,
			Size = function(use: ComposeTypes.Use)
				return D2.fromOffset(0, size(use))
			end,
			AutomaticSize = E.AutomaticSize.X,
			Host.UIListLayout({
				FillDirection = E.FillDirection.Horizontal,
				Padding = D.new(0, spacing),
				SortOrder = E.SortOrder.LayoutOrder,
			}),
		})
		native[#native + 1] = Compose.keyed({
			from = function(use: ComposeTypes.Use)
				local items = use(items)
				local visible: { Media.AvatarMember } = {}
				for index = 1, math.min(#items, maximum) do
					table.insert(visible, items[index])
				end
				return visible
			end,
			key = function(item: Media.AvatarMember)
				return if item.resource then item.id .. "\0" .. tostring(item.resource) else item.id
			end,
			render = function(current: ComposeTypes.Readable<Media.AvatarMember>, index: ComposeTypes.Readable<number>)
				return UI.Avatar({
					resource = current:peek().resource,
					Name = function(use: ComposeTypes.Use)
						return use(current).id
					end,
					name = function(use: ComposeTypes.Use)
						return use(current).name
					end,
					image = if current:peek().icon
						then nil
						else function(use: ComposeTypes.Use)
							local item = use(current)
							return item.image
								or (
									if item.userId
										then "rbxthumb://type=AvatarHeadShot&id=" .. tostring(item.userId) .. "&w=150&h=150"
										else ""
								)
						end,
					presence = function(use: ComposeTypes.Use): Media.Presence?
						return use(current).presence :: Media.Presence?
					end,
					icon = if current:peek().icon
						then function(use: ComposeTypes.Use): string?
							return use(current).icon
						end
						else nil,
					diameter = size,
					presenceMark = spec.layout == "spread",
					LayoutOrder = index,
				})
			end,
		})
		native[#native + 1] = Compose.show(function(use: ComposeTypes.Use)
			return #use(items) > maximum
		end, function()
			return ctx.styled(
				Host.TextButton "Overflow" {
					Attributes = {
						AccessibleLabel = (function(use: ComposeTypes.Use): string
							local label = read(spec.overflowLabel, use)
							assert(
								label == nil or type(label) == "string",
								"Facet AvatarGroup overflowLabel must be a string"
							)
							return label or tostring(#use(items) - maximum) .. " more players"
						end) :: Engine.Value<Engine.AttributeValue?>,
					},
					Size = function(use: ComposeTypes.Use)
						local pixels = size(use)
						return D2.fromOffset(pixels, pixels)
					end,
					LayoutOrder = maximum + 2,
					Text = function(use: ComposeTypes.Use)
						return if spec.overflow == "ellipsis" then "…" else "+" .. tostring(#use(items) - maximum)
					end,
					Selectable = spec.onOverflow ~= nil,
					AutoButtonColor = false,
					Activated = function()
						local onOverflow = spec.onOverflow
						if onOverflow then
							onOverflow()
						end
					end,
					Host.UICorner({ CornerRadius = ctx.round }),
					Host.UISizeConstraint({
						MinSize = function(use: ComposeTypes.Use): Vector2
							local minimum = floor(use)
							return V2.new(minimum, minimum)
						end,
					}),
				},
				"button"
			)
		end)
		if spacing < 0 then
			native[#native + 1] = Compose.show(function(use: ComposeTypes.Use)
				return #use(items) > maximum
			end, function()
				return Host.Frame "OverflowGap" {
					BackgroundTransparency = 1,
					LayoutOrder = maximum + 1,
					Size = D2.fromOffset(4 - 2 * spacing, 0),
				}
			end)
		end
		local group = Host.Frame(native)
		if spec.layout ~= "spread" then
			ctx.styled(group, "avatar-stack")
		end
		return group
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="127">
            <Properties>
              <string name="Name">media_badge</string>
              <string name="Source"><![CDATA[--!strict
local layoutKit = require("./layout_kit")
local Types = require("./types")
local Engine = require("./engine_types")
local Media = require("./media_types")
local ComposeTypes = require("../vendor/compose/core")
local decoration = require("./native_decoration")
local ControlTypes = require("./control_types")
local MediaProps = require("./media_props")
local MediaShared = require("./media_shared")

return function(ctx: Types.Context, UI: ControlTypes.Controls, shared: MediaShared.Shared)
	local Host, runtime, Compose = ctx.Host, ctx.runtime, ctx.Compose
	local lists = layoutKit.of(ctx)
	local types, read = ctx.types, ctx.read
	local E, D2, D, V2 = types.Enum, types.UDim2, types.UDim, types.Vector2
	local metric, controlSize = ctx.metric, ctx.controlSize
	local skin = shared.skin
	local function statusTag(node: GuiObject, source: Types.Value<Media.Status>?)
		local previous: string?
		Compose.watch(function(use: ComposeTypes.Use)
			local requested = read(source, use)
			local status = if requested == nil then "neutral" else requested
			assert(
				({
					neutral = true,
					info = true,
					success = true,
					warning = true,
					error = true,
					accent = true,
					voice = true,
					contrast = true,
				})[status],
				"Facet: invalid status"
			)
			if previous then
				node:RemoveTag(previous)
			end
			previous = "facet-status-" .. status
			node:AddTag(previous :: string)
		end)
	end

	UI.Badge = ctx.construct("Badge", function(spec: MediaProps.BadgeProps): GuiObject
		assert(
			spec.iconPosition == nil or spec.iconPosition == "leading" or spec.iconPosition == "trailing",
			"Facet Badge invalid iconPosition"
		)
		local function caption(use: ComposeTypes.Use): string
			local value = read(spec.label, use)
			assert(value == nil or type(value) == "string", "Facet Badge label must be a string")
			assert(
				(value ~= nil and value ~= "") or (spec.icon ~= nil and type(spec.name) == "string" and spec.name ~= ""),
				"Facet Badge requires meaningful text or a named icon"
			)
			return value or ""
		end
		local native = ctx.props(
			spec,
			{ "label", "status", "icon", "iconPosition", "name", "appearance", "corners", "controlSize" },
			{
				Text = caption,
				Attributes = { AccessibleLabel = spec.name or caption },
				AutomaticSize = E.AutomaticSize.XY,
				Size = function(use: ComposeTypes.Use)
					return D2.fromOffset(0, controlSize(spec.controlSize, "iconSize", use) + 4)
				end,
			}
		)
		local node = ctx.styled(Host.TextLabel(native), "text")
		local pill: GuiObject = node
		if spec.icon then
			node.Name = "Label"
			node.BackgroundTransparency = 1
			node.Size = D2.fromOffset(0, 0)
			local icon = ctx.icon(spec.icon, {
				Size = function(use: ComposeTypes.Use)
					local pixels = math.floor(controlSize(spec.controlSize, "iconSize", use) * 0.7 + 0.5)
					return D2.fromOffset(pixels, pixels)
				end,
			})
			local leading = spec.iconPosition ~= "trailing"
			icon.LayoutOrder = if leading then 1 else 2
			node.LayoutOrder = if leading then 2 else 1
			pill = Host.Frame({
				Name = spec.Name or "Badge",
				AutomaticSize = E.AutomaticSize.XY,
				Size = function(use: ComposeTypes.Use)
					return D2.fromOffset(0, controlSize(spec.controlSize, "iconSize", use) + 4)
				end,
				lists.list({ gap = 4, align = "center" }, false) :: ComposeTypes.Child,
				icon :: ComposeTypes.Child,
				node :: ComposeTypes.Child,
			})
		end
		ctx.styled(pill, "badge")
		if spec.status ~= nil then
			statusTag(pill, spec.status)
		end
		local previousAppearance: string?
		Compose.watch(function(use: ComposeTypes.Use)
			local appearance = read(spec.appearance, use) or "standard"
			assert(
				appearance == "standard" or appearance == "status" or appearance == "utility",
				"Facet Badge invalid appearance"
			)
			if previousAppearance then
				pill:RemoveTag(previousAppearance)
			end
			previousAppearance = "facet-badge-" .. appearance
			pill:AddTag(previousAppearance :: string)
		end)
		if spec.appearance then
			runtime.mountFragment(function()
				return {
					Compose.show(function(use: ComposeTypes.Use)
						return read(spec.appearance, use) == "status"
					end, function()
						return UI.StatusIndicator "Status" {
							status = spec.status,
							diameter = 8,
							LayoutOrder = -1,
							Position = D2.new(0, -14, 0.5, 0),
							AnchorPoint = V2.new(0, 0.5),
						}
					end),
				}
			end, pill)
		end
		if spec.corners then
			runtime.mount(function()
				return Host.UICorner({
					CornerRadius = function(use: ComposeTypes.Use)
						local radius = read(spec.corners, use)
						if type(radius) == "string" then
							radius = ({
								square = 0,
								rounded = metric("radii.control", use),
								capsule = metric("radii.pill", use),
							})[radius]
						end
						assert(type(radius) == "number", "Facet Badge invalid corners")
						return D.new(0, radius)
					end,
				})
			end, pill)
		end
		skin(pill, "badge")
		if (pill :: Instance) == (node :: Instance) and ctx.config.theme ~= nil then
			local function needsCaption(use: ComposeTypes.Use?): boolean
				local package = read(ctx.config.theme, use)
				local recipe = package and package.chrome and package.chrome.badge
				return recipe ~= nil and recipe.kind ~= "native" and recipe.kind ~= "none"
			end
			local function lifted()
				Compose.cleanup(function()
					node:RemoveTag("facet-badge-captioned")
				end)
				local label = ctx.styled(
					ctx.text({
						Name = "Label",
						Size = D2.fromScale(1, 1),
						AutomaticSize = E.AutomaticSize.None,
						ZIndex = 1,
						Text = ctx.observe.Text(node),
						TextColor3 = ctx.observeStyled.TextColor3(node),
						FontFace = ctx.observeStyled.FontFace(node),
						TextSize = ctx.observeStyled.TextSize(node),
						TextXAlignment = ctx.observeStyled.TextXAlignment(node),
						TextYAlignment = ctx.observeStyled.TextYAlignment(node),
					}),
					"badge-caption"
				)
				local boundary = decoration(Compose, runtime, types, node, label, { inset = true })
				Compose.watch(function(use: ComposeTypes.Use)
					local visible = needsCaption(use)
					boundary.Visible = visible
					if visible then
						node:AddTag("facet-badge-captioned")
					else
						node:RemoveTag("facet-badge-captioned")
					end
				end)
				return boundary
			end
			if Compose.isReadable(ctx.config.theme) or type(ctx.config.theme) == "function" then
				local attached = false
				runtime.mountFragment(function()
					return {
						Compose.show(function(use: ComposeTypes.Use)
							attached = attached or needsCaption(use)
							return attached
						end, lifted),
					}
				end, node)
			elseif needsCaption() then
				runtime.mount(lifted, node)
			end
		end
		return pill
	end)

	UI.StatusIndicator = ctx.construct("StatusIndicator", function(spec: MediaProps.StatusIndicatorProps): TextLabel
		local size = function(use: ComposeTypes.Use)
			return read(spec.diameter, use)
				or (
					if spec.controlSize
						then controlSize(spec.controlSize, "iconSize", use)
						else if spec.count ~= nil then 24 else 12
				)
		end
		local function form(use: ComposeTypes.Use): "dot" | "ring" | "square" | "dash"
			local value = read(spec.form, use) or "dot"
			assert(
				value == "dot" or value == "ring" or value == "square" or value == "dash",
				"Facet StatusIndicator invalid form"
			)
			return value
		end
		local native = ctx.props(
			spec,
			{ "status", "form", "count", "max", "name", "diameter", "controlSize", "cutout" },
			{
				Attributes = if spec.name ~= nil
					then ({ AccessibleLabel = spec.name } :: unknown) :: Engine.Attributes
					else nil,
				Size = function(use: ComposeTypes.Use)
					return D2.fromOffset(
						if spec.count ~= nil then 0 else size(use),
						if form(use) == "dash" then math.max(3, size(use) / 3) else size(use)
					)
				end,
				AutomaticSize = if spec.count ~= nil then E.AutomaticSize.X else nil,
				Text = function(use: ComposeTypes.Use)
					local count = read(spec.count, use)
					if count == nil then
						return ""
					end
					assert(
						type(count) == "number" and count >= 0 and count < math.huge and count % 1 == 0,
						"Facet StatusIndicator count must be a nonnegative integer"
					)
					assert(
						form(use) == "dot" or form(use) == "square",
						"Facet StatusIndicator count requires dot or square"
					)
					assert(
						spec.max == nil
							or (
								type(spec.max) == "number"
								and spec.max >= 0
								and spec.max < math.huge
								and spec.max % 1 == 0
							),
						"Facet StatusIndicator max must be a nonnegative integer"
					)
					return if count > (spec.max or 99) then tostring(spec.max or 99) .. "+" else tostring(count)
				end,
				TextXAlignment = E.TextXAlignment.Center,
				Host.UICorner({
					CornerRadius = function(use: ComposeTypes.Use)
						return if form(use) == "square" then D.new(0, 0) else ctx.round(use)
					end,
				}) :: ComposeTypes.Child,
				Compose.show(function(use: ComposeTypes.Use)
					return form(use) == "ring"
				end, function()
					return ctx.styled(
						Host.UIStroke "Ring" {
							ApplyStrokeMode = E.ApplyStrokeMode.Border,
							BorderStrokePosition = E.BorderStrokePosition.Inner,
							Thickness = function(use: ComposeTypes.Use)
								return math.max(2, math.floor(size(use) / 6 + 0.5))
							end,
						},
						"status-ring"
					)
				end),
			} :: Engine.TextLabelNativeProps
		)
		if spec.count ~= nil and spec.Size == nil then
			native[#native + 1] = Host.UISizeConstraint({
				MinSize = function(use: ComposeTypes.Use)
					return V2.new(size(use), size(use))
				end,
			})
		elseif spec.count == nil then
			native[#native + 1] = Host.UIAspectRatioConstraint({
				AspectRatio = function(use: ComposeTypes.Use)
					return if form(use) == "dash" then 3 else 1
				end,
				AspectType = E.AspectType.FitWithinMaxSize,
			})
		end
		if spec.cutout then
			native[#native + 1] = ctx.styled(
				Host.UIStroke "Cutout" {
					ApplyStrokeMode = E.ApplyStrokeMode.Border,
					BorderStrokePosition = E.BorderStrokePosition.Inner,
					Thickness = 1,
				},
				"cutout"
			)
		end
		if spec.count ~= nil and spec.Size ~= nil then
			native[#native + 1] = Host.Frame "CountWidthFloor" {
				BackgroundTransparency = 1,
				Size = function(use: ComposeTypes.Use): UDim2
					local package = read(ctx.config.theme, use)
					local recipe = if package and package.chrome then package.chrome.badge else nil
					local insets = if recipe then recipe.contentInsets else nil
					local horizontal = math.max(8, if insets then insets.left or 0 else 0)
						+ math.max(8, if insets then insets.right or 0 else 0)
					local vertical = math.max(3, if insets then insets.top or 0 else 0)
						+ math.max(3, if insets then insets.bottom or 0 else 0)
					return D2.new(0, 100000, 1, vertical - horizontal)
				end,
				Host.UIAspectRatioConstraint {
					AspectRatio = 1,
					AspectType = E.AspectType.FitWithinMaxSize,
					DominantAxis = E.DominantAxis.Height,
				},
			}
			native[#native + 1] = Host.UIListLayout { HorizontalAlignment = E.HorizontalAlignment.Center }
		end
		local node = ctx.styled(Host.TextLabel(native), "text")
		ctx.styled(node, "badge")
		statusTag(node, spec.status)
		Compose.watch(function(use: ComposeTypes.Use)
			if form(use) == "ring" then
				node:AddTag("facet-status-hollow")
			elseif node:HasTag("facet-status-hollow") then
				node:RemoveTag("facet-status-hollow")
			end
		end)
		return node
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="128">
            <Properties>
              <string name="Name">media_image</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Engine = require("./engine_types")
local ComposeTypes = require("../vendor/compose/core")
local prepareMedia = require("./media_readiness")
local ControlTypes = require("./control_types")
local MediaProps = require("./media_props")
local MediaShared = require("./media_shared")

return function(ctx: Types.Context, UI: ControlTypes.Controls, shared: MediaShared.Shared)
	local Host, Compose = ctx.Host, ctx.Compose
	local types, read = ctx.types, ctx.read
	local E, D2 = types.Enum, types.UDim2
	local controlSize = ctx.controlSize
	local bind = shared.bind
	UI.Image = ctx.construct("Image", function(spec: MediaProps.ImageProps): ImageLabel
		local keys = { "image", "tint", "scaleMode", "tileSize", "sliceCenter", "sliceScale", "resample", "shape" }
		local declared = read(spec.scaleMode)
		local live = Compose.isReadable(spec.scaleMode) or type(spec.scaleMode) == "function"
		assert(
			not live or (spec.tileSize == nil and spec.sliceCenter == nil),
			"Facet UI.Image: tile and slice are static; author scaleMode as a word with its geometry"
		)
		if declared == "tile" then
			local tile = spec.tileSize
			assert(
				type(tile) == "table"
					and type(tile.width) == "number"
					and type(tile.height) == "number"
					and tile.width > 0
					and tile.height > 0
					and tile.width % 1 == 0
					and tile.height % 1 == 0,
				"Facet UI.Image: scaleMode tile requires tileSize = { width, height } in whole pixels above zero"
			)
		else
			assert(spec.tileSize == nil, "Facet UI.Image: tileSize requires scaleMode tile")
		end
		if declared == "slice" then
			local rect = spec.sliceCenter
			assert(
				type(rect) == "table"
					and type(rect.x0) == "number"
					and type(rect.y0) == "number"
					and type(rect.x1) == "number"
					and type(rect.y1) == "number"
					and rect.x1 > rect.x0
					and rect.y1 > rect.y0,
				"Facet UI.Image: scaleMode slice requires sliceCenter = { x0, y0, x1, y1 } in source pixels"
			)
			assert(
				spec.sliceScale == nil or (type(spec.sliceScale) == "number" and spec.sliceScale > 0),
				"Facet UI.Image: sliceScale must be above zero"
			)
		else
			assert(spec.sliceCenter == nil, "Facet UI.Image: sliceCenter requires scaleMode slice")
			assert(spec.sliceScale == nil, "Facet UI.Image: sliceScale requires scaleMode slice")
		end
		assert(
			spec.shape == nil or spec.shape == "rect" or spec.shape == "circle",
			"Facet UI.Image: shape must be rect or circle"
		)
		assert(
			spec.shape ~= "circle" or declared ~= "slice",
			"Facet UI.Image: a circle cannot slice; use fit, fill, crop, stretch or tile"
		)
		local modes: { [string]: Enum.ScaleType } = {
			fit = E.ScaleType.Fit,
			fill = E.ScaleType.Crop,
			crop = E.ScaleType.Crop,
			stretch = E.ScaleType.Stretch,
			tile = E.ScaleType.Tile,
			slice = E.ScaleType.Slice,
		}
		local defaults: Engine.ImageLabelNativeProps = {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = bind(spec.image, ""),
			Size = function(use: ComposeTypes.Use): UDim2
				local side = controlSize(nil, "height", use)
				return D2.fromOffset(side, side)
			end,
		}
		if spec.tint ~= nil then
			defaults.ImageColor3 = spec.tint :: Types.Value<Color3>
		end
		if spec.scaleMode ~= nil then
			defaults.ScaleType = function(use: ComposeTypes.Use): Enum.ScaleType
				local mode = read(spec.scaleMode, use)
				assert(
					not live or (mode ~= "tile" and mode ~= "slice"),
					"Facet UI.Image: a bound scaleMode cannot be tile or slice, which need static geometry"
				)
				return (
					assert(
						modes[mode or "stretch"],
						"Facet UI.Image: scaleMode must be fit, fill, crop, stretch, tile or slice"
					)
				)
			end
		end
		if spec.tileSize ~= nil then
			defaults.TileSize = D2.fromOffset(spec.tileSize.width, spec.tileSize.height)
		end
		if spec.sliceCenter ~= nil then
			local rect = spec.sliceCenter
			defaults.SliceCenter = types.Rect.new(rect.x0, rect.y0, rect.x1, rect.y1)
			defaults.SliceScale = spec.sliceScale or 1
		end
		if spec.resample ~= nil then
			defaults.ResampleMode = function(use: ComposeTypes.Use): Enum.ResamplerMode
				local mode = read(spec.resample, use) or "default"
				assert(
					mode == "default" or mode == "pixelated",
					"Facet UI.Image: resample must be default or pixelated"
				)
				return if mode == "pixelated" then E.ResamplerMode.Pixelated else E.ResamplerMode.Default
			end
		end
		if spec.shape == "circle" then
			defaults[#defaults + 1] = Host.UICorner({ CornerRadius = ctx.round })
			defaults[#defaults + 1] = Host.UIAspectRatioConstraint({ AspectRatio = 1 })
		end
		local image = Host.ImageLabel(ctx.props(spec, keys, defaults))
		prepareMedia(ctx, image, spec.ImageTransparency)
		return image
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="129">
            <Properties>
              <string name="Name">media_path</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Engine = require("./engine_types")
local Media = require("./media_types")
local ComposeTypes = require("../vendor/compose/core")
local pathShapes = require("./nav_path_shapes")
local ControlTypes = require("./control_types")
local MediaProps = require("./media_props")

return function(ctx: Types.Context, UI: ControlTypes.Controls)
	local Host, Compose = ctx.Host, ctx.Compose
	local types, read = ctx.types, ctx.read
	local D2 = types.UDim2
	local metric = ctx.metric
	UI.Path = ctx.construct("Path", function(spec: MediaProps.PathProps): Frame
		assert(spec.points ~= nil, "Facet Path requires points")
		local width, height = spec.width, spec.height
		assert(width == nil or (type(width) == "number" and width > 0), "Facet Path width must be a positive number")
		assert(
			height == nil or (type(height) == "number" and height > 0),
			"Facet Path height must be a positive number"
		)
		local stroke: Engine.Path2DNativeProps = {
			Name = "Stroke",
			Closed = function(use: ComposeTypes.Use): boolean
				return read(spec.closed, use) == true
			end,
		}
		if spec.thickness ~= nil then
			stroke.Thickness = function(use: ComposeTypes.Use): number
				local value = read(spec.thickness, use)
				if type(value) == "string" then
					return metric(value, use)
				end
				assert(
					type(value) == "number" and value > 0,
					"Facet Path thickness must be a positive number or a theme metric name"
				)
				return value
			end
		end
		if spec.tint ~= nil then
			stroke.Color3 = function(use: ComposeTypes.Use): Color3
				return read(spec.tint, use) :: Color3
			end
		end
		local path = ctx.styled(Host.Path2D(stroke), "path")
		local previousRole: string?
		Compose.watch(function(use: ComposeTypes.Use)
			local role = read(spec.role, use) or "content"
			assert(
				role == "content" or role == "secondary" or role == "accent",
				"Facet Path role must be content, secondary or accent"
			)
			if previousRole then
				path:RemoveTag(previousRole)
			end
			previousRole = "facet-path-" .. role
			path:AddTag(previousRole :: string)
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			local points = read(spec.points, use) :: { Media.PathPoint }
			assert(type(points) == "table", "Facet Path points must be a list of pathShapes points")
			assert(#points <= pathShapes.MAX_CONTROL_POINTS, "Facet Path takes at most 100 control points")
			local native: { Path2DControlPoint } = {}
			for _, point in points do
				table.insert(
					native,
					types.Path2DControlPoint.new(
						D2.fromScale(point.x, point.y),
						D2.fromScale(point.inX, point.inY),
						D2.fromScale(point.outX, point.outY)
					)
				)
			end
			path:SetControlPoints(native)
		end)
		local props = ctx.props(spec, { "points", "thickness", "closed", "role", "tint", "width", "height" }, {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = if width or height then D2.fromOffset(width or height or 0, height or width or 0) else nil,
		})
		props[#props + 1] = path
		return Host.Frame(props)
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">media_progress</string>
              <string name="Source"><![CDATA[--!strict
local reducedMotion = require("./motion").reduced
local Types = require("./types")
local Engine = require("./engine_types")
local Theme = require("./theme_types")
local ComposeTypes = require("../vendor/compose/core")
local pathShapes = require("./nav_path_shapes")
local ControlTypes = require("./control_types")
local MediaProps = require("./media_props")
local MediaShared = require("./media_shared")

return function(ctx: Types.Context, UI: ControlTypes.Controls, shared: MediaShared.Shared)
	local Host, runtime, Compose = ctx.Host, ctx.runtime, ctx.Compose
	local types, read = ctx.types, ctx.read
	local E, D2, V2 = types.Enum, types.UDim2, types.Vector2
	local metric, controlSize = ctx.metric, ctx.controlSize
	local skin = shared.skin
	UI.ProgressView = ctx.construct("ProgressView", function(spec: MediaProps.ProgressViewProps): Frame
		local motionReduced = reducedMotion(ctx)
		local presentation = spec.presentation or "bar"
		assert(
			presentation == "bar" or presentation == "circular" or presentation == "spinner",
			"Facet ProgressView presentation must be bar, circular or spinner"
		)
		assert(spec.segments == nil or presentation == "bar", "Facet ProgressView segments require bar presentation")
		assert(
			spec.diameter == nil or presentation ~= "bar",
			"Facet ProgressView diameter requires a circular presentation"
		)
		assert(
			presentation ~= "bar" or spec.controlSize == nil or spec.thickness == nil,
			"Facet ProgressView: give thickness or controlSize, not both (a bar's rung is its track thickness)"
		)
		assert(
			presentation == "bar" or spec.controlSize == nil or spec.diameter == nil,
			"Facet ProgressView: give diameter or controlSize, not both (a ring's rung is its diameter)"
		)
		assert(
			spec.endLabel == nil or type(read(spec.endLabel)) == "string",
			"Facet ProgressView endLabel must be a string"
		)
		local count = spec.segments or 1
		assert(
			type(count) == "number" and count >= 1 and count < math.huge and count % 1 == 0,
			"Facet ProgressView segments must be a positive integer"
		)
		local delay: number, duration: number =
			ctx.metric("motion.durations.trailDelay"), ctx.metric("motion.durations.trailSettle")
		if spec.trail then
			assert(type(spec.trail) == "table", "Facet ProgressView trail must be a table")
			delay, duration = spec.trail.delay or delay, spec.trail.duration or duration
			assert(
				type(delay) == "number"
					and delay >= 0
					and delay < math.huge
					and type(duration) == "number"
					and duration > 0
					and duration < math.huge,
				"Facet ProgressView trail delay/duration invalid"
			)
		end
		local indeterminate = spec.value == nil
		local timeline = if indeterminate
			then runtime.timeline({ duration = ctx.metric("motion.durations.progressLoop"), repeats = math.huge })
			else nil
		local progress = Compose.formula(function(use: ComposeTypes.Use)
			if timeline then
				local phase = use(timeline.progress)
				return if motionReduced(use) then math.floor(phase * 4) / 4 else phase
			end
			local minimum, maximum = read(spec.min, use) or 0, read(spec.max, use) or 1
			assert(maximum > minimum, "Facet ProgressView max must exceed min")
			return math.clamp(((read(spec.value, use) :: number) - minimum) / (maximum - minimum), 0, 1)
		end)
		local trail: ComposeTypes.Formula<number>?
		if spec.trail and not indeterminate then
			local clock = runtime.timeline({ delay = delay, duration = duration, autoplay = false })
			local previous = progress:peek()
			local origin, destination = Compose.cell(previous), Compose.cell(previous)
			trail = Compose.formula(function(use: ComposeTypes.Use)
				return use(origin) + (use(destination) - use(origin)) * use(clock.progress)
			end)
			Compose.watch(function(use: ComposeTypes.Use)
				local value = use(progress)
				if motionReduced(use) or value >= previous then
					origin:set(value)
					destination:set(value)
					clock:seek(duration)
				else
					origin:set((trail :: ComposeTypes.Formula<number>):peek())
					destination:set(value)
					clock:restart()
				end
				previous = value
			end)
		end
		local readout: TextLabel?
		local ending: TextLabel? = if spec.endLabel
			then ctx.text({
				Name = "EndLabel",
				Text = function(use: ComposeTypes.Use)
					return read(spec.endLabel, use) or ""
				end,
			})
			else nil
		if spec.showValue then
			readout = ctx.text({
				Name = "Value",
				Text = function(use: ComposeTypes.Use)
					if indeterminate then
						return "Loading"
					end
					local value = read(spec.value, use)
					return if spec.format
						then spec.format(value :: number)
						else tostring(math.floor(use(progress) * 100 + 0.5)) .. "%"
				end,
			})
		end
		local direction = Compose.formula(function(use: ComposeTypes.Use): Theme.FillDirection
			local package = read(ctx.config.theme, use)
			local recipe = if package then ((package.chrome or {}) :: { [string]: Theme.SkinLayer }).barFill else nil
			local value = (if recipe then recipe.direction or "ltr" else "ltr") :: Theme.FillDirection
			assert(({ ltr = true, rtl = true, ttb = true, btt = true })[value], "Facet progress invalid fill direction")
			return value :: Theme.FillDirection
		end)
		local function dynamic(source: unknown): boolean
			return Compose.isReadable(source) or type(source) == "function"
		end
		local settled = not (
			indeterminate
			or trail ~= nil
			or dynamic(spec.value)
			or dynamic(spec.min)
			or dynamic(spec.max)
			or dynamic(spec.controlSize)
			or dynamic(spec.thickness)
			or dynamic(ctx.config.theme)
		)
		local function fixed<T>(body: (ComposeTypes.Use) -> T): Types.Value<T>
			if not settled then
				return body
			end
			return body(function<U>(source: ComposeTypes.Readable<U>): U
				return source:peek()
			end)
		end
		local function vertical(use: ComposeTypes.Use): boolean
			return use(direction) == "ttb" or use(direction) == "btt"
		end
		local function reversed(use: ComposeTypes.Use): boolean
			return use(direction) == "rtl" or use(direction) == "btt"
		end
		local content: GuiObject
		if presentation == "bar" then
			local function thickness(use: ComposeTypes.Use): number
				local rung = read(spec.controlSize, use)
				return read(spec.thickness, use)
					or (
						if rung == "xsmall" or rung == "compact"
							then metric("space.xs", use)
							else metric("controls.progress.trackHeight", use)
					)
			end

			local measured = Compose.cell(V2.zero)
			local function ornament(slot: string, use: ComposeTypes.Use): (number, number)
				local package = read(ctx.config.theme, use)
				local recipe = if package then ((package.chrome or {}) :: { [string]: Theme.SkinLayer })[slot] else nil
				if recipe == nil or recipe.kind == "native" or recipe.kind == "none" then
					return 1, 0
				end
				local size = if type(recipe.size) == "table" then recipe.size else { w = 16, h = 16 }
				local along, cross = size.w, size.h
				if vertical(use) then
					along, cross = cross, along
				end
				local pixels, box = thickness(use), use(measured)
				local length, depth = if vertical(use) then box.Y else box.X, if vertical(use) then box.X else box.Y
				local fit = math.min(1, pixels / cross)
				if depth > 0 then
					fit = math.min(fit, length * pixels / depth / 4 / along)
				end
				return if fit < 0.5 then 0 else fit, if fit < 0.5 then 0 else math.round(along * fit)
			end
			local track: Engine.FrameNativeProps = {
				Name = "Track",
				Size = fixed(function(use: ComposeTypes.Use)
					local pixels = thickness(use)
					return if vertical(use) then D2.new(0, pixels, 1, 0) else D2.new(1, 0, 0, pixels)
				end),
				ClipsDescendants = false,
			}
			if trail then
				track[#track + 1] = ctx.styled(
					Host.Frame "Trail" {
						BackgroundTransparency = 0.6,
						BorderSizePixel = 0,
						ZIndex = 0,
						Size = function(use: ComposeTypes.Use)
							local fraction = if motionReduced(use)
								then use(progress)
								else math.max(use(trail :: ComposeTypes.Formula<number>), use(progress))
							return if vertical(use) then D2.fromScale(1, fraction) else D2.fromScale(fraction, 1)
						end,
						AnchorPoint = function(use: ComposeTypes.Use)
							return if reversed(use)
								then (if vertical(use) then V2.new(0, 1) else V2.new(1, 0))
								else V2.new(0, 0)
						end,
						Position = function(use: ComposeTypes.Use)
							return if reversed(use)
								then (if vertical(use) then D2.fromScale(0, 1) else D2.fromScale(1, 0))
								else D2.fromScale(0, 0)
						end,
					},
					"fill"
				)
			end
			for index = 1, count do
				track[#track + 1] = ctx.styled(
					Host.Frame({
						Name = "Fill" .. index,
						ClipsDescendants = true,
						AnchorPoint = fixed(function(use: ComposeTypes.Use)
							return if reversed(use)
								then (if vertical(use) then V2.new(0, 1) else V2.new(1, 0))
								else V2.new(0, 0)
						end),
						BorderSizePixel = 0,
						Size = fixed(function(use: ComposeTypes.Use)
							local fraction = if indeterminate
								then 0.3
								else math.clamp(use(progress) * count - (index - 1), 0, 1)
							local gap = if count > 1 and fraction > 0 then -2 else 0
							return if vertical(use)
								then D2.new(1, 0, fraction / count, gap)
								else D2.new(fraction / count, gap, 1, 0)
						end),
						Position = fixed(function(use: ComposeTypes.Use)
							local position = if indeterminate
								then (if motionReduced(use) then use(progress) * 0.7 else use(progress) * 1.3 - 0.3)
								else (index - 1) / count
							if reversed(use) then
								position = 1 - position
							end
							return D2.fromScale(
								if vertical(use) then 0 else position,
								if vertical(use) then position else 0
							)
						end),
					}),
					"fill"
				)
			end
			local clipped: Engine.FrameNativeProps = {
				Name = "FillClip",

				Size = function(use: ComposeTypes.Use)
					local _, cap = ornament("barCap", use)
					return if vertical(use) then D2.new(1, 0, 1, -2 * cap) else D2.new(1, -2 * cap, 1, 0)
				end,
				Position = function(use: ComposeTypes.Use)
					local _, cap = ornament("barCap", use)
					return if vertical(use) then D2.fromOffset(0, cap) else D2.fromOffset(cap, 0)
				end,
				BackgroundTransparency = 1,
				ClipsDescendants = true,
			}
			for _, child in ipairs((track :: unknown) :: { unknown }) do
				clipped[#clipped + 1] = child
			end
			for index = #track, 1, -1 do
				table.remove((track :: unknown) :: { unknown }, index)
			end
			track[#track + 1] = Host.Frame(clipped)
			content = skin(ctx.styled(Host.Frame(track), "track"), "barTrack")
			local trackSize = ctx.layoutSize(content)
			Compose.watch(function(use: ComposeTypes.Use)
				measured:set(use(trackSize))
			end)
			for _, fill in content:GetDescendants() do
				if string.match(fill.Name, "^Fill%d+$") then
					local fillIndex = tonumber(string.match(fill.Name, "%d+$")) :: number
					skin(fill :: Frame, "barFill", {
						Size = function(use: ComposeTypes.Use)
							local fraction = if indeterminate
								then 0.3
								else math.clamp(use(progress) * count - (fillIndex - 1), 0, 1)
							local scale = 1 / math.max(fraction, 0.000001)
							return if vertical(use) then D2.fromScale(1, scale) else D2.fromScale(scale, 1)
						end,
						AnchorPoint = function(use: ComposeTypes.Use)
							return if reversed(use)
								then (if vertical(use) then V2.new(0, 1) else V2.new(1, 0))
								else V2.new(0, 0)
						end,
						Position = function(use: ComposeTypes.Use)
							return if reversed(use)
								then (if vertical(use) then D2.fromScale(0, 1) else D2.fromScale(1, 0))
								else D2.fromScale(0, 0)
						end,
					})
				end
			end
			skin(content, "barCap", {
				direction = function(use: ComposeTypes.Use): Theme.FillDirection
					return use(direction) :: Theme.FillDirection
				end,
				fit = function(use: ComposeTypes.Use): number
					return (ornament("barCap", use))
				end,
				ZIndex = 2,
			})
			skin(content, "barCenter", {
				fit = function(use: ComposeTypes.Use): number
					return (ornament("barCenter", use))
				end,
				ZIndex = 2,
			})
		else
			local diameter = function(use: ComposeTypes.Use)
				return read(spec.diameter, use)
					or (
						if spec.controlSize
							then controlSize(spec.controlSize, "height", use)
							else metric("controls.progress.circularSize", use)
					)
			end
			local native: Engine.FrameNativeProps = {
				Name = "Indicator",
				Size = function(use: ComposeTypes.Use)
					local pixels = diameter(use)
					return D2.fromOffset(pixels, pixels)
				end,
				BackgroundTransparency = 1,
			}
			if presentation == "spinner" then
				local count = 8
				for index = 1, count do
					local angle = (index - 1) / count * math.pi * 2 - math.pi / 2
					native[#native + 1] = ctx.styled(
						Host.Frame("Segment" .. index)({
							AnchorPoint = V2.new(0.5, 0.5),
							BorderSizePixel = 0,
							Position = D2.fromScale(0.5 + math.cos(angle) * 0.4, 0.5 + math.sin(angle) * 0.4),
							Size = function(use: ComposeTypes.Use)
								local thickness = read(spec.thickness, use)
									or metric("controls.progress.spinnerDotSize", use)
								return D2.fromOffset(thickness, thickness)
							end,
							BackgroundTransparency = function(use: ComposeTypes.Use)
								local value = use(progress)
								if not indeterminate then
									return if index / count <= value then 0 else 0.85
								end
								return ((index / count - value) % 1) * 0.85
							end,
							Host.UICorner({ CornerRadius = ctx.round }),
						}),
						"fill"
					)
				end
			else
				local thickness = function(use: ComposeTypes.Use)
					return read(spec.thickness, use)
						or math.max(
							metric("controls.progress.circularThickness", use),
							math.round(diameter(use) * 0.08)
						)
				end
				for _, isTrack in { true, false } do
					local path = ctx.styled(
						Host.Path2D({
							Name = if isTrack then "RingTrack" else "RingFill",
							Thickness = thickness,
							Closed = false,
							ZIndex = if isTrack then 1 else 2,
							Visible = function(use: ComposeTypes.Use)
								return isTrack or indeterminate or use(progress) > 0
							end,
						}),
						if isTrack then "progress-ring-track" else "progress-ring-fill"
					)
					Compose.watch(function(use: ComposeTypes.Use)
						local pixels = diameter(use)
						assert(pixels > 0, "Facet ProgressView diameter must be positive")
						local radius = math.max(0, 1 - thickness(use) / pixels)
						local points: { pathShapes.PathPoint } = if isTrack
							then pathShapes.ring({ radius = radius })
							else pathShapes.arc(
								if indeterminate then use(progress) * 360 else 0,
								if indeterminate then 90 else use(progress) * 360,
								{ radius = radius }
							)
						local nativePoints: { Path2DControlPoint } = {}
						for _, point in points do
							table.insert(
								nativePoints,
								types.Path2DControlPoint.new(
									D2.fromScale(point.x, point.y),
									D2.fromScale(point.inX, point.inY),
									D2.fromScale(point.outX, point.outY)
								)
							)
						end
						path:SetControlPoints(nativePoints)
					end)
					native[#native + 1] = path
				end
			end
			content = Host.Frame(native)
			if readout and presentation == "circular" then
				local bounds = ctx.observe.TextBounds(readout)
				local centered = Compose.formula(function(use: ComposeTypes.Use)
					local measured, innerDiameter = use(bounds), diameter(use) * 0.6
					return measured.X <= innerDiameter and measured.Y <= innerDiameter
				end)
				runtime.decorate(content, { AnchorPoint = V2.new(0.5, 0), Position = D2.fromScale(0.5, 0) })
				runtime.decorate(readout, {
					AutomaticSize = E.AutomaticSize.XY,
					TextWrapped = false,
					TextXAlignment = E.TextXAlignment.Center,
					AnchorPoint = function(use: ComposeTypes.Use)
						return V2.new(0.5, if use(centered) then 0.5 else 0)
					end,
					Position = function(use: ComposeTypes.Use)
						return D2.new(0.5, 0, 0, if use(centered) then diameter(use) / 2 else diameter(use) + 8)
					end,
				})
				content = Host.Frame "Gauge" {
					BackgroundTransparency = 1,
					ClipsDescendants = false,
					Size = function(use: ComposeTypes.Use)
						local pixels, measured = diameter(use), use(bounds)
						return D2.fromOffset(
							math.max(pixels, measured.X),
							pixels + (if use(centered) then 0 else measured.Y + 8)
						)
					end,
					content,
					readout,
				}
				readout = nil
			end
		end
		local children: { ComposeTypes.Child } = {}
		local trailing: { ComposeTypes.Child } = {}
		if readout then
			table.insert(trailing, readout)
		end
		if ending then
			table.insert(trailing, ending)
		end
		if presentation == "bar" and spec.label and #trailing > 0 then
			local header: { ComposeTypes.Child } = {
				UI.Text({
					text = spec.label,
					LayoutOrder = 1,
					Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }),
				}),
			}
			for _, node in trailing do
				table.insert(header, node)
			end
			table.insert(
				children,
				ctx.row(header, { Name = "Header", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
			)
			trailing = {}
		elseif spec.label then
			table.insert(children, UI.Text({ text = spec.label }))
		end
		table.insert(children, content)
		for _, node in trailing do
			table.insert(children, node)
		end
		local root = ctx.column(
			children,
			ctx.props(spec, {
				"value",
				"min",
				"max",
				"presentation",
				"label",
				"endLabel",
				"showValue",
				"format",
				"diameter",
				"thickness",
				"segments",
				"trail",
				"controlSize",
			}, {
				Size = fixed(function(use: ComposeTypes.Use)
					return if presentation == "bar"
						then (if vertical(use) then D2.fromOffset(24, 160) else D2.new(1, 0, 0, 0))
						else D2.fromOffset(0, 0)
				end),
				AutomaticSize = fixed(function(use: ComposeTypes.Use)
					return if presentation == "bar"
						then (if vertical(use) then E.AutomaticSize.None else E.AutomaticSize.Y)
						else E.AutomaticSize.XY
				end),
			})
		)
		if timeline then
			ctx.playWhileShown(timeline, root)
		end
		return root
	end)
end
