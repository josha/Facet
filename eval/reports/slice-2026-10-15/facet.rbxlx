                  <string name="Name">collection</string>
                </Properties>
                <Item class="ModuleScript" referent="255">
                  <Properties>
                    <string name="Name">admission</string>
                    <string name="Source"><![CDATA[--!strict

export type Result = {
	order: { number }?,
	admitted: number,
	pending: number,
}

local function select(count: number, limit: number?, before: (a: number, b: number) -> boolean): Result
	if limit == nil or count <= limit then
		return { order = nil, admitted = count, pending = 0 }
	end
	local order = table.create(count) :: { number }
	for index = 1, count do
		order[index] = index
	end
	table.sort(order, before)
	return { order = order, admitted = limit, pending = count - limit }
end

return select
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="256">
                  <Properties>
                    <string name="Name">frame-pump</string>
                    <string name="Source"><![CDATA[--!strict

local Diagnostics = require "../diagnostics"
local Host = require "../host"
local Owner = require "../ownership/owner"
local Types = require "../reactive/types"

export type Pump = {
	update: (pending: boolean) -> (),
}

local function create(owner: Owner.Owner, host: Host.Host, tick: Types.Cell<number>, primitive: string): Pump
	local unsubscribe: (() -> ())? = nil

	local function stop()
		if unsubscribe ~= nil then
			unsubscribe()
			unsubscribe = nil
		end
	end

	local function start()
		if unsubscribe ~= nil then
			return
		end
		local frames = host.frames
		if frames == nil then
			Diagnostics.raise(
				"collection/no-frames",
				primitive .. " has pending admission work but its host has no frames",
				{
					primitive = primitive,
					contract = "admission over time requires host.frames.onFrame",
					fix = "implement host.frames or remove the admission budget",
				}
			)
		end
		unsubscribe = (frames :: Host.Frames).onFrame(function()
			tick:update(function(value)
				return value + 1
			end)
		end)
	end

	owner.own(stop)
	return {
		update = function(pending: boolean)
			if pending then
				start()
			else
				stop()
			end
		end,
	}
end

return create
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="257">
                  <Properties>
                    <string name="Name">grid</string>
                    <string name="Source"><![CDATA[--!strict

local LIMIT = 65536
local SPAN = LIMIT * 2

export type Grid = {
	cellSize: number,
	buckets: { [number]: { number } },
	activeKeys: { number },
	pool: { { number } },
	lengths: { [number]: number },
	count: number,
	minX: number,
	maxX: number,
	minY: number,
	maxY: number,
	minZ: number,
	maxZ: number,
}

local function cellOf(value: number, cellSize: number): number
	return math.clamp(math.floor(value / cellSize), -LIMIT, LIMIT - 1)
end

local function keyOf(cx: number, cy: number, cz: number): number
	return ((cx + LIMIT) * SPAN + (cy + LIMIT)) * SPAN + (cz + LIMIT)
end

local function create(cellSize: number): Grid
	return {
		cellSize = if cellSize > 0 then cellSize else 1,
		buckets = {},
		activeKeys = {},
		pool = {},
		lengths = {},
		count = 0,
		minX = 0,
		maxX = -1,
		minY = 0,
		maxY = -1,
		minZ = 0,
		maxZ = -1,
	}
end

local function build<V>(self: Grid, list: { V }, positionOf: (value: V) -> (number, number, number))
	local buckets = self.buckets
	local lengths = self.lengths
	local activeKeys = self.activeKeys
	local pool = self.pool

	for _, key in activeKeys do
		local bucket = buckets[key]
		buckets[key] = nil
		lengths[key] = nil
		pool[#pool + 1] = bucket
	end
	table.clear(activeKeys)

	local cellSize = self.cellSize
	local total = #list
	self.count = total

	local minX, maxX = math.huge, -math.huge
	local minY, maxY = math.huge, -math.huge
	local minZ, maxZ = math.huge, -math.huge

	for index = 1, total do
		local x, y, z = positionOf(list[index])
		local cx, cy, cz = cellOf(x, cellSize), cellOf(y, cellSize), cellOf(z or 0, cellSize)
		if cx < minX then
			minX = cx
		end
		if cx > maxX then
			maxX = cx
		end
		if cy < minY then
			minY = cy
		end
		if cy > maxY then
			maxY = cy
		end
		if cz < minZ then
			minZ = cz
		end
		if cz > maxZ then
			maxZ = cz
		end
		local key = keyOf(cx, cy, cz)
		local bucket = buckets[key]
		if bucket == nil then
			bucket = table.remove(pool) or {}
			buckets[key] = bucket
			lengths[key] = 0
			activeKeys[#activeKeys + 1] = key
		end
		local at = (lengths[key] :: number) + 1
		lengths[key] = at
		bucket[at] = index
	end

	if total > 0 then
		self.minX, self.maxX = minX, maxX
		self.minY, self.maxY = minY, maxY
		self.minZ, self.maxZ = minZ, maxZ
	else
		self.minX, self.maxX = 0, -1
		self.minY, self.maxY = 0, -1
		self.minZ, self.maxZ = 0, -1
	end
end

local function query(self: Grid, x: number, y: number, z: number, radius: number, visit: (index: number) -> ()): number
	local cellSize = self.cellSize
	local buckets = self.buckets
	local minX = math.max(cellOf(x - radius, cellSize), self.minX)
	local maxX = math.min(cellOf(x + radius, cellSize), self.maxX)
	local minY = math.max(cellOf(y - radius, cellSize), self.minY)
	local maxY = math.min(cellOf(y + radius, cellSize), self.maxY)
	local minZ = math.max(cellOf(z - radius, cellSize), self.minZ)
	local maxZ = math.min(cellOf(z + radius, cellSize), self.maxZ)

	local visited = 0
	for cx = minX, maxX do
		for cy = minY, maxY do
			for cz = minZ, maxZ do
				visited += 1
				local key = keyOf(cx, cy, cz)
				local live = self.lengths[key]
				if live ~= nil and live > 0 then
					local bucket = buckets[key]
					for at = 1, live do
						visit(bucket[at])
					end
				end
			end
		end
	end
	return visited
end

return {
	create = create,
	build = build,
	query = query,
	cellOf = cellOf,
	keyOf = keyOf,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="258">
                  <Properties>
                    <string name="Name">layout</string>
                    <string name="Source"><![CDATA[--!strict

local Prefix = require "./prefix"

export type Kind = "list" | "grid"

export type Placement = {
	index: number,
	row: number,
	column: number,
	offset: number,
	size: number,
	crossOffset: number,
	crossSize: number,
}

export type Geometry = {
	count: number,
	columns: number,
	rowCount: number,
	gap: number,
	crossSize: number,
	crossGap: number,
	rowSize: number,
	uniform: boolean,
	rows: Prefix.Prefix?,
	itemSizes: { number }?,
}

local function rowsFor(count: number, columns: number): number
	if count <= 0 then
		return 0
	end
	return math.ceil(count / columns)
end

export type Options = {
	count: number,
	columns: number,
	rowSize: number,
	gap: number,
	crossSize: number,
	crossGap: number,
}

local function create(options: Options): Geometry
	local columns = math.max(1, math.floor(options.columns))
	return {
		count = options.count,
		columns = columns,
		rowCount = rowsFor(options.count, columns),
		gap = options.gap,
		crossSize = options.crossSize,
		crossGap = options.crossGap,
		rowSize = options.rowSize,
		uniform = true,
		rows = nil,
		itemSizes = nil,
	}
end

local function materialise(self: Geometry)
	if self.rows ~= nil then
		return
	end
	self.rows = Prefix.create(self.rowCount, self.rowSize + self.gap)
	self.itemSizes = table.create(self.count, self.rowSize)
	self.uniform = false
end

local function totalExtent(self: Geometry): number
	if self.rowCount == 0 then
		return 0
	end
	if self.uniform then
		return self.rowCount * (self.rowSize + self.gap) - self.gap
	end

	return (self.rows :: Prefix.Prefix).sum - self.gap
end

local function setItemSize(self: Geometry, index: number, size: number): boolean
	if index < 1 or index > self.count then
		return false
	end
	if self.uniform then
		if size == self.rowSize then
			return false
		end
		materialise(self)
	end

	local itemSizes = self.itemSizes :: { number }
	if itemSizes[index] == size then
		return false
	end
	itemSizes[index] = size

	local columns = self.columns
	local row = math.ceil(index / columns)
	local rowSize: number
	if columns == 1 then
		rowSize = size
	else
		local first = (row - 1) * columns + 1
		local last = math.min(self.count, row * columns)
		rowSize = 0
		for at = first, last do
			local candidate = itemSizes[at]
			if candidate > rowSize then
				rowSize = candidate
			end
		end
	end

	return Prefix.set(self.rows :: Prefix.Prefix, row, rowSize + self.gap)
end

local function rowSpan(self: Geometry, row: number): (number, number)
	if self.uniform then
		return (row - 1) * (self.rowSize + self.gap), self.rowSize
	end
	local rows = self.rows :: Prefix.Prefix
	return Prefix.startOf(rows, row), Prefix.extentOf(rows, row) - self.gap
end

local function rowAt(self: Geometry, offset: number): number
	if self.rowCount == 0 then
		return 0
	end
	if self.uniform then
		local stride = self.rowSize + self.gap
		if stride <= 0 then
			return 1
		end
		return math.clamp(math.floor(offset / stride) + 1, 1, self.rowCount)
	end
	local row = Prefix.find(self.rows :: Prefix.Prefix, offset)
	return math.clamp(row, 1, self.rowCount)
end

local function placementOf(self: Geometry, index: number): Placement
	local columns = self.columns
	local row = math.ceil(index / columns)
	local column = index - (row - 1) * columns
	local offset, size = rowSpan(self, row)
	return {
		index = index,
		row = row,
		column = column,
		offset = offset,
		size = size,
		crossOffset = (column - 1) * (self.crossSize + self.crossGap),
		crossSize = self.crossSize,
	}
end

local function offsetOf(self: Geometry, index: number): number
	if self.count == 0 then
		return 0
	end
	local row = math.ceil(math.clamp(index, 1, self.count) / self.columns)
	local offset = rowSpan(self, row)
	return offset
end

export type Range = {

	first: number,
	last: number,
	firstRow: number,
	lastRow: number,
}

local function rangeInto(self: Geometry, offset: number, size: number, overscan: number, out: Range): Range
	if self.rowCount == 0 then
		out.first = 1
		out.last = 0
		out.firstRow = 1
		out.lastRow = 0
		return out
	end

	local firstRow = rowAt(self, math.max(0, offset))
	local lastRow: number
	if size <= 0 then
		lastRow = firstRow
	else
		lastRow = rowAt(self, math.max(0, offset) + size)

		local rowStart = rowSpan(self, lastRow)
		if lastRow > firstRow and rowStart >= offset + size then
			lastRow -= 1
		end
	end

	firstRow = math.max(1, firstRow - overscan)
	lastRow = math.min(self.rowCount, lastRow + overscan)

	local columns = self.columns
	out.first = (firstRow - 1) * columns + 1
	out.last = math.min(self.count, lastRow * columns)
	out.firstRow = firstRow
	out.lastRow = lastRow
	return out
end

local function rangeFor(self: Geometry, offset: number, size: number, overscan: number): Range
	return rangeInto(self, offset, size, overscan, { first = 1, last = 0, firstRow = 1, lastRow = 0 })
end

return {
	create = create,
	rowsFor = rowsFor,
	totalExtent = totalExtent,
	setItemSize = setItemSize,
	placementOf = placementOf,
	offsetOf = offsetOf,
	rowAt = rowAt,
	rowSpan = rowSpan,
	rangeFor = rangeFor,
	rangeInto = rangeInto,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="259">
                  <Properties>
                    <string name="Name">prefix</string>
                    <string name="Source"><![CDATA[--!strict

export type Prefix = {
	count: number,

	tree: { number },
	extents: { number },
	sum: number,
}

local function create(count: number, extent: number): Prefix
	local tree = table.create(count + 1, 0)
	local extents = table.create(count, extent)

	for index = 1, count do
		tree[index] += extent
		local parent = index + bit32.band(index, -index)
		if parent <= count then
			tree[parent] += tree[index]
		end
	end

	return {
		count = count,
		tree = tree,
		extents = extents,
		sum = extent * count,
	}
end

local function extentOf(self: Prefix, index: number): number
	return self.extents[index]
end

local function set(self: Prefix, index: number, extent: number): boolean
	local current = self.extents[index]
	local delta = extent - current
	if delta == 0 then
		return false
	end
	self.extents[index] = extent
	self.sum += delta

	local tree = self.tree
	local count = self.count
	local at = index
	while at <= count do
		tree[at] += delta
		at += bit32.band(at, -at)
	end
	return true
end

local function startOf(self: Prefix, index: number): number
	local tree = self.tree
	local total = 0
	local at = index - 1
	while at > 0 do
		total += tree[at]
		at -= bit32.band(at, -at)
	end
	return total
end

local function find(self: Prefix, offset: number): (number, number)
	local count = self.count
	if count == 0 then
		return 0, 0
	end
	if offset <= 0 then
		return 1, 0
	end

	local tree = self.tree
	local index = 0
	local remaining = offset
	local step = 1
	while step * 2 <= count do
		step *= 2
	end
	while step > 0 do
		local next = index + step
		if next <= count and tree[next] <= remaining then
			index = next
			remaining -= tree[next]
		end
		step //= 2
	end

	local row = index + 1
	if row > count then
		return count, self.sum - self.extents[count]
	end
	return row, offset - remaining
end

return {
	create = create,
	set = set,
	startOf = startOf,
	extentOf = extentOf,
	find = find,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="260">
                  <Properties>
                    <string name="Name">relevance</string>
                    <string name="Source"><![CDATA[--!strict

local Diagnostics = require "../diagnostics"

export type Tier = {
	name: string,
	radius: number,
}

local function checkTiers(tiers: { Tier }, primitive: string)
	if #tiers == 0 then
		Diagnostics.raise("collection/no-tiers", ("%s was given an empty tier list"):format(primitive), {
			primitive = primitive,
			contract = "a spatial collection needs at least one representation tier",
			fix = 'pass tiers = { { name = "full", radius = 100 } }',
		})
	end
	local previous = -math.huge
	for index, tier in tiers do
		if type(tier.name) ~= "string" then
			Diagnostics.raise("collection/tier-unnamed", ("%s was given a tier with no name"):format(primitive), {
				primitive = primitive,
				index = index,
				expected = 'name = a string, e.g. "full"',
				actual = Diagnostics.describe(tier.name),
			})
		end
		if type(tier.radius) ~= "number" or tier.radius ~= tier.radius then
			Diagnostics.raise(
				"collection/tier-radius",
				("%s was given a tier with no usable radius"):format(primitive),
				{
					primitive = primitive,
					index = index,
					detail = ("tier %q"):format(tier.name),
					expected = "radius = a number",
					actual = Diagnostics.describe(tier.radius),
				}
			)
		end
		if tier.radius < previous then
			Diagnostics.raise("collection/tiers-unordered", ("%s was given tiers out of order"):format(primitive), {
				primitive = primitive,
				index = index,
				detail = ("tier %q has radius %s, inside the tier before it"):format(tier.name, tostring(tier.radius)),
				contract = "tiers are listed nearest first, by ascending radius",
				fix = "order the list so each radius is at least the one before it",
			})
		end
		previous = tier.radius
	end
end

local function tierFor(distance: number, current: number?, tiers: { Tier }, hysteresis: number, scale: number): number?
	for index = 1, #tiers do
		local radius = tiers[index].radius * scale

		if current ~= nil and current <= index then
			radius += hysteresis
		end
		if distance <= radius then
			return index
		end
	end
	return nil
end

local function pinnedTier(
	distance: number,
	current: number?,
	tiers: { Tier },
	hysteresis: number,
	scale: number
): number
	local tier = tierFor(distance, current, tiers, hysteresis, scale)
	return if tier ~= nil then tier else #tiers
end

return {
	checkTiers = checkTiers,
	tierFor = tierFor,
	pinnedTier = pinnedTier,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="261">
                  <Properties>
                    <string name="Name">retain</string>
                    <string name="Source"><![CDATA[--!strict

local Children = require "../runtime/children"
local Host = require "../host"
local Support = require "../structure/support"
local Types = require "../reactive/types"
local cellModule = require "../reactive/cell"
local keyed = require "../structure/keyed"

export type Render<V, S, K> = (value: Types.Readable<V>, state: Types.Readable<S>, key: K) -> Host.Node

export type Selection<V, S, K> = {
	values: { V },
	keys: { K },
	states: { S },
}

export type Options<V, S, K> = {
	primitive: string,
	source: Types.Body<{ V }>,
	select: (use: Types.Use, list: { V }) -> Selection<V, S, K>,
	render: Render<V, S, K>,
	equals: ((a: S, b: S) -> boolean)?,
}

local function retain<V, S, K>(options: Options<V, S, K>): Children.Directive
	local source = options.source
	local selectItems = options.select
	local render = options.render
	local equals = options.equals

	local states: { [K]: Types.Cell<S> } = {}
	local keysAt: { K } = {}
	local pending: { [K]: S } = {}
	local present: { [K]: true } = {}

	local function slice(use: Types.Use): { V }
		local list = source(use)
		local selection = selectItems(use, list)
		local values, keys, itemStates = selection.values, selection.keys, selection.states
		local count = #values

		table.clear(present)
		table.clear(keysAt)
		for index = 1, count do
			local key = keys[index]
			keysAt[index] = key
			present[key] = true
			local held = states[key]
			if held ~= nil then
				held:set(itemStates[index])
			else
				pending[key] = itemStates[index]
			end
		end

		for key in states do
			if present[key] == nil then
				states[key] = nil
			end
		end

		return values
	end

	local function keyOfRetained(_value: V, index: number): K
		return keysAt[index]
	end

	local function renderRetained(value: Types.Readable<V>, _index: Types.Readable<number>, key: K): Host.Node
		local state = states[key]
		if state == nil then
			state = cellModule.cell(pending[key], equals)
			states[key] = state
			pending[key] = nil
		end
		return render(value, state :: Types.Cell<S>, key)
	end

	local inner = keyed { from = slice, key = keyOfRetained, render = renderRetained }
	return function(mountPoint: Children.MountPoint)
		Support.mountPointOf(mountPoint, options.primitive)
		inner(mountPoint)
	end
end

return retain
]]></string>
                  </Properties>
                </Item>
              </Item>
              <Item class="ModuleScript" referent="262">
                <Properties>
                  <string name="Name">diagnostics</string>
                  <string name="Source"><![CDATA[--!strict

export type Fields = {
	component: string?,
	node: string?,
	kind: string?,
	key: string?,
	event: string?,
	index: number?,
	expected: string?,
	actual: string?,
	contract: string?,
	fix: string?,
	detail: string?,
}

local function format(code: string, summary: string, fields: Fields?): string
	local lines = { ("Compose[%s]: %s"):format(code, summary) }

	if fields ~= nil then
		local function line(name: string, value: (string | number)?)
			if value ~= nil then
				table.insert(lines, ("  %s: %s"):format(name, tostring(value)))
			end
		end
		line("component", fields.component)
		line("node", fields.node)
		line("kind", fields.kind)
		line("key", fields.key)
		line("event", fields.event)
		line("index", fields.index)
		line("expected", fields.expected)
		line("actual", fields.actual)
		line("detail", fields.detail)
		line("contract", fields.contract)
		line("fix", fields.fix)
	end

	table.insert(lines, "  see: docs/index.md")
	return table.concat(lines, "\n")
end

local function raise(code: string, summary: string, fields: Fields?, level: number?): never
	return error(format(code, summary, fields), if level ~= nil then level else 0) :: never
end

local function describe(value: unknown): string
	local kind = typeof(value)
	if kind == "string" then
		return ("string %q"):format(value :: string)
	elseif kind == "number" or kind == "boolean" or kind == "nil" then
		return ("%s %s"):format(kind, tostring(value))
	end
	return kind
end

export type Parsed = {
	code: string,
	summary: string,
	fields: { [string]: string },
}

local function parse(message: string): Parsed?
	local at = string.find(message, "Compose[", 1, true)
	if at == nil then
		return nil
	end
	local body = string.sub(message, at)

	local code, summary = string.match(body, "^Compose%[([^%]]+)%]:%s*([^\n]*)")
	if code == nil then
		return nil
	end

	local fields: { [string]: string } = {}
	for line in string.gmatch(body, "\n([^\n]*)") do
		local name, value = string.match(line, "^%s%s([%w_]+):%s(.*)$")
		if name ~= nil then
			fields[name :: string] = value :: string
		end
	end

	return { code = code :: string, summary = summary :: string, fields = fields }
end

return {
	format = format,
	raise = raise,
	describe = describe,
	parse = parse,
}
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="263">
                <Properties>
                  <string name="Name">focus-neighbor</string>
                  <string name="Source"><![CDATA[--!strict

local FocusScope = require "./focus-scope"
local Diagnostics = require "./diagnostics"

export type FocusRect = { x: number, y: number, width: number, height: number }

local function focusNeighbor(from: FocusRect, candidates: { FocusRect }, direction: FocusScope.Direction): number?
	if direction ~= "left" and direction ~= "right" and direction ~= "up" and direction ~= "down" then
		Diagnostics.raise("focus-neighbor/unknown-direction", "focusNeighbor needs a known direction", {
			expected = '"left", "right", "up", or "down"',
		})
	end
	local vertical = direction == "up" or direction == "down"
	local forward = direction == "down" or direction == "right"
	local bestTier, bestPrimary, bestAcross, found = math.huge, math.huge, math.huge, nil
	for index, candidate in candidates do
		local gap, along, across, overlap, extent, reach
		if vertical then
			local edge = if forward then from.y + from.height else from.y
			extent = from.height
			reach = if forward then candidate.y + candidate.height - edge else edge - candidate.y
			gap = if forward then candidate.y - edge else edge - (candidate.y + candidate.height)
			along = (candidate.y + candidate.height / 2 - edge) * (if forward then 1 else -1)
			across = math.abs(candidate.x + candidate.width / 2 - (from.x + from.width / 2))
			overlap = candidate.x < from.x + from.width and from.x < candidate.x + candidate.width
		else
			local edge = if forward then from.x + from.width else from.x
			extent = from.width
			reach = if forward then candidate.x + candidate.width - edge else edge - candidate.x
			gap = if forward then candidate.x - edge else edge - (candidate.x + candidate.width)
			along = (candidate.x + candidate.width / 2 - edge) * (if forward then 1 else -1)
			across = math.abs(candidate.y + candidate.height / 2 - (from.y + from.height / 2))
			overlap = candidate.y < from.y + from.height and from.y < candidate.y + candidate.height
		end
		if gap > -extent / 2 and (overlap or reach > 0) then
			local tier, primary
			if overlap then
				tier, primary = 0, gap
			elseif across < along then
				tier, primary = 1, across + along * 0.028
			else
				tier, primary = 2, across / math.max(along, 1) ^ 0.15
			end
			if
				tier < bestTier
				or (tier == bestTier and (primary < bestPrimary or (primary == bestPrimary and across < bestAcross)))
			then
				bestTier, bestPrimary, bestAcross, found = tier, primary, across, index
			end
		end
	end
	return found
end

return focusNeighbor
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="264">
                <Properties>
                  <string name="Name">focus-scope</string>
                  <string name="Source"><![CDATA[--!strict

local Active = require "./ownership/active"
local Diagnostics = require "./diagnostics"
local Owner = require "./ownership/owner"
local Types = require "./reactive/types"
local cellModule = require "./reactive/cell"
local formula = require "./reactive/formula"
local Support = require "./structure/support"

export type Options<V, K> = {
	from: Types.Readable<{ V }> | Types.Body<{ V }>,
	key: ((value: V, index: number) -> K)?,
	disabled: ((value: V, index: number) -> boolean)?,
	position: ((value: V, index: number) -> (number, number))?,
	wrap: boolean?,
	initial: K?,
	autoFocus: boolean?,
}

export type FocusScope<K> = {
	current: Types.Readable<K?>,
	focus: (key: K) -> boolean,
	clear: () -> (),
	next: () -> K?,
	previous: () -> K?,
	move: (direction: Direction) -> K?,
	first: () -> K?,
	last: () -> K?,
	isFocused: (key: K) -> Types.Readable<boolean>,
}

export type Direction = "left" | "right" | "up" | "down"

local KNOWN_FIELDS: { [string]: true } = {
	from = true,
	key = true,
	disabled = true,
	position = true,
	wrap = true,
	initial = true,
	autoFocus = true,
}

local function identity<V>(value: V, _index: number): V
	return value
end

local function createFocusScope<V, K>(options: Options<V, K>): FocusScope<K>
	local settings = Support.optionsOf(options, "createFocusScope", "from = ..., key = ...")
	Support.noUnknownFields(settings, "createFocusScope", KNOWN_FIELDS)
	local owner = Active.current()
	if owner == nil then
		Diagnostics.raise("focus-scope/no-active-owner", "createFocusScope ran outside an owner", {
			contract = "a focus scope lives exactly as long as the component or owner that created it",
			fix = "create it inside a component or Compose.withOwner(owner, ...)",
		})
	end
	local source = Support.sourceOf(settings.from, "createFocusScope", "from") :: Types.Body<{ V }>
	local keyOf: (value: V, index: number) -> K = if settings.key == nil
		then (identity :: unknown) :: (value: V, index: number) -> K
		else Support.builderOf(settings.key, "createFocusScope", "key")
	local disabled: ((value: V, index: number) -> boolean)? = if settings.disabled == nil
		then nil
		else Support.builderOf(settings.disabled, "createFocusScope", "disabled")
	local positionOf: ((value: V, index: number) -> (number, number))? = if settings.position == nil
		then nil
		else Support.builderOf(settings.position, "createFocusScope", "position")
	local wrap = settings.wrap == true
	local autoFocus = settings.autoFocus == true
	local initial: K? = settings.initial
	local current: Types.Cell<K?> = cellModule.cell(initial)
	local order: { K } = {}
	local positions: { [K]: number } = {}
	local points: { [K]: { x: number, y: number } } = {}
	local alive = true
	local holder = owner :: Owner.Owner

	holder.own(function()
		alive = false
		table.clear(order)
		table.clear(positions)
		table.clear(points)
	end)
	holder.watch(function(use)
		local list = source(use)
		table.clear(order)
		table.clear(positions)
		table.clear(points)
		for index, value in list do
			if disabled == nil or not (disabled :: (V, number) -> boolean)(value, index) then
				local key = keyOf(value, index)
				if positions[key] ~= nil then
					Diagnostics.raise("focus-scope/duplicate-key", "createFocusScope encountered the same key twice", {
						index = index,
						contract = "focus candidates have stable unique keys",
					})
				end
				order[#order + 1] = key
				positions[key] = #order
				if positionOf ~= nil then
					local x, y = (positionOf :: (V, number) -> (number, number))(value, index)
					if
						type(x) ~= "number"
						or type(y) ~= "number"
						or x ~= x
						or y ~= y
						or math.abs(x) == math.huge
						or math.abs(y) == math.huge
					then
						Diagnostics.raise(
							"focus-scope/invalid-position",
							"createFocusScope.position returned invalid coordinates",
							{
								index = index,
								expected = "two finite numbers",
							}
						)
					end
					points[key] = { x = x, y = y }
				end
			end
		end
		local selected = current:peek()
		if selected ~= nil and positions[selected] == nil then
			current:set(if autoFocus then order[1] else nil)
		elseif selected == nil and autoFocus then
			current:set(order[1])
		end
	end)

	local function ensureAlive(): boolean
		return alive
	end

	local function focus(key: K): boolean
		if not ensureAlive() or positions[key] == nil then
			return false
		end
		current:set(key)
		return true
	end

	local function clear()
		if ensureAlive() then
			current:set(nil)
		end
	end

	local function choose(index: number): K?
		if not ensureAlive() or #order == 0 then
			return nil
		end
		local target = index
		if wrap then
			target = ((target - 1) % #order) + 1
		else
			target = math.clamp(target, 1, #order)
		end
		local key = order[target]
		current:set(key)
		return key
	end

	local function first(): K?
		return choose(1)
	end

	local function last(): K?
		return choose(#order)
	end

	local function move(delta: number): K?
		local selected = current:peek()
		if selected == nil then
			return if delta > 0 then first() else last()
		end
		return choose((positions[selected] or 1) + delta)
	end

	local function moveDirection(direction: Direction): K?
		if direction ~= "left" and direction ~= "right" and direction ~= "up" and direction ~= "down" then
			Diagnostics.raise("focus-scope/unknown-direction", "focus movement needs a known direction", {
				actual = Diagnostics.describe(direction),
				expected = '"left", "right", "up", or "down"',
			})
		end
		if positionOf == nil then
			Diagnostics.raise("focus-scope/no-positions", "directional focus movement needs candidate positions", {
				fix = "pass position = function(item) return item.x, item.y end, or use next/previous",
			})
		end
		local selected = current:peek()
		if selected == nil or points[selected] == nil then
			return first()
		end
		local origin = points[selected]
		local best: K? = nil
		local bestScore = math.huge
		for _, key in order do
			if key ~= selected then
				local point = points[key]
				local dx, dy = point.x - origin.x, point.y - origin.y
				local primary, cross: number
				if direction == "left" then
					primary, cross = -dx, math.abs(dy)
				elseif direction == "right" then
					primary, cross = dx, math.abs(dy)
				elseif direction == "up" then
					primary, cross = -dy, math.abs(dx)
				else
					primary, cross = dy, math.abs(dx)
				end
				if primary > 0 then
					local score = primary + cross * 2
					if score < bestScore then
						best, bestScore = key, score
					end
				end
			end
		end
		if best ~= nil then
			current:set(best)
			return best
		end
		return selected
	end

	local function isFocused(key: K): Types.Readable<boolean>
		local value = formula(function(use)
			return use(current) == key
		end)
		holder.own(function()
			value:dispose()
		end)
		return value
	end

	return {
		current = current,
		focus = focus,
		clear = clear,
		next = function()
			return move(1)
		end,
		previous = function()
			return move(-1)
		end,
		move = moveDirection,
		first = first,
		last = last,
		isFocused = isFocused,
	}
end

return createFocusScope
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="265">
                <Properties>
                  <string name="Name">geometry</string>
                  <string name="Source"><![CDATA[--!strict

local Diagnostics = require "./diagnostics"

export type Size = { width: number, height: number }
export type Insets = { left: number?, top: number?, right: number?, bottom: number? }
export type Anchor = { x: number, y: number }
export type Frame = { left: number, top: number, right: number, bottom: number, width: number, height: number }
export type Bounds = { left: number, top: number, right: number, bottom: number }
export type FitOptions = { min: Size?, max: Size?, anchor: Anchor? }
export type ClearOptions<R> = { within: unknown?, reserved: { R }? }

local CENTER: Anchor = { x = 0.5, y = 0.5 }

local function finite(value: unknown): boolean
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function number(value: unknown, name: string, minimum: number?): number
	if not finite(value) or (minimum ~= nil and (value :: number) < minimum) then
		Diagnostics.raise("geometry/invalid-number", ("%s must be a finite number"):format(name), {
			actual = Diagnostics.describe(value),
			expected = if minimum ~= nil
				then ("a finite number of %s or more"):format(tostring(minimum))
				else "a finite number",
		})
	end
	return value :: number
end

local function bounds(value: unknown, name: string): Bounds
	if type(value) ~= "table" then
		Diagnostics.raise("geometry/invalid-rect", ("%s must be a rect"):format(name), {
			actual = Diagnostics.describe(value),
			expected = "{ left, top, right, bottom } with finite numbers",
		})
	end
	local rect = value :: Bounds
	number(rect.left, name .. ".left")
	number(rect.top, name .. ".top")
	number(rect.right, name .. ".right")
	number(rect.bottom, name .. ".bottom")
	if rect.right < rect.left or rect.bottom < rect.top then
		Diagnostics.raise("geometry/invalid-rect", ("%s has a negative extent"):format(name), {
			actual = ("left %s, right %s, top %s, bottom %s"):format(
				tostring(rect.left),
				tostring(rect.right),
				tostring(rect.top),
				tostring(rect.bottom)
			),
			expected = "right at or after left, and bottom at or after top",
			fix = "clamp a computed width or height at zero before building the rect",
		})
	end
	return rect
end

local function size(value: unknown, name: string): Size
	if type(value) ~= "table" then
		Diagnostics.raise("geometry/invalid-size", ("%s must be a size"):format(name), {
			actual = Diagnostics.describe(value),
			expected = "{ width, height } with finite numbers of zero or more",
		})
	end
	local result = value :: Size
	number(result.width, name .. ".width", 0)
	number(result.height, name .. ".height", 0)
	return result
end

local function build(left: number, top: number, width: number, height: number): Frame
	return { left = left, top = top, right = left + width, bottom = top + height, width = width, height = height }
end

local function safeArea(viewport: Size, insets: Insets?, margin: number?): Frame
	size(viewport, "viewport")
	local edge = if margin ~= nil then number(margin, "margin", 0) else 0
	local left, top, right, bottom = 0, 0, 0, 0
	if insets ~= nil then
		if type(insets) ~= "table" then
			Diagnostics.raise("geometry/invalid-insets", "insets must be a table", {
				actual = Diagnostics.describe(insets),
				expected = "{ left?, top?, right?, bottom? } with numbers of zero or more",
			})
		end
		left = if insets.left ~= nil then number(insets.left, "insets.left", 0) else 0
		top = if insets.top ~= nil then number(insets.top, "insets.top", 0) else 0
		right = if insets.right ~= nil then number(insets.right, "insets.right", 0) else 0
		bottom = if insets.bottom ~= nil then number(insets.bottom, "insets.bottom", 0) else 0
	end
	return build(
		left + edge,
		top + edge,
		math.max(0, viewport.width - left - right - edge * 2),
		math.max(0, viewport.height - top - bottom - edge * 2)
	)
end

local function fit(available: Bounds, desired: Size, options: FitOptions?): Frame
	bounds(available, "available")
	size(desired, "desired")
	local settings = if options ~= nil then options else {} :: FitOptions
	local minimum = if settings.min ~= nil then size(settings.min, "min") else nil
	local maximum = if settings.max ~= nil then size(settings.max, "max") else nil
	if minimum ~= nil and maximum ~= nil and (minimum.width > maximum.width or minimum.height > maximum.height) then
		Diagnostics.raise("geometry/invalid-limits", "the minimum size exceeds the maximum size", {
			actual = ("min %sx%s, max %sx%s"):format(
				tostring(minimum.width),
				tostring(minimum.height),
				tostring(maximum.width),
				tostring(maximum.height)
			),
			expected = "a minimum no larger than the maximum on both axes",
		})
	end
	local anchor = CENTER
	if settings.anchor ~= nil then
		anchor = settings.anchor
		if
			type(anchor) ~= "table"
			or not finite(anchor.x)
			or not finite(anchor.y)
			or anchor.x < 0
			or anchor.x > 1
			or anchor.y < 0
			or anchor.y > 1
		then
			Diagnostics.raise("geometry/invalid-anchor", "an anchor needs x and y fractions between 0 and 1", {
				actual = Diagnostics.describe(settings.anchor),
				expected = "{ x = 0.5, y = 0.5 } centers; { x = 0, y = 0 } is the top left",
			})
		end
	end
	local room = { width = available.right - available.left, height = available.bottom - available.top }
	local width = desired.width
	local height = desired.height
	if maximum ~= nil then
		width = math.min(width, maximum.width)
		height = math.min(height, maximum.height)
	end
	if minimum ~= nil then
		width = math.max(width, minimum.width)
		height = math.max(height, minimum.height)
	end
	width = math.min(width, room.width)
	height = math.min(height, room.height)
	return build(
		available.left + (room.width - width) * anchor.x,
		available.top + (room.height - height) * anchor.y,
		width,
		height
	)
end

local function intersects(a: Bounds, b: Bounds): boolean
	return a.left < b.right and a.right > b.left and a.top < b.bottom and a.bottom > b.top
end

local function encloses(outer: Bounds, inner: Bounds): boolean
	return inner.left >= outer.left
		and inner.right <= outer.right
		and inner.top >= outer.top
		and inner.bottom <= outer.bottom
end

local function overlaps(a: Bounds, b: Bounds): boolean
	return intersects(bounds(a, "a"), bounds(b, "b"))
end

local function contains(outer: Bounds, inner: Bounds): boolean
	return encloses(bounds(outer, "outer"), bounds(inner, "inner"))
end

local function firstClear<T, R>(candidates: { T }, options: ClearOptions<R>?): (T?, number?)
	if type(candidates) ~= "table" then
		Diagnostics.raise("geometry/invalid-candidates", "candidates must be a list of rects", {
			actual = Diagnostics.describe(candidates),
			expected = "an array of { left, top, right, bottom } in preference order",
		})
	end
	local settings = if options ~= nil then options else {} :: ClearOptions<R>
	local within = if settings.within ~= nil then bounds(settings.within, "within") else nil
	local reserved: { R } = if settings.reserved ~= nil then settings.reserved else {}
	for index, region in reserved do
		bounds(region, ("reserved[%d]"):format(index))
	end
	for index, candidate in candidates do
		bounds(candidate, ("candidates[%d]"):format(index))
		local clear = within == nil or encloses(within :: Bounds, (candidate :: unknown) :: Bounds)
		if clear then
			for _, region in reserved do
				if intersects((candidate :: unknown) :: Bounds, (region :: unknown) :: Bounds) then
					clear = false
					break
				end
			end
		end
		if clear then
			return candidate, index
		end
	end
	return nil, nil
end

return table.freeze {
	safeArea = safeArea,
	fit = fit,
	overlaps = overlaps,
	contains = contains,
	firstClear = firstClear,
}
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="266">
                <Properties>
                  <string name="Name">host</string>
                  <string name="Source"><![CDATA[--!strict

local Diagnostics = require "./diagnostics"

export type Node = unknown

export type Unsubscribe = () -> ()

export type KeyKind = "property" | "event"

export type Renderer = {
	createNode: (kind: string) -> Node,
	setProperty: (node: Node, key: string, value: unknown) -> (),
	clearProperty: (node: Node, key: string) -> (),

	setAttribute: ((node: Node, name: string, value: unknown) -> (boolean, string?))?,

	insertChild: (parent: Node, child: Node, position: number?) -> (),

	moveChild: ((parent: Node, child: Node, position: number) -> ())?,

	removeChild: (parent: Node, child: Node) -> (),

	destroyNode: (node: Node) -> (),
}

export type Events = {
	connectEvent: <Args...>(node: Node, event: string, handler: (Args...) -> ()) -> Unsubscribe,

	classifyKey: ((node: Node, key: string) -> KeyKind)?,
}

export type Observation = {
	readProperty: (node: Node, key: string) -> unknown,
	observeProperty: (node: Node, key: string, listener: () -> ()) -> Unsubscribe,
}

export type Naming = {

	setName: (node: Node, label: string) -> (),
}

export type Frames = {
	onFrame: (listener: (delta: number) -> ()) -> Unsubscribe,
	now: () -> number,
}

export type Host = {
	name: string,
	render: Renderer,
	events: Events?,
	observation: Observation?,
	frames: Frames?,
	naming: Naming?,
	describeNode: ((node: Node) -> string)?,
	typeNameOf: ((value: unknown) -> string)?,
}

type LooseHost = {
	name: unknown,
	render: { [string]: unknown }?,
	events: { [string]: unknown }?,
	observation: { [string]: unknown }?,
	frames: { [string]: unknown }?,
	naming: { [string]: unknown }?,
}

local REQUIRED_RENDERER = {
	"createNode",
	"setProperty",
	"clearProperty",
	"insertChild",
	"removeChild",
	"destroyNode",
}

local function validate(host: Host)
	if type(host) ~= "table" then
		Diagnostics.raise("host/not-a-host", "createRuntime expects a host table", {
			actual = Diagnostics.describe(host),
			contract = "a host implements the protocol in src/core/host.luau",
		})
	end
	if type(host.name) ~= "string" or host.name == "" then
		Diagnostics.raise("host/unnamed", "a host must name itself", {
			contract = "host.name appears in every diagnostic Compose raises about this host",
			fix = 'set host.name, e.g. "roblox"',
		})
	end

	local loose = (host :: unknown) :: LooseHost

	if type(loose.render) ~= "table" then
		Diagnostics.raise("host/no-renderer", ("host %q has no render capability"):format(host.name), {
			contract = "render is the one required capability",
		})
	end
	local renderer = loose.render :: { [string]: unknown }
	for _, method in REQUIRED_RENDERER do
		if type(renderer[method]) ~= "function" then
			Diagnostics.raise("host/incomplete-renderer", ("host %q is missing render.%s"):format(host.name, method), {
				expected = "a function",
				actual = Diagnostics.describe(renderer[method]),
				contract = "every method in Renderer is required",
			})
		end
	end

	local events = loose.events
	if events ~= nil and type(events.connectEvent) ~= "function" then
		Diagnostics.raise(
			"host/incomplete-events",
			("host %q declares events without connectEvent"):format(host.name),
			{
				contract = "a declared capability must be complete",
				fix = "either implement connectEvent or omit host.events entirely",
			}
		)
	end

	local observation = loose.observation
	if observation ~= nil then
		if type(observation.readProperty) ~= "function" or type(observation.observeProperty) ~= "function" then
			Diagnostics.raise(
				"host/incomplete-observation",
				("host %q declares observation but does not implement it"):format(host.name),
				{
					contract = "observation requires both readProperty and observeProperty",
					fix = "either implement both or omit host.observation entirely",
				}
			)
		end
	end

	local naming = loose.naming
	if naming ~= nil then
		if type(naming.setName) ~= "function" then
			Diagnostics.raise(
				"host/incomplete-naming",
				("host %q declares naming but does not implement it"):format(host.name),
				{
					contract = "naming requires setName",
					fix = "either implement setName or omit host.naming entirely",
				}
			)
		end
	end

	local frames = loose.frames
	if frames ~= nil then
		if type(frames.onFrame) ~= "function" or type(frames.now) ~= "function" then
			Diagnostics.raise(
				"host/incomplete-frames",
				("host %q declares frames but does not implement it"):format(host.name),
				{
					contract = "frames requires both onFrame and now",
					fix = "either implement both or omit host.frames entirely",
				}
			)
		end
	end
end

local function typeNameOf(host: Host, value: unknown): string
	local name = host.typeNameOf
	if name ~= nil then
		return name(value)
	end
	return typeof(value)
end

local function describeNode(host: Host, node: Node): string
	local describe = host.describeNode
	if describe ~= nil then
		local ok, label = pcall(describe, node)
		if ok and type(label) == "string" then
			return label
		end
	end
	return tostring(node)
end

return {
	validate = validate,
	describeNode = describeNode,
	typeNameOf = typeNameOf,
}
]]></string>
