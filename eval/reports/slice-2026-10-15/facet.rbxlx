  <Item class="Workspace" referent="414">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
    <Item class="Part" referent="415">
      <Properties>
        <string name="Name">Mechanic</string>
        <bool name="Anchored">true</bool>
        <Color3uint8 name="Color3uint8">16761920</Color3uint8>
        <Vector3 name="Position">
          <X>24</X>
          <Y>3</Y>
          <Z>0</Z>
        </Vector3>
        <Vector3 name="size">
          <X>3</X>
          <Y>6</Y>
          <Z>3</Z>
        </Vector3>
      </Properties>
    </Item>
    <Item class="SpawnLocation" referent="416">
      <Properties>
        <string name="Name">SpawnLocation</string>
        <bool name="Anchored">true</bool>
        <Vector3 name="Position">
          <X>0</X>
          <Y>0.5</Y>
