                  <Properties>
                    <string name="Name">sink</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local Graph = require "./graph"
local Weak = require "../weak"
local Types = require "./types"
local profile = require "./profile"
local stats = require "./stats"
local statsOn = stats.state
local runTracked = Graph.runTracked
local PRODUCER = Graph.PRODUCER
local OBSERVED = Graph.OBSERVED
local CLEAN = Graph.CLEAN
local CHECK = Graph.CHECK

type Dispose = Types.Dispose
type Edge = Graph.Edge
type Consumer = Graph.Consumer
type Reactor = Graph.Reactor
type Scheduled = Graph.Scheduled
type Tracked = Graph.Tracked

export type Member = Tracked

export type Sink = {
	state: number,
	dependencies: { Edge },
	reads: number,
	enqueue: ((Consumer) -> ()) | false | nil,
	enqueueSettle: ((Consumer) -> ()) | false | nil,
	released: boolean,
	retry: boolean?,
	derived: boolean?,
	queued: boolean,
	run: (self: Scheduled) -> ...unknown,

	reactor: Reactor,
	members: { Member },
	at: number,
	live: number,
	evicted: { Member }?,
	report: (err: unknown, member: Member) -> (),
	evict: (member: Member) -> (),
	edge: Edge,
	running: boolean?,
	membersChanged: boolean?,
}

export type Host = Graph.Producer & {
	sinks: { [Reactor]: Sink }?,
}

local UNATTACHED: Edge = {}

local function releaseIfEmpty(self: Sink, producer: Host)
	if self.released or #self.members > 0 then
		return
	end
	self.queued = false
	Graph.release(self)
	local sinks = producer.sinks
	if sinks ~= nil then
		sinks[self.reactor] = nil
	end
end

local function pass(self: Sink)
	local members = self.members
	local producer = self.edge[PRODUCER]
	local live = self.live

	for index = self.at + 1, #members do
		self.at = index
		local member = members[index]
		if not member.released then
			live += 1
			member.state = CLEAN
			if statsOn.enabled then
				stats.bump "watchRuns"
				profile.enterRun(member)
			end

			runTracked(member)

			if not member.released and (member.reads ~= 1 or member.dependencies[1][PRODUCER] ~= producer) then
				local evicted = self.evicted or {}
				self.evicted = evicted
				table.insert(evicted, member)
			end
		end
	end

	self.live = live
end

local function run(scheduled: Scheduled)
	local self = scheduled :: Sink
	if self.released then
		return
	end

	local edge = self.edge
	local producer: Host = edge[PRODUCER] :: Host
	if self.state == CHECK then
		local refresh = producer.refresh
		if refresh then
			self.retry = true
			(refresh :: (Graph.Producer) -> ())(producer)
			self.retry = false
		end
		if producer.version == edge[OBSERVED] then
			self.state = CLEAN
			return
		end
	end
	self.state = CLEAN
	edge[OBSERVED] = producer.version

	local members = self.members
	local failures: { string }? = nil

	local context = Graph.captureEvaluationContext()

	self.running = true
	self.at = 0
	self.live = 0
	while true do
		local ok, err: unknown = pcall(pass, self)
		if ok then
			break
		end
		Graph.restoreEvaluationContext(context)

		failures = failures or {}
		table.insert(failures :: { string }, tostring(err))
		if self.at >= #members then
			break
		end
	end

	self.running = false
	if self.live ~= #members or self.membersChanged then
		self.membersChanged = false
		local kept = 0
		for index = 1, #members do
			local member = members[index]
			if not member.released then
				kept += 1
				members[kept] = member
			end
		end
		for index = #members, kept + 1, -1 do
			members[index] = nil
		end
	end

	local evicted = self.evicted
	if evicted then
		self.evicted = nil
		for _, member in evicted do
			self.evict(member)
		end
	end

	releaseIfEmpty(self, producer)

	if failures ~= nil then
		local collected = failures :: { string }
		if #collected == 1 then
			error(collected[1], 0)
		end
		error(("Compose: %d fused bindings failed:\n  %s"):format(#collected, table.concat(collected, "\n  ")), 0)
	end
end

local function enqueue(consumer: Consumer)
	local self = consumer :: Sink
	if self.released then
		return
	end
	self.reactor:__enqueue(self)
end

local function sinkFor(
	producer: Host,
	reactor: Reactor,
	report: (err: unknown, member: Member) -> (),
	evict: (member: Member) -> ()
): Sink
	local sinks = producer.sinks or Weak.keys() :: { [Reactor]: Sink }
	producer.sinks = sinks
	local existing = sinks[reactor]
	if existing ~= nil and not existing.released then
		return existing
	end

	local self: Sink = {
		state = Graph.CLEAN,
		dependencies = {},
		reads = 0,
		released = false,
		queued = false,
		reactor = reactor,
		members = {},

		at = 0,
		live = 0,
		evicted = nil,
		report = report,
		evict = evict,
		run = run,

		enqueue = reactor.__enqueueConsumer or enqueue,

		enqueueSettle = reactor.__enqueueSettleConsumer or false,
		edge = UNATTACHED,
	}
	self.edge = Graph.attach(producer, self)
	self.dependencies[1] = self.edge
	sinks[reactor] = self
	return self
end

return {
	sinkFor = sinkFor,
	releaseIfEmpty = releaseIfEmpty,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="285">
                  <Properties>
                    <string name="Name">static-sink</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local Graph = require "./graph"
local Weak = require "../weak"
local profile = require "./profile"
local stats = require "./stats"
local statsOn = stats.state
local OBSERVED = Graph.OBSERVED
local CLEAN = Graph.CLEAN
local CHECK = Graph.CHECK

type Edge = Graph.Edge
type Consumer = Graph.Consumer
type Reactor = Graph.Reactor
type Scheduled = Graph.Scheduled

export type Member = {
	released: boolean,
	body: (value: unknown) -> (),
	sink: StaticSink,
}

export type Host = {
	version: number,
	subscribers: Edge?,
	lastSubscriber: Edge?,
	refresh: ((Graph.Producer) -> ()) | false,
	derived: boolean?,
	value: unknown,
	staticSinks: { [Reactor]: StaticSink }?,
}

export type StaticSink = {
	state: number,
	dependencies: { Edge },
	reads: number,
	enqueue: ((Consumer) -> ()) | false | nil,
	enqueueSettle: ((Consumer) -> ()) | false | nil,
	released: boolean,
	retry: boolean?,
	derived: boolean?,
	queued: boolean,
	run: (self: Scheduled) -> ...unknown,

	reactor: Reactor,
	producer: Host,
	members: { Member },
	live: number,
	only: Member?,
	edge: Edge,
}

local UNATTACHED: Edge = {}

local function releaseIfEmpty(self: StaticSink)
	if self.released or self.live > 0 then
		return
	end
	self.queued = false
	self.only = nil
	Graph.release(self)
	local sinks = self.producer.staticSinks
	if sinks ~= nil then
		sinks[self.reactor] = nil
	end
	table.clear(self.members)
end

local function runMembers(self: StaticSink, producer: Host)
	local members = self.members

	local failures: { string }? = nil
	local write = 0
	for read = 1, #members do
		if self.released then
			break
		end
		local member = members[read]
		if not member.released then
			write += 1
			members[write] = member
			if statsOn.enabled then
				stats.bump "watchRuns"
				profile.enterRun(member)
			end
			local ok, err: unknown = pcall(member.body, producer.value)
			if not ok then
				failures = failures or {}
				table.insert(failures :: { string }, tostring(err))
			end
		end
	end
	for index = #members, write + 1, -1 do
		members[index] = nil
	end

	if failures ~= nil then
		local collected = failures :: { string }
		if #collected == 1 then
			error(collected[1], 0)
		end
		error(("Compose: %d direct bindings failed:\n  %s"):format(#collected, table.concat(collected, "\n  ")), 0)
	end
end

local function run(scheduled: Scheduled)
	local self = scheduled :: StaticSink
	if self.released then
		return
	end

	local producer = self.producer
	local edge = self.edge
	if self.state == CHECK then
		local refresh = producer.refresh
		if refresh then
			self.retry = true
			(refresh :: (Graph.Producer) -> ())(producer)
			self.retry = false
		end
		if producer.version == edge[OBSERVED] then
			self.state = CLEAN
			return
		end
	end
	self.state = CLEAN
	edge[OBSERVED] = producer.version

	local single = self.only
	if single then
		if statsOn.enabled then
			stats.bump "watchRuns"
			profile.enterRun(single)
		end
		single.body(producer.value)
		return
	end

	runMembers(self, producer)
end

local function runOnCell(scheduled: Scheduled)
	local self = scheduled :: StaticSink
	if self.released then
		return
	end
	self.state = CLEAN

	local producer = self.producer
	local single = self.only
	if single then
		if statsOn.enabled then
			stats.bump "watchRuns"
			profile.enterRun(single)
		end
		single.body(producer.value)
		return
	end

	runMembers(self, producer)
end

local function enqueue(consumer: Consumer)
	local self = consumer :: StaticSink
	if not self.released then
		self.reactor:__enqueue(self)
	end
end

local function sinkFor(producer: Host, reactor: Reactor): StaticSink
	local refresh = producer.refresh
	if refresh then
		(refresh :: (Graph.Producer) -> ())(producer)
	end
	local sinks = producer.staticSinks or Weak.keys() :: { [Reactor]: StaticSink }
	producer.staticSinks = sinks
	local existing = sinks[reactor]
	if existing ~= nil and not existing.released then
		return existing
	end

	local self: StaticSink = {
		state = Graph.CLEAN,
		dependencies = {},
		reads = 0,
		released = false,
		queued = false,
		reactor = reactor,
		producer = producer,
		members = {},
		live = 0,
		only = nil,

		run = if producer.derived == false then runOnCell else run,

		enqueue = reactor.__enqueueConsumer or enqueue,

		enqueueSettle = reactor.__enqueueSettleConsumer or false,
		edge = UNATTACHED,
	}
	self.edge = Graph.attach(producer, self)
	self.dependencies[1] = self.edge
	sinks[reactor] = self
	return self
end

local function recount(sink: StaticSink)
	if sink.live == 1 then
		local members = sink.members
		for index = 1, #members do
			local member = members[index]
			if not member.released then
				sink.only = member
				return
			end
		end
	end
	sink.only = nil
end

local function add<T>(producer: Host, reactor: Reactor, body: (value: T) -> ()): Member
	local sink = sinkFor(producer, reactor)
	local member: Member = { released = false, body = body :: (value: unknown) -> (), sink = sink }
	table.insert(sink.members, member)
	sink.live += 1
	sink.only = if sink.live == 1 then member else nil

	if statsOn.enabled then
		profile.born(member)
		stats.bump "watchRuns"
		profile.enterRun(member)
	end
	local ok, err: unknown = pcall(member.body, producer.value)
	if not ok then
		member.released = true
		sink.live -= 1
		recount(sink)
		releaseIfEmpty(sink)
		error(err, 0)
	end
	return member
end

local function release(member: Member)
	if member.released then
		return
	end
	member.released = true
	local sink = member.sink
	sink.live -= 1
	recount(sink)
	releaseIfEmpty(sink)
end

return {
	add = add,
	release = release,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="286">
                  <Properties>
                    <string name="Name">stats</string>
                    <string name="Source"><![CDATA[--!strict

export type Counters = {
	cellWrites: number,
	cellWritesSuppressed: number,
	notifications: number,
	formulaRecomputations: number,
	formulaRecomputationsSuppressed: number,
	watchRuns: number,
	watchSchedules: number,
	watchSchedulesCoalesced: number,
	drains: number,
	continuationPasses: number,
}

local function zeroed(): Counters
	return {
		cellWrites = 0,
		cellWritesSuppressed = 0,
		notifications = 0,
		formulaRecomputations = 0,
		formulaRecomputationsSuppressed = 0,
		watchRuns = 0,
		watchSchedules = 0,
		watchSchedulesCoalesced = 0,
		drains = 0,
		continuationPasses = 0,
	}
end

local counters: Counters = zeroed()
local state = { enabled = false }

local function setEnabled(value: boolean)
	state.enabled = value
end

local function read(): Counters
	return table.clone(counters)
end

local function reset()
	counters = zeroed()
end

local function bump(name: string, amount: number?)
	local record = counters :: { [string]: number }
	record[name] += if amount ~= nil then amount else 1
end

return {

	state = state,
	setEnabled = setEnabled,
	read = read,
	reset = reset,
	bump = bump,
	zeroed = zeroed,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="287">
                  <Properties>
                    <string name="Name">types</string>
                    <string name="Source"><![CDATA[--!strict

export type Dispose = () -> ()

export type Use = <T>(Readable<T>) -> T

export type Readable<T> = {
	peek: (self: Readable<T>) -> T,
}

export type Cell<T> = Readable<T> & {
	set: (self: Cell<T>, value: T) -> (),
	update: (self: Cell<T>, change: (previous: T) -> T) -> (),
}

export type Formula<T> = {
	peek: (self: Readable<T>) -> T,
	dispose: (self: Formula<T>) -> (),
}

export type Body<T> = (use: Use) -> T

export type Source<T> = Readable<T> | Body<T>

export type Value<T> = T | Cell<T> | Formula<T> | Source<T>

export type Equals<T> = (current: T, incoming: T) -> boolean

export type Initial<T> = (() -> T) | T

return {}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="288">
                  <Properties>
                    <string name="Name">userSpace</string>
                    <string name="Source"><![CDATA[--!strict

local state = { validating = false }

local YIELDED = "Compose: reactive code yielded. Computeds and effects must complete "
	.. "without yielding; use an async resource for work that waits."

local function raise(co: thread, cause: unknown): never
	if type(cause) == "string" then
		error(debug.traceback(co, cause), 2)
	end
	error(cause, 2)
end

local function settle(co: thread, ok: boolean, ...: unknown): ...unknown
	if ok and coroutine.status(co) == "dead" then
		return ...
	end
	if ok then
		return raise(co, YIELDED)
	end
	return raise(co, (...))
end

local function guarded(fn: (...unknown) -> ...unknown, ...: unknown): ...unknown
	local co = coroutine.create(fn)
	return settle(co, coroutine.resume(co, ...))
end

local checked = (guarded :: unknown) :: <Args..., Rets...>(fn: (Args...) -> Rets..., Args...) -> Rets...

local function call<Args..., Rets...>(fn: (Args...) -> Rets..., ...: Args...): Rets...
	if state.validating then
		return checked(fn, ...)
	end
	return fn(...)
end

local function setValidating(value: boolean)
	state.validating = value
end

return {
	call = call,

	state = state,
	setValidating = setValidating,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="289">
                  <Properties>
                    <string name="Name">watch</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local Graph = require "./graph"
local Sink = require "./sink"
local StaticSink = require "./static-sink"
local Types = require "./types"
local profile = require "./profile"
local stats = require "./stats"
local userSpace = require "./userSpace"
local validationState = userSpace.state
local statsOn = stats.state
local beginEvaluation = Graph.beginEvaluation
local finishEvaluation = Graph.finishEvaluation
local use = Graph.use

type Body = (use: Types.Use) -> ()
type Edge = Graph.Edge
type Consumer = Graph.Consumer
type Reactor = Graph.Reactor
type Scheduled = Graph.Scheduled

type Watch = {
	state: number,
	dependencies: { Edge },
	reads: number,
	enqueue: ((Consumer) -> ()) | false | nil,
	enqueueSettle: ((Consumer) -> ()) | false | nil,
	released: boolean,
	retry: boolean?,
	derived: boolean?,
	queued: boolean,
	guarded: boolean,
	run: (self: Scheduled) -> ...unknown,

	reactor: Reactor,
	body: Body,
	sink: Sink.Sink | false,
}

local WATCH = {}
WATCH.__index = WATCH

WATCH.derived = false

WATCH.sink = false

WATCH.enqueueSettle = false

WATCH.guarded = false

local FUSE_AT = 8
type Dispose = Types.Dispose

local function invoke(self: Watch): nil
	self.body(Graph.use)
	return nil
end

local function evaluate(self: Watch)
	if statsOn.enabled then
		stats.bump "watchRuns"
		profile.enterRun(self)
	end

	self.state = Graph.CLEAN
	Graph.evaluate(self, invoke, self)
end

local function evaluateQueued(self: Watch)
	if statsOn.enabled then
		stats.bump "watchRuns"
		profile.enterRun(self)
	end
	self.state = Graph.CLEAN
	local previous = beginEvaluation(self)
	if validationState.validating then
		userSpace.call(self.body, use)
	else
		self.body(use)
	end
	finishEvaluation(self, previous)
end

local function run(scheduled: Scheduled)
	local self = scheduled :: Watch
	if self.released then
		return
	end
	if self.state == Graph.CHECK then
		if self.guarded then
			local checked, moved = pcall(Graph.dependenciesMoved, self)
			if checked and not moved then
				self.state = Graph.CLEAN
				return
			end
		else
			self.retry = true
			local moved = Graph.dependenciesMoved(self)
			self.retry = false
			if not moved then
				self.state = Graph.CLEAN
				return
			end
		end
	end
	evaluateQueued(self)
end

local function enqueue(consumer: Consumer)
	local self = consumer :: Watch
	self.reactor.__enqueueConsumer(self)
end

local function create(reactor: Reactor, body: Body): Watch
	return (
		setmetatable({
			state = Graph.DIRTY,
			dependencies = {} :: { Edge },
			reads = 0,
			reactor = reactor,
			body = body,
			queued = false,
			released = false,
		}, WATCH) :: unknown
	) :: Watch
end

local function start(self: Watch, label: string?): Dispose
	if statsOn.enabled then
		profile.born(self, label)
	end

	local ok, err: unknown = pcall(evaluate, self)
	if not ok then
		Graph.release(self)
		error(err, 0)
	end

	return function()
		if self.released then
			return
		end
		Graph.release(self)
		self.queued = false
	end
end

local function watch(reactor: Reactor, body: Body, label: string?): Dispose
	return start(create(reactor, body), label)
end

local function watchGuarded(reactor: Reactor, body: Body, label: string?): Dispose
	local self = create(reactor, body)
	self.guarded = true
	return start(self, label)
end

local function watchStatic<T>(reactor: Reactor, producer: Types.Readable<T>, body: (value: T) -> ()): Dispose
	local member = StaticSink.add((producer :: unknown) :: StaticSink.Host, reactor, body)
	return function()
		StaticSink.release(member)
	end
end

local function unfuse(member: Sink.Member)
	local self = member :: Watch
	local fused = self.sink
	if not fused then
		return
	end
	local sink = fused :: Sink.Sink
	local members = sink.members
	if sink.running then
		sink.membersChanged = true
	else
		for index = 1, #members do
			if members[index] == self then
				table.remove(members, index)
				break
			end
		end
	end
	local producer = sink.edge[Graph.PRODUCER] :: Sink.Host
	Sink.releaseIfEmpty(sink, producer)
	self.sink = false

	self.enqueue = nil
end

local function report(err: unknown, _member: Sink.Member): ()
	error(err, 0)
end

local function fuseIfTerminal(self: Watch)
	if self.released or self.sink then
		return
	end
	local dependencies = self.dependencies
	if #dependencies ~= 1 then
		return
	end
	local producer: Sink.Host = dependencies[1][Graph.PRODUCER] :: Sink.Host

	if producer.derived then
		return
	end
	if Graph.subscriberCount(producer) < FUSE_AT then
		return
	end
	local sink = Sink.sinkFor(producer, self.reactor, report, unfuse)
	self.sink = sink
	table.insert(sink.members, self)

	self.enqueue = false
end

local function watchTerminal(reactor: Reactor, body: Body): Dispose
	local self = create(reactor, body)

	if statsOn.enabled then
		profile.born(self)
	end

	local ok, err: unknown = pcall(evaluate, self)
	if not ok then
		Graph.release(self)
		error(err, 0)
	end
	fuseIfTerminal(self)

	return function()
		if self.released then
			return
		end
		unfuse(self)
		Graph.release(self)
		self.queued = false
	end
end

WATCH.run = run
WATCH.enqueue = enqueue

local function sample<T>(body: () -> T): T
	return Graph.untracked(body)
end

return {
	watch = watch,
	watchGuarded = watchGuarded,
	watchStatic = watchStatic,
	watchTerminal = watchTerminal,
	sample = sample,
}
]]></string>
                  </Properties>
                </Item>
              </Item>
              <Item class="ModuleScript" referent="290">
                <Properties>
                  <string name="Name">runtime</string>
                  <string name="Source"><![CDATA[--!strict

local Active = require "./ownership/active"
local Animation = require "./animation/motion"
local RampModule = require "./animation/ramp"
local SchedulerModule = require "./scheduler"
local TimelineModule = require "./animation/timeline"
local Block = require "@self/block"
local Children = require "@self/children"
local Diagnostics = require "./diagnostics"
local Host = require "./host"
local Inspect = require "./ownership/inspect"
local Nodes = require "./ownership/nodes"
local Owner = require "./ownership/owner"
local Reactor = require "./reactive/reactor"
local Props = require "@self/props"
local Root = require "./ownership/root"
local Types = require "./reactive/types"
local Weak = require "./weak"

export type Node = Host.Node
type Dispose = Types.Dispose

export type Child = Node | Children.Directive

export type Directive = Children.Directive
export type MountPoint = Children.MountPoint
export type Props = Props.Props
export type SpringOptions = Animation.SpringOptions
export type TimelineOptions = TimelineModule.Options
export type Timeline = TimelineModule.Timeline
export type TweenOptions = Animation.TweenOptions
export type RampOptions = RampModule.Options
export type Ramp<T> = RampModule.Ramp<T>
export type Scheduler = SchedulerModule.Scheduler

export type Component = () -> Node

export type Fragment = () -> { Child }

export type Constructor = ((label: string) -> (props: Props.Props) -> Node) & ((props: {}) -> Node)

export type Runtime = {
	host: Host.Host,
	create: (kind: string) -> Constructor,
	constructors: { [string]: Constructor },
	mount: (component: Component, target: Node) -> (Dispose, Node),
	mountFragment: (fragment: Fragment, target: Node) -> (Dispose, { Node }),

	decorate: (node: Node, props: Props.Props) -> Node,

	connect: <Args...>(node: Node, event: string, handler: (Args...) -> ()) -> () -> (),

	adopt: (node: Node) -> Node,
	borrow: (node: Node) -> Node,

	spring: <T>(source: Types.Body<T>, options: Animation.SpringOptions?) -> Types.Readable<T>,

	tween: <T>(source: Types.Body<T>, options: Animation.TweenOptions?) -> Types.Readable<T>,
	timeline: (options: TimelineModule.Options?) -> TimelineModule.Timeline,
	ramp: <T>(initial: T, options: RampModule.Options?) -> RampModule.Ramp<T>,
	scheduler: (owner: Owner.Owner?) -> SchedulerModule.Scheduler,

	reactor: Reactor.Reactor,

	watch: (self: Runtime, body: (use: Types.Use) -> (), label: string?) -> Types.Dispose,
	batch: <T...>(self: Runtime, body: () -> T...) -> T...,
	settle: (self: Runtime) -> (),
	pending: (self: Runtime) -> number,
	dispose: (self: Runtime) -> (),
}

local function createRuntime(host: Host.Host): Runtime
	local reactor = Reactor.create()

	local rootOwner = Owner.createOwner(reactor)
	local runtimeDisposed = false
	Host.validate(host)
	local render = host.render

	local function requireOwner(operation: string): Owner.Owner
		local owner = Active.current()
		if owner == nil then
			Diagnostics.raise("owner/no-active-owner", ("%s ran with no owner to register with"):format(operation), {
				contract = "nodes and bindings must belong to something that can release them",
				fix = "call it inside runtime.mount(component, target), or inside Compose.withOwner(owner, fn)",
			})
		end
		return owner :: Owner.Owner
	end

	local function destroyOwnedNode(node: Node)
		local ok, err: unknown = pcall(Nodes.releaseDependents, node)
		render.destroyNode(node)
		Nodes.forget(node)
		if not ok then
			error(err, 0)
		end
	end

	local pendingLabel = Weak.keys() :: { [unknown]: string }

	local function create(kind: string): Constructor
		if type(kind) ~= "string" then
			Diagnostics.raise("mount/kind-not-a-string", "create expects a node kind", {
				actual = Diagnostics.describe(kind),
				expected = 'a string the host understands, e.g. "Frame"',
			})
		end

		local operation = ("create(%q)"):format(kind)

		local inFlight: string? = nil
		local function onKey(key: string)
			inFlight = key
		end

		local function applyBuild(label: string?, props: Props.Props, node: Node, owner: Owner.Owner)
			if label ~= nil then
				Nodes.label(node, label)
				local naming = host.naming
				if naming ~= nil then
					inFlight = "<name>"
					naming.setName(node, label)
					inFlight = nil
				end
			end
			Props.apply(host, node, props, owner, onKey)

			local childCount = #props
			if childCount == 0 then
				return
			end

			inFlight = nil
			local list = Children.createList(host, node)
			for index = 1, childCount do
				local child = props[index]
				local slot = Children.addSlot(list)
				if type(child) == "function" and pendingLabel[child] == nil then
					(child :: Children.Directive)(Children.mountPointFor(list, slot))
				elseif type(child) == "table" or type(child) == "userdata" then
					Children.insertStatic(list, slot, child)
				elseif pendingLabel[child] ~= nil then
					Diagnostics.raise(
						"mount/constructor-not-applied",
						"a child is a constructor that was never given props",
						{
							kind = kind,
							index = index,
							label = pendingLabel[child],
							contract = ("%s %q is a constructor; it builds a node only once it is called with props"):format(
								kind,
								pendingLabel[child]
							),
							fix = ("write %s %q { } -- an empty table is fine"):format(kind, pendingLabel[child]),
						}
					)
				else
					Diagnostics.raise("mount/not-a-child", "a child is neither a node nor a directive", {
						kind = kind,
						index = index,
						actual = Diagnostics.describe(child),
						expected = "a node, or a directive such as show(...) or keyed(...)",
					})
				end
			end
		end

		local function build(label: string?, props: Props.Props): Node
			if type(props) ~= "table" then
				Diagnostics.raise("props/not-a-table", ("create(%q) expects a props table"):format(kind), {
					kind = kind,
					label = label,
					actual = Diagnostics.describe(props),
					expected = "a table of properties, with children in its array part",
				})
			end

			local owner = requireOwner(operation)
			local mark = owner.checkpoint()

			local node = render.createNode(kind)
			Nodes.markOwned(node)
			owner.own(function()
				destroyOwnedNode(node)
			end)
			if Inspect.isActive() then
				Inspect.node(owner, node, "owned")
				Nodes.chargeToOwner(owner, node, "owned")
			end

			local savedInFlight = inFlight
			inFlight = nil
			local ok, err: unknown = pcall(Active.runWith, owner, applyBuild, label, props, node, owner)
			if not ok then
				owner.rollbackTo(mark)
				local key = inFlight
				inFlight = savedInFlight
				if key ~= nil then
					error(("%s\n  while applying: %s.%s"):format(tostring(err), kind, tostring(key)), 0)
				end
				error(err, 0)
			end
			inFlight = savedInFlight

			return node
		end

		return (
			function(first: string | Props.Props): Node | (props: Props.Props) -> Node
				if type(first) == "string" then
					local labelled = function(props: Props.Props): Node
						return build(first, props)
					end
					pendingLabel[labelled] = first
					return labelled
				end
				return build(nil, first)
			end :: Constructor
		) :: Constructor
	end

	local function refuseAfterDispose(operation: string, label: string)
		if runtimeDisposed then
			Diagnostics.raise("runtime/disposed", ("%s ran after runtime:dispose()"):format(operation), {
				component = label,
				contract = "a disposed runtime starts no new work",
				fix = "create a new runtime, or mount before disposing this one",
			})
		end
	end

	local function releaseInOrder(first: Dispose, second: Dispose)
		local firstOk, firstErr: unknown = pcall(first)
		local secondOk, secondErr: unknown = pcall(second)
		if not firstOk then
			error(firstErr, 0)
		end
		if not secondOk then
			error(secondErr, 0)
		end
	end

	local function claimTarget(target: Node)
		if not Nodes.isDestructible(target) then
			Nodes.markBorrowed(target)
		end
	end

	local function orderAgainstTarget(target: Node, detach: Dispose): Dispose
		if not Nodes.isDestructible(target) then
			return detach
		end
		local unlink = Nodes.attachDependent(target, detach)
		return function()
			unlink()
			detach()
		end
	end

	local function mountInto(produce: () -> { Node }, target: Node, label: string): (Dispose, { Node })
		if type(target) ~= "table" and type(target) ~= "userdata" then
			Diagnostics.raise("mount/target-not-a-node", "mount expects a host node to mount into", {
				component = label,
				actual = Diagnostics.describe(target),
				expected = "a node belonging to the host this runtime renders to",
			})
		end
		refuseAfterDispose("mount", label)
		claimTarget(target)

		local parent = Active.current()
		local isTopLevel = parent == nil
		local owner = if parent ~= nil then parent else Owner.createOwner(reactor)

		if isTopLevel and Inspect.isActive() then
			Inspect.mount(owner)
			Inspect.label(owner, label)
		end

		local mountPoint = Children.wholeOf(host, target)
		local ok, block = pcall(Block.mountBlock, mountPoint, owner, produce, label, nil)
		if not ok then
			if isTopLevel then
				owner.dispose()
			end
			error(block, 0)
		end

		if not isTopLevel then
			return block.dispose, block.nodes
		end

		local detach = Root.hold(function()
			releaseInOrder(block.dispose, owner.dispose)
		end)
		return orderAgainstTarget(target, detach), block.nodes
	end

	local function mount(component: Component, target: Node): (Dispose, Node)
		local label = Block.nameOf(component)
		local dispose, nodes = mountInto(function(): { Node }
			return { component() }
		end, target, label)
		return dispose, nodes[1]
	end

	local function mountFragment(fragment: Fragment, target: Node): (Dispose, { Node })
		local label = Block.nameOf(fragment)
		if type(target) ~= "table" and type(target) ~= "userdata" then
			Diagnostics.raise("mount/target-not-a-node", "mountFragment expects a host node to mount into", {
				component = label,
				actual = Diagnostics.describe(target),
				expected = "a node belonging to the host this runtime renders to",
			})
		end
		refuseAfterDispose("mountFragment", label)
		claimTarget(target)

		local parent = Active.current()
		local isTopLevel = parent == nil
		local owner = if parent ~= nil then parent else Owner.createOwner(reactor)
		if isTopLevel and Inspect.isActive() then
			Inspect.mount(owner)
			Inspect.label(owner, label)
		end

		local blockOwner = owner.createChild()
		local roots: { Node } = {}
		local list = Children.createList(host, target)
		blockOwner.own(function()
			for index = #roots, 1, -1 do
				pcall(render.removeChild, target, roots[index])
			end
		end)

		local ok, err: unknown = pcall(function()
			local children = Active.withOwner(blockOwner, fragment)
			if type(children) ~= "table" then
				Diagnostics.raise(
					"mount/not-a-child-list",
					"a fragment returned something that is not a list of children",
					{
						component = label,
						actual = Diagnostics.describe(children),
						expected = "an array of nodes and structural directives",
					}
				)
			end
			for index, child in children do
				local slot = Children.addSlot(list)
				if type(child) == "function" and pendingLabel[child] == nil then
					Active.withOwner(blockOwner, function()
						(child :: Children.Directive)(Children.mountPointFor(list, slot))
					end)
				elseif type(child) == "table" or type(child) == "userdata" then
					Children.insertStatic(list, slot, child)
					table.insert(roots, child)
				elseif pendingLabel[child] ~= nil then
					Diagnostics.raise(
						"mount/constructor-not-applied",
						"a fragment child is a constructor that was never given props",
						{
							component = label,
							index = index,
							label = pendingLabel[child],
							fix = ("write Part %q { } -- an empty table is fine"):format(pendingLabel[child]),
						}
					)
				else
					Diagnostics.raise("mount/not-a-child", "a fragment entry is neither a node nor a directive", {
						component = label,
						index = index,
						actual = Diagnostics.describe(child),
						expected = "a node, or a directive such as show(...) or keyed(...)",
					})
				end
			end
		end)
		if not ok then
			blockOwner.dispose()
			if isTopLevel then
				owner.dispose()
			end
			error(err, 0)
		end

		if not isTopLevel then
			return blockOwner.dispose, roots
		end
		local detach = Root.hold(function()
			releaseInOrder(blockOwner.dispose, owner.dispose)
		end)
		return orderAgainstTarget(target, detach), roots
	end

	local function decorate(node: Node, props: Props.Props): Node
		if type(node) ~= "table" and type(node) ~= "userdata" then
			Diagnostics.raise("mount/not-a-node", "decorate expects an existing host node", {
				actual = Diagnostics.describe(node),
				expected = "a node belonging to the host this runtime renders to",
			})
		end
		if type(props) ~= "table" then
			Diagnostics.raise("props/not-a-table", "decorate expects a props table", {
				actual = Diagnostics.describe(props),
				expected = "a table of properties and event keys",
			})
		end

		local parentOwner = requireOwner "decorate"
		local owner = parentOwner.createChild()

		local inFlight: string? = nil
		local ok, err: unknown = pcall(function()
			Active.withOwner(owner, function()
				Props.apply(host, node, props, owner, function(key: string)
					inFlight = key
				end)

				if #props > 0 then
					Diagnostics.raise("props/decorate-has-children", "decorate cannot add children", {
						contract = "decorate only applies properties and events to an existing node",
						fix = "use a portal to mount children into a node Compose does not own",
					})
				end
				return nil
			end)
		end)

		if not ok then
			owner.dispose()
			if inFlight ~= nil then
				error(("%s\n  while applying: decorate.%s"):format(tostring(err), tostring(inFlight)), 0)
			end
			error(err, 0)
		end

		return node
	end

	local function connect<Args...>(node: Node, event: string, handler: (Args...) -> ()): () -> ()
		if type(node) ~= "table" and type(node) ~= "userdata" then
			Diagnostics.raise("mount/not-a-node", "connect expects an existing host node", {
				event = event,
				actual = Diagnostics.describe(node),
				expected = "a node belonging to the host this runtime renders to",
			})
		end
		if type(handler) ~= "function" then
			Diagnostics.raise("props/event-needs-handler", "connect expects a handler function", {
				event = event,
				actual = Diagnostics.describe(handler),
				expected = "a function",
			})
		end

		local events = host.events
		if events == nil then
			Diagnostics.raise("host/no-events", ("host %q cannot subscribe to events"):format(host.name), {
				event = event,
				contract = "subscribing requires the host events capability",
				fix = "implement host.events.connectEvent, or stop calling connect on this host",
			})
		end

		local owner = requireOwner "connect"
		local unsubscribe = (events :: Host.Events).connectEvent(node, event, handler)
		local detach = owner.own(unsubscribe)
		return detach
	end

	local function adopt(node: Node): Node
		local owner = requireOwner "adopt"
		if Nodes.custodyOf(node) == "owned" then
			Diagnostics.raise("owner/already-owned", "adopt was given a node Compose already owns", {
				node = Host.describeNode(host, node),
				contract = "a node has exactly one owner; adopting a second time would destroy it twice",
				fix = "adopt only nodes created outside Compose",
			})
		end
		Nodes.markAdopted(node)
		owner.own(function()
			destroyOwnedNode(node)
		end)
		if Inspect.isActive() then
			Inspect.node(owner, node, "adopted")
			Nodes.chargeToOwner(owner, node, "adopted")
		end
		return node
	end

	local function borrow(node: Node): Node
		Nodes.markBorrowed(node)
		if Inspect.isActive() then
			local holder = Active.current()
			if holder ~= nil then
				Inspect.node(holder, node, "borrowed")
				Nodes.chargeToOwner(holder, node, "borrowed")
			end
		end
		return node
	end

	local motion = Animation.createMotion(host, requireOwner, reactor)
	local timelines = TimelineModule.createTimelines(host, requireOwner)
	local ramp = RampModule.createRamps(motion.tween, requireOwner)
	local scheduler = SchedulerModule.createSchedulers(timelines.timeline, requireOwner)

	local function watch(_self: Runtime, body: (use: Types.Use) -> (), label: string?): Types.Dispose
		local active = Active.current()
		local owner = if active ~= nil then active else rootOwner
		return owner.watch(body, label)
	end

	local constructors: { [string]: Constructor } = {}
	setmetatable(constructors :: { [string]: Constructor }, {
		__index = function(self: { [string]: Constructor }, kind: string): Constructor
			local constructor = create(kind)
			rawset(self, kind, constructor)
			return constructor
		end,
	})

	return {
		host = host,
		reactor = reactor,
		watch = watch,
		batch = function<T...>(_self: Runtime, body: () -> T...): T...
			return reactor:batch(body)
		end,
		settle = function(_self: Runtime)
			reactor:settle()
		end,
		pending = function(_self: Runtime): number
			return reactor:pending()
		end,
		dispose = function(_self: Runtime)
			runtimeDisposed = true
			rootOwner.dispose()
		end,
		connect = connect,
		create = create,
		constructors = constructors,
		decorate = decorate,
		mount = mount,
		mountFragment = mountFragment,
		adopt = adopt,
		borrow = borrow,
		spring = motion.spring,
		tween = motion.tween,
		timeline = timelines.timeline,
		ramp = ramp,
		scheduler = scheduler,
	}
end

return {
	createRuntime = createRuntime,
}
]]></string>
                </Properties>
                <Item class="ModuleScript" referent="291">
                  <Properties>
                    <string name="Name">block</string>
                    <string name="Source"><![CDATA[--!strict

local Active = require "../ownership/active"
local Children = require "./children"
local Diagnostics = require "../diagnostics"
local Host = require "../host"
local Nodes = require "../ownership/nodes"
local Owner = require "../ownership/owner"
local Types = require "../reactive/types"

type Node = Host.Node
type Dispose = Types.Dispose

export type Block = {
	nodes: { Node },
	dispose: Dispose,
}

local function nameOf(component: unknown): string
	if type(component) ~= "function" then
		return "<not a component>"
	end
	local name = debug.info(component :: (...unknown) -> ...unknown, "n")
	if name ~= "" then
		return name
	end
	return "<anonymous component>"
end

local function requireNodes(produced: { Node }, label: string): { Node }
	if type(produced) ~= "table" then
		Diagnostics.raise("mount/not-a-node-list", "a component returned something that is not a list of nodes", {
			component = label,
			actual = Diagnostics.describe(produced),
			expected = "a node, or an array of nodes",
		})
	end
	for index, node in produced do
		local kind = type(node)
		if kind ~= "table" and kind ~= "userdata" then
			Diagnostics.raise("mount/not-a-node", "a component returned something that is not a node", {
				component = label,
				index = index,
				actual = Diagnostics.describe(node),
				expected = "a node created through runtime.create, or adopted from the host",
				fix = if kind == "function"
					then 'if this is a named constructor, call it with a props table -- Part "Ground" { }'
					else nil,
			})
		end
	end
	return produced
end

local function mountBlock(
	mountPoint: Children.MountPoint,
	parentOwner: Owner.Owner,
	produce: () -> { Node },
	label: string,
	at: number?
): Block
	local owner = parentOwner.createChild()

	local ok, produced = pcall(Active.runWith1, owner, produce)
	if not ok then
		owner.dispose()
		error(produced, 0)
	end
	local okNodes, built = pcall(requireNodes, produced, label)
	if not okNodes then
		owner.dispose()
		error(built, 0)
	end

	local inserted = 0
	local insertOk, insertErr: unknown = pcall(function()
		local base = if at ~= nil then at else mountPoint.count() + 1
		for index, node in built do
			mountPoint.insert(node, base + index - 1)
			inserted = index
		end
	end)
	if not insertOk then
		for index = inserted, 1, -1 do
			pcall(mountPoint.remove, built[index])
		end
		owner.dispose()
		error(insertErr, 0)
	end

	owner.own(function()
		for index = #built, 1, -1 do
			mountPoint.remove(built[index])
		end
		for _, node in built do
			Nodes.forget(node)
		end
	end)

	return { nodes = built, dispose = owner.dispose }
end

return {
	mountBlock = mountBlock,
	nameOf = nameOf,
	requireNodes = requireNodes,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="292">
                  <Properties>
                    <string name="Name">children</string>
                    <string name="Source"><![CDATA[--!strict

local Diagnostics = require "../diagnostics"
local Host = require "../host"

type Node = Host.Node

export type ChildList = {
	host: Host.Host,
	parent: Node,
	counts: { number },

	total: number,
}

export type MountPoint = {
	parent: Node,
	insert: (node: Node, at: number?) -> (),
	moveTo: (node: Node, at: number) -> (),

	ordersChildren: boolean,
	remove: (node: Node) -> (),
	count: () -> number,
	host: Host.Host,
}

export type Directive = (MountPoint) -> ()

local function createList(host: Host.Host, parent: Node): ChildList
	return { host = host, parent = parent, counts = {}, total = 0 }
end

local function addSlot(list: ChildList): number
	local index = #list.counts + 1
	list.counts[index] = 0
	return index
end

local function baseOf(list: ChildList, slot: number): number
	local base = 0
	local counts = list.counts
	for index = 1, slot - 1 do
		base += counts[index]
	end
	return base
end

local function mountPointFor(list: ChildList, slot: number): MountPoint
	local host = list.host
	local render = host.render

	local moveChild = render.moveChild
	local parent = list.parent

	local function count(): number
		return list.counts[slot]
	end

	local function insert(node: Node, at: number?)
		local held = list.counts[slot]
		local within = if at ~= nil then at else held + 1
		if within < 1 or within > held + 1 then
			Diagnostics.raise("structure/position-out-of-range", "a directive asked for a position it cannot have", {
				index = within,
				expected = ("between 1 and %d"):format(held + 1),
				contract = "a slot-local position must be inside the slot, or exactly one past its end",
			})
		end
		render.insertChild(parent, node, baseOf(list, slot) + within)
		list.counts[slot] = held + 1
		list.total += 1
	end

	local function moveTo(node: Node, at: number)
		if moveChild == nil then
			return
		end
		local held = list.counts[slot]
		if at < 1 or at > held then
			Diagnostics.raise("structure/position-out-of-range", "a directive asked to move a node outside its slot", {
				index = at,
				expected = ("between 1 and %d"):format(held),
				contract = "a move must land inside the slot it started in",
			})
		end
		moveChild(parent, node, baseOf(list, slot) + at)
	end

	local function remove(node: Node)
		render.removeChild(parent, node)
		list.counts[slot] -= 1
		list.total -= 1
	end

	local mountPoint: MountPoint = {
		parent = parent,
		host = host,
		insert = insert,
		moveTo = moveTo,
		ordersChildren = moveChild ~= nil,
		remove = remove,
		count = count,
	}

	local function refuse(key: string, how: string): never
		return Diagnostics.raise(
			"structure/not-a-mount-point",
			("a directive %s %q on its mount point"):format(how, key),
			{
				key = key,
				contract = "a child written as a function is a directive, and receives a mount point, "
					.. "not the parent node",
				fix = "use insert, moveTo, remove, count, parent, or host; to reach the parent node itself, "
					.. "read mountPoint.parent",
			}
		) :: never
	end

	return (
		setmetatable(mountPoint, {
			__index = function(_: unknown, key: string): never
				return refuse(tostring(key), "read")
			end,
			__newindex = function(_: unknown, key: string, _value: unknown): never
				return refuse(tostring(key), "assigned")
			end,
		}) :: unknown
	) :: MountPoint
end

local function insertStatic(list: ChildList, slot: number, node: Node)
	list.host.render.insertChild(list.parent, node, list.total + 1)
	list.counts[slot] += 1
	list.total += 1
end

local function wholeOf(host: Host.Host, parent: Node): MountPoint
	local list = createList(host, parent)
	local slot = addSlot(list)
	return mountPointFor(list, slot)
end

return {
	createList = createList,
	addSlot = addSlot,
	baseOf = baseOf,
	mountPointFor = mountPointFor,
	insertStatic = insertStatic,
	wholeOf = wholeOf,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="293">
                  <Properties>
                    <string name="Name">keys</string>
                    <string name="Source"><![CDATA[--!strict

export type EventKey = {
	composeKey: "event",
	name: string,
}

export type PropertyKey = {
	composeKey: "property",
	name: string,
}

export type GroupKey = {
	composeKey: "group",
	names: { string },
}

export type StaticValue = {
	composeValue: "static",
	value: unknown,
}

local eventKeys: { [string]: EventKey } = {}
local propertyKeys: { [string]: PropertyKey } = {}

local function event(name: string): EventKey
	local existing = eventKeys[name]
	if existing ~= nil then
		return existing
	end
	local created: EventKey = { composeKey = "event", name = name }
	table.freeze(created :: {})
	eventKeys[name] = created
	return created
end

local function property(name: string): PropertyKey
	local existing = propertyKeys[name]
	if existing ~= nil then
		return existing
	end
	local created: PropertyKey = { composeKey = "property", name = name }
	table.freeze(created :: {})
	propertyKeys[name] = created
	return created
end

local function group(names: { string }): GroupKey
	if #names == 0 then
		error("group needs at least one property name", 2)
	end
	local copied = table.create(#names) :: { string }
	for index, name in names do
		if type(name) ~= "string" then
			error(("group names must be strings; entry %d is %s"):format(index, typeof(name)), 2)
		end
		copied[index] = name
	end
	table.freeze(copied)
	local created: GroupKey = { composeKey = "group", names = copied }
	table.freeze(created :: {})
	return created
end

local function static(value: unknown): StaticValue
	local created: StaticValue = { composeValue = "static", value = value }
	table.freeze(created :: {})
	return created
end

export type Marker = {
	kind: "event" | "property" | "group",
	name: string,
	names: { string }?,
}

local function readKey(key: unknown): Marker?
	if type(key) ~= "table" then
		return nil
	end
	local marker = key :: { composeKey: unknown, name: unknown, names: unknown }
	local kind = marker.composeKey
	if kind == "event" then
		return { kind = "event", name = tostring(marker.name) }
	elseif kind == "property" then
		return { kind = "property", name = tostring(marker.name) }
	elseif kind == "group" then
		local names = marker.names :: { string }
		return { kind = "group", name = table.concat(names, "+"), names = names }
	end
	return nil
end

local function readStatic(value: unknown): (unknown, boolean)
	if type(value) ~= "table" then
		return nil, false
	end
	local marker = value :: { composeValue: unknown, value: unknown }
	if marker.composeValue ~= "static" then
		return nil, false
	end
	return marker.value, true
end

return {
	event = event,
	group = group,
	property = property,
	static = static,
	readKey = readKey,
	readStatic = readStatic,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="294">
                  <Properties>
                    <string name="Name">props</string>
                    <string name="Source"><![CDATA[--!strict

local Diagnostics = require "../diagnostics"
local Host = require "../host"
local Keys = require "./keys"
local Nodes = require "../ownership/nodes"
local cellModule = require "../reactive/cell"
local profile = require "../reactive/profile"
local stats = require "../reactive/stats"
local statsOn = stats.state
local Owner = require "../ownership/owner"
local Types = require "../reactive/types"
local Weak = require "../weak"

type Node = Host.Node

local UNWRITTEN = newproxy(false)

export type Props = { [unknown]: unknown }

type Binding = { remaining: number, active: boolean, dispose: (() -> ())?, pendingKey: string?, previous: Binding? }
type Bindings = { [string]: Binding? }
type Registry = { [Node]: Bindings }

type Clear = (node: Node, key: string, value: nil) -> ...unknown
type GroupBody = (use: Types.Use) -> ...unknown

local propertyBindings = Weak.keys() :: Registry
local attributeBindings = Weak.keys() :: Registry

local function retireBinding(binding: Binding?, key: string)
	if binding == nil then
		return
	end
	if binding.pendingKey == key then
		retireBinding(binding.previous, key)
		return
	end
	binding.remaining -= 1
	if binding.remaining == 0 then
		binding.active = false
		if binding.dispose ~= nil then
			binding.dispose()
		end
	end
end

local function replace(bindings: Bindings, key: string, binding: Binding?)
	local previous = bindings[key]
	bindings[key] = binding
	if binding ~= nil then
		binding.remaining += 1
		binding.active = true
	end
	retireBinding(previous, key)
end

local function beginWrite(
	registry: Registry,
	node: Node,
	bindings: Bindings,
	key: string,
	binding: Binding,
	previous: Binding?
): boolean
	if registry[node] ~= bindings or bindings[key] ~= previous then
		return false
	end
	binding.pendingKey = key
	binding.previous = previous
	bindings[key] = binding
	return true
end

local function finishWrite(bindings: Bindings, key: string, binding: Binding, succeeded: boolean)
	local previous = binding.previous
	binding.previous = nil
	binding.pendingKey = nil
	if bindings[key] ~= binding then
		return
	end
	if succeeded then
		binding.remaining += 1
		binding.active = true
		retireBinding(previous, key)
	else
		bindings[key] = if previous ~= nil and (previous.active or previous.pendingKey == key) then previous else nil
	end
end

local function bindingFor(registry: Registry, node: Node): (Bindings, Binding)
	local bindings = registry[node]
	if bindings == nil then
		bindings = {}
		registry[node] = bindings
	end
	return bindings, { remaining = 0, active = false }
end

local function retire(registry: Registry, node: Node, key: string)
	local bindings = registry[node]
	if bindings ~= nil then
		replace(bindings, key, nil)
		if next(bindings) == nil and registry[node] == bindings then
			registry[node] = nil
		end
	end
end

local function singleCleanup(
	registry: Registry,
	node: Node,
	bindings: Bindings,
	key: string,
	binding: Binding,
	clear: Clear
): () -> ()
	local borrowed = not Nodes.isDestructible(node)
	return function()
		binding.active = false
		if bindings[key] ~= binding then
			if next(bindings) == nil and registry[node] == bindings then
				registry[node] = nil
			end
			return
		end
		if binding.pendingKey == key then
			bindings[key] = binding.previous
			return
		end
		bindings[key] = nil
		binding.remaining = 0
		if next(bindings) == nil and registry[node] == bindings then
			registry[node] = nil
		end
		if borrowed then
			clear(node, key, nil)
		end
	end
end

local function classify(host: Host.Host, node: Node, key: string): Host.KeyKind
	local events = host.events
	if events == nil then
		return "property"
	end
	local classifyKey = events.classifyKey
	if classifyKey == nil then
		return "property"
	end
	return classifyKey(node, key)
end

local function subscribe(host: Host.Host, node: Node, owner: Owner.Owner, name: string, handler: (...unknown) -> ())
	local events = host.events
	if events == nil then
		Diagnostics.raise("host/no-events", ("host %q cannot subscribe to events"):format(host.name), {
			event = name,
			node = Host.describeNode(host, node),
			contract = "subscribing requires the host events capability",
			fix = "implement host.events.connectEvent, or stop passing event keys to this host",
		})
	end
	owner.own((events :: Host.Events).connectEvent(node, name, handler))
end

local function refuseNodeValue(host: Host.Host, node: Node, key: string, value: unknown)
	if not Nodes.isDestructible(value) then
		return
	end
	Diagnostics.raise("props/child-under-string-key", "a node was given as the value of a property", {
		key = key,
		node = Host.describeNode(host, node),
		actual = ("a node this runtime will destroy: %s"):format(Host.describeNode(host, value)),
		expected = "a value the host can store in a property",
		contract = "a string key names a property to write; children live in the array part of the props table",
		fix = ("drop the key -- write the node as a positional child rather than as %s = ...; "):format(key)
			.. ("if this host really does take a node there, say so with %s = static(node)"):format(key),
	})
end

local function writeOnce(host: Host.Host, node: Node, owner: Owner.Owner, key: string, value: unknown)
	local before = propertyBindings[node]
	local previous = if before ~= nil then before[key] else nil
	host.render.setProperty(node, key, value)
	local current = propertyBindings[node]
	if (if current ~= nil then current[key] else nil) ~= previous then
		return
	end
	if Nodes.isDestructible(node) then
		retire(propertyBindings, node, key)
		return
	end
	local bindings, binding = bindingFor(propertyBindings, node)
	local cleanup = singleCleanup(propertyBindings, node, bindings, key, binding, host.render.clearProperty :: Clear)
	replace(bindings, key, binding)
	binding.dispose = owner.own(cleanup)
end

local function bind(host: Host.Host, node: Node, owner: Owner.Owner, key: string, source: Types.Source<unknown>)
	local render = host.render
	local setProperty = render.setProperty
	local bindings, binding = bindingFor(propertyBindings, node)
	local previous = bindings[key]
	local initial = true
	local function publish(value: unknown)
		if initial then
			if not beginWrite(propertyBindings, node, bindings, key, binding, previous) then
				initial = false
				if binding.dispose ~= nil then
					binding.dispose()
				end
				return
			end
			local ok, err: unknown = pcall(setProperty, node, key, value)
			finishWrite(bindings, key, binding, ok)
			if not ok then
				error(err, 0)
			end
			initial = false
		elseif binding.active then
			setProperty(node, key, value)
		else
			return
		end
		if statsOn.enabled then
			profile.hostWrite()
		end
	end
	local cleanup = singleCleanup(propertyBindings, node, bindings, key, binding, render.clearProperty :: Clear)
	if statsOn.enabled then
		profile.naming(("%s.%s"):format(Host.describeNode(host, node), key))
	end
	if cellModule.isReadable(source) then
		binding.dispose = owner.watchStatic(source :: Types.Readable<unknown>, publish, cleanup)
	else
		local body = source :: Types.Body<unknown>
		binding.dispose = owner.watchTerminal(function(use)
			if initial then
				publish(body(use))
			elseif binding.active then
				local value = body(use)
				if binding.active then
					setProperty(node, key, value)
					if statsOn.enabled then
						profile.hostWrite()
					end
				end
			end
		end, cleanup)
	end
	if statsOn.enabled then
		profile.naming(nil)
	end
	previous = nil
	if binding.remaining == 0 then
		(binding.dispose :: () -> ())()
	end
end

local function bindGroup(host: Host.Host, node: Node, owner: Owner.Owner, names: { string }, source: unknown)
	local render = host.render
	local count = #names
	for index = 1, count do
		local name = names[index]
		if classify(host, node, name) == "event" then
			Diagnostics.raise("props/group-names-an-event", "a group named a key the host classifies as an event", {
				event = name,
				node = Host.describeNode(host, node),
				contract = "a group writes properties; events are subscribed with event(name)",
				fix = ("move %q out of the group and onto its own [event(%q)] key"):format(name, name),
			})
		end
	end
	if type(source) ~= "function" then
		Diagnostics.raise("props/group-needs-a-body", "a group key was given something that is not a body", {
			properties = table.concat(names, ", "),
			node = Host.describeNode(host, node),
			actual = Diagnostics.describe(source),
			expected = "a function taking `use` and returning one value per name",
		})
	end

	local body = source :: GroupBody
	local written = table.create(count, UNWRITTEN) :: { unknown }
	local bindings, binding = bindingFor(propertyBindings, node)
	local previous = table.create(count) :: { Binding? }
	for index, name in names do
		previous[index] = bindings[name]
	end
	local borrowed = not Nodes.isDestructible(node)
	local function cleanup()
		binding.active = false
		local failure: unknown = nil
		for _, name in names do
			if bindings[name] == binding then
				if binding.pendingKey == name then
					bindings[name] = binding.previous
					continue
				end
				bindings[name] = nil
				if borrowed then
					local ok, err: unknown = pcall(render.clearProperty, node, name)
					if not ok and failure == nil then
						failure = err
					end
				end
			end
		end
		binding.remaining = 0
		if next(bindings) == nil and propertyBindings[node] == bindings then
			propertyBindings[node] = nil
		end
		if failure ~= nil then
			error(failure, 0)
		end
	end
	if statsOn.enabled then
		profile.naming(("%s.{%s}"):format(Host.describeNode(host, node), table.concat(names, ",")))
	end
	binding.dispose = owner.watch(function(use)
		local values = table.pack(body(use))
		if values.n ~= count then
			Diagnostics.raise("props/group-arity", "a group body returned the wrong number of values", {
				properties = table.concat(names, ", "),
				node = Host.describeNode(host, node),
				actual = ("%d value(s)"):format(values.n),
				expected = ("%d, one per name, in order"):format(count),
			})
		end
		for index = 1, count do
			local name = names[index]
			local initial = written[index] == UNWRITTEN
			local value = values[index]
			if initial then
				if not beginWrite(propertyBindings, node, bindings, name, binding, previous[index]) then
					written[index] = value
					continue
				end
				local ok, err: unknown = pcall(render.setProperty, node, name, value)
				finishWrite(bindings, name, binding, ok)
				if not ok then
					error(err, 0)
				end
			elseif bindings[name] == binding and value ~= written[index] then
				render.setProperty(node, name, value)
			else
				continue
			end
			written[index] = value
			if statsOn.enabled then
				profile.hostWrite()
			end
		end
		if binding.remaining == 0 and binding.dispose ~= nil then
			binding.dispose()
		end
	end, nil, cleanup)
	if statsOn.enabled then
		profile.naming(nil)
	end
	table.clear(previous)
	for index = 1, count do
		if written[index] == UNWRITTEN then
			written[index] = nil
		end
	end
	if binding.remaining == 0 then
		(binding.dispose :: () -> ())()
	end
end

local ATTRIBUTES = "Attributes"

type SetAttribute = (node: Node, name: string, value: unknown) -> (boolean, string?)

local function attributeWriter(host: Host.Host, node: Node): SetAttribute
	local setAttribute = host.render.setAttribute
	if setAttribute == nil then
		Diagnostics.raise("host/no-attributes", ("host %q cannot store attributes"):format(host.name), {
			key = ATTRIBUTES,
			node = Host.describeNode(host, node),
			contract = "an Attributes prop requires the render.setAttribute capability",
			fix = "implement host.render.setAttribute, or write the value under an ordinary property key",
		})
	end
	return setAttribute :: SetAttribute
end

local function writeAttribute(host: Host.Host, node: Node, write: SetAttribute, name: string, value: unknown)
	local accepted, reason = write(node, name, value)
	if accepted then
		return
	end
	Diagnostics.raise("props/attribute-value", "the host refused an attribute value", {
		key = ("%s.%s"):format(ATTRIBUTES, name),
		node = Host.describeNode(host, node),
		actual = Diagnostics.describe(value),
		expected = "a value this host stores as an attribute",
		detail = if reason ~= nil then reason else "the host gave no reason",
		contract = "an attribute value must be one the host's attribute store accepts; nil clears it",
		fix = ("write a value the host accepts, or move %q onto an ordinary property key"):format(name),
	})
end

local function refuseNodeAttribute(host: Host.Host, node: Node, name: string, value: unknown)
	if not Nodes.isDestructible(value) then
		return
	end
	Diagnostics.raise("props/child-under-attribute", "a node was given as the value of an attribute", {
		key = ("%s.%s"):format(ATTRIBUTES, name),
		node = Host.describeNode(host, node),
		actual = ("a node this runtime will destroy: %s"):format(Host.describeNode(host, value)),
		expected = "a value the host can store in an attribute",
		contract = "an attribute holds data; children live in the array part of the props table",
		fix = ("drop the attribute -- write the node as a positional child rather than as %s.%s"):format(
			ATTRIBUTES,
			name
		),
	})
end

local function writeAttributeOnce(
	host: Host.Host,
	node: Node,
	owner: Owner.Owner,
	write: SetAttribute,
	name: string,
	value: unknown
)
	local before = attributeBindings[node]
	local previous = if before ~= nil then before[name] else nil
	writeAttribute(host, node, write, name, value)
	local current = attributeBindings[node]
	if (if current ~= nil then current[name] else nil) ~= previous then
		return
	end
	if Nodes.isDestructible(node) then
		retire(attributeBindings, node, name)
		return
	end
	local bindings, binding = bindingFor(attributeBindings, node)
	local cleanup = singleCleanup(attributeBindings, node, bindings, name, binding, write)
	replace(bindings, name, binding)
	binding.dispose = owner.own(cleanup)
end

local function bindAttribute(
	host: Host.Host,
	node: Node,
	owner: Owner.Owner,
	write: SetAttribute,
	name: string,
	source: Types.Source<unknown>
)
	local written: unknown = UNWRITTEN
	local bindings, binding = bindingFor(attributeBindings, node)
	local previous = bindings[name]
	local function publish(value: unknown)
		local initial = written == UNWRITTEN
		if initial then
			if not beginWrite(attributeBindings, node, bindings, name, binding, previous) then
				written = value
				if binding.dispose ~= nil then
					binding.dispose()
				end
				return
			end
			local ok, err: unknown = pcall(writeAttribute, host, node, write, name, value)
			finishWrite(bindings, name, binding, ok)
			if not ok then
				error(err, 0)
			end
		elseif not binding.active or value == written then
			return
		else
			writeAttribute(host, node, write, name, value)
		end
		written = value
		if statsOn.enabled then
			profile.hostWrite()
		end
	end
	local cleanup = singleCleanup(attributeBindings, node, bindings, name, binding, write)
	if statsOn.enabled then
		profile.naming(("%s.%s.%s"):format(Host.describeNode(host, node), ATTRIBUTES, name))
	end
	if cellModule.isReadable(source) then
		binding.dispose = owner.watchStatic(source :: Types.Readable<unknown>, publish, cleanup)
	else
		local body = source :: Types.Body<unknown>
		binding.dispose = owner.watchTerminal(function(use)
			publish(body(use))
		end, cleanup)
	end
	if statsOn.enabled then
		profile.naming(nil)
	end
	previous = nil
	if binding.remaining == 0 then
		(binding.dispose :: () -> ())()
	end
end

local function applyAttributes(host: Host.Host, node: Node, owner: Owner.Owner, source: unknown, onKey: (string) -> ())
	if type(source) ~= "table" then
		Diagnostics.raise(
			"props/attributes-not-a-table",
			"the Attributes key was given something that is not a table",
			{
				key = ATTRIBUTES,
				node = Host.describeNode(host, node),
				actual = Diagnostics.describe(source),
				expected = "a table of attribute name to value",
				contract = "Attributes is a reserved key naming a table of attributes to write",
				fix = 'write Attributes = { Tier = 3 }, or [Compose.property "Attributes"] = value for a real property',
			}
		)
	end

	local table_ = source :: { [unknown]: unknown }
	local names: { string } = {}
	for name in table_ do
		if type(name) ~= "string" or name == "" then
			Diagnostics.raise("props/attribute-name", "an attribute name is not a non-empty string", {
				key = ATTRIBUTES,
				node = Host.describeNode(host, node),
				actual = Diagnostics.describe(name),
				expected = "a non-empty string",
				contract = "every key of an Attributes table names one attribute",
				fix = "give the attribute a name the host can address",
			})
		end
		table.insert(names, name :: string)
	end

	table.sort(names)

	local write = attributeWriter(host, node)
	for _, name in names do
		onKey(("%s.%s"):format(ATTRIBUTES, name))
		local value = table_[name]

		local literal, isStatic = Keys.readStatic(value)
		if isStatic then
			writeAttributeOnce(host, node, owner, write, name, literal)
			continue
		end

		if cellModule.isReadable(value) or type(value) == "function" then
			bindAttribute(host, node, owner, write, name, value :: Types.Source<unknown>)
			continue
		end

		refuseNodeAttribute(host, node, name, value)
		writeAttributeOnce(host, node, owner, write, name, value)
	end
end

local function apply(host: Host.Host, node: Node, props: Props, owner: Owner.Owner, onKey: (string) -> ())
	local length = #props

	for key, value in props do
		if type(key) == "number" and key >= 1 and key <= length and key % 1 == 0 then
			continue
		end

		local marker = Keys.readKey(key)
		if marker ~= nil then
			onKey(marker.name)
			if marker.kind == "group" then
				bindGroup(host, node, owner, marker.names :: { string }, value)
			elseif marker.kind == "event" then
				if type(value) ~= "function" then
					Diagnostics.raise(
						"props/event-needs-handler",
						"an event key was given something that is not a handler",
						{
							event = marker.name,
							node = Host.describeNode(host, node),
							actual = Diagnostics.describe(value),
							expected = "a function",
						}
					)
				end
				subscribe(host, node, owner, marker.name, value :: (...unknown) -> ())
			elseif type(value) == "function" or cellModule.isReadable(value) then
				bind(host, node, owner, marker.name, value :: Types.Source<unknown>)
			else
				refuseNodeValue(host, node, marker.name, value)
				writeOnce(host, node, owner, marker.name, value)
			end
			continue
		end

		if type(key) ~= "string" then
			Diagnostics.raise("props/unsupported-key", "a props key is neither a string nor a wrapped key", {
				actual = Diagnostics.describe(key),
				expected = 'a string, event("Name"), or property("Name")',
				contract = "props keys name properties and events; array entries are children",
			})
		end
		local name = key :: string

		if name == ATTRIBUTES then
			onKey(ATTRIBUTES)
			applyAttributes(host, node, owner, value, onKey)
			continue
		end

		onKey(name)

		local literal, isStatic = Keys.readStatic(value)
		if isStatic then
			writeOnce(host, node, owner, name, literal)
			continue
		end

		if cellModule.isReadable(value) then
			bind(host, node, owner, name, value :: Types.Source<unknown>)
			continue
		end

		if type(value) == "function" then
			if classify(host, node, name) == "event" then
				subscribe(host, node, owner, name, value :: (...unknown) -> ())
			else
				bind(host, node, owner, name, value :: Types.Source<unknown>)
			end
			continue
		end

		refuseNodeValue(host, node, name, value)
		writeOnce(host, node, owner, name, value)
	end
end

return {
	apply = apply,
}
]]></string>
                  </Properties>
                </Item>
              </Item>
              <Item class="ModuleScript" referent="295">
                <Properties>
                  <string name="Name">scheduler</string>
                  <string name="Source"><![CDATA[--!strict

local Active = require "./ownership/active"
local Diagnostics = require "./diagnostics"
local Owner = require "./ownership/owner"
local Timeline = require "./animation/timeline"

export type Cancel = () -> boolean

export type Scheduler = {
	after: (seconds: number, body: () -> ()) -> Cancel,
	replace: (key: unknown, seconds: number, body: () -> ()) -> Cancel,
	cancel: (key: unknown) -> boolean,
	clear: () -> (),
	pending: () -> number,
	dispose: () -> (),
}

type Entry = {
	due: number,
	sequence: number,
	key: unknown,
	body: () -> (),
	live: boolean,
}

local function noop(): boolean
	return false
end

local function checkDelay(seconds: unknown)
	if type(seconds) ~= "number" or seconds ~= seconds or seconds < 0 or seconds == math.huge then
		Diagnostics.raise("scheduler/invalid-delay", "a scheduled task needs a finite delay of zero or more seconds", {
			actual = Diagnostics.describe(seconds),
			expected = "seconds, e.g. 0.25; zero runs on the next frame",
		})
	end
end

local function checkBody(body: unknown)
	if type(body) ~= "function" then
		Diagnostics.raise("scheduler/invalid-body", "a scheduled task needs a function to run", {
			actual = Diagnostics.describe(body),
			expected = "a function taking no arguments",
		})
	end
end

local function checkKey(key: unknown)
	if key == nil or key ~= key then
		Diagnostics.raise("scheduler/invalid-key", "a replacement key must be a value other than nil or NaN", {
			actual = Diagnostics.describe(key),
			expected = "a string, number, boolean or table identifying the work",
		})
	end
end

local function createSchedulers(
	timeline: (options: Timeline.Options?) -> Timeline.Timeline,
	requireOwner: (operation: string) -> Owner.Owner
): (owner: Owner.Owner?) -> Scheduler
	return function(explicit: Owner.Owner?): Scheduler
		local parent: Owner.Owner
		if explicit ~= nil then
			if type(explicit) ~= "table" or type(explicit.createChild) ~= "function" then
				Diagnostics.raise("scheduler/invalid-owner", "a scheduler can only be bound to an owner", {
					actual = Diagnostics.describe(explicit),
					expected = "an owner from Compose.createOwner or owner.createChild",
				})
			end
			parent = explicit
		else
			parent = requireOwner "scheduler"
		end

		local scope = parent.createChild()
		local entries: { [Entry]: true } = {}
		local keyed: { [unknown]: Entry } = {}
		local count = 0
		local sequence = 0
		local clock: Timeline.Timeline

		local created, failure: unknown = pcall(function()
			Active.withOwner(scope, function()
				clock = timeline { duration = 1, repeats = math.huge, autoplay = false }
			end)
		end)
		if not created then
			pcall(scope.dispose)
			error(failure, 0)
		end

		local function retire(entry: Entry): boolean
			if not entry.live then
				return false
			end
			entry.live = false
			entries[entry] = nil
			count -= 1
			if entry.key ~= nil and keyed[entry.key] == entry then
				keyed[entry.key] = nil
			end
			if count == 0 then
				clock:pause()
			end
			return true
		end

		local function drain(now: number)
			local due: { Entry } = {}
			for entry in entries do
				if entry.due <= now then
					table.insert(due, entry)
				end
			end
			if #due == 0 then
				return
			end
			table.sort(due, function(a: Entry, b: Entry): boolean
				if a.due ~= b.due then
					return a.due < b.due
				end
				return a.sequence < b.sequence
			end)
			local failures: { unknown } = {}
			for _, entry in due do
				if entry.live then
					retire(entry)
					local ok, problem: unknown = pcall(function()
						Active.withOwner(scope, entry.body)
						return nil
					end)
					if not ok then
						table.insert(failures, problem)
					end
				end
			end
			Owner.raiseAll(failures)
		end

		scope.own(function()
			for entry in entries do
				entry.live = false
			end
			table.clear(entries)
			table.clear(keyed)
			count = 0
		end)
		scope.watchStatic(clock.elapsed, drain)

		local function schedule(key: unknown, seconds: number, body: () -> ()): Cancel
			checkDelay(seconds)
			checkBody(body)
			if scope.isDisposed() then
				return noop
			end
			if key ~= nil then
				local prior = keyed[key]
				if prior ~= nil then
					retire(prior)
				end
			end
			sequence += 1
			local entry: Entry = {
				due = clock.elapsed:peek() + seconds,
				sequence = sequence,
				key = key,
				body = body,
				live = true,
			}
			entries[entry] = true
			if key ~= nil then
				keyed[key] = entry
			end
			count += 1
			if count == 1 then
				clock:play()
			end
			return function(): boolean
				return retire(entry)
			end
		end

		return {
			after = function(seconds: number, body: () -> ()): Cancel
				return schedule(nil, seconds, body)
			end,
			replace = function(key: unknown, seconds: number, body: () -> ()): Cancel
				checkKey(key)
				return schedule(key, seconds, body)
			end,
			cancel = function(key: unknown): boolean
				local entry = keyed[key]
				return entry ~= nil and retire(entry)
			end,
			clear = function()
				local live: { Entry } = {}
				for entry in entries do
					table.insert(live, entry)
				end
				for _, entry in live do
					retire(entry)
				end
			end,
			pending = function(): number
				return count
			end,
			dispose = scope.dispose,
		}
	end
end

return {
	createSchedulers = createSchedulers,
}
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="296">
                <Properties>
                  <string name="Name">slot</string>
                  <string name="Source"><![CDATA[--!strict

local Active = require "./ownership/active"
local Diagnostics = require "./diagnostics"
local Owner = require "./ownership/owner"

export type Slot = {
	bind: (key: unknown, attach: (owner: Owner.Owner, release: () -> ()) -> ()) -> boolean,
	release: (key: unknown) -> boolean,
	current: () -> unknown,
	dispose: () -> (),
}

local function createSlot(explicit: Owner.Owner?): Slot
	local parent = explicit
	if parent == nil then
		parent = Active.current()
		if parent == nil then
			Diagnostics.raise("slot/no-active-owner", "createSlot ran outside an owner", {
				contract = "a slot cannot outlive the owner responsible for what it holds",
				fix = "create it inside a component, Compose.withOwner(owner, ...), or pass an owner",
			})
		end
	elseif type(parent) ~= "table" or type((parent :: Owner.Owner).createChild) ~= "function" then
		Diagnostics.raise("slot/invalid-owner", "a slot can only be bound to an owner", {
			actual = Diagnostics.describe(parent),
			expected = "an owner from Compose.createOwner or owner.createChild",
		})
	end
	local scope = (parent :: Owner.Owner).createChild()
	local currentKey: unknown = nil
	local currentOwner: Owner.Owner? = nil
	scope.own(function()
		currentKey = nil
		currentOwner = nil
	end)

	local function release(key: unknown): boolean
		if key == nil or currentKey ~= key then
			return false
		end
		currentKey = nil
		local owner = currentOwner
		currentOwner = nil
		if owner ~= nil then
			owner.dispose()
		end
		return true
	end

	local function bind(key: unknown, attach: (owner: Owner.Owner, release: () -> ()) -> ()): boolean
		if key == nil or key ~= key then
			Diagnostics.raise("slot/invalid-key", "a slot key must be a value other than nil or NaN", {
				actual = Diagnostics.describe(key),
				expected = "the value the slot holds the attachment for",
			})
		end
		if type(attach) ~= "function" then
			Diagnostics.raise("slot/invalid-attach", "a slot needs a function that attaches the new value", {
				actual = Diagnostics.describe(attach),
				expected = "a function receiving the owner for the attachment and a release callback",
			})
		end
		if scope.isDisposed() or currentKey == key then
			return false
		end
		local staged = scope.createChild()
		local ok, failure: unknown = pcall(function()
			Active.withOwner(staged, function()
				attach(staged, function()
					release(key)
				end)
			end)
			return nil
		end)
		if not ok then
			pcall(staged.dispose)
			error(failure, 0)
		end
		if scope.isDisposed() then
			return false
		end
		local prior = currentOwner
		currentKey = key
		currentOwner = staged
		if prior ~= nil then
			prior.dispose()
		end
		return true
	end

	return {
		bind = bind,
		release = release,
		current = function(): unknown
			return currentKey
		end,
		dispose = scope.dispose,
	}
end

return createSlot
]]></string>
                </Properties>
              </Item>
