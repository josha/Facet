          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">input_value</string>
              <string name="Source"><![CDATA[--!strict
local Shared = require("./types")
export type Options = {
	min: number?,
	max: number?,
	step: Shared.Value<number>?,
	format: ((number) -> string)?,
}
export type Model = {
	min: number,
	max: number,
	quantize: (number) -> number,
	format: (number) -> string,
	fraction: (number) -> number,
	fromFraction: (number) -> number,
	stepped: (number, number) -> number,
}
export type Read = Shared.Read
local function finite(value: unknown): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function defaultFormat(value: number): string
	if value == 0 then
		return "0"
	end
	if value % 1 == 0 then
		return string.format("%d", value)
	end
	local text = string.format("%.2f", value):gsub("0+$", ""):gsub("%.$", "")
	return if text == "-0" then "0" else text
end

return function(spec: Options, read: Read): Model
	local minimum, maximum = spec.min or 0, spec.max or 1
	assert(
		finite(minimum) and finite(maximum) and maximum > minimum,
		"Facet value control: finite min must be below max"
	)
	local function step(): number?
		local value = read(spec.step)
		assert(value == nil or (finite(value) and value > 0), "Facet value control: step must be positive and finite")
		return value
	end
	step()
	local function clamp(value: number): number
		return if finite(value) then math.clamp(value, minimum, maximum) else minimum
	end
	local function quantize(value: number): number
		local clamped, increment = clamp(value), step()
		return if increment
			then clamp(minimum + math.floor((clamped - minimum) / increment + 0.5) * increment)
			else clamped
	end
	local function format(value: number): string
		if spec.format then
			local ok, formatted = pcall(spec.format, clamp(value))
			if ok and type(formatted) == "string" then
				return formatted
			end
		end
		return defaultFormat(clamp(value))
	end
	return {
		min = minimum,
		max = maximum,
		quantize = quantize,
		format = format,
		fraction = function(value: number): number
			return (clamp(value) - minimum) / (maximum - minimum)
		end,
		fromFraction = function(fraction: number): number
			return quantize(minimum + math.clamp(fraction, 0, 1) * (maximum - minimum))
		end,
		stepped = function(value: number, direction: number): number
			local increment = step()
			local delta = (increment or (maximum - minimum) / 100) * (if direction < 0 then -1 else 1)
			local nextValue = quantize(clamp(value) + delta)
			return if increment and nextValue == quantize(value) then clamp(nextValue + delta) else nextValue
		end,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">inputs</string>
              <string name="Source"><![CDATA[--!strict
local textField = require("./text_field")
local inputKit = require("./input_kit")
local inputButton = require("./input_button")
local inputToggle = require("./input_toggle")
local inputStepper = require("./input_stepper")
local inputLevel = require("./input_level")
local inputChip = require("./input_chip")
local inputShortcutHint = require("./input_shortcut_hint")
local InputTypes = require("./input_types")
local Shared = require("./types")
local ControlTypes = require("./control_types")
local ComposeTypes = require("../vendor/compose/core")

return function(ctx: Shared.Context, UI: ControlTypes.Controls): ()
	local kit = inputKit(ctx)
	local runtime = ctx.runtime
	local stopEnabled, adjustment = kit.stopEnabled, kit.adjustment
	inputButton(ctx, UI, kit)
	inputToggle(ctx, UI, kit)
	textField(ctx, UI)
	inputStepper(ctx, UI, kit)

	UI.feedback = function(kind: Shared.HapticKind)
		assert(type(kind) == "string", "Facet UI.feedback expects a feedback kind")
		local effect = ctx.haptic(kind) :: HapticEffect
		effect:Play()
	end

	UI.adjustable = function(node: GuiObject, options: InputTypes.AdjustableOptions)
		assert(
			type(options) == "table" and type(options.onAdjust) == "function",
			"Facet UI.adjustable requires onAdjust"
		)
		local axis = options.axis or "horizontal"
		assert(
			axis == "horizontal" or axis == "vertical" or axis == "none",
			`Facet UI.adjustable: axis '{tostring(axis)}' is not horizontal, vertical or none`
		)
		local canAdjust = options.canAdjust
		local bound = if axis == "none" then nil else math.huge
		runtime.decorate(node, {
			Selectable = function(use: ComposeTypes.Use): boolean
				return stopEnabled(options, use)
			end,
		})
		adjustment(node, options, options.onAdjust, nil, if bound then -bound else nil, bound, {
			vertical = axis == "vertical",
			once = options.repeats ~= true,
			arrows = function(use: ComposeTypes.Use, direction: number): boolean
				return canAdjust == nil or canAdjust(direction, use)
			end,
		})
	end

	require("./slider")(ctx, UI, {
		enabled = kit.enabled,
		stopEnabled = stopEnabled,
		writable = kit.writable,
		attributes = kit.attributes,
		valueAttributes = kit.valueAttributes,
		adjustment = adjustment,
		paintedPart = kit.paintedPart,
	})

	inputLevel(ctx, UI, kit)
	inputChip(ctx, UI, kit)
	inputShortcutHint(ctx, UI, kit)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">layout</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local Engine = require("./engine_types")
local Layout = require("./layout_types")
local layoutKit = require("./layout_kit")
local scrollLock = require("./scroll_lock")
local initialScroll = require("./scroll_initial")
local ControlTypes = require("./control_types")
local LayoutProps = require("./layout_props")
export type LayoutControls = ControlTypes.Controls

return function(ctx: Types.Context, controls: ControlTypes.Controls?): ControlTypes.Controls
	local Host, read, Compose, runtime = ctx.Host, ctx.read, ctx.Compose, ctx.runtime
	local kit = layoutKit.of(ctx)
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local UI: ControlTypes.Controls = controls or ({} :: ControlTypes.Controls)
	local flowKeys = { "gap", "padding", "align", "distribute", "wrap", "width", "height" }
	local function containerProps(spec: unknown, keys: { string }): { [unknown]: unknown }
		local maxWidth = (spec :: { maxWidth: Types.ValueNumber? }).maxWidth
		if maxWidth == nil then
			return ctx.props(spec, keys) :: { [unknown]: unknown }
		end
		local omitted = table.clone(keys)
		table.insert(omitted, "maxWidth")
		local properties = ctx.props(spec, omitted) :: { [unknown]: unknown }
		properties[#properties + 1] = Host.UISizeConstraint({
			MaxSize = function(use: ComposeTypes.Use): Vector2
				local value = read(maxWidth, use)
				assert(
					type(value) == "number" and value >= 0 and value < math.huge,
					"Facet maxWidth must be a finite number of pixels, 0 or more"
				)
				return V2.new(value, math.huge)
			end,
		})
		return properties
	end
	local function split(spec: unknown, keys: { string }): ({ [unknown]: unknown }, { ComposeTypes.Child })
		local fields = spec :: { [unknown]: unknown }
		local named: { [unknown]: unknown } = {}
		local children: { ComposeTypes.Child } = {}
		for key, value in fields do
			if type(key) ~= "number" then
				named[key] = value
			end
		end
		for index = 1, #fields do
			children[index] = fields[index] :: ComposeTypes.Child
		end
		return containerProps(named, keys), children
	end
	local function stack(spec: LayoutProps.StackProps, vertical: boolean): Frame
		local properties, children = split(spec, flowKeys)
		return kit.stack(children, (properties :: unknown) :: Engine.FrameNativeProps, spec, vertical)
	end

	UI.VStack = ctx.construct("VStack", function(spec: LayoutProps.StackProps): Frame
		return stack(spec, true)
	end)

	UI.HStack = ctx.construct("HStack", function(spec: LayoutProps.StackProps): Frame
		return stack(spec, false)
	end)

	UI.Screen = ctx.construct("Screen", function(spec: LayoutProps.ScreenProps): Frame
		local properties, children =
			split(spec, { "gap", "padding", "align", "distribute", "width", "height", "chrome" })
		local chrome = spec.chrome or "device"
		assert(
			chrome == "device" or chrome == "band" or chrome == "edge",
			"Facet UI.Screen: chrome must be device, band or edge"
		)
		local base: Types.Value<Types.Padding> = if spec.padding == nil then "m" else spec.padding
		local under = Compose.cell(0)
		local clearance: ComposeTypes.Cell<{ [string]: number }?> = Compose.cell(nil :: { [string]: number }?)
		local distant = ctx.tenFoot()
		local authored = ctx.config.environment and ctx.config.environment.overscanInsets
		local needsInsets = Compose.formula(function(use: ComposeTypes.Use): boolean
			local margins = read(authored, use)
			return chrome ~= "edge" and (type(margins) == "table" or (margins == nil and distant(use)))
		end)
		local FRACTION = { top = 60 / 1080, bottom = 60 / 1080, left = 90 / 1920, right = 90 / 1920 }
		local flow: Types.Flow = {
			gap = spec.gap,
			align = spec.align,
			distribute = spec.distribute,
			padding = function(use: ComposeTypes.Use): Types.Padding
				local value = read(base, use)
				local sides: Types.Sides = if type(value) == "table"
					then value :: Types.Sides
					else { top = value, right = value, bottom = value, left = value }
				local margins = read(authored, use)
				local function side(name: "top" | "right" | "bottom" | "left", extra: number): UDim
					local pixels = kit.spacing((sides :: { [string]: Types.Space? })[name], use) + extra
					local available = use(clearance)
					if available and chrome ~= "edge" then
						return ctx.types.UDim.new(0, pixels + available[name])
					end
					if type(margins) == "table" and chrome ~= "edge" then
						return ctx.types.UDim.new(0, pixels + ((margins :: { [string]: number })[name] or 0))
					end
					local fraction = if margins == nil and chrome ~= "edge" and distant(use) then FRACTION[name] else 0
					return ctx.types.UDim.new(fraction, pixels)
				end
				return (
					{
						top = side("top", if chrome == "device" then use(under) else 0),
						right = side("right", 0),
						bottom = side("bottom", 0),
						left = side("left", 0),
					} :: unknown
				) :: Types.Padding
			end,
			width = spec.width,
			height = spec.height,
		}
		local frame =
			kit.stack(children, (properties :: unknown) :: Engine.FrameNativeProps, flow, true, "fill", "fill")
		kit.underTopbar(frame, under)
		local owner = assert(Compose.currentOwner())
		local observing: ComposeTypes.Owner? = nil
		local function locate()
			if observing then
				observing.dispose()
				observing = nil
			end
			local layer = (ctx.config.overlayParent or frame:FindFirstAncestorWhichIsA("LayerCollector")) :: GuiBase2d?
			if layer == nil or not needsInsets:peek() then
				clearance:set(nil)
				return
			end
			local child = owner.createChild()
			observing = child
			Compose.withOwner(child, function()
				local position, size = ctx.observe.AbsolutePosition(frame), ctx.observe.AbsoluteSize(frame)
				local origin, extent = ctx.observe.AbsolutePosition(layer), ctx.observe.AbsoluteSize(layer)
				local unit = ctx.layoutUnit(frame)
				Compose.watch(function(use: ComposeTypes.Use)
					local at, box, start, bounds = use(position), use(size), use(origin), use(extent)
					if box.X <= 0 or box.Y <= 0 or bounds.X <= 0 or bounds.Y <= 0 then
						clearance:set(nil)
						return
					end
					local scale = use(unit)
					local margins = read(authored, use)
					local function remaining(name: string, span: number, gap: number): number
						local inset = if type(margins) == "table"
							then ((margins :: { [string]: number })[name] or 0) * scale
							elseif margins == nil and distant(use) then span * FRACTION[name]
							else 0
						return if inset > 0 then math.max(0, inset - gap) / scale else 0
					end
					clearance:set({
						top = remaining("top", bounds.Y, at.Y - start.Y),
						left = remaining("left", bounds.X, at.X - start.X),
						bottom = remaining("bottom", bounds.Y, start.Y + bounds.Y - at.Y - box.Y),
						right = remaining("right", bounds.X, start.X + bounds.X - at.X - box.X),
					})
				end)
			end)
		end
		runtime.connect(frame, "AncestryChanged", locate)
		Compose.watch(function(use: ComposeTypes.Use)
			use(needsInsets)
			locate()
		end)
		return frame
	end)

	UI.ZStack = ctx.construct("ZStack", function(spec: LayoutProps.ZStackProps): Frame
		local properties, children = split(spec, { "padding", "width", "height", "alignH", "alignV" })
		local size, automatic = kit.extent(spec, "hug", "hug")
		local aligned = spec.alignH ~= nil or spec.alignV ~= nil
		local function fraction(value: Layout.Edge?): number
			assert(
				value == nil or value == "start" or value == "center" or value == "end",
				"Facet ZStack alignH and alignV must be start, center or end"
			)
			return if value == "center" then 0.5 elseif value == "end" then 1 else 0
		end
		local placed = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [GuiObject]: ComposeTypes.Cell<Vector2> }
		local members = Compose.cell(0)
		local function hugs(value: Layout.Extent?): boolean
			return value == nil or value == "hug"
		end
		local native: Engine.FrameNativeProps = {
			BorderSizePixel = 0,
			Size = size,
			AutomaticSize = automatic,
		}
		local frame = kit.plain(
			Host.Frame(kit.assemble(native, properties, { kit.insets(spec.padding) }, children, function(node, index)
				if node.ZIndex == 1 then
					node.ZIndex = index
				end
				if aligned then
					placed[node] = ctx.observe.AbsoluteSize(node)
					members:update(function(count: number): number
						return count + 1
					end)
				end
			end)),
			properties
		)
		if aligned then
			Compose.watch(function(use: ComposeTypes.Use)
				use(members)
				local x, y = fraction(read(spec.alignH, use)), fraction(read(spec.alignV, use))
				local wide, tall = hugs(read(spec.width, use)), hugs(read(spec.height, use))
				local nodes: { GuiObject } = {}
				local extents: { [GuiObject]: Vector2 } = {}
				local widest, tallest = 0, 0
				for node, observed in placed do
					if node.Parent == frame then
						local extent = use(observed)
						table.insert(nodes, node)
						extents[node] = extent
						widest = math.max(widest, extent.X)
						tallest = math.max(tallest, extent.Y)
					end
				end
				for _, node in nodes do
					local extent = extents[node]
					node.AnchorPoint = V2.new(if wide then 0 else x, if tall then 0 else y)
					node.Position = D2.new(
						if wide then 0 else x,
						if wide then math.floor(x * (widest - extent.X) + 0.5) else 0,
						if tall then 0 else y,
						if tall then math.floor(y * (tallest - extent.Y) + 0.5) else 0
					)
				end
			end)
		end
		return frame
	end)

	UI.ScrollView = ctx.construct("ScrollView", function(spec: LayoutProps.ScrollViewProps): ScrollingFrame
		local properties, children = split(spec, { "axis", "gap", "padding", "align", "distribute", "width", "height" })
		local axis = spec.axis or "y"
		assert(axis == "x" or axis == "y" or axis == "xy", "Facet ScrollView axis must be x, y or xy")
		local scaled = false
		local filling: { GuiObject } = {}
		for _, child in children do
			local node = child :: GuiObject
			local gui = (typeof(node) == "Instance" or type(node) == "table")
				and type(node.IsA) == "function"
				and node:IsA("GuiObject")
			if gui and node.Size.Y.Scale > 0 then
				scaled = true
				table.insert(filling, node)
			end
		end
		local size, automatic = kit.extent(spec, "fill", if axis == "x" and not scaled then "hug" else "fill")
		local native: Engine.ScrollingFrameNativeProps = {
			Active = true,
			BorderSizePixel = 0,
			Size = size,
			AutomaticSize = automatic,
			CanvasSize = D2.new(),
			AutomaticCanvasSize = if axis == "x"
				then E.AutomaticSize.X
				elseif axis == "y" then E.AutomaticSize.Y
				else E.AutomaticSize.XY,
			ScrollingDirection = if axis == "x"
				then E.ScrollingDirection.X
				elseif axis == "y" then E.ScrollingDirection.Y
				else E.ScrollingDirection.XY,
		}
		native.VerticalScrollBarInset = if axis == "x" then E.ScrollBarInset.ScrollBar else E.ScrollBarInset.Always
		if axis ~= "y" then
			native.HorizontalScrollBarInset = E.ScrollBarInset.ScrollBar
		end
		local flow: Types.Flow = { gap = spec.gap, align = spec.align, distribute = spec.distribute }
		local insets = kit.insets(spec.padding)
		local layout = kit.list(flow, axis ~= "x")
		local frame =
			kit.plain(Host.ScrollingFrame(kit.assemble(native, properties, { layout, insets }, children)), properties)
		scrollLock.own(frame, ctx)
		initialScroll(ctx, frame, spec.CanvasPosition)
		if axis == "x" and properties.CanvasSize == nil and properties.AutomaticCanvasSize == nil then
			local content = ctx.observe.AbsoluteContentSize(layout)
			local unit = ctx.layoutUnit(frame)
			local window = ctx.observe.AbsoluteWindowSize(frame)
			local observe = (ctx.observe :: unknown) :: {
				PaddingLeft: (UIPadding) -> ComposeTypes.Cell<UDim>,
				PaddingRight: (UIPadding) -> ComposeTypes.Cell<UDim>,
			}
			local left = if insets then observe.PaddingLeft(insets) else nil
			local right = if insets then observe.PaddingRight(insets) else nil
			local mode = ctx.observe.AutomaticSize(frame)
			local scrollStyle = (
				ctx.observeStyled :: unknown
			) :: { ScrollBarThickness: (ScrollingFrame) -> ComposeTypes.Cell<number> }
			local thickness = scrollStyle.ScrollBarThickness(frame)
			if frame:FindFirstChildWhichIsA("UISizeConstraint") == nil then
				runtime.mount(function()
					return Host.UISizeConstraint "ScrollBarRoom" {
						MinSize = function(use: ComposeTypes.Use): Vector2
							local free = use(mode) == E.AutomaticSize.Y or use(mode) == E.AutomaticSize.XY
							local scale = use(unit)
							local extent, viewport = use(content), use(window)
							return V2.new(
								0,
								if free
										and extent.X > viewport.X
										and viewport.X > 0
									then math.ceil(extent.Y / scale) + use(thickness)
									else 0
							)
						end,
					}
				end, frame)
			end
			runtime.decorate(frame, {
				CanvasSize = function(use: ComposeTypes.Use): UDim2
					local scale = use(unit)
					local extent = use(content).X / scale
					local width = use(window).X / scale
					for _, side in { left, right } do
						if side then
							local padding: UDim = use(side)
							extent += padding.Offset + padding.Scale * width
						end
					end
					return D2.fromOffset(math.ceil(extent), 0)
				end,
			})
		end
		if axis ~= "x" and #filling > 0 then
			local window = ctx.layoutSize(frame)
			local top, bottom = Compose.cell(0), Compose.cell(0)
			if insets then
				local padTop, padBottom = ctx.observe.PaddingTop(insets), ctx.observe.PaddingBottom(insets)
				Compose.watch(function(use: ComposeTypes.Use)
					top:set(use(padTop).Offset)
					bottom:set(use(padBottom).Offset)
				end)
			end
			local frames = runtime.host.frames
			for _, node in filling do
				local size, automatic = node.Size, node.AutomaticSize
				local layout = node:FindFirstChildWhichIsA("UIListLayout")
				if node:IsA("Frame") and layout and layout.FillDirection == E.FillDirection.Vertical then
					automatic = if automatic == E.AutomaticSize.X or automatic == E.AutomaticSize.XY
						then E.AutomaticSize.XY
						else E.AutomaticSize.Y
					node.AutomaticSize = automatic
					local flex = node:FindFirstChildWhichIsA("UIFlexItem")
					if flex then
						if flex.FlexMode == E.UIFlexMode.Fill then
							flex.FlexMode = E.UIFlexMode.Grow
						elseif flex.FlexMode == E.UIFlexMode.Custom then
							flex.ShrinkRatio = 0
						end
					end
				end
				local rest = D2.new(size.X.Scale, size.X.Offset, 0, size.Y.Offset)
				local written = rest
				local authored = false
				node.Size = rest
				local floor = Compose.formula(function(use: ComposeTypes.Use): number
					local room = use(window).Y - use(top) - use(bottom)
					return math.max(0, size.Y.Scale * room + size.Y.Offset)
				end)
				local constraint = node:FindFirstChildWhichIsA("UISizeConstraint")
				if constraint then
					local minimum = constraint.MinSize
					runtime.decorate(constraint, {
						MinSize = function(use: ComposeTypes.Use): Vector2
							return V2.new(minimum.X, math.max(minimum.Y, use(floor)))
						end,
					})
				else
					runtime.mount(function()
						return Host.UISizeConstraint({
							MinSize = function(use: ComposeTypes.Use): Vector2
								return V2.new(0, use(floor))
							end,
						})
					end, node)
				end
				local observed = ctx.observe.Size(node)
				Compose.watch(function(use: ComposeTypes.Use)
					if use(observed) ~= written then
						authored = true
					end
				end)
				if frames and (automatic == E.AutomaticSize.Y or automatic == E.AutomaticSize.XY) then
					local last, settling: (() -> ())? = 0, nil
					Compose.watch(function(use: ComposeTypes.Use)
						local now = use(floor)
						if now < last and settling == nil and not authored then
							local scrolled, step = frame.CanvasPosition, 0
							node.AutomaticSize = E.AutomaticSize.None
							written = D2.new(size.X.Scale, size.X.Offset, 0, now)
							node.Size = written
							settling = frames.onFrame(function()
								step += 1
								if step == 1 then
									if not authored then
										written = rest
										node.AutomaticSize, node.Size = automatic, rest
									end
									return
								end
								if settling then
									settling()
									settling = nil
								end
								frame.CanvasPosition = scrolled
							end)
						end
						last = now
					end)
					Compose.cleanup(function()
						if settling then
							settling()
						end
					end)
				end
			end
		end
		return frame
	end)

	UI.Grid = ctx.construct("Grid", function(spec: LayoutProps.GridProps): Frame
		local properties, children = split(
			spec,
			{ "columns", "flow", "gap", "rowGap", "cellHeight", "aspectRatio", "align", "padding", "width", "height" }
		)
		local size, automatic = kit.extent(spec, "fill", "hug")
		local flow = spec.flow or "row"
		assert(flow == "row" or flow == "column", "Facet Grid flow must be row or column")
		local cells = Compose.cell(0)
		local function columns(use: ComposeTypes.Use?): number
			local count = read(spec.columns, use)
			assert(
				type(count) == "number" and count >= 1 and count % 1 == 0,
				"Facet Grid columns must be a whole number, 1 or more"
			)
			return count
		end
		local layout: Engine.UIGridLayoutNativeProps = {
			SortOrder = E.SortOrder.LayoutOrder,
			FillDirection = if flow == "column" then E.FillDirection.Vertical else E.FillDirection.Horizontal,
			FillDirectionMaxCells = function(use: ComposeTypes.Use): number
				local count = columns(use)
				if flow == "column" then
					return math.max(1, math.ceil(use(cells) / count))
				end
				return count
			end,
			CellPadding = function(use: ComposeTypes.Use): UDim2
				local gap = kit.spacing(spec.gap, use)
				return D2.fromOffset(gap, if spec.rowGap == nil then gap else kit.spacing(spec.rowGap, use))
			end,
			CellSize = function(use: ComposeTypes.Use): UDim2
				local count = columns(use)
				local gap = kit.spacing(spec.gap, use)
				local height = read(spec.cellHeight, use)
				return D2.new(
					1 / count,
					-math.ceil(gap * (count - 1) / count),
					0,
					if height == nil then ctx.controlSize(ctx.config.controlSize, "height", use) else height
				)
			end,
		}
		if spec.align ~= nil then
			layout.HorizontalAlignment = function(use: ComposeTypes.Use): Enum.HorizontalAlignment
				local value = read(spec.align, use)
				assert(
					value == "start" or value == "center" or value == "end",
					"Facet Grid align must be start, center or end"
				)
				return if value == "center"
					then E.HorizontalAlignment.Center
					elseif value == "end" then E.HorizontalAlignment.Right
					else E.HorizontalAlignment.Left
			end
		end
		if spec.aspectRatio ~= nil then
			layout[1] = Host.UIAspectRatioConstraint({ AspectRatio = spec.aspectRatio })
		end
		local native: Engine.FrameNativeProps = {
			BorderSizePixel = 0,
			Size = size,
			AutomaticSize = automatic,
		}
		local node = kit.plain(
			Host.Frame(
				kit.assemble(native, properties, { Host.UIGridLayout(layout), kit.insets(spec.padding) }, children)
			),
			properties
		)
		if flow == "column" then
			local function count()
				local total = 0
				for _, child in node:GetChildren() do
					if child:IsA("GuiObject") then
						total += 1
					end
				end
				cells:set(total)
			end
			runtime.connect(node, "ChildAdded", count)
			runtime.connect(node, "ChildRemoved", count)
			count()
		end

		local forward = if flow == "column" then "NextSelectionRight" else "NextSelectionDown"
		local clamped = setmetatable({} :: { [GuiObject]: boolean }, { __mode = "k" })
		local revision = Compose.cell(0)
		local function bump()
			revision:set(revision:peek() + 1)
		end
		runtime.connect(node, "ChildAdded", bump)
		runtime.connect(node, "ChildRemoved", bump)
		local function selectable(cell: GuiObject): GuiObject?
			if cell.Selectable then
				return cell
			end
			for _, inner in cell:GetDescendants() do
				if inner:IsA("GuiObject") and inner.Selectable then
					return inner
				end
			end
			return nil
		end
		Compose.watch(function(use: ComposeTypes.Use)
			use(revision)
			local list: { GuiObject } = {}
			local index: { [GuiObject]: number } = {}
			for position, child in node:GetChildren() do
				if child:IsA("GuiObject") and child.Visible then
					table.insert(list, child)
					index[child] = position
				end
			end
			table.sort(list, function(a: GuiObject, b: GuiObject): boolean
				return if a.LayoutOrder ~= b.LayoutOrder then a.LayoutOrder < b.LayoutOrder else index[a] < index[b]
			end)
			local total = #list
			local lanes = columns(use)
			if flow == "column" then
				lanes = math.max(1, math.ceil(total / lanes))
			end
			local lines = math.ceil(total / lanes)
			local short = total - (lines - 1) * lanes
			local last = if lines >= 2 and short < lanes then selectable(list[total]) else nil
			for position, cell in list do
				local target = selectable(cell)
				if target then
					local line, lane = (position - 1) // lanes + 1, (position - 1) % lanes + 1
					local fields = (
						target :: unknown
					) :: { NextSelectionDown: GuiObject?, NextSelectionRight: GuiObject? }
					if last and line == lines - 1 and lane > short then
						if fields[forward] == nil or clamped[target] then
							fields[forward] = last
							clamped[target] = true
						end
					elseif clamped[target] then
						fields[forward] = nil
						clamped[target] = nil
					end
				end
			end
		end)
		return node
	end)

	local function scrolls(holder: Instance?, horizontal: boolean): boolean
		if holder == nil or not holder:IsA("ScrollingFrame") then
			return false
		end
		local direction = (holder :: ScrollingFrame).ScrollingDirection
		return direction == E.ScrollingDirection.XY
			or direction == (if horizontal then E.ScrollingDirection.X else E.ScrollingDirection.Y)
	end
	local function tracked(
		node: GuiObject,
		sizes: { [GuiObject]: ComposeTypes.Cell<Vector2> },
		parents: { [GuiObject]: ComposeTypes.Cell<Instance?> },
		members: ComposeTypes.Cell<number>
	)
		sizes[node] = ctx.observe.AbsoluteSize(node)
		parents[node] = ctx.observe.Parent(node)
		members:update(function(count: number): number
			return count + 1
		end)
	end

	UI.AdaptiveStack = ctx.construct("AdaptiveStack", function(spec: LayoutProps.AdaptiveStackProps): Frame
		local properties, children = split(spec, { "axis", "gap", "padding", "align", "distribute", "width", "height" })
		local flow: Types.Flow = {
			gap = spec.gap,
			padding = spec.padding,
			align = spec.align,
			distribute = spec.distribute,
			width = spec.width,
			height = spec.height,
		}
		local axis = spec.axis
		if axis ~= nil then
			local function column(use: ComposeTypes.Use?): boolean
				local value = read(axis, use)
				assert(value == "x" or value == "y", "Facet AdaptiveStack axis must be x or y")
				return value == "y"
			end
			local vertical: Types.Value<boolean> = if Compose.isReadable(axis) or type(axis) == "function"
				then column
				else column(nil)
			return kit.stack(children, (properties :: unknown) :: Engine.FrameNativeProps, flow, vertical)
		end
		local vertical = Compose.cell(false)
		local sizes = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [GuiObject]: ComposeTypes.Cell<Vector2> }
		local parents = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [GuiObject]: ComposeTypes.Cell<Instance?> }
		local shown = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [GuiObject]: ComposeTypes.Cell<boolean> }
		local members = Compose.cell(0)
		local size, automatic = kit.extent(flow, "fill", "hug")
		local layout = kit.list(flow, vertical)
		local native: Engine.FrameNativeProps = {
			BorderSizePixel = 0,
			Size = size,
			AutomaticSize = automatic,
		}
		local node = kit.plain(
			Host.Frame(kit.assemble(native, properties, { layout, kit.insets(spec.padding) }, children, function(child)
				shown[child] = ctx.observe.Visible(child)
				tracked(child, sizes, parents, members)
			end)),
			properties
		)
		local box, holder, content =
			ctx.observe.AbsoluteSize(node), ctx.observe.Parent(node), ctx.observe.AbsoluteContentSize(layout)
		local rowNeed, lastCount = 0, 0
		local retried: string?, refused: string? = nil, nil
		Compose.watch(function(use: ComposeTypes.Use)
			use(members)
			local width, row = use(box).X, use(content).X
			if scrolls(use(holder), true) then
				vertical:set(false)
				return
			end
			local padding = node:FindFirstChildWhichIsA("UIPadding")
			local offered = if padding then width - padding.PaddingLeft.Offset - padding.PaddingRight.Offset else width
			local count, total = 0, 0
			for child, extent in sizes do
				if use(parents[child]) == node and use(shown[child]) then
					count += 1
					if child.Size.X.Scale == 0 and child:FindFirstChildWhichIsA("UIFlexItem") == nil then
						total += use(extent).X
					end
				end
			end
			local key = `{total}/{count}/{offered}`
			if not vertical:peek() then
				rowNeed = row
				if rowNeed > offered then
					refused = retried
				end
			elseif read(spec.align, use) ~= "stretch" then
				rowNeed = if key == refused
					then math.huge
					else total + kit.spacing(spec.gap, use) * math.max(count - 1, 0)
			elseif count ~= lastCount then
				rowNeed = 0
			end
			lastCount = count
			if width > 0 then
				if vertical:peek() and rowNeed <= offered then
					retried = key
				end
				vertical:set(rowNeed > offered)
			end
		end)
		return node
	end)

	UI.ViewThatFits = ctx.construct("ViewThatFits", function(spec: LayoutProps.ViewThatFitsProps): Frame
		local properties, children = split(spec, { "width", "height" })
		assert(#children > 0, "Facet ViewThatFits needs at least one candidate")
		local sizes = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [GuiObject]: ComposeTypes.Cell<Vector2> }
		local parents = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [GuiObject]: ComposeTypes.Cell<Instance?> }
		local members = Compose.cell(0)
		local box: Types.Box = { width = spec.width, height = spec.height }
		local size, automatic = kit.extent(box, "fill", "hug")
		local native: Engine.FrameNativeProps = {
			BorderSizePixel = 0,
			Size = size,
			AutomaticSize = automatic,
		}
		local node = kit.plain(
			Host.Frame(kit.assemble(native, properties, { kit.list({}, true) }, children, function(child)
				tracked(child, sizes, parents, members)
			end)),
			properties
		)
		if #children == 1 then
			return node
		end
		local offered, holder = ctx.observe.AbsoluteSize(node), ctx.observe.Parent(node)
		Compose.watch(function(use: ComposeTypes.Use)
			use(members)
			local offer, parent = use(offered), use(holder)
			local openX = read(spec.width, use) == "hug" or offer.X <= 0 or scrolls(parent, true)
			local height = read(spec.height, use)
			local openY = height == nil or height == "hug" or offer.Y <= 0 or scrolls(parent, false)
			local candidates: { GuiObject } = {}
			for child in sizes do
				if use(parents[child]) == node then
					table.insert(candidates, child)
				end
			end
			table.sort(candidates, function(a, b)
				return a.LayoutOrder < b.LayoutOrder
			end)
			local winner = candidates[#candidates]
			for _, child in candidates do
				local extent = use(sizes[child])
				if (openX or extent.X <= offer.X) and (openY or extent.Y <= offer.Y) then
					winner = child
					break
				end
			end
			for _, child in candidates do
				child.Visible = child == winner
			end
		end)
		return node
	end)

	UI.ErrorBoundary = ctx.construct("ErrorBoundary", function(spec: LayoutProps.ErrorBoundaryProps): Frame
		assert(type(spec.view) == "function", "Facet ErrorBoundary requires a view function")
		assert(type(spec.fallback) == "function", "Facet ErrorBoundary requires a fallback function")
		local properties = containerProps(spec, { "view", "fallback", "onError", "width", "height" })
		local box: Types.Box = { width = spec.width, height = spec.height }
		local size, automatic = kit.extent(box, "hug", "hug")
		local failed: ComposeTypes.Cell<string?> = Compose.cell(nil :: string?)
		local native: Engine.FrameNativeProps = {
			BorderSizePixel = 0,
			Size = size,
			AutomaticSize = automatic,
		}
		local region = Compose.boundary(function()
			failed:set(nil)
			return (spec.view() :: unknown) :: ComposeTypes.Node
		end, function(failure: unknown, retry: () -> ())
			failed:set(tostring(failure))
			local report: ((unknown) -> ())? = spec.onError or ctx.config.onError
			if report then
				report(failure)
			end
			return (spec.fallback(failure, retry) :: unknown) :: ComposeTypes.Node
		end)
		local root = kit.plain(Host.Frame(kit.assemble(native, properties, {}, { region })), properties)
		Compose.watch(function(use: ComposeTypes.Use)
			root:SetAttribute("FacetError", use(failed))
		end)
		return root
	end)

	local function stackAxis(node: Frame, axis: ("x" | "y")?): (ComposeTypes.Use) -> "x" | "y"
		if axis ~= nil then
			assert(axis == "x" or axis == "y", "Facet axis must be x or y")
			return function(): "x" | "y"
				return axis
			end
		end
		local direction: ComposeTypes.Cell<"x" | "y"> = Compose.cell("y" :: "x" | "y")
		local connections: { RBXScriptConnection } = {}
		local function release()
			for _, connection in connections do
				connection:Disconnect()
			end
			table.clear(connections)
		end
		local function attach()
			release()
			local holder = node.Parent
			if holder == nil then
				return
			end
			local layout = holder:FindFirstChildWhichIsA("UIListLayout")
			if layout == nil then
				table.insert(connections, holder.ChildAdded:Connect(attach))
				direction:set("y")
				return
			end
			local function update()
				direction:set(if layout.FillDirection == E.FillDirection.Horizontal then "x" else "y")
			end
			table.insert(connections, layout:GetPropertyChangedSignal("FillDirection"):Connect(update))
			update()
		end
		runtime.connect(node, "AncestryChanged", attach)
		Compose.cleanup(release)
		attach()
		return function(use: ComposeTypes.Use): "x" | "y"
			return if use(direction) == "x" then "x" else "y"
		end
	end

	UI.Divider = ctx.construct("Divider", function(spec: LayoutProps.DividerProps): Frame
		local thickness = spec.thickness
		assert(
			thickness == nil or type(thickness) == "string" or (type(thickness) == "number" and thickness > 0),
			"Facet Divider thickness must be a positive number or a theme metric name"
		)
		local function weight(use: ComposeTypes.Use?): number
			if type(thickness) == "number" then
				return thickness
			end
			local path = if type(thickness) == "string" then thickness else "strokes.hairline"
			return if string.find(path, ".", 1, true) then ctx.metric(path, use) else kit.spacing(path, use)
		end
		local native: Engine.FrameNativeProps = {
			Name = "Divider",
			BorderSizePixel = 0,
		}
		local node = ctx.styled(Host.Frame(ctx.props(spec, { "axis", "thickness", "appearance" }, native)), "divider")
		local along = stackAxis(node, spec.axis)
		if spec.Size == nil then
			runtime.decorate(node, {
				Size = function(use: ComposeTypes.Use): UDim2
					local pixels = weight(use)
					return if along(use) == "x" then D2.new(0, pixels, 1, 0) else D2.new(1, 0, 0, pixels)
				end,
			})
		end
		Compose.watch(function(use: ComposeTypes.Use)
			local appearance = read(spec.appearance, use) or "standard"
			assert(
				appearance == "standard" or appearance == "strong",
				"Facet Divider appearance must be standard or strong"
			)
			if appearance == "strong" then
				node:AddTag("facet-divider-strong")
			elseif node:HasTag("facet-divider-strong") then
				node:RemoveTag("facet-divider-strong")
			end
		end)
		return node
	end)

	UI.Spacer = ctx.construct("Spacer", function(spec: LayoutProps.SpacerProps): Frame
		local native: Engine.FrameNativeProps = {
			Name = "Spacer",
			BorderSizePixel = 0,
			Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }),
		}
		local node = kit.plain(Host.Frame(ctx.props(spec, { "minLength" }, native)), spec)
		local along = stackAxis(node, nil)
		if spec.Size == nil then
			runtime.decorate(node, {
				Size = function(use: ComposeTypes.Use): UDim2
					local floor = kit.spacing(spec.minLength, use)
					return if along(use) == "x" then D2.fromOffset(floor, 0) else D2.fromOffset(0, floor)
				end,
			})
		end
		return node
	end)

	UI.fill = function(weight: number?): UIFlexItem
		if weight == nil then
			return Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill })
		end
		assert(type(weight) == "number" and weight > 0, "Facet fill weight must be a positive number")
		return Host.UIFlexItem({ FlexMode = E.UIFlexMode.Custom, GrowRatio = weight, ShrinkRatio = weight })
	end

	return UI
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="119">
            <Properties>
              <string name="Name">layout_kit</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local bindThemes = require("./themes")
local Shared = require("./types")
local Theme = require("./theme_types")

export type Place = (GuiObject, number) -> ()
export type Kit = {
	spacing: (Shared.Value<Shared.Space>?, ComposeTypes.Use?) -> number,
	insets: (Shared.Value<Shared.Padding>?) -> UIPadding?,
	extent: (Shared.Box, Shared.Extent, Shared.Extent) -> (Shared.Value<UDim2>, Shared.Value<Enum.AutomaticSize>),
	list: (Shared.Flow, Shared.Value<boolean>) -> UIListLayout,
	underTopbar: (GuiObject, ComposeTypes.Cell<number>) -> (),
	ordered: ({ ComposeTypes.Child }, Place?) -> { ComposeTypes.Child },
	assemble: <P>(P, unknown?, { Instance? }, { ComposeTypes.Child }, Place?) -> P,
	plain: <N>(N & Instance, unknown?) -> N & Instance,
	stack: (
		{ ComposeTypes.Child },
		Shared.FrameNativeProps?,
		Shared.Flow,
		Shared.Value<boolean>,
		Shared.Extent?,
		Shared.Extent?
	) -> Frame,
}

local layoutKit = {}

function layoutKit.of(ctx: Shared.Context): Kit
	return (assert(ctx.layoutKit :: Kit?, "Facet layout requires a controls context"))
end

function layoutKit.attach(ctx: Shared.Context): Kit
	local Host, read, types, config, Compose, runtime =
		ctx.Host, ctx.read, ctx.types, ctx.config, ctx.Compose, ctx.runtime
	local themes = bindThemes(Compose)
	local Enum = types.Enum
	local kit = {} :: Kit
	local function live(value: unknown): boolean
		return Compose.isReadable(value) or type(value) == "function"
	end
	local function derive<T>(compute: (ComposeTypes.Use?) -> T, ...: unknown): Shared.Value<T>
		for index = 1, select("#", ...) do
			if live((select(index, ...))) then
				return function(use: ComposeTypes.Use): T
					return compute(use)
				end
			end
		end
		return compute(nil)
	end
	function kit.spacing(value: Shared.Value<Shared.Space>?, use: ComposeTypes.Use?): number
		local step = read(value, use)
		if step == nil then
			return 0
		end
		if type(step) == "number" then
			assert(step >= 0 and step < math.huge, "Facet spacing must be a finite number of pixels, 0 or more")
			return step
		end
		assert(type(step) == "string", "Facet spacing must be a number or a spacing step")
		local package: Theme.ThemePackage? = read(config.theme, use)
		local space: { [string]: number } = if package and type(package.metrics.space) == "table"
			then package.metrics.space
			else ctx.neutralMetrics(use).space
		local pixels: number? = space[step] or ctx.neutralMetrics(use).space[step]
		assert(
			type(pixels) == "number",
			`Facet spacing step "{step}" is not in the theme; use xs, s, m, l, xl or a number`
		)
		return pixels
	end
	local function spacingValue(value: Shared.Value<Shared.Space>?): Shared.Value<UDim>
		return derive(function(use)
			return types.UDim.new(0, kit.spacing(value, use))
		end, value, if type(read(value)) == "string" then config.theme else nil)
	end
	function kit.insets(padding: Shared.Value<Shared.Padding>?): UIPadding?
		if padding == nil then
			return nil
		end
		local function side(name: "top" | "right" | "bottom" | "left"): Shared.Value<UDim>
			local function pick(use: ComposeTypes.Use?): Shared.Space?
				local value = read(padding, use)
				if type(value) == "table" then
					local sides = value :: Shared.Sides
					return if name == "top"
						then sides.top
						elseif name == "right" then sides.right
						elseif name == "bottom" then sides.bottom
						else sides.left
				end
				return value
			end
			return derive(function(use)
				local value: unknown = pick(use)
				if typeof(value) == "UDim" then
					return value :: UDim
				end
				return types.UDim.new(0, kit.spacing(value :: Shared.Space?, use))
			end, padding, if type(pick(nil)) == "string" then config.theme else nil)
		end
		return Host.UIPadding({
			PaddingTop = side("top"),
			PaddingRight = side("right"),
			PaddingBottom = side("bottom"),
			PaddingLeft = side("left"),
		})
	end
	local function valid(value: unknown, names: { [string]: boolean }): boolean
		return type(value) == "string" and names[value] == true
	end
	local extents = { fill = true, hug = true }
	local function checked(value: Shared.Extent): Shared.Extent
		assert(
			valid(value, extents) or (type(value) == "number" and value >= 0),
			"Facet width and height must be fill, hug or a number of pixels"
		)
		return value
	end
	function kit.extent(
		box: Shared.Box,
		width: Shared.Extent,
		height: Shared.Extent
	): (Shared.Value<UDim2>, Shared.Value<Enum.AutomaticSize>)
		local function resolve(use: ComposeTypes.Use?): (Shared.Extent, Shared.Extent)
			local w: Shared.Extent? = read(box.width, use)
			local h: Shared.Extent? = read(box.height, use)
			return checked(if w == nil then width else w), checked(if h == nil then height else h)
		end
		local function scale(value: Shared.Extent): number
			return if value == "fill" then 1 else 0
		end
		local function offset(value: Shared.Extent): number
			return if type(value) == "number" then value else 0
		end
		return derive(function(use)
			local w: Shared.Extent, h: Shared.Extent = resolve(use)
			return types.UDim2.new(scale(w), offset(w), scale(h), offset(h))
		end, box.width, box.height),
			derive(function(use)
				local w: Shared.Extent, h: Shared.Extent = resolve(use)
				local wide, tall = w == "hug", h == "hug"
				return if wide and tall
					then Enum.AutomaticSize.XY
					elseif wide then Enum.AutomaticSize.X
					elseif tall then Enum.AutomaticSize.Y
					else Enum.AutomaticSize.None
			end, box.width, box.height)
	end
	local function edge<T>(value: Shared.Align | Shared.Distribute, start: T, center: T, finish: T): T
		return if value == "center" then center elseif value == "end" then finish else start
	end
	function kit.list(flow: Shared.Flow, vertical: Shared.Value<boolean>): UIListLayout
		local function column(use: ComposeTypes.Use?): boolean
			return read(vertical, use) == true
		end
		local steady = not live(vertical)
		local function uses(onColumn: unknown, onRow: unknown): boolean
			if steady then
				return if column(nil) then onColumn ~= nil else onRow ~= nil
			end
			return onColumn ~= nil or onRow ~= nil
		end
		local native: Shared.UIListLayoutNativeProps = {
			FillDirection = derive(function(use)
				return if column(use) then Enum.FillDirection.Vertical else Enum.FillDirection.Horizontal
			end, vertical),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}
		if flow.gap ~= nil then
			native.Padding = spacingValue(flow.gap)
		end
		if flow.wrap ~= nil then
			native.Wraps = flow.wrap
		end
		local H, V = Enum.HorizontalAlignment, Enum.VerticalAlignment
		local function align(use: ComposeTypes.Use?): Shared.Align
			local value: Shared.Align? = read(flow.align, use)
			assert(
				value == nil or valid(value, { start = true, center = true, ["end"] = true, stretch = true }),
				"Facet align must be start, center, end or stretch"
			)
			return if value == nil then "start" else value
		end
		local spread = {
			spaceBetween = Enum.UIFlexAlignment.SpaceBetween,
			spaceAround = Enum.UIFlexAlignment.SpaceAround,
			spaceEvenly = Enum.UIFlexAlignment.SpaceEvenly,
		}
		local function distribute(use: ComposeTypes.Use?): Shared.Distribute
			local value: Shared.Distribute? = read(flow.distribute, use)
			assert(
				value == nil
					or valid(value, { start = true, center = true, ["end"] = true })
					or valid(value, { spaceBetween = true, spaceAround = true, spaceEvenly = true }),
				"Facet distribute must be start, center, end, spaceBetween, spaceAround or spaceEvenly"
			)
			return if value == nil then "start" else value
		end
		if uses(flow.align, flow.distribute) then
			native.HorizontalAlignment = derive(function(use)
				return edge(if column(use) then align(use) else distribute(use), H.Left, H.Center, H.Right)
			end, vertical, flow.align, flow.distribute)
		end
		if uses(flow.distribute, flow.align) then
			native.VerticalAlignment = derive(function(use)
				return edge(if column(use) then distribute(use) else align(use), V.Top, V.Center, V.Bottom)
			end, vertical, flow.align, flow.distribute)
		end
		local cross = if flow.align ~= nil and (live(flow.align) or align(nil) == "stretch") then flow.align else nil
		local main = if flow.distribute ~= nil and (live(flow.distribute) or spread[distribute(nil)])
			then flow.distribute
			else nil
		if cross ~= nil then
			native.ItemLineAlignment = derive(function(use)
				return if align(use) == "stretch"
					then Enum.ItemLineAlignment.Stretch
					else Enum.ItemLineAlignment.Automatic
			end, flow.align)
		end
		local function flex(use: ComposeTypes.Use?, stretching: boolean): Enum.UIFlexAlignment
			if stretching then
				return if cross ~= nil and align(use) == "stretch"
					then Enum.UIFlexAlignment.Fill
					else Enum.UIFlexAlignment.None
			end
			return if main ~= nil
				then spread[distribute(use)] or Enum.UIFlexAlignment.None
				else Enum.UIFlexAlignment.None
		end
		if uses(cross, main) then
			native.HorizontalFlex = derive(function(use)
				return flex(use, column(use))
			end, vertical, cross, main)
		end
		if uses(main, cross) then
			native.VerticalFlex = derive(function(use)
				return flex(use, not column(use))
			end, vertical, cross, main)
		end
		return Host.UIListLayout(native)
	end

	local SPAN = 65536
	function kit.ordered(children: { ComposeTypes.Child }, place: ((GuiObject, number) -> ())?): { ComposeTypes.Child }
		local spaced = false
		for _, child in children do
			spaced = spaced or type(child) == "function"
		end
		local result: { ComposeTypes.Child } = {}
		for index, child in children do
			local base = if spaced then index * SPAN else index
			if type(child) == "function" then
				local directive = child :: ComposeTypes.Directive
				result[index] = function(mountPoint: ComposeTypes.MountPoint)
					local slot: { Instance } = {}
					local stamped: { [Instance]: number } = {}
					local own: { [Instance]: number } = {}
					local watches: { [Instance]: RBXScriptConnection } = {}
					local function restamp()
						for at, node in slot do
							if node:IsA("GuiObject") then
								local order = base + (own[node] or at)
								stamped[node] = order;
								(node :: GuiObject).LayoutOrder = order
							end
						end
					end
					local function forget(node: Instance)
						local found = table.find(slot, node)
						if found then
							table.remove(slot, found)
						end
						if watches[node] then
							watches[node]:Disconnect()
						end
						watches[node], stamped[node], own[node] = nil, nil, nil
					end
					Compose.cleanup(function()
						for node in watches do
							forget(node)
						end
					end)
					directive({
						parent = mountPoint.parent,
						host = mountPoint.host,
						ordersChildren = true,
						count = mountPoint.count,
						insert = function(node: unknown, at: number?)
							local gui = node :: Instance
							table.insert(slot, at or #slot + 1, gui)
							if gui:IsA("GuiObject") then
								local authored = (gui :: GuiObject).LayoutOrder
								if authored ~= 0 then
									own[gui] = authored
								end
								watches[gui] = gui:GetPropertyChangedSignal("LayoutOrder"):Connect(function()
									local order = (gui :: GuiObject).LayoutOrder
									if order ~= stamped[gui] then
										own[gui] = order
										restamp()
									end
								end)
								if place then
									place(gui :: GuiObject, index)
								end
							end
							restamp()
							mountPoint.insert(node, at)
						end,
						moveTo = function(node: unknown, at: number)
							table.remove(slot, assert(table.find(slot, node :: Instance)))
							table.insert(slot, at, node :: Instance)
							restamp()
							if mountPoint.ordersChildren then
								mountPoint.moveTo(node, at)
							end
						end,
						remove = function(node: unknown)
							forget(node :: Instance)
							mountPoint.remove(node)
							restamp()
						end,
					})
				end
			else
				if (child :: Instance):IsA("GuiObject") then
					local gui = child :: GuiObject
					gui.LayoutOrder = base
					if place then
						place(gui, index)
					end
				end
				result[index] = child
			end
		end
		return result
	end
	function kit.assemble<P>(
		native: P,
		properties: unknown?,
		helpers: { Instance? },
		children: { ComposeTypes.Child },
		place: ((GuiObject, number) -> ())?
	): P
		local fields = (native :: unknown) :: { [unknown]: unknown }
		for index = 1, #helpers do
			local helper = helpers[index]
			if helper then
				fields[#fields + 1] = helper
			end
		end
		for key, value in ((properties or {}) :: unknown) :: { [unknown]: unknown } do
			if type(key) == "number" then
				fields[#fields + 1] = value
			else
				fields[key] = value
			end
		end
		for _, child in kit.ordered(children, place) do
			fields[#fields + 1] = child
		end
		return native
	end

	function kit.plain<N>(node: N & Instance, properties: unknown?): N & Instance
		if ((properties or {}) :: { BackgroundTransparency: unknown? }).BackgroundTransparency == nil then
			node:AddTag("facet-layout")
		end
		return node
	end
	function kit.stack(
		children: { ComposeTypes.Child },
		properties: Shared.FrameNativeProps?,
		flow: Shared.Flow,
		vertical: Shared.Value<boolean>,
		width: Shared.Extent?,
		height: Shared.Extent?
	): Frame
		local size, automatic = kit.extent(flow, width or "hug", height or "hug")
		local native: Shared.FrameNativeProps = {
			BorderSizePixel = 0,
			Size = size,
			AutomaticSize = automatic,
		}
		return kit.plain(
			Host.Frame(
				kit.assemble(native, properties, { kit.list(flow, vertical), kit.insets(flow.padding) }, children)
			),
			properties
		)
	end
	function kit.underTopbar(frame: GuiObject, under: ComposeTypes.Cell<number>)
		local gui = config.guiService
		if gui == nil then
			return
		end
		local topbar, position, parent =
			ctx.observe.TopbarInset(gui), ctx.observe.AbsolutePosition(frame), ctx.observe.Parent(frame)
		local function measure()
			local band, top = gui.TopbarInset, frame.AbsolutePosition.Y
			local ok, inset = pcall(gui.GetGuiInset, gui)
			under:set(
				if typeof(band) == "Rect" and frame:FindFirstAncestorWhichIsA("ScreenGui")
					then math.max(0, band.Max.Y - (if ok and typeof(inset) == "Vector2" then inset.Y else 0) - top)
					else 0
			)
		end
		Compose.watch(function(use: ComposeTypes.Use)
			use(parent)
			use(topbar)
			use(position)
			measure()
		end)
		local frames = config.services and config.services.RunService
		if frames then
			runtime.connect(frames, "Heartbeat", measure)
		end
	end
	ctx.layoutKit = kit
	return kit
end

return layoutKit
]]></string>
