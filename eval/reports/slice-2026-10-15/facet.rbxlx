          <Item class="ModuleScript" referent="159">
            <Properties>
              <string name="Name">nav_path_shapes</string>
              <string name="Source"><![CDATA[--!strict

local path_shapes = {}

export type PathPoint = { x: number, y: number, inX: number, inY: number, outX: number, outY: number }

local MAX_CONTROL_POINTS = 100
path_shapes.MAX_CONTROL_POINTS = MAX_CONTROL_POINTS

function path_shapes.arc(
	startDeg: number,
	sweepDeg: number,
	opts: { segments: number?, radius: number? }?
): { PathPoint }
	local segments = (opts and opts.segments) or math.max(2, math.ceil(math.abs(sweepDeg) / 45))
	assert(segments + 1 <= MAX_CONTROL_POINTS, "path_shapes.arc: segment count exceeds the engine's 100-point limit")
	local radius = 0.5 * ((opts and opts.radius) or 1)
	local cx, cy = 0.5, 0.5
	sweepDeg = math.clamp(sweepDeg, -360, 360)
	local thetaSeg = math.rad(sweepDeg / segments)

	local handleLen = (4 / 3) * math.tan(math.abs(thetaSeg) / 4) * radius
	local dirSign = if sweepDeg >= 0 then 1 else -1
	local points: { PathPoint } = {}
	for i = 0, segments do
		local aDeg = startDeg + sweepDeg * (i / segments)
		local a = math.rad(aDeg)

		local px = cx + radius * math.sin(a)
		local py = cy - radius * math.cos(a)

		local dx = math.cos(a) * dirSign
		local dy = math.sin(a) * dirSign
		table.insert(points, {
			x = px,
			y = py,
			inX = -dx * handleLen,
			inY = -dy * handleLen,
			outX = dx * handleLen,
			outY = dy * handleLen,
		})
	end
	return points
end

function path_shapes.ring(opts: { radius: number? }?): { PathPoint }
	return path_shapes.arc(0, 360, { segments = 8, radius = opts and opts.radius })
end

function path_shapes.needle(angleDeg: number, opts: { innerRadius: number?, radius: number? }?): { PathPoint }
	local rOuter = 0.5 * ((opts and opts.radius) or 1)
	local rInner = 0.5 * ((opts and opts.innerRadius) or 0)
	local a = math.rad(angleDeg)
	local cx, cy = 0.5, 0.5
	local function pt(r: number): PathPoint
		return { x = cx + r * math.sin(a), y = cy - r * math.cos(a), inX = 0, inY = 0, outX = 0, outY = 0 }
	end
	return { pt(rInner), pt(rOuter) }
end

return table.freeze(path_shapes)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="160">
            <Properties>
              <string name="Name">nav_picker</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local fieldChrome = require("./field_chrome")
local ComposeTypes = require("../vendor/compose/core")
local ControlTypes = require("./control_types")
local NavigationProps = require("./navigation_props")
local MenuItems = require("./nav_menu_items")
local PickerParts = require("./nav_picker_parts")
local pickerMenus = require("./nav_picker_menu")
local pickerCards = require("./nav_picker_cards")
local pickerOptions = require("./nav_picker_options")

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	surfaces: Nav.Surfaces,
	buildMenu: MenuItems.BuildMenu
)
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2 = ctx.types.Enum, ctx.types.UDim2
	local shared = PickerParts(ctx, surfaces)
	local pickerKeys, derive = shared.keys, shared.derive
	local menus = pickerMenus(ctx, UI, shared, buildMenu)
	local cardsStyle = pickerCards(ctx, UI, shared)
	local optionsStyle = pickerOptions(ctx, UI, surfaces, shared)
	local function optionLabels(options: unknown): { unknown }
		local labels: { unknown } = {}
		if type(options) == "table" and not Compose.isReadable(options) then
			for _, option in options :: { { label: unknown } } do
				table.insert(labels, option.label)
			end
		end
		return labels
	end
	local function writable(cell: { set: unknown }, name: string)
		assert(type(cell) == "table" and type(cell.set) == "function", name .. " requires a writable Compose cell")
	end
	local optionFields: { [string]: boolean } = {
		id = true,
		value = true,
		label = true,
		description = true,
		icon = true,
		badge = true,
		enabled = true,
		meta = true,
		avatar = true,
		sectionTitle = true,
		indicator = true,
	}
	local function translate(word: string?, style: Nav.PickerStyle): string?
		if word == nil then
			return nil
		end
		if style == "segmented" then
			return if word == "standard" then "filled" elseif word == "contrast" then "stroke" else word
		elseif style == "menu" or style == "navigationLink" then
			return if word == "filled" then "standard" elseif word == "stroke" then "contrast" else word
		end
		return nil
	end
	local chrome = fieldChrome(ctx)
	UI.Picker = ctx.construct("Picker", function<V>(spec: NavigationProps.PickerSpec<V>): GuiObject
		writable(spec.selected, "Picker.selected")
		assert(spec.onChange == nil or type(spec.onChange) == "function", "Picker.onChange must be a function")
		assert(spec.onChanging == nil or type(spec.onChanging) == "function", "Picker.onChanging must be a function")
		assert(spec.required == nil or type(spec.required) == "boolean", "Picker.required must be a boolean")
		assert(
			spec.enabled == nil or type(read(spec.enabled)) == "boolean",
			"Picker.enabled must be a boolean or a readable boolean"
		)
		local declaredStyle: Nav.PickerStyle = spec.style or "automatic"
		chrome.check("Picker", {
			label = spec.label,
			requiredMark = spec.requiredMark,
			hint = spec.hint,
			errorText = spec.errorText,
			controlSize = spec.controlSize,
			corners = spec.corners,
		})
		shared.appearanceFor(declaredStyle, read(spec.appearance))
		assert(
			spec.maxHeight == nil
				or (type(spec.maxHeight) == "number" and spec.maxHeight > 0 and spec.maxHeight < math.huge),
			"Facet UI.Picker: maxHeight must be a finite number of pixels above zero"
		)
		assert(
			spec.maxHeight == nil or table.find({ "automatic", "menu", "navigationLink" }, declaredStyle),
			"Facet UI.Picker: maxHeight belongs to the menu styles"
		)
		assert(
			spec.valueAlignment == nil or spec.valueAlignment == "start" or spec.valueAlignment == "end",
			"Facet UI.Picker: valueAlignment must be start or end"
		)
		assert(
			spec.query == nil or declaredStyle ~= "segmented",
			"Facet UI.Picker: a segmented picker takes no query. Use navigationLink or menu for a searchable list"
		)
		assert(
			spec.indicatorPosition == nil or declaredStyle == "radioGroup",
			"Facet UI.Picker: indicatorPosition belongs to the radioGroup style"
		)
		assert(
			spec.indicatorPosition == nil or spec.indicatorPosition == "leading" or spec.indicatorPosition == "trailing",
			"Facet UI.Picker: indicatorPosition must be leading or trailing"
		)
		if spec.requiredMark == "required" and spec.label ~= nil then
			local marked = table.clone(spec)
			local words = spec.label
			marked.requiredMark = nil
			marked.label = function(use: ComposeTypes.Use)
				return (read(words, use) or "") .. " *"
			end
			return UI.Picker(marked)
		end
		if spec.hint ~= nil or spec.errorText ~= nil then
			local inner = table.clone(spec)
			local shell: Types.FrameNativeProps = {}
			local source = (inner :: unknown) :: { [string]: unknown }
			local target = (shell :: unknown) :: { [string]: unknown }
			for _, key in { "Name", "Size", "Position", "AnchorPoint", "LayoutOrder", "Visible", "ZIndex" } do
				target[key], source[key] = source[key], nil
			end
			inner.hint, inner.errorText = nil, nil
			inner.Name = "Control"
			local control = UI.Picker(inner)
			local failure = chrome.errorOf({ errorText = spec.errorText }, nil)
			Compose.watch(function(use: ComposeTypes.Use)
				local failing = failure(use) ~= ""
				for _, node in control:GetDescendants() do
					if node.Name == "Trigger" and node:IsA("GuiObject") then
						if failing then
							node:AddTag("facet-invalid")
						elseif node:HasTag("facet-invalid") then
							node:RemoveTag("facet-invalid")
						end
					end
				end
			end)
			shell.Name = shell.Name or "Picker"
			return chrome.wrap({
				control = "Picker",
				spec = { hint = spec.hint, errorText = spec.errorText },
				plate = control,
				focus = function() end,
				enabled = function(use: ComposeTypes.Use?)
					return read(spec.enabled, use) ~= false
				end,
				native = shell,
			})
		end
		assert(
			type(spec.options) == "table" or type(spec.options) == "function",
			"Facet UI.Picker: options must be an array of { value, label } entries, a Compose readable, or a function(use) that returns one"
		)
		local function isSelected(value: V, use: ComposeTypes.Use?): boolean
			if spec.multiple then
				return read(spec.selected, use)[value] == true
			else
				return read(spec.selected, use) == value
			end
		end
		local function commitSelection<T>(
			selected: ComposeTypes.Cell<T>,
			value: T,
			onChanging: ((T, T) -> boolean?)?,
			onChange: ((T) -> ())?
		)
			local previous = selected:peek()
			if onChanging and onChanging(value, previous) == false then
				return
			end
			runtime:batch(function()
				selected:set(value)
				if onChange then
					onChange(value)
				end
			end)
		end
		local function select(value: V)
			if read(spec.enabled) == false then
				return
			end
			if spec.multiple then
				local previous = spec.selected:peek()
				local nextValue: { [V]: boolean } = {}
				for key, flag in previous do
					if key ~= value then
						nextValue[key] = flag
					end
				end
				if not previous[value] then
					nextValue[value] = true
				end
				if spec.required and next(nextValue) == nil then
					return
				end
				commitSelection(spec.selected, nextValue, spec.onChanging, spec.onChange)
			else
				if value ~= spec.selected:peek() then
					commitSelection(spec.selected, value, spec.onChanging, spec.onChange)
				end
			end
		end
		local declaredIndicator, declaredAxis, declaredSizing = read(spec.indicator), read(spec.axis), read(spec.sizing)
		assert(
			declaredIndicator == nil or table.find({ "automatic", "pill", "underline", "none" }, declaredIndicator),
			"Invalid Picker.indicator"
		)
		assert(declaredAxis == nil or table.find({ "x", "y" }, declaredAxis), "Picker.axis must be x or y")
		assert(
			declaredSizing == nil or table.find({ "fill", "hug" }, declaredSizing),
			"Picker.sizing must be fill or hug"
		)
		local style = spec.style or "automatic"
		if style == "automatic" then
			local input = surfaces.service("UserInputService")
			local preferred = if input
				then ctx.observe.PreferredInput(input) :: ComposeTypes.Readable<Enum.PreferredInput?>
				else Compose.cell(nil :: Enum.PreferredInput?)
			local opened: ComposeTypes.Cell<boolean> = spec.isPresented or Compose.cell(false)
			local tenFoot = ctx.tenFoot()
			local width = Compose.cell(0)
			local measure = ctx.text({
				Name = "LabelMeasure",
				Text = derive(function(use: ComposeTypes.Use?)
					local labels = {}
					for _, option in read(spec.options, use) do
						table.insert(labels, tostring(read(option.label, use) or ""))
					end
					return table.concat(labels, "")
				end, spec.options, table.unpack(optionLabels(spec.options))),
				TextSize = spec.textSize,
				TextWrapped = false,
				Visible = false,
			})
			measure:AddTag("facet-type-control")
			local labelBounds = ctx.observe.TextBounds(measure)

			local resolved = Compose.formula(function(use: ComposeTypes.Use): Nav.PickerStyle
				if spec.query then
					return "navigationLink"
				end
				local list: { Nav.PickerOption<V> } = read(spec.options, use)
				local count = #list
				local available = use(width)
				local described = false
				for _, option in list do
					if option.description ~= nil then
						described = true
					end
				end
				local needed = use(labelBounds).X + count * 24 + math.max(0, count - 1) * 4 + 6
				if count <= 4 and not described and (available == 0 or needed <= available) then
					return "segmented"
				end
				local kind = use(preferred)
				if
					not tenFoot(use)
					and (kind == E.PreferredInput.KeyboardAndMouse or kind == E.PreferredInput.Touch)
				then
					return "menu"
				end
				return if count <= 6 then "inline" else "menu"
			end)
			local props = ctx.props(spec, pickerKeys, {
				Name = "Picker",
				BackgroundTransparency = 1,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
			})
			props[#props + 1] = Compose.keyed({
				from = function(use: ComposeTypes.Use)
					return { use(resolved) }
				end,
				render = function(current: ComposeTypes.Readable<Nav.PickerStyle>)
					local presentation: Nav.PickerStyle = current:peek()
					local automatic = props.AutomaticSize
					local size = derive(function(use: ComposeTypes.Use?)
						local sizing = read(automatic, use)
						return D2.fromScale(
							if sizing == E.AutomaticSize.X or sizing == E.AutomaticSize.XY then 0 else 1,
							if sizing == E.AutomaticSize.Y or sizing == E.AutomaticSize.XY then 0 else 1
						)
					end, automatic)
					if spec.multiple then
						local child: NavigationProps.MultiplePickerSpec<V> = {
							options = spec.options,
							query = spec.query,
							placeholder = spec.placeholder,
							label = spec.label,
							required = spec.required,
							enabled = spec.enabled,
							indicator = spec.indicator,
							axis = spec.axis,
							sizing = spec.sizing,
							iconOnly = spec.iconOnly,
							textSize = spec.textSize,
							Name = "Presentation",
							style = presentation,
							isPresented = opened,
							AutomaticSize = automatic,
							Size = size,
							controlSize = spec.controlSize,
							corners = if presentation == "menu"
									or presentation == "segmented"
									or presentation == "navigationLink"
								then spec.corners
								else nil,
							maxHeight = if presentation == "menu" or presentation == "navigationLink"
								then spec.maxHeight
								else nil,
							appearance = if spec.appearance ~= nil
									and (
										presentation == "menu"
										or presentation == "segmented"
										or presentation == "navigationLink"
									)
								then function(use: ComposeTypes.Use): string
									return translate(read(spec.appearance, use), presentation) or "utility"
								end
								else nil,
							valueAlignment = spec.valueAlignment,
							multiple = true :: true,
							selected = spec.selected,
							onChanging = spec.onChanging,
							onChange = spec.onChange,
						}
						return UI.Picker(child)
					else
						local child: NavigationProps.SinglePickerSpec<V> = {
							options = spec.options,
							query = spec.query,
							placeholder = spec.placeholder,
							label = spec.label,
							required = spec.required,
							enabled = spec.enabled,
							indicator = spec.indicator,
							axis = spec.axis,
							sizing = spec.sizing,
							iconOnly = spec.iconOnly,
							textSize = spec.textSize,
							Name = "Presentation",
							style = presentation,
							isPresented = opened,
							AutomaticSize = automatic,
							Size = size,
							controlSize = spec.controlSize,
							corners = if presentation == "menu"
									or presentation == "segmented"
									or presentation == "navigationLink"
								then spec.corners
								else nil,
							maxHeight = if presentation == "menu" or presentation == "navigationLink"
								then spec.maxHeight
								else nil,
							appearance = if spec.appearance ~= nil
									and (
										presentation == "menu"
										or presentation == "segmented"
										or presentation == "navigationLink"
									)
								then function(use: ComposeTypes.Use): string
									return translate(read(spec.appearance, use), presentation) or "utility"
								end
								else nil,
							valueAlignment = spec.valueAlignment,
							multiple = false :: false,
							selected = spec.selected,
							onChanging = spec.onChanging,
							onChange = spec.onChange,
						}
						return UI.Picker(child)
					end
				end,
			})
			props[#props + 1] = measure
			local container = Host.Frame(props)
			local measured = ctx.observe.AbsoluteSize(container)
			Compose.watch(function(use: ComposeTypes.Use)
				width:set(use(measured).X)
			end)
			return container
		end
		local options = Compose.formula(function(use: ComposeTypes.Use)
			local query = string.lower(tostring(read(spec.query, use) or ""))
			local result: { Nav.PickerOption<V> } = {}
			local seen: { [V | string]: boolean } = {}
			local list: { Nav.PickerOption<V> } = read(spec.options, use)
			for key in list do
				assert(
					type(key) == "number" and key >= 1 and key <= #list and key % 1 == 0,
					"Picker options require a dense array"
				)
			end
			for _, option in list do
				for field in (option :: unknown) :: { [unknown]: unknown } do
					assert(
						type(field) == "string" and optionFields[field] == true,
						`Unknown Picker option field {tostring(field)}`
					)
				end
				assert(
					option.description == nil or type(read(option.description, use)) == "string",
					"Picker description must be text"
				)
				assert(
					option.enabled == nil or type(read(option.enabled, use)) == "boolean",
					"Picker option enabled must be a boolean"
				)
				assert(
					option.icon == nil or type(read(option.icon, use)) == "string",
					"Picker option icon must be an icon name"
				)
				local badge = read(option.badge, use)
				assert(
					badge == nil or type(badge) == "string" or type(badge) == "number",
					"Picker option badge must be text or a number"
				)
				local key = option.id or option.value
				assert(key ~= nil and not seen[key], "Picker options require unique values or ids")
				seen[key] = true
				assert(
					type(read(option.label, use)) == "string" and string.find(read(option.label, use), "%S") ~= nil,
					"Picker options require nonempty labels"
				)
				assert(
					read(spec.iconOnly) ~= true or option.icon ~= nil,
					"Picker.iconOnly requires an icon on each option"
				)
				local label = tostring(read(option.label, use) or "")
				if query == "" or string.find(string.lower(label), query, 1, true) then
					table.insert(result, option)
				end
			end
			return result
		end)
		local choice: PickerParts.Choice<V> = { isSelected = isSelected, select = select, options = options }
		if style == "menu" then
			return menus.menu(spec, choice)
		end
		if style == "navigationLink" then
			return menus.navigationLink(spec, choice)
		end
		if style == "cards" then
			return cardsStyle(spec, choice)
		end
		assert(table.find({ "segmented", "inline", "radioGroup", "navigationLink" }, style), "Unknown Picker style")
		return optionsStyle(spec, choice, style)
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="161">
            <Properties>
              <string name="Name">nav_picker_cards</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local NavigationProps = require("./navigation_props")
local PickerParts = require("./nav_picker_parts")

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, shared: PickerParts.Parts)
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2 = ctx.types.Enum, ctx.types.UDim2
	local pickerKeys = shared.keys
	local function cardsStyle<V>(spec: NavigationProps.PickerSpec<V>, choice: PickerParts.Choice<V>): GuiObject
		local isSelected, select, options = choice.isSelected, choice.select, choice.options
		local across = read(spec.axis) == "x"
		local function clear()
			if read(spec.enabled) == false or spec.multiple then
				return
			end
			local single = (spec :: unknown) :: NavigationProps.SinglePickerSpec<V>
			local previous = single.selected:peek()
			if single.onChanging and single.onChanging((nil :: unknown) :: V, previous) == false then
				return
			end
			local optional = (single.selected :: unknown) :: ComposeTypes.Cell<V?>
			runtime:batch(function()
				optional:set(nil)
				if single.onChange then
					single.onChange((nil :: unknown) :: V)
				end
			end)
		end
		local cards = ctx.column({
			Compose.keyed({
				from = options,
				key = function(option: Nav.PickerOption<V>)
					return option.id or option.value
				end,
				render = function(
					source: ComposeTypes.Readable<Nav.PickerOption<V>>,
					index: ComposeTypes.Readable<number>
				)
					local key = tostring(source:peek().id or source:peek().value)
					local chosen = function(use: ComposeTypes.Use)
						return isSelected(use(source).value, use)
					end
					local card = UI.Button({
						Name = "Card-" .. key,
						LayoutOrder = index,
						Size = if across then D2.fromOffset(200, 0) else D2.new(1, 0, 0, 0),
						AutomaticSize = E.AutomaticSize.Y,
						label = function(use: ComposeTypes.Use)
							return read(use(source).label, use)
						end,
						subtitle = function(use: ComposeTypes.Use)
							return read(use(source).description, use) or ""
						end,
						icon = shared.liveIcon(source),
						controlSize = spec.controlSize,
						appearance = function(use: ComposeTypes.Use): string
							return if chosen(use) then "emphasis" else "standard"
						end,
						selected = chosen,
						enabled = function(use: ComposeTypes.Use)
							return read(spec.enabled, use) ~= false and read(use(source).enabled, use) ~= false
						end,
						onActivate = function()
							local value = source:peek().value
							if isSelected(value) and spec.required == false then
								clear()
							else
								select(value)
							end
						end,
					})
					card:AddTag("facet-card-option")
					local cardWidth = shared.layoutWidth(card)
					shared.wrapCaptions(card, spec.controlSize, function(use: ComposeTypes.Use): number
						return use(cardWidth)
					end)
					local content = card:FindFirstChild("Content")
					if content then
						runtime.mountFragment(function()
							local parts: { Types.Child } = {}
							if source:peek().meta ~= nil then
								table.insert(
									parts,
									ctx.styled(
										ctx.text({
											Name = "Meta",
											LayoutOrder = 50,
											Text = function(use: ComposeTypes.Use)
												return read(use(source).meta, use) or ""
											end,
										}),
										"secondary"
									)
								)
							end
							if source:peek().badge ~= nil then
								table.insert(
									parts,
									ctx.styled(
										Host.Frame "Badge" {
											LayoutOrder = 60,
											Size = D2.fromOffset(0, 0),
											AutomaticSize = E.AutomaticSize.XY,
											ctx.text({
												Name = "Count",
												Text = function(use: ComposeTypes.Use)
													local badge = read(use(source).badge, use)
													return if badge == nil then "" else tostring(badge)
												end,
											}) :: Types.Child,
										},
										"badge"
									)
								)
							end
							return parts
						end, content)
					end
					Compose.watch(function(use: ComposeTypes.Use)
						card:SetAttribute("FacetLabel", read(use(source).label, use))
					end)
					return card
				end,
			}),
		}, { Name = "Cards", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
		local layout = assert(cards:FindFirstChildWhichIsA("UIListLayout"))
		if across then
			layout.FillDirection = E.FillDirection.Horizontal
			layout.Wraps = true
		end
		local outer = ctx.props(spec, pickerKeys, {
			Name = "Picker",
			BackgroundTransparency = 1,
			Size = D2.new(1, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
		})
		if spec.label == nil then
			return ctx.column({ cards }, outer)
		end
		return ctx.column({
			ctx.text({
				Name = "Label",
				Text = function(use: ComposeTypes.Use)
					return read(spec.label, use) or ""
				end,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
				TextWrapped = true,
			}),
			cards,
		}, outer)
	end
	return cardsStyle
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="162">
            <Properties>
              <string name="Name">nav_picker_menu</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local ComposeTypes = require("../vendor/compose/core")
local ControlTypes = require("./control_types")
local InputProps = require("./input_props")
local NavigationProps = require("./navigation_props")
local MenuItems = require("./nav_menu_items")
local PickerParts = require("./nav_picker_parts")

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	shared: PickerParts.Parts,
	buildMenu: MenuItems.BuildMenu
)
	local runtime, read = ctx.runtime, ctx.read
	local E, D2, V2, D = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2, ctx.types.UDim
	local pickerKeys, appearanceFor = shared.keys, shared.appearanceFor
	local function menuStyle<V>(spec: NavigationProps.PickerSpec<V>, choice: PickerParts.Choice<V>): GuiObject
		local isSelected, select, options = choice.isSelected, choice.select, choice.options
		local native: Types.FrameNativeProps = ctx.props(spec, pickerKeys)
		local menuSpec: NavigationProps.MenuSpec<V> = { items = {} }
		for key, value in pairs(native) do
			menuSpec[key] = value
		end
		menuSpec.enabled = spec.enabled
		menuSpec.isPresented = spec.isPresented
		menuSpec.query = spec.query
		menuSpec.maxHeight = spec.maxHeight
		local valueText = function(use: ComposeTypes.Use): string
			local labels = {}
			for _, option in read(spec.options, use) do
				if isSelected(option.value, use) then
					table.insert(labels, read(option.label, use))
				end
			end
			return if #labels > 0
				then table.concat(labels, ", ")
				else read(spec.placeholder, use) or (if spec.label == nil then "Choose" else "Choose")
		end
		local triggerProps: InputProps.ButtonProps = {
			Name = "Trigger",
			label = valueText,
			enabled = spec.enabled,
			controlSize = spec.controlSize,
			corners = spec.corners,
			appearance = if spec.appearance ~= nil
				then function(use: ComposeTypes.Use): string
					local word = appearanceFor("menu", read(spec.appearance, use))
					return if word == "contrast" then "emphasis" elseif word == "utility" then "utility" else "default"
				end
				else nil,
			Attributes = { FacetLabel = valueText } :: Types.Attributes,
			ctx.icon("chevron.up.chevron.down", {
				Name = "Disclosure",
				Size = D2.fromOffset(12, 12),
				AnchorPoint = V2.new(1, 0.5),
				Position = D2.new(1, 20, 0.5, 0),
				BackgroundTransparency = 1,
			}) :: Types.Child,
		}
		if spec.Size ~= nil and spec.label == nil then
			local automatic = spec.AutomaticSize or E.AutomaticSize.None
			triggerProps.AutomaticSize = automatic
			triggerProps.Size = function(use: ComposeTypes.Use)
				local sizing = read(automatic, use)
				local width = sizing == E.AutomaticSize.X or sizing == E.AutomaticSize.XY
				local height = sizing == E.AutomaticSize.Y or sizing == E.AutomaticSize.XY
				return D2.new(
					if width then 0 else 1,
					0,
					if height then 0 else 1,
					if height then ctx.controlSize(spec.controlSize, "height", use) else 0
				)
			end
			triggerProps.TextTruncate = E.TextTruncate.AtEnd
			triggerProps.TextWrapped = false
			triggerProps.ClipsDescendants = true
		end
		local trigger = UI.Button(triggerProps)
		trigger:AddTag("facet-disclosure")
		menuSpec.trigger = function(): GuiObject
			return trigger
		end
		menuSpec.items = function(use: ComposeTypes.Use)
			local items = {}
			for _, option in use(options) do
				table.insert(items, {
					id = option.id or tostring(option.value),
					label = option.label,
					icon = option.icon,
					description = option.description,
					badge = option.badge,
					meta = option.meta,
					avatar = option.avatar,
					sectionTitle = option.sectionTitle,
					dismiss = not spec.multiple,
					marked = function(use: ComposeTypes.Use)
						return isSelected(option.value, use)
					end,
					enabled = option.enabled,
					onSelect = function()
						select(option.value)
					end,
				})
			end
			return items
		end
		if spec.label == nil then
			return buildMenu(menuSpec, true)
		end
		menuSpec.Name = "Value"
		menuSpec.Size = nil
		menuSpec.AutomaticSize = E.AutomaticSize.XY
		menuSpec.AnchorPoint = nil
		menuSpec.Position = nil
		local inline = spec.valueAlignment == "start"
		local label = ctx.text({
			Name = "Label",
			Text = function(use: ComposeTypes.Use)
				return read(spec.label, use) or ""
			end,
			Size = if inline then D2.fromOffset(0, 0) else D2.new(1, 0, 0, 0),
			AutomaticSize = if inline then E.AutomaticSize.XY else E.AutomaticSize.Y,
			TextWrapped = not inline,
			TextXAlignment = E.TextXAlignment.Left,
		})
		if inline then
			local hug = function(use: ComposeTypes.Use): boolean
				return read(spec.sizing, use) == "hug"
			end
			local row = ctx.row(
				{ label, buildMenu(menuSpec, true) },
				ctx.props(spec, pickerKeys, {
					Name = spec.Name or "Picker",
					BackgroundTransparency = 1,
					Size = function(use: ComposeTypes.Use)
						return if hug(use) then D2.fromOffset(0, 0) else D2.new(1, 0, 0, 0)
					end,
					AutomaticSize = function(use: ComposeTypes.Use)
						return if hug(use) then E.AutomaticSize.XY else E.AutomaticSize.Y
					end,
				})
			)
			local layout = assert(row:FindFirstChildWhichIsA("UIListLayout"))
			layout.VerticalAlignment = E.VerticalAlignment.Center
			layout.Wraps = true
			row:SetAttribute("FacetValueAlignment", "start")
			return row
		end
		local column = ctx.column(
			{ label, buildMenu(menuSpec, true) },
			ctx.props(spec, pickerKeys, {
				Name = spec.Name or "Picker",
				BackgroundTransparency = 1,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
			})
		)
		assert(column:FindFirstChildWhichIsA("UIListLayout")).Padding = D.new(0, 4)
		return column
	end
	local function linkStyle<V>(spec: NavigationProps.PickerSpec<V>, choice: PickerParts.Choice<V>): GuiObject
		local isSelected = choice.isSelected
		local opened: ComposeTypes.Cell<boolean> = spec.isPresented or ctx.Compose.cell(false)
		local chosenText = function(use: ComposeTypes.Use): string
			for _, option in read(spec.options, use) do
				if isSelected(option.value, use) then
					local label: string = read(option.label, use)
					return label
				end
			end
			return read(spec.placeholder, use) or "Choose"
		end
		local native: Types.FrameNativeProps = ctx.props(spec, pickerKeys)
		local triggerProps = (native :: unknown) :: InputProps.ButtonProps
		triggerProps.Name = spec.Name or "Picker"
		triggerProps.enabled = spec.enabled
		triggerProps.label = spec.label or chosenText
		triggerProps.trailingIcon = if spec.label ~= nil then "chevron.trailing" else nil
		if spec.label ~= nil then
			triggerProps.row = { title = spec.label }
			local given = spec.Size
			triggerProps.Size = function(use: ComposeTypes.Use): UDim2
				local base: UDim2 = read(given, use) or D2.fromScale(1, 0)
				local floor = ctx.controlSize(spec.controlSize, "height", use)
				return D2.new(base.X.Scale, base.X.Offset, base.Y.Scale, math.max(base.Y.Offset, floor))
			end
			triggerProps.AutomaticSize = spec.AutomaticSize or E.AutomaticSize.Y
			triggerProps.ClipsDescendants = true
		end
		triggerProps.controlSize = spec.controlSize
		triggerProps.corners = spec.corners
		triggerProps.appearance = if spec.appearance ~= nil
			then function(use: ComposeTypes.Use): string
				local word = appearanceFor("navigationLink", read(spec.appearance, use))
				return if word == "contrast" then "emphasis" elseif word == "utility" then "utility" else "standard"
			end
			else nil
		local trigger = UI.Button(triggerProps)
		local row = trigger:FindFirstChild("Content")
		local chevron = row and row:FindFirstChild("TrailingIcon")
		if chevron and chevron:IsA("GuiObject") then
			chevron.LayoutOrder = 100
		end
		if spec.label ~= nil and row then
			runtime.mountFragment(function()
				return {
					ctx.styled(
						ctx.text({
							Name = "Trailing",
							LayoutOrder = 90,
							Text = chosenText,
						}),
						"secondary"
					),
				}
			end, row)
		end
		UI.Popover {
			isPresented = opened,
			onPresentedChange = function(value: boolean)
				opened:set(value)
			end,
			trigger = trigger :: GuiButton,
			edge = "bottom" :: "bottom",
			align = "end" :: "end",
			maxWidth = ctx.metric("controls.popup.panelWidth"),
			maxHeight = spec.maxHeight or 400,
			title = spec.label,
			content = function(): Instance
				local choices: NavigationProps.PickerSpec<V>
				if spec.multiple then
					local source: NavigationProps.MultiplePickerSpec<V> = spec
					local child = table.clone(source)
					child.Name, child.style, child.isPresented = "Choices", "inline", nil
					child.Size = D2.new(1, 0, 0, 0)
					child.appearance, child.corners, child.maxHeight, child.requiredMark = nil, nil, nil, nil
					child.indicator = "none"
					child.onChange = function(value: { [V]: boolean })
						if source.onChange then
							source.onChange(value)
						end
					end
					choices = child
				else
					local source: NavigationProps.SinglePickerSpec<V> = spec
					local child = table.clone(source)
					child.Name, child.style, child.isPresented = "Choices", "inline", nil
					child.Size = D2.new(1, 0, 0, 0)
					child.appearance, child.corners, child.maxHeight, child.requiredMark = nil, nil, nil, nil
					child.indicator = "none"
					child.onChange = function(value: V)
						opened:set(false)
						if source.onChange then
							source.onChange(value)
						end
					end
					choices = child
				end
				local picker = (UI.Picker :: unknown) :: (NavigationProps.PickerSpec<V>) -> GuiObject
				return ctx.column({ picker(choices) }, {
					Name = "PickerSearch",
					Size = function(use: ComposeTypes.Use)
						return D2.fromOffset(ctx.metric("controls.popup.panelWidth", use) - 16, 0)
					end,
					AutomaticSize = E.AutomaticSize.Y,
				})
			end,
		}
		return trigger
	end
	return { menu = menuStyle, navigationLink = linkStyle }
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="163">
            <Properties>
              <string name="Name">nav_picker_options</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local segmentMetrics = require("./segment_metrics")
local Types = require("./types")
local Nav = require("./navigation_types")
local Media = require("./media_types")
local Content = require("./content_types")
local reducedMotion = require("./motion").reduced
local rest = require("./rest")
local ComposeTypes = require("../vendor/compose/core")
local MediaProps = require("./media_props")
local NavigationProps = require("./navigation_props")
local PickerParts = require("./nav_picker_parts")

local RADIO_MARK = 18 + 8

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces, shared: PickerParts.Parts)
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2, V2, D = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2, ctx.types.UDim
	local pickerKeys, derive = shared.keys, shared.derive
	local layoutWidth, sideChrome, wrapCaptions = shared.layoutWidth, shared.sideChrome, shared.wrapCaptions
	local function slideSelection(
		picker: Frame,
		boxes: {
			[GuiObject]: {
				order: ComposeTypes.Readable<number>,
				size: ComposeTypes.Readable<Vector2>,
				at: ComposeTypes.Readable<Vector2>,
			},
		},
		currentOrder: ComposeTypes.Cell<number>,
		indicator: Types.Value<string>?
	): ()
		local reduced = reducedMotion(ctx)
		local spring = ctx.motionSpring("control")
		local laidOut = ctx.observe.AbsoluteContentSize(assert(picker:FindFirstChildWhichIsA("UIListLayout", true)))
		local seenOrder: number?, seenStrip: Vector2? = nil, nil
		local function reshaped(before: Vector2, after: Vector2): boolean
			if before.Y <= 0 or after.Y <= 0 then
				return math.abs(after.X - before.X) > 0.5 or math.abs(after.Y - before.Y) > 0.5
			end
			return math.abs(after.X * before.Y - before.X * after.Y) > 0.5 * math.max(before.Y, after.Y)
		end
		local function landsWithStrip(use: ComposeTypes.Use): boolean
			local order, strip = use(currentOrder), use(laidOut) :: Vector2
			local reflowed = order == seenOrder and seenStrip ~= nil and reshaped(seenStrip, strip)
			seenOrder, seenStrip = order, strip
			return reduced(use) or reflowed
		end
		local sliding = runtime.spring(function(use: ComposeTypes.Use)
			return use(currentOrder)
		end, { period = spring.period, damping = spring.damping, tolerance = 1e-3, reducedMotion = landsWithStrip })
		local _, slot = runtime.mount(function()
			return Host.Folder "Slide" { Host.Frame "SlideUnit" { Size = D2.fromOffset(1, 1), Visible = false } }
		end, picker)
		local probe = (slot :: Instance):FindFirstChild("SlideUnit") :: GuiObject
		local unit = ctx.observe.AbsoluteSize(probe)
		local content = ctx.observe.AbsolutePosition(probe)
		local function rectAt(use: ComposeTypes.Use, order: number): (Vector2?, Vector2?)
			local scale = (use(unit) :: Vector2).X
			scale = if scale > 0 then scale else 1
			local room = (use(laidOut) :: Vector2) / scale
			for _, box in boxes do
				if use(box.order) == order then
					local at = (use(box.at) - use(content) :: Vector2) / scale
					local size = use(box.size) / scale
					at = V2.new(math.clamp(at.X, 0, room.X), math.clamp(at.Y, 0, room.Y))
					return at, V2.new(math.min(size.X, room.X - at.X), math.min(size.Y, room.Y - at.Y))
				end
			end
			return nil, nil
		end
		local rect = Compose.formula(function(use: ComposeTypes.Use): { Vector2 }?
			local at = use(sliding)
			local low = math.floor(at)
			local fromAt, fromSize = rectAt(use, low)
			local toAt, toSize = rectAt(use, low + 1)
			local t = at - low
			if fromAt == nil or fromSize == nil or (t > 0 and (toAt == nil or toSize == nil)) then
				fromAt, fromSize = rectAt(use, use(currentOrder))
				t = 0
			end
			if fromAt == nil or fromSize == nil then
				return nil
			end
			local place = if t > 0 then fromAt:Lerp(toAt :: Vector2, t) else fromAt
			local size = if t > 0 then fromSize:Lerp(toSize :: Vector2, t) else fromSize
			return { place, size }
		end)
		local function shown(use: ComposeTypes.Use): boolean
			return read(indicator, use) ~= "underline"
				and not reduced(use)
				and use(sliding) ~= use(currentOrder)
				and use(currentOrder) > 0
				and use(rect) ~= nil
		end
		Compose.watch(function(use: ComposeTypes.Use)
			if shown(use) then
				picker:AddTag("facet-segmented-slides")
			elseif picker:HasTag("facet-segmented-slides") then
				picker:RemoveTag("facet-segmented-slides")
			end
		end)
		runtime.mount(function()
			return ctx.styled(
				Host.Frame "SelectionFill" {
					ZIndex = 0,
					Active = false,
					Visible = shown,
					Position = function(use: ComposeTypes.Use): UDim2
						local box = use(rect)
						return if box then D2.fromOffset(box[1].X, box[1].Y) else D2.new()
					end,
					Size = function(use: ComposeTypes.Use): UDim2
						local box = use(rect)
						return if box then D2.fromOffset(box[2].X, box[2].Y) else D2.new()
					end,
				},
				"segment-fill"
			)
		end, slot :: Instance)
	end
	local function optionsStyle<V>(
		spec: NavigationProps.PickerSpec<V>,
		choice: PickerParts.Choice<V>,
		style: string
	): GuiObject
		local isSelected, select, options = choice.isSelected, choice.select, choice.options
		local vertical = style ~= "segmented" or read(spec.axis) == "y"
		local function across(use: ComposeTypes.Use?): boolean
			return style == "segmented" and read(spec.axis, use) ~= "y"
		end
		local room = Compose.cell(math.huge)
		local segmentBoxes: {
			[GuiObject]: {
				order: ComposeTypes.Readable<number>,
				size: ComposeTypes.Readable<Vector2>,
				at: ComposeTypes.Readable<Vector2>,
			},
		} =
			{}
		local currentOrder = Compose.cell(0)
		local captionHeights: { [Instance]: number } = {}
		local tallestCaption = Compose.cell(0)
		local function measureCaptions(): ()
			local tallest = 0
			for _, height in captionHeights do
				tallest = math.max(tallest, height)
			end
			if tallest ~= tallestCaption:peek() then
				tallestCaption:set(tallest)
			end
		end
		local segmentInput = ctx.effectiveInput()
		local function stripHeight(use: ComposeTypes.Use?): number
			local rung = ctx.controlSize(spec.controlSize, "height", use)
			if spec.controlSize == nil or segmentInput(use) == "Touch" then
				rung = math.max(rung, 44 + 2 * segmentMetrics.inset)
			end
			local package = read(ctx.config.theme, use)
			local recipe = if package and package.chrome then package.chrome.control else nil
			local inset = if recipe then recipe.contentInsets else nil
			local caption = if use then use(tallestCaption) else tallestCaption:peek()
			if caption <= 0 or recipe == nil or recipe.kind == "native" or recipe.kind == "none" then
				return rung
			end
			local chrome = math.max(0, if inset then inset.top or 0 else 0)
				+ math.max(0, if inset then inset.bottom or 0 else 0)
			return math.max(rung, math.ceil(caption) + chrome + 2 * segmentMetrics.inset)
		end
		local fixedOptions = not (Compose.isReadable(spec.options) or type(spec.options) == "function")
		local children: { ComposeTypes.Child } = {
			Host.UIListLayout({
				FillDirection = derive(function(use: ComposeTypes.Use?)
					return if style ~= "segmented" or read(spec.axis, use) == "y"
						then E.FillDirection.Vertical
						else E.FillDirection.Horizontal
				end, spec.axis),
				SortOrder = E.SortOrder.LayoutOrder,
				Wraps = style == "segmented" and not vertical,
				Padding = D.new(0, 4),
				HorizontalFlex = derive(function(use: ComposeTypes.Use?)
					return if style == "segmented"
							and read(spec.axis, use) ~= "y"
							and read(spec.sizing, use) ~= "hug"
						then E.UIFlexAlignment.Fill
						else E.UIFlexAlignment.None
				end, spec.axis, spec.sizing),
				VerticalFlex = derive(function(use: ComposeTypes.Use?)
					return if style == "segmented"
							and read(spec.axis, use) == "y"
							and read(spec.sizing, use) ~= "hug"
						then E.UIFlexAlignment.Fill
						else E.UIFlexAlignment.None
				end, spec.axis, spec.sizing),
			}),
		}
		if spec.query then
			table.insert(children, UI.TextInput "Search" { value = spec.query, placeholder = "Search" })
		end
		table.insert(
			children,
			Compose.keyed({
				from = options,
				key = function(option: Nav.PickerOption<V>)
					return option.id or option.value
				end,
				render = function(
					source: ComposeTypes.Readable<Nav.PickerOption<V>>,
					index: ComposeTypes.Readable<number>
				)
					local selected = function(use: ComposeTypes.Use)
						return isSelected(use(source).value, use)
					end
					local current = source:peek()
					local fixed = fixedOptions and spec.query == nil
					local sealed = style == "segmented" and current.icon ~= nil
					local function labelOf(use: ComposeTypes.Use?): string
						if read(spec.iconOnly, use) then
							return ""
						end
						local option = if use then use(source) else source:peek()
						return read(option.label, use)
					end
					local function enabledOf(use: ComposeTypes.Use?): boolean
						local option = if use then use(source) else source:peek()
						return read(spec.enabled, use) ~= false and read(option.enabled, use) ~= false
					end
					local button = UI.Button({
						Name = tostring(current.id or current.value),
						LayoutOrder = if fixed then index:peek() else index,
						Size = function(use: ComposeTypes.Use)
							if across(use) then
								local height = stripHeight(use)
								if spec.controlSize == nil then
									height = math.max(height, 44 + 2 * segmentMetrics.inset)
								end
								local authored = read(spec.Size, use)
								local automatic = read(spec.AutomaticSize, use)
								if
									authored
									and authored.Y.Scale == 0
									and authored.Y.Offset > 0
									and automatic ~= E.AutomaticSize.Y
									and automatic ~= E.AutomaticSize.XY
								then
									height = math.max(
										authored.Y.Offset,
										if segmentInput(use) == "Touch" then 44 + 2 * segmentMetrics.inset else 0
									)
								end
								return D2.fromOffset(0, math.max(0, height - 2 * segmentMetrics.inset))
							end
							local height = if spec.controlSize ~= nil
								then ctx.controlSize(spec.controlSize, "height", use)
								else 44
							local automatic = read(spec.AutomaticSize, use)
							local hug = style == "segmented"
								and (automatic == E.AutomaticSize.X or automatic == E.AutomaticSize.XY)
							return D2.new(if hug then 0 else 1, 0, 0, height)
						end,
						AutomaticSize = if style ~= "segmented"
							then E.AutomaticSize.Y
							else derive(function(use: ComposeTypes.Use?)
								local automatic = read(spec.AutomaticSize, use)
								return if across(use)
									then E.AutomaticSize.X
									elseif
										automatic == E.AutomaticSize.X or automatic == E.AutomaticSize.XY
									then E.AutomaticSize.XY
									else E.AutomaticSize.Y
							end, spec.axis, spec.AutomaticSize),
						label = derive(labelOf, if fixed then nil else source, spec.iconOnly, current.label),
						name = function(use: ComposeTypes.Use): string
							local option = use(source)
							local badge = read(option.badge, use)
							return tostring(read(option.label, use))
								.. (if badge ~= nil and badge ~= "" then ` ({badge})` else "")
						end,
						subtitle = if source:peek().description ~= nil
								or source:peek().badge ~= nil
								or style == "radioGroup"
								or Compose.isReadable(spec.options)
								or type(spec.options) == "function"
							then function(use: ComposeTypes.Use)
								return read(use(source).description, use) or ""
							end
							else nil,
						icon = shared.liveIcon(source),
						TextSize = spec.textSize,
						TextXAlignment = if style == "segmented" then E.TextXAlignment.Center else nil,
						trailingIcon = if read(spec.indicator) == "none" and style ~= "segmented"
							then "checkmark"
							else nil,
						selected = function(use: ComposeTypes.Use)
							local indicator = read(spec.indicator, use)
							return selected(use)
								and indicator ~= "underline"
								and (indicator ~= "none" or style == "segmented")
						end,
						enabled = derive(enabledOf, if fixed then nil else source, spec.enabled, current.enabled),
						haptic = function(use: ComposeTypes.Use)
							return spec.multiple == true or not selected(use)
						end,
						onActivate = function()
							select(source:peek().value)
						end,
					})
					if sealed then
						Compose.watch(function(use: ComposeTypes.Use)
							if labelOf(use) == "" then
								button:AddTag("facet-button-glyph")
							else
								button:RemoveTag("facet-button-glyph")
							end
						end)
					end
					local glyph = if sealed then button:FindFirstChild("LeadingIcon", true) else nil
					if glyph and (current.badge ~= nil or not fixed) then
						local corner = UI.badged(
							Host.Frame({ Name = "Anchor", BackgroundTransparency = 1, Size = D2.fromScale(1, 1) }),
							function(use: ComposeTypes.Use): string?
								local badge = read(use(source).badge, use)
								return if badge == nil then nil else tostring(badge)
							end
						)
						runtime.decorate(corner, { Size = D2.fromScale(1, 1), AutomaticSize = E.AutomaticSize.None })
						runtime.mount(function()
							return corner
						end, glyph)
					end
					if read(spec.indicator) == "none" and style ~= "segmented" then
						local check = button:FindFirstChild("TrailingIcon", true)
						if check and check:IsA("GuiObject") then
							Compose.watch(function(use: ComposeTypes.Use)
								check.Visible = selected(use)
							end)
						end
					end
					local badgeContent = button:FindFirstChild("Content")
					if
						badgeContent
						and (
							current.badge ~= nil
							or Compose.isReadable(spec.options)
							or type(spec.options) == "function"
						)
					then
						runtime.mountFragment(function()
							return {
								Compose.show(function(use: ComposeTypes.Use)
									local badge = read(use(source).badge, use)
									return badge ~= nil and badge ~= "" and not sealed
								end, function()
									local last = tostring(read(source:peek().badge))
									return UI.Badge({
										Name = "Count",
										LayoutOrder = 900,
										label = function(use: ComposeTypes.Use): string
											local badge = read(use(source).badge, use)
											if badge ~= nil and badge ~= "" then
												last = tostring(badge)
											end
											return last
										end,
									})
								end),
							}
						end, badgeContent)
					end
					if style == "radioGroup" then
						local trailing = spec.indicatorPosition == "trailing"
						runtime.mountFragment(function()
							return {
								ctx.styled(
									Host.Frame "Indicator" {
										Size = D2.fromOffset(18, 18),
										LayoutOrder = if trailing then 1000 else 0,
										BackgroundTransparency = 1,
										ctx.corner(9) :: Types.Child,
										ctx.styled(
											Host.Frame "Dot" {
												AnchorPoint = V2.new(0.5, 0.5),
												Position = D2.fromScale(0.5, 0.5),
												Size = D2.fromOffset(8, 8),
												Visible = selected,
												ctx.corner(4) :: Types.Child,
											},
											"fill"
										) :: Types.Child,
									},
									"radio-mark"
								),
							}
						end, (assert(button:FindFirstChild("Content"), "Picker radio rows use a content row")))
					end
					if
						source:peek().indicator ~= nil
						or Compose.isReadable(spec.options)
						or type(spec.options) == "function"
					then
						local statusUI = (UI :: unknown) :: {
							StatusIndicator: Types.Constructor<MediaProps.StatusIndicatorProps, TextLabel>,
						}
						surfaces.attach(button, {
							Compose.show(function(use: ComposeTypes.Use)
								return use(source).indicator ~= nil
							end, function()
								return statusUI.StatusIndicator({
									Name = "Status",
									AnchorPoint = V2.new(1, 0.5),
									Position = D2.new(1, -8, 0.5, 0),
									status = function(use: ComposeTypes.Use): Media.Status
										local mark = use(source).indicator
										if mark == nil then
											return "neutral"
										end
										local status = read(mark.status, use)
										return if status == nil then "neutral" else status
									end,
									form = source:peek().indicator
										and (source:peek().indicator :: Nav.OptionIndicator).form,
									count = function(use: ComposeTypes.Use)
										local mark = use(source).indicator
										return if mark then read(mark.count, use) else nil
									end,
								})
							end),
						})
					end
					local underlined = Compose.isReadable(spec.indicator)
						or type(spec.indicator) == "function"
						or spec.indicator == "underline"
					surfaces.attach(button, {
						Host.UISizeConstraint({
							MinSize = function(use: ComposeTypes.Use)
								local strip = across(use)
								local width = if strip
									then math.max(
										0,
										44 - sideChrome(spec.controlSize, use, sealed and labelOf(use) == "")
									)
									else 44
								return V2.new(width, if spec.controlSize ~= nil or strip then 0 else 44)
							end,
							MaxSize = if style == "segmented"
								then function(use: ComposeTypes.Use): Vector2
									return V2.new(math.max(44, use(room) - 2 * segmentMetrics.inset), math.huge)
								end
								else nil,
						}),
						if underlined
							then Compose.show(function(use: ComposeTypes.Use)
								return read(spec.indicator, use) == "underline" and selected(use)
							end, function()
								return ctx.styled(
									Host.Frame "SelectionIndicator" {
										BorderSizePixel = 0,
										Size = D2.new(1, 0, 0, 2),
										Position = D2.new(0, 0, 1, -2),
										Selectable = false,
									},
									"selection-indicator"
								)
							end)
							else nil,
					})
					if fixed and not (Compose.isReadable(current.label) or type(current.label) == "function") then
						button:SetAttribute("FacetLabel", current.label)
					else
						Compose.watch(function(use: ComposeTypes.Use)
							button:SetAttribute("FacetLabel", read(use(source).label, use))
						end)
					end
					local family = if style == "segmented" then "facet-segment" else "facet-choice"
					button:AddTag(family)
					if style == "radioGroup" then
						wrapCaptions(button, spec.controlSize, function(use: ComposeTypes.Use): number
							return use(room) - RADIO_MARK
						end)
					end
					if style == "segmented" then
						local function peers(use: ComposeTypes.Use): number
							return #use(options)
						end
						wrapCaptions(button, spec.controlSize, function(use: ComposeTypes.Use): number
							return use(room) - 2 * segmentMetrics.inset
						end, peers)
						shared.wrapWhenLong(button :: TextButton, function(use: ComposeTypes.Use): string
							return `{use(room) - 2 * segmentMetrics.inset}|{peers(use)}`
						end, button, true)
						local caption = button:FindFirstChild("Title", true) or button:FindFirstChild("Label", true)
						local bounds = if caption and caption:IsA("TextLabel")
							then ctx.observe.TextBounds(caption)
							else ctx.observe.TextBounds(button)
						local captionUnit = ctx.layoutUnit(button)
						local extent = ctx.observe.AbsoluteSize(button)
						Compose.watch(function(use: ComposeTypes.Use)
							captionHeights[button] = use(bounds).Y / use(captionUnit)
							measureCaptions()
						end)
						segmentBoxes[button] =
							{ order = index, size = extent, at = ctx.observe.AbsolutePosition(button) }
						Compose.cleanup(function()
							captionHeights[button] = nil
							segmentBoxes[button] = nil
							measureCaptions()
						end)
					end
					local content = button:FindFirstChild("Content")
					local layout = if content then content:FindFirstChildWhichIsA("UIListLayout") else nil
					if style ~= "segmented" and layout then
						layout.HorizontalAlignment = E.HorizontalAlignment.Left
					end
					Compose.watch(function(use: ComposeTypes.Use)
						local indicator = read(spec.indicator, use)
						local current = selected(use)
							and indicator ~= "underline"
							and (indicator ~= "none" or style == "segmented")
						if current then
							button:AddTag(family .. "-current")
						elseif button:HasTag(family .. "-current") then
							button:RemoveTag(family .. "-current")
						end
						local order = use(index)
						if style ~= "segmented" then
							return
						elseif current then
							currentOrder:set(order)
						elseif currentOrder:peek() == order then
							currentOrder:set(0)
						end
					end)
					local section = source:peek().sectionTitle
					if section ~= nil and style ~= "segmented" then
						runtime.decorate(button, { LayoutOrder = 2 })
						return ctx.column({
							ctx.styled(
								ctx.text({
									Name = "SectionTitle",
									Text = function(use: ComposeTypes.Use)
										return read(section, use) or ""
									end,
								}),
								"type-caption"
							),
							button,
						}, {
							Name = "Section-" .. button.Name,
							LayoutOrder = index,
							Size = D2.new(1, 0, 0, 0),
							AutomaticSize = E.AutomaticSize.Y,
						})
					end
					return button
				end,
			})
		)
		local labelled = spec.label ~= nil and not vertical
		local strip = style == "segmented" and spec.label == nil and (spec.Size ~= nil or spec.AutomaticSize ~= nil)
		local declaredSize, declaredAutomatic = spec.Size, spec.AutomaticSize
		local function tall(use: ComposeTypes.Use): boolean
			local sizing = read(declaredAutomatic, use)
			return across(use) and (sizing == E.AutomaticSize.Y or sizing == E.AutomaticSize.XY)
		end
		local source = spec
		if strip then
			source = table.clone(spec)
			local fields = (source :: unknown) :: { [string]: unknown }
			fields.Size, fields.AutomaticSize = nil, nil
		end
		local defaults: Types.FrameNativeProps = {
			Name = "Picker",
			BackgroundTransparency = if style == "segmented" then nil else 1,
			Size = if strip
				then function(use: ComposeTypes.Use): UDim2
					local rung = ctx.controlSize(spec.controlSize, "height", use)
					local size: UDim2 = read(declaredSize, use) or D2.new(1, 0, 0, rung)
					if tall(use) then
						return D2.new(size.X.Scale, size.X.Offset, 0, rung)
					end
					return size
				end
				elseif style == "segmented" then function(use: ComposeTypes.Use): UDim2
					if not across(use) then
						return D2.new(1, 0, 0, 0)
					end
					return D2.new(if labelled then 0 else 1, 0, 0, stripHeight(use))
				end
				else D2.new(1, 0, 0, 0),
			AutomaticSize = if strip
				then function(use: ComposeTypes.Use): Enum.AutomaticSize
					local sizing: Enum.AutomaticSize = read(declaredAutomatic, use) or E.AutomaticSize.None
					if tall(use) then
						return if sizing == E.AutomaticSize.XY then E.AutomaticSize.X else E.AutomaticSize.None
					end
					if not across(use) then
						local wide = sizing == E.AutomaticSize.X or sizing == E.AutomaticSize.XY
						return if wide then E.AutomaticSize.XY else E.AutomaticSize.Y
					end
					return sizing
				end
				elseif style == "segmented" then derive(function(use: ComposeTypes.Use?)
					return if not across(use)
						then E.AutomaticSize.Y
						elseif labelled then E.AutomaticSize.X
						else E.AutomaticSize.None
				end, spec.axis)
				else E.AutomaticSize.Y,
		}
		local p = if spec.label == nil then ctx.props(source, pickerKeys, defaults) else defaults
		for _, child in children do
			table.insert((p :: unknown) :: { unknown }, child)
		end
		local ready = Compose.cell(false)
		local fieldLabel: TextLabel? = nil
		local picker: Frame
		if style == "segmented" and labelled then
			local fading = (p :: unknown) :: Types.CanvasGroupNativeProps
			fading.GroupTransparency = function(use: ComposeTypes.Use): number
				return if use(ready) then 0 else 1
			end
			picker = ctx.fade(fading)
			local settled = rest(ctx, function(): (string, boolean)
				local parts = { tostring(picker.AbsoluteSize) }
				local filled = picker.AbsoluteSize.X > 0 and picker.AbsoluteSize.Y > 0
				local caption = fieldLabel
				if caption then
					table.insert(parts, `{caption.AbsolutePosition}:{caption.AbsoluteSize}:{caption.TextBounds}`)
					filled = filled
						and caption.AbsoluteSize.X > 0
						and caption.AbsoluteSize.Y > 0
						and caption.TextBounds.X <= caption.AbsoluteSize.X
						and caption.TextBounds.Y <= caption.AbsoluteSize.Y
				end
				for button in segmentBoxes do
					table.insert(
						parts,
						`{button.AbsolutePosition}:{button.AbsoluteSize}:{(button :: TextButton).TextBounds}`
					)
					filled = filled and button.AbsoluteSize.X > 0 and button.AbsoluteSize.Y > 0
				end
				return table.concat(parts, ";"), filled
			end)
			Compose.watch(function(use: ComposeTypes.Use)
				ready:set(use(settled))
			end)
		else
			picker = Host.Frame(p)
		end
		if style == "segmented" and not vertical then
			local layout = assert(picker:FindFirstChildWhichIsA("UIListLayout", true))
			local extent = ctx.observe.AbsoluteContentSize(layout)
			local unit = ctx.layoutUnit(picker)
			local base = p.Size
			runtime.decorate(picker, {
				Size = function(use: ComposeTypes.Use): UDim2
					local size = read(base, use) or D2.new(1, 0, 0, stripHeight(use))
					if not across(use) then
						return size
					end
					local scale = use(unit)
					local height = use(extent).Y / (if scale > 0 then scale else 1)
					return D2.new(
						size.X.Scale,
						size.X.Offset,
						size.Y.Scale,
						math.max(size.Y.Offset, height + 2 * segmentMetrics.inset)
					)
				end,
			})
		end
		if not labelled then
			local width = layoutWidth(picker)
			Compose.watch(function(use: ComposeTypes.Use)
				room:set(use(width))
			end)
		end
		if style == "segmented" then
			picker:AddTag("facet-segmented")
			if spec.multiple ~= true then
				slideSelection(picker, segmentBoxes, currentOrder, (spec.indicator :: unknown) :: Types.Value<string>?)
			end
			surfaces.attach(picker, {
				Host.UISizeConstraint "TargetFloor" {
					MinSize = function(use: ComposeTypes.Use)
						local rung = if spec.controlSize ~= nil
							then ctx.controlSize(spec.controlSize, "height", use)
							else 44
						return V2.new(
							0,
							if read(spec.axis, use) == "y"
								then 0
								elseif segmentInput(use) == "Touch" then math.max(
									rung,
									44 + 2 * segmentMetrics.inset
								)
								elseif spec.controlSize ~= nil then rung
								else rung + 2 * segmentMetrics.inset
						)
					end,
				},
			})
			if spec.corners then
				surfaces.attach(picker, {
					Host.UICorner "Corners" { CornerRadius = D.new(if spec.corners == "pill" then 1 else 0, 0) },
				})
				picker:AddTag(if spec.corners == "pill" then "facet-segmented-pill" else "facet-segmented-square")
			end
			if spec.appearance ~= nil then
				Compose.watch(function(use: ComposeTypes.Use)
					local word = shared.appearanceFor("segmented", read(spec.appearance, use))
					local stroke, utility = word == "stroke", word == "utility"
					if stroke then
						picker:AddTag("facet-segmented-stroke")
					elseif picker:HasTag("facet-segmented-stroke") then
						picker:RemoveTag("facet-segmented-stroke")
					end
					if utility then
						picker:AddTag("facet-segmented-utility")
					elseif picker:HasTag("facet-segmented-utility") then
						picker:RemoveTag("facet-segmented-utility")
					end
				end)
			end
		end
		if spec.label == nil then
			return picker
		end
		picker.Name = "Options"
		local label = ctx.text({
			Name = "Label",
			Text = derive(function(use: ComposeTypes.Use?)
				return read(spec.label, use) or ""
			end, spec.label),
			Size = D2.new(if vertical then 1 else 0, 0, 0, 0),
			AutomaticSize = if vertical then E.AutomaticSize.Y else E.AutomaticSize.XY,
			TextWrapped = vertical,
			TextXAlignment = E.TextXAlignment.Left,
		})
		local outer = ctx.props(spec, pickerKeys, {
			Name = "Picker",
			BackgroundTransparency = 1,
			Size = D2.new(1, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
		})
		if vertical then
			return ctx.column({ label, picker }, outer)
		end
		fieldLabel = label
		if style == "segmented" then
			runtime.mount(function()
				return Host.UIGradient "FadePaint" {
					Transparency = function(use: ComposeTypes.Use): NumberSequence
						return ctx.types.NumberSequence.new(if use(ready) then 0 else 1)
					end,
				}
			end, label)
		end
		runtime.mount(function()
			return Host.UIFlexItem({ FlexMode = E.UIFlexMode.Grow })
		end, label)
		local row = ctx.row({ label, picker }, outer)
		local layout = assert(row:FindFirstChildWhichIsA("UIListLayout"))
		layout.VerticalAlignment = E.VerticalAlignment.Center
		layout.Padding = D.new(0, 16)
		layout.Wraps = true
		local width = layoutWidth(row)
		Compose.watch(function(use: ComposeTypes.Use)
			room:set(use(width))
		end)

		local limit = picker:FindFirstChild("TargetFloor")
		local maxSize = function(use: ComposeTypes.Use)
			return V2.new(use(width), math.huge)
		end
		if limit then
			runtime.decorate(limit, { MaxSize = maxSize })
		else
			surfaces.attach(picker, { Host.UISizeConstraint({ MaxSize = maxSize }) })
		end
		return row
	end
	return optionsStyle
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="164">
            <Properties>
              <string name="Name">nav_picker_parts</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")

export type Choice<V> = {
	isSelected: (value: V, use: ComposeTypes.Use?) -> boolean,
	select: (value: V) -> (),
	options: ComposeTypes.Readable<{ Nav.PickerOption<V> }>,
}
export type Parts = {
	keys: { string },
	appearanceFor: (style: Nav.PickerStyle, word: unknown) -> string?,
	derive: <T>(compute: (ComposeTypes.Use?) -> T, ...unknown) -> Types.Value<T>,
	layoutWidth: (node: GuiObject) -> ComposeTypes.Readable<number>,
	wrapWhenLong: (
		label: TextLabel | TextButton,
		space: (ComposeTypes.Use) -> string,
		container: GuiObject,
		truncates: boolean
	) -> (),
	sideChrome: (controlSize: Types.Value<Types.ControlSize?>?, use: ComposeTypes.Use?, glyph: boolean?) -> number,
	wrapCaptions: (
		button: GuiObject,
		controlSize: Types.Value<Types.ControlSize?>?,
		across: (ComposeTypes.Use) -> number,
		peers: ((ComposeTypes.Use) -> number)?
	) -> (),
	liveIcon: <V>(source: ComposeTypes.Readable<Nav.PickerOption<V>>) -> Types.Value<string>?,
}

return function(ctx: Types.Context, surfaces: Nav.Surfaces): Parts
	local Host, Compose, read = ctx.Host, ctx.Compose, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local function derive<T>(compute: (ComposeTypes.Use?) -> T, ...: unknown): Types.Value<T>
		for index = 1, select("#", ...) do
			local source = select(index, ...)
			if Compose.isReadable(source) or type(source) == "function" then
				return compute
			end
		end
		return compute(nil)
	end
	local function layoutWidth(node: GuiObject): ComposeTypes.Readable<number>
		local extent = ctx.observe.AbsoluteSize(node)
		local _, units = ctx.runtime.mount(function()
			return ctx.Host.Folder "Units" {
				ctx.Host.Frame "Unit" { Size = ctx.types.UDim2.fromOffset(1, 1), Visible = false },
			}
		end, node)
		local pixel = ctx.observe.AbsoluteSize((units :: Instance):FindFirstChild("Unit") :: GuiObject)
		return Compose.formula(function(use: ComposeTypes.Use): number
			local unit = (use(pixel) :: Vector2).X
			local width = (use(extent) :: Vector2).X / (if unit > 0 then unit else 1)
			return if width > 0 then width else math.huge
		end)
	end

	local function wrapWhenLong(
		label: TextLabel | TextButton,
		space: (ComposeTypes.Use) -> string,
		container: GuiObject,
		truncates: boolean
	)
		local text = label :: TextLabel
		local words, points, face =
			ctx.observe.Text(label), ctx.observeStyled.TextSize(label), ctx.observeStyled.FontFace(label)
		local fits, extent = ctx.observe.TextFits(label), ctx.observe.AbsoluteSize(container)
		local owner = assert(Compose.currentOwner(), "Facet UI.Picker wraps captions inside a Compose owner")
		local probe: TextLabel? = nil
		local restore: Enum.TextTruncate? = nil
		local boundFor, boundWidth = "", 0
		local pending: thread? = nil
		local function widestWord(): number
			if probe == nil then
				Compose.withOwner(owner, function()
					local _, measure = ctx.runtime.mount(function()
						return ctx.Host.Folder "WordMeasure" {
							ctx.Host.TextLabel "WidestWord" {
								Size = D2.fromOffset(0, 0),
								BackgroundTransparency = 1,
								TextTransparency = 1,
								Interactable = false,
								AutoLocalize = false,
								Text = "",
							},
						}
					end, container)
					probe = (measure :: Instance):FindFirstChild("WidestWord") :: TextLabel
				end)
			end
			local measuring = probe :: TextLabel
			measuring.FontFace, measuring.TextSize = face:peek() :: Font, points:peek() :: number
			measuring.Text = string.gsub(text.Text, "%s+", "\n")
			local widest = measuring.TextBounds.X
			measuring.Text = ""
			return widest
		end
		local function cancel()
			if pending and coroutine.status(pending) == "suspended" then
				task.cancel(pending)
			end
			pending = nil
		end
		local function checkWords(key: string)
			if boundFor == key and text.TextWrapped and text.TextBounds.X < widestWord() - 0.5 then
				restore = text.TextTruncate
				text.TextWrapped = false
				text.TextTruncate = E.TextTruncate.AtEnd
			end
		end
		local function recheck(key: string)
			cancel()
			if not task then
				return
			end
			local thread: thread
			thread = task.spawn(function()
				for _ = 1, 10 do
					task.wait()
					if boundFor ~= key or not text.TextWrapped then
						break
					end
					checkWords(key)
				end
				if pending == thread then
					pending = nil
				end
			end)
			if coroutine.status(thread) ~= "dead" then
				pending = thread
			end
		end
		Compose.cleanup(cancel)
		Compose.watch(function(use: ComposeTypes.Use)
			use(fits)
			local width = use(extent).X
			local inputs = `{space(use)}|{use(words)}|{use(points)}|{use(face)}`
			if text.TextWrapped or restore ~= nil then
				if inputs == boundFor and width <= boundWidth then
					if truncates then
						checkWords(inputs)
					end
					return
				end
				text.TextWrapped = false
				if restore ~= nil then
					text.TextTruncate = restore
					restore = nil
				end
			end
			if not text.TextFits then
				text.TextWrapped = true
				boundFor, boundWidth = inputs, width
				if truncates then
					recheck(inputs)
				end
			end
		end)
	end

	local function sideChrome(
		controlSize: Types.Value<Types.ControlSize?>?,
		use: ComposeTypes.Use?,
		glyph: boolean?
	): number
		local package = ctx.read(ctx.config.theme, use)
		local recipe = if package and package.chrome then package.chrome.control else nil
		local insets = if recipe then recipe.contentInsets else nil
		local side = if glyph then 0 else ctx.controlSize(controlSize, "paddingX", use)
		return math.max(side, if insets then insets.left or 0 else 0)
			+ math.max(side, if insets then insets.right or 0 else 0)
	end

	local function wrapCaptions(
		button: GuiObject,
		controlSize: Types.Value<Types.ControlSize?>?,
		across: (ComposeTypes.Use) -> number,
		peers: ((ComposeTypes.Use) -> number)?
	)
		local glyph = button:FindFirstChild("LeadingIcon", true) ~= nil
		local function room(use: ComposeTypes.Use): Vector2
			local chrome = sideChrome(controlSize, use)
				+ if glyph then ctx.controlSize(controlSize, "iconSize", use) + 8 else 0
			return V2.new(math.max(0, across(use) - chrome), math.huge)
		end
		for _, name in { "Title", "Description" } do
			local caption = button:FindFirstChild(name, true)
			if caption and caption:IsA("TextLabel") then
				surfaces.attach(caption, { Host.UISizeConstraint({ MaxSize = room }) })
				wrapWhenLong(caption, function(use: ComposeTypes.Use): string
					return `{room(use).X}|{if peers then peers(use) else 0}`
				end, button, peers ~= nil)
			end
		end
	end
	local pickerKeys = {
		"selected",
		"options",
		"style",
		"query",
		"placeholder",
		"label",
		"required",
		"multiple",
		"onChanging",
		"onChange",
		"enabled",
		"indicator",
		"axis",
		"sizing",
		"iconOnly",
		"textSize",
		"isPresented",
		"requiredMark",
		"hint",
		"errorText",
		"controlSize",
		"appearance",
		"corners",
		"maxHeight",
		"indicatorPosition",
		"valueAlignment",
	}
	local MENU_WORDS: { [string]: string } = { standard = "standard", contrast = "contrast", utility = "utility" }
	local STRIP_WORDS: { [string]: string } = { filled = "filled", stroke = "stroke", utility = "utility" }
	local function liveIcon<V>(source: ComposeTypes.Readable<Nav.PickerOption<V>>): Types.Value<string>?
		if source:peek().icon == nil then
			return nil
		end
		return function(use: ComposeTypes.Use): string
			return read(use(source).icon, use) or ""
		end
	end
	local function appearanceFor(style: Nav.PickerStyle, word: unknown): string?
		if word == nil then
			return nil
		end
		if style == "menu" or style == "navigationLink" then
			if type(word) ~= "string" or MENU_WORDS[word] == nil then
				error(
					`Facet UI.Picker: a {style} appearance is standard | contrast | utility (got {tostring(word)})`,
					0
				)
			end
		elseif style == "segmented" then
			if type(word) ~= "string" or STRIP_WORDS[word] == nil then
				error(`Facet UI.Picker: a segmented appearance is filled | stroke | utility (got {tostring(word)})`, 0)
			end
		elseif style == "automatic" then
			if type(word) ~= "string" or (MENU_WORDS[word] == nil and STRIP_WORDS[word] == nil) then
				error(
					"Facet UI.Picker: appearance is standard | contrast | utility | filled | stroke "
						.. `(got {tostring(word)})`,
					0
				)
			end
		else
			error(`Facet UI.Picker: a {style} picker takes no appearance`, 0)
		end
		return word :: string
	end
	return {
		keys = pickerKeys,
		appearanceFor = appearanceFor,
		derive = derive,
		layoutWidth = layoutWidth,
		wrapWhenLong = wrapWhenLong,
		sideChrome = sideChrome,
		wrapCaptions = wrapCaptions,
		liveIcon = liveIcon,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="165">
            <Properties>
              <string name="Name">nav_popover</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local Overlay = require("./overlay_types")
local ComposeTypes = require("../vendor/compose/core")
local parts = require("./overlay_parts")
local placement = require("./overlay_placement")
local activation = require("./activation")
local OverlayProps = require("./overlay_props")

local KEYS = {
	"isPresented",
	"onPresentedChange",
	"onDismiss",
	"trigger",
	"source",
	"content",
	"edge",
	"align",
	"gap",
	"crossOffset",
	"tail",
	"maxWidth",
	"maxHeight",
	"compact",
	"title",
	"modal",
	"cancelPolicy",
	"closeButton",
}
local MARGIN = 8
local PADDING = 8

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces): ()
	local Compose, Host, runtime, read = ctx.Compose, ctx.Host, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2

	local function finite(value: unknown): boolean
		return type(value) == "number" and value == value and math.abs(value) < math.huge
	end

	UI.Popover = ctx.construct("Popover", function(spec: OverlayProps.PopoverSpec): GuiObject
		local where = "UI.Popover"
		if spec.isPresented == nil then
			error(`Facet {where}: isPresented is required; it is the caller's boolean fact`, 0)
		end
		for _, key in { "onPresentedChange", "onDismiss" } do
			local value = (spec :: { [unknown]: unknown })[key]
			if value ~= nil and type(value) ~= "function" then
				error(`Facet {where}: {key} must be a function`, 0)
			end
		end
		if type(spec.content) ~= "function" then
			error(`Facet {where}: content must be a factory that returns the content`, 0)
		end
		if (spec.trigger == nil) == (spec.source == nil) then
			error(`Facet {where}: supply exactly one of trigger or source`, 0)
		end
		local node: GuiObject? = nil
		local rect: Overlay.Rect? = nil
		if spec.source ~= nil then
			local source = (spec.source :: unknown) :: { [string]: unknown }
			if type(source) ~= "table" then
				error(`Facet {where}: source is \{ node = GuiObject } or \{ rect = \{ x, y, w, h } }`, 0)
			end
			for key in source do
				if key ~= "node" and key ~= "rect" then
					error(`Facet {where}: unknown source option '{tostring(key)}'`, 0)
				end
			end
			if (source.node == nil) == (source.rect == nil) then
				error(`Facet {where}: source names exactly one of node or rect`, 0)
			end
			if source.rect ~= nil then
				local box = source.rect :: { [string]: unknown }
				for _, key in { "x", "y", "w", "h" } do
					if not finite(box[key]) then
						error(`Facet {where}: source.rect.{key} must be a finite number`, 0)
					end
				end
				rect = { x = box.x :: number, y = box.y :: number, w = box.w :: number, h = box.h :: number }
			else
				if not parts.instance(source.node) then
					error(`Facet {where}: source.node must be a GuiObject`, 0)
				end
				node = source.node :: GuiObject
			end
		end
		placement.assertEdge(spec.edge, where)
		placement.assertAlign(spec.align, where)
		placement.assertCrossOffset(spec.crossOffset, where)
		for _, key in { "maxWidth", "maxHeight" } do
			local value = (spec :: { [unknown]: unknown })[key]
			if value ~= nil and not (finite(value) and (value :: number) > 0) then
				error(`Facet {where}: {key} must be a positive finite number of pixels`, 0)
			end
		end
		if spec.gap ~= nil and not finite(spec.gap) then
			error(`Facet {where}: gap must be a finite number of pixels`, 0)
		end
		if spec.tail ~= nil and type(spec.tail) ~= "boolean" then
			error(`Facet {where}: tail must be true or false`, 0)
		end
		if spec.title ~= nil and not parts.bound(ctx, spec.title, "string") then
			error(`Facet {where}: title must be a string or a bound string`, 0)
		end
		if spec.modal ~= nil and type(spec.modal) ~= "boolean" then
			error(`Facet {where}: modal must be true or false`, 0)
		end
		if spec.cancelPolicy ~= nil and spec.cancelPolicy ~= "dismiss" and spec.cancelPolicy ~= "none" then
			error(`Facet {where}: cancelPolicy must be dismiss or none`, 0)
		end
		assert(
			spec.closeButton == nil or type(spec.closeButton) == "boolean",
			"Facet UI.Popover: closeButton must be a boolean"
		)
		local chrome = spec.modal == false
		local compact = if chrome then "popover" else spec.compact or "sheet"
		if compact ~= "sheet" and compact ~= "popover" then
			error(`Facet {where}: compact must be sheet or popover`, 0)
		end

		local owner = assert(Compose.currentOwner())
		local props = ctx.props(spec, KEYS, {})
		local root: GuiObject
		if spec.trigger then
			root = spec.trigger
			local native = table.clone((props :: unknown) :: { [unknown]: unknown })
			native.Name = nil
			if next(native) ~= nil then
				runtime.decorate(root, (native :: unknown) :: Types.GuiObjectNativeProps)
			end
		else
			local frame = Host.Frame(
				ctx.props(spec, KEYS, { Name = "Popover", BackgroundTransparency = 1, Size = D2.fromOffset(0, 0) })
			)
			root = frame
		end
		local name = ((props :: unknown) :: { Name: string? }).Name or "Popover"
		local function wanted(): boolean
			return read(spec.isPresented) == true
		end
		local lost = Compose.cell(false)
		local mounted = Compose.cell(true)
		local closing: Overlay.PopoverDismissReason? = nil
		local losing = false
		local disposed = false
		local presented = false
		local warned = false
		local function report(reason: Overlay.PopoverDismissReason)
			if spec.onDismiss then
				spec.onDismiss(reason)
			end
		end
		local function propose(nextValue: boolean, reason: Overlay.PopoverDismissReason): boolean
			local change = spec.onPresentedChange
			if change == nil then
				return false
			end
			if not nextValue then
				closing = reason
			end
			local accepted = false
			parts.call(change, function()
				accepted = wanted() == nextValue
				if not accepted then
					closing = nil
				end
			end, nextValue)
			return accepted
		end
		if spec.trigger then
			local trigger = spec.trigger
			local function pressed()
				if trigger.Interactable ~= false and ctx.available(trigger) then
					propose(not wanted(), "trigger")
				end
			end
			if activation.marked(trigger) then
				Compose.cleanup(activation.listen(trigger, pressed))
			else
				runtime.connect(trigger, "Activated", pressed)
			end
		end
		if node then
			local target = node
			local function check()
				local here = target.Parent ~= nil and target:FindFirstAncestorWhichIsA("LayerCollector") ~= nil
				if not here and presented and not losing then
					losing = true
					lost:set(true)
					mounted:set(false)
					losing = false
					propose(false, "anchorLost")
					closing = nil
					report("anchorLost")
					return
				end
				mounted:set(here)
			end
			runtime.connect(target, "AncestryChanged", check)
			check()
		end
		local input = surfaces.service("UserInputService")
		local preferred: ComposeTypes.Readable<Enum.PreferredInput>? = if input
				and input.GetPropertyChangedSignal
			then ctx.observe.PreferredInput(input)
			else nil
		local layerSize = Compose.cell(V2.zero)
		local layerOwner: ComposeTypes.Owner? = nil
		local function locateLayer()
			if owner.isDisposed() then
				return
			end
			if layerOwner then
				layerOwner.dispose()
			end
			local child = owner.createChild()
			layerOwner = child
			Compose.withOwner(child, function()
				local layer = surfaces.parent(root)
				if layer then
					local size = ctx.observe.AbsoluteSize(layer)
					Compose.watch(function(use: ComposeTypes.Use)
						layerSize:set(use(size))
					end)
				end
			end)
		end
		runtime.connect(root, "AncestryChanged", locateLayer)
		locateLayer()
		local route = Compose.formula(function(use: ComposeTypes.Use): "sheet" | "popover"
			if compact == "popover" then
				return "popover"
			end
			local width = use(layerSize).X
			local kind = if preferred then use(preferred) else nil
			return if kind == E.PreferredInput.Touch and width > 0 and width < 600 then "sheet" else "popover"
		end)
		local popoverTiming = ctx.motionTiming("popover")
		local sheetExit = ctx.metric("motion.durations.popoverSheetExit")
		local motion: Nav.MotionTiming = { enter = popoverTiming.enter, exit = popoverTiming.exit }
		Compose.watch(function(use: ComposeTypes.Use)
			motion.exit = if use(route) == "sheet" then sheetExit else popoverTiming.exit
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			if read(spec.isPresented, use) ~= true then
				lost:set(false)
			end
		end)
		local condition = function(use: ComposeTypes.Use): boolean
			local want = read(spec.isPresented, use) == true
			local ready = use(mounted)
			if want and not ready and not warned and node ~= nil then
				warned = true
				warn(`Facet {where}: the source node '{node.Name}' is not mounted yet; the popover waits for it`)
			end
			return want and ready and not use(lost)
		end
		local function anchored(phase: Nav.PresencePhase?): Frame
			local settled = Compose.cell(false)
			local presence = surfaces.appearance(phase, popoverTiming, settled)
			local layer = assert(surfaces.parent(root))
			local extent = ctx.observe.AbsoluteSize(layer)
			local origin = ctx.observe.AbsolutePosition(layer)
			local sourceAt: ComposeTypes.Readable<Vector2>, sourceSize: ComposeTypes.Readable<Vector2>
			local anchorNode = node or spec.trigger
			if anchorNode then
				sourceAt, sourceSize = ctx.observe.AbsolutePosition(anchorNode), ctx.observe.AbsoluteSize(anchorNode)
			else
				sourceAt, sourceSize = Compose.cell(V2.zero), Compose.cell(V2.zero)
			end
			local function safe(use: ComposeTypes.Use): Overlay.Rect
				local size = use(extent)
				return {
					x = MARGIN,
					y = MARGIN,
					w = math.max(0, size.X - 2 * MARGIN),
					h = math.max(0, size.Y - 2 * MARGIN),
				}
			end
			local content: Instance
			local contentScope = Compose.createRootOwner(function()
				content = spec.content()
			end, runtime.reactor)
			Compose.cleanup(contentScope.dispose)
			local function cap(use: ComposeTypes.Use): Vector2
				local box = safe(use)
				local width = math.min(spec.maxWidth or math.huge, box.w)
				local height = math.min(spec.maxHeight or math.huge, box.h)
				return V2.new(math.max(0, width - 2 * PADDING), math.max(0, height - 2 * PADDING))
			end
			local limit = Host.UISizeConstraint({
				MaxSize = cap,
			})
			local fills = parts.instance(content)
				and content:IsA("GuiObject")
				and content.Size.X.Scale > 0
				and content.AutomaticSize ~= E.AutomaticSize.X
				and content.AutomaticSize ~= E.AutomaticSize.XY
			local proposed = Host.UISizeConstraint({
				MinSize = function(use: ComposeTypes.Use)
					if not fills then
						return V2.zero
					end
					return V2.new(math.min(ctx.metric("controls.popup.panelWidth", use) - 2 * PADDING, cap(use).X), 0)
				end,
			})
			local list = Host.UIListLayout({ SortOrder = E.SortOrder.LayoutOrder })
			local laidOut = Compose.cell(0)
			local bodyProps: Types.ScrollingFrameNativeProps = {
				Name = "Body",
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = function(use: ComposeTypes.Use)
					return D2.fromOffset(0, math.min(use(laidOut), cap(use).Y))
				end,
				AutomaticSize = E.AutomaticSize.X,
				ScrollingDirection = E.ScrollingDirection.Y,
				ScrollBarThickness = 4,
				VerticalScrollBarInset = E.ScrollBarInset.ScrollBar,
				Selectable = false,
			}
			bodyProps[#bodyProps + 1] = limit
			local children: { Types.Child } = { list, proposed, content }
			local closeUnit = ctx.layoutUnit(layer)
			local closeContentSize = if content:IsA("GuiObject")
				then ctx.observe.AbsoluteSize(content :: GuiObject)
				else Compose.cell(V2.zero)
			local closes = spec.cancelPolicy ~= "none"
				and spec.closeButton ~= false
				and (not chrome or spec.closeButton == true)
			if closes or spec.title ~= nil then
				if content:IsA("GuiObject") then
					runtime.decorate(content, { LayoutOrder = 1 })
				end
				local header: { Types.Child } = {
					Host.UIListLayout {
						FillDirection = E.FillDirection.Horizontal,
						HorizontalAlignment = E.HorizontalAlignment.Right,
						VerticalAlignment = E.VerticalAlignment.Center,
						SortOrder = E.SortOrder.LayoutOrder,
						Padding = ctx.types.UDim.new(0, PADDING),
					} :: Types.Child,
				}
				if spec.title ~= nil then
					table.insert(
						header,
						ctx.styled(
							ctx.text({
								Name = "Title",
								LayoutOrder = 1,
								Text = function(use: ComposeTypes.Use)
									return read(spec.title, use) or ""
								end,
								TextWrapped = true,
								Size = D2.new(1, 0, 0, 0),
								AutomaticSize = E.AutomaticSize.Y,
								Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }),
							}),
							"type-heading"
						)
					)
				end
				if closes then
					table.insert(
						header,
						UI.Button "CloseCommand" {
							LayoutOrder = 2,
							Visible = function(use: ComposeTypes.Use)
								if spec.closeButton ~= nil then
									return spec.closeButton
								end
								local box = safe(use)
								local size = use(closeContentSize) :: Vector2
								local unit = use(closeUnit)
								return box.w / unit < 600
									or box.w * box.h > 0
										and (size.X + 2 * PADDING * unit) * (size.Y + 2 * PADDING * unit) >= box.w * box.h * 0.75
							end,
							name = "Close",
							icon = "close",
							appearance = "utility",
							shape = "circle" :: "circle",
							onActivate = function()
								propose(false, "cancel")
							end,
						}
					)
				end
				local row: Types.FrameNativeProps = {
					Name = "CloseHeader",
					BackgroundTransparency = 1,
					Size = D2.new(1, 0, 0, 0),
					AutomaticSize = E.AutomaticSize.Y,
					LayoutOrder = 0,
				}
				for _, child in header do
					row[#row + 1] = child
				end
				table.insert(children, Host.Frame(row))
			end
			local body, _, _, extent, bodyRested = parts.scroller(ctx, bodyProps, children, { hug = true, rest = true })
			Compose.watch(function(use: ComposeTypes.Use)
				local height = use(extent)
				if not use(bodyRested) or presence.travel(use) >= 1 then
					laidOut:set(height)
				end
			end)
			local panel = ctx.styled(
				ctx.fade({
					Name = "Panel",
					GroupTransparency = function(use: ComposeTypes.Use)
						return 1 - presence.opacity(use)
					end,
					BackgroundTransparency = 0,
					BorderSizePixel = 0,
					Size = D2.fromOffset(0, 0),
					AutomaticSize = E.AutomaticSize.XY,
					ZIndex = 2,
					body :: Instance,
					ctx.padding(PADDING, PADDING),
				}, true),
				"popover"
			)
			ctx.styled(panel, "panel")
			ctx.styled(panel, "floating")
			surfaces.skin(panel, "panel")
			local sizes, rested = surfaces.atRest(presence.travel, settled, { panel })
			local measured = sizes[1]
			local tailed = rect == nil and spec.tail ~= false
			local solved = Compose.formula(function(use: ComposeTypes.Use): placement.Placement
				local offset = use(origin)
				local source: Overlay.Rect = if rect
					then rect
					else {
						x = use(sourceAt).X - offset.X,
						y = use(sourceAt).Y - offset.Y,
						w = use(sourceSize).X,
						h = use(sourceSize).Y,
					}
				local size = use(measured)
				local side = if tailed then parts.tailSize(ctx, use) else 0
				return placement.solve({
					source = source,
					size = { w = size.X, h = size.Y },
					safe = safe(use),
					edge = spec.edge or (if preferred and use(preferred) == E.PreferredInput.Touch then "top" else nil),
					align = spec.align,
					gap = (spec.gap or 8) + side * math.sqrt(2) / 2,
					crossOffset = spec.crossOffset,
					tail = side * math.sqrt(2),
					tailInset = 8,
				})
			end)
			local scale = surfaces.popover(panel, presence.travel, function(use: ComposeTypes.Use): (Vector2, Vector2)
				local at = use(solved)
				local size = use(measured)
				local origin = if at.edge == "bottom"
					then V2.new(math.clamp((at.tailX or at.x) - at.x, 0, size.X), 0)
					elseif at.edge == "top" then V2.new(math.clamp((at.tailX or at.x) - at.x, 0, size.X), size.Y)
					elseif at.edge == "right" then V2.new(0, math.clamp((at.tailY or at.y) - at.y, 0, size.Y))
					else V2.new(size.X, math.clamp((at.tailY or at.y) - at.y, 0, size.Y))
				return V2.new(at.x, at.y), origin
			end, {
				pinned = true,
				rested = rested,
				size = measured,
				geometry = { Size = D2.fromOffset(0, 0), AutomaticSize = E.AutomaticSize.XY },
			})
			local children: { Types.Child } = { panel }
			if tailed then
				local tail = parts.tail(
					ctx,
					"Tail",
					function(use: ComposeTypes.Use): (Vector2?, string)
						local at = use(solved)
						if at.tailSuppressed or at.tailX == nil or at.tailY == nil then
							return nil, at.edge
						end
						return V2.new(at.tailX, at.tailY), at.edge
					end,
					presence.opacity,
					function(): number
						return 2
					end,
					{
						node = panel,
						scale = scale,
						corner = function(use: ComposeTypes.Use): Vector2
							local at = use(solved)
							return V2.new(at.x, at.y)
						end,
						size = measured,
						radius = function(use: ComposeTypes.Use): number
							return ctx.metric("radii.panel", use)
						end,
						role = "floating",
					}
				)
				for _, part in tail do
					table.insert(children, part)
				end
			end
			if chrome then
				return Host.Frame "Popup" {
					BackgroundTransparency = 1,
					Active = false,
					Size = D2.fromScale(1, 1),
					ZIndex = 95,
					table.unpack(children),
				}
			end
			local modal = surfaces.modal(function()
				return Host.Frame "Popup" {
					BackgroundTransparency = 1,
					Size = D2.fromScale(1, 1),
					table.unpack(children),
				}
			end, function()
				propose(false, "cancel")
			end, {
				Name = name .. "Modal",
				backgroundTransparency = 1,
				onOutside = function()
					propose(false, "outside")
				end,
				exiting = if phase then phase.exiting else nil,
				appearance = presence.opacity,
				canDismiss = spec.cancelPolicy ~= "none",
			})
			modal:SetAttribute("FacetRoute", "popover")
			Compose.cleanup(contentScope.dispose)
			return modal
		end
		local function sheeted(phase: Nav.PresencePhase?): Frame
			local build = assert(surfaces.sheetModal, "Facet UI.Popover requires the Sheet surface")
			local modal = build({
				isPresented = Compose.cell(true),
				detent = Compose.cell("hug"),
				detents = { "hug" :: Nav.SheetDetent },
				title = spec.title,
				closeButton = if spec.cancelPolicy == "none" then false else spec.closeButton,
				content = spec.content,
			}, function(reason: string): boolean
				if spec.cancelPolicy == "none" then
					return false
				end
				return propose(false, if reason == "outside" then "outside" else "cancel")
			end, phase)
			modal:SetAttribute("FacetRoute", "sheet")
			return modal
		end
		local activeModal: Frame? = nil
		local previousRect: Overlay.Rect? = nil
		local outsideTouch: InputObject? = nil
		local resetRect: RBXScriptConnection? = nil
		local frames = ctx.config.services.RunService
		if input then
			runtime.connect(input, "InputBegan", function(event: InputObject)
				local box = previousRect
				if
					box
					and event.UserInputType == E.UserInputType.Touch
					and activeModal
					and ctx.available(activeModal)
				then
					local point = event.Position
					if
						point.X < box.x - 24
						or point.X > box.x + box.w + 24
						or point.Y < box.y - 24
						or point.Y > box.y + box.h + 24
					then
						outsideTouch = event
					end
				end
			end)
			runtime.connect(input, "InputEnded", function(event: InputObject)
				if event == outsideTouch then
					outsideTouch = nil
					if
						event.UserInputState ~= E.UserInputState.Cancel
						and wanted()
						and activeModal
						and ctx.available(activeModal)
						and spec.cancelPolicy ~= "none"
					then
						propose(false, "outside")
					end
				end
			end)
		end
		Compose.cleanup(function()
			if resetRect then
				resetRect:Disconnect()
			end
		end)
		local gui = surfaces.service("GuiService")
		local pending: { string }? = nil
		local function pathTo(target: Instance?, base: Instance): { string }?
			local path: { string } = {}
			local at = target
			while at and at ~= base do
				table.insert(path, 1, at.Name)
				at = at.Parent
			end
			return if at == base then path else nil
		end
		surfaces.attach(root, {
			surfaces.overlay(root, condition, function(phase: Nav.PresencePhase?)
				presented = true
				Compose.cleanup(function()
					presented = false
					if losing then
						return
					end
					if disposed or owner.isDisposed() then
						closing = nil
						report("cancel")
						return
					end
					local reason: Overlay.PopoverDismissReason = closing or "cancel"
					closing = nil
					if wanted() and not lost:peek() then
						propose(false, "cancel")
						closing = nil
						report("cancel")
					else
						report(reason)
					end
				end)
				return Host.Folder "PopoverRoute" {
					Compose.keyed({
						from = function(use: ComposeTypes.Use): { string }
							return { use(route) }
						end,
						render = function(item: ComposeTypes.Readable<string>): Instance
							local modal = if item:peek() == "sheet" then sheeted(phase) else anchored(phase)
							activeModal = modal
							Compose.cleanup(function()
								if
									wanted()
									and preferred
									and preferred:peek() == E.PreferredInput.Touch
									and item:peek() == "popover"
								then
									local panel = modal:FindFirstChild("Panel", true) :: GuiObject?
									if panel then
										local at, size = panel.AbsolutePosition, panel.AbsoluteSize
										previousRect = { x = at.X, y = at.Y, w = size.X, h = size.Y }
										if resetRect then
											resetRect:Disconnect()
										end
										if frames then
											resetRect = frames.PreRender:Connect(function()
												previousRect = nil
												if resetRect then
													resetRect:Disconnect()
													resetRect = nil
												end
											end)
										end
									end
								end
							end)
							local restore = pending
							pending = nil
							if restore and gui then
								local found: Instance? = modal
								for _, part in restore do
									found = if found then found:FindFirstChild(part, true) else nil
								end
								if found and found:IsA("GuiObject") then
									gui.SelectedObject = found
								end
							end
							Compose.cleanup(function()
								if gui and not disposed then
									local body = modal:FindFirstChild("Body", true)
										or modal:FindFirstChild("SheetContent", true)
									local path = if body then pathTo(gui.SelectedObject, body) else nil
									if path and #path > 0 then
										pending = { path[#path] }
									end
								end
							end)
							return modal
						end,
					}),
				}
			end, { motion = motion }),
		})
		Compose.cleanup(function()
			disposed = true
		end)
		return root
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="166">
            <Properties>
              <string name="Name">nav_popover_placement</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local materialize = require("./materialize")

export type Popover = (
	GuiObject,
	Nav.Appearance,
	(ComposeTypes.Use) -> (Vector2, Vector2),
	Nav.PopoverOptions?
) -> (ComposeTypes.Use) -> number

return function(ctx: Types.Context): Popover
	local runtime = ctx.runtime
	local D2, V2 = ctx.types.UDim2, ctx.types.Vector2
	local function popover(
		panel: GuiObject,
		amount: Nav.Appearance,
		place: (ComposeTypes.Use) -> (Vector2, Vector2),
		options: Nav.PopoverOptions?
	): (ComposeTypes.Use) -> number
		local settings: Nav.PopoverOptions = options or {}
		local rested = settings.rested
		local rise = settings.rise
		local parent = ctx.observe.Parent(panel)
		local function position(use: ComposeTypes.Use, x: number, y: number): UDim2
			local container = use(parent)
			while container and not container:IsA("GuiBase2d") do
				container = container.Parent
			end
			local extent = if container and container:IsA("GuiBase2d") then container.AbsoluteSize else V2.zero
			local left, top = math.floor(x), math.floor(y)
			return D2.new(
				if extent.X > 0 then (x - left) / extent.X else 0,
				if extent.X > 0 then left else x,
				if extent.Y > 0 then (y - top) / extent.Y else 0,
				if extent.Y > 0 then top else y
			)
		end
		local function scale(use: ComposeTypes.Use): number
			if panel:HasTag("facet-menu") or panel:HasTag("facet-popover") or panel:HasTag("facet-tooltip") then
				return 1
			end
			if (rested and not use(rested)) or (rise and rise(use) ~= nil) then
				return 1
			end
			local from = settings.from or ctx.metric("motion.materialize.anchored", use)
			return from + (1 - from) * amount(use)
		end
		if settings.pinned then
			local size = settings.size or ctx.observe.AbsoluteSize(panel)
			runtime.decorate(panel, {
				AnchorPoint = function(use: ComposeTypes.Use)
					if rise and rise(use) ~= nil then
						return V2.zero
					end
					local _, origin = place(use)
					local box = use(size)
					return V2.new(
						if box.X > 0 then math.clamp(origin.X / box.X, 0, 1) else 0,
						if box.Y > 0 then math.clamp(origin.Y / box.Y, 0, 1) else 0
					)
				end,
				Position = function(use: ComposeTypes.Use)
					local at, origin = place(use)
					local distance = if rise then rise(use) else nil
					return if distance
						then position(use, at.X, at.Y + distance * (1 - amount(use)))
						else position(use, at.X + origin.X, at.Y + origin.Y)
				end,
			})
		else
			runtime.decorate(panel, {
				Position = function(use: ComposeTypes.Use)
					local at, origin = place(use)
					local distance = if rise then rise(use) else nil
					if distance then
						return position(use, at.X, at.Y + distance * (1 - amount(use)))
					end
					local shrink = 1 - scale(use)
					return position(use, at.X + origin.X * shrink, at.Y + origin.Y * shrink)
				end,
			})
		end
		materialize(ctx, panel, assert(settings.geometry), scale, function(use: ComposeTypes.Use)
			local _, point = place(use)
			local box = if settings.size then use(settings.size) else panel.AbsoluteSize
			return V2.new(if box.X > 0 then point.X / box.X else 0.5, if box.Y > 0 then point.Y / box.Y else 0.5)
		end, panel:HasTag("facet-menu") or panel:HasTag("facet-popover") or panel:HasTag("facet-tooltip"))
		return scale
	end
	return popover
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="167">
            <Properties>
              <string name="Name">nav_radial</string>
              <string name="Source"><![CDATA[--!strict
local layoutKit = require("./layout_kit")
local Types = require("./types")
local Navigation = require("./navigation_types")
local ControlTypes = require("./control_types")
local RadialProps = require("./radial_props")
local ComposeTypes = require("../vendor/compose/core")
local createMenu = require("./nav_radial_menu")
local arrangeRing = require("./nav_radial_layout")
local ArrangementTypes = require("./nav_radial_layout")
local MenuTypes = require("./nav_radial_menu")
local paintSectors = require("./nav_radial_sectors")
local buildCenter = require("./nav_radial_center")
local attachGestures = require("./nav_radial_gestures")
local createPresence = require("./nav_overlay_presence")

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Navigation.Surfaces)
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local lists = layoutKit.of(ctx)
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local build = function<V>(spec: RadialProps.RadialMenuSpec<V>): Frame
		assert(spec.items, "RadialMenu requires items")
		local menu = createMenu(ctx, surfaces, spec)
		local session = menu.session
		local opened, scrim, skin = menu.opened, menu.scrim, menu.skin
		local cancel, close, open = menu.cancel, menu.close, menu.open
		local back: () -> () = menu.back
		local isPointer = menu.isPointer
		local anchored = read(spec.anchor)
		local anchorGui = if anchored
				and (typeof(anchored) == "Instance" or (type(anchored) == "table" and anchored.IsA))
			then anchored :: GuiObject
			else nil
		local root = Host.Frame(ctx.props(spec, {
			"items",
			"label",
			"launcher",
			"icon",
			"preset",
			"appearance",
			"buttonSurface",
			"distribution",
			"navigation",
			"expansion",
			"center",
			"centerLabel",
			"centerContent",
			"centerPassThrough",
			"completion",
			"anchor",
			"follow",
			"clearance",
			"ringWidth",
			"contentFit",
			"gestureSelection",
			"enabled",
			"holdAction",
			"skin",
			"onOpen",
			"onClose",
			"isPresented",
			"transition",
			"scrim",
		}, {
			Name = "RadialMenu",
			BackgroundTransparency = 1,
			Size = D2.fromOffset(0, 0),
			AutomaticSize = if anchorGui then E.AutomaticSize.None else E.AutomaticSize.XY,
		}))
		local layoutUnit = ctx.layoutUnit(root)
		local timing = ctx.motionTiming("radial")
		local departure = createPresence(ctx).departure(timing, root, function(): boolean
			return not menu.reduced() and spec.transition ~= false
		end)
		local beginDeparture = assert(departure.exit)
		departure.exit = function(nodes): ComposeTypes.Exiting
			timing.exit = ctx.metric("motion.radial.exit")
			return beginDeparture(nodes)
		end
		if spec.launcher ~= false then
			local overAnchor: ((ComposeTypes.Use) -> UDim2)? = nil
			if anchorGui then
				local at, size = ctx.observe.AbsolutePosition(anchorGui), ctx.observe.AbsoluteSize(anchorGui)
				local own = ctx.observe.AbsolutePosition(root)
				overAnchor = function(use: ComposeTypes.Use): UDim2
					local middle = use(at) + use(size) / 2 - use(own)
					return D2.fromOffset(middle.X, middle.Y)
				end
			end
			surfaces.attach(root, {
				UI.Button "Launcher" {
					AnchorPoint = if overAnchor then V2.new(0.5, 0.5) else nil,
					Position = overAnchor,
					label = spec.label or "Quick actions",
					name = spec.label or "Quick actions",
					icon = spec.icon or (if spec.label == nil then "more" else nil),
					shape = if spec.label == nil then "circle" :: "circle" else nil,
					enabled = spec.enabled,
					InputBegan = function(input: InputObject)
						if not opened:peek() and isPointer(input) then
							open()
							session.openedByLauncher = opened:peek()
							menu.beginPointer(input, false, true)
						end
					end,
					onActivate = function(input: InputObject?)
						local echo = session.openedByLauncher and input ~= nil and isPointer(input)
						session.openedByLauncher = false
						if echo then
							return
						end
						if opened:peek() then
							close()
						else
							open()
						end
					end,
				},
			})
		end
		surfaces.attach(root, {
			surfaces.overlay(root, opened, function(phase: Navigation.PresencePhase?)
				local arrange: (Types.Context, MenuTypes.Menu<V>, Frame) -> ArrangementTypes.Arrangement<V> =
					arrangeRing
				local arrangement = arrange(ctx, menu, root)
				local paint = paintSectors(ctx, UI, surfaces, lists, menu, arrangement, phase)
				local hub = buildCenter(ctx, UI, surfaces, menu, arrangement, paint, root, layoutUnit, phase)
				attachGestures(ctx, surfaces, menu, arrangement, paint, hub)
				local viewport, origin, center, layout, fallback =
					arrangement.viewport,
					arrangement.origin,
					arrangement.center,
					arrangement.layout,
					arrangement.fallback
				local hideLauncher = hub.hideLauncher
				local modal = surfaces.modal(
					function()
						return paint.panel
					end,
					back,
					{
						appearance = function(use: ComposeTypes.Use?): number
							return 1 - if use then paint.transparency(use) else 0
						end,
					}
				)
				surfaces.attach(modal, { hub.centerHit, hub.centerNode, hub.previewPlate, hub.preview })
				if hideLauncher then
					hideLauncher()
				end
				local catcher = modal:FindFirstChild("DismissOutside")
				if catcher then
					if scrim == "dark" then
						catcher:AddTag("facet-radial-scrim")
					elseif scrim == "none" then
						local clear = catcher :: GuiObject
						clear:RemoveTag("facet-scrim")
						clear.BackgroundTransparency = 1
					end
					runtime.decorate(catcher, {
						Position = function(use: ComposeTypes.Use)
							local size = use(viewport)
							return D2.fromOffset(-size.X, -size.Y)
						end,
						Size = function(use: ComposeTypes.Use)
							local size = use(viewport)
							return D2.new(1, 2 * size.X, 1, 2 * size.Y)
						end,
					})
				end
				if spec.skin and spec.skin.background then
					skin(modal, spec.skin.background)
				end
				local bounds = ctx.observe.AbsoluteSize(modal)
				local position = ctx.observe.AbsolutePosition(modal)
				Compose.watch(function(use: ComposeTypes.Use)
					local at, size = use(position), use(bounds)
					if size.X > 0 and size.Y > 0 then
						origin:set(at)
					end
				end)
				if spec.centerPassThrough and (spec.center == "empty" or spec.center == "content") then
					local outside = modal:FindFirstChild("DismissOutside")
					if outside then
						runtime.decorate(outside, { Visible = fallback })
					end
					for _, edge in { "Top", "Bottom", "Left", "Right" } do
						local rectangle = Compose.formula(function(use: ComposeTypes.Use)
							local size, at, radius = use(viewport), use(center), use(layout).inner
							local left, right =
								math.clamp(at.X - radius, 0, size.X), math.clamp(at.X + radius, 0, size.X)
							local top, bottom =
								math.clamp(at.Y - radius, 0, size.Y), math.clamp(at.Y + radius, 0, size.Y)
							if edge == "Top" then
								return { 0, 0, size.X, top }
							end
							if edge == "Bottom" then
								return { 0, bottom, size.X, size.Y - bottom }
							end
							if edge == "Left" then
								return { 0, top, left, bottom - top }
							end
							return { right, top, size.X - right, bottom - top }
						end)
						surfaces.attach(modal, {
							Host.TextButton({
								Name = "Dismiss" .. edge,
								Text = "",
								BackgroundTransparency = 1,
								Selectable = false,
								ZIndex = 100,
								Visible = function(use: ComposeTypes.Use)
									return not use(fallback) and use(opened)
								end,
								Position = function(use: ComposeTypes.Use)
									local r = use(rectangle)
									return D2.fromOffset(r[1], r[2])
								end,
								Size = function(use: ComposeTypes.Use)
									local r = use(rectangle)
									return D2.fromOffset(r[3], r[4])
								end,
								Activated = back,
							}),
						})
					end
				end
				Compose.watch(function(use: ComposeTypes.Use)
					local size = use(bounds)
					if size.X > 0 and size.Y > 0 then
						if viewport:peek() ~= size then
							cancel()
						end
						viewport:set(size)
					end
				end)
				return modal
			end, {
				presence = departure,
			}),
		})
		Compose.watch(function(use: ComposeTypes.Use)
			local anchor = read(spec.anchor, use)
			if not use(opened) then
				cancel()
			end
			if read(spec.enabled, use) == false or (type(anchor) == "table" and anchor.visible == false) then
				close()
			end
		end)
		if spec.holdAction then
			runtime.connect(spec.holdAction, "Pressed", function()
				session.held = true
				open()
			end)
			runtime.connect(spec.holdAction, "Released", function()
				if not session.held then
					return
				end
				session.held = false
				local selected = if session.analog and session.candidateSector
					then assert(session.candidateSector)()
					else nil
				if selected then
					menu.nativeActivate(selected, nil, "hold")
				else
					cancel()
				end
			end)
		end
		local launcher = root:FindFirstChild("Launcher")
		if launcher and launcher:IsA("GuiObject") then
			skin(launcher, spec.skin and spec.skin.launcher)
		end
		return root
	end
	UI.RadialMenu = ctx.construct("RadialMenu", build)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="168">
            <Properties>
              <string name="Name">nav_radial_center</string>
              <string name="Source"><![CDATA[--!strict
local geometry = require("./nav_radial_geometry")
local placement = require("./overlay_placement")
local Types = require("./types")
local Radial = require("./radial_types")
local Navigation = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local MenuTypes = require("./nav_radial_menu")
local ArrangementTypes = require("./nav_radial_layout")
local PaintTypes = require("./nav_radial_sectors")

export type Hub<V> = {
	showCenter: (use: ComposeTypes.Use) -> boolean,
	centerNode: TextButton,
	centerHit: TextButton,
	hideLauncher: (() -> ())?,
	reachOf: (ring: Radial.Layout<V>) -> number,
	preview: TextLabel,
	previewPlate: Frame,
}

return function<V>(
	ctx: Types.Context,
	UI: MenuTypes.Controls,
	surfaces: Navigation.Surfaces,
	menu: MenuTypes.Menu<V>,
	arrangement: ArrangementTypes.Arrangement<V>,
	paint: PaintTypes.Paint<V>,
	root: Frame,
	layoutUnit: ComposeTypes.Readable<number>,
	phase: Navigation.PresencePhase?
): Hub<V>
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local spec, corner, painted = menu.spec, menu.corner, menu.painted
	local path, candidate, naming, touchPoint = menu.path, menu.candidate, menu.naming, menu.touchPoint
	local preferred = menu.preferred
	local viewport, origin, launcher, anchorSize =
		arrangement.viewport, arrangement.origin, arrangement.launcher, arrangement.anchorSize
	local center, layout, sectors, fallback =
		arrangement.center, arrangement.layout, arrangement.sectors, arrangement.fallback
	local transparency, panel = paint.transparency, paint.panel
	local ringNavigation = spec.center == "empty" or spec.center == "content"
	local function showCenter(use: ComposeTypes.Use): boolean
		if corner or use(fallback) or not ringNavigation then
			return true
		end
		for _, sector in use(sectors) do
			if sector.id == "$navigation" then
				return false
			end
		end
		return true
	end
	local function navigating(use: ComposeTypes.Use?): boolean
		return corner or ringNavigation or (if use then use(fallback) else fallback:peek())
	end
	local function centerAction()
		if navigating() or spec.center == nil or spec.center == "back" then
			menu.back()
		elseif spec.center == "root" then
			menu.jump({})
		else
			menu.close()
		end
	end
	local function hub(use: ComposeTypes.Use): number
		return if showCenter(use) then math.min(painted(use), 2 * use(layout).inner - 4) else 0
	end
	local function centerName(use: ComposeTypes.Use): string
		local depth = #use(path)
		if navigating(use) or spec.center == nil or spec.center == "back" then
			return (if navigating(use) then nil else read(spec.centerLabel, use))
				or if depth == 0 then "Close" else "Back"
		end
		return read(spec.centerLabel, use) or if spec.center == "root" then "Home" else "Close"
	end
	local function morph(use: ComposeTypes.Use): number
		return 1 - transparency(use)
	end
	local function diameter(use: ComposeTypes.Use): number
		if use(fallback) then
			return painted(use)
		end
		if corner and launcher and anchorSize then
			local extent = use(anchorSize)
			local from = math.max(painted(use), math.min(extent.X, extent.Y))
			return math.floor(painted(use) + (from - painted(use)) * (1 - morph(use)) + 0.5)
		end
		return hub(use)
	end
	local function centerAt(use: ComposeTypes.Use): UDim2
		if use(fallback) then
			return D2.new(1, -16 - painted(use) / 2, 0, 2 + painted(use) / 2)
		end
		local at = use(center)
		return D2.fromOffset(at.X, at.Y)
	end
	local hideLauncher: (() -> ())? = nil
	local centerNode = UI.Button "Center" {
		corners = "pill" :: "pill",
		appearance = "utility",
		name = centerName,
		icon = function(use: ComposeTypes.Use): string
			return if spec.center == "root" and not navigating(use)
				then "chevron.up"
				elseif centerName(use) == "Back" then "chevron.leading"
				else "close"
		end,
		Visible = showCenter,
		Position = centerAt,
		AnchorPoint = V2.new(0.5, 0.5),
		Size = function(use: ComposeTypes.Use)
			local size = diameter(use)
			return D2.fromOffset(size, size)
		end,
		AutomaticSize = E.AutomaticSize.None,
		ZIndex = 105,
		onActivate = centerAction,
	}
	local centerHit = Host.TextButton "CenterHit" {
		Text = "",
		BackgroundTransparency = 1,
		Selectable = false,
		Visible = showCenter,
		Position = centerAt,
		AnchorPoint = V2.new(0.5, 0.5),
		Size = function(use: ComposeTypes.Use)
			local size = math.max(diameter(use), (ctx.metric("targetSizes.minimum", use)))
			return D2.fromOffset(size, size)
		end,
		ZIndex = 104,
		Activated = centerAction,
	}
	if launcher and launcher:IsA("GuiObject") then
		local hidden = launcher :: GuiObject

		hideLauncher = function()
			local automatic, size = root.AutomaticSize, root.Size
			local held = automatic ~= E.AutomaticSize.None
			local extent = root.AbsoluteSize / layoutUnit:peek()
			local function show()
				hidden.Visible = true
				if held then
					root.AutomaticSize, root.Size = automatic, size
				end
			end
			if held then
				root.AutomaticSize, root.Size = E.AutomaticSize.None, D2.fromOffset(extent.X, extent.Y)
			end
			hidden.Visible = false
			if phase and corner then
				Compose.watch(function(use: ComposeTypes.Use)
					if use(phase.exiting) then
						show()
					end
				end)
			end
			Compose.cleanup(show)
		end
	end
	if corner and launcher and launcher:IsA("GuiObject") then
		local glyph = centerNode:FindFirstChild("LeadingIcon", true)
		if glyph then
			runtime.decorate(glyph, {
				ImageTransparency = function(use: ComposeTypes.Use): number
					return 1 - morph(use)
				end,
			})
		end
		surfaces.attach(centerNode, {
			ctx.icon(spec.icon or "more", {
				Name = "LauncherIcon",
				AnchorPoint = V2.new(0.5, 0.5),
				Position = D2.fromScale(0.5, 0.5),
				ImageTransparency = morph,
			}),
		})
	end
	if not corner then
		local glyph = centerNode:FindFirstChild("LeadingIcon", true)
		if glyph then
			runtime.decorate(glyph, { ImageTransparency = transparency })
		end
	end
	if spec.center == "content" and spec.centerContent and not corner then
		local node = if type(spec.centerContent) == "function" then spec.centerContent() else spec.centerContent
		runtime.decorate(node, {
			Position = function(use: ComposeTypes.Use)
				local at = use(center)
				return D2.fromOffset(at.X, at.Y)
			end,
			AnchorPoint = V2.new(0.5, 0.5),
			ZIndex = 105,
		})
		surfaces.attach(panel, { node })
	end
	menu.skin(centerNode, spec.skin and spec.skin.center)
	local panelSize = ctx.observe.AbsoluteSize(panel)
	local function reachOf(ring: Radial.Layout<V>): number
		local reach = ring.inner
		for _, sector in ring.sectors do
			reach = math.max(reach, sector.outer)
		end
		return reach
	end
	local previewBounds = Compose.cell(V2.zero)
	local function previewSize(use: ComposeTypes.Use): Vector2
		local bounds = use(previewBounds)
		return V2.new(
			math.min(240, math.max(0, use(viewport).X - 16), if bounds.X > 0 then math.ceil(bounds.X) else 240),
			math.max(ctx.metric("typography.caption.size", use) + 12, math.ceil(bounds.Y))
		)
	end
	local function previewPlace(use: ComposeTypes.Use): (UDim2, Vector2)
		local ring = use(layout)
		if ring.list then
			return D2.fromOffset(16, 40), V2.new(0, 1)
		end
		local at = use(center)
		do
			local key = use(candidate)
			local near: Radial.Sector<V>? = nil
			for _, sector in ring.sectors do
				if sector.key == key then
					near = sector
				end
			end
			local point = use(touchPoint)
			if near and (point or (preferred and use(preferred) == E.PreferredInput.Touch)) then
				local room = use(viewport)
				local contact = if point then V2.new(point.X, point.Y) - use(origin) else at + V2.new(near.x, near.y)
				local size = previewSize(use)
				local box = placement.touch(
					{ x = contact.X, y = contact.Y },
					{ w = size.X, h = size.Y },
					{ x = 8, y = 8, w = math.max(0, room.X - 16), h = math.max(0, room.Y - 16) },
					ctx.metric("targetSizes.minimum", use) + ctx.metric("space.s", use)
				)
				return D2.fromOffset(box.x + box.w / 2, box.y + box.h), V2.new(0.5, 1)
			end
			local angle = math.rad(if near then near.angle else geometry.arc(spec.preset or "donut") + 45)
			local dx, dy = math.sin(angle), -math.cos(angle)
			local reach = if near
				then math.sqrt(near.x * near.x + near.y * near.y) + math.max(44, near.size) / 2 + ctx.metric(
					"space.xs",
					use
				)
				else reachOf(ring) + ctx.metric("space.s", use)
			local function side(value: number): number
				return if value > 0.3 then 0 elseif value < -0.3 then 1 else 0.5
			end
			return D2.fromOffset(at.X + dx * reach, at.Y + dy * reach), V2.new(side(dx), side(dy))
		end
	end
	local function previewWidth(use: ComposeTypes.Use): number
		if use(touchPoint) or preferred and use(preferred) == E.PreferredInput.Touch then
			return math.min(240, math.max(0, use(viewport).X - 16))
		end
		local place, anchor = previewPlace(use)
		local x, room = place.X.Offset, use(viewport).X
		local fits = if anchor.X == 0
			then room - 8 - x
			elseif anchor.X == 1 then x - 8
			else 2 * math.min(x - 8, room - 8 - x)
		return math.max(0, math.min(240, fits))
	end
	local preview = ctx.text({
		Name = "SelectionPreview",
		Size = function(use: ComposeTypes.Use): UDim2
			if use(layout).list then
				return D2.new(1, -32 - 1.5 * painted(use), 0, 0)
			end
			return D2.fromOffset(0, 0)
		end,
		AutomaticSize = function(use: ComposeTypes.Use)
			return if use(layout).list then E.AutomaticSize.Y else E.AutomaticSize.XY
		end,
		Position = function(use: ComposeTypes.Use): UDim2
			return (previewPlace(use))
		end,
		AnchorPoint = function(use: ComposeTypes.Use): Vector2
			local _, anchor = previewPlace(use)
			return anchor
		end,
		TextXAlignment = function(use: ComposeTypes.Use)
			local _, anchor = previewPlace(use)
			return if anchor.X == 0.5
				then E.TextXAlignment.Center
				elseif anchor.X == 0 then E.TextXAlignment.Left
				else E.TextXAlignment.Right
		end,
		TextWrapped = true,
		Text = function(use: ComposeTypes.Use)
			if not use(layout).list then
				local key = if use(naming) then use(candidate) else nil
				local entries = use(sectors)
				for sectorIndex = 1, #entries do
					local sector = entries[sectorIndex]
					if sector.key == key and paint.iconic(use, sector) then
						local label = read(sector.item.label, use) or ""
						local detail = read(sector.item.description, use)
						return label .. (if detail then " · " .. detail else "")
					end
				end
				return ""
			end

			local labels: { string } = {}
			local items: { Radial.RadialItem<V> }? = read(spec.items, use)
			for _, id in use(path) do
				local found: Radial.RadialItem<V>? = nil
				local level: { Radial.RadialItem<V> } = items or {}
				for itemIndex = 1, #level do
					local item = level[itemIndex]
					if item.id == id then
						found = item
					end
				end
				if found == nil then
					break
				end
				table.insert(labels, tostring(read(found.label, use) or id))
				items = read(found.children, use)
			end
			return if #labels > 0 then table.concat(labels, " › ") else read(spec.label, use) or "Quick actions"
		end,
		ZIndex = 106,
		ctx.padding(8, 6),
	})
	preview:AddTag("facet-type-caption")
	surfaces.attach(preview, {
		Host.UISizeConstraint {
			MaxSize = function(use: ComposeTypes.Use): Vector2
				return V2.new(if use(layout).list then math.huge else previewWidth(use), math.huge)
			end,
		},
	})
	local textBounds = ctx.layoutSize(preview, layoutUnit)
	Compose.watch(function(use: ComposeTypes.Use)
		previewBounds:set(use(textBounds))
	end)
	local previewText = ctx.observe.Text(preview)
	local function previewShown(use: ComposeTypes.Use): boolean
		return use(layout).list or use(naming) and use(candidate) ~= nil and use(previewText) ~= ""
	end
	runtime.decorate(preview, { Visible = previewShown })
	local previewPlate = ctx.styled(
		Host.Frame "SelectionPlate" {
			Position = function(use: ComposeTypes.Use): UDim2
				return (previewPlace(use))
			end,
			AnchorPoint = function(use: ComposeTypes.Use): Vector2
				return select(2, previewPlace(use))
			end,
			Size = function(use: ComposeTypes.Use): UDim2
				return D2.fromOffset(previewSize(use).X, previewSize(use).Y)
			end,
			Visible = function(use: ComposeTypes.Use): boolean
				return not use(layout).list and previewShown(use)
			end,
			ZIndex = 105,
		},
		"tooltip"
	)
	return {
		showCenter = showCenter,
		centerNode = centerNode,
		centerHit = centerHit,
		hideLauncher = hideLauncher,
		reachOf = reachOf,
		preview = preview,
		previewPlate = previewPlate,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="169">
            <Properties>
              <string name="Name">nav_radial_geometry</string>
              <string name="Source"><![CDATA[--!strict

local Radial = require("./radial_types")

local geometry = {}
local pathShapes = require("./nav_path_shapes")
local slots: { [string]: number } = { N = 0, NE = 45, E = 90, SE = 135, S = 180, SW = 225, W = 270, NW = 315 }
function geometry.arc(preset: string): (number, number)
	local corners: { [string]: number } =
		{ ["top-left"] = 90, ["top-right"] = 180, ["bottom-right"] = 270, ["bottom-left"] = 0 }
	return corners[preset] or 0, if corners[preset] then 90 else 360
end
function geometry.delta(a: number, b: number): number
	return (a - b + 180) % 360 - 180
end
function geometry.sectors<V>(
	items: { Radial.RadialItem<V> },
	start: number,
	sweep: number,
	distribution: string,
	inner: number,
	outer: number
): { Radial.Sector<V> }
	local result: { Radial.Sector<V> } = {}
	local used: { [number]: boolean } = {}
	for i = 1, #items do
		local item = items[i]
		local angle: number
		local span: number
		if distribution == "compass" then
			local slot = if item.slot then slots[item.slot] else nil
			assert(slot ~= nil, "RadialMenu: compass items require slot N, NE, E, SE, S, SW, W, or NW")
			angle = slot
			assert(not used[angle], "RadialMenu: conflicting compass slot " .. tostring(item.slot))
			used[angle] = true
			span = 45
			if sweep < 360 then
				local distance = (angle - start) % 360
				span = math.min(span, 2 * distance, 2 * (sweep - distance))
				assert(span > 0, "RadialMenu: corner compass slots must be inside the arc, not on its edge")
			end
		else
			span = sweep / #items
			angle = if sweep == 360 then start + (i - 1) * span else start + (i - 0.5) * span
		end
		assert(sweep == 360 or ((angle - start) % 360 <= sweep), "RadialMenu: compass slot is outside the corner arc")
		local radius = (inner + outer) / 2
		local sector: Radial.Sector<V> = {
			id = item.id,
			item = item,
			path = {},
			key = item.id,
			index = i,
			list = false,
			angle = angle,
			span = span,
			inner = inner,
			outer = outer,
			x = math.sin(math.rad(angle)) * radius,
			y = -math.cos(math.rad(angle)) * radius,
			size = math.min(outer - inner, 2 * radius * math.sin(math.rad(math.min(span, 180) / 2)) * 0.86),
		}
		result[i] = sector
	end
	return result
end

type LabelBounds = { w: number, h: number }
type LabelFit = {
	x: number,
	y: number,
	inner: number,
	outer: number,
	angle: number,
	span: number,
	height: number,
	bounds: LabelBounds,
}
local labelFits = setmetatable({} :: { [Radial.SectorShape]: LabelFit }, { __mode = "k" })

function geometry.labelBounds(s: Radial.SectorShape, height: number): LabelBounds
	local cached = labelFits[s]
	if
		cached
		and cached.x == s.x
		and cached.y == s.y
		and cached.inner == s.inner
		and cached.outer == s.outer
		and cached.angle == s.angle
		and cached.span == s.span
		and cached.height == height
	then
		return cached.bounds
	end
	local requestedHeight = height
	local innerSquared, outerSquared = s.inner * s.inner, s.outer * s.outer
	local sine, cosine = math.sin(math.rad(s.angle)), math.cos(math.rad(s.angle))
	local halfAngle = s.span / 2 - 2
	local threshold = math.cos(math.rad(halfAngle))
	local thresholdSquared = threshold * threshold
	local function cornerFits(x: number, y: number): boolean
		local radiusSquared = x * x + y * y
		if radiusSquared > outerSquared or halfAngle < 0 then
			return false
		end
		local projection = x * sine - y * cosine
		if threshold >= 0 then
			return projection >= 0 and projection * projection >= radiusSquared * thresholdSquared
		end
		return projection >= 0 or projection * projection <= radiusSquared * thresholdSquared
	end
	local function fits(width: number, h: number): boolean
		local hx, hy = width / 2 + 3, h / 2 + 3
		local nearX, nearY = math.max(0, math.abs(s.x) - hx), math.max(0, math.abs(s.y) - hy)
		if nearX * nearX + nearY * nearY < innerSquared then
			return false
		end
		return cornerFits(s.x - hx, s.y - hy)
			and cornerFits(s.x - hx, s.y + hy)
			and cornerFits(s.x + hx, s.y - hy)
			and cornerFits(s.x + hx, s.y + hy)
	end

	if not fits(height, height) then
		local low, high = 0, height
		for _ = 1, 14 do
			local mid = (low + high) / 2
			if fits(mid, mid) then
				low = mid
			else
				high = mid
			end
		end
		height = low
	end
	local lo, hi = 0, math.min(160, s.outer * 2)
	for _ = 1, 14 do
		local mid = (lo + hi) / 2
		if fits(mid, height) then
			lo = mid
		else
			hi = mid
		end
	end
	local bounds: LabelBounds = { w = lo, h = height }
	table.freeze(bounds)
	labelFits[s] = {
		x = s.x,
		y = s.y,
		inner = s.inner,
		outer = s.outer,
		angle = s.angle,
		span = s.span,
		height = requestedHeight,
		bounds = bounds,
	}
	return (bounds :: unknown) :: LabelBounds
end

function geometry.fitContent(
	s: Radial.SectorShape,
	width: number,
	height: number,
	padding: number,
	mode: Radial.ContentFit
): Radial.SectorShape
	local fitted = table.clone(s)
	if mode == "none" then
		return fitted
	end
	local hx, hy = width / 2 + padding, height / 2 + padding
	local nx, ny = math.max(0, math.abs(s.x) - hx), math.max(0, math.abs(s.y) - hy)
	local near, far, halfAngle = math.sqrt(nx * nx + ny * ny), 0, 0
	for _, dx in { -hx, hx } do
		for _, dy in { -hy, hy } do
			local x, y = s.x + dx, s.y + dy
			far = math.max(far, math.sqrt(x * x + y * y))
			halfAngle = math.max(halfAngle, math.abs(geometry.delta(math.deg(math.atan2(x, -y)), s.angle)))
		end
	end
	if mode ~= "angular" then
		fitted.inner, fitted.outer = math.max(s.inner, near), math.min(s.outer, far)
	end
	if mode ~= "radial" then
		fitted.span = math.min(s.span, halfAngle * 2 + math.deg((s.gap or 2) / math.max(1, fitted.inner)))
	end
	return fitted
end
function geometry.hit<V>(
	sectors: { Radial.Sector<V> },
	x: number,
	y: number,
	appearance: string,
	overshoot: number?,
	previous: Radial.Sector<V>?
): Radial.Sector<V>?
	local radius = math.sqrt(x * x + y * y)
	local angle = math.deg(math.atan2(x, -y)) % 360
	local function contains(s: Radial.Sector<V>, hysteresis: number): boolean
		if radius < s.inner or radius > s.outer + (overshoot or 0) then
			return false
		end
		if appearance == "buttons" and overshoot == nil then
			return (x - s.x) ^ 2 + (y - s.y) ^ 2 <= (s.size / 2) ^ 2
		end
		return math.abs(geometry.delta(angle, s.angle)) < s.span / 2 + hysteresis
	end

	local candidate: Radial.Sector<V>?
	for i = #sectors, 1, -1 do
		local s = sectors[i]
		if contains(s, 0) then
			candidate = s
			break
		end
	end
	if candidate and previous and contains(previous, 3) then
		return previous
	end
	return candidate
end

function geometry.paint(s: Radial.SectorShape): Radial.Paint
	local halfGap = math.min((s.gap or 2) / 2, (s.inner + s.outer) / 2 * math.sin(math.rad(s.span / 4)))
	local trim = math.deg(math.asin(halfGap / ((s.inner + s.outer) / 2)))
	local start, span = s.angle - s.span / 2 + trim, s.span - 2 * trim
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	local angles = { start, start + span }
	for angle = 0, 720, 90 do
		if (angle - start) % 360 <= span then
			table.insert(angles, angle)
		end
	end
	for _, angle in angles do
		for _, radius in { s.inner, s.outer } do
			local x, y = math.sin(math.rad(angle)) * radius, -math.cos(math.rad(angle)) * radius
			minX = math.min(minX, x)
			maxX = math.max(maxX, x)
			minY = math.min(minY, y)
			maxY = math.max(maxY, y)
		end
	end

	for _, edge in { -1, 1 } do
		local a = math.rad(s.angle + edge * s.span / 2)
		for _, r in { s.inner, s.outer } do
			local x = math.sin(a) * r - edge * halfGap * math.cos(a)
			local y = -math.cos(a) * r - edge * halfGap * math.sin(a)
			minX = math.min(minX, x)
			maxX = math.max(maxX, x)
			minY = math.min(minY, y)
			maxY = math.max(maxY, y)
		end
	end
	local w, h = math.max(1, maxX - minX), math.max(1, maxY - minY)
	local points = pathShapes.arc(start, span, { radius = (s.inner + s.outer) / (s.outer * 2) })
	for _, endpoint in { { 1, -1 }, { #points, 1 } } do
		local p, edge = points[endpoint[1]], endpoint[2]
		local a = math.rad(s.angle + edge * s.span / 2)
		local r = (s.inner + s.outer) / 2
		p.x = 0.5 + (math.sin(a) * r - edge * halfGap * math.cos(a)) / (2 * s.outer)
		p.y = 0.5 + (-math.cos(a) * r - edge * halfGap * math.sin(a)) / (2 * s.outer)
		local length = math.sqrt(p.outX ^ 2 + p.outY ^ 2)
		p.outX, p.outY = math.cos(a) * length, math.sin(a) * length
		p.inX, p.inY = -p.outX, -p.outY
	end

	local outline: { pathShapes.PathPoint } = {}
	for _, radius in { s.outer, s.inner } do
		local arc = pathShapes.arc(start, span, { radius = radius / s.outer })
		for _, endpoint in { { 1, -1 }, { #arc, 1 } } do
			local p, edge = arc[endpoint[1]], endpoint[2]
			local a = math.rad(s.angle + edge * s.span / 2)
			p.x = 0.5 + (math.sin(a) * radius - edge * halfGap * math.cos(a)) / (2 * s.outer)
			p.y = 0.5 + (-math.cos(a) * radius - edge * halfGap * math.sin(a)) / (2 * s.outer)
		end
		if radius == s.inner then
			local reversed: { pathShapes.PathPoint } = {}
			for i = #arc, 1, -1 do
				local p = arc[i]
				p.inX, p.outX = p.outX, p.inX
				p.inY, p.outY = p.outY, p.inY
				table.insert(reversed, p)
			end
			arc = reversed
		end
		arc[1].inX, arc[1].inY = 0, 0
		arc[#arc].outX, arc[#arc].outY = 0, 0
		for _, p in arc do
			table.insert(outline, p)
		end
	end
	for _, curve in { points, outline } do
		for _, p in curve do
			p.x = (p.x * 2 * s.outer - s.outer - minX) / w
			p.y = (p.y * 2 * s.outer - s.outer - minY) / h
			p.inX *= 2 * s.outer / w
			p.outX *= 2 * s.outer / w
			p.inY *= 2 * s.outer / h
			p.outY *= 2 * s.outer / h
		end
	end
	return { x = minX, y = minY, w = w, h = h, points = points, outline = outline }
end
return geometry
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="170">
            <Properties>
              <string name="Name">nav_radial_gestures</string>
              <string name="Source"><![CDATA[--!strict
local geometry = require("./nav_radial_geometry")
local Types = require("./types")
local Radial = require("./radial_types")
local Navigation = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local MenuTypes = require("./nav_radial_menu")
local ArrangementTypes = require("./nav_radial_layout")
local PaintTypes = require("./nav_radial_sectors")
local HubTypes = require("./nav_radial_center")

type NavigationHold = { count: number, saved: boolean, changed: boolean, watch: RBXScriptConnection? }
local navigationHolds = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [Instance]: NavigationHold }
local function holdNavigation(gui: GuiService): () -> ()
	local hold = navigationHolds[gui]
	if hold == nil then
		local created: NavigationHold = { count = 0, saved = gui.GuiNavigationEnabled, changed = false }
		gui.GuiNavigationEnabled = false
		created.watch = gui:GetPropertyChangedSignal("GuiNavigationEnabled"):Connect(function()
			if gui.GuiNavigationEnabled then
				created.changed = true
			end
		end)
		navigationHolds[gui] = created
		hold = created
	end
	local held = hold :: NavigationHold
	held.count += 1
	local released = false
	return function()
		if released then
			return
		end
		released = true
		held.count -= 1
		if held.count == 0 then
			navigationHolds[gui] = nil
			if held.watch then
				held.watch:Disconnect()
			end
			if not held.changed and gui.GuiNavigationEnabled == false then
				gui.GuiNavigationEnabled = held.saved
			end
		end
	end
end

return function<V>(
	ctx: Types.Context,
	surfaces: Navigation.Surfaces,
	menu: MenuTypes.Menu<V>,
	arrangement: ArrangementTypes.Arrangement<V>,
	paint: PaintTypes.Paint<V>,
	hub: HubTypes.Hub<V>
)
	local Compose, runtime, read = ctx.Compose, ctx.runtime, ctx.read
	local E, V2 = ctx.types.Enum, ctx.types.Vector2
	local spec, session, appearance, gestureSelection = menu.spec, menu.session, menu.appearance, menu.gestureSelection
	local opened, path, candidate, interacting = menu.opened, menu.path, menu.candidate, menu.interacting
	local naming, touchPoint, holding = menu.naming, menu.touchPoint, menu.holding
	local cancel, nativeActivate = menu.cancel, menu.nativeActivate
	local origin, center, layout, sectors, fallback =
		arrangement.origin, arrangement.center, arrangement.layout, arrangement.sectors, arrangement.fallback
	local buttons, focus, gui, panel = paint.buttons, paint.focus, paint.gui, paint.panel
	local function choose(sector: Radial.Sector<V>?): Radial.Sector<V>?
		if sector and read(sector.item.enabled) == false then
			sector = nil
		end
		candidate:set(if sector then sector.key else nil)
		return sector
	end
	local function beyond(position: Vector3): boolean
		local ring = layout:peek()
		local at = center:peek() + origin:peek()
		return not ring.list and V2.new(position.X - at.X, position.Y - at.Y).Magnitude > hub.reachOf(ring)
	end
	session.aimPointer = function(
		position: Vector3,
		dragging: boolean?,
		beginning: boolean?
	): (Radial.Sector<V> | false)?
		if fallback:peek() then
			return false
		end
		local at = center:peek() + origin:peek()
		local x, y = position.X - at.X, position.Y - at.Y
		local magnitude = math.sqrt(x * x + y * y)
		if
			beginning
			and spec.centerPassThrough
			and (spec.center == "empty" or spec.center == "content")
			and magnitude < layout:peek().inner
		then
			return false
		end
		if dragging and gestureSelection == "direction" then
			if magnitude < 26 then
				return choose(nil)
			end
			local entries = sectors:peek()
			local last = entries[#entries]
			if not last then
				return choose(nil)
			end
			local radius = (last.inner + last.outer) / 2
			x, y = x / magnitude * radius, y / magnitude * radius
		end
		return choose(
			geometry.hit(
				sectors:peek(),
				x,
				y,
				appearance,
				if dragging then 44 else nil,
				assert(session.candidateSector)()
			)
		)
	end
	session.aimAnalog = function(value: Vector2)
		if session.capture or not opened:peek() or not ctx.available(panel) then
			return
		end
		local magnitude = value.Magnitude
		if magnitude < 0.25 then
			session.analog = false
			interacting:set(false)
			candidate:set(nil)
			return
		end
		if magnitude < 0.35 and not session.analog then
			return
		end
		local entering = not session.analog
		if entering and session.freezeCenter then
			session.freezeCenter()
		end
		session.analog = true
		interacting:set(true)
		naming:set(true)
		if fallback:peek() then
			if entering then
				candidate:set(focus.move(if value.Y > 0 then "up" else "down"))
			end
		else
			local entries = sectors:peek()
			local last = entries[#entries]
			if not last then
				return
			end
			local radius = (last.inner + last.outer) / 2
			choose(
				geometry.hit(
					entries,
					value.X / magnitude * radius,
					-value.Y / magnitude * radius,
					"wedges",
					0,
					assert(session.candidateSector)()
				)
			)
		end
		local key = candidate:peek()
		if gui and key and buttons[key] then
			gui.SelectedObject = buttons[key]
		end
	end
	runtime.connect(panel, "InputBegan", function(input: InputObject)
		menu.beginPointer(input, true)
	end)
	local inputService = surfaces.service("UserInputService")
	runtime.connect(inputService or panel, "InputChanged", function(input: InputObject)
		if
			session.capture
			and (
				input == session.capture
				or (
					session.capture.UserInputType == E.UserInputType.MouseButton1
					and input.UserInputType == E.UserInputType.MouseMovement
				)
			)
		then
			if input.UserInputState == E.UserInputState.Cancel then
				cancel()
			else
				if
					session.launcherGesture
					and not naming:peek()
					and session.heldAt
					and (input.Position - session.heldAt).Magnitude < 14
				then
					return
				end
				if session.capture.UserInputType == E.UserInputType.Touch then
					touchPoint:set(input.Position)
				end
				if session.heldAt and (input.Position - session.heldAt).Magnitude > 14 then
					holding:pause()
					if session.inspectedUntil == math.huge then
						session.inspectedUntil = nil
					end
				end
				naming:set(true)
				assert(session.aimPointer)(input.Position, true)
			end
		end
	end)
	runtime.connect(inputService or panel, "InputEnded", function(input: InputObject)
		if
			session.capture
			and (
				input == session.capture
				or (
					session.capture.UserInputType == E.UserInputType.MouseButton1
					and input.UserInputType == E.UserInputType.MouseButton1
				)
			)
		then
			if input.UserInputState == E.UserInputState.Cancel then
				cancel()
				return
			end
			local still = session.pressedAt and (input.Position - session.pressedAt).Magnitude < 8
			local outside = still and beyond(session.pressedAt :: Vector3) and beyond(input.Position)
			local launcherTap = session.launcherGesture
				and session.heldAt
				and (input.Position - session.heldAt).Magnitude < 14
			local sector = if outside or launcherTap then nil else assert(session.aimPointer)(input.Position, true)
			cancel()
			if outside then
				menu.close()
			elseif type(sector) == "table" then
				nativeActivate(sector, input, "gesture")
			end
		end
	end)
	session.returnSelection = function(change: () -> (), key: string?)
		local held = gui ~= nil and surfaces.within(gui.SelectedObject, panel)
		change()
		local button = buttons[key or (if held then focus.first() else nil) or ""]
		if held and gui and button and button.Parent then
			gui.SelectedObject = button
		end
	end
	Compose.cleanup(function()
		cancel()
		session.aimPointer, session.aimAnalog, session.candidateSector, session.freezeCenter, session.returnSelection =
			nil, nil, nil, nil, nil
	end)

	if gui then
		local release: (() -> ())? = nil
		local function let()
			if release then
				release()
				release = nil
			end
		end
		Compose.watch(function(use: ComposeTypes.Use)
			if use(opened) and release == nil then
				release = holdNavigation(gui)
			elseif not use(opened) then
				let()
			end
		end)
		Compose.cleanup(let)
	end
	Compose.watch(function(use: ComposeTypes.Use)
		local entries = use(sectors)
		local validPath = use(layout).path
		if #validPath < #path:peek() then
			menu.jump(validPath)
		end
		local wanted, found = candidate:peek(), false
		for _, sector in entries do
			if sector.key == wanted and read(sector.item.enabled, use) ~= false then
				found = true
			end
		end
		if wanted and not found then
			candidate:set(nil)
		end
	end)
	if ctx.action then
		ctx.action(
			panel,
			"RadialAim",
			{ "Thumbstick1" },
			opened,
			function() end,
			{ priority = 2200, group = "Radial", direction2D = session.aimAnalog }
		)
		ctx.action(panel, "RadialCommit", { "ButtonA", "Return" }, function(use: ComposeTypes.Use)
			return use(opened) and use(candidate) ~= nil
		end, function()
			local selected = assert(session.candidateSector)()
			nativeActivate(selected, nil, "action")
		end, { priority = 2200, group = "Radial" })
		local directionalKeys: { [ComposeTypes.FocusDirection]: { Types.ActionBinding } } = {
			left = { "Left", "DPadLeft" },
			right = { "Right", "DPadRight" },
			up = { "Up", "DPadUp" },
			down = { "Down", "DPadDown" },
		}
		local toward: { [string]: Vector2 } = {
			left = V2.new(-1, 0),
			right = V2.new(1, 0),
			up = V2.new(0, -1),
			down = V2.new(0, 1),
		}
		local function ringStep(direction: string): (string?, boolean)
			local d = toward[direction]
			local entries = {}
			for _, sector in sectors:peek() do
				if read(sector.item.enabled) ~= false then
					table.insert(entries, sector)
				end
			end
			local function aligned(v: Vector2): number
				return if v.Magnitude > 0 then v.Unit:Dot(d) else -1
			end
			local current: Radial.Sector<V>? = nil
			for _, sector in entries do
				if sector.key == candidate:peek() then
					current = sector
				end
			end
			if current == nil then
				local best, bestKey = 0, nil
				for _, sector in entries do
					local score = aligned(V2.new(sector.x, sector.y))
					if score > best then
						best, bestKey = score, sector.key
					end
				end
				return bestKey, false
			end
			local here = V2.new(current.x, current.y)
			if read(hub.showCenter) and aligned(-here) >= math.cos(math.rad(45)) then
				return nil, true
			end
			table.sort(entries, function(a, b)
				return math.atan2(a.x, -a.y) < math.atan2(b.x, -b.y)
			end)
			local at = table.find(entries, current) :: number
			local best, bestKey = 0, nil
			for _, step in { -1, 1 } do
				local neighbour = entries[(at - 1 + step) % #entries + 1]
				if neighbour ~= current then
					local score = aligned(V2.new(neighbour.x, neighbour.y) - here)
					if score > best then
						best, bestKey = score, neighbour.key
					end
				end
			end
			return bestKey, false
		end
		for direction, keys in directionalKeys do
			ctx.action(panel, "Radial-" .. direction, keys, opened, function()
				session.analog = false
				interacting:set(false)
				if fallback:peek() then
					local key = focus.move(direction :: ComposeTypes.FocusDirection)
					candidate:set(key)
					naming:set(true)
					if gui and key and buttons[key] then
						gui.SelectedObject = buttons[key]
					end
					return
				end
				local key, centre = ringStep(direction)
				if centre then
					candidate:set(nil)
					if gui then
						gui.SelectedObject = hub.centerNode
					end
					return
				end
				if key == nil then
					return
				end
				candidate:set(key)
				naming:set(true)
				if gui and buttons[key] then
					gui.SelectedObject = buttons[key]
				end
			end, { priority = 2200, capture = true, group = "Radial" })
		end
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="171">
            <Properties>
              <string name="Name">nav_radial_layout</string>
              <string name="Source"><![CDATA[--!strict
local geometry = require("./nav_radial_geometry")
local Types = require("./types")
local Radial = require("./radial_types")
local RadialProps = require("./radial_props")
local ComposeTypes = require("../vendor/compose/core")
local MenuTypes = require("./nav_radial_menu")

export type Arrangement<V> = {
	viewport: ComposeTypes.Cell<Vector2>,
	origin: ComposeTypes.Cell<Vector2>,
	launcher: Instance?,
	anchorSize: ComposeTypes.Cell<Vector2>?,
	centerTarget: ComposeTypes.Cell<Vector2>,
	following: ComposeTypes.Cell<boolean>,
	center: ComposeTypes.Formula<Vector2>,
	captionPadding: (use: ComposeTypes.Use) -> number,
	wordWidths: ComposeTypes.Cell<{ [string]: number }>,
	layout: ComposeTypes.Formula<Radial.Layout<V>>,
	sectors: ComposeTypes.Formula<{ Radial.Sector<V> }>,
	fallback: ComposeTypes.Formula<boolean>,
}

return function<V>(ctx: Types.Context, menu: MenuTypes.Menu<V>, root: Frame): Arrangement<V>
	local Compose, runtime, read = ctx.Compose, ctx.runtime, ctx.read
	local V2 = ctx.types.Vector2
	local spec: RadialProps.RadialMenuSpec<V> = menu.spec
	local session = menu.session
	local corner: boolean = menu.corner
	local ringWidth: (use: ComposeTypes.Use?) -> number? = menu.ringWidth
	local follow: string = menu.follow
	local reduced: (use: ComposeTypes.Use?) -> boolean = menu.reduced
	local glyphOnly: (item: Radial.RadialItemBase<V>) -> boolean = menu.glyphOnly
	local appearance: string = menu.appearance
	local contentFit: Radial.ContentFit = menu.contentFit
	local gestureSelection: string = menu.gestureSelection
	local interacting: ComposeTypes.Cell<boolean> = menu.interacting
	local path: ComposeTypes.Cell<{ string }> = menu.path
	local candidate: ComposeTypes.Cell<string?> = menu.candidate
	local layer = ctx.config.overlayParent :: GuiBase2d?
		or root:FindFirstAncestorWhichIsA("LayerCollector") :: GuiBase2d?
	local measured = layer ~= nil and layer.AbsoluteSize.X > 0 and layer.AbsoluteSize.Y > 0
	local viewport = Compose.cell(if measured then (layer :: GuiBase2d).AbsoluteSize else V2.new(640, 480))
	local origin = Compose.cell(if measured then (layer :: GuiBase2d).AbsolutePosition else V2.zero)
	local anchor = read(spec.anchor)
	local launcher = if anchor == nil then root:FindFirstChild("Launcher") else nil
	local focal = anchor or launcher
	local nativeAnchor = focal and (typeof(focal) == "Instance" or (type(focal) == "table" and focal.IsA))
	local anchorPosition = if nativeAnchor then ctx.observe.AbsolutePosition(focal :: GuiObject) else nil
	local anchorSize = if nativeAnchor then ctx.observe.AbsoluteSize(focal :: GuiObject) else nil
	if nativeAnchor and anchorPosition and anchorSize then
		anchorPosition:set((focal :: GuiObject).AbsolutePosition)
		anchorSize:set((focal :: GuiObject).AbsoluteSize)
	end
	local shelves: { { position: ComposeTypes.Readable<Vector2>, size: ComposeTypes.Readable<Vector2> } } = {}
	local shelf = if nativeAnchor and not corner then (focal :: Instance).Parent else nil
	while shelf and shelf ~= layer and shelf:IsA("GuiObject") do
		table.insert(shelves, {
			position = ctx.observe.AbsolutePosition(shelf :: GuiObject),
			size = ctx.observe.AbsoluteSize(shelf :: GuiObject),
		})
		shelf = shelf.Parent
	end
	local rawInner = Compose.formula(function(use: ComposeTypes.Use): number
		local inner =
			math.max(24, if type(read(spec.clearance, use)) == "number" then read(spec.clearance, use) else 40)
		local focal = read(spec.anchor, use)
		if type(focal) == "table" and type(focal.clearance) == "number" then
			inner = math.max(inner, focal.clearance)
		end
		if anchorSize then
			local extent = use(anchorSize)
			inner = math.max(inner, math.max(extent.X, extent.Y) / 2)
		end
		return inner
	end)
	local rawCenter = Compose.formula(function(use: ComposeTypes.Use)
		local size = use(viewport)
		local live = read(spec.anchor, use)
		local preset = spec.preset or "donut"
		local at = V2.new(
			if string.find(preset, "left") then 16 elseif string.find(preset, "right") then size.X - 16 else size.X / 2,
			if string.find(preset, "top") then 16 elseif string.find(preset, "bottom") then size.Y - 16 else size.Y / 2
		)
		if anchorPosition and anchorSize and (launcher == nil or use(anchorSize).X > 0) then
			at = use(anchorPosition) + use(anchorSize) / 2 - use(origin)
		elseif live and live.x and live.y then
			at = V2.new(live.x, live.y) - use(origin)
		end
		local _, sweep = geometry.arc(preset)
		if sweep < 360 then
			return at
		end
		local reach = use(rawInner) + (ringWidth(use) or 44)
		return V2.new(
			math.clamp(at.X, reach + 12, math.max(reach + 12, size.X - reach - 12)),
			math.clamp(at.Y, reach + 20, math.max(reach + 20, size.Y - reach - 20))
		)
	end)
	local centerTarget = Compose.cell(rawCenter:peek())
	local innerTarget = Compose.cell(rawInner:peek())
	Compose.watch(function(use: ComposeTypes.Use)
		local at, inner = use(rawCenter), use(rawInner)
		if follow ~= "fixed" and (follow == "always" or not use(interacting)) then
			centerTarget:set(at)
			innerTarget:set(inner)
		end
	end)
	local frozenCenter = Compose.cell(centerTarget:peek())
	local centerSpring = ctx.motionSpring("quick")
	local movingCenter = runtime.spring(function(use: ComposeTypes.Use)
		return use(centerTarget)
	end, { period = centerSpring.period, damping = centerSpring.damping })
	local following = Compose.cell(false)
	local center = Compose.formula(function(use: ComposeTypes.Use)
		if use(interacting) and follow ~= "always" then
			return use(frozenCenter)
		end
		return if reduced(use) or not use(following) then use(centerTarget) else use(movingCenter)
	end)
	session.freezeCenter = function()
		frozenCenter:set(center:peek())
	end
	local function captionPadding(use: ComposeTypes.Use): number
		local package = read(ctx.config.theme, use)
		local skin = package and package.chrome and package.chrome.control
		local insets = skin and skin.contentInsets
		return 2 * ctx.controlSize(nil, "paddingX", use)
			+ (if insets then insets.left or 0 else 0)
			+ (if insets then insets.right or 0 else 0)
	end

	local wordWidths: ComposeTypes.Cell<{ [string]: number }> = Compose.cell({})
	local function solve(use: ComposeTypes.Use, flatten: boolean): Radial.Layout<V>
		local size, at, inner = use(viewport), use(centerTarget), use(innerTarget)
		local start, sweep = geometry.arc(spec.preset or "donut")
		local room = if sweep == 360
			then math.min(at.X - 12, size.X - at.X - 12, at.Y - 20, size.Y - at.Y - 20)
			else math.min(size.X - 28, size.Y - 28)
		local minimum = ctx.metric("targetSizes.minimum", use)
		for _, space in shelves do
			local position, extent = use(space.position) - use(origin), use(space.size)
			local fit = math.min(
				at.X - position.X,
				position.X + extent.X - at.X,
				at.Y - position.Y,
				position.Y + extent.Y - at.Y
			)
			if fit >= inner + minimum then
				room = math.min(room, fit)
				break
			end
		end
		local radius = math.max(inner + 1, math.min(240, room))
		local band = math.max(minimum, radius - inner)
		local floor = math.min(band, math.max(minimum, ringWidth(use) or 0))
		local items = read(spec.items, use)
		local prefix: { string } = {}
		local levels: { { Radial.Sector<V> } } = {}
		local ring = inner
		local padding = ctx.metric("space.s", use)
		local textSize = ctx.metric("typography.control.size", use)
		local iconSize = ctx.controlSize(nil, "iconSize", use)
		local function estimate(item: Radial.RadialItemBase<V>): (number, number)
			if glyphOnly(item) then
				return iconSize, iconSize
			end
			local label = read(item.label, use) or ""
			return (utf8.len(label) or #label) * textSize * 0.6 + captionPadding(use), textSize
		end
		local navigation, expansion = spec.navigation or "replace", spec.expansion or "fan"
		local currentStart, currentSweep = start, sweep
		local replaced = 0
		local function append(): { Radial.Sector<V> }
			local shown: { Radial.RadialItem<V> } = {}
			local seen: { [string]: boolean } = {}
			for _, item in items do
				assert(type(item.id) == "string" and not seen[item.id], "RadialMenu items require unique ids per level")
				seen[item.id] = true
				assert(not (item.checked and item.selected), "RadialMenu state items require checked or selected")
				assert(
					not ((item.checked or item.selected) and (item.children or item.onSelect)),
					"RadialMenu state items use onChange"
				)
				if read(item.hidden, use) ~= true then
					table.insert(shown, item)
				end
			end
			if spec.center and spec.center ~= "back" and not corner and #prefix == #use(path) then
				local navigationItem: Radial.RadialItemBase<V> & { checked: nil?, selected: nil?, value: nil?, onChange: nil? } =
					{
						id = "$navigation",
						label = if #prefix > 0 then "Back" else "Close",
						icon = if #prefix > 0 then "chevron.leading" else "close",
						labelStyle = "icon" :: "icon",
					}
				if #prefix == 0 and spec.distribution == "compass" then
					local slots: { [string]: boolean } = {}
					for _, item in shown do
						if item.slot then
							slots[item.slot] = true
						end
					end
					local compassSlots: { Radial.CompassSlot } = { "SW", "S", "SE", "NW", "W", "E", "NE", "N" }
					for _, slot in compassSlots do
						if not slots[slot] then
							navigationItem.slot = slot :: Radial.CompassSlot
							break
						end
					end
					if navigationItem.slot then
						table.insert(shown, navigationItem)
					end
				else
					table.insert(shown, navigationItem)
				end
			end
			local ri = ring
			local distribution = if #prefix == 0 then spec.distribution or "even" else "even"
			local levelStart = currentStart
			local last = shown[#shown]
			if last and last.id == "$navigation" and distribution == "even" and currentSweep == 360 then
				levelStart = 225 - (#shown - 1) * 360 / #shown
			end
			local levelBand = band
			do
				local extent, target = 0, 0
				for _, probe in geometry.sectors(shown, levelStart, currentSweep, distribution, ri, ri + 1) do
					local width, height = estimate((probe.item :: unknown) :: Radial.RadialItemBase<V>)
					local ux, uy = math.sin(math.rad(probe.angle)), -math.cos(math.rad(probe.angle))
					local hw, hh = width / 2 + padding, height / 2 + padding
					local middle = ri + math.abs(hw * ux) + math.abs(hh * uy)
					for _, dx in { -hw, hw } do
						for _, dy in { -hh, hh } do
							local x, y = middle * ux + dx, middle * uy + dy
							extent = math.max(extent, math.sqrt(x * x + y * y) - ri)
						end
					end
					local chord = 2 * math.sin(math.rad(math.min(probe.span, 180) / 2)) * 0.86
					target = math.max(target, 2 * (math.max(minimum, width, height) / chord - ri))
				end
				local wanted = 2 * math.ceil(math.max(extent, target) / 2)
				levelBand = math.clamp(math.max(wanted, replaced), floor, band)
			end
			ring = ri + levelBand + 4
			local sectors = geometry.sectors(shown, levelStart, currentSweep, distribution, ri, ri + levelBand)
			for _, sector in sectors do
				sector.path = table.clone(prefix)
				sector.key = table.concat(prefix, "/") .. "/" .. sector.id
			end
			table.insert(levels, sectors)
			return sectors
		end
		local current = append()
		for _, id in use(path) do
			local parent: Radial.Sector<V>?
			for sectorIndex = 1, #current do
				local sector = current[sectorIndex]
				if sector.id == id and read(sector.item.enabled, use) ~= false then
					parent = sector
					break
				end
			end
			if not parent or not parent.item.children then
				break
			end
			navigation = if flatten then "replace" else parent.item.navigation or navigation
			expansion = parent.item.expansion or expansion
			table.insert(prefix, id)
			items = read(parent.item.children, use)
			replaced = if navigation == "replace" then parent.outer - parent.inner else 0
			if navigation == "replace" then
				levels, ring = {}, inner
				currentStart, currentSweep = start, sweep
			elseif expansion == "fan" then
				currentSweep = math.min(sweep, math.max(parent.span, #items * 32))
				currentStart = parent.angle - currentSweep / 2
				if sweep < 360 then
					currentStart = math.clamp(currentStart, start, start + sweep - currentSweep)
				end
			else
				currentStart, currentSweep = start, sweep
			end
			current = append()
		end
		local result: { Radial.Sector<V> } = {}
		local list = room < inner + band or band < minimum
		for levelIndex = 1, #levels do
			local level = levels[levelIndex]
			for sectorIndex = 1, #level do
				local sector = level[sectorIndex]
				list = list or sector.size < 44 or sector.outer > room
				if
					appearance == "wedges"
					and not sector.item.icon
					and not glyphOnly(sector.item)
					and contentFit ~= "none"
				then
					local width, height = estimate(sector.item)
					local bounds = geometry.labelBounds(sector, height)
					local captionReady = (use(wordWidths)[sector.key] or 0) > 0
					list = list or room - inner < width or (captionReady and (bounds.w < width or bounds.h < height))
				end
				table.insert(result, sector)
			end
		end
		list = list and gestureSelection ~= "direction"
		if list then
			result = {}
			for _, sector in current do
				if sector.id ~= "$navigation" then
					table.insert(result, sector)
				end
			end
		end
		for index, sector in result do
			sector.index, sector.list = index, list
		end
		return { sectors = result, list = list, inner = inner, path = prefix }
	end
	local layout = Compose.formula(function(use: ComposeTypes.Use): Radial.Layout<V>
		local stacked = solve(use, false)
		if not stacked.list or #use(path) == 0 then
			return stacked
		end
		local flat = solve(use, true)
		return if flat.list then stacked else flat
	end)
	local sectors = Compose.formula(function(use: ComposeTypes.Use)
		return use(layout).sectors
	end)
	local fallback = Compose.formula(function(use: ComposeTypes.Use)
		return use(layout).list
	end)
	session.candidateSector = function()
		local entries = sectors:peek()
		for sectorIndex = 1, #entries do
			local sector = entries[sectorIndex]
			if sector.key == candidate:peek() then
				return sector
			end
		end
		return nil
	end
	return {
		viewport = viewport,
		origin = origin,
		launcher = launcher,
		anchorSize = anchorSize,
		centerTarget = centerTarget,
		following = following,
		center = center,
		captionPadding = captionPadding,
		wordWidths = wordWidths,
		layout = layout,
		sectors = sectors,
		fallback = fallback,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="172">
            <Properties>
              <string name="Name">nav_radial_menu</string>
              <string name="Source"><![CDATA[--!strict
local reducedMotion = require("./motion").reduced
local geometry = require("./nav_radial_geometry")
local adaptive = require("./adaptive")
local Types = require("./types")
local Radial = require("./radial_types")
local Navigation = require("./navigation_types")
local ControlTypes = require("./control_types")
local RadialProps = require("./radial_props")
local ComposeTypes = require("../vendor/compose/core")

local HOLD = 0.4

export type Controls = ControlTypes.BuilderControls
export type Session<V> = {
	branchOrigin: { path: string, shape: Radial.SectorShape }?,
	capture: InputObject?,
	pressedAt: Vector3?,
	heldAt: Vector3?,
	inspectedUntil: number?,
	analog: boolean,
	held: boolean,
	suppressedInput: InputObject?,
	suppressedUntil: number?,
	suppressedKey: string?,
	suppressedSource: string?,
	openedByLauncher: boolean,
	launcherGesture: boolean,
	aimPointer: ((Vector3, boolean?, boolean?) -> Radial.Sector<V>? | false)?,
	aimAnalog: ((Vector2) -> ())?,
	candidateSector: (() -> Radial.Sector<V>?)?,
	freezeCenter: (() -> ())?,
	returnSelection: ((() -> (), string?) -> ())?,
}
export type Menu<V> = {
	spec: RadialProps.RadialMenuSpec<V>,
	session: Session<V>,
	preferred: ComposeTypes.Cell<Enum.PreferredInput>?,
	painted: (use: ComposeTypes.Use?) -> number,
	appearance: string,
	glyphOnly: (item: Radial.RadialItemBase<V>) -> boolean,
	follow: string,
	gestureSelection: string,
	contentFit: Radial.ContentFit,
	scrim: string,
	corner: boolean,
	ringWidth: (use: ComposeTypes.Use?) -> number?,
	reduced: (use: ComposeTypes.Use?) -> boolean,
	opened: ComposeTypes.Cell<boolean>,
	path: ComposeTypes.Cell<{ string }>,
	candidate: ComposeTypes.Cell<string?>,
	interacting: ComposeTypes.Cell<boolean>,
	naming: ComposeTypes.Cell<boolean>,
	touchPoint: ComposeTypes.Cell<Vector3?>,
	holding: Types.Playback,
	jump: (entries: { string }) -> (),
	cancel: () -> (),
	close: () -> (),
	open: () -> (),
	back: () -> (),
	nativeActivate: (sector: Radial.Sector<V>?, input: InputObject?, source: string?) -> (),
	pointing: () -> boolean,
	isPointer: (input: InputObject) -> boolean,
	beginPointer: (input: InputObject, onPanel: boolean?, fromLauncher: boolean?) -> (),
	skin: (node: GuiObject, definition: Radial.SkinImages?, selected: Types.Value<boolean>?) -> (),
}

return function<V>(ctx: Types.Context, surfaces: Navigation.Surfaces, spec: RadialProps.RadialMenuSpec<V>): Menu<V>
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2 = ctx.types.Enum, ctx.types.UDim2
	local input = surfaces.service("UserInputService")
	local preferred = if input and input.GetPropertyChangedSignal then ctx.observe.PreferredInput(input) else nil
	local distant = ctx.tenFoot()
	local function painted(use: ComposeTypes.Use?): number
		return if distant(use) then 32 * adaptive.TEN_FOOT_SCALE else 32
	end
	local function choice<T>(value: T?, fallback: T, choices: { T }, name: string): T
		local selected = if value == nil then fallback else value
		assert(table.find(choices, selected), "RadialMenu invalid " .. name)
		return selected
	end
	local appearance = choice(spec.appearance, "wedges", { "wedges", "buttons" }, "appearance")
	local function glyphOnly(item: Radial.RadialItemBase<V>): boolean
		local icon = item.icon ~= nil or (item.compactLabel ~= nil and item.compactLabel.icon ~= nil)
		return icon
			and (
				item.labelStyle == "icon"
				or (item.compactLabel ~= nil and item.compactLabel.prefer == true)
				or appearance == "buttons"
			)
	end
	local follow = choice(spec.follow, "idle", { "idle", "always", "fixed" }, "follow")
	local gestureSelection = choice(spec.gestureSelection, "bounded", { "bounded", "direction" }, "gestureSelection")
	local contentFit: Radial.ContentFit = spec.contentFit or "radial"
	choice(contentFit, "radial", { "both", "radial", "angular", "none" }, "contentFit")
	choice(spec.navigation, "replace", { "replace", "expand" }, "navigation")
	choice(spec.expansion, "fan", { "fan", "ring" }, "expansion")
	choice(spec.center, "back", { "back", "root", "close", "content", "empty" }, "center")
	choice(spec.completion, "close", { "close", "back", "root", "stay" }, "completion")
	choice(spec.buttonSurface, "native", { "native", "none" }, "buttonSurface")
	local scrim = choice(spec.scrim, "none", { "dark", "light", "none" }, "scrim")
	local _, presetSweep = geometry.arc(spec.preset or "donut")
	local corner = presetSweep < 360
	local function ringWidth(use: ComposeTypes.Use?): number?
		local width = read(spec.ringWidth, use)
		if width == nil or type(width) == "number" then
			return width
		end
		assert(
			width == "narrow" or width == "regular" or width == "wide",
			"RadialMenu ringWidth must be a number of pixels or narrow, regular or wide"
		)
		return ctx.metric("controls.radial." .. width, use)
	end
	local motionReduced = reducedMotion(ctx)
	local function reduced(use: ComposeTypes.Use?): boolean
		return spec.transition == false or motionReduced(use)
	end
	local function validate(
		items: { Radial.RadialItem<V> },
		use: ComposeTypes.Use,
		ancestors: { [{ Radial.RadialItem<V> }]: boolean }
	)
		assert(type(items) == "table" and not ancestors[items], "RadialMenu requires an acyclic item tree")
		ancestors[items] = true
		local ids: { [string]: boolean } = {}
		for _, item in items do
			assert(
				type(item.id) == "string" and item.id ~= "$navigation" and not ids[item.id],
				"RadialMenu requires unique nonreserved item ids"
			)
			ids[item.id] = true
			choice(item.completion, "close", { "stay", "back", "root", "close" }, "item completion")
			choice(item.navigation, "replace", { "replace", "expand" }, "item navigation")
			choice(item.expansion, "fan", { "fan", "ring" }, "item expansion")
			assert(not (item.children and item.onSelect), "RadialMenu items use children or onSelect")
			if item.children then
				validate(read(item.children, use), use, ancestors)
			end
		end
		ancestors[items] = nil
	end
	Compose.watch(function(use: ComposeTypes.Use)
		validate(read(spec.items, use), use, {})
	end)
	local opened: ComposeTypes.Cell<boolean> = spec.isPresented or Compose.cell(spec.launcher == false)
	local path: ComposeTypes.Cell<{ string }> = Compose.cell({})
	local candidate: ComposeTypes.Cell<string?> = Compose.cell(nil :: string?)
	local session: Session<V> = { analog = false, held = false, openedByLauncher = false, launcherGesture = false }
	local origins: { [string]: Radial.SectorShape } = {}
	local function jump(entries: { string })
		session.branchOrigin = nil
		path:set(entries)
	end
	Compose.watch(function(use: ComposeTypes.Use)
		if not use(opened) then
			session.branchOrigin = nil
		end
	end)
	local interacting = Compose.cell(false)
	local naming = Compose.cell(false)
	local touchPoint: ComposeTypes.Cell<Vector3?> = Compose.cell(nil :: Vector3?)
	local holding = runtime.timeline({ duration = HOLD, autoplay = false })
	local function cancel()
		if session.inspectedUntil == math.huge then
			session.inspectedUntil = os.clock() + 0.3
		end
		session.capture, session.analog, session.launcherGesture = nil, false, false
		interacting:set(false)
		naming:set(false)
		touchPoint:set(nil)
		holding:pause()
		candidate:set(nil)
	end
	Compose.watch(function(use: ComposeTypes.Use)
		if
			use(holding.completed)
			and session.capture
			and not session.launcherGesture
			and session.capture.UserInputType == E.UserInputType.Touch
		then
			naming:set(true)
			session.inspectedUntil = math.huge
		end
	end)
	local function close()
		if not opened:peek() then
			return
		end
		opened:set(false)
		jump({})
		cancel()
		if spec.onClose then
			spec.onClose()
		end
	end
	local function open()
		if read(spec.enabled) == false or opened:peek() then
			return
		end
		local anchor = read(spec.anchor)
		if type(anchor) == "table" and anchor.visible == false then
			return
		end
		opened:set(true)
		if spec.onOpen then
			spec.onOpen()
		end
	end
	local function back()
		cancel()
		local entries = table.clone(path:peek())
		if #entries == 0 then
			close()
		else
			local leaving = table.concat(path:peek(), "/")
			local popped = table.remove(entries)
			local shape = origins[leaving]
			session.branchOrigin = if shape then { path = table.concat(entries, "/"), shape = shape } else nil
			local function change()
				path:set(entries)
				candidate:set(nil)
			end
			if session.returnSelection then
				session.returnSelection(change, table.concat(entries, "/") .. "/" .. tostring(popped))
			else
				change()
			end
		end
	end
	local function activate(sector: Radial.Sector<V>?)
		if not sector or not opened:peek() then
			return
		end
		local item = sector.item
		if read(spec.enabled) == false or read(item.enabled) == false or read(item.hidden) == true then
			return
		end
		cancel()
		if item.id == "$navigation" then
			back()
			return
		end
		if item.children then
			local entries = table.clone(sector.path)
			table.insert(entries, item.id)
			local key = table.concat(entries, "/")
			session.branchOrigin = { path = key, shape = sector :: Radial.SectorShape }
			origins[key] = sector :: Radial.SectorShape
			local function change()
				path:set(entries)
				candidate:set(nil)
			end
			if session.returnSelection then
				session.returnSelection(change)
			else
				change()
			end
			return
		end
		local state = item.checked or item.selected
		local completion = item.completion
			or (if item.dismiss == false then "stay" elseif item.dismiss == true then "close" else spec.completion)
			or (if state then "stay" else "close")
		if completion == "close" then
			close()
		elseif completion == "root" then
			jump({})
		elseif completion == "back" then
			back()
		end
		if item.checked then
			local value = not item.checked:peek()
			item.checked:set(value)
			if item.onChange then
				item.onChange(value)
			end
		elseif item.selected then
			if item.selected:peek() ~= item.value then
				item.selected:set(item.value)
				if item.onChange then
					item.onChange(item.value)
				end
			end
		else
			local select: (() -> ())? = item.onSelect
			if select then
				select()
			end
		end
	end
	local function nativeActivate(sector: Radial.Sector<V>?, input: InputObject?, source: string?)
		if not sector then
			return
		end
		source = source or "native"
		if
			session.inspectedUntil
			and os.clock() < session.inspectedUntil
			and input
			and input.UserInputType == E.UserInputType.Touch
		then
			return
		end
		if
			session.suppressedUntil
			and os.clock() < session.suppressedUntil
			and session.suppressedKey == sector.key
			and session.suppressedSource ~= source
			and (input == nil or session.suppressedInput == nil or input == session.suppressedInput)
		then
			return
		end
		session.suppressedInput, session.suppressedUntil, session.suppressedKey, session.suppressedSource =
			input, os.clock() + 0.3, sector.key, source
		activate(sector)
	end
	local function pointing(): boolean
		local input = surfaces.service("UserInputService") :: UserInputService?
		return touchPoint:peek() == nil
			and (preferred == nil or preferred:peek() ~= E.PreferredInput.Touch)
			and input ~= nil
			and type(input.GetLastInputType) == "function"
			and input:GetLastInputType() == E.UserInputType.MouseMovement
	end
	local function isPointer(input: InputObject): boolean
		return input.UserInputType == E.UserInputType.MouseButton1 or input.UserInputType == E.UserInputType.Touch
	end
	local function beginPointer(input: InputObject, onPanel: boolean?, fromLauncher: boolean?)
		if not session.capture and opened:peek() and isPointer(input) and session.aimPointer then
			session.suppressedInput, session.suppressedUntil, session.inspectedUntil = nil, nil, nil
			if not fromLauncher and session.aimPointer(input.Position, false, true) == false then
				return
			end
			session.capture, session.pressedAt, session.heldAt =
				input, if onPanel then input.Position else nil, input.Position
			session.launcherGesture = fromLauncher == true
			if input.UserInputType == E.UserInputType.Touch then
				touchPoint:set(input.Position)
				holding:restart()
			end
			if session.freezeCenter then
				session.freezeCenter()
			end
			interacting:set(true)
		end
	end
	local function skin(node: GuiObject, definition: Radial.SkinImages?, selected: Types.Value<boolean>?)
		if not definition then
			return
		end
		local guiState = ctx.observe.GuiState(node)
		surfaces.attach(node, {
			Host.ImageLabel "RadialSkin" {
				Size = D2.fromScale(1, 1),
				BackgroundTransparency = 1,
				ZIndex = node.ZIndex - 1,
				Image = function(use: ComposeTypes.Use)
					local state = use(guiState)
					return (
						if state == E.GuiState.Press
							then definition.pressed
							elseif state == E.GuiState.Hover then definition.hover
							elseif selected and read(selected, use) then definition.selected
							else nil
					)
						or definition.default
						or ""
				end,
			},
		})
	end
	return {
		spec = spec,
		session = session,
		preferred = preferred,
		painted = painted,
		appearance = appearance,
		glyphOnly = glyphOnly,
		follow = follow,
		gestureSelection = gestureSelection,
		contentFit = contentFit,
		scrim = scrim,
		corner = corner,
		ringWidth = ringWidth,
		reduced = reduced,
		opened = opened,
		path = path,
		candidate = candidate,
		interacting = interacting,
		naming = naming,
		touchPoint = touchPoint,
		holding = holding,
		jump = jump,
		cancel = cancel,
		close = close,
		open = open,
		back = back,
		nativeActivate = nativeActivate,
		pointing = pointing,
		isPointer = isPointer,
		beginPointer = beginPointer,
		skin = skin,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="173">
            <Properties>
              <string name="Name">nav_radial_sectors</string>
              <string name="Source"><![CDATA[--!strict
local geometry = require("./nav_radial_geometry")
local layoutKit = require("./layout_kit")
local Types = require("./types")
local Radial = require("./radial_types")
local Navigation = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local MenuTypes = require("./nav_radial_menu")
local ArrangementTypes = require("./nav_radial_layout")

export type Paint<V> = {
	transparency: (use: ComposeTypes.Use) -> number,
	buttons: { [string]: TextButton },
	iconic: (use: ComposeTypes.Use, live: Radial.Sector<V>) -> boolean,
	focus: ComposeTypes.FocusScope<string>,
	gui: GuiService?,
	panel: ScrollingFrame,
}

return function<V>(
	ctx: Types.Context,
	UI: MenuTypes.Controls,
	surfaces: Navigation.Surfaces,
	lists: layoutKit.Kit,
	menu: MenuTypes.Menu<V>,
	arrangement: ArrangementTypes.Arrangement<V>,
	phase: Navigation.PresencePhase?
): Paint<V>
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local spec, session = menu.spec, menu.session
	local reduced, appearance = menu.reduced, menu.appearance
	local contentFit: Radial.ContentFit = menu.contentFit
	local preferred, candidate, naming = menu.preferred, menu.candidate, menu.naming
	local following, center = arrangement.following, arrangement.center
	local captionPadding, wordWidths, sectors, fallback =
		arrangement.captionPadding, arrangement.wordWidths, arrangement.sectors, arrangement.fallback
	local entry = runtime.timeline({ duration = ctx.metric("motion.radial.enter") })
	Compose.watch(function(use: ComposeTypes.Use)
		use(arrangement.centerTarget)
		if entry.completed:peek() then
			following:set(true)
		end
	end)
	local spreadFrom = ctx.metric("motion.materialize.radialSpread")
	local fading = runtime.tween(function(use: ComposeTypes.Use)
		return if phase and use(phase.exiting) then 1 else 0
	end, { seconds = ctx.metric("motion.radial.exit") })
	local function spread(use: ComposeTypes.Use): number
		if reduced(use) then
			return 1
		end
		local present = ctx.motionEase("present", use)
		local shown = present(use(entry.progress)) * (1 - present(use(fading)))
		return spreadFrom + (1 - spreadFrom) * shown
	end
	local function transparency(use: ComposeTypes.Use): number
		if reduced(use) then
			return 0
		end
		return math.max(1 - use(entry.progress), use(fading))
	end
	local buttons: { [string]: TextButton } = {}
	local ringFits: ComposeTypes.Cell<{ [string]: { ring: number, inner: number, outer: number } }> = Compose.cell({})
	local fittedWidths: ComposeTypes.Cell<{ [string]: number }> = Compose.cell({})
	local function iconic(use: ComposeTypes.Use, live: Radial.Sector<V>): boolean
		if live.list then
			return false
		end
		if menu.glyphOnly(live.item) then
			return true
		end
		local item = live.item
		local icon = item.icon ~= nil or (item.compactLabel ~= nil and item.compactLabel.icon ~= nil)
		if not icon then
			return false
		end
		local padding = captionPadding(use)
		local button = buttons[live.key]
		local inset = button and button:FindFirstChildWhichIsA("UIPadding")
		if inset then
			local left = inset:GetStyled("PaddingLeft") :: UDim
			local right = inset:GetStyled("PaddingRight") :: UDim
			padding = left.Offset + right.Offset
		end
		local width = math.min(geometry.labelBounds(live, 40).w, use(fittedWidths)[live.key] or math.huge)
		return (use(wordWidths)[live.key] or 0) + padding > width
	end
	local focus = Compose.createFocusScope({
		from = sectors,
		key = function(sector: Radial.Sector<V>)
			return sector.key
		end,
		disabled = function(sector: Radial.Sector<V>)
			return read(sector.item.enabled) == false
		end,
		position = function(sector: Radial.Sector<V>)
			return if sector.list then 0 else sector.x, if sector.list then sector.index * 48 else sector.y
		end,
		autoFocus = false,
	})
	local selectingInput = surfaces.selecting()
	Compose.watch(function(use: ComposeTypes.Use)
		if selectingInput(use) and use(focus.current) == nil and #use(sectors) > 0 then
			focus.first()
		end
	end)
	local gui = surfaces.service("GuiService")
	local attributes: Types.Attributes = {
		Presentation = function(use: ComposeTypes.Use)
			return if use(fallback) then "list" else "radial"
		end,
	}
	local panelProps: Types.ScrollingFrameNativeProps = {
		Name = "RadialPanel",
		BackgroundTransparency = function(use: ComposeTypes.Use)
			return if use(fallback) then 0 else 1
		end,
		Size = function(use: ComposeTypes.Use)
			return if use(fallback) then D2.new(1, -32, 1, -80) else D2.fromScale(1, 1)
		end,
		Position = function(use: ComposeTypes.Use)
			return if use(fallback) then D2.fromOffset(16, 48) else D2.fromOffset(0, 0)
		end,
		Active = function(use: ComposeTypes.Use)
			return use(fallback) or not spec.centerPassThrough
		end,
		Interactable = menu.opened,
		Selectable = false,
		CanvasSize = D2.fromOffset(0, 0),
		AutomaticCanvasSize = function(use: ComposeTypes.Use)
			return if use(fallback) then E.AutomaticSize.Y else E.AutomaticSize.None
		end,
		ScrollingEnabled = fallback,
		ClipsDescendants = fallback,
		ScrollBarThickness = function(use: ComposeTypes.Use)
			return if use(fallback) then 6 else 0
		end,
		Attributes = attributes,
		Compose.show(fallback, function()
			return lists.list({ gap = 4 }, true)
		end),
		Compose.keyed({
			from = function(use: ComposeTypes.Use)
				local entries: { string } = {}
				local function visit(items: { Radial.RadialItem<V> }, prefix: string)
					for _, item in items do
						local key = prefix .. "/" .. item.id
						table.insert(entries, key)
						if item.children then
							visit(read(item.children, use), if prefix == "" then item.id else key)
						end
					end
					if spec.center and spec.center ~= "back" and not menu.corner then
						table.insert(entries, prefix .. "/$navigation")
					end
				end
				visit(read(spec.items, use), "")
				return entries
			end,
			render = function(key: ComposeTypes.Readable<string>)
				local current: ComposeTypes.Cell<Radial.Sector<V>?> = Compose.cell(nil :: Radial.Sector<V>?)
				local fittedShape: ComposeTypes.Cell<Radial.SectorShape?> = Compose.cell(nil :: Radial.SectorShape?)
				local painted = Compose.cell(false)
				local present = Compose.formula(function(use: ComposeTypes.Use): Radial.Sector<V>?
					local entries = use(sectors)
					for sectorIndex = 1, #entries do
						local sector = entries[sectorIndex]
						if sector.key == use(key) then
							return sector
						end
					end
					return nil
				end)
				Compose.watch(function(use: ComposeTypes.Use)
					local sector = use(present)
					if sector then
						current:set(sector)
					end
				end)
				return Host.Frame("SectorSlot" .. key:peek())({
					BackgroundTransparency = 1,
					Visible = painted,
					Interactable = function(use: ComposeTypes.Use)
						return use(present) ~= nil
					end,
					LayoutOrder = function(use: ComposeTypes.Use)
						local sector = use(current)
						return if sector then sector.index else 0
					end,
					Size = function(use: ComposeTypes.Use)
						local sector = use(current)
						return if sector and sector.list then D2.new(1, 0, 0, 44) else D2.fromScale(1, 1)
					end,
					Compose.presence(function(use: ComposeTypes.Use)
						return use(present)
					end, function(branchPhase: Navigation.PresencePhase)
						local function currentSector(use: ComposeTypes.Use?): Radial.Sector<V>
							return assert(if use then use(current) else current:peek())
						end
						painted:set(true)
						Compose.cleanup(function()
							painted:set(false)
						end)
						local entered = Compose.cell(false)
						local opacity = runtime.tween(function(use: ComposeTypes.Use)
							return if use(entered) and not use(branchPhase.exiting) then 1 else 0
						end, { seconds = ctx.metric("motion.radial.exit") })
						local arrival = runtime.tween(function(use: ComposeTypes.Use)
							return if use(entered) then 1 else 0
						end, { seconds = ctx.metric("motion.radial.slot") })
						local sector = assert(currentSector())
						local from = session.branchOrigin
						local branch = if from and from.path == table.concat(sector.path, "/") then from.shape else nil
						local centred = branch == nil and entry.completed:peek()
						local function unfold(use: ComposeTypes.Use, shape: Radial.SectorShape): Radial.SectorShape
							local parent = assert(branch)
							local present = ctx.motionEase("present", use)
							local p = if use(branchPhase.exiting)
								then 1 - present(1 - use(opacity))
								else present(use(arrival))
							local start = ctx.metric("motion.unfoldStart", use)
							local factor = start + (1 - start) * p
							local middle = (parent.inner + parent.outer) / 2
							local radius = middle + (math.sqrt(shape.x * shape.x + shape.y * shape.y) - middle) * p
							local angle = parent.angle + geometry.delta(shape.angle, parent.angle) * factor
							local result = table.clone(shape)
							result.angle, result.span = angle, shape.span * factor
							result.inner = parent.inner + (shape.inner - parent.inner) * p
							result.outer = parent.outer + (shape.outer - parent.outer) * p
							result.x = math.sin(math.rad(angle)) * radius
							result.y = -math.cos(math.rad(angle)) * radius
							return result
						end
						local function moving(use: ComposeTypes.Use, live: Radial.Sector<V>): boolean
							return (branch ~= nil or centred) and not live.list and not reduced(use)
						end
						local function travel(use: ComposeTypes.Use, live: Radial.Sector<V>): (number, number)
							if not moving(use, live) then
								return 0, 0
							end
							if branch then
								local shown = unfold(use, live)
								return shown.x - live.x, shown.y - live.y
							end
							local amount = ctx.metric("motion.materialize.branch", use) * (1 - use(arrival))
							return -live.x * amount, -live.y * amount
						end
						local function chosen(use: ComposeTypes.Use): boolean
							local live = currentSector(use)
							return use(candidate) == live.key
								or use(focus.current) == live.key
								or read(live.item.checked, use) == true
								or (live.item.selected ~= nil and read(live.item.selected, use) == live.item.value)
						end
						local button = UI.Button({
							Name = sector.id,
							corners = if appearance == "buttons" then "pill" :: "pill" else nil,
							appearance = if appearance == "wedges" then "utility" else nil,
							ClipsDescendants = appearance == "wedges",
							label = function(use: ComposeTypes.Use)
								local live = currentSector(use)
								return if iconic(use, live) then "" else read(live.item.label, use)
							end,
							name = function(use: ComposeTypes.Use): string
								return read(currentSector(use).item.label, use) or ""
							end,
							icon = sector.item.icon or (sector.item.compactLabel and sector.item.compactLabel.icon),
							AnchorPoint = function(use: ComposeTypes.Use)
								return if currentSector(use).list then V2.zero else V2.new(0.5, 0.5)
							end,
							BackgroundTransparency = if appearance == "wedges"
									or spec.buttonSurface == "none"
								then function(use: ComposeTypes.Use): number
									return if use(fallback) then 0 else 1
								end
								else nil,
							LayoutOrder = function(use: ComposeTypes.Use)
								return currentSector(use).index
							end,
							InputBegan = menu.beginPointer,
							MouseEnter = function()
								if
									not session.capture
									and not session.analog
									and (preferred == nil or preferred:peek() ~= E.PreferredInput.Touch)
								then
									candidate:set(currentSector().key)
									naming:set(menu.pointing())
								end
							end,
							MouseLeave = function()
								if not session.capture and not session.analog then
									candidate:set(nil)
									naming:set(false)
								end
							end,
							AutomaticSize = E.AutomaticSize.None,
							Position = function(use: ComposeTypes.Use)
								local at, live = use(center), currentSector(use)
								if live.list then
									return D2.fromOffset(0, 0)
								end
								local scale = spread(use)
								local dx, dy = travel(use, live)
								return D2.fromOffset(at.X + live.x * scale + dx, at.Y + live.y * scale + dy)
							end,
							Size = function(use: ComposeTypes.Use)
								local live = currentSector(use)
								if live.list then
									return D2.new(1, -8, 0, 44)
								end
								if appearance == "buttons" then
									local diameter = math.max(
										44,
										live.size,
										if iconic(use, live)
											then 0
											else (use(wordWidths)[live.key] or 0) + captionPadding(use)
									)
									return D2.fromOffset(diameter, diameter)
								end
								local bounds = geometry.labelBounds(use(fittedShape) or live, 40)
								return D2.fromOffset(if iconic(use, live) then bounds.h else bounds.w, bounds.h)
							end,
							TextWrapped = false,
							enabled = function(use: ComposeTypes.Use)
								return read(currentSector(use).item.enabled, use) ~= false
							end,
							selected = chosen,
							onActivate = function(input: InputObject?)
								menu.nativeActivate(currentSector(), input)
							end,
							SelectionGained = function()
								focus.focus(currentSector().key)
								candidate:set(currentSector().key)
							end,
							ZIndex = 105,
						})
						button:AddTag("facet-radial-label")
						Compose.watch(function(use: ComposeTypes.Use)
							if use(fallback) then
								button:AddTag("facet-radial-row")
							elseif button:HasTag("facet-radial-row") then
								button:RemoveTag("facet-radial-row")
							end
						end)
						buttons[sector.key] = button
						local floor = button:FindFirstChildWhichIsA("UISizeConstraint")
						if floor then
							floor:Destroy()
						end
						local glyph = button:FindFirstChild("LeadingIcon", true)
						if glyph then
							runtime.decorate(glyph, {
								Visible = function(use: ComposeTypes.Use)
									local live = currentSector(use)
									return live.list or iconic(use, live)
								end,
							})
						end
						Compose.watch(function(use: ComposeTypes.Use)
							local live = currentSector(use)
							if not live.list and iconic(use, live) then
								button:AddTag("facet-button-glyph")
							else
								button:RemoveTag("facet-button-glyph")
							end
						end)
						if appearance == "wedges" then
							ctx.styled(button, "radial-item")
						end
						Compose.cleanup(function()
							buttons[sector.key] = nil
						end)
						menu.skin(button, spec.skin and spec.skin.item, function(use: ComposeTypes.Use)
							return use(candidate) == currentSector(use).key
						end)
						local caption = button:FindFirstChild("Title", true)
						local textNode = if caption and caption:IsA("TextLabel") then caption else button
						local natural = ctx.styled(
							Host.TextLabel({
								Name = "CaptionMeasure",
								BackgroundTransparency = 1,
								BorderSizePixel = 0,
								TextXAlignment = E.TextXAlignment.Left,
								Text = function(use: ComposeTypes.Use): string
									return read(currentSector(use).item.label, use) or ""
								end,
								FontFace = ctx.observeStyled.FontFace(textNode),
								TextSize = ctx.observeStyled.TextSize(textNode),
								TextWrapped = false,
								TextTruncate = E.TextTruncate.None,
								TextTransparency = 1,
								Interactable = false,
								Size = D2.fromOffset(0, 0),
								AutomaticSize = E.AutomaticSize.XY,
							}),
							"Text"
						)
						surfaces.attach(button, { natural })
						local unit = ctx.layoutUnit(button)
						local fullBounds, paintedBounds =
							ctx.layoutBounds(natural, unit), ctx.layoutBounds(textNode, unit)
						local measured = Compose.formula(function(use: ComposeTypes.Use): Vector2
							local full, painted = use(fullBounds), use(paintedBounds)
							return V2.new(math.max(full.X, painted.X), math.max(full.Y, painted.Y))
						end)
						Compose.watch(function(use: ComposeTypes.Use)
							local width = use(measured).X
							if width > 0 and wordWidths:peek()[sector.key] ~= width then
								local widths = table.clone(wordWidths:peek())
								widths[sector.key] = width
								wordWidths:set(widths)
							end
						end)
						local paint = Host.Path2D "Sector" {
							Thickness = sector.outer - sector.inner,
							Closed = false,
							ZIndex = 102,
						}
						ctx.styled(paint, "radial-sector")
						Compose.watch(function(use: ComposeTypes.Use)
							if chosen(use) then
								paint:AddTag("facet-radial-candidate")
							else
								paint:RemoveTag("facet-radial-candidate")
							end
						end)
						local wrapper = ctx.fade({
							Name = "Sector-" .. sector.id,
							BackgroundTransparency = 1,
							GroupTransparency = function(use: ComposeTypes.Use)
								return if reduced(use)
									then transparency(use)
									else 1 - (1 - transparency(use)) * use(opacity)
							end,
							ClipsDescendants = false,
							LayoutOrder = function(use: ComposeTypes.Use)
								return currentSector(use).index
							end,
							Size = function(use: ComposeTypes.Use)
								return if currentSector(use).list then D2.new(1, 0, 0, 44) else D2.fromScale(1, 1)
							end,
							button,
						}, nil, false)
						local shaped = Compose.cell(false)
						local shape = Host.Frame "Paint" {
							BackgroundTransparency = 1,
							Visible = function(use: ComposeTypes.Use)
								return appearance == "wedges" and not currentSector(use).list and use(shaped)
							end,
							paint,
						}
						surfaces.attach(wrapper, { shape })
						local placed = Compose.cell(nil :: { x: number, y: number }?)
						Compose.watch(function(use: ComposeTypes.Use)
							if use(present) == nil then
								return
							end
							local live = currentSector(use)
							local text = use(measured)
							local label = geometry.labelBounds(live, 40)
							local iconOnly = iconic(use, live)
							local iconSize = ctx.controlSize(nil, "iconSize", use)
							local fitted = geometry.fitContent(
								live,
								if iconOnly
									then iconSize
									elseif text.X > 0 then text.X + captionPadding(use)
									else label.w,
								if iconOnly
									then iconSize
									elseif text.Y > 0 then math.max(text.Y, ctx.controlSize(nil, "height", use))
									else label.h,
								6,
								contentFit
							)
							local ready = iconOnly or text.X > 0 or (read(live.item.label, use) or "") == ""
							local complete = ready
							if contentFit == "radial" then
								local own = ringFits:peek()[live.key]
								if
									ready
									and (
										not own
										or own.ring ~= live.inner
										or own.inner ~= fitted.inner
										or own.outer ~= fitted.outer
									)
								then
									local nextFits = table.clone(ringFits:peek())
									nextFits[live.key] =
										{ ring = live.inner, inner = fitted.inner, outer = fitted.outer }
									ringFits:set(nextFits)
								end
								local shown: { [string]: boolean } = {}
								for _, entry in use(sectors) do
									shown[entry.key] = true
								end
								local fits = use(ringFits)
								for _, entry in use(sectors) do
									local fit = fits[entry.key]
									if entry.inner == live.inner and (fit == nil or fit.ring ~= live.inner) then
										complete = false
									end
								end
								for key, fit in fits do
									if shown[key] and fit.ring == live.inner then
										fitted.inner = math.min(fitted.inner, fit.inner)
										fitted.outer = math.max(fitted.outer, fit.outer)
									end
								end
							end
							if complete and not shaped:peek() then
								shaped:set(true)
							end
							fittedShape:set(fitted)
							local width = geometry.labelBounds(fitted, 40).w
							if fittedWidths:peek()[live.key] ~= width then
								local widths = table.clone(fittedWidths:peek())
								widths[live.key] = width
								fittedWidths:set(widths)
							end
							local bounds =
								geometry.paint(if branch and moving(use, live) then unfold(use, fitted) else fitted)
							placed:set({ x = bounds.x, y = bounds.y })
							shape.Size = D2.fromOffset(bounds.w, bounds.h)
							paint.Thickness = math.max(1, fitted.outer - fitted.inner)
							local points: { Path2DControlPoint } = {}
							for _, point in bounds.points do
								table.insert(
									points,
									ctx.types.Path2DControlPoint.new(
										D2.fromScale(point.x, point.y),
										D2.fromScale(point.inX, point.inY),
										D2.fromScale(point.outX, point.outY)
									)
								)
							end
							paint:SetControlPoints(points)
						end)
						Compose.watch(function(use: ComposeTypes.Use)
							local bounds = use(placed)
							if bounds == nil then
								return
							end
							local live, at = currentSector(use), use(center)
							local dx, dy = 0, 0
							if not branch then
								dx, dy = travel(use, live)
							end
							local lag = spread(use) - 1
							shape.Position =
								D2.fromOffset(at.X + bounds.x + dx + lag * live.x, at.Y + bounds.y + dy + lag * live.y)
						end)
						entered:set(true)
						return wrapper
					end, {
						exit = function(): ComposeTypes.Exiting
							return if reduced()
								then { completed = Compose.cell(true) }
								else runtime.timeline({ duration = ctx.metric("motion.radial.exit") })
						end,
					}),
				})
			end,
		}),
	}
	local panel = Host.ScrollingFrame(panelProps)
	Compose.watch(function(use: ComposeTypes.Use)
		if use(fallback) then
			panel:AddTag("facet-panel")
		else
			panel:RemoveTag("facet-panel")
		end
	end)
	return {
		transparency = transparency,
		buttons = buttons,
		iconic = iconic,
		focus = focus,
		gui = gui,
		panel = panel,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="174">
            <Properties>
              <string name="Name">nav_sheet</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local fontReadiness = require("./font_readiness")
local NavigationProps = require("./navigation_props")
local sheetDetents = require("./nav_sheet_detents")
local sheetGesture = require("./nav_sheet_gesture")
local sheetContent = require("./nav_sheet_content")

type Prepared = sheetDetents.Prepared

local KEYS = {
	"title",
	"content",
	"detent",
	"detents",
	"isPresented",
	"interactiveDismissDisabled",
	"dragIndicator",
	"placement",
	"edge",
	"width",
	"closeButton",
	"header",
	"hero",
	"actions",
	"actionLayout",
	"contentInset",
	"scrollPolicy",
}
local SETTLE_LIMIT = 20

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces): ()
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local readSource = ctx.readSource
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local frames = runtime.host.frames
	local detents = sheetDetents(ctx)
	local prepare, writableDetent = detents.prepare, detents.writableDetent
	local gestureFor = sheetGesture(ctx, UI, surfaces, detents.word)
	local contentFor = sheetContent(ctx, UI, surfaces)

	local function modalFor(
		spec: NavigationProps.SheetSpec,
		detent: ComposeTypes.Cell<string>,
		prepared: Prepared,
		request: Nav.SheetRequest?,
		phase: Nav.PresencePhase?,
		anchor: GuiObject?
	): Frame
		local gesture = gestureFor(spec, detent, prepared, request, phase, anchor)
		local placed, edge, ready, toward = gesture.placed, gesture.edge, gesture.ready, gesture.toward
		local pulled, painted, keyboard, standing = gesture.pulled, gesture.painted, gesture.keyboard, gesture.standing
		local level, handle, detector, pad = gesture.level, gesture.handle, gesture.detector, gesture.pad
		local canDismiss, interactive, lowest = gesture.canDismiss, gesture.interactive, gesture.lowest
		local unit, extent = gesture.unit, gesture.extent
		local sheetBody = contentFor(spec, gesture)
		local room, plaqued, usable, press = sheetBody.room, sheetBody.plaqued, sheetBody.usable, sheetBody.press
		local panelWidth, contentSize = sheetBody.panelWidth, sheetBody.contentSize
		local function anchors(use: ComposeTypes.Use): (number, number)
			local placement = use(placed)
			return if placement == "side" then (if edge == "left" then 0 else 1) else 0.5,
				if placement == "center" then 0.5 else 1
		end
		local shown = surfaces.appearance(phase, ctx.motionTiming("sheet"), ready)
		local function travel(use: ComposeTypes.Use): (number, number)
			local rest = 1 - shown.travel(use)
			if rest <= 0 then
				return if use(placed) == "side" then toward() * pulled(use) else 0, 0
			end
			local placement = use(placed)
			if placement == "side" then
				local shift = pulled(use)
				return toward() * (shift + (use(panelWidth) - shift) * rest), 0
			end
			if placement == "center" then
				return 0, 0
			end
			return 0, math.ceil(painted(use) * rest)
		end
		runtime.decorate(room.frame, {
			[Compose.group({ "Position", "Size" })] = function(use: ComposeTypes.Use): (UDim2, UDim2)
				local left, top, right, bottom =
					pad("left", use), pad("top", use), pad("right", use), pad("bottom", use)
				return D2.fromOffset(left, top), D2.new(1, -left - right, 0, math.max(0, standing(use) - top - bottom))
			end,
		})
		local panelProps: Types.CanvasGroupNativeProps = {
			Name = "SheetPanel",
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			AnchorPoint = function(use: ComposeTypes.Use)
				local anchorX, anchorY = anchors(use)
				return V2.new(anchorX, anchorY)
			end,
			Position = function(use: ComposeTypes.Use)
				local anchorX, anchorY = anchors(use)
				local y = (if anchorY == 1 then -keyboard(use) else -keyboard(use) / 2) + standing(use) - painted(use)
				local dx, dy = travel(use)
				return D2.new(anchorX, dx, anchorY, y + dy)
			end,
			AutomaticSize = E.AutomaticSize.None,
			Size = function(use: ComposeTypes.Use)
				return D2.fromOffset(use(panelWidth), standing(use))
			end,
			GroupTransparency = function(use: ComposeTypes.Use)
				return if not use(ready) then 1 elseif level(use) == "limited" then 1 - shown.opacity(use) else 0
			end,
		}
		for _, child in { handle, room.frame, ctx.corner(), detector("PanelDrag", "panel") } :: { Instance } do
			panelProps[#panelProps + 1] = child
		end
		local panel = ctx.fade(panelProps, true)
		ctx.styled(panel, "sheet")
		runtime.decorate(panel, {
			Attributes = {
				FacetPlacement = function(use: ComposeTypes.Use): string
					return use(placed)
				end,
			},
		})
		surfaces.skin(panel, nil, {
			padding = false,
			title = if spec.header == nil then spec.title else nil,
			onCaption = function(on: boolean)
				plaqued:set(on)
			end,
		})
		local overlay = surfaces.modal(function()
			return panel
		end, function()
			if not canDismiss() then
				return
			end
			if prepared.cancel and usable(prepared.cancel) then
				press(prepared.cancel)
			else
				interactive("cancel")
			end
		end, {
			canDismiss = function(use: ComposeTypes.Use)
				return canDismiss(use)
			end,
			onOutside = function()
				interactive("outside")
			end,
			exiting = if phase then phase.exiting else nil,
			appearance = function(use: ComposeTypes.Use?): number
				local base = shown.opacity(use)
				if not canDismiss(use) then
					return base
				end
				if readSource(placed, use) == "side" then
					local width = readSource(panelWidth, use)
					return if width > 0 then base * math.clamp(1 - pulled(use) / width, 0, 1) else base
				end
				local rest = lowest(use)
				return if rest > 0 then base * math.clamp(painted(use) / rest, 0, 1) else base
			end,
		})
		local scale = ctx.layoutUnit(overlay)
		Compose.watch(function(use: ComposeTypes.Use)
			unit:set(use(scale))
		end)
		local size = ctx.layoutSize(overlay, unit)
		local measured = Compose.cell(false)
		Compose.watch(function(use: ComposeTypes.Use)
			local value = use(size)
			if value.Y > 0 then
				extent:set(value)
				measured:set(true)
			end
		end)
		if frames and not ready:peek() then
			local panelSize = ctx.observe.AbsoluteSize(panel)
			local function contentGeometry(): string
				local origin = panel.AbsolutePosition
				local signature: { string } = {}
				for _, node in panel:GetDescendants() do
					if node:IsA("GuiObject") then
						local entry = `{node.AbsolutePosition - origin}:{node.AbsoluteSize}:{node.Visible}`
						if node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox") then
							entry ..= `:{node.TextBounds}`
						end
						table.insert(signature, entry)
					end
				end
				return table.concat(signature, ";")
			end
			local fontsReady = fontReadiness(ctx, { panel })
			local started = Compose.cell(false)
			local clock = runtime.tween(function(use: ComposeTypes.Use): number
				return if use(started) then 1 else 0
			end, { seconds = SETTLE_LIMIT / 60 })
			started:set(true)
			local previous: string? = nil
			Compose.watch(function(use: ComposeTypes.Use)
				local elapsed = use(clock)
				local finished = elapsed >= 1
				if ready:peek() or elapsed <= 0 then
					return
				end
				local signature = if measured:peek()
					then string.format(
						"%d %d %d %d %d %s",
						extent:peek().X,
						extent:peek().Y,
						panelSize:peek().X,
						contentSize:peek().Y,
						room.pinned:peek(),
						contentGeometry()
					)
					else nil
				if fontsReady() and (finished or (signature ~= nil and signature == previous)) then
					ready:set(true)
				end
				previous = signature
			end)
		end
		surfaces.keep(spec.content, spec.header, spec.hero and spec.hero.content)
		return overlay
	end

	UI.Sheet = ctx.construct("Sheet", function(spec: NavigationProps.SheetSpec): Frame
		local prepared = prepare(spec)
		local detent = writableDetent(spec, prepared)
		assert(
			type(spec.isPresented) == "table" and spec.isPresented.set,
			"Sheet.isPresented requires a writable Compose cell"
		)
		local root = Host.Frame(
			ctx.props(spec, KEYS, { Name = "Sheet", BackgroundTransparency = 1, Size = D2.fromOffset(0, 0) })
		)
		surfaces.attach(root, {
			surfaces.overlay(root, spec.isPresented, function(phase)
				return modalFor(spec, detent, prepared, nil, phase, root)
			end, {
				motion = ctx.motionTiming("sheet"),
				failure = function(failure)
					root:SetAttribute("FacetError", tostring(failure))
					spec.isPresented:set(false)
					if ctx.config.onError then
						ctx.config.onError(failure)
					end
					return Host.Folder "FailedSheet" {}
				end,
			}),
		})
		return root
	end)

	surfaces.sheetModal = function(
		spec: NavigationProps.SheetSpec,
		request: Nav.SheetRequest,
		phase: Nav.PresencePhase?
	): Frame
		local prepared = prepare(spec)
		return modalFor(spec, writableDetent(spec, prepared), prepared, request, phase, nil)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="175">
            <Properties>
              <string name="Name">nav_sheet_content</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local Overlay = require("./overlay_types")
local ComposeTypes = require("../vendor/compose/core")
local parts = require("./overlay_parts")
local NavigationProps = require("./navigation_props")
local sheetGesture = require("./nav_sheet_gesture")

export type SheetContent = {
	plaqued: ComposeTypes.Cell<boolean>,
	usable: (Overlay.Action?) -> boolean,
	press: (Overlay.Action) -> (),
	panelWidth: ComposeTypes.Formula<number>,
	contentSize: ComposeTypes.Cell<Vector2>,
	room: parts.Room,
}

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	surfaces: Nav.Surfaces
): (NavigationProps.SheetSpec, sheetGesture.Gesture) -> SheetContent
	local Compose, Host, runtime, read = ctx.Compose, ctx.Host, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	return function(spec: NavigationProps.SheetSpec, gesture: sheetGesture.Gesture): SheetContent
		local grabber, canDismiss, close, unit, extent =
			gesture.grabber, gesture.canDismiss, gesture.close, gesture.unit, gesture.extent
		local pad, standing, hugHeight, tallest = gesture.pad, gesture.standing, gesture.hugHeight, gesture.tallest
		local regions: { GuiObject } = {}
		local plaqued = Compose.cell(false)
		local hero = spec.hero
		local sticky = hero ~= nil and hero.sticky == true
		local overHero = spec.header == false and hero ~= nil
		local closeCommand: TextButton? = nil
		local function linkClose(button: TextButton): TextButton
			closeCommand = button
			button.SelectionOrder = -1
			grabber.NextSelectionDown = button
			grabber.NextSelectionRight = button
			button.NextSelectionUp = grabber
			button.NextSelectionLeft = grabber
			return button
		end
		local function closeControl(): TextButton?
			local explicit = spec.closeButton
			local function activate()
				close("close")
			end
			if explicit == false then
				return nil
			end
			if explicit ~= nil and explicit ~= true then
				return linkClose(UI.Button "Close" {
					label = explicit :: Types.Value<string>,
					appearance = if overHero then "inverse" else "link",
					LayoutOrder = 2,
					onActivate = activate,
				})
			end
			return linkClose(UI.Button "Close" {
				name = "Close",
				Visible = if explicit == nil then canDismiss else true,
				icon = "close",
				appearance = if overHero then "inverse" else nil,
				LayoutOrder = 2,
				Size = D2.fromOffset(44, 44),
				AutomaticSize = E.AutomaticSize.None,
				onActivate = activate,
			})
		end
		local function heroFrame(): Frame
			local current = assert(hero)
			local frame = parts.media(ctx, current, "Hero")
			if current.content then
				local children: { Types.Child } = {
					Host.UIListLayout({ SortOrder = E.SortOrder.LayoutOrder }),
					Host.UIPadding({
						PaddingLeft = ctx.types.UDim.new(0, 16),
						PaddingRight = ctx.types.UDim.new(0, 16),
						PaddingBottom = ctx.types.UDim.new(0, 12),
					}),
				}
				if overHero then
					table.insert(
						children,
						Host.Frame "Strip" {
							BackgroundTransparency = 1,
							LayoutOrder = 0,
							Size = function(use: ComposeTypes.Use)
								return D2.new(1, 0, 0, math.max(44, ctx.metric("targetSizes.minimum", use)) + 8)
							end,
						}
					)
				end
				local content = current.content
				local node: Instance = if type(content) == "function" then content() else content :: Instance
				if node:IsA("GuiObject") then
					runtime.decorate(node, { LayoutOrder = 1 })
				end
				table.insert(children, node)
				surfaces.attach(frame, {
					Host.Frame "Art" {
						BackgroundTransparency = 1,
						Size = D2.fromScale(1, 1),
						table.unpack(children),
					},
				})
			end
			if overHero then
				local close = closeControl()
				if close then
					surfaces.attach(frame, {
						Host.Frame "Utilities" {
							BackgroundTransparency = 1,
							AnchorPoint = V2.new(1, 0),
							Position = D2.new(1, -8, 0, 8),
							Size = D2.fromOffset(0, 0),
							AutomaticSize = E.AutomaticSize.XY,
							ZIndex = 3,
							close,
						},
					})
				end
			end
			return frame
		end
		if sticky then
			table.insert(regions, heroFrame())
		end
		if not overHero then
			local header: { Types.Child } = {}
			if spec.header == nil then
				table.insert(
					header,
					ctx.styled(
						ctx.text({
							Name = "Title",
							LayoutOrder = 1,
							Visible = function(use: ComposeTypes.Use)
								return not use(plaqued)
							end,
							Text = function(use: ComposeTypes.Use)
								return read(spec.title, use) or ""
							end,
							TextWrapped = true,
							Size = D2.new(1, 0, 0, 0),
							AutomaticSize = E.AutomaticSize.Y,
							Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }),
						}),
						"type-heading"
					)
				)
			elseif spec.header ~= false then
				local custom = spec.header
				local node: Instance = if type(custom) == "function" then custom() else custom :: Instance
				if node:IsA("GuiObject") then
					surfaces.attach(node, { Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }) })
				end
				table.insert(header, node)
			end
			local close = closeControl()
			if close then
				table.insert(header, close)
			end
			if #header > 0 then
				local row: Types.FrameNativeProps = {
					Name = "Header",
					BackgroundTransparency = 1,
					Size = D2.new(1, 0, 0, 0),
					AutomaticSize = E.AutomaticSize.Y,
				}
				row[#row + 1] = Host.UIListLayout({
					FillDirection = E.FillDirection.Horizontal,
					HorizontalAlignment = E.HorizontalAlignment.Right,
					VerticalAlignment = E.VerticalAlignment.Center,
					SortOrder = E.SortOrder.LayoutOrder,
					Padding = ctx.types.UDim.new(0, 8),
				})
				for _, child in header do
					row[#row + 1] = child
				end
				table.insert(regions, Host.Frame(row))
			end
		end
		local inset = if spec.contentInset == "none" then 0 else 8
		local bodyLayout = Host.UIListLayout({ SortOrder = E.SortOrder.LayoutOrder })
		local bodyPadding = ctx.padding(inset, inset)
		local bodyChildren: { Types.Child } = { bodyLayout }
		local content: Instance = if type(spec.content) == "function"
			then (spec.content :: () -> Instance)()
			else spec.content :: Instance
		local scrollViewport: Frame? = nil
		local bodyContent = content
		if content:IsA("ScrollingFrame") and content.Size.Y.Scale > 0 then
			scrollViewport = Host.Frame "SheetScrollViewport" {
				BackgroundTransparency = 1,
				Size = D2.new(1, 0, 0, 0),
				content,
			}
			bodyContent = assert(scrollViewport)
		end
		if hero and not sticky then
			table.insert(bodyChildren, heroFrame())
			local inner: Types.FrameNativeProps = {
				Name = "Inset",
				BackgroundTransparency = 1,
				LayoutOrder = 2,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
			}
			inner[#inner + 1] = Host.UIListLayout({ SortOrder = E.SortOrder.LayoutOrder })
			inner[#inner + 1] = ctx.padding(inset, inset)
			inner[#inner + 1] = bodyContent
			table.insert(bodyChildren, Host.Frame(inner))
		else
			table.insert(bodyChildren, bodyPadding)
			table.insert(bodyChildren, bodyContent)
		end
		local flex = Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill })
		local bodyProps: Types.ScrollingFrameNativeProps = {
			Name = "SheetContent",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollingDirection = E.ScrollingDirection.Y,
			ScrollBarThickness = 6,
			ClipsDescendants = true,
			flex :: Instance,
		}
		local body = parts.scroller(ctx, bodyProps, bodyChildren, { name = "SheetFlow" })
		if scrollViewport then
			local window = ctx.observe.AbsoluteWindowSize(body)
			runtime.decorate(scrollViewport, {
				Size = function(use: ComposeTypes.Use): UDim2
					return D2.new(1, 0, 0, math.max(0, use(window).Y / use(unit) - inset * 2))
				end,
			})
		end
		if closeCommand then
			local command = closeCommand
			local entry: GuiObject? = nil
			local previousUp: GuiObject? = nil
			local function linkContent()
				local nextEntry = surfaces.firstSelectable(body)
				if nextEntry == command then
					nextEntry = surfaces.firstSelectable(content)
				end
				if nextEntry == entry then
					return
				end
				if entry and entry.NextSelectionUp == command then
					local links = (entry :: unknown) :: { NextSelectionUp: GuiObject? }
					links.NextSelectionUp = previousUp
				end
				entry = nextEntry
				local outgoing = (command :: unknown) :: { NextSelectionDown: GuiObject? }
				outgoing.NextSelectionDown = nextEntry
				if nextEntry then
					previousUp = nextEntry.NextSelectionUp
					nextEntry.NextSelectionUp = command
				end
			end
			linkContent()
			runtime.connect(body, "DescendantAdded", linkContent)
			Compose.cleanup(function()
				if entry and entry.NextSelectionUp == command then
					local links = (entry :: unknown) :: { NextSelectionUp: GuiObject? }
					links.NextSelectionUp = previousUp
				end
			end)
		end
		table.insert(regions, body)
		local function usable(action: Overlay.Action?): boolean
			return parts.usable(ctx, action)
		end
		local function press(action: Overlay.Action)
			if usable(action) then
				action.onActivate()
			end
		end
		local panelWidth = Compose.formula(function(use: ComposeTypes.Use): number
			return math.max(0, math.min(parts.width(ctx, spec.width, use), use(extent).X))
		end)
		local actions = spec.actions or {}
		if #actions > 0 then
			table.insert(
				regions,
				parts.actions(ctx, UI, actions, spec.actionLayout, function(use: ComposeTypes.Use)
					return math.max(0, use(panelWidth) - pad("left", use) - pad("right", use))
				end, press).frame
			)
		end
		local contentSize = ctx.observe.AbsoluteContentSize(bodyLayout)
		local extra = if hero == nil or sticky then inset * 2 else 0
		local function natural(use: ComposeTypes.Use): number
			return use(contentSize).Y / use(unit) + extra
		end
		local chrome = function(use: ComposeTypes.Use): number
			return pad("top", use) + pad("bottom", use)
		end
		local room = parts.room(ctx, regions, body, natural, function(use: ComposeTypes.Use): number
			return math.max(0, standing(use) - chrome(use))
		end, true, unit)
		runtime.decorate(flex, {
			FlexMode = function(use: ComposeTypes.Use)
				return if use(room.tight) then E.UIFlexMode.None else E.UIFlexMode.Fill
			end,
		})
		Compose.watch(function(use: ComposeTypes.Use)
			local want = natural(use) + use(room.pinned) + chrome(use) + 8
			local previous = hugHeight:peek()
			if want > 0 and (previous == nil or math.abs(previous - want) > 0.5) then
				hugHeight:set(want)
			end
		end)
		if spec.scrollPolicy == "atLargestDetent" then
			runtime.decorate(body, {
				ScrollingEnabled = function(use: ComposeTypes.Use)
					return use(tallest) and not use(room.tight)
				end,
				Active = tallest,
			})
		end
		return {
			plaqued = plaqued,
			usable = usable,
			press = press,
			panelWidth = panelWidth,
			contentSize = contentSize,
			room = room,
		}
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="176">
            <Properties>
              <string name="Name">nav_sheet_detents</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local Overlay = require("./overlay_types")
local ComposeTypes = require("../vendor/compose/core")
local parts = require("./overlay_parts")
local freeze = require("./freeze")
local NavigationProps = require("./navigation_props")

export type Detent = { id: string, fraction: number?, height: number?, hug: boolean, index: number }
export type Prepared = { detents: { Detent }, byId: { [string]: Detent }, cancel: Overlay.Action? }
export type Detents = {
	prepare: (NavigationProps.SheetSpec) -> Prepared,
	word: (string) -> string,
	writableDetent: (NavigationProps.SheetSpec, Prepared) -> ComposeTypes.Cell<string>,
}

local PLACEMENTS: { [string]: boolean } =
	freeze({ automatic = true, adaptive = true, bottom = true, side = true, center = true })

return function(ctx: Types.Context): Detents
	local function prepare(spec: NavigationProps.SheetSpec): Prepared
		assert(
			spec.detent == nil or type(spec.detent) == "string" or (type(spec.detent) == "table" and spec.detent.set),
			"Sheet.detent requires a detent id or a writable Compose cell"
		)
		local placement = spec.placement or "automatic"
		assert(PLACEMENTS[placement], "Sheet.placement must be automatic, adaptive, bottom, side or center")
		assert(
			spec.edge == nil
				or ((placement == "side" or placement == "adaptive") and (spec.edge == "left" or spec.edge == "right")),
			"Sheet.edge is left or right, and only with placement side or adaptive"
		)
		parts.checkPreset(ctx, "Sheet", "width", spec.width, parts.WIDTH_PRESETS)
		assert(
			spec.closeButton == nil
				or type(spec.closeButton) == "boolean"
				or parts.bound(ctx, spec.closeButton, "string"),
			"Sheet.closeButton must be a boolean or a label"
		)
		local header = spec.header
		assert(
			header == nil or header == false or parts.instance(header) or type(header) == "function",
			"Sheet.header must be an Instance, a content factory or false"
		)
		assert(
			spec.contentInset == nil or spec.contentInset == "standard" or spec.contentInset == "none",
			"Sheet.contentInset must be standard or none"
		)
		assert(
			spec.actionLayout == nil
				or spec.actionLayout == "automatic"
				or spec.actionLayout == "row"
				or spec.actionLayout == "stacked",
			"Sheet.actionLayout must be automatic, row or stacked"
		)
		assert(
			spec.scrollPolicy == nil or spec.scrollPolicy == "always" or spec.scrollPolicy == "atLargestDetent",
			"Sheet.scrollPolicy must be always or atLargestDetent"
		)
		assert(
			spec.dragIndicator == nil
				or spec.dragIndicator == "automatic"
				or spec.dragIndicator == "visible"
				or spec.dragIndicator == "hidden",
			"Sheet.dragIndicator must be automatic, visible or hidden"
		)
		parts.checkHero("UI.Sheet", spec.hero)
		parts.checkActions(ctx, "UI.Sheet", spec.actions, math.huge)
		local cancel: Overlay.Action? = nil
		local listed: { Overlay.Action } = spec.actions or {}
		for _, action in listed do
			if action.role == "cancel" then
				cancel = action
			end
		end
		local detents: { Detent } = {}
		local byId: { [string]: Detent } = {}
		local entries: { Nav.SheetDetent } = spec.detents or { "medium", "large" }
		assert(#entries > 0, "Invalid Sheet detent")
		for index, entry in entries do
			local d: Detent
			if entry == "medium" then
				d = { id = "medium", fraction = 0.5, hug = false, index = index }
			elseif entry == "large" then
				d = { id = "large", fraction = 0.95, hug = false, index = index }
			elseif entry == "hug" then
				d = { id = "hug", hug = true, index = index }
			else
				assert(type(entry) == "table", "Invalid Sheet detent")
				local custom = (entry :: unknown) :: { [string]: unknown }
				for key in custom do
					assert(key == "id" or key == "fraction" or key == "height", "Invalid Sheet detent")
				end
				assert(type(custom.id) == "string" and custom.id ~= "", "Invalid Sheet detent")
				assert(
					(custom.fraction == nil) ~= (custom.height == nil),
					"Sheet detent requires exactly one of fraction or height"
				)
				local fraction, height = custom.fraction, custom.height
				assert(
					if fraction ~= nil
						then type(fraction) == "number" and fraction > 0 and fraction <= 1
						else type(height) == "number" and height > 0 and height < math.huge,
					"Invalid Sheet detent extent"
				)
				d = {
					id = custom.id :: string,
					fraction = fraction :: number?,
					height = height :: number?,
					hug = false,
					index = index,
				}
			end
			assert(not byId[d.id], "Sheet detents require unique ids")
			byId[d.id] = d
			table.insert(detents, d)
		end
		return { detents = detents, byId = byId, cancel = cancel }
	end

	local function word(id: string): string
		if id == "hug" then
			return "Fit"
		end
		return string.upper(string.sub(id, 1, 1)) .. string.sub(id, 2)
	end

	local function writableDetent(spec: NavigationProps.SheetSpec, prepared: Prepared): ComposeTypes.Cell<string>
		local authored = spec.detent
		if type(authored) == "table" then
			return authored
		end
		local initial = if type(authored) == "string" and prepared.byId[authored]
			then authored
			else prepared.detents[1].id
		return ctx.Compose.cell(initial)
	end
	return { prepare = prepare, word = word, writableDetent = writableDetent }
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="177">
            <Properties>
              <string name="Name">nav_sheet_gesture</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local parts = require("./overlay_parts")
local release = require("./sheet_release")
local settle = require("./settle")
local motion = require("./motion")
local reducedMotion = motion.reduced
local NavigationProps = require("./navigation_props")
local sheetDetents = require("./nav_sheet_detents")

type Detent = sheetDetents.Detent
type Prepared = sheetDetents.Prepared
type Session = {
	source: "grip" | "panel",
	origin: number,
	start: number,
	detent: string,
	acquired: boolean,
	slop: number,
	moved: boolean,
	samples: { { height: number, at: number } },
}

export type Gesture = {
	edge: string,
	level: (ComposeTypes.Use?) -> motion.Level,
	unit: ComposeTypes.Cell<number>,
	keyboard: (ComposeTypes.Use) -> number,
	extent: ComposeTypes.Cell<Vector2>,
	placed: ComposeTypes.Formula<string>,
	reserve: (string, ComposeTypes.Use?) -> number,
	pad: (string, ComposeTypes.Use?) -> number,
	hugHeight: ComposeTypes.Cell<number?>,
	ready: ComposeTypes.Cell<boolean>,
	painted: (ComposeTypes.Use?) -> number,
	canDismiss: (ComposeTypes.Use?) -> boolean,
	close: (string) -> (),
	interactive: (string) -> (),
	lowest: (ComposeTypes.Use?) -> number,
	standing: (ComposeTypes.Use?) -> number,
	pulled: (ComposeTypes.Use?) -> number,
	toward: () -> number,
	detector: (string, "grip" | "panel") -> Instance,
	tallest: ComposeTypes.Formula<boolean>,
	grabber: TextButton,
	handle: TextButton,
}

local HANDLE = 20
local HELD_PULL = 0.2

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	surfaces: Nav.Surfaces,
	word: (string) -> string
): (
	NavigationProps.SheetSpec,
	ComposeTypes.Cell<string>,
	Prepared,
	Nav.SheetRequest?,
	Nav.PresencePhase?,
	GuiObject?
) -> Gesture
	local Compose, Host, runtime, read = ctx.Compose, ctx.Host, ctx.runtime, ctx.read
	local readSource = ctx.readSource
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local frames = runtime.host.frames
	local function now(): number
		return if frames then frames.now() else os.clock()
	end
	return function(
		spec: NavigationProps.SheetSpec,
		detent: ComposeTypes.Cell<string>,
		prepared: Prepared,
		request: Nav.SheetRequest?,
		phase: Nav.PresencePhase?,
		anchor: GuiObject?
	): Gesture
		local detents, byId = prepared.detents, prepared.byId
		local declared = spec.placement or "automatic"
		local edge = spec.edge or "right"
		local gui = surfaces.service("GuiService")
		local input = surfaces.service("UserInputService")
		local preferred: ComposeTypes.Readable<Enum.PreferredInput>? = if input
				and input.GetPropertyChangedSignal
			then ctx.observe.PreferredInput(input)
			else nil
		local reduce = reducedMotion(ctx)
		local level = motion.level(ctx)
		local unit = Compose.cell(1)
		local keyboard: (ComposeTypes.Use) -> number = function()
			return 0
		end
		if input and input.GetPropertyChangedSignal then
			local visible = ctx.observe.OnScreenKeyboardVisible(input)
			local size = ctx.observe.OnScreenKeyboardSize(input)
			keyboard = function(use: ComposeTypes.Use): number
				return if use(visible) == true then use(size).Y / use(unit) else 0
			end
		end
		local layer = if anchor then surfaces.parent(anchor) else ctx.config.overlayParent
		local initial = if layer and layer:IsA("GuiBase2d") then (layer :: GuiBase2d).AbsoluteSize else V2.zero
		local extent = Compose.cell(if initial.Y > 0 then initial else V2.new(0, 720))
		local pointer: (ComposeTypes.Use) -> boolean = function()
			return false
		end
		if declared == "adaptive" and input and input.GetPropertyChangedSignal then
			local mouse, touch = ctx.observe.MouseEnabled(input), ctx.observe.TouchEnabled(input)
			pointer = function(use: ComposeTypes.Use): boolean
				return use(mouse) == true and use(touch) ~= true
			end
		end
		local tenFoot = ctx.tenFoot()
		local placed = Compose.formula(function(use: ComposeTypes.Use): string
			if (declared == "automatic" or declared == "adaptive") and tenFoot(use) then
				return "center"
			end
			if declared == "adaptive" then
				return if use(extent).X >= 600 and pointer(use) then "side" else "bottom"
			end
			return if declared == "automatic" then "bottom" else declared
		end)
		local function from(use: ComposeTypes.Use?): string
			return if read(placed, use) == "side" then edge else "bottom"
		end
		local indicator = spec.dragIndicator or "automatic"
		local BASE: { [string]: number } = { top = 12, bottom = 12, left = 16, right = 16 }
		local RESERVED: { [string]: string } = { bottom = "top", right = "left", left = "right" }
		local function reserve(side: string, use: ComposeTypes.Use?): number
			return BASE[side] + (if indicator ~= "hidden" and RESERVED[from(use)] == side then HANDLE + 8 else 0)
		end
		local function pad(side: string, use: ComposeTypes.Use?): number
			return surfaces.inset(0, side, nil, use) + reserve(side, use)
		end
		local function available(use: ComposeTypes.Use?): number
			local get: ComposeTypes.Use = use
				or function<T>(source: ComposeTypes.Readable<T>): T
					return source:peek()
				end
			return math.max(1, get(extent).Y - keyboard(get))
		end
		local function minimum(use: ComposeTypes.Use?): number
			return ctx.metric("targetSizes.minimum", use) * 4 + ctx.metric("space.m", use) * 2
		end
		local hugHeight: ComposeTypes.Cell<number?> = Compose.cell(nil :: number?)
		local function heightOf(d: Detent, use: ComposeTypes.Use?): number
			local room = available(use)
			local want = if d.hug
				then readSource(hugHeight, use) or minimum(use)
				elseif d.fraction then room * d.fraction
				else assert(d.height)
			return math.min(room, math.max(minimum(use), want))
		end
		local function ordered(): { Detent }
			local out = table.clone(detents)
			table.sort(out, function(a: Detent, b: Detent): boolean
				local ha, hb = heightOf(a), heightOf(b)
				if ha ~= hb then
					return ha < hb
				end
				return a.index < b.index
			end)
			return out
		end
		local lastValid = if byId[detent:peek()] then detent:peek() else detents[1].id
		local function selected(use: ComposeTypes.Use?): Detent
			local id = readSource(detent, use)
			local found = byId[id]
			if found then
				lastValid = id
				return found
			end
			return byId[lastValid]
		end
		local dragHeight: ComposeTypes.Cell<number?> = Compose.cell(nil :: number?)
		local ready = Compose.cell(frames == nil)
		local settleTo = settle(ctx, function(): number
			return heightOf(selected())
		end, ctx.motionSpring("sheet"))
		local halt, launch = settleTo.halt, settleTo.launch
		local function painted(use: ComposeTypes.Use?): number
			local drag = readSource(dragHeight, use)
			if drag then
				return drag
			end
			if reduce(use) then
				return heightOf(selected(use), use)
			end
			local settling = readSource(settleTo.value, use)
			if settling then
				return math.min(available(use), math.max(minimum(use), settling))
			end
			return heightOf(selected(use), use)
		end
		local shownHeight = heightOf(selected())
		Compose.watch(function(use: ComposeTypes.Use)
			local drag = use(dragHeight)
			local goal = heightOf(selected(use), use)
			if drag then
				shownHeight = drag
				return
			end
			if use(ready) and settleTo.value:peek() == nil and math.abs(goal - shownHeight) > 0.5 then
				launch(shownHeight, 0)
			end
			shownHeight = goal
		end)
		local canDismiss = function(use: ComposeTypes.Use?): boolean
			return read(spec.interactiveDismissDisabled, use) ~= true
		end
		local function close(reason: string)
			if request then
				request(reason)
			else
				spec.isPresented:set(false)
			end
		end
		local function interactive(reason: string)
			if canDismiss() then
				close(reason)
			end
		end
		local function select(id: string)
			dragHeight:set(nil)
			detent:set(id)
		end
		local function nextUp(use: ComposeTypes.Use?): Detent?
			local sorted = ordered()
			local index = table.find(sorted, selected(use)) or 1
			return sorted[index + 1]
		end
		local dragged = -math.huge
		local session: Session? = nil
		local function endSession()
			session = nil
			dragHeight:set(nil)
		end
		local function stops(): { release.Stop }
			local out: { release.Stop } = {}
			for _, d in ordered() do
				table.insert(out, { id = d.id, height = heightOf(d), index = d.index })
			end
			return out
		end
		local function grab(source: "grip" | "panel", y: number): boolean
			if session then
				return false
			end
			local kind = if preferred then preferred:peek() else nil
			session = {
				source = source,
				origin = y,
				start = painted(),
				detent = selected().id,
				acquired = source == "grip",
				slop = if source == "grip" then 0 elseif kind == E.PreferredInput.Touch then 14 else 6,
				moved = false,
				samples = {},
			}
			local current = assert(session)
			if current.acquired then
				halt()
				dragHeight:set(current.start)
				table.insert(current.samples, { height = current.start, at = now() })
			end
			return true
		end
		local function move(source: "grip" | "panel", y: number)
			local current = session
			if current == nil or current.source ~= source then
				return
			end
			if source == "grip" and math.abs(y - current.origin) > 4 then
				dragged = now()
				current.moved = true
			end
			if not current.acquired then
				if math.abs(y - current.origin) < current.slop then
					return
				end
				current.acquired = true
				current.origin += if y > current.origin then current.slop else -current.slop
				halt()
				dragHeight:set(current.start)
				table.insert(current.samples, { height = current.start, at = now() })
			end
			local sorted = stops()
			local height = release.resist(
				current.start + current.origin - y,
				sorted[1].height,
				sorted[#sorted].height,
				available(),
				canDismiss(),
				ctx.metric("targetSizes.minimum")
			)
			dragHeight:set(height)
			table.insert(current.samples, { height = height, at = now() })
			if #current.samples > 8 then
				table.remove(current.samples, 1)
			end
		end
		local function velocity(samples: { { height: number, at: number } }): number
			local count = #samples
			if count < 2 then
				return 0
			end
			local last = samples[count]
			local first = last
			for index = count - 1, 1, -1 do
				if last.at - samples[index].at > 0.1 then
					break
				end
				first = samples[index]
			end
			local span = last.at - first.at
			if span < 1 / 240 or now() - last.at > 0.1 then
				return 0
			end
			return (last.height - first.height) / span
		end
		local function tapped()
			local grow = if canDismiss() then nil else nextUp()
			if grow then
				select(grow.id)
			else
				interactive("close")
			end
		end
		local function finish(source: "grip" | "panel")
			local current = session
			if current == nil or current.source ~= source then
				return
			end
			if source == "grip" and not current.moved then
				endSession()
				dragged = now()
				tapped()
				return
			end
			if not current.acquired then
				endSession()
				return
			end
			local height = dragHeight:peek() or current.start
			local speed = velocity(current.samples)
			local choice = release.choose(stops(), height, speed, selected().id, canDismiss())
			if choice == "dismiss" then
				session = nil
				if request == nil then
					spec.isPresented:set(false)
				elseif not request("drag") then
					select(selected().id)
				end
				return
			end
			launch(
				height,
				speed,
				if math.abs(speed) > ctx.metric("motion.fling.bounceSpeed") then ctx.motionSpring("flick") else nil
			)
			endSession()
			select(choice)
		end
		if phase then
			Compose.watch(function(use: ComposeTypes.Use)
				if not use(phase.exiting) and session == nil then
					dragHeight:set(nil)
				end
			end)
		end
		local function lowest(use: ComposeTypes.Use?): number
			local out = math.huge
			for _, d in detents do
				out = math.min(out, heightOf(d, use))
			end
			return out
		end
		local function standing(use: ComposeTypes.Use?): number
			return math.max(painted(use), lowest(use))
		end
		local watchedDetent = detent:peek()
		Compose.watch(function(use: ComposeTypes.Use)
			local id = use(detent)
			if id ~= watchedDetent then
				watchedDetent = id
				if session then
					endSession()
				end
			end
		end)
		Compose.cleanup(function()
			session = nil
		end)
		local pull = Compose.cell(0)
		local pulling: { origin: number, moved: boolean, samples: { { height: number, at: number } } }? = nil
		local held = Compose.cell(false)
		local pullBack = settle(ctx, function(): number
			return 0
		end, ctx.motionSpring("sheet"))
		local function pulled(use: ComposeTypes.Use?): number
			if read(held, use) then
				return readSource(pull, use)
			end
			return readSource(pullBack.value, use) or readSource(pull, use)
		end
		local function toward(): number
			return if edge == "left" then -1 else 1
		end
		local function pullTo(x: number)
			local current = pulling
			if current == nil then
				return
			end
			if math.abs(x - current.origin) > 4 then
				dragged = now()
				current.moved = true
			end
			local amount = math.max(0, (x - current.origin) * toward())
			pull:set(if canDismiss() then amount else amount * HELD_PULL)
			table.insert(current.samples, { height = pull:peek(), at = now() })
		end
		local function release()
			local current = pulling
			pulling = nil
			if current == nil then
				return
			end
			held:set(false)
			if not current.moved then
				pullBack.launch(pull:peek(), 0)
				pull:set(0)
				dragged = now()
				tapped()
				return
			end
			local amount = pull:peek()
			local speed = velocity(current.samples)
			local width = math.min(parts.width(ctx, spec.width), extent:peek().X)
			if canDismiss() and (amount > width / 3 or speed > 600) then
				if request == nil then
					spec.isPresented:set(false)
					return
				elseif request("drag") then
					return
				end
			end
			pullBack.launch(amount, speed)
			pull:set(0)
		end
		Compose.cleanup(function()
			pulling = nil
		end)
		local function detector(name: string, source: "grip" | "panel"): Instance
			local function sideways(): boolean
				return source == "grip" and from() ~= "bottom"
			end
			return Host.UIDragDetector({
				Name = name,
				CursorIcon = function(use: ComposeTypes.Use): string
					if source == "panel" then
						return ""
					end
					return if from(use) == "bottom"
						then "rbxasset://SystemCursors/SizeNS"
						else "rbxasset://SystemCursors/SizeEW"
				end,
				ActivatedCursorIcon = function(): string
					return if source == "grip" then "rbxasset://SystemCursors/ClosedHand" else ""
				end,
				DragStyle = E.UIDragDetectorDragStyle.TranslateLine,
				DragAxis = function(use: ComposeTypes.Use)
					return if source == "grip" and from(use) ~= "bottom" then V2.new(1, 0) else V2.new(0, 1)
				end,
				ResponseStyle = E.UIDragDetectorResponseStyle.CustomOffset,
				Enabled = if source == "panel" and preferred
					then function(use: ComposeTypes.Use): boolean
						return use(preferred) ~= E.PreferredInput.Gamepad
					end
					else nil,
				DragStart = function(position: Vector2)
					if sideways() then
						if pulling == nil then
							local from = pulled()
							pullBack.halt()
							local finger = if canDismiss() then from else from / HELD_PULL
							pulling = { origin = position.X - finger * toward(), moved = false, samples = {} }
							pull:set(from)
							held:set(true)
						end
					else
						grab(source, position.Y)
					end
				end,
				DragContinue = function(position: Vector2)
					if sideways() then
						pullTo(position.X)
					else
						move(source, position.Y)
					end
				end,
				DragEnd = function()
					if sideways() then
						release()
					else
						finish(source)
					end
				end,
			})
		end
		local tallest = Compose.formula(function(use: ComposeTypes.Use): boolean
			local mine = heightOf(selected(use), use)
			for _, other in detents do
				if heightOf(other, use) > mine then
					return false
				end
			end
			return true
		end)
		local grabber = Host.TextButton "Grabber" {
			SelectionOrder = -2,
			Attributes = { FacetFocusPart = "Pill" } :: Types.Attributes,
			AnchorPoint = V2.new(0.5, 0.5),
			Position = function(use: ComposeTypes.Use): UDim2
				local side = from(use)
				local offset = surfaces.inset(0, RESERVED[side], nil, use) + HANDLE / 2
				return if side == "bottom"
					then D2.new(0.5, 0, 0, offset)
					elseif side == "left" then D2.new(1, -offset, 0.5, 0)
					else D2.new(0, offset, 0.5, 0)
			end,
			Visible = indicator ~= "hidden",
			Size = function(use: ComposeTypes.Use)
				return if from(use) == "bottom" then D2.fromOffset(88, 44) else D2.fromOffset(44, 88)
			end,
			BackgroundTransparency = 1,
			ZIndex = 2,
			Text = "",
			AutoButtonColor = false,
			Selectable = function(use: ComposeTypes.Use)
				return #detents > 1 or canDismiss(use)
			end,
			Activated = function(input: InputObject?)
				if now() - dragged < 0.3 then
					return
				end
				if
					input ~= nil
					and (
						input.UserInputType == E.UserInputType.Touch
						or input.UserInputType == E.UserInputType.MouseButton1
					)
				then
					tapped()
					return
				end
				local grow = nextUp()
				if grow then
					select(grow.id)
				else
					interactive("close")
				end
			end,
			detector("UIDragDetector", "grip"),
			ctx.styled(
				Host.Frame "Pill" {
					AnchorPoint = V2.new(0.5, 0.5),
					Position = D2.fromScale(0.5, 0.5),
					Size = function(use: ComposeTypes.Use)
						return if from(use) == "bottom" then D2.fromOffset(36, 5) else D2.fromOffset(5, 36)
					end,
					BorderSizePixel = 0,
					Host.UICorner({ CornerRadius = ctx.round }),
				},
				"grabber"
			) :: Types.Child,
		}

		if gui and gui.GetPropertyChangedSignal and preferred then
			local selection = ctx.observe.SelectedObject(gui)
			local pad = preferred
			runtime.decorate(assert(grabber:FindFirstChildWhichIsA("UIDragDetector")), {
				Enabled = function(use: ComposeTypes.Use): boolean
					return not (use(pad) == E.PreferredInput.Gamepad and use(selection) == grabber)
				end,
			})
		end
		local function stepTo(direction: number, use: ComposeTypes.Use?): Detent?
			local sorted = ordered()
			return sorted[(table.find(sorted, selected(use)) or 1) + direction]
		end
		UI.adjustable(grabber, {
			axis = "horizontal",
			onAdjust = function(direction: number)
				local target = stepTo(direction)
				if target then
					select(target.id)
				end
			end,
			canAdjust = function(direction: number, use: ComposeTypes.Use?): boolean
				return stepTo(direction, use) ~= nil
			end,
		})
		Compose.watch(function(use: ComposeTypes.Use)
			grabber:SetAttribute(
				"AccessibleLabel",
				if nextUp(use) then "Resize: " .. word(selected(use).id) else "Close sheet"
			)
		end)
		return {
			edge = edge,
			level = level,
			unit = unit,
			keyboard = keyboard,
			extent = extent,
			placed = placed,
			reserve = reserve,
			pad = pad,
			hugHeight = hugHeight,
			ready = ready,
			painted = painted,
			canDismiss = canDismiss,
			close = close,
			interactive = interactive,
			lowest = lowest,
			standing = standing,
			pulled = pulled,
			toward = toward,
			detector = detector,
			tallest = tallest,
			grabber = grabber,
			handle = grabber,
		}
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="178">
            <Properties>
              <string name="Name">nav_split_button</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local ControlTypes = require("./control_types")
local NavigationProps = require("./navigation_props")
local MenuItems = require("./nav_menu_items")

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	surfaces: Nav.Surfaces,
	buildMenu: MenuItems.BuildMenu
)
	local Host, Compose, read = ctx.Host, ctx.Compose, ctx.read
	local E, D2, D = ctx.types.Enum, ctx.types.UDim2, ctx.types.UDim
	UI.SplitButton = ctx.construct("SplitButton", function<V>(spec: NavigationProps.SplitButtonSpec<V>): Frame
		local input = surfaces.service("UserInputService")
		local preferred = if input
			then ctx.observe.PreferredInput(input) :: ComposeTypes.Readable<Enum.PreferredInput?>
			else Compose.cell(nil :: Enum.PreferredInput?)
		local touch = Compose.formula(function(use: ComposeTypes.Use)
			return use(preferred) == E.PreferredInput.Touch
		end)
		local opened = Compose.cell(false)
		local enabled = function(use: ComposeTypes.Use)
			return read(spec.enabled, use) ~= false and read(spec.busy, use) ~= true
		end
		local function primary()
			return UI.Button "Primary" {
				appearance = "utility",
				label = spec.label,
				onActivate = spec.onActivate,
				enabled = spec.enabled,
				busy = spec.busy,
				shortcut = spec.shortcut,
			}
		end
		return Host.Frame(
			ctx.props(spec, { "label", "onActivate", "items", "enabled", "busy", "shortcut", "menuLabel" }, {
				Name = "SplitButton",
				BackgroundTransparency = 1,
				Size = D2.fromOffset(0, 0),
				AutomaticSize = E.AutomaticSize.XY,
				Compose.show(touch, function()
					local suppressEcho = false
					local trigger = UI.Button "Primary" {
						Size = if spec.Size then D2.fromScale(1, 1) else nil,
						AutomaticSize = if spec.Size then E.AutomaticSize.None else nil,
						label = spec.label,
						trailingIcon = "chevron.down",
						enabled = spec.enabled,
						busy = spec.busy,
						onActivate = function()
							if suppressEcho then
								suppressEcho = false
								return
							end
							if spec.onActivate then
								spec.onActivate()
							end
						end,
					}
					return buildMenu({
						Name = "TouchAlternatives",
						Size = if spec.Size then D2.fromScale(1, 1) else nil,
						AutomaticSize = if spec.Size then E.AutomaticSize.None else nil,
						trigger = function(): GuiObject
							return trigger
						end,
						items = spec.items,
						enabled = enabled,
						isPresented = opened,
						triggers = { "longPress", "secondary", "keyboard", "gamepad" } :: { Nav.MenuTrigger },
						onOpen = function()
							suppressEcho = true
						end,
						onClose = function()
							suppressEcho = false
						end,
					}, true)
				end, function()
					local row = ctx.row({
						primary(),
						ctx.styled(
							Host.Frame "Divider" {
								BorderSizePixel = 0,
								Size = function(use: ComposeTypes.Use)
									return D2.fromOffset(ctx.metric("strokes.hairline", use), 0)
								end,
								Host.UIFlexItem({ ItemLineAlignment = E.ItemLineAlignment.Stretch }),
							},
							"divider"
						),
						UI.Menu "Alternatives" {
							trigger = function(): GuiObject
								return UI.Button "Trigger" {
									appearance = "utility",
									icon = "chevron.down",
									name = spec.menuLabel or "More options",
									help = spec.menuLabel or "More options",
									enabled = enabled,
									onActivate = function()
										opened:set(true)
									end,
								}
							end,
							items = spec.items,
							enabled = enabled,
							isPresented = opened,
						},
					}, { Name = "Split" })
					assert(row:FindFirstChildWhichIsA("UIListLayout")).Padding = D.new(0, 0)
					row:ResetPropertyToDefault("BackgroundTransparency")
					ctx.skin(ctx.styled(row, "control"), "control", {
						disabled = function(use: ComposeTypes.Use)
							return not enabled(use)
						end,
					})
					return row
				end),
			})
		)
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="179">
            <Properties>
              <string name="Name">nav_stack</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local dragSession = require("./drag_session")
local ComposeTypes = require("../vendor/compose/core")
local parts = require("./overlay_parts")
local motion = require("./motion")
local reducedMotion = motion.reduced
local adaptive = require("./adaptive")
local ControlTypes = require("./control_types")
local NavigationProps = require("./navigation_props")
local pageLayers = require("./nav_page_layers")

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	surfaces: Nav.Surfaces,
	layers: pageLayers.PageLayers
): ()
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local content, checkTransition, layer = layers.content, layers.checkTransition, layers.layer
	local navigationDepth = 0
	local function navigationStack<P>(spec: NavigationProps.NavigationStackSpec<P>): Frame
		local pushSpring = ctx.motionSpring("move")
		local parallax = ctx.metric("motion.distances.parallax")
		local dim = ctx.metric("motion.distances.dim")
		assert(
			type(spec.path) == "table" and spec.path.set and spec.root and spec.destinations,
			"NavigationStack requires path, root and destinations"
		)
		checkTransition(spec.transition)
		local gui = surfaces.service("GuiService")
		local selectedObject = if gui then ctx.observe.SelectedObject(gui) else Compose.cell(nil :: GuiObject?)
		local depth = navigationDepth
		local rootEntry: Nav.NavigationEntry<P> = { id = "@root" }
		local errorText: ComposeTypes.Cell<string?> = Compose.cell(nil :: string?)
		local accepted = { rootEntry }
		local reduce = reducedMotion(ctx)
		local level = motion.level(ctx)
		local timing: Nav.Transition? = if type(spec.transition) == "table" then spec.transition else nil
		local animated = spec.transition == nil
		local function validate(path: { Nav.NavigationEntry<P> }): { Nav.NavigationEntry<P> }
			assert(type(path) == "table", "NavigationStack.path must contain an array")
			local list = { rootEntry }
			for _, entry in path do
				assert(
					type(entry) == "table" and type(entry.id) == "string" and spec.destinations[entry.id],
					"NavigationStack path has an undeclared destination"
				)
				table.insert(list, entry)
			end
			return list
		end
		validate(spec.path:peek())
		local entries = Compose.formula(function(use: ComposeTypes.Use)
			local ok, list = pcall(validate, use(spec.path))
			if ok then
				accepted = list
				errorText:set(nil)
			else
				errorText:set(tostring(list))
			end
			return accepted
		end)
		local leaving: ComposeTypes.Cell<Nav.NavigationEntry<P>?> = Compose.cell(nil :: Nav.NavigationEntry<P>?)
		local root: Frame
		local handoff = false
		local shownList = entries:peek()
		Compose.watch(function(use: ComposeTypes.Use)
			local list = use(entries)
			local former = shownList
			shownList = list
			local top = former[#former]
			if top ~= list[#list] and gui and root and surfaces.within(gui.SelectedObject, root) then
				handoff = true
				root:SetAttribute("FacetSelectionOwner", true)
				gui.SelectedObject = nil
			end
			local departing = leaving:peek()
			if table.find(list, top) == nil and animated and not reduce() then
				leaving:set(top)
			elseif departing and table.find(list, departing) then
				leaving:set(nil)
			end
		end)
		local displayed = Compose.formula(function(use: ComposeTypes.Use)
			local list = use(entries)
			local departing = use(leaving)
			if departing == nil or table.find(list, departing) then
				return list
			end
			local result = table.clone(list)
			table.insert(result, departing)
			return result
		end)
		local offsets: ComposeTypes.Cell<{ [Nav.NavigationEntry<P>]: (ComposeTypes.Use?) -> number }> = Compose.cell({})
		local stackReady = false
		local function pop()
			local path = table.clone(spec.path:peek())
			if #path > 0 then
				table.remove(path)
				spec.path:set(path)
			end
		end
		local function frontOffset(use: ComposeTypes.Use): number
			local list = use(displayed)
			local measure = use(offsets)[list[#list]]
			return if measure then measure(use) else 0
		end
		local backdrop: ComposeTypes.Cell<Color3?> = Compose.cell(nil :: Color3?)
		local moving = Compose.formula(function(use: ComposeTypes.Use): boolean
			return frontOffset(use) > 0 or use(leaving) ~= nil
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			if not use(moving) then
				return
			end
			local at: Instance? = root and root.Parent
			while at do
				if at:IsA("GuiObject") and (at:GetStyled("BackgroundTransparency") :: number) < 1 then
					backdrop:set(at:GetStyled("BackgroundColor3") :: Color3)
					return
				end
				at = at.Parent
			end
			backdrop:set(nil)
		end)
		root = Host.Frame(ctx.props(spec, { "path", "root", "destinations", "backLabel", "chrome", "transition" }, {
			Name = "NavigationStack",
			BackgroundTransparency = 1,
			Size = D2.fromScale(1, 1),
			ClipsDescendants = moving,
			Compose.LayerStack({
				from = displayed,
				retention = "all",
				render = function(
					current: ComposeTypes.Readable<Nav.NavigationEntry<P>>,
					state: ComposeTypes.Readable<ComposeTypes.LayerStackState>
				): Instance
					local entry = current:peek()
					local destination = if entry == rootEntry then spec.root else spec.destinations[entry.id]
					local titled = entry ~= rootEntry or (destination.title ~= nil and destination.title ~= "")
					local function chromeVisible(use: ComposeTypes.Use?): boolean
						local policy = read(destination.chrome, use) or read(spec.chrome, use)
						assert(
							policy == nil or policy == "automatic" or policy == "hidden",
							"Invalid NavigationStack.chrome"
						)
						return titled and policy ~= "hidden"
					end
					local function chrome(use: ComposeTypes.Use?): number
						return if chromeVisible(use) then ctx.metric("targetSizes.minimum", use) else 0
					end
					local role = Compose.formula(function(use: ComposeTypes.Use): string
						local list = use(entries)
						local at = table.find(list, entry)
						return if at == nil then "exiting" elseif at == #list then "top" else "covered"
					end)
					local entering = Compose.cell(stackReady and animated and not reduce())
					local function target(use: ComposeTypes.Use): number
						return if use(role) == "exiting" or use(entering) and not reduce(use) then 1 else 0
					end
					local travel: ComposeTypes.Readable<number> = if animated
						then runtime.spring(target, {
							period = pushSpring.period,
							damping = pushSpring.damping,
							tolerance = 1e-3,
							reducedMotion = function(use: ComposeTypes.Use): boolean
								return reduce(use)
							end,
						})
						else Compose.cell(0)
					entering:set(false)
					local fading = Compose.cell(stackReady and animated and level() == "limited")
					local arrival = runtime.tween(function(use: ComposeTypes.Use): number
						return if use(fading) then 0 else 1
					end, { seconds = ctx.metric("motion.reducedFade"), ease = ctx.motionEase("fade") })
					fading:set(false)
					local function offset(use: ComposeTypes.Use?): number
						if not animated or reduce(use) then
							return if read(role, use) == "exiting" then 1 else 0
						end
						return read(travel, use)
					end
					local registered = table.clone(offsets:peek())
					registered[entry] = offset
					offsets:set(registered)
					Compose.cleanup(function()
						local remaining = table.clone(offsets:peek())
						remaining[entry] = nil
						offsets:set(remaining)
					end)
					local function placement(use: ComposeTypes.Use): (string, number)
						local list = use(displayed)
						local at = table.find(list, entry)
						if at == #list then
							return "front", offset(use)
						end
						if at == #list - 1 then
							local above = use(offsets)[list[#list]]
							local moved = if above then above(use) else 0
							if moved > 0 or use(role) == "top" then
								return "beneath", moved
							end
						end
						return "rest", 0
					end
					local function reveal(use: ComposeTypes.Use): number
						local place, moved = placement(use)
						return if place == "beneath" then moved + parallax * (1 - moved) else 1
					end
					local title = ctx.text({
						Name = "Title",
						Text = destination.title or "",
						Size = D2.fromScale(1, 1),
						TextTruncate = E.TextTruncate.AtEnd,
						TextXAlignment = function(use: ComposeTypes.Use)
							return if use(state).index > 1 then E.TextXAlignment.Center else E.TextXAlignment.Left
						end,
					})
					runtime.mount(function()
						local function inset(use: ComposeTypes.Use): UDim
							return ctx.types.UDim.new(0, ctx.controlSize(nil, "paddingX", use))
						end
						return Host.UIPadding({ PaddingLeft = inset, PaddingRight = inset })
					end, title)
					local navigationBar = Host.Frame "NavigationBar" {
						BackgroundTransparency = 1,
						Size = function(use: ComposeTypes.Use)
							return D2.new(1, 0, 0, chrome(use))
						end,
						Visible = chromeVisible,
						title :: Types.Child,
						Compose.show(function(use: ComposeTypes.Use)
							return chromeVisible(use) and use(state).index > 1
						end, function()
							return parts.back(ctx, UI, spec.backLabel, pop, {
								AnchorPoint = V2.new(0, 0.5),
								Position = D2.fromScale(0, 0.5),
							})
						end),
					}
					local barSize = ctx.observe.AbsoluteSize(navigationBar)
					Compose.watch(function(use: ComposeTypes.Use)
						local large = entry == rootEntry and adaptive.sizeClass(use(barSize).X) ~= "compact"
						title:RemoveTag(if large then "facet-type-heading" else "facet-type-title")
						title:AddTag(if large then "facet-type-title" else "facet-type-heading")
					end)
					local destinationFrame = Host.Frame "Destination" {
						BackgroundTransparency = 1,
						Position = function(use: ComposeTypes.Use)
							return D2.fromOffset(0, chrome(use))
						end,
						Size = function(use: ComposeTypes.Use)
							return D2.new(1, 0, 1, -chrome(use))
						end,
						Compose.boundary(function()
							navigationDepth += 1
							local ok, built =
								pcall(content, destination.content, if entry == rootEntry then nil else entry)
							navigationDepth -= 1
							if not ok then
								error(built, 0)
							end
							return built
						end, function(failure)
							errorText:set(tostring(failure))
							return ctx.text({
								Name = "DestinationError",
								Text = "This page could not be displayed.",
								TextWrapped = true,
							})
						end),
					}
					local panel: GuiObject
					if timing then
						panel = layer({
							Name = entry.id,
							BackgroundTransparency = 1,
							Size = D2.fromScale(1, 1),
							Visible = function(use: ComposeTypes.Use)
								return use(state).top
							end,
							navigationBar,
							destinationFrame,
						}, state, timing)
					else
						panel = ctx.fade({
							Name = entry.id,
							GroupTransparency = function(use: ComposeTypes.Use)
								return if level(use) == "limited" then 1 - use(arrival) else 0
							end,
							BackgroundTransparency = function(use: ComposeTypes.Use)
								return if use(moving)
										and use(backdrop) ~= nil
										and placement(use) ~= "rest"
									then 0
									else 1
							end,
							BackgroundColor3 = function(use: ComposeTypes.Use)
								return use(backdrop) or ctx.types.Color3.new(0, 0, 0)
							end,
							BorderSizePixel = 0,
							Size = D2.fromScale(1, 1),
							Position = function(use: ComposeTypes.Use)
								local place, moved = placement(use)
								return if place == "front"
									then D2.fromScale(moved, 0)
									elseif place == "beneath" then D2.fromScale(-parallax * (1 - moved), 0)
									else D2.fromScale(0, 0)
							end,
							ClipsDescendants = function(use: ComposeTypes.Use)
								return reveal(use) < 1
							end,
							Visible = function(use: ComposeTypes.Use)
								local place = placement(use)
								return place == "beneath" or place == "front" and use(role) ~= "covered"
							end,
							Interactable = function(use: ComposeTypes.Use)
								return use(role) == "top"
							end,
							Host.Frame "Page" {
								BackgroundTransparency = 1,
								Size = D2.fromScale(1, 1),
								navigationBar,
								destinationFrame,
							} :: Types.Child,
							Compose.show(function(use: ComposeTypes.Use)
								return placement(use) == "beneath"
							end, function()
								return Host.Frame "Dim" {
									BackgroundColor3 = ctx.types.Color3.new(0, 0, 0),
									BorderSizePixel = 0,
									Size = D2.fromScale(1, 1),
									ZIndex = 10,
									Interactable = false,
									BackgroundTransparency = function(use: ComposeTypes.Use)
										local _, moved = placement(use)
										return 1 - dim * (1 - moved)
									end,
								}
							end) :: Types.Child,
						})
					end
					Compose.watch(function(use: ComposeTypes.Use)
						if not use(moving) then
							return
						end
						if gui and surfaces.within(gui.SelectedObject, panel) then
							handoff = true
							root:SetAttribute("FacetSelectionOwner", true)
							gui.SelectedObject = nil
						end
						if use(role) == "exiting" and offset(use) >= 1 and leaving:peek() == entry then
							leaving:set(nil)
						end
					end)
					local visible, parent = ctx.observe.Visible(panel), ctx.observe.Parent(panel)
					local interactable = ctx.observe.Interactable(panel)
					local remembered: GuiObject?
					local rememberedPath: { string } = {}
					local previousTop: boolean?
					local focusing = surfaces.selecting()
					Compose.watch(function(use: ComposeTypes.Use)
						local selected = use(selectedObject)
						if selected and selected:IsA("GuiObject") and surfaces.within(selected, panel) then
							remembered = selected :: GuiObject
							table.clear(rememberedPath)
							local at: Instance? = selected
							while at and at ~= panel do
								table.insert(rememberedPath, 1, at.Name)
								at = at.Parent
							end
						end
					end)
					local function recall(): GuiObject?
						if remembered and remembered.Parent then
							return remembered
						end
						local at: Instance? = panel
						for _, name in rememberedPath do
							at = if at then at:FindFirstChild(name) else nil
						end
						return if at and at ~= panel and at:IsA("GuiObject") then at :: GuiObject else nil
					end
					Compose.watch(function(use: ComposeTypes.Use)
						local top = use(role) == "top"
						if top and (use(moving) or not use(visible) or not use(interactable)) then
							return
						end
						if not use(parent) then
							return
						end
						if
							gui
							and top
							and use(visible)
							and use(parent)
							and previousTop ~= true
							and (previousTop == false or use(state).index > 1)
							and (gui.SelectedObject ~= nil or handoff or focusing(use))
						then
							handoff = false
							local back = recall()
							gui.SelectedObject = if back
									and back.Visible
									and back.Selectable
									and back.Interactable
								then back
								else surfaces.firstSelectable(panel)
							root:SetAttribute("FacetSelectionOwner", false)
						end
						previousTop = top
					end)
					surfaces.keep(destination.content)
					return panel
				end,
			}),
		}))
		stackReady = true
		local swipeOrigin: number? = nil
		local swipeBlocked = false
		local drag = dragSession(ctx)
		local stackUnit = ctx.layoutUnit(root)
		runtime.decorate(root, {
			Active = function(use: ComposeTypes.Use): boolean
				local path = use(spec.path)
				local entry = path[#path]
				local destination = if entry then spec.destinations[entry.id] else spec.root
				return read(spec.Active, use) == true
					or (
						entry ~= nil
						and destination ~= nil
						and (read(destination.chrome, use) or read(spec.chrome, use)) == "hidden"
					)
			end,
		})
		runtime.connect(root, "InputBegan", function(input: InputObject)
			swipeOrigin = if input.UserInputType == E.UserInputType.Touch then input.Position.X else nil
			swipeBlocked = drag.state:peek() ~= nil
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			if use(drag.state) ~= nil and swipeOrigin ~= nil then
				swipeBlocked = true
			end
		end)
		runtime.connect(root, "TouchSwipe", function(direction: Enum.SwipeDirection, touches: number)
			local path = spec.path:peek()
			local entry = path[#path]
			local destination = if entry then spec.destinations[entry.id] else spec.root
			local origin = swipeOrigin
			swipeOrigin = nil
			if
				direction == E.SwipeDirection.Right
				and touches == 1
				and entry
				and destination ~= nil
				and origin ~= nil
				and origin >= root.AbsolutePosition.X
				and origin <= root.AbsolutePosition.X + ctx.metric("controls.navigationBack.swipeEdge") * stackUnit:peek()
				and not moving:peek()
				and not swipeBlocked
				and (read(destination.chrome) or read(spec.chrome)) == "hidden"
				and dragSession(ctx).state:peek() == nil
			then
				pop()
			end
		end)
		if ctx.action then
			local drag = dragSession(ctx)
			root:SetAttribute("FacetNavigationStack", true)
			local nesting = Compose.cell(depth)
			local _, context = ctx.action(
				root,
				"NavigationBack",
				{ "Escape", "ButtonB" },
				function(use: ComposeTypes.Use)
					return use(drag.state) == nil
						and #use(spec.path) > 0
						and (use(nesting) == 0 or surfaces.within(use(selectedObject), root))
				end,
				pop,
				{ priority = 1000 + depth }
			)
			local function locate()
				local count, at = 0, root.Parent
				while at do
					if at:GetAttribute("FacetNavigationStack") == true then
						count += 1
					end
					at = at.Parent
				end
				nesting:set(count)
				context.Priority = 1000 + count
			end
			runtime.connect(root, "AncestryChanged", locate)
			locate()
		end
		Compose.watch(function(use: ComposeTypes.Use)
			root:SetAttribute("FacetError", use(errorText))
		end)
		return root
	end

	UI.NavigationStack = ctx.construct("NavigationStack", navigationStack)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="180">
            <Properties>
              <string name="Name">nav_surface_kit</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")

export type Attach = (Instance, { Types.Child }) -> Instance
export type Kit = {
	gui: GuiService?,
	input: UserInputService?,
	service: (("GuiService") -> GuiService?) & (("UserInputService") -> UserInputService?),
	selecting: () -> (ComposeTypes.Use) -> boolean,
	preference: () -> (ComposeTypes.Use) -> number,
	keep: (...unknown) -> (),
	within: (Instance?, Instance) -> boolean,
	displayed: (Instance) -> boolean,
	firstSelectable: (Instance, string?) -> GuiObject?,
	attach: Attach,
	inset: (number, string, string?, ComposeTypes.Use?) -> number,
	skin: (GuiObject, string?, Nav.PanelSkin?) -> GuiObject,
	centered: (GuiObject, number) -> GuiObject,
}

return function(ctx: Types.Context, attach: Attach): Kit
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local services: Types.Services = ctx.config.services or {}
	local function service(name: "GuiService" | "UserInputService"): (GuiService | UserInputService)?
		if name == "GuiService" then
			return services.GuiService or (if game then game:GetService("GuiService") else nil)
		end
		return services.UserInputService or (if game then game:GetService("UserInputService") else nil)
	end
	local gui = service("GuiService") :: GuiService?
	local input = service("UserInputService") :: UserInputService?

	local function selecting(): (ComposeTypes.Use) -> boolean
		local active = gui ~= nil and gui.SelectedObject ~= nil
		local last: ComposeTypes.Cell<Enum.UserInputType>? = nil
		if input and input.GetLastInputType then
			local source = Compose.cell(input:GetLastInputType())
			last = source
			runtime.connect(input, "LastInputTypeChanged", function(value: Enum.UserInputType)
				source:set(value)
			end)
		end
		local preferred = if input and input.GetPropertyChangedSignal then ctx.observe.PreferredInput(input) else nil
		return function(use: ComposeTypes.Use): boolean
			local preference = if preferred then use(preferred) else nil
			if preference == E.PreferredInput.Touch then
				return false
			end
			if preference == E.PreferredInput.Gamepad then
				return true
			end
			local value = if last then use(last) else nil
			return active
				and (value == nil or value == E.UserInputType.Keyboard or string.find(value.Name, "^Gamepad") ~= nil)
		end
	end

	local function preference(): (ComposeTypes.Use) -> number
		local source = if gui and gui.GetPropertyChangedSignal then ctx.observe.PreferredTransparency(gui) else nil
		return function(use: ComposeTypes.Use): number
			local value = if source then use(source) else 1
			return if type(value) == "number" and value == value then math.clamp(value, 0, 1) else 1
		end
	end
	local function keep(...: unknown): ()
		for index = 1, select("#", ...) do
			local content = select(index, ...)
			if content and type(content) ~= "function" then
				local node = content :: Instance
				local parent = node.Parent
				if parent then
					runtime.mount(function()
						return runtime.borrow(node)
					end, parent)
				end
				Compose.cleanup(function()
					if node.Parent ~= nil then
						node.Parent = nil
					end
				end)
			end
		end
	end
	local function within(node: Instance?, ancestor: Instance): boolean
		return node ~= nil and (node == ancestor or node:IsDescendantOf(ancestor))
	end
	local function displayed(node: Instance): boolean
		local at: Instance? = node
		while at and not at:IsA("LayerCollector") do
			if at:IsA("GuiObject") and not at.Visible then
				return false
			end
			at = at.Parent
		end
		return at ~= nil
	end
	local function firstSelectable(node: Instance, preferred: string?): GuiObject?
		if node:IsA("GuiObject") and (not node.Visible or not node.Interactable) then
			return nil
		end
		if
			node:IsA("GuiObject")
			and node.Visible
			and node.Selectable
			and node.Interactable
			and (not node:IsA("ScrollingFrame") or node:GetAttribute("FacetSelectionOwner") == true)
		then
			if preferred == nil or node.Name == preferred then
				return node
			end
		end
		for _, child in node:GetChildren() do
			local found = firstSelectable(child, preferred)
			if found then
				return found
			end
		end
		return if node:IsA("ScrollingFrame")
				and node.Selectable
				and (preferred == nil or node.Name == preferred)
			then node
			else nil
	end
	local function inset(authored: number, side: string, slot: string?, use: ComposeTypes.Use?): number
		local package = ctx.read(ctx.config.theme, use)
		local recipe = if package and package.chrome then package.chrome[slot or "panel"] else nil
		local carve = if recipe then recipe.contentInsets else nil
		if carve == nil then
			return authored
		end
		local value = if side == "top"
			then carve.top
			elseif side == "bottom" then carve.bottom
			elseif side == "left" then carve.left
			else carve.right
		return math.max(authored, value or 0)
	end
	local function skin(panel: GuiObject, slot: string?, options: Nav.PanelSkin?): GuiObject
		local settings: Nav.PanelSkin = options or {}
		local extra = settings.reserve
		ctx.skin(panel, slot or "panel", { label = settings.title, onCaption = settings.onCaption })
		local padding = if settings.padding == false
			then nil
			else settings.padding or panel:FindFirstChildWhichIsA("UIPadding")
		if padding and (ctx.config.theme ~= nil or extra) then
			local function side(name: string, authored: UDim): (ComposeTypes.Use) -> UDim
				return function(use: ComposeTypes.Use): UDim
					return ctx.types.UDim.new(
						0,
						inset(
							if authored.Scale == 0
									and authored.Offset == 0
									and extra == nil
									and (slot == nil or slot == "panel")
								then ctx.metric("space.m", use)
								else authored.Offset,
							name,
							slot,
							use
						) + (if extra then extra(name, use) else 0)
					)
				end
			end
			runtime.decorate(padding, {
				PaddingTop = side("top", padding.PaddingTop),
				PaddingBottom = side("bottom", padding.PaddingBottom),
				PaddingLeft = side("left", padding.PaddingLeft),
				PaddingRight = side("right", padding.PaddingRight),
			})
		end
		return panel
	end
	local function centered(panel: GuiObject, width: number): GuiObject
		runtime.decorate(panel, {
			AnchorPoint = V2.new(0.5, 0.5),
			Position = D2.fromScale(0.5, 0.5),
			Size = D2.new(1, -32, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
		})
		attach(panel, { Host.UISizeConstraint({ MaxSize = V2.new(width or 440, math.huge) }) })
		return panel
	end
	return {
		gui = gui,
		input = input,
		service = service :: (("GuiService") -> GuiService?) & (("UserInputService") -> UserInputService?),
		selecting = selecting,
		preference = preference,
		keep = keep,
		within = within,
		displayed = displayed,
		firstSelectable = firstSelectable,
		attach = attach,
		inset = inset,
		skin = skin,
		centered = centered,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="181">
            <Properties>
              <string name="Name">nav_surface_parts</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local motionLevels = require("./motion")

export type SurfaceParts = {
	body: (Nav.Content) -> Instance,
	empty: (Types.FrameProps, { string }, string) -> Frame,
	revealMotion: (
		ComposeTypes.Cell<boolean>
	) -> ((ComposeTypes.Use?) -> number, ComposeTypes.Readable<boolean>, (ComposeTypes.Use) -> number),
	unroll: (
		(ComposeTypes.Use?) -> number,
		ComposeTypes.Readable<Vector2>
	) -> ((ComposeTypes.Use) -> Enum.AutomaticSize, (ComposeTypes.Use) -> number?),
}

return function(ctx: Types.Context): SurfaceParts
	local Host, runtime, read = ctx.Host, ctx.runtime, ctx.read
	local E, D2 = ctx.types.Enum, ctx.types.UDim2
	local function body(content: Nav.Content): Instance
		return if type(content) == "function" then content() else content
	end
	local function empty(spec: Types.FrameProps, keys: { string }, name: string): Frame
		return Host.Frame(
			ctx.props(spec, keys, { Name = name, BackgroundTransparency = 1, Size = D2.fromOffset(0, 0) })
		)
	end
	local function revealMotion(expanded: ComposeTypes.Cell<boolean>): ((ComposeTypes.Use?) -> number, ComposeTypes.Readable<boolean>, (
		ComposeTypes.Use
	) -> number)
		local level = motionLevels.level(ctx)
		local reveal, fade = ctx.motionTiming("reveal"), ctx.motionEase("fade")
		local function motion(
			share: (ComposeTypes.Use) -> number,
			ease: ComposeTypes.Easing?,
			fades: boolean
		): (ComposeTypes.Use?) -> number
			local value = runtime.tween(function(use: ComposeTypes.Use): number
				return if use(expanded) then 1 else 0
			end, {
				seconds = function(use: ComposeTypes.Use): number
					if fades and level() == "limited" then
						return ctx.metric("motion.reducedFade", use)
					end
					return share(use) * (if expanded:peek() then reveal.enter else reveal.exit)
				end,
				ease = ease,
			})
			return function(use: ComposeTypes.Use?): number
				local current = level(use)
				if current == "none" or (current == "limited" and not fades) then
					return if read(expanded, use) then 1 else 0
				end
				return read(value, use)
			end
		end
		local progress, opacity =
			motion(function()
				return 1
			end, ctx.motionEase("present"), false), motion(function(use: ComposeTypes.Use): number
				return ctx.metric("motion.revealFadeShare", use)
			end, function(t: number): number
				return if level() == "limited" then fade(t) else t
			end, true)
		return progress,
			ctx.Compose.formula(function(use: ComposeTypes.Use): boolean
				return progress(use) <= 0
			end),
			function(use: ComposeTypes.Use): number
				return 1 - opacity(use)
			end
	end
	local function unroll(progress: (ComposeTypes.Use?) -> number, natural: ComposeTypes.Readable<Vector2>)
		return function(use: ComposeTypes.Use): Enum.AutomaticSize
			return if progress(use) >= 1 then E.AutomaticSize.Y else E.AutomaticSize.None
		end, function(use: ComposeTypes.Use): number?
			local amount = progress(use)
			return if amount >= 1 then nil else math.floor(use(natural).Y * amount + 0.5)
		end
	end
	return { body = body, empty = empty, revealMotion = revealMotion, unroll = unroll }
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="182">
            <Properties>
              <string name="Name">nav_surfaces</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ControlTypes = require("./control_types")
local surfaceParts = require("./nav_surface_parts")
local disclosure = require("./nav_disclosure")
local collapsible = require("./nav_collapsible")
local alert = require("./nav_alert")
local callout = require("./nav_callout")

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces): ()
	local kit = surfaceParts(ctx)
	disclosure(ctx, UI, surfaces, kit)
	collapsible(ctx, UI, surfaces, kit)
	alert(ctx, UI, surfaces, kit)
	callout(ctx, UI, surfaces, kit)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="183">
            <Properties>
              <string name="Name">nav_tab_accessories</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local segmentMetrics = require("./segment_metrics")
local NavigationProps = require("./navigation_props")
local tabMetrics = require("./nav_tab_metrics")

export type TabAccessoryView = {
	frame: tabMetrics.TabFrame,
	aboveHeight: ComposeTypes.Cell<number>,
	metrics: tabMetrics.TabMetrics,
}

return function(
	ctx: Types.Context,
	surfaces: Nav.Surfaces,
	spec: NavigationProps.TabViewSpec,
	root: Frame,
	view: TabAccessoryView
): ()
	local Host, Compose, runtime = ctx.Host, ctx.Compose, ctx.runtime
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local INSET = segmentMetrics.inset
	local frame = view.frame
	local placement, headHeight, footHeight, trailingWidth =
		frame.placement, frame.headHeight, frame.footHeight, frame.trailingWidth
	local aboveHeight = view.aboveHeight
	local metrics = view.metrics
	local band, bottomInset = metrics.band, metrics.bottomInset
	local slots: { [string]: { [string]: boolean } } = {
		head = { sidebar = true },
		foot = { sidebar = true },
		trailing = { topBar = true, bottomBar = true, bottomBarCompact = true },
		aboveBar = { bottomBar = true, bottomBarCompact = true },
	}
	local accessories: { [string]: (Nav.Placement) -> Instance? } = spec.accessories or {}
	for slot, build in accessories do
		assert(
			slots[slot] and type(build) == "function",
			"TabView accessories require head, foot, trailing or aboveBar builders"
		)
		if spec.placement and spec.placement ~= "automatic" and type(spec.placement) == "string" then
			assert(slots[slot][spec.placement], "TabView accessory is unavailable in this placement")
		end
		surfaces.attach(root, {
			Compose.keyed({
				from = function(use: ComposeTypes.Use): { Nav.Placement }
					local place = use(placement) :: Nav.Placement
					local result: { Nav.Placement } = {}
					if slots[slot][place] then
						table.insert(result, place)
					end
					return result
				end,
				render = function(current: ComposeTypes.Readable<Nav.Placement>): Instance
					local built = build(current:peek())
					if built == nil then
						return Host.Folder({})
					end
					local accessory = Host.Frame("Accessory-" .. slot)({
						BackgroundTransparency = 1,
						ClipsDescendants = true,
						Size = function(use: ComposeTypes.Use)
							return if slot == "head" or slot == "foot"
								then D2.fromOffset(metrics.railWidth(use), 0)
								elseif slot == "trailing" then D2.fromOffset(0, band(use))
								else D2.new(1, 0, 0, 0)
						end,
						AutomaticSize = if slot == "trailing" then E.AutomaticSize.X else E.AutomaticSize.Y,
						built,
					})
					local measure = ctx.observe.AbsoluteSize(accessory)
					local metric: ComposeTypes.Cell<number> = if slot == "head"
						then headHeight
						elseif slot == "foot" then footHeight
						elseif slot == "trailing" then trailingWidth
						else aboveHeight
					Compose.watch(function(use: ComposeTypes.Use)
						local size = use(measure)
						metric:set(if slot == "trailing" then size.X else size.Y)
					end)
					Compose.cleanup(function()
						metric:set(0)
					end)
					runtime.decorate(accessory, {
						Name = "Accessory-" .. slot,
						ZIndex = 5,
						AnchorPoint = V2.new(
							if slot == "trailing" then 1 else 0,
							if slot == "foot" or slot == "aboveBar" then 1 else 0
						),
						Position = function(use: ComposeTypes.Use)
							local place = use(placement)
							if slot == "head" then
								return D2.fromOffset(0, 0)
							end
							if slot == "foot" then
								return D2.fromScale(0, 1)
							end
							if slot == "aboveBar" then
								return D2.new(0, 0, 1, -band(use) - bottomInset(use))
							end
							return D2.new(
								1,
								0,
								if place == "topBar" then 0 else 1,
								if metrics.segmentedTop(use)
									then INSET
									elseif place == "topBar" then 0
									else -band(use) - bottomInset(use)
							)
						end,
					})
					return accessory
				end,
			}),
		})
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="184">
            <Properties>
              <string name="Name">nav_tab_item</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local Content = require("./content_types")
local ComposeTypes = require("../vendor/compose/core")
local NavigationProps = require("./navigation_props")
local tabMetrics = require("./nav_tab_metrics")
local textMeasure = require("./text_measure")

export type TabItemView = {
	frame: tabMetrics.TabFrame,
	select: (string) -> (),
	sectionLabels: { [string]: string },
	tabButtons: { [string]: TextButton },
	tabMeasures: { [string]: { position: ComposeTypes.Readable<Vector2>, size: ComposeTypes.Readable<Vector2> } },
	tabLinks: ComposeTypes.Cell<number>,
	metrics: tabMetrics.TabMetrics,
}

local CORNER_OVERLAP = 0.25

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	surfaces: Nav.Surfaces,
	spec: NavigationProps.TabViewSpec,
	view: TabItemView
): Types.Child
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2, V2, D = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2, ctx.types.UDim
	local frame = view.frame
	local fit, placement, visibleTabs = frame.fit, frame.placement, frame.visibleTabs
	local layoutUnit, indicatorOf, select = frame.layoutUnit, frame.indicatorOf, view.select
	local sectionLabels, tabButtons, tabMeasures, tabLinks =
		view.sectionLabels, view.tabButtons, view.tabMeasures, view.tabLinks
	local metrics = view.metrics
	local wordWidths, stacked, crowded, labelLine, iconGap =
		metrics.wordWidths, metrics.stacked, metrics.crowded, metrics.labelLine, metrics.iconGap
	local badgeClearances, band, tabHeight = metrics.badgeClearances, metrics.band, metrics.tabHeight
	return Compose.keyed({
		from = visibleTabs,
		key = function(tab: Nav.Tab): string
			return tab.id
		end,
		render = function(current: ComposeTypes.Readable<Nav.Tab>, index: ComposeTypes.Readable<number>): Instance
			local tab = current:peek()
			local button = UI.Button({
				Name = tab.id,
				controlSize = spec.controlSize,
				label = function(use: ComposeTypes.Use)
					local tab = use(current)
					if read(spec.iconOnly, use) then
						return ""
					end
					return tostring(read(tab.label, use) or tab.id)
				end,
				name = function(use: ComposeTypes.Use): string
					local tab = use(current)
					local badge = read(tab.badge, use)
					return tostring(read(tab.label, use) or tab.id)
						.. (if badge ~= nil and badge ~= "" then ` ({badge})` else "")
				end,
				icon = tab.icon,
				subtitle = if tab.badge ~= nil and tab.icon == nil
					then function(): string
						return ""
					end
					else nil,
				TextSize = if fit then nil else (spec.textSize :: unknown) :: Types.Value<number>,
				LayoutOrder = index,
				Size = function(use: ComposeTypes.Use)
					local place = use(placement)
					local height = tabHeight(use)
					if string.find(place, "bottom") ~= nil and (stacked(use) or (fit and not use(crowded))) then
						return D2.new(1 / math.max(1, #use(visibleTabs)), -4, 0, height)
					end
					return if place == "sidebar" then D2.new(1, 0, 0, height) else D2.fromOffset(0, height)
				end,
				AutomaticSize = function(use: ComposeTypes.Use)
					local place = use(placement)
					return if place == "sidebar"
							or (string.find(place, "bottom") ~= nil and (stacked(use) or (fit and not use(crowded))))
						then E.AutomaticSize.None
						else E.AutomaticSize.X
				end,
				TextXAlignment = function(use: ComposeTypes.Use)
					return if use(placement) == "sidebar" and read(spec.railWidth, use) ~= nil
						then E.TextXAlignment.Left
						else E.TextXAlignment.Center
				end,
				TextTruncate = E.TextTruncate.AtEnd,
				enabled = function(use: ComposeTypes.Use): boolean
					return read(spec.enabled, use) ~= false and read(use(current).enabled, use) ~= false
				end,
				selected = function(use: ComposeTypes.Use)
					local indicator = indicatorOf(use)
					if use(spec.selection) ~= tab.id or indicator == "none" or indicator == "mark" then
						return false
					end
					local place = use(placement)
					return indicator == "pill" or place == "sidebar" or string.find(place, "bottom") ~= nil
				end,
				onActivate = function()
					select(tab.id)
				end,
			})
			button:AddTag("facet-tab-item")
			do
				local measure = ctx.text({
					Name = "LabelMeasure",
					Visible = false,
					TextWrapped = false,
					Text = function(use: ComposeTypes.Use): string
						return tostring(read(use(current).label, use) or tab.id)
					end,
					TextSize = function(use: ComposeTypes.Use): number
						local authored = if fit then nil else read(spec.textSize, use)
						return if type(authored) == "number"
							then authored
							else ctx.metric("typography.control.size", use)
					end,
				})
				surfaces.attach(button, { measure :: Types.Child })
				local natural = textMeasure.natural(ctx, measure, function()
					local bounds = ctx.observe.TextBounds(measure)
					return Compose.formula(function(use: ComposeTypes.Use): Vector2
						return use(bounds) / use(layoutUnit)
					end)
				end)
				Compose.watch(function(use: ComposeTypes.Use)
					local width = use(natural).X * use(layoutUnit)
					if width == math.huge then
						return
					end
					local widths = table.clone(wordWidths:peek())
					widths[tab.id] = width
					wordWidths:set(widths)
				end)
				Compose.cleanup(function()
					local widths = table.clone(wordWidths:peek())
					widths[tab.id] = nil
					wordWidths:set(widths)
				end)
			end
			if fit then
				local measure = button:FindFirstChild("LabelMeasure") :: TextLabel
				local measured = textMeasure.natural(ctx, measure, function()
					local bounds = ctx.observe.TextBounds(measure)
					return Compose.formula(function(use: ComposeTypes.Use): Vector2
						return use(bounds) / use(layoutUnit)
					end)
				end)
				local natural = Compose.formula(function(use: ComposeTypes.Use): Vector2
					return use(measured) * use(layoutUnit)
				end)
				local room = ctx.observe.AbsoluteSize(button)
				local function budget(use: ComposeTypes.Use): (number, number, number, boolean)
					local width = use(natural).X
					local unit = use(layoutUnit)
					local glyphWidth = if not stacked(use) and use(current).icon
						then (ctx.controlSize(spec.controlSize, "iconSize", use) + ctx.metric("space.xs", use)) * unit
						else 0
					local padded = use(room).X
						- 2 * ctx.controlSize(spec.controlSize, "paddingX", use) * unit
						- glyphWidth
					local snug = use(room).X - glyphWidth - 2 * ctx.metric("space.xs", use) * unit
					local fitting = string.find(use(placement), "bottom") ~= nil and not use(crowded)
					return width, padded, snug, fitting
				end
				local tight = Compose.formula(function(use: ComposeTypes.Use): boolean
					local width, padded, _, fitting = budget(use)
					return fitting and width > 0 and padded > 0 and width > padded
				end)
				Compose.watch(function(use: ComposeTypes.Use)
					if use(tight) then
						button:AddTag("facet-button-tight")
					elseif button:HasTag("facet-button-tight") then
						button:RemoveTag("facet-button-tight")
					end
				end)
				local target = Compose.formula(function(use: ComposeTypes.Use): number?
					local width, padded, snug, fitting = budget(use)
					local available = if use(tight) then snug else padded
					if not fitting or width <= 0 or available <= 0 then
						return nil
					end
					local largest = ctx.metric("typography.control.size", use)
					local smallest = ctx.metric("typography.caption.size", use)
					return math.clamp(math.floor(largest * available / width), smallest, largest)
				end)
				local drop = Compose.cell(0)
				Compose.watch(function(use: ComposeTypes.Use)
					use(target)
					drop:set(0)
				end)
				local caption = button:FindFirstChild("Title", true)
				local title: TextLabel? = if caption and caption:IsA("TextLabel") then caption else nil
				Compose.watch(function(use: ComposeTypes.Use)
					local size = use(target)
					if size == nil then
						button:ResetPropertyToDefault("TextSize")
						if title then
							title:ResetPropertyToDefault("TextSize")
						end
						return
					end
					local smallest = ctx.metric("typography.caption.size", use)
					button.TextSize = math.max(smallest, size - use(drop))
					if title then
						title.TextSize = button.TextSize
					end
				end)
				local fits, drawn = ctx.observe.TextFits(title or button), ctx.observe.TextBounds(title or button)
				Compose.watch(function(use: ComposeTypes.Use)
					local whole, bounds = use(fits), use(drawn)
					local smallest = ctx.metric("typography.caption.size", use)
					if not whole and bounds.X > 0 and target:peek() ~= nil and button.TextSize > smallest then
						drop:set(drop:peek() + 1)
					end
				end)
				button:SetAttribute("FacetTextFit", true)
			end
			local glyph = button:FindFirstChild("LeadingIcon", true) :: GuiObject?
			local rowContent = button:FindFirstChild("Content")
			local flow = rowContent and rowContent:FindFirstChildWhichIsA("UIListLayout")
			local title = rowContent and rowContent:FindFirstChild("Title") :: TextLabel?
			if glyph and flow and title then
				local restGap = flow.Padding
				runtime.decorate(flow, {
					FillDirection = function(use)
						return if stacked(use) then E.FillDirection.Vertical else E.FillDirection.Horizontal
					end,
					Padding = function(use)
						return if stacked(use) then D.new(0, iconGap(use)) else restGap
					end,
				})
				runtime.decorate(title, {
					Size = function(use: ComposeTypes.Use)
						if stacked(use) then
							return D2.new(1, 0, 0, labelLine(use))
						end
						if string.find(use(placement), "bottom") then
							return D2.new(
								1,
								-ctx.controlSize(spec.controlSize, "iconSize", use)
									- (flow:GetStyled("Padding") :: UDim).Offset,
								0,
								labelLine(use)
							)
						end
						return D2.fromOffset(0, 0)
					end,
					AutomaticSize = function(use: ComposeTypes.Use)
						return if string.find(use(placement), "bottom")
							then E.AutomaticSize.None
							else E.AutomaticSize.XY
					end,
					TextXAlignment = E.TextXAlignment.Center,
					TextWrapped = false,
					TextTruncate = E.TextTruncate.AtEnd,
				})
			end
			local function badgeOf(use: ComposeTypes.Use): string?
				local badge = read(use(current).badge, use)
				return if badge == nil or badge == "" then nil else tostring(badge)
			end
			if tab.badge ~= nil and glyph then
				local icon = glyph :: GuiObject
				local corner = UI.badged(
					Host.Frame({ Name = "Anchor", BackgroundTransparency = 1, Size = D2.fromScale(1, 1) }),
					badgeOf
				)
				local sealSize = Compose.cell(V2.zero)
				local iconBox, iconSize = ctx.observe.AbsoluteSize(icon), ctx.observe.Size(icon)
				local function reach(use: ComposeTypes.Use): (number, number, number)
					local seal, box = use(sealSize), use(iconBox).X
					local side = (use(iconSize) :: UDim2).X.Offset
					local ratio = if side > 0 and box > 0 then side / box else 1
					local lift = side * CORNER_OVERLAP
					return math.round(math.max(0, seal.X * ratio / 2 - lift)),
						math.round(math.max(0, seal.Y * ratio / 2 - lift)),
						ratio
				end
				runtime.decorate(corner, {
					Size = function(use: ComposeTypes.Use): UDim2
						local across, up = reach(use)
						return D2.new(1, across, 1, up)
					end,
					Position = function(use: ComposeTypes.Use): UDim2
						local across, up = reach(use)
						local anchor = read(use(current).badgeAnchor, use) or "topTrailing"
						assert(
							table.find({ "topLeading", "topTrailing", "bottomLeading", "bottomTrailing" }, anchor),
							"Invalid TabView tab.badgeAnchor"
						)
						return D2.fromOffset(
							if string.find(anchor, "Leading") then -across else 0,
							if string.find(anchor, "bottom") then 0 else -up
						)
					end,
					AutomaticSize = E.AutomaticSize.None,
				})
				runtime.mount(function()
					return corner
				end, icon)
				local holder = corner:FindFirstChild("Corner")
				if holder then
					runtime.decorate(holder, {
						Position = function(use: ComposeTypes.Use): UDim2
							local anchor = read(use(current).badgeAnchor, use) or "topTrailing"
							return D2.fromScale(
								if string.find(anchor, "Leading") then 0 else 1,
								if string.find(anchor, "bottom") then 1 else 0
							)
						end,
					})
					local tracked: RBXScriptConnection?
					local function track()
						if tracked then
							tracked:Disconnect()
						end
						local seal = holder:FindFirstChildWhichIsA("GuiObject")
						local function measure()
							sealSize:set(if seal and seal.Parent == holder then seal.AbsoluteSize else V2.zero)
						end
						tracked = if seal then seal:GetPropertyChangedSignal("AbsoluteSize"):Connect(measure) else nil
						measure()
					end
					local added, removed = holder.ChildAdded:Connect(track), holder.ChildRemoved:Connect(track)
					track()
					Compose.cleanup(function()
						added:Disconnect()
						removed:Disconnect()
						if tracked then
							tracked:Disconnect()
						end
					end)
				end
				local flow = icon.Parent and icon.Parent:FindFirstChildWhichIsA("UIListLayout")
				Compose.watch(function(use: ComposeTypes.Use)
					local anchor = read(use(current).badgeAnchor, use) or "topTrailing"
					local _, up, ratio = reach(use)
					local clearance = if string.find(anchor, "bottom")
						then up + use(sealSize).Y * ratio / 2 + ctx.metric("space.xs", use)
						else 0
					local values = badgeClearances:peek()
					if values[tab.id] ~= clearance then
						local nextValues = table.clone(values)
						nextValues[tab.id] = clearance
						badgeClearances:set(nextValues)
					end
				end)
				Compose.cleanup(function()
					local values = table.clone(badgeClearances:peek())
					values[tab.id] = nil
					badgeClearances:set(values)
				end)
				if flow then
					local gap = flow.Padding.Offset
					runtime.decorate(flow, {
						Padding = function(use: ComposeTypes.Use): UDim
							if stacked(use) then
								return D.new(0, iconGap(use))
							end
							local width = use(sealSize).X
							if width <= 0 or read(spec.iconOnly, use) then
								return D.new(0, gap)
							end
							local across, _, ratio = reach(use)
							local overhang = math.ceil(across + width * ratio / 2)
							return D.new(0, math.max(gap, overhang + ctx.metric("space.xs", use)))
						end,
					})
				end
			end
			local row = button:FindFirstChild("Content")
			if tab.badge ~= nil and not glyph and row then
				runtime.mountFragment(function()
					return {
						Compose.show(function(use: ComposeTypes.Use): boolean
							return badgeOf(use) ~= nil
						end, function()
							return UI.Badge({
								Name = "Count",
								LayoutOrder = 900,
								label = function(use: ComposeTypes.Use): string
									return badgeOf(use) or ""
								end,
							})
						end),
					}
				end, row)
			end
			local indicator = tab.indicator
			if indicator then
				surfaces.attach(button, {
					UI.StatusIndicator({
						Name = "Status",
						status = indicator.status,
						form = indicator.form,
						count = indicator.count,
						max = indicator.max,
						AnchorPoint = V2.new(1, 0),
						Position = D2.new(1, -4, 0, 4),
						ZIndex = 3,
					}) :: Types.Child,
				})
			end
			Compose.watch(function(use: ComposeTypes.Use)
				local current = use(spec.selection) == tab.id
				local place = use(placement)
				local filled = current
					and indicatorOf(use) ~= "none"
					and indicatorOf(use) ~= "mark"
					and (
						place == "sidebar"
						or string.find(place, "bottom") ~= nil
						or (spec.style == "sidebarAdaptable" and metrics.segmentedTop(use))
					)
				local tags: { [string]: boolean } = { ["facet-tab-current"] = current, ["facet-tab-filled"] = filled }
				for name, active in tags do
					if active then
						button:AddTag(name)
					elseif button:HasTag(name) then
						button:RemoveTag(name)
					end
				end
			end)
			surfaces.attach(button, {
				Host.UISizeConstraint({
					MinSize = function(use: ComposeTypes.Use)
						return V2.new(band(use), tabHeight(use))
					end,
				}),
				Compose.show(function(use: ComposeTypes.Use): boolean
					return use(spec.selection) == tab.id
						and indicatorOf(use) == "mark"
						and (use(placement) == "sidebar" or string.find(use(placement), "bottom") ~= nil)
				end, function(): Instance
					local insetSelection = Compose.formula(function(use: ComposeTypes.Use): boolean
						local choice = read(spec.indicatorPlacement, use)
						assert(
							choice == nil or choice == "aboveIcon" or choice == "belowIcon" or choice == "inset",
							"Invalid TabView.indicatorPlacement"
						)
						return use(placement) == "sidebar" or choice == "inset" or glyph == nil
					end)
					local function buildMark(): Frame
						return ctx.styled(
							Host.Frame "SelectionIndicator" {
								BorderSizePixel = 0,
								ZIndex = button.ZIndex,
								AnchorPoint = function(use: ComposeTypes.Use): Vector2
									return if use(insetSelection)
										then V2.zero
										else V2.new(
											0.5,
											if read(spec.indicatorPlacement, use) == "belowIcon" then 0 else 1
										)
								end,
								Size = function(use: ComposeTypes.Use): UDim2
									return if use(insetSelection)
										then D2.new(
											1,
											-2 * ctx.metric("controls.tabRailSelection.insetX", use),
											1,
											-2 * ctx.metric("controls.tabRailSelection.insetY", use)
										)
										else D2.fromOffset(
											ctx.metric("controls.tabMark.width", use),
											ctx.metric("controls.tabMark.height", use)
										)
								end,
								Position = function(use: ComposeTypes.Use): UDim2
									return if use(insetSelection)
										then D2.fromOffset(
											ctx.metric("controls.tabRailSelection.insetX", use),
											ctx.metric("controls.tabRailSelection.insetY", use)
										)
										else if read(spec.indicatorPlacement, use) == "belowIcon"
											then D2.new(0.5, 0, 1, ctx.metric("controls.tabMark.gap", use))
											else D2.new(0.5, 0, 0, -ctx.metric("controls.tabMark.gap", use))
								end,
								Host.UICorner {
									CornerRadius = function(use: ComposeTypes.Use): UDim
										return D.new(
											0,
											ctx.metric(
												if use(insetSelection)
													then "controls.tabRailSelection.radius"
													else "controls.tabMark.radius",
												use
											)
										)
									end,
								},
							},
							"selection-indicator"
						)
					end
					return Host.Folder {
						Compose.keyed {
							from = function(use: ComposeTypes.Use): { GuiObject }
								return { if use(insetSelection) then button else assert(glyph) }
							end,
							render = function(target: ComposeTypes.Readable<GuiObject>): Instance
								return Host.Folder {
									Compose.portal(target:peek(), function()
										return { buildMark() }
									end),
								}
							end,
						},
					}
				end),
				Compose.show(function(use: ComposeTypes.Use)
					return use(spec.selection) == tab.id
						and indicatorOf(use) ~= "none"
						and indicatorOf(use) ~= "pill"
						and use(placement) == "topBar"
				end, function()
					return ctx.styled(
						Host.Frame "SelectionIndicator" {
							Size = D2.new(1, 0, 0, 2),
							Position = D2.new(0, 0, 1, -2),
							BorderSizePixel = 0,
						},
						"selection-indicator"
					)
				end),
			})
			Compose.watch(function(use: ComposeTypes.Use)
				button:SetAttribute("FacetLabel", read(use(current).label, use) or tab.id)
			end)
			tabButtons[tab.id] = button
			tabMeasures[tab.id] = {
				position = ctx.observe.AbsolutePosition(button),
				size = ctx.observe.AbsoluteSize(button),
			}
			tabLinks:set(tabLinks:peek() + 1)
			Compose.cleanup(function()
				tabButtons[tab.id], tabMeasures[tab.id] = nil, nil
				tabLinks:set(tabLinks:peek() + 1)
			end)
			if next(sectionLabels) then
				return ctx.column({
					Compose.show(function(use: ComposeTypes.Use)
						local at = use(index)
						local tabs = use(visibleTabs)
						return use(placement) == "sidebar"
							and use(current).section ~= nil
							and (at == 1 or tabs[at - 1].section ~= use(current).section)
					end, function()
						return ctx.text({
							Name = "Section",
							Text = function(use: ComposeTypes.Use)
								return sectionLabels[assert(use(current).section)]
							end,
							Size = D2.new(1, 0, 0, 28),
							AutomaticSize = E.AutomaticSize.None,
						})
					end),
					button,
				}, {
					Name = "TabRow-" .. tab.id,
					LayoutOrder = index,
					Size = function(use: ComposeTypes.Use)
						return if use(placement) == "sidebar" then D2.new(1, 0, 0, 0) else D2.fromOffset(0, band(use))
					end,
					AutomaticSize = function(use: ComposeTypes.Use)
						return if use(placement) == "sidebar" then E.AutomaticSize.Y else E.AutomaticSize.X
					end,
				})
			end
			return button
		end,
	})
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="185">
            <Properties>
              <string name="Name">nav_tab_metrics</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local segmentMetrics = require("./segment_metrics")
local NavigationProps = require("./navigation_props")

export type TabFrame = {
	fit: boolean,
	placement: ComposeTypes.Formula<string>,
	visibleTabs: ComposeTypes.Formula<{ Nav.Tab }>,
	dimensions: ComposeTypes.Readable<Vector2>,
	layoutUnit: ComposeTypes.Readable<number>,
	headHeight: ComposeTypes.Cell<number>,
	footHeight: ComposeTypes.Cell<number>,
	trailingWidth: ComposeTypes.Cell<number>,
	indicatorOf: (ComposeTypes.Use) -> Nav.TabSelectionIndicator?,
}

export type TabMetrics = {
	wordWidths: ComposeTypes.Cell<{ [string]: number }>,
	barExtent: ComposeTypes.Cell<Vector2>,
	stacked: (ComposeTypes.Use?) -> boolean,
	crowded: ComposeTypes.Formula<boolean>,
	labelLine: (ComposeTypes.Use?) -> number,
	floating: (ComposeTypes.Use?) -> boolean,
	bottomInset: (ComposeTypes.Use?) -> number,
	contentGap: (ComposeTypes.Use) -> number,
	badgeClearances: ComposeTypes.Cell<{ [string]: number }>,
	iconGap: (ComposeTypes.Use?) -> number,
	band: (ComposeTypes.Use?) -> number,
	tabHeight: (ComposeTypes.Use?) -> number,
	segmentedTop: (ComposeTypes.Use) -> boolean,
	plated: (ComposeTypes.Use) -> boolean,
	inset: (ComposeTypes.Use) -> UDim,
	stripOverflows: ComposeTypes.Cell<boolean>,
	stripLayout: UIListLayout,
	stripContent: ComposeTypes.Cell<Vector2>,
	railWidth: (ComposeTypes.Use) -> number,
	floatingSize: (ComposeTypes.Use) -> UDim2,
	floatingPosition: (ComposeTypes.Use) -> UDim2,
}

return function(ctx: Types.Context, spec: NavigationProps.TabViewSpec, view: TabFrame): TabMetrics
	local Host, Compose, read = ctx.Host, ctx.Compose, ctx.read
	local E, D2, V2, D = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2, ctx.types.UDim
	local fit, placement, visibleTabs = view.fit, view.placement, view.visibleTabs
	local dimensions, layoutUnit, indicatorOf = view.dimensions, view.layoutUnit, view.indicatorOf
	local headHeight, footHeight, trailingWidth = view.headHeight, view.footHeight, view.trailingWidth
	local wordWidths: ComposeTypes.Cell<{ [string]: number }> = Compose.cell({})
	local barExtent: ComposeTypes.Cell<Vector2> = Compose.cell(V2.zero)
	local function stacked(use: ComposeTypes.Use?): boolean
		local choice = read(spec.labelPlacement, use)
		return not read(spec.iconOnly, use)
			and string.find(read(placement, use), "bottom") ~= nil
			and choice == "belowIcon"
	end
	local crowded = Compose.formula(function(use: ComposeTypes.Use): boolean
		if not fit or string.find(use(placement), "bottom") == nil then
			return false
		end
		local extent = use(barExtent).X
		if extent <= 0 then
			return false
		end
		local count = math.max(1, #use(visibleTabs))
		local available = extent / count - 4 - 2 * ctx.controlSize(nil, "paddingX", use)
		local scale = ctx.metric("typography.caption.size", use) / ctx.metric("typography.control.size", use)
		for _, width in use(wordWidths) do
			if width * scale > available + 0.5 then
				return true
			end
		end
		return false
	end)
	local function labelLine(use: ComposeTypes.Use?): number
		local authored = if fit then nil else read(spec.textSize, use)
		local size = if type(authored) == "number" then authored else ctx.metric("typography.control.size", use)
		return math.ceil(size * ctx.metric("typography.control.lineHeight", use))
	end
	local function floating(use: ComposeTypes.Use?): boolean
		local choice = read(spec.track, use)
		assert(choice == nil or choice == "automatic" or choice == "floating", "Invalid TabView.track")
		local place = read(placement, use)
		return choice == "floating" and (place == "sidebar" or string.find(place, "bottom") ~= nil)
	end
	local function bottomInset(use: ComposeTypes.Use?): number
		return if floating(use) and read(placement, use) ~= "sidebar"
			then ctx.metric("controls.tabBottomTrack.bottomInset", use)
			else 0
	end
	local function contentGap(use: ComposeTypes.Use): number
		return if floating(use) then ctx.metric("controls.tabBottomTrack.contentGap", use) else 8
	end
	local badgeClearances = Compose.cell({} :: { [string]: number })
	local function iconGap(use: ComposeTypes.Use?): number
		local gap = ctx.metric("space.xs", use)
		if read(spec.indicator, use) == "mark" and read(spec.indicatorPlacement, use) == "belowIcon" then
			gap =
				math.max(gap, ctx.metric("controls.tabMark.height", use) + 2 * ctx.metric("controls.tabMark.gap", use))
		end
		local clearances: { [string]: number } = if use then use(badgeClearances) else badgeClearances:peek()
		for _, clearance in clearances do
			gap = math.max(gap, clearance)
		end
		return gap
	end
	local function band(use: ComposeTypes.Use?): number
		local minimum = ctx.metric("targetSizes.minimum", use)
		if floating(use) and read(placement, use) ~= "sidebar" then
			minimum = math.max(minimum, ctx.metric("controls.tabBottomTrack.height", use))
		end
		return if stacked(use)
			then math.max(
				minimum,
				ctx.controlSize(spec.controlSize, "iconSize", use)
					+ labelLine(use)
					+ iconGap(use)
					+ math.max(
						0,
						ctx.controlSize(spec.controlSize, "height", use)
							- ctx.controlSize(spec.controlSize, "iconSize", use),
						if read(spec.indicator, use) == "mark"
							then 2 * (ctx.metric("controls.tabMark.height", use) + ctx.metric(
								"controls.tabMark.gap",
								use
							))
							else 0
					)
			)
			else minimum
	end
	local function tabHeight(use: ComposeTypes.Use?): number
		return if spec.controlSize == nil
				or stacked(use)
				or (floating(use) and read(placement, use) ~= "sidebar")
			then band(use)
			else ctx.controlSize(spec.controlSize, "height", use)
	end
	local INSET = segmentMetrics.inset
	local function segmentedTop(use: ComposeTypes.Use): boolean
		return use(placement) == "topBar" and indicatorOf(use) == "pill"
	end
	local function plated(use: ComposeTypes.Use): boolean
		return indicatorOf(use) == "pill" and (use(placement) == "topBar" or use(placement) == "sidebar")
	end
	local function inset(use: ComposeTypes.Use): UDim
		return D.new(0, if plated(use) then INSET else 0)
	end
	local stripOverflows = Compose.cell(false)
	local stripLayout = Host.UIListLayout({
		FillDirection = function(use: ComposeTypes.Use)
			return if use(placement) == "sidebar" then E.FillDirection.Vertical else E.FillDirection.Horizontal
		end,
		SortOrder = E.SortOrder.LayoutOrder,
		HorizontalAlignment = E.HorizontalAlignment.Center,
		VerticalAlignment = function(use: ComposeTypes.Use)
			return if use(placement) == "sidebar" then E.VerticalAlignment.Top else E.VerticalAlignment.Center
		end,
		Padding = D.new(0, 4),
	})
	local stripContent = ctx.observe.AbsoluteContentSize(stripLayout)
	local function railWidth(use: ComposeTypes.Use): number
		local authored = read(spec.railWidth, use)
		if authored then
			return authored
		end
		local widest = 0
		for _, width in use(wordWidths) do
			widest = math.max(widest, width)
		end
		if widest <= 0 then
			return math.clamp(math.floor(use(dimensions).X * 0.2), 200, 280)
		end
		local unit = use(layoutUnit)
		local glyph = 0
		for _, tab in use(visibleTabs) do
			if tab.icon then
				glyph = ctx.controlSize(spec.controlSize, "iconSize", use) + ctx.metric("space.xs", use)
				break
			end
		end
		local label = widest / (if unit > 0 then unit else 1)
		local plate = if indicatorOf(use) == "pill" then 2 * INSET else 0
		local package = read(ctx.config.theme, use)
		local skin = package and package.chrome and package.chrome.control
		local insets = if skin then skin.contentInsets else nil
		local carve = if insets then (insets.left or 0) + (insets.right or 0) else 0
		return math.ceil(label + glyph + 2 * ctx.controlSize(spec.controlSize, "paddingX", use) + carve) + 16 + plate
	end
	local function floatingSize(use: ComposeTypes.Use): UDim2
		return if use(placement) == "sidebar"
			then D2.new(
				0,
				railWidth(use) - 2 * ctx.metric("controls.tabRailTrack.sideInset", use),
				1,
				-use(headHeight)
					- use(footHeight)
					- ctx.metric("controls.tabRailTrack.topInset", use)
					- ctx.metric("controls.tabRailTrack.bottomInset", use)
			)
			else D2.new(
				1,
				-2 * ctx.metric("controls.tabBottomTrack.sideInset", use) - use(trailingWidth),
				0,
				band(use)
			)
	end
	local function floatingPosition(use: ComposeTypes.Use): UDim2
		return if use(placement) == "sidebar"
			then D2.fromOffset(
				ctx.metric("controls.tabRailTrack.sideInset", use),
				use(headHeight) + ctx.metric("controls.tabRailTrack.topInset", use)
			)
			else D2.new(0, ctx.metric("controls.tabBottomTrack.sideInset", use), 1, -band(use) - bottomInset(use))
	end
	return {
		wordWidths = wordWidths,
		barExtent = barExtent,
		stacked = stacked,
		crowded = crowded,
		labelLine = labelLine,
		floating = floating,
		bottomInset = bottomInset,
		contentGap = contentGap,
		badgeClearances = badgeClearances,
		iconGap = iconGap,
		band = band,
		tabHeight = tabHeight,
		segmentedTop = segmentedTop,
		plated = plated,
		inset = inset,
		stripOverflows = stripOverflows,
		stripLayout = stripLayout,
		stripContent = stripContent,
		railWidth = railWidth,
		floatingSize = floatingSize,
		floatingPosition = floatingPosition,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="186">
            <Properties>
              <string name="Name">nav_tab_view</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local Content = require("./content_types")
local ComposeTypes = require("../vendor/compose/core")
local motion = require("./motion")
local adaptive = require("./adaptive")
local segmentMetrics = require("./segment_metrics")
local reservations = require("./reservations")
local ControlTypes = require("./control_types")
local NavigationProps = require("./navigation_props")
local pageLayers = require("./nav_page_layers")
local tabMetrics = require("./nav_tab_metrics")
local tabItem = require("./nav_tab_item")
local tabAccessories = require("./nav_tab_accessories")
type SelectionLinks = {
	NextSelectionLeft: GuiObject?,
	NextSelectionRight: GuiObject?,
	NextSelectionUp: GuiObject?,
	NextSelectionDown: GuiObject?,
}

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	surfaces: Nav.Surfaces,
	layers: pageLayers.PageLayers
): ()
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2, V2, D = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2, ctx.types.UDim
	local content, layer, checkedSelection = layers.content, layers.layer, layers.checkedSelection
	local tabDepth = 0
	UI.TabView = ctx.construct("TabView", function(spec: NavigationProps.TabViewSpec): Frame
		local retention = spec.retention
		assert(
			retention == nil or retention == "all" or retention == "top",
			"TabView.retention uses Compose all or top"
		)
		local depth = tabDepth
		local tabLevel = motion.level(ctx)
		local nested = Compose.cell(depth > 0)
		local statuses: { [string]: boolean } = {
			neutral = true,
			info = true,
			success = true,
			warning = true,
			error = true,
			accent = true,
			voice = true,
			contrast = true,
		}
		local forms: { [string]: boolean } = { dot = true, ring = true, square = true, dash = true }
		for _, tab in read(spec.tabs) do
			local indicator = tab.indicator
			if indicator ~= nil then
				assert(
					type(indicator) == "table",
					"Facet UI.TabView: tab.indicator must be a StatusIndicator spec table { form?, status?, count?, max? }"
				)
				assert(
					indicator.status == nil or statuses[indicator.status],
					"Facet UI.TabView: tab.indicator.status must be neutral, info, success, warning, error or accent"
				)
				assert(
					indicator.form == nil or forms[indicator.form],
					"Facet UI.TabView: tab.indicator.form must be dot, ring, square or dash"
				)
			end
		end
		local fit = spec.textSize == nil or spec.textSize == "fit"
		assert(
			spec.labelPlacement == nil or table.find({ "besideIcon", "belowIcon" }, read(spec.labelPlacement)),
			"Invalid TabView.labelPlacement"
		)
		assert(
			spec.style == nil or table.find({ "automatic", "sidebarAdaptable", "collapsible" }, spec.style),
			"Invalid TabView.style"
		)
		local sectionLabels: { [string]: string } = {}
		for _, section in (spec.sections or {} :: { { id: string, label: string } }) do
			assert(
				type(section.id) == "string" and type(section.label) == "string" and sectionLabels[section.id] == nil,
				"TabView sections require unique ids and labels"
			)
			sectionLabels[section.id] = section.label
		end
		local byId = checkedSelection(spec.selection, read(spec.tabs), "TabView")
		local tabMap = Compose.formula(function(use: ComposeTypes.Use)
			local result: { [string]: Nav.Tab } = {}
			for _, tab in read(spec.tabs, use) do
				assert(type(tab.id) == "string" and result[tab.id] == nil, "TabView tabs require unique string ids")
				assert(
					tab.section == nil or sectionLabels[tab.section] ~= nil,
					"TabView tab.section must name a declared section"
				)
				result[tab.id] = tab
			end
			return result
		end)
		local root = Host.Frame(ctx.props(spec, {
			"selection",
			"tabs",
			"sections",
			"customization",
			"accessories",
			"railWidth",
			"transition",
			"retention",
			"placement",
			"style",
			"sidebarPreference",
			"sidebarExpanded",
			"restoreScroll",
			"shoulderNavigation",
			"restoreFocus",
			"indicator",
			"track",
			"indicatorPlacement",
			"iconOnly",
			"textSize",
			"labelPlacement",
			"enabled",
			"onChange",
			"controlSize",
		}, { Name = "TabView", BackgroundTransparency = 1, Size = D2.fromScale(1, 1) }))
		local layoutUnit = ctx.layoutUnit(root)
		local dimensions = ctx.layoutSize(root, layoutUnit)
		local function locate()
			local at: Instance? = root.Parent
			local inside = depth > 0
			while at and not inside do
				inside = at:GetAttribute("FacetTabPage") == true
				at = at.Parent
			end
			if nested:peek() ~= inside then
				nested:set(inside)
			end
		end
		runtime.connect(root, "AncestryChanged", locate)
		locate()
		local input = surfaces.service("UserInputService")
		local primaryInput = if input
			then ctx.observe.PreferredInput(input) :: ComposeTypes.Readable<Enum.PreferredInput?>
			else Compose.cell(nil :: Enum.PreferredInput?)
		local tenFoot = ctx.tenFoot()
		local displaySize = if ctx.config.guiService
			then ctx.observe.ViewportDisplaySize(ctx.config.guiService)
			else nil
		local function resolvePlacement(use: ComposeTypes.Use): Nav.Placement
			if spec.style == "collapsible" then
				return "topBar"
			end
			local explicit = read(spec.placement, use)
			if explicit and explicit ~= "automatic" then
				return explicit
			end
			local distant = tenFoot(use)
			if spec.style == "sidebarAdaptable" and distant and read(spec.sidebarExpanded, use) == true then
				return "sidebar"
			end
			if use(nested) then
				return "topBar"
			end
			local size, preferred = use(dimensions), use(primaryInput)
			local display = if displaySize then use(displaySize) else nil
			local home: Nav.Placement = adaptive.navPlacement({
				sizeClass = adaptive.sizeClass(size.X),
				heightClass = adaptive.heightClass(size.Y),
				primary = if preferred == E.PreferredInput.Gamepad
					then "gamepad"
					elseif preferred == E.PreferredInput.Touch then "touch"
					else "pointer",
				displaySize = if typeof(display) == "EnumItem" then (display :: EnumItem).Name else nil,
				tenFoot = distant,
			})
			if spec.style == "sidebarAdaptable" and not distant and (home == "sidebar" or home == "topBar") then
				local choice = read(spec.sidebarPreference, use)
				if choice and choice ~= "automatic" then
					return choice
				end
			end
			return home
		end
		local placement = Compose.formula(resolvePlacement :: (ComposeTypes.Use) -> string)
		local function indicatorOf(use: ComposeTypes.Use): Nav.TabSelectionIndicator?
			local chosen = read(spec.indicator, use)
			if (chosen == nil or chosen == "automatic") and spec.style == "sidebarAdaptable" then
				return "pill"
			end
			return chosen
		end

		local COMPACT_HEIGHT = 480
		local collapsed = Compose.formula(function(use: ComposeTypes.Use): boolean
			if spec.style == "collapsible" then
				return true
			end
			if not use(nested) or (spec.style ~= nil and spec.style ~= "automatic") then
				return false
			end
			local explicit = read(spec.placement, use)
			if explicit and explicit ~= "automatic" then
				return false
			end
			local size = use(dimensions)
			return size.Y > 0 and size.Y < COMPACT_HEIGHT
		end)
		local headHeight, footHeight, trailingWidth, aboveHeight =
			Compose.cell(0), Compose.cell(0), Compose.cell(0), Compose.cell(0)
		local visibleTabs = Compose.formula(function(use: ComposeTypes.Use)
			local customized = read(spec.customization, use)
			local byId = use(tabMap)
			if not customized then
				return read(spec.tabs, use)
			end
			local ordered: { Nav.Tab } = {}
			local added: { [string]: boolean } = {}
			local hidden: { [string]: boolean } = {}
			for _, id in (customized.hidden or {} :: { string }) do
				hidden[id] = true
			end
			for _, id in (customized.order or {} :: { string }) do
				local tab = byId[id]
				if tab and not added[id] and (not hidden[id] or tab.required) then
					table.insert(ordered, tab)
					added[id] = true
				end
			end
			for _, tab in read(spec.tabs, use) do
				if not added[tab.id] and (not hidden[tab.id] or tab.required) then
					table.insert(ordered, tab)
				end
			end
			assert(#ordered > 0, "TabView customization must leave a visible tab")
			return ordered
		end)
		local visited = Compose.cell({} :: { string })
		local tabsReady = false
		local panels: { [string]: GuiObject } = {}
		local bookmarks: { [string]: GuiObject? } = {}
		local bookmarkPaths: { [string]: { string } } = {}
		local tabButtons: { [string]: TextButton } = {}
		local tabLinks = Compose.cell(0)
		local tabMeasures: { [string]: { position: ComposeTypes.Readable<Vector2>, size: ComposeTypes.Readable<Vector2> } } =
			{}
		local gui = surfaces.service("GuiService")
		local selectedObject = if gui then ctx.observe.SelectedObject(gui) else Compose.cell(nil :: GuiObject?)
		local previous: string?
		local handoff: string?
		Compose.watch(function(use: ComposeTypes.Use)
			local id = use(spec.selection)
			byId = use(tabMap)
			local allowed = false
			for _, tab in use(visibleTabs) do
				if tab.id == id then
					allowed = true
					break
				end
			end
			if not allowed then
				spec.selection:set(use(visibleTabs)[1].id)
				return
			end
			local retained = {}
			for _, old in visited:peek() do
				if byId[old] then
					table.insert(retained, old)
				end
			end
			if #retained ~= #visited:peek() then
				visited:set(retained)
			end
			if previous == id then
				return
			end
			local leaving = false
			local previousPanel = if previous then panels[previous] else nil
			if gui and previousPanel and surfaces.within(gui.SelectedObject, previousPanel) then
				leaving = true
				bookmarks[previous :: string] = gui.SelectedObject
			end
			local order = table.clone(visited:peek())
			local at = table.find(order, id)
			if at then
				table.remove(order, at)
			end
			table.insert(order, id)
			visited:set(order)
			local bookmark = bookmarks[id]
			handoff = if spec.restoreFocus ~= false
					and gui
					and (leaving or (bookmark and bookmark.Parent))
				then id
				else nil
			if spec.restoreScroll == false and panels[id] then
				local function reset(node: Instance): ()
					if node:IsA("ScrollingFrame") then
						node.CanvasPosition = V2.zero
					end
					for _, child in node:GetChildren() do
						reset(child)
					end
				end
				reset(panels[id])
			end
			previous = id
		end)
		local function tabEnabled(id: string, use: ComposeTypes.Use?): boolean
			local tab = read(tabMap, use)[id]
			return tab ~= nil and read(tab.enabled, use) ~= false
		end
		local function select(id: string): ()
			if read(spec.enabled) == false or id == spec.selection:peek() or not tabEnabled(id) then
				return
			end
			spec.selection:set(id)
			if spec.onChange then
				spec.onChange(id)
			end
		end
		local frame: tabMetrics.TabFrame = {
			fit = fit,
			placement = placement,
			visibleTabs = visibleTabs,
			dimensions = dimensions,
			layoutUnit = layoutUnit,
			headHeight = headHeight,
			footHeight = footHeight,
			trailingWidth = trailingWidth,
			indicatorOf = indicatorOf,
		}
		local metrics = tabMetrics(ctx, spec, frame)
		local floating, floatingSize, floatingPosition =
			metrics.floating, metrics.floatingSize, metrics.floatingPosition
		local segmentedTop, inset = metrics.segmentedTop, metrics.inset
		local band, railWidth, bottomInset = metrics.band, metrics.railWidth, metrics.bottomInset
		local barExtent, stripLayout, stripOverflows, stripContent =
			metrics.barExtent, metrics.stripLayout, metrics.stripOverflows, metrics.stripContent
		local INSET = segmentMetrics.inset
		local bar = Host.ScrollingFrame "Tabs" {
			ZIndex = 2,
			BackgroundTransparency = function(use: ComposeTypes.Use): number
				return if segmentedTop(use) then 0 else 1
			end,
			BorderSizePixel = 0,
			ScrollBarThickness = function(use: ComposeTypes.Use)
				return if use(placement) == "sidebar" then 2 else 0
			end,
			VerticalScrollBarInset = E.ScrollBarInset.ScrollBar,
			CanvasSize = D2.fromOffset(0, 0),
			AutomaticCanvasSize = function(use: ComposeTypes.Use)
				return if use(placement) == "sidebar" then E.AutomaticSize.Y else E.AutomaticSize.X
			end,
			ScrollingDirection = function(use: ComposeTypes.Use)
				return if use(placement) == "sidebar" then E.ScrollingDirection.Y else E.ScrollingDirection.X
			end,
			Size = function(use: ComposeTypes.Use)
				if segmentedTop(use) then
					return D2.fromOffset(0, band(use) + 2 * INSET)
				end
				return D2.fromScale(1, 1)
			end,
			AutomaticSize = function(use: ComposeTypes.Use): Enum.AutomaticSize
				return if segmentedTop(use) then E.AutomaticSize.X else E.AutomaticSize.None
			end,
			Host.UIFlexItem {
				FlexMode = function(use: ComposeTypes.Use): Enum.UIFlexMode
					return if segmentedTop(use) then E.UIFlexMode.Shrink else E.UIFlexMode.None
				end,
			},
			Host.UIPadding({
				PaddingLeft = inset,
				PaddingRight = inset,
				PaddingTop = inset,
				PaddingBottom = inset,
			}) :: Types.Child,
			Host.Frame "Strip" {
				BackgroundTransparency = 1,
				Size = function(use: ComposeTypes.Use): UDim2
					return D2.fromScale(1, if use(placement) == "sidebar" then 0 else 1)
				end,
				AutomaticSize = function(use: ComposeTypes.Use): Enum.AutomaticSize
					return if use(placement) == "sidebar" then E.AutomaticSize.Y else E.AutomaticSize.X
				end,
				stripLayout :: Types.Child,
				tabItem(ctx, UI, surfaces, spec, {
					frame = frame,
					select = select,
					sectionLabels = sectionLabels,
					tabButtons = tabButtons,
					tabMeasures = tabMeasures,
					tabLinks = tabLinks,
					metrics = metrics,
				}),
			},
		}
		local bandBox = Host.Frame "TabBand" {
			ZIndex = 2,
			BackgroundTransparency = 1,
			Size = function(use: ComposeTypes.Use): UDim2
				if floating(use) then
					return floatingSize(use)
				end
				if segmentedTop(use) then
					return D2.new(1, -use(trailingWidth), 0, band(use) + 2 * INSET)
				end
				return if use(placement) == "sidebar"
					then D2.new(0, railWidth(use) - 16, 1, -use(headHeight) - use(footHeight))
					else D2.new(1, -use(trailingWidth), 0, band(use))
			end,
			Position = function(use: ComposeTypes.Use): UDim2
				if floating(use) then
					return floatingPosition(use)
				end
				return if use(placement) == "sidebar"
					then D2.fromOffset(8, use(headHeight))
					elseif string.find(use(placement), "bottom") then D2.new(0, 0, 1, -band(use))
					else D2.fromOffset(0, 0)
			end,
			Host.UIListLayout {
				FillDirection = E.FillDirection.Horizontal,
				HorizontalAlignment = E.HorizontalAlignment.Center,
				VerticalAlignment = E.VerticalAlignment.Center,
			},
			bar,
		}
		Compose.watch(function(use: ComposeTypes.Use)
			bar:SetAttribute("FacetEntry", use(spec.selection))
			if segmentedTop(use) then
				root:AddTag("facet-top-tabs")
				bandBox:AddTag("facet-top-tabs")
				bar:AddTag("facet-tab-plate")
				bar:AddTag("facet-segmented")
			else
				root:RemoveTag("facet-top-tabs")
				bandBox:RemoveTag("facet-top-tabs")
				bar:RemoveTag("facet-tab-plate")
				bar:RemoveTag("facet-segmented")
			end
		end)
		local ancestry, barAt, barSize =
			Compose.cell(0), ctx.observe.AbsolutePosition(bar), ctx.observe.AbsoluteSize(bar)
		local reserved: Instance? = nil
		runtime.connect(bar, "AncestryChanged", function()
			ancestry:set(ancestry:peek() + 1)
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			use(ancestry)
			local layer = bar:FindFirstAncestorWhichIsA("LayerCollector")
			if reserved and reserved ~= layer then
				reservations.clear(reserved, bar)
			end
			reserved = layer
			if layer and layer:IsA("GuiBase2d") then
				local band = string.find(use(placement), "bottom") ~= nil and use(barSize).Y > 0
				local top = use(barAt).Y - (layer :: GuiBase2d).AbsolutePosition.Y - use(aboveHeight)
				reservations.set(
					layer,
					bar,
					"bottom",
					if band then top else nil,
					if band then use(barSize).Y + use(aboveHeight) + bottomInset(use) else nil
				)
			end
		end)
		Compose.cleanup(function()
			if reserved then
				reservations.clear(reserved, bar)
			end
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			use(tabLinks)
			local vertical = use(placement) == "sidebar"
			local order: { TextButton } = {}
			for _, tab in use(visibleTabs) do
				local button = tabButtons[tab.id]
				if button and button.Parent then
					local live = read(spec.enabled, use) ~= false and tabEnabled(tab.id, use)
					if live then
						table.insert(order, button)
					else
						local links = (button :: unknown) :: SelectionLinks
						links.NextSelectionLeft, links.NextSelectionRight = nil, nil
						links.NextSelectionUp, links.NextSelectionDown = nil, nil
					end
				end
			end
			for index, button in order do
				local before: GuiObject?, after: GuiObject? = order[index - 1], order[index + 1]
				local links = (button :: unknown) :: SelectionLinks
				links.NextSelectionLeft = if vertical then nil else before
				links.NextSelectionRight = if vertical then nil else after
				links.NextSelectionUp = if vertical then before else nil
				links.NextSelectionDown = if vertical then after else nil
			end
		end)
		local barSize, barPosition = ctx.observe.AbsoluteSize(bar), ctx.observe.AbsolutePosition(bar)
		Compose.watch(function(use: ComposeTypes.Use)
			barExtent:set(use(barSize))
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			local room = use(barSize).X
			stripOverflows:set(
				use(placement) ~= "sidebar" and room > 0 and use(stripContent).X > room - 2 * inset(use).Offset + 0.5
			)
		end)
		local revealed: string? = nil
		Compose.watch(function(use: ComposeTypes.Use)
			use(ancestry)
			use(tabLinks)
			local selected = use(spec.selection)
			local measure = tabMeasures[selected]
			local button = tabButtons[selected]
			if not measure or not button or not button.Parent then
				return
			end
			use(barSize)
			use(barPosition)
			use(measure.position)
			use(measure.size)
			local extent, origin, at, size =
				bar.AbsoluteSize, bar.AbsolutePosition, button.AbsolutePosition, button.AbsoluteSize
			local vertical = use(placement) == "sidebar"
			local start = if vertical then at.Y - origin.Y else at.X - origin.X
			local length = if vertical then size.Y else size.X
			local visible = if vertical then extent.Y else extent.X
			local key = `{selected}:{visible}:{length}:{use(stripContent).X}:{use(stripOverflows)}`
			if visible <= 0 or length <= 0 or revealed == key then
				return
			end
			revealed = key
			local delta = if start < 0 then start elseif start + length > visible then start + length - visible else 0
			if delta ~= 0 then
				bar.CanvasPosition = if vertical
					then V2.new(bar.CanvasPosition.X, math.max(0, bar.CanvasPosition.Y + delta))
					else V2.new(math.max(0, bar.CanvasPosition.X + delta), bar.CanvasPosition.Y)
			end
		end)
		local layers = Host.Frame "Content" {
			BackgroundTransparency = 1,

			ClipsDescendants = true,
			Position = function(use: ComposeTypes.Use)
				local place = use(placement)
				return if place == "sidebar"
					then D2.fromOffset(railWidth(use), 0)
					elseif place == "topBar" then D2.fromOffset(0, band(use) + 8)
					else D2.fromOffset(0, 0)
			end,
			Size = function(use: ComposeTypes.Use)
				local place = use(placement)
				return if place == "sidebar"
					then D2.new(1, -(railWidth(use)), 1, 0)
					elseif place == "none" then D2.fromScale(1, 1)
					else D2.new(
						1,
						0,
						1,
						-band(use) - metrics.contentGap(use) - use(aboveHeight) - bottomInset(use)
					)
			end,
			Compose.LayerStack({
				from = visited,
				retention = "all",
				render = function(
					current: ComposeTypes.Readable<string>,
					state: ComposeTypes.Readable<ComposeTypes.LayerStackState>,
					id: string
				): Instance
					local step = if spec.placement == "none" then 0 else 1
					tabDepth += step
					local ok, built = pcall(function(): Instance
						return content(byId[current:peek()].content, nil)
					end)
					tabDepth -= step
					if not ok then
						error(built, 0)
					end
					local panel = layer(
						{
							Name = id,
							BackgroundTransparency = 1,
							Size = D2.fromScale(1, 1),
							Visible = function(use: ComposeTypes.Use)
								return use(state).top
							end,
							SelectionGroup = true,
							Attributes = { FacetTabPage = spec.placement ~= "none" } :: Types.Attributes,
							built,
						},
						state,
						if spec.transition == nil
							then {
								seconds = function(): number
									return if tabLevel() == "limited"
										then ctx.metric("motion.reducedFade")
										else ctx.metric("motion.durations.tabFade")
								end,
								ease = ctx.motionEase("fade"),
							}
							else spec.transition,
						if spec.retention == "top"
							then function()
								if spec.selection:peek() == id then
									return
								end
								local retained = {}
								for _, key in visited:peek() do
									if key ~= id then
										table.insert(retained, key)
									end
								end
								visited:set(retained)
							end
							else nil,
						not tabsReady
					)
					panels[id] = panel
					local shown = ctx.observe.Visible(panel)
					local attached = Compose.cell(0)
					runtime.connect(panel, "AncestryChanged", function()
						attached:set(attached:peek() + 1)
					end)
					Compose.watch(function(use: ComposeTypes.Use)
						use(attached)
						if
							not use(shown)
							or not use(state).top
							or handoff ~= id
							or not gui
							or panel:FindFirstAncestorWhichIsA("LayerCollector") == nil
						then
							return
						end
						handoff = nil
						local bookmark = bookmarks[id]
						if not bookmark and bookmarkPaths[id] then
							local node: Instance? = panel
							for _, name in bookmarkPaths[id] do
								node = if node then node:FindFirstChild(name) else nil
							end
							bookmark = if node and node:IsA("GuiObject") then node else nil
						end
						bookmarkPaths[id] = nil
						local button = tabButtons[id]
						gui.SelectedObject = if bookmark
								and surfaces.within(bookmark, panel)
								and bookmark.Visible
								and bookmark.Interactable
							then bookmark
							else surfaces.firstSelectable(panel) or (if button
									and button.Parent
									and button.Visible
								then button
								else nil)
					end)
					Compose.cleanup(function()
						local bookmark = bookmarks[id]
						if bookmark and surfaces.within(bookmark, panel) then
							local names: { string } = {}
							local node: Instance? = bookmark
							while node and node ~= panel do
								table.insert(names, 1, node.Name)
								node = node.Parent
							end
							bookmarkPaths[id] = names
						end
						panels[id], bookmarks[id] = nil, nil
					end)
					return panel
				end,
			}),
		}
		tabsReady = true
		local track = Host.Frame "Track" {
			ZIndex = 1,
			BorderSizePixel = 0,
			Visible = function(use: ComposeTypes.Use)
				return (metrics.plated(use) or floating(use)) and not use(collapsed) and not segmentedTop(use)
			end,
			Size = function(use: ComposeTypes.Use)
				if floating(use) then
					return floatingSize(use)
				end
				if use(placement) == "sidebar" then
					return D2.new(0, railWidth(use) - 16, 1, -use(headHeight) - use(footHeight))
				end
				return D2.fromOffset(0, 0)
			end,
			Position = function(use: ComposeTypes.Use)
				if floating(use) then
					return floatingPosition(use)
				end
				if use(placement) == "sidebar" then
					return D2.fromOffset(8, use(headHeight))
				end
				return D2.fromOffset(0, 0)
			end,
		}
		if not floating() then
			track:AddTag("facet-segmented")
		end
		track:AddTag("facet-tab-plate")
		surfaces.attach(track, {
			Compose.show(floating, function(): Instance
				return Host.UICorner {
					CornerRadius = function(use: ComposeTypes.Use): UDim
						return D.new(
							0,
							ctx.metric(
								if use(placement) == "sidebar"
									then "controls.tabRailTrack.radius"
									else "controls.tabBottomTrack.radius",
								use
							)
						)
					end,
				}
			end),
		})
		Compose.watch(function(use: ComposeTypes.Use)
			if floating(use) then
				track:RemoveTag("facet-segmented")
			else
				track:AddTag("facet-segmented")
			end
		end)
		surfaces.attach(root, { track, bandBox, layers })
		local canvas, window = ctx.observe.AbsoluteCanvasSize(bar), ctx.observe.AbsoluteWindowSize(bar)
		runtime.decorate(bar, {
			Visible = function(use: ComposeTypes.Use)
				return not use(collapsed) and use(placement) ~= "none"
			end,
			ClipsDescendants = function(use: ComposeTypes.Use): boolean
				local content, room = use(canvas), use(window)
				return content.X > room.X + 0.5 or content.Y > room.Y + 0.5
			end,
		})
		surfaces.attach(root, {
			Compose.show(collapsed, function()
				return UI.Menu "TabsMenu" {
					Size = function(use: ComposeTypes.Use)
						return D2.fromOffset(0, band(use))
					end,
					AutomaticSize = E.AutomaticSize.X,
					disclosure = true,
					label = function(use: ComposeTypes.Use)
						local tab = use(tabMap)[use(spec.selection)]
						return read(tab.label, use) or tab.id
					end,
					items = function(use: ComposeTypes.Use)
						local items: { Nav.MenuItem<string> } = {}
						for _, tab in use(visibleTabs) do
							table.insert(items, {
								id = tab.id,
								label = tab.label or tab.id,
								icon = tab.icon,
								enabled = tab.enabled,
								marked = function(use: ComposeTypes.Use)
									return use(spec.selection) == tab.id
								end,
								onSelect = function()
									select(tab.id)
								end,
							})
						end
						return items
					end,
				}
			end),
		})
		tabAccessories(ctx, surfaces, spec, root, {
			frame = frame,
			aboveHeight = aboveHeight,
			metrics = metrics,
		})
		local function advance(direction: number): ()
			local list = visibleTabs:peek()
			local at = 1
			for index, tab in list do
				if tab.id == spec.selection:peek() then
					at = index
					break
				end
			end
			local nextIndex = at
			for _ = 1, #list do
				local candidate = if spec.shoulderNavigation == "content"
					then math.clamp(nextIndex + direction, 1, #list)
					else (nextIndex - 1 + direction) % #list + 1
				if candidate == nextIndex then
					break
				end
				nextIndex = candidate
				if tabEnabled(list[nextIndex].id) then
					break
				end
			end
			select(list[nextIndex].id)
		end
		if ctx.action then
			local active = function(use: ComposeTypes.Use)
				return read(spec.enabled, use) ~= false
					and gui ~= nil
					and surfaces.within(use(selectedObject), if spec.shoulderNavigation == "content" then root else bar)
			end
			ctx.action(root, "PreviousTab", { "ButtonL1" }, active, function()
				advance(-1)
			end, { priority = 50 + depth })
			ctx.action(root, "NextTab", { "ButtonR1" }, active, function()
				advance(1)
			end, { priority = 50 + depth })
			local expanded = spec.sidebarExpanded
			if expanded ~= nil then
				assert(
					type(expanded) == "table" and expanded.set ~= nil,
					"Facet UI.TabView: sidebarExpanded must be a writable Compose cell"
				)
				ctx.action(root, "SidebarCollapse", { "ButtonB" }, function(use: ComposeTypes.Use)
					return use(expanded) == true
						and tenFoot(use)
						and gui ~= nil
						and surfaces.within(use(selectedObject), bar)
				end, function()
					expanded:set(false)
				end, { priority = 1100 + depth })
			end
			local function inChrome(node: GuiObject?): boolean
				local content = root:FindFirstChild("Content")
				return node ~= nil
					and surfaces.within(node, root)
					and not (content and surfaces.within(node, content))
					and not surfaces.within(node, bar)
			end
			local accessory: GuiObject? = nil
			Compose.watch(function(use: ComposeTypes.Use)
				local current = use(selectedObject) :: GuiObject?
				accessory = if inChrome(current) then current else nil
			end)
			local first = true
			Compose.watch(function(use: ComposeTypes.Use)
				use(placement)
				if first then
					first = false
					return
				end
				local button = tabButtons[spec.selection:peek()]
				local current = gui and gui.SelectedObject
				if gui and button and (accessory ~= nil or inChrome(current)) and current ~= button then
					accessory = nil
					gui.SelectedObject = button
				end
			end)
		end
		return root
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="187">
            <Properties>
              <string name="Name">nav_toast</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local Overlay = require("./overlay_types")
local ComposeTypes = require("../vendor/compose/core")
local parts = require("./overlay_parts")
local toastSchedule = require("./toast_schedule")
local motion = require("./motion")
local reducedMotion = motion.reduced
local reservations = require("./reservations")
local OverlayProps = require("./overlay_props")
local arrival = require("./overlay_arrival")
local textMeasure = require("./text_measure")

type Reason = Overlay.ToastDismissReason
type Record = {
	spec: OverlayProps.ToastSpec,
	state: ComposeTypes.Cell<string>,
	stack: Stack?,
	id: number?,
	pending: Reason?,
	torn: boolean,
	hovered: boolean,
	row: GuiObject?,
}
type Stack = {
	schedule: toastSchedule.Schedule,
	order: ComposeTypes.Cell<{ Record }>,
	inset: ComposeTypes.Cell<number>,
	time: number,
	stop: (() -> ())?,
	lane: string,
	layer: GuiBase2d,
	container: Frame?,
	owner: ComposeTypes.Owner?,
	users: number,
}

local KEYS = {
	"message",
	"content",
	"icon",
	"action",
	"closeButton",
	"isPresented",
	"onPresentedChange",
	"key",
	"priority",
	"duration",
	"readFloor",
	"position",
	"width",
	"fade",
	"onDismiss",
}
local PASSIVE_ONLY = { "content", "position", "width", "fade" }
local MARGIN, GAP, HUG_MAX, ROW_Z, ACTION_Z = 8, 8, 560, 70, 60

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces): ()
	local Compose, Host, runtime, read = ctx.Compose, ctx.Host, ctx.runtime, ctx.read
	local E, D2, V2, UD = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2, ctx.types.UDim
	local frames = runtime.host.frames
	local gui = surfaces.service("GuiService")
	local stacks = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [Instance]: { [string]: Stack } }
	local actionRows = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [GuiObject]: boolean }
	local actionTokens = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [unknown]: boolean }
	local returnTo: GuiObject? = nil

	local function wanted(record: Record): boolean
		return not record.torn and (record.spec.isPresented == nil or read(record.spec.isPresented) == true)
	end

	local function retire(record: Record, reason: Reason)
		record.id = nil
		record.state:set("idle")
		local row, spec = record.row, record.spec
		if gui and row and surfaces.within(gui.SelectedObject, row) then
			gui.SelectedObject = if returnTo and returnTo.Parent then returnTo else nil
		end
		local change = spec.onPresentedChange
		if spec.isPresented ~= nil and change and not record.torn and wanted(record) then
			parts.call(change, nil, false)
		end
		record.pending = nil
		if spec.onDismiss then
			spec.onDismiss(reason)
		end
	end

	local function offer(record: Record, reason: Reason, fn: () -> ())
		record.pending = reason
		parts.call(fn, function()
			if record.id ~= nil and wanted(record) then
				record.pending = nil
			end
		end)
	end

	local function dismiss(record: Record, reason: Reason)
		local stack, id = record.stack, record.id
		if stack and id then
			stack.schedule.dismiss(id, reason)
		end
	end

	local function finish(record: Record, reason: Reason)
		if record.torn or record.id == nil then
			return
		end
		local change = record.spec.onPresentedChange
		if record.spec.isPresented ~= nil and change then
			offer(record, reason, function()
				change(false)
			end)
		else
			dismiss(record, reason)
		end
	end

	local function paused(stack: Stack): boolean
		local top = stack.schedule.visible()[1]
		if stack.lane ~= "action" or top == nil then
			return false
		end
		local record = top.data :: Record
		if record.row == nil or record.hovered then
			return true
		end
		return (gui ~= nil and surfaces.within(gui.SelectedObject, record.row)) or #ctx.modalScopes:peek() > 0
	end

	local function stackFor(layer: GuiBase2d, lane: string): Stack
		local byLane = stacks[layer] or {}
		stacks[layer] = byLane
		local existing = byLane[lane]
		if existing then
			return existing
		end
		local stack: Stack
		local schedule = toastSchedule.new({
			maxVisible = if lane == "action" then 1 else nil,
			now = function(): number
				return stack.time
			end,
			onDismiss = function(entry: toastSchedule.Entry, reason: string)
				retire(entry.data :: Record, reason :: Reason)
			end,
			onPropose = function(entry: toastSchedule.Entry, reason: string)
				finish(entry.data :: Record, reason :: Reason)
			end,
			onChange = function()
				for _, entry in stack.schedule.queued() do
					(entry.data :: Record).state:set("queued")
				end
				local order: { Record } = {}
				for _, entry in stack.schedule.visible() do
					local record = entry.data :: Record
					record.state:set("shown")
					table.insert(order, record)
				end
				stack.order:set(order)
				if stack.schedule.isEmpty() and stack.stop then
					stack.stop()
					stack.stop = nil
				end
			end,
		})
		stack = {
			schedule = schedule,
			order = Compose.cell({} :: { Record }),
			inset = Compose.cell(0),
			time = 0,
			stop = nil,
			lane = lane,
			layer = layer,
			container = nil,
			owner = nil,
			users = 0,
		} :: Stack
		if lane ~= "action" then
			local scope = Compose.createRootOwner(function(owner)
				stack.owner = owner
				local _, container = runtime.mount(function()
					local properties: Types.FrameNativeProps = {
						Name = "ToastStack",
						BackgroundTransparency = 1,
						Size = D2.new(1, -32, 1, 0),
						AnchorPoint = V2.new(0.5, 0),
						Position = D2.fromScale(0.5, 0),
						ZIndex = ROW_Z,
						Host.UIPadding {
							PaddingTop = function(use: ComposeTypes.Use)
								return UD.new(0, MARGIN + (if lane == "top" then use(stack.inset) else 0))
							end,
							PaddingBottom = function(use: ComposeTypes.Use)
								return UD.new(0, MARGIN + (if lane == "bottom" then use(stack.inset) else 0))
							end,
						},
						Host.UIListLayout {
							FillDirection = E.FillDirection.Vertical,
							HorizontalAlignment = E.HorizontalAlignment.Center,
							VerticalAlignment = if lane == "bottom"
								then E.VerticalAlignment.Bottom
								else E.VerticalAlignment.Top,
							SortOrder = E.SortOrder.LayoutOrder,
							Padding = UD.new(0, GAP),
						},
					}
					return Host.Frame(properties)
				end, layer)
				stack.container = container :: Frame
			end, runtime.reactor)
			stack.owner = scope.owner
		end
		byLane[lane] = stack
		return stack
	end

	local function push(record: Record)
		local stack = record.stack :: Stack
		if stack.stop == nil and frames then
			stack.stop = frames.onFrame(function(dt: number)
				if not paused(stack) then
					stack.time += dt
				end
				stack.inset:set(
					if stack.lane == "action"
						then reservations.reserved(stack.layer, "bottom", actionTokens)
						else reservations.reserved(stack.layer, stack.lane :: reservations.Edge)
				)
				stack.schedule.update()
			end)
		end
		local spec = record.spec
		local duration = spec.duration
		if spec.action then
			duration = if duration
				then math.max(duration, spec.readFloor or toastSchedule.DEFAULTS.readFloor)
				else math.huge
		end
		record.state:set("queued")
		local id = stack.schedule.push({
			key = spec.key,
			priority = spec.priority,
			duration = duration,
			readFloor = spec.readFloor,
			data = record,
			held = spec.isPresented ~= nil,
		})
		if record.state:peek() ~= "idle" then
			record.id = id
		end
	end

	local function validate(spec: OverlayProps.ToastSpec)
		local where = "UI.Toast"
		local fields = (spec :: unknown) :: { [string]: unknown }
		local interactive = spec.action ~= nil
		if (spec.message == nil) == (spec.content == nil) then
			error(`Facet {where}: give exactly one of message or content`, 0)
		end
		if spec.message ~= nil and not parts.bound(ctx, spec.message, "string") then
			error(`Facet {where}: message is a string or a bound string`, 0)
		end
		if spec.content ~= nil and type(spec.content) ~= "function" then
			error(`Facet {where}: content is a factory that returns the body`, 0)
		end
		if interactive then
			for _, key in PASSIVE_ONLY do
				if fields[key] ~= nil then
					error(`Facet {where}: {key} is for a toast without an action; one with an action docks bottom`, 0)
				end
			end
			if type(spec.action) ~= "table" then
				error(`Facet {where}: action must be \{ label, onActivate }`, 0)
			end
			local action = spec.action :: Overlay.ToastAction
			parts.known(where, (action :: unknown) :: { [string]: unknown }, { "label", "onActivate" }, "action")
			if not parts.bound(ctx, action.label, "string") or type(action.onActivate) ~= "function" then
				error(`Facet {where}: action needs a label and an onActivate function`, 0)
			end
		elseif spec.closeButton ~= nil then
			error(`Facet {where}: closeButton needs an action; a toast without one is display-only`, 0)
		end
		if spec.closeButton ~= nil and type(spec.closeButton) ~= "boolean" then
			error(`Facet {where}: closeButton must be true or false`, 0)
		end
		if spec.icon ~= nil and (type(spec.icon) ~= "string" or spec.icon == "") then
			error(`Facet {where}: icon must be an icon name or an image source`, 0)
		end
		if spec.position ~= nil and spec.position ~= "top" and spec.position ~= "bottom" then
			error(`Facet {where}: position is top or bottom`, 0)
		end
		if spec.width ~= nil and spec.width ~= "fill" and spec.width ~= "hug" then
			error(`Facet {where}: width is fill or hug`, 0)
		end
		for _, key in { "duration", "readFloor" } do
			local value = fields[key]
			if value ~= nil and not (type(value) == "number" and value >= 0 and value < math.huge) then
				error(`Facet {where}: {key} is seconds, 0 or more`, 0)
			end
		end
		if spec.priority ~= nil and not (type(spec.priority) == "number" and math.abs(spec.priority) < math.huge) then
			error(`Facet {where}: priority is a finite number`, 0)
		end
		if spec.key ~= nil and type(spec.key) ~= "string" then
			error(`Facet {where}: key is a string`, 0)
		end
		if spec.fade ~= nil and type(spec.fade) ~= "boolean" then
			error(`Facet {where}: fade is a boolean`, 0)
		end
		for _, key in { "onDismiss", "onPresentedChange" } do
			if fields[key] ~= nil and type(fields[key]) ~= "function" then
				error(`Facet {where}: {key} is a function`, 0)
			end
		end
		if spec.isPresented ~= nil and not parts.bound(ctx, spec.isPresented, "boolean") then
			error(`Facet {where}: isPresented is the caller's boolean fact`, 0)
		end
		local endsItself = not interactive or spec.closeButton ~= false or spec.duration ~= nil
		if spec.isPresented ~= nil and endsItself and spec.onPresentedChange == nil then
			error(
				`Facet {where}: a bound toast that can end itself (a duration or a close button) needs `
					.. "onPresentedChange. A read-only one has an action, closeButton = false and no duration.",
				0
			)
		end
		if spec.isPresented == nil and spec.onPresentedChange ~= nil then
			error(`Facet {where}: onPresentedChange answers isPresented; give both or neither`, 0)
		end
	end

	local function withIcon(icon: string?, message: Instance, hug: boolean): Instance
		if icon == nil then
			return message
		end
		surfaces.attach(message, { Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }) })
		local props: Types.FrameNativeProps = {
			Name = "Body",
			BackgroundTransparency = 1,
			Size = if hug then D2.fromOffset(0, 0) else D2.fromScale(1, 0),
			AutomaticSize = if hug then E.AutomaticSize.XY else E.AutomaticSize.Y,
			Host.UIListLayout({
				FillDirection = E.FillDirection.Horizontal,
				VerticalAlignment = E.VerticalAlignment.Center,
				SortOrder = E.SortOrder.LayoutOrder,
				Padding = UD.new(0, 8),
			}),
			ctx.icon(icon, { Name = "Icon", LayoutOrder = 0 }),
			message,
		}
		return Host.Frame(props)
	end

	local function limitedSlide(
		phase: Nav.PresencePhase?,
		entered: ComposeTypes.Readable<boolean>,
		level: (ComposeTypes.Use?) -> motion.Level
	): (ComposeTypes.Readable<number>, (
		ComposeTypes.Use,
		(ComposeTypes.Use) -> number
	) -> number)
		local toastTiming = ctx.motionTiming("toast")
		local arrivalReady = arrival.ready(phase)
		local present, fade, trail = ctx.motionEase("present"), ctx.motionEase("fade"), ctx.motionEase("trail")
		local function shown(use: ComposeTypes.Use): number
			return if (phase and use(phase.exiting)) or (arrivalReady and not use(arrivalReady))
				then 0
				elseif use(entered) then 1
				else 0
		end
		local function seconds(_: ComposeTypes.Use): number
			if level() == "limited" then
				return ctx.metric("motion.reducedFade")
			end
			return if phase and phase.exiting:peek() then toastTiming.exit else toastTiming.enter
		end
		local slide = runtime.tween(shown, {
			seconds = seconds,
			ease = function(t: number): number
				return if level() == "limited" then fade(t) else present(t)
			end,
		})
		local trailing = runtime.tween(shown, { seconds = seconds, ease = trail })
		return slide,
			function(use: ComposeTypes.Use, amount: (ComposeTypes.Use) -> number): number
				local current = level(use)
				return if current == "limited"
					then use(slide)
					elseif current == "normal" then use(trailing)
					else amount(use)
			end
	end

	local function passiveRow(record: Record, stack: Stack, phase: Nav.PresencePhase?): Instance
		local spec = record.spec
		local bottom = spec.position == "bottom"
		local hug = spec.width == "hug"
		local contentHug = hug and spec.content ~= nil
		local extent = if contentHug then ctx.layoutSize(stack.layer) else nil
		local natural: ComposeTypes.Readable<Vector2>? = nil
		local reduced = reducedMotion(ctx)
		local level = motion.level(ctx)
		local body: Instance
		if spec.content then
			body = spec.content()
		else
			local message = spec.message
			local messageNode = ctx.text({
				Name = "Message",
				Text = function(use: ComposeTypes.Use)
					return read(message, use) or ""
				end,
				TextWrapped = true,
				LayoutOrder = 1,
				Size = D2.fromScale(1, 0),
				AutomaticSize = E.AutomaticSize.Y,
			})
			if hug then
				natural = textMeasure.natural(ctx, messageNode)
			end
			body = withIcon(spec.icon, messageNode, false)
		end
		local entered = Compose.cell(false)
		local slide, opacity = limitedSlide(phase, entered, level)
		local function amount(use: ComposeTypes.Use): number
			if reduced(use) then
				return if level(use) == "none" and phase and use(phase.exiting) then 0 else 1
			end
			return use(slide)
		end
		local props: Types.CanvasGroupNativeProps = {
			Name = "ToastRow",
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			Active = false,
			Interactable = false,
			ZIndex = ROW_Z,
			AnchorPoint = function(use: ComposeTypes.Use)
				return V2.new(0.5, if bottom then 0 else 1 - amount(use))
			end,
			AutomaticSize = if contentHug then E.AutomaticSize.XY else E.AutomaticSize.Y,
			Size = function(use: ComposeTypes.Use)
				return if contentHug then D2.fromOffset(0, 0) else D2.fromScale(1, 0)
			end,
			Position = function(use: ComposeTypes.Use)
				local travel = (1 - amount(use)) * (MARGIN + use(stack.inset))
				return D2.new(0.5, 0, if bottom then 1 - amount(use) else 0, if bottom then travel else -travel)
			end,
			body,
		}
		props[#props + 1] = ctx.padding(12, 8)
		props[#props + 1] = ctx.corner()
		if hug then
			props[#props + 1] = Host.UISizeConstraint({
				Name = "WidthCap",
				MaxSize = function(use: ComposeTypes.Use)
					if extent then
						return V2.new(math.max(0, math.min(HUG_MAX, use(extent).X - 32)), math.huge)
					end
					local package = read(ctx.config.theme, use)
					local panel = if package and package.chrome then package.chrome.panel else nil
					local insets = if panel then panel.contentInsets else nil
					local chrome = math.max(12, if insets then insets.left or 0 else 0)
						+ math.max(12, if insets then insets.right or 0 else 0)
						+ (if spec.icon then ctx.controlSize(nil, "iconSize", use) + 8 else 0)
					return V2.new(math.min(HUG_MAX, if natural then use(natural).X + chrome else HUG_MAX), math.huge)
				end,
			})
		end
		local row = ctx.styled(ctx.fade(props), "snackbar")
		ctx.styled(row, "panel")
		ctx.styled(row, "floating")
		surfaces.skin(row, "panel")
		ctx.fadeTo(row, function(use: ComposeTypes.Use)
			local arrivalReady = arrival.ready(phase)
			if arrivalReady and not use(arrivalReady) then
				return 1
			end
			if spec.fade == false and level(use) == "normal" then
				return 0
			end
			return 1 - opacity(use, amount)
		end)
		for _, node in row:GetDescendants() do
			if node:IsA("GuiObject") then
				node.Selectable = false
			end
		end
		local parent = ctx.observe.Parent(row)
		Compose.watch(function(use: ComposeTypes.Use)
			if use(parent) then
				entered:set(true)
			end
		end)
		local slot = Host.Frame "ToastSlot" {
			BackgroundTransparency = 1,
			Size = D2.fromScale(1, 0),
			AutomaticSize = E.AutomaticSize.Y,
			LayoutOrder = function(use: ComposeTypes.Use): number
				local index = table.find(use(stack.order), record) or 0
				return if bottom then -index else index
			end,
			row,
		}
		slot:SetAttribute("FacetArrivalGroup", true)
		return slot
	end

	local function actionRow(record: Record, stack: Stack, phase: Nav.PresencePhase?): Instance
		local spec, layer = record.spec, stack.layer
		local origin = ctx.observe.AbsolutePosition(layer)
		local closable = spec.closeButton ~= false
		local measure = ctx.text({
			Name = "MessageMeasure",
			Text = function(use: ComposeTypes.Use)
				return read(spec.message, use) or ""
			end,
			TextWrapped = false,
			TextTransparency = 1,
			Size = D2.fromOffset(0, 0),
			AutomaticSize = E.AutomaticSize.None,
			Visible = false,
		})
		local unit = ctx.layoutUnit(measure)
		local extent = ctx.layoutSize(layer, unit)
		local function cap(use: ComposeTypes.Use): number
			return math.max(0, math.min(ctx.metric("controls.snackbar.maxWidth", use), use(extent).X - 32))
		end
		local natural = ctx.layoutBounds(measure, unit)
		local actionWidth = Compose.cell(0)
		local function chrome(use: ComposeTypes.Use): number
			local package = ctx.read(ctx.config.theme, use)
			local panel = if package and package.chrome then package.chrome.panel else nil
			local insets = if panel then panel.contentInsets else nil
			return math.max(8, if insets then insets.left or 0 else 0)
				+ math.max(8, if insets then insets.right or 0 else 0)
				+ (if spec.icon then ctx.controlSize(nil, "iconSize", use) + 8 else 0)
				+ (if closable then 44 + 8 else 0)
		end
		local beside = Compose.formula(function(use: ComposeTypes.Use): boolean
			return math.ceil(use(natural).X) + use(actionWidth) + 8 + chrome(use) <= cap(use)
		end)
		local message = ctx.text({
			Name = "Message",
			Text = function(use: ComposeTypes.Use)
				return read(spec.message, use) or ""
			end,
			TextWrapped = true,
			LayoutOrder = 1,
			Size = D2.new(1, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
		})
		surfaces.attach(message, {
			Host.UIFlexItem({
				FlexMode = function(use: ComposeTypes.Use)
					return if use(beside) then E.UIFlexMode.Fill else E.UIFlexMode.None
				end,
			}),
		})
		local action = spec.action :: Overlay.ToastAction
		local button = UI.Button "Action" {
			label = action.label,
			LayoutOrder = 2,
			onActivate = function()
				if record.state:peek() ~= "shown" then
					return
				end
				if spec.isPresented ~= nil then
					offer(record, "action", action.onActivate)
				else
					parts.call(action.onActivate, function()
						dismiss(record, "action")
					end)
				end
			end,
		}
		local buttonSize = ctx.layoutSize(button, unit)
		Compose.watch(function(use: ComposeTypes.Use)
			actionWidth:set(use(buttonSize).X)
		end)
		local bodyProps: Types.FrameNativeProps = {
			Name = "Body",
			BackgroundTransparency = 1,
			LayoutOrder = 2,
			Size = D2.new(0, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
			Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }),
			Host.UIListLayout({
				FillDirection = function(use: ComposeTypes.Use)
					return if use(beside) then E.FillDirection.Horizontal else E.FillDirection.Vertical
				end,
				HorizontalAlignment = E.HorizontalAlignment.Right,
				VerticalAlignment = E.VerticalAlignment.Center,
				SortOrder = E.SortOrder.LayoutOrder,
				Padding = UD.new(0, 8),
			}),
			message,
			measure,
			button,
		}
		local rowProps: Types.CanvasGroupNativeProps = {
			Name = "Snack",
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			ZIndex = ACTION_Z,
			AnchorPoint = V2.new(0.5, 1),
			AutomaticSize = E.AutomaticSize.Y,
			Size = function(use: ComposeTypes.Use)
				return D2.fromOffset(cap(use), 0)
			end,
			ctx.padding(8, 8),
			ctx.corner(),
			Host.UIListLayout({
				FillDirection = E.FillDirection.Horizontal,
				VerticalAlignment = E.VerticalAlignment.Center,
				SortOrder = E.SortOrder.LayoutOrder,
				Padding = UD.new(0, 8),
			}),
			Host.Frame(bodyProps),
		}
		if spec.icon then
			rowProps[#rowProps + 1] = ctx.icon(spec.icon, { Name = "Icon", LayoutOrder = 0 })
		end
		if closable then
			rowProps[#rowProps + 1] = UI.Button "Close" {
				name = "Close",
				icon = "close",
				LayoutOrder = 3,
				Size = D2.fromOffset(44, 44),
				AutomaticSize = E.AutomaticSize.None,
				onActivate = function()
					finish(record, "close")
				end,
			}
		end
		local row = ctx.styled(ctx.fade(rowProps), "snackbar")
		ctx.styled(row, "panel")
		ctx.styled(row, "floating")
		surfaces.skin(row, "panel")
		local reduced = reducedMotion(ctx)
		local level = motion.level(ctx)
		local shown = Compose.cell(false)
		local slide, opacity = limitedSlide(phase, shown, level)
		local function amount(use: ComposeTypes.Use): number
			if reduced(use) then
				return if level(use) == "none" and phase and use(phase.exiting) then 0 else 1
			end
			return use(slide)
		end
		ctx.fadeTo(row, function(use: ComposeTypes.Use)
			return 1 - opacity(use, amount)
		end)
		local measured = ctx.observe.AbsoluteSize(row)
		runtime.decorate(row, {
			AnchorPoint = function(use: ComposeTypes.Use)
				return V2.new(0.5, amount(use))
			end,
			Position = function(use: ComposeTypes.Use)
				local travel = (1 - amount(use)) * (16 + use(stack.inset))
				return D2.new(0.5, 0, 1, -16 - use(stack.inset) + travel)
			end,
			Interactable = function(use: ComposeTypes.Use)
				return not (phase and use(phase.exiting))
			end,
		})
		local state = ctx.observe.GuiState(row)
		Compose.watch(function(use: ComposeTypes.Use)
			record.hovered = use(state) == E.GuiState.Hover
		end)
		record.row = row
		actionRows[row] = true
		local token = {}
		actionTokens[token] = true
		local at = ctx.observe.AbsolutePosition(row)
		Compose.watch(function(use: ComposeTypes.Use)
			local box = use(measured)
			local offset = use(origin)
			use(extent)
			if box.Y > 0 then
				reservations.set(layer, token, "bottom", use(at).Y - offset.Y, box.Y)
			end
		end)
		Compose.cleanup(function()
			if gui and surfaces.within(gui.SelectedObject, row) then
				gui.SelectedObject = if returnTo and returnTo.Parent then returnTo else nil
			end
			reservations.clear(layer, token)
			actionRows[row] = nil
			if record.row == row then
				record.row = nil
			end
		end)
		local selection: ComposeTypes.Readable<GuiObject?> = if gui and gui.GetPropertyChangedSignal
			then ctx.observe.SelectedObject(gui)
			else Compose.cell(nil :: GuiObject?)
		ctx.action(row, "ToastCancel", { E.KeyCode.ButtonB, E.KeyCode.Escape }, function(use: ComposeTypes.Use)
			local selected = use(selection)
			return selected ~= nil and surfaces.within(selected, row)
		end, function()
			local back = returnTo
			finish(record, "cancel")
			if gui and back and back.Parent and gui.SelectedObject ~= back then
				gui.SelectedObject = back
			end
		end, { priority = 2500 })
		local raiser = returnTo
		local target = surfaces.firstSelectable(row)
		if raiser and target and (raiser.NextSelectionDown :: GuiObject?) == nil then
			raiser.NextSelectionDown = target
			local function unlink()
				if raiser.NextSelectionDown == target then
					((raiser :: unknown) :: { NextSelectionDown: GuiObject? }).NextSelectionDown = nil
				end
			end
			Compose.watch(function(use: ComposeTypes.Use)
				local selected = use(selection)
				if selected ~= nil and selected ~= raiser and not surfaces.within(selected, row) then
					unlink()
				end
			end)
			Compose.cleanup(unlink)
		end
		local parent = ctx.observe.Parent(row)
		Compose.watch(function(use: ComposeTypes.Use)
			if use(parent) then
				shown:set(true)
			end
		end)
		return row
	end

	local function trackReturn()
		if gui and gui.GetPropertyChangedSignal then
			local selection = ctx.observe.SelectedObject(gui)
			Compose.watch(function(use: ComposeTypes.Use)
				local selected = use(selection)
				if selected == nil then
					return
				end
				for row in actionRows do
					if surfaces.within(selected, row) then
						return
					end
				end
				returnTo = selected
			end)
		end
	end

	UI.Toast = ctx.construct("Toast", function(spec: OverlayProps.ToastSpec): Frame
		validate(spec)
		local interactive = spec.action ~= nil
		local level = motion.level(ctx)
		if interactive then
			trackReturn()
		end
		local properties =
			ctx.props(spec, KEYS, { Name = "Toast", BackgroundTransparency = 1, Size = D2.fromOffset(0, 0) })
		local visible = properties.Visible
		properties.Visible = false
		local root = Host.Frame(properties)
		root:SetAttribute("FacetOverlayPlaceholder", true)
		local record: Record = {
			spec = spec,
			state = Compose.cell("idle"),
			stack = nil,
			id = nil,
			pending = nil,
			torn = false,
			hovered = false,
			row = nil,
		}
		local armed = wanted(record)
		local function sync()
			if armed and record.stack and record.id == nil then
				armed = false
				push(record)
			end
		end
		local function locate()
			local collector = root:FindFirstAncestorWhichIsA("LayerCollector")
			local layer = if collector then surfaces.parent(root) else nil
			if record.stack == nil and layer then
				local stack = stackFor(layer :: GuiBase2d, if interactive then "action" else spec.position or "top")
				record.stack = stack
				stack.users += 1
				sync()
			end
		end
		runtime.connect(root, "AncestryChanged", locate)
		locate()
		if spec.isPresented ~= nil then
			local last = armed
			Compose.watch(function(use: ComposeTypes.Use)
				local want = read(spec.isPresented, use) == true
				if want == last then
					return
				end
				last = want
				armed = want
				if want then
					sync()
				else
					dismiss(record, record.pending or "cancel")
				end
			end)
		end
		Compose.cleanup(function()
			record.torn = true
			armed = false
			dismiss(record, if spec.isPresented ~= nil then "cancel" else "manual")
			local stack = record.stack
			if stack then
				stack.users -= 1
				if stack.users == 0 then
					if stack.owner then
						stack.owner.dispose()
					end
					local lanes = stacks[stack.layer]
					if lanes then
						lanes[stack.lane] = nil
					end
				end
			end
		end)
		surfaces.attach(root, {
			surfaces.overlay(root, function(use: ComposeTypes.Use): boolean
				return use(record.state) == "shown" and read(visible, use) ~= false
			end, function(phase)
				local stack = assert(record.stack)
				return if interactive then actionRow(record, stack, phase) else passiveRow(record, stack, phase)
			end, {
				parent = function(): GuiBase2d?
					return if record.stack then record.stack.container else nil
				end,
				presence = {
					exit = function()
						local current = level()
						if current == "none" then
							return { completed = Compose.cell(true) }
						end
						local seconds = if current == "limited"
							then ctx.metric("motion.reducedFade")
							else ctx.metric("motion.toast.exit")
						return { completed = runtime.timeline({ duration = seconds }).completed }
					end,
				},
			}),
		})
		Compose.watch(function(use: ComposeTypes.Use)
			local state = use(record.state)
			root:SetAttribute("ToastVisible", state == "shown")
			root:SetAttribute("ToastQueued", state == "queued")
		end)
		return root
	end)
end
