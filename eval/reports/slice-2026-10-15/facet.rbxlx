          <Item class="ModuleScript" referent="154">
            <Properties>
              <string name="Name">nav_overlay_portal</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local overlayPresence = require("./nav_overlay_presence")
local rest = require("./rest")
local fontReadiness = require("./font_readiness")
local textMeasure = require("./text_measure")
local arrival = require("./overlay_arrival")

export type Portal = {
	available: (GuiObject) -> ComposeTypes.Readable<boolean>,
	parent: (Instance) -> GuiBase2d?,
	overlay: (GuiObject, Types.Value<boolean>, (Nav.PresencePhase?) -> Instance, Nav.OverlayOptions?) -> Types.Child,
}

return function(ctx: Types.Context, presence: overlayPresence.Presence): Portal
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local departure = presence.departure
	local function available(anchor: GuiObject, changed: (() -> ())?): ComposeTypes.Readable<boolean>
		local owner = assert(Compose.currentOwner())
		local value = Compose.cell(false)
		local ancestryOwner: ComposeTypes.Owner?
		local function locate()
			if owner.isDisposed() then
				return
			end
			if ancestryOwner then
				ancestryOwner.dispose()
				ancestryOwner = nil
			end
			local root: Instance? = anchor
			while root and not root:IsA("LayerCollector") do
				root = root.Parent
			end
			if root == nil then
				value:set(false)
				return
			end
			local nextOwner = owner.createChild()
			ancestryOwner = nextOwner
			Compose.withOwner(nextOwner, function()
				local sources: { ComposeTypes.Readable<boolean> } = {}
				local at: Instance? = anchor
				local attached = false
				while at do
					if at:IsA("GuiObject") then
						if at ~= anchor or anchor:GetAttribute("FacetOverlayPlaceholder") ~= true then
							table.insert(sources, ctx.observe.Visible(at))
						end
						table.insert(sources, ctx.observe.Interactable(at))
					end
					if at:IsA("LayerCollector") then
						attached = true
						table.insert(sources, ctx.observe.Enabled(at))
						break
					end
					at = at.Parent
				end
				Compose.watch(function(use: ComposeTypes.Use)
					local enabled = attached
					for _, source in sources do
						if not use(source) then
							enabled = false
						end
					end
					value:set(enabled)
				end)
			end)
		end
		local function refresh()
			locate()
			if changed then
				changed()
			end
		end
		runtime.connect(anchor, "AncestryChanged", refresh)
		refresh()
		return value
	end

	local function arrive(build: () -> Instance, arrived: ComposeTypes.Cell<boolean>): Instance
		local frames = ctx.config.services and ctx.config.services.RunService
		local built: Instance? = nil
		local wrapper: CanvasGroup? = nil
		if frames and frames.PreRender then
			wrapper = Host.CanvasGroup "OverlayArrival" {
				BackgroundTransparency = 1,
				Size = ctx.types.UDim2.fromScale(1, 1),
				GroupTransparency = function(use: ComposeTypes.Use): number
					return if use(arrived) then 0 else 1
				end,
				Interactable = arrived,
				Compose.fragment(function(): { unknown }
					local node = build()
					built = node
					return { node }
				end),
			}
		else
			built = build()
		end
		local node = assert(built)
		if frames == nil then
			arrived:set(true)
			return node
		end
		local surfaces: { GuiObject } = {}
		local parts: { Instance } = if node:IsA("GuiObject") then { node } else node:GetChildren()
		for _, part in parts do
			if part:IsA("GuiObject") and part.Visible then
				table.insert(surfaces, part)
			end
		end
		if #surfaces == 0 then
			arrived:set(true)
			return node
		end
		if frames.PreRender == nil then
			arrived:set(true)
			for _, surface in surfaces do
				surface.Visible = false
			end
			local connection: RBXScriptConnection? = nil
			connection = frames.Heartbeat:Connect(function()
				if connection then
					connection:Disconnect()
					connection = nil
				end
				for _, surface in surfaces do
					surface.Visible = true
				end
			end)
			Compose.cleanup(function()
				if connection then
					connection:Disconnect()
				end
			end)
			return node
		end
		local fontsReady = fontReadiness(ctx, surfaces)
		local ready = rest(ctx, function(): (string, boolean, boolean?)
			local signature: { string } = {}
			local filled = false
			local measured = true
			for _, surface in surfaces do
				local descendants = surface:GetDescendants()
				table.insert(descendants, surface)
				filled = filled or (surface.AbsoluteSize.X > 0 and surface.AbsoluteSize.Y > 0)
				for _, child in descendants do
					measured = measured and textMeasure.ready(child)
					if child:IsA("GuiObject") then
						filled = filled or (child.Visible and child.AbsoluteSize.X > 0 and child.AbsoluteSize.Y > 0)
						local value = `{child.AbsolutePosition}:{child.AbsoluteSize}:{child.Visible}`
						if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
							value ..= `:{child.TextBounds}`
						end
						table.insert(signature, value)
					end
				end
			end
			return table.concat(signature, ";"), filled, fontsReady() and measured
		end, nil, true)
		Compose.watch(function(use: ComposeTypes.Use)
			if use(ready) then
				arrived:set(true)
			end
		end)
		if node:GetAttribute("FacetArrivalGroup") == true then
			return node
		end
		local depths: { ComposeTypes.Readable<number> } = {}
		for _, surface in surfaces do
			local depth = Compose.cell(surface.ZIndex)
			Compose.cleanup(assert(runtime.host.observation).observeProperty(surface, "ZIndex", function()
				depth:set(surface.ZIndex)
			end))
			table.insert(depths, depth)
		end
		local group = assert(wrapper)
		runtime.decorate(group, {
			ZIndex = function(use: ComposeTypes.Use): number
				local highest = 1
				for _, depth in depths do
					highest = math.max(highest, use(depth))
				end
				return highest
			end,
		})
		return group
	end
	local function parent(anchor: Instance): GuiBase2d?
		local layer = (ctx.config.overlayParent or anchor:FindFirstAncestorWhichIsA("LayerCollector")) :: GuiBase2d?
		if layer and layer:IsA("SurfaceGui") and not layer.ClipsDescendants then
			layer.ClipsDescendants = true
		end
		return layer
	end
	local function overlay(
		anchor: GuiObject,
		presented: Types.Value<boolean>,
		build: (Nav.PresencePhase?) -> Instance,
		options: Nav.OverlayOptions?
	): Types.Child
		local owner = assert(Compose.currentOwner())
		local destination = Compose.cell(nil :: Instance?)
		destination:set(if options and options.parent then options.parent() else ctx.config.overlayParent)
		local function locate()
			if owner.isDisposed() then
				return
			end
			if options and options.parent then
				destination:set(options.parent() or parent(anchor))
				return
			end
			if ctx.config.overlayParent then
				return
			end
			destination:set(parent(anchor))
		end
		local enabled = available(anchor, locate)
		local condition = function(use: ComposeTypes.Use): boolean
			return use(enabled) and ctx.read(presented, use)
		end
		return Compose.switch(destination, {}, function()
			local target = destination:peek()
			if target == nil then
				return Compose.fragment(function()
					return {}
				end)
			end
			local age: ComposeTypes.Readable<number>? = nil
			local function render(phase: Nav.PresencePhase?): Instance
				if phase then
					age = runtime.timeline({ duration = 0.001 }).elapsed
				end
				local function themed(): Instance
					local services = ctx.config.services.RunService
					local arrived = Compose.cell(services == nil or services.PreRender == nil)
					local entering: Nav.PresencePhase = phase or { exiting = Compose.cell(false) }
					arrival.bind(entering, arrived)
					return arrive(function()
						local node = build(entering)
						local scope: Instance? = anchor
						while scope and scope ~= target do
							local link = scope:FindFirstChildWhichIsA("StyleLink")
							if link then
								local observe = (
									ctx.observe :: unknown
								) :: { StyleSheet: (StyleLink) -> ComposeTypes.Cell<StyleSheet?> }
								local sheet = observe.StyleSheet(link :: StyleLink)
								local Links = (Host :: unknown) :: { StyleLink: ({ StyleSheet: unknown }) -> Instance }
								runtime.mountFragment(function()
									return { Links.StyleLink { StyleSheet = sheet } }
								end, node)
								break
							end
							scope = scope.Parent
						end
						return node
					end, arrived)
				end
				if options and options.failure then
					return Host.Folder({
						Compose.boundary(function()
							return themed()
						end, options.failure),
					})
				end
				return themed()
			end
			local presence = if options and options.presence
				then options.presence
				elseif options and options.motion then departure(options.motion, anchor, function(): boolean
					local elapsed = age
					return elapsed ~= nil and elapsed:peek() > 0
				end)
				else nil
			local function presentation(): Types.Child
				return if presence
					then Compose.presence(condition, render, presence)
					else Compose.show(condition, render)
			end
			local identity = options and options.identity
			runtime.mountFragment(function()
				return {
					if identity then Compose.switch(identity, {}, presentation) else presentation(),
				}
			end, target)
			return Compose.fragment(function()
				return {}
			end)
		end)
	end
	return { available = available, parent = parent, overlay = overlay }
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="155">
            <Properties>
              <string name="Name">nav_overlay_presence</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local motion = require("./motion")
local rest = require("./rest")
local fontReadiness = require("./font_readiness")
local arrival = require("./overlay_arrival")
local textMeasure = require("./text_measure")

export type Presence = {
	appearance: (Nav.PresencePhase?, Nav.MotionTiming, ComposeTypes.Readable<boolean>?) -> Nav.Presence,
	atRest: (
		Nav.Appearance,
		ComposeTypes.Cell<boolean>,
		{ GuiObject },
		((ComposeTypes.Use) -> string)?
	) -> ({ ComposeTypes.Readable<Vector2> }, ComposeTypes.Readable<boolean>),
	departure: (Nav.MotionTiming, GuiObject, () -> boolean) -> ComposeTypes.PresenceOptions,
}

return function(ctx: Types.Context): Presence
	local Compose, runtime = ctx.Compose, ctx.runtime
	local function appearance(
		phase: Nav.PresencePhase?,
		timing: Nav.MotionTiming,
		ready: ComposeTypes.Readable<boolean>?
	): Nav.Presence
		local level = motion.level(ctx)
		local arrivalReady = arrival.ready(phase)
		local function placed(use: ComposeTypes.Use?): boolean
			return (ready == nil or ctx.read(ready, use)) and (arrivalReady == nil or ctx.read(arrivalReady, use))
		end
		local exiting: ComposeTypes.Readable<boolean> = if phase then phase.exiting else Compose.cell(false)
		local shown = Compose.cell(false)
		local fadeIn, fadeOut = ctx.metric("motion.presentFadeIn"), ctx.metric("motion.presentFadeOut")
		local present, fade = ctx.motionEase("present"), ctx.motionEase("fade")
		local progress = runtime.tween(function(use: ComposeTypes.Use): number
			return if use(exiting) or not use(shown) or not placed(use) then 0 else 1
		end, {
			seconds = function(_: ComposeTypes.Use): number
				if level() == "limited" then
					return ctx.metric("motion.reducedFade")
				end
				return if exiting:peek() then timing.exit else timing.enter
			end,
			ease = function(t: number): number
				return if level() == "limited" then fade(t) else present(t)
			end,
		})
		shown:set(true)
		local function raw(use: ComposeTypes.Use?): number
			if not placed(use) then
				return 0
			end
			return if level(use) == "none" then 1 else ctx.read(progress, use)
		end
		local function travel(use: ComposeTypes.Use?): number
			if not placed(use) then
				return 0
			end
			return if level(use) == "normal" then ctx.read(progress, use) else 1
		end
		local last = 0
		type Anchor = { p: number, o: number }
		local anchor: ComposeTypes.Cell<Anchor> = Compose.cell({ p = 0, o = 0 } :: Anchor)
		local function opacity(use: ComposeTypes.Use?): number
			local p = raw(use)
			if level(use) ~= "normal" then
				last = p
				return p
			end
			local from: Anchor = if use then use(anchor) else anchor:peek()
			local value
			if ctx.read(exiting, use) then
				local cleared = 1 - present(fadeOut)
				value = if from.p > cleared
					then from.o * math.clamp((p - cleared) / (from.p - cleared), 0, 1)
					elseif from.p > 0 then from.o * math.clamp(p / from.p, 0, 1)
					else 0
			else
				local opaque = math.max(present(fadeIn), from.p + 1e-3)
				value = from.o + (1 - from.o) * math.clamp((p - from.p) / (opaque - from.p), 0, 1)
			end
			last = value
			return value
		end
		Compose.watch(function(use: ComposeTypes.Use)
			use(exiting)
			anchor:set({ p = raw(), o = last })
		end)
		return { opacity = opacity, travel = travel }
	end
	local function atRest(
		amount: Nav.Appearance,
		ready: ComposeTypes.Cell<boolean>,
		nodes: { GuiObject },
		restart: ((ComposeTypes.Use) -> string)?
	): ({ ComposeTypes.Readable<Vector2> }, ComposeTypes.Readable<boolean>)
		local live: { ComposeTypes.Readable<Vector2> } = {}
		for index, node in nodes do
			live[index] = ctx.observe.AbsoluteSize(node)
		end
		local fontsReady = fontReadiness(ctx, nodes)
		local rested = rest(ctx, function(): (string, boolean, boolean?)
			local parts: { string } = {}
			local filled = false
			local measured = true
			local origin = nodes[1].AbsolutePosition
			local descendants = nodes[1]:GetDescendants()
			for _, node in nodes do
				table.insert(descendants, node)
				filled = filled or (node.AbsoluteSize.X > 0 and node.AbsoluteSize.Y > 0)
			end
			for _, node in descendants do
				measured = measured and textMeasure.ready(node)
				if node:IsA("GuiObject") then
					local value = `{node.AbsolutePosition - origin}:{node.AbsoluteSize}:{node.Visible}`
					if node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox") then
						value ..= `:{node.TextBounds}`
					end
					table.insert(parts, value)
				end
			end
			return table.concat(parts, ";"), filled, nodes[1].Visible and fontsReady() and measured
		end, restart)
		local held: { ComposeTypes.Readable<Vector2> } = {}
		for index, size in live do
			local natural = Compose.cell(size:peek())
			held[index] = natural
			Compose.watch(function(use: ComposeTypes.Use)
				local value = use(size)
				if not use(rested) or amount() >= 1 then
					natural:set(value)
				end
			end)
		end
		Compose.watch(function(use: ComposeTypes.Use)
			if use(rested) then
				ready:set(true)
			end
		end)
		return held, rested
	end
	local function attached(anchor: GuiObject): boolean
		local at: Instance? = anchor
		while at do
			if at:IsA("GuiObject") and not at.Visible then
				return false
			end
			if at:IsA("LayerCollector") then
				return at.Enabled
			end
			at = at.Parent
		end
		return false
	end
	local function departure(
		timing: Nav.MotionTiming,
		anchor: GuiObject,
		shown: () -> boolean
	): ComposeTypes.PresenceOptions
		local level = motion.level(ctx)
		local owner = assert(Compose.currentOwner())
		type Pending = {
			completed: ComposeTypes.Readable<boolean>,
			scope: ComposeTypes.Owner?,
		}
		local pending: ComposeTypes.Cell<Pending?> = Compose.cell(nil :: Pending?)
		local function release(entry: Pending?)
			if entry and entry.scope then
				entry.scope.dispose()
			end
		end
		Compose.watch(function(use: ComposeTypes.Use)
			local entry = use(pending)
			if entry and use(entry.completed) then
				pending:set(nil)
				release(entry)
			end
		end)
		Compose.cleanup(function()
			release(pending:peek())
		end)
		local function begin(
			completed: ComposeTypes.Readable<boolean>,
			scope: ComposeTypes.Owner?
		): ComposeTypes.Exiting
			release(pending:peek())
			pending:set({ completed = completed, scope = scope })
			return { completed = completed }
		end
		return {
			exit = function()
				local current = level()
				if not shown() or not attached(anchor) or current == "none" then
					return begin(Compose.cell(true), nil)
				end
				local scope = owner.createChild()
				local timeline = Compose.withOwner(scope, function()
					return runtime.timeline({
						duration = if current == "limited" then ctx.metric("motion.reducedFade") else timing.exit,
					})
				end)
				return begin(timeline.completed, scope)
			end,
		}
	end
	return { appearance = appearance, atRest = atRest, departure = departure }
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="156">
            <Properties>
              <string name="Name">nav_page_layers</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local motion = require("./motion")

export type PageLayers = {
	content: <P>(Instance | ((Nav.NavigationEntry<P>?) -> Instance), Nav.NavigationEntry<P>?) -> Instance,
	checkTransition: (Nav.Transition | false?) -> (),
	layer: (
		Types.CanvasGroupNativeProps & Types.FrameNativeProps,
		ComposeTypes.Readable<ComposeTypes.LayerStackState>,
		Nav.Transition | false?,
		(() -> ())?,
		boolean?
	) -> GuiObject,
	checkedSelection: (ComposeTypes.Cell<string>, { Nav.Tab }, string) -> { [string]: Nav.Tab },
}

return function(ctx: Types.Context): PageLayers
	local Host, Compose, runtime = ctx.Host, ctx.Compose, ctx.runtime
	local function content<P>(
		builder: Instance | ((Nav.NavigationEntry<P>?) -> Instance),
		entry: Nav.NavigationEntry<P>?
	): Instance
		return if type(builder) == "function" then builder(entry) else builder
	end
	local function checkTransition(transition: Nav.Transition | false?): ()
		if transition == nil or transition == false then
			return
		end
		assert(type(transition) == "table", "Navigation transition uses Compose tween options")
		for key in transition do
			assert(key == "seconds" or key == "ease", "Navigation transition uses Compose tween options: seconds, ease")
		end
	end
	local function layer(
		properties: Types.CanvasGroupNativeProps & Types.FrameNativeProps,
		state: ComposeTypes.Readable<ComposeTypes.LayerStackState>,
		transition: Nav.Transition | false?,
		hidden: (() -> ())?,
		immediate: boolean?
	): GuiObject
		if transition == nil or transition == false then
			local node = Host.Frame(properties)
			if hidden then
				Compose.watch(function(use: ComposeTypes.Use)
					if not use(state).top then
						hidden()
					end
				end)
			end
			return node
		end
		checkTransition(transition)
		local mounted = Compose.cell(false)
		local level = motion.level(ctx)
		local opacity = runtime.tween(function(use: ComposeTypes.Use)
			return if (immediate or use(mounted)) and use(state).top then 1 else 0
		end, transition)
		local function still(use: ComposeTypes.Use): boolean
			return level(use) == "none"
		end
		properties.GroupTransparency = function(use: ComposeTypes.Use)
			return if still(use) then 0 else 1 - use(opacity)
		end
		properties.Visible = function(use: ComposeTypes.Use)
			return use(state).top or not still(use) and use(opacity) > 0
		end
		properties.Interactable = function(use: ComposeTypes.Use)
			return use(state).top
		end
		local panel = ctx.fade(properties, nil, if properties.BackgroundTransparency == 1 then false else nil)
		local parent = ctx.observe.Parent(panel)
		Compose.watch(function(use: ComposeTypes.Use)
			mounted:set(use(parent) ~= nil)
		end)
		if hidden then
			Compose.watch(function(use: ComposeTypes.Use)
				if not use(state).top and (still(use) or use(opacity) == 0) then
					hidden()
				end
			end)
		end
		return panel
	end

	local function checkedSelection(
		selection: ComposeTypes.Cell<string>,
		entries: { Nav.Tab },
		label: string
	): { [string]: Nav.Tab }
		assert(selection and selection.set, label .. ".selection requires a writable Compose cell")
		assert(type(entries) == "table" and #entries > 0, label .. " requires entries")
		local byId: { [string]: Nav.Tab } = {}
		for _, entry in entries do
			assert(type(entry.id) == "string" and byId[entry.id] == nil, label .. " entries require unique string ids")
			byId[entry.id] = entry
		end
		assert(byId[selection:peek()], label .. ".selection must name an entry")
		return byId
	end
	return {
		content = content,
		checkTransition = checkTransition,
		layer = layer,
		checkedSelection = checkedSelection,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="157">
            <Properties>
              <string name="Name">nav_page_view</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local reducedMotion = require("./motion").reduced
local NavigationProps = require("./navigation_props")
local pageLayers = require("./nav_page_layers")

local FLING_SPEED = 1200

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	surfaces: Nav.Surfaces,
	layers: pageLayers.PageLayers
): ()
	local Host, Compose, runtime = ctx.Host, ctx.Compose, ctx.runtime
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local content, checkedSelection = layers.content, layers.checkedSelection
	UI.PageView = ctx.construct("PageView", function(spec: NavigationProps.PageViewSpec): Frame
		local byId = checkedSelection(spec.selection, spec.pages, "PageView")
		local indexById: { [string]: number } = {}
		for index, page in spec.pages do
			indexById[page.id] = index
		end
		local footerHeight = (if spec.summary ~= false then 24 else 0)
			+ (if spec.indicators ~= false then 48 else 0)
			+ (if spec.controls ~= false then 48 else 0)
		local pageNodes: { [string]: Frame } = {}
		local reduced = reducedMotion(ctx)
		local fling = Compose.cell(false)
		local flingStyle, pageStyle = ctx.motionStyle("fling"), ctx.motionStyle("page")
		local layout = Host.UIPageLayout "PagesLayout" {
			Animated = function(use: ComposeTypes.Use)
				return not reduced(use)
			end,
			EasingStyle = function(use: ComposeTypes.Use)
				return if use(fling) then flingStyle else pageStyle
			end,
			EasingDirection = E.EasingDirection.Out,
			TweenTime = ctx.metric("motion.durations.pageTurn"),
			Circular = false,
			FillDirection = E.FillDirection.Horizontal,
			SortOrder = E.SortOrder.LayoutOrder,
			GamepadInputEnabled = true,
			TouchInputEnabled = true,
			ScrollWheelInputEnabled = false,
		}
		local hugs = spec.AutomaticSize == E.AutomaticSize.Y or spec.AutomaticSize == E.AutomaticSize.XY
		local tallest = Compose.cell(0)
		local heights: { ComposeTypes.Readable<Vector2> } = {}
		local children: { Types.Child } = { layout }
		for index, page in spec.pages do
			local body = content(page.content, nil)
			if hugs and body:IsA("GuiObject") then
				table.insert(heights, ctx.observe.AbsoluteSize(body))
			end
			local node = Host.Frame(page.id)({
				BackgroundTransparency = 1,
				Size = D2.fromScale(1, 1),
				LayoutOrder = index,
				body,
			})
			pageNodes[page.id] = node
			table.insert(children, node)
		end
		local pages = Host.Frame "Pages" {
			BackgroundTransparency = 1,
			Size = function(use: ComposeTypes.Use)
				return if hugs then D2.new(1, 0, 0, use(tallest)) else D2.new(1, 0, 1, -footerHeight)
			end,
			ClipsDescendants = true,
		}
		surfaces.attach(pages, children)
		local pressed: { x: number, at: number }? = nil
		local function pointer(input: InputObject): boolean
			return input.UserInputType == E.UserInputType.Touch or input.UserInputType == E.UserInputType.MouseButton1
		end
		runtime.connect(pages, "InputBegan", function(input: InputObject)
			if pointer(input) then
				pressed = { x = input.Position.X, at = os.clock() }
			end
		end)
		runtime.connect(pages, "InputEnded", function(input: InputObject)
			local start = pressed
			pressed = nil
			if start and pointer(input) then
				local seconds = math.max(os.clock() - start.at, 1 / 120)
				fling:set(math.abs(input.Position.X - start.x) / seconds > FLING_SPEED)
			end
		end)
		local changing = false
		local parent = ctx.observe.Parent(pages)
		Compose.watch(function(use: ComposeTypes.Use)
			local id = use(spec.selection)
			assert(byId[id], "PageView.selection must name a declared page")
			if use(parent) then
				changing = true
				layout:JumpTo(pageNodes[id])
				changing = false
			end
		end)
		local size = ctx.observe.AbsoluteSize(pages)
		Compose.watch(function(use: ComposeTypes.Use)
			local box = use(size)
			if box.X <= 0 or not use(parent) then
				return
			end
			local animated = layout.Animated
			layout.Animated = false
			changing = true
			layout:JumpTo(pageNodes[spec.selection:peek()])
			changing = false
			layout.Animated = animated
		end)
		local gui = surfaces.service("GuiService")
		local current = ctx.observe.CurrentPage(layout)
		Compose.watch(function(use: ComposeTypes.Use)
			local page = use(current)
			if
				gui
				and page
				and gui.SelectedObject
				and surfaces.within(gui.SelectedObject, pages)
				and not surfaces.within(gui.SelectedObject, page)
			then
				gui.SelectedObject = surfaces.firstSelectable(page)
			end
			if not changing and page and byId[page.Name] and page.Name ~= spec.selection:peek() then
				spec.selection:set(page.Name)
			end
		end)
		local function step(amount: number): ()
			fling:set(false)
			local at = math.clamp(indexById[spec.selection:peek()] + amount, 1, #spec.pages)
			spec.selection:set(spec.pages[at].id)
		end
		if gui and ctx.action then
			local selectedObject = ctx.observe.SelectedObject(gui)
			local function inside(use: ComposeTypes.Use): boolean
				return surfaces.within(use(selectedObject), pages)
			end
			ctx.action(pages, "PageForward", { E.KeyCode.Right, E.KeyCode.DPadRight }, inside, function()
				step(1)
			end, { priority = 1500, capture = true })
			ctx.action(pages, "PageBack", { E.KeyCode.Left, E.KeyCode.DPadLeft }, inside, function()
				step(-1)
			end, { priority = 1500, capture = true })
		end
		local footer: { Types.Child } = {}
		if spec.summary ~= false then
			table.insert(
				footer,
				ctx.text({
					Name = "Summary",
					Text = function(use: ComposeTypes.Use)
						return ctx.phrase(
							"Facet.PageOf",
							"Page {current} of {count}",
							{ current = indexById[use(spec.selection)], count = #spec.pages },
							use
						)
					end,
				})
			)
		end
		if spec.indicators ~= false then
			local dots: { ComposeTypes.Child } = {}
			for index, page in spec.pages do
				local id = page.id
				local dot = UI.Button(id)({
					name = function(use: ComposeTypes.Use): string
						return ctx.phrase(
							"Facet.PageOf",
							"Page {current} of {count}",
							{ current = index, count = #spec.pages },
							use
						)
					end,
					LayoutOrder = index,
					Size = D2.fromOffset(44, 44),
					AutomaticSize = E.AutomaticSize.None,
					BackgroundTransparency = 1,
					selected = function(use: ComposeTypes.Use): boolean
						return use(spec.selection) == id
					end,
					onActivate = function()
						fling:set(false)
						spec.selection:set(id)
					end,
				})
				dot:AddTag("facet-page-indicator")
				runtime.mount(function()
					return ctx.styled(
						Host.Frame "Dot" {
							AnchorPoint = V2.new(0.5, 0.5),
							Position = D2.fromScale(0.5, 0.5),
							Size = D2.fromOffset(8, 8),
							BorderSizePixel = 0,
							Host.UICorner({ CornerRadius = ctx.round }),
						},
						"page-dot"
					)
				end, dot)
				table.insert(dots, dot)
			end
			local row = ctx.row(dots, { Name = "Indicators" })
			assert(row:FindFirstChildWhichIsA("UIListLayout")).Padding = ctx.types.UDim.new(0, 0)
			table.insert(footer, row)
		end
		if spec.controls ~= false then
			table.insert(
				footer,
				ctx.row({
					UI.Button "Previous" {
						label = "Previous",
						enabled = function(use: ComposeTypes.Use)
							return indexById[use(spec.selection)] > 1
						end,
						onActivate = function()
							step(-1)
						end,
					},
					UI.Button "Next" {
						label = "Next",
						enabled = function(use: ComposeTypes.Use)
							return indexById[use(spec.selection)] < #spec.pages
						end,
						onActivate = function()
							step(1)
						end,
					},
				})
			)
		end
		local column = ctx.column(footer, {
			Name = "Footer",
			Position = function(use: ComposeTypes.Use)
				return if hugs then D2.fromOffset(0, use(tallest)) else D2.new(0, 0, 1, -footerHeight)
			end,
			Size = D2.new(1, 0, 0, footerHeight),
			AutomaticSize = E.AutomaticSize.None,
		})
		assert(column:FindFirstChildWhichIsA("UIListLayout")).HorizontalAlignment = E.HorizontalAlignment.Center
		local root = Host.Frame(ctx.props(spec, { "pages", "selection", "indicators", "summary", "controls" }, {
			Name = "PageView",
			BackgroundTransparency = 1,
			Size = D2.fromScale(1, 1),
			pages,
			column,
		}))
		if hugs then
			local unit = ctx.layoutUnit(root)
			Compose.watch(function(use: ComposeTypes.Use)
				local most = 0
				for _, height in heights do
					most = math.max(most, use(height).Y)
				end
				tallest:set(math.ceil(most / use(unit) - 1e-3))
			end)
		end
		return root
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="158">
            <Properties>
              <string name="Name">nav_pages</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ControlTypes = require("./control_types")
local pageLayers = require("./nav_page_layers")
local tabView = require("./nav_tab_view")
local navigationStack = require("./nav_stack")
local pageView = require("./nav_page_view")

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces): ()
	local layers = pageLayers(ctx)
	tabView(ctx, UI, surfaces, layers)
	navigationStack(ctx, UI, surfaces, layers)
	pageView(ctx, UI, surfaces, layers)
end
]]></string>
