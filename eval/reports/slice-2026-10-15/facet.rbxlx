local scrollingFrame = (nil :: unknown) :: Engine.ScrollingFrameProps
local zoomView = (nil :: unknown) :: ZoomTravel.ZoomViewOptions
local frame = (nil :: unknown) :: Engine.FrameProps
local travel = (nil :: unknown) :: ZoomTravel.TravelOptions

export type ZoomViewProps = {
	Changed: typeof(scrollingFrame.Changed),
	Attributes: typeof(scrollingFrame.Attributes),
	AncestryChanged: typeof(scrollingFrame.AncestryChanged),
	Archivable: typeof(scrollingFrame.Archivable),
	AttributeChanged: typeof(scrollingFrame.AttributeChanged),
