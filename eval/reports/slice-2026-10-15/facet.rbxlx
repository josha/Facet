            <Properties>
              <string name="Name">media_readiness</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local ComposeTypes = require("../vendor/compose/core")
local rest = require("./rest")
local motion = require("./motion")

return function(ctx: Types.Context, node: ImageLabel | ViewportFrame, authored: Types.Value<number>?)
	local Compose = ctx.Compose
	local owner = assert(Compose.currentOwner())
	local scope: ComposeTypes.Owner? = nil
	local held: Instance? = nil
	local background = node.BackgroundTransparency
	local backgroundColor = node.BackgroundColor3
	local function locate()
		local parent: Instance? = node.Parent
		local row: Instance? = nil
		local surface: GuiObject? = nil
		while parent do
			if parent:IsA("GuiObject") and parent:HasTag("facet-panel") and surface == nil then
				surface = parent
			end
			if parent:GetAttribute("FacetCollectionRow") then
				row = parent
				break
			end
			parent = parent.Parent
		end
		if row == held or owner.isDisposed() then
			return
		end
		if scope then
			scope.dispose()
			scope = nil
		end
		held = row
		if not row then
			(node :: ImageLabel).ImageTransparency = ctx.read(authored) or 0
			local native = node :: GuiObject
			if not node:IsA("ViewportFrame") then
				native.BackgroundTransparency = background
				native.BackgroundColor3 = backgroundColor
			end
			node:SetAttribute("FacetMediaReady", nil)
			return
		end
		local nextScope = owner.createChild()
		scope = nextScope
		Compose.withOwner(nextScope, function()
			local size = ctx.observe.AbsoluteSize(node)
			local observed = (ctx.observe :: unknown) :: { [string]: (Instance) -> ComposeTypes.Cell<unknown> }
			local loaded = if node:IsA("ImageLabel") then observed.IsLoaded(node) else nil
			local image = if node:IsA("ImageLabel") then observed.Image(node) else nil
			local assetOwner: ComposeTypes.Owner? = nil
			Compose.watch(function(use: ComposeTypes.Use)
				if image then
					use(image)
				end
				if assetOwner then
					assetOwner.dispose()
				end
				local asset = nextScope.createChild()
				assetOwner = asset
				Compose.withOwner(asset, function()
					local fetched = Compose.cell(false)
					local provider = ctx.config.services and ctx.config.services.ContentProvider
					if provider and node:IsA("ImageLabel") and node.Image ~= "" and task then
						local thread = task.defer(function()
							pcall(function()
								provider:PreloadAsync(
									{ node },
									function(_content: string, status: Enum.AssetFetchStatus)
										if
											not asset.isDisposed()
											and status == ctx.types.Enum.AssetFetchStatus.Success
										then
											fetched:set(true)
										end
									end
								)
							end)
						end)
						Compose.cleanup(function()
							if coroutine.status(thread) ~= "dead" then
								task.cancel(thread)
							end
						end)
					end
					node:SetAttribute("FacetMediaReady", false)
					local ready = rest(ctx, function(): (string, boolean, boolean?)
						local box = size:peek()
						local filled = box.X > 0
							and box.Y > 0
							and node:GetAttribute("FacetBuilt") ~= false
							and (
								loaded == nil
								or (image ~= nil and image:peek() == "")
								or loaded:peek() == true
								or fetched:peek()
							)
						return tostring(box), filled, filled
					end, function(use: ComposeTypes.Use): string
						return if image then tostring(use(image)) else tostring(use(size))
					end, true)
					Compose.watch(function(read: ComposeTypes.Use)
						node:SetAttribute("FacetMediaReady", read(ready))
					end)
					local amount = ctx.runtime.tween(function(use: ComposeTypes.Use): number
						return if use(ready) then 1 else 0
					end, {
						seconds = function(use: ComposeTypes.Use): number
							return ctx.motionTiming("reveal", use).enter
						end,
						ease = ctx.motionEase("fade"),
						reducedMotion = motion.reduced(ctx),
					})
					local color = ctx.observeStyled.BackgroundColor3(surface or (row :: GuiObject))
					ctx.runtime.decorate(node, {
						ImageTransparency = function(use: ComposeTypes.Use): number
							return 1 - (1 - (ctx.read(authored, use) or 0)) * use(amount)
						end,
						BackgroundTransparency = if node:IsA("ViewportFrame")
							then nil
							else function(use: ComposeTypes.Use): number
								return background * use(amount)
							end,
						BackgroundColor3 = if node:IsA("ViewportFrame")
							then nil
							else function(use: ComposeTypes.Use): Color3
								local progress = use(amount)
								local target = backgroundColor
								local placeholder = use(color)
								if background >= 1 then
									return if progress < 1 then placeholder else target
								end
								return placeholder:Lerp(target, progress)
							end,
					})
				end)
			end)
		end)
	end
	ctx.runtime.connect(node, "AncestryChanged", locate)
	locate()
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="133">
            <Properties>
              <string name="Name">media_shared</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Theme = require("./theme_types")
local ComposeTypes = require("../vendor/compose/core")
local bindThemes = require("./themes")

export type Shared = {
	skin: (node: GuiObject, slot: string, options: Theme.SkinOptions?) -> GuiObject,
	bind: <T>(source: Types.Value<T>?, fallback: T) -> Types.Value<T>,
}

return function(ctx: Types.Context): Shared
	local runtime, Compose = ctx.runtime, ctx.Compose
	local themes = bindThemes(Compose)
	local types, read = ctx.types, ctx.read
	local function skin(node: GuiObject, slot: string, options: Theme.SkinOptions?): GuiObject
		local package = ctx.config.theme
		if not Compose.isReadable(package) and type(package) ~= "function" then
			local resolved = read(package)
			local recipe = if resolved then (resolved.chrome or {})[slot] else nil
			if recipe == nil or ((recipe.kind == "native" or recipe.kind == "none") and recipe.shadow == nil) then
				return node
			end
		end
		local settings: Theme.SkinOptions = options or {}
		settings.types, settings.target = types, node
		runtime.mount(function()
			return themes.skin(runtime, ctx.config.theme, slot, settings)
		end, node)
		return node
	end

	local function bind<T>(source: Types.Value<T>?, fallback: T): Types.Value<T>
		if not Compose.isReadable(source) and type(source) ~= "function" then
			return if source == nil then fallback else source :: T
		end
		local live = source :: Types.Value<T>
		return function(use: ComposeTypes.Use)
			local value = read(live, use)
			return if value == nil then fallback else value
		end
	end
	return { skin = skin, bind = bind }
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="134">
            <Properties>
              <string name="Name">media_skeleton</string>
              <string name="Source"><![CDATA[--!strict
local reducedMotion = require("./motion").reduced
local Types = require("./types")
local Engine = require("./engine_types")
local ComposeTypes = require("../vendor/compose/core")
local ControlTypes = require("./control_types")
local MediaProps = require("./media_props")

return function(ctx: Types.Context, UI: ControlTypes.Controls)
	local Host, runtime, Compose = ctx.Host, ctx.runtime, ctx.Compose
	local types, read = ctx.types, ctx.read
	local E, D2, D, V2 = types.Enum, types.UDim2, types.UDim, types.Vector2
	local metric, controlSize = ctx.metric, ctx.controlSize
	local skeletonClock = Compose.createSharedResource(function(): (Types.Playback, (() -> ())?)
		local clock = runtime.timeline({ duration = ctx.metric("motion.durations.spinnerLoop"), repeats = math.huge })
		local motionReduced = reducedMotion(ctx)
		Compose.watch(function(use: ComposeTypes.Use)
			if motionReduced(use) then
				clock:pause()
			else
				clock:play()
			end
		end)
		return clock, nil
	end)
	UI.Skeleton = ctx.construct("Skeleton", function(spec: MediaProps.SkeletonProps): Frame
		local form = spec.form or "box"
		assert(form == "box" or form == "circle" or form == "line", "Facet Skeleton invalid form")
		assert(spec.lines == nil or form == "line", "Facet Skeleton lines require line form")
		assert(spec.corners == nil or form ~= "circle", "Facet Skeleton circle owns its corners")
		local count = spec.lines or 1
		assert(count >= 1 and count % 1 == 0, "Facet Skeleton lines must be positive")
		local clock = skeletonClock()
		local motionReduced = reducedMotion(ctx)
		local rows: { ComposeTypes.Child } = {}
		for index = 1, count do
			local native: Engine.FrameNativeProps = {
				Name = "Placeholder" .. index,
				Size = function(use: ComposeTypes.Use)
					local pixels = controlSize(spec.controlSize, if form == "line" then "iconSize" else "height", use)
					return if form == "circle"
						then D2.fromOffset(pixels, pixels)
						else D2.new(if count > 1 and index == count then 0.6 else 1, 0, 0, pixels)
				end,
				Host.UIGradient "Shimmer" {
					Enabled = function(use: ComposeTypes.Use)
						return not motionReduced(use)
					end,
					Offset = function(use: ComposeTypes.Use)
						return V2.new(use(clock.progress) * 2 - 1, 0)
					end,
					Transparency = types.NumberSequence.new({
						types.NumberSequenceKeypoint.new(0, 0.4),
						types.NumberSequenceKeypoint.new(0.5, 0),
						types.NumberSequenceKeypoint.new(1, 0.4),
					}),
				},
			}
			if form == "circle" then
				native[#native + 1] = Host.UICorner({ CornerRadius = ctx.round })
			elseif spec.corners then
				native[#native + 1] = Host.UICorner({
					CornerRadius = function(use: ComposeTypes.Use)
						local value = read(spec.corners, use)
						if value == "pill" then
							return D.new(1, 0)
						end
						if value == "square" then
							return D.new(0, 0)
						end
						if value == "rounded" or value == "control" then
							return D.new(0, metric("radii.control", use))
						end
						if value == "panel" then
							return D.new(0, metric("radii.panel", use))
						end
						assert(type(value) == "number" and value >= 0, "Facet Skeleton invalid corners")
						return D.new(0, value)
					end,
				})
			end
			table.insert(rows, ctx.styled(Host.Frame(native), "skeleton"))
		end
		return ctx.column(
			rows,
			ctx.props(
				spec,
				{ "form", "lines", "controlSize", "corners" },
				{ Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y }
			)
		)
	end)
end
]]></string>
            </Properties>
