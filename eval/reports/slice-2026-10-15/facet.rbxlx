              <Item class="ModuleScript" referent="317">
                <Properties>
                  <string name="Name">engine</string>
                  <string name="Source"><![CDATA[--!strict
--!nolint DeprecatedApi

export type Connection = {
	Disconnect: (self: Connection) -> (),
}

export type Destroyable = {
	Destroy: (self: Destroyable) -> (),
}

export type Signal<Args... = ...unknown> = {
	Connect: (self: Signal<Args...>, handler: (Args...) -> ()) -> Connection,
}

export type Vector2 = { X: number, Y: number }
export type Vector3 = { X: number, Y: number, Z: number }
export type Color3 = { R: number, G: number, B: number }
export type UDim = { Scale: number, Offset: number }
export type UDim2 = { X: UDim, Y: UDim }
export type CFrame = { GetComponents: (self: CFrame) -> ...number }
export type Instance = {
	ClassName: string,
	Name: string,
	Parent: unknown,
	Destroy: (self: Instance) -> (),
	SetAttribute: (self: Instance, name: string, value: unknown) -> (),
	GetPropertyChangedSignal: (self: Instance, name: string) -> Signal<()>,
}
export type PropertyObservable = { GetPropertyChangedSignal: (self: PropertyObservable, name: string) -> Signal<()> }
export type DataModel = { GetService: (self: DataModel, name: string) -> { Heartbeat: Signal<number> } }

export type Engine = {
	new: (className: string) -> Instance,
	heartbeat: Signal<number>,
	clock: () -> number,
	typeName: (value: unknown) -> string,
	destroy: (object: unknown) -> (),
	propertyChanged: (object: unknown, property: string) -> Signal<()>,

	datatypes: {
		Vector2: ((x: number, y: number) -> Vector2)?,
		Vector3: ((x: number, y: number, z: number) -> Vector3)?,
		Color3: ((r: number, g: number, b: number) -> Color3)?,
		UDim: ((scale: number, offset: number) -> UDim)?,
		UDim2: ((xScale: number, xOffset: number, yScale: number, yOffset: number) -> UDim2)?,
		CFrame: ((position: Vector3, rotation: { number }) -> CFrame)?,
	},
	readCFrame: ((value: CFrame) -> (number, number, number, { number }))?,
}

type Library<F> = { new: F }

type Globals = {
	Instance: Library<(className: string) -> Instance>?,
	game: DataModel?,
	typeof: (value: unknown) -> string,
	Vector2: Library<(x: number, y: number) -> Vector2>?,
	Vector3: Library<(x: number, y: number, z: number) -> Vector3>?,
	Color3: Library<(r: number, g: number, b: number) -> Color3>?,
	UDim: Library<(scale: number, offset: number) -> UDim>?,
	UDim2: Library<(xScale: number, xOffset: number, yScale: number, yOffset: number) -> UDim2>?,
	CFrame: Library<(...number) -> CFrame>?,
	task: { cancel: unknown }?,
	os: typeof(os),
}

local function environment(): Globals
	return ((getfenv and getfenv(0) or {}) :: unknown) :: Globals
end

local function ambient(): Engine
	local globals = environment()
	local instances = globals.Instance
	local dataModel = globals.game

	if instances == nil or dataModel == nil then
		error(
			"ComposeRoblox: the Roblox engine is not present. This adapter only runs inside Roblox; "
				.. "pass an engine explicitly to ComposeRoblox.createHost(engine) to run it anywhere else.",
			0
		)
	end

	local runService = dataModel:GetService "RunService"
	local typeName = globals.typeof
	local vector2 = globals.Vector2
	local vector3 = globals.Vector3
	local color3 = globals.Color3
	local udim = globals.UDim
	local udim2 = globals.UDim2
	local cframe = globals.CFrame

	return {
		new = function(className: string): Instance
			return instances.new(className)
		end,
		heartbeat = runService.Heartbeat,
		clock = globals.os.clock,
		typeName = typeName,
		destroy = function(object: unknown)
			(object :: Destroyable):Destroy()
		end,
		propertyChanged = function(object: unknown, property: string): Signal<()>
			return (object :: PropertyObservable):GetPropertyChangedSignal(property)
		end,
		datatypes = {
			Vector2 = if vector2 ~= nil then vector2.new else nil,
			Vector3 = if vector3 ~= nil then vector3.new else nil,
			Color3 = if color3 ~= nil then color3.new else nil,
			UDim = if udim ~= nil then udim.new else nil,
			UDim2 = if udim2 ~= nil then udim2.new else nil,
			CFrame = if cframe ~= nil
				then function(position: Vector3, rotation: { number }): CFrame
					local coordinates = (position :: unknown) :: { x: number, y: number, z: number }
					return cframe.new(coordinates.x, coordinates.y, coordinates.z, table.unpack(rotation))
				end
				else nil,
		},
		readCFrame = if cframe ~= nil
			then function(value: CFrame): (number, number, number, { number })
				local components = { value:GetComponents() }
				return components[1],
					components[2],
					components[3],
					{
						components[4],
						components[5],
						components[6],
						components[7],
						components[8],
						components[9],
						components[10],
						components[11],
						components[12],
					}
			end
			else nil,
	}
end

local function cancelThread(thread: thread): boolean
	local scheduler = environment().task
	if scheduler == nil or type(scheduler.cancel) ~= "function" then
		return false
	end
	return (pcall(scheduler.cancel :: (thread: thread) -> (), thread))
end

return {
	ambient = ambient,
	cancelThread = cancelThread,
}
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="318">
                <Properties>
                  <string name="Name">host</string>
                  <string name="Source"><![CDATA[--!strict

local Compose = require "../core"
local Engine = require "./engine"

type Node = Compose.Node

type DefaultCache = { [string]: unknown }

local function createHost(engine: Engine.Engine): Compose.Host
	local defaults: DefaultCache = {}
	local unsampleable: { [string]: true } = {}

	local classified: { [string]: { [string]: Compose.KeyKind } } = {}

	local function readClassName(node: Node): string
		return (node :: Engine.Instance).ClassName
	end

	local function readMember(node: Node, key: string): unknown
		return (node :: { [string]: unknown })[key]
	end

	local function hasConnectMethod(value: unknown): boolean
		return type((value :: { Connect: unknown }).Connect) == "function"
	end

	local function classNameOf(node: Node): string
		local ok, name = pcall(readClassName, node)
		if ok and type(name) == "string" then
			return name
		end
		return "<unknown class>"
	end

	local function defaultFor(node: Node, key: string): unknown
		local class = classNameOf(node)
		local cacheKey = class .. "." .. key
		local cached = defaults[cacheKey]
		if cached ~= nil then
			return cached
		end
		if unsampleable[class] then
			return nil
		end

		local ok, sample = pcall(engine.new, class)
		if not ok then
			unsampleable[class] = true
			return nil
		end
		local readOk, value = pcall(readMember, sample, key)
		pcall(engine.destroy, sample)
		if not readOk then
			return nil
		end
		defaults[cacheKey] = value
		return value
	end

	local function createNode(kind: string): Node
		return engine.new(kind)
	end

	local function setProperty(node: Node, key: string, value: unknown)
		(node :: { [string]: unknown })[key] = value
	end

	local function writeAttribute(node: Node, name: string, value: unknown): boolean
		(node :: Engine.Instance):SetAttribute(name, value)
		return true
	end

	local function setAttribute(node: Node, name: string, value: unknown): (boolean, string?)
		local ok, result = pcall(writeAttribute, node, name, value)
		if ok then
			return true, nil
		end
		return false, tostring(result)
	end

	local function clearProperty(node: Node, key: string)
		local default = defaultFor(node, key)
		if default == nil then
			return
		end
		(node :: { [string]: unknown })[key] = default
	end

	local function insertChild(parent: Node, child: Node, _position: number?)
		(child :: Engine.Instance).Parent = parent
	end

	local function removeChild(_parent: Node, child: Node)
		if (child :: Engine.Instance).Parent ~= nil then
			(child :: Engine.Instance).Parent = nil
		end
	end

	local function destroyNode(node: Node)
		engine.destroy(node)
	end

	local function connectEvent<Args...>(node: Node, event: string, handler: (Args...) -> ()): Compose.Unsubscribe
		local read, found = pcall(function(): unknown
			return (node :: { [string]: unknown })[event]
		end)
		local signal = (if read then found else nil) :: Engine.Signal<Args...>?
		if signal == nil or type(signal.Connect) ~= "function" then
			error(
				Compose.formatDiagnostic(
					"host/not-an-event",
					("%s has no event named %s"):format(classNameOf(node), event),
					{
						event = event,
						node = classNameOf(node),
						contract = "an event key must name something the object can be subscribed to",
						fix = "check the spelling, or use Compose.property(name) if it is a property",
					}
				),
				0
			)
		end

		local connection = signal:Connect(handler)
		local disconnected = false
		return function()
			if disconnected then
				return
			end
			disconnected = true
			connection:Disconnect()
		end
	end

	local function classifyKey(node: Node, key: string): Compose.KeyKind
		local class = classNameOf(node)
		local byKey = classified[class]
		if byKey ~= nil then
			local known = byKey[key]
			if known ~= nil then
				return known :: Compose.KeyKind
			end
		end

		local kind: Compose.KeyKind = "property"
		local ok, value = pcall(readMember, node, key)
		if ok and value ~= nil then
			local connectOk, hasConnect = pcall(hasConnectMethod, value)
			if connectOk and hasConnect then
				kind = "event"
			end
		end

		if class ~= "<unknown class>" then
			if byKey == nil then
				local created: { [string]: Compose.KeyKind } = {}
				classified[class] = created
				byKey = created
			end
			byKey[key] = kind
		end
		return kind
	end

	local function readProperty(node: Node, key: string): unknown
		return (node :: { [string]: unknown })[key]
	end

	local function observeProperty(node: Node, key: string, listener: () -> ()): Compose.Unsubscribe
		local connection = engine.propertyChanged(node, key):Connect(listener)
		local disconnected = false
		return function()
			if disconnected then
				return
			end
			disconnected = true
			connection:Disconnect()
		end
	end

	local function onFrame(listener: (delta: number) -> ()): Compose.Unsubscribe
		local connection = engine.heartbeat:Connect(listener)
		local disconnected = false
		return function()
			if disconnected then
				return
			end
			disconnected = true
			connection:Disconnect()
		end
	end

	return {
		name = "roblox",
		render = {
			createNode = createNode,
			setProperty = setProperty,
			setAttribute = setAttribute,
			clearProperty = clearProperty,
			insertChild = insertChild,
			removeChild = removeChild,
			destroyNode = destroyNode,
		},
		events = {
			connectEvent = connectEvent,
			classifyKey = classifyKey,
		},
		observation = {
			readProperty = readProperty,
			observeProperty = observeProperty,
		},
		naming = {
			setName = function(node: Node, label: string)
				(node :: Engine.Instance).Name = label
			end,
		},
		frames = {
			onFrame = onFrame,
			now = engine.clock,
		},
		describeNode = function(node: Node): string
			local ok, name = pcall(function()
				return ("%s %q"):format((node :: Engine.Instance).ClassName, (node :: Engine.Instance).Name)
			end)
			return if ok then name else tostring(node)
		end,
		typeNameOf = function(value: unknown): string
			return engine.typeName(value)
		end,
	}
end

return {
	createHost = createHost,
}
]]></string>
                </Properties>
