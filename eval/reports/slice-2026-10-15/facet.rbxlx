	ref: typeof(frame.ref),
	selection: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, V>).selection),
	selectionFrom: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, V>).selectionFrom),
	selectionIndicator: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, V>).selectionIndicator),
	selectionMode: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, V>).selectionMode),
	selectable: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, V>).selectable),
	disabled: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, V>).disabled),
	onSelectionChange: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, V>).onSelectionChange),
	editing: typeof(((nil :: unknown) :: Collections.SelectionOptions<V, V>).editing),
	collectionId: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, V>).collectionId),
	drag: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, V>).drag),
	drop: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, V>).drop),
	rowDrop: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, V>).rowDrop),
	reorderable: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, V>).reorderable),
	movable: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, V>).movable),
	onReorder: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, V>).onReorder),
	deletable: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, V>).deletable),
	rowDeletable: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, V>).rowDeletable),
	onDelete: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, V>).onDelete),
	dragLabel: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, V>).dragLabel),
	autoscroll: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, V>).autoscroll),
	direction: typeof(((nil :: unknown) :: Collections.ReorderOptions<V, V>).direction),
	expanded: typeof(((nil :: unknown) :: Collections.HierarchyOptions<V, V>).expanded),
	onExpansionChange: typeof(((nil :: unknown) :: Collections.HierarchyOptions<V, V>).onExpansionChange),
	indent: typeof(((nil :: unknown) :: Collections.HierarchyOptions<V, V>).indent),
	focusPolicy: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).focusPolicy),
	initialFocus: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).initialFocus),
	autoFocus: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).autoFocus),
	wrapFocus: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).wrapFocus),
	maxRetained: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).maxRetained),
	onReachEnd: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).onReachEnd),
	from: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).from),
	columns: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).columns),
	itemSize: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).itemSize),
	gap: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).gap),
	overscan: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).overscan),
	sort: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).sort),
	onSortChange: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).onSortChange),
	widths: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).widths),
	onWidthsChange: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).onWidthsChange),
	onActivate: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).onActivate),
	rowActions: ((current: Compose.Readable<V>, key: V) -> RowActionsOptions?)?,
	headerHeight: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).headerHeight),
	header: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).header),
	status: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).status),
	controls: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).controls),
	focus: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).focus),
	measure: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).measure),
	measured: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).measured),
	follow: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).follow),
	followThreshold: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).followThreshold),
	reducedMotion: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).reducedMotion),
	onCellChange: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).onCellChange),
	alternatingRows: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).alternatingRows),
	scrolls: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).scrolls),
	mode: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).mode),
	snap: typeof(((nil :: unknown) :: Collections.TableOptions<V, V>).snap),
	children: typeof(((nil :: unknown) :: Collections.OptionalChildren<V>).children),
	key: typeof(identity.key),
	[number | Engine.EventKey]: Compose.Child,
}
export type CollectionSpec<V, K> = KeyedCollectionSpec<V, K> | IdentityCollectionSpec<V>
export type OutlineSpec<V, K> = KeyedOutlineSpec<V, K> | IdentityOutlineSpec<V>
export type TableSpec<V, K> = KeyedTableSpec<V, K> | IdentityTableSpec<V>

return {}
]]></string>
            </Properties>
