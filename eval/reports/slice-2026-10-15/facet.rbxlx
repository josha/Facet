          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">geometry_observation</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")

type Update = { read: () -> (), publish: () -> () }

type Queue = {
	pending: { [Update]: boolean },
	derived: { [Update]: boolean },
	thread: thread?,
	users: number,
	frame: RBXScriptConnection?,
}
local queues: { [ComposeTypes.Runtime]: Queue } = {}

return function(
	Compose: typeof(ComposeTypes),
	runtime: ComposeTypes.Runtime,
	node: Instance,
	property: string,
	beforePaint: RBXScriptSignal?
): ComposeTypes.Cell<unknown>
	local observation = assert(runtime.host.observation)
	local initial: unknown = observation.readProperty(node, property)
	local value = Compose.cell(initial)
	local queue = queues[runtime]
	if queue == nil then
		queue = { pending = {}, derived = {}, users = 0 }
		queues[runtime] = queue
	end
	local held = queue :: Queue
	held.users += 1
	local alive = true
	local snapshot: unknown = initial
	local update: Update = {
		read = function()
			if alive then
				snapshot = observation.readProperty(node, property)
			end
		end,
		publish = function()
			if alive then
				value:set(snapshot)
			end
		end,
	}
	local function flush()
		if held.thread then
			task.cancel(held.thread)
			held.thread = nil
		end
		local pending = held.pending
		held.pending = {}
		for entry in held.derived do
			pending[entry] = true
		end
		for entry in pending do
			entry.read()
		end
		runtime.reactor:batch(function()
			for entry in pending do
				entry.publish()
			end
		end)
	end
	if beforePaint and held.frame == nil then
		held.frame = beforePaint:Connect(flush)
	end
	if beforePaint and (property == "TextBounds" or property == "AbsoluteSize" or property == "AbsoluteWindowSize") then
		held.derived[update] = true
	end
	local function refresh()
		if not alive then
			return
		end
		if held.frame or (task and task.defer) then
			held.pending[update] = true
			if held.frame == nil and held.thread == nil then
				held.thread = task.defer(function()
					held.thread = nil
					flush()
				end)
			end
		else
			update.read()
			update.publish()
		end
	end
	local stop = observation.observeProperty(node, property, refresh)
	if held.frame or (task and task.defer) then
		refresh()
	end
	Compose.cleanup(function()
		alive = false
		stop()
		held.pending[update] = nil
		held.derived[update] = nil
		held.users -= 1
		if next(held.pending) == nil and held.thread then
			task.cancel(held.thread)
			held.thread = nil
		end
		if held.users == 0 then
			if held.frame then
				held.frame:Disconnect()
			end
			queues[runtime] = nil
		end
	end)
	return value
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">gesture_arbitration</string>
              <string name="Source"><![CDATA[--!strict
export type Kind = "pending" | "drag" | "pan" | "scroll" | "press" | "doubleTap" | "cancelled"
export type Options = {
	pickup: ("immediate" | "longPress")?,
	axis: ("X" | "Y" | "XY")?,
	scroll: boolean?,
	threshold: number?,
}
export type Decision = { owner: GuiObject, origin: Vector2, kind: Kind }
type Contact = Decision & { options: Options }
export type Arbiter = {
	begin: (InputObject, GuiObject, Vector2, Options) -> boolean,
	move: (InputObject, Vector2) -> Kind?,
	claim: (InputObject, GuiObject, Kind) -> boolean,
	get: (InputObject) -> Decision?,
	finish: (InputObject, GuiObject, boolean?) -> Kind?,
	cancelOwner: (GuiObject) -> (),
	capture: (GuiObject, () -> ()) -> (),
	claimCamera: (GuiObject) -> boolean,
}
export type Binding = {
	begin: (InputObject, Vector2, Options) -> boolean,
	move: (InputObject, Vector2) -> Kind?,
	claim: (InputObject, Kind) -> boolean,
	get: (InputObject) -> Decision?,
	finish: (InputObject, boolean?) -> Kind?,
}
local arbitration = {}

function arbitration.new(): Arbiter
	local contacts: { [InputObject]: Contact } = {}
	local arbiter = {} :: Arbiter
	local captureOwner: GuiObject? = nil
	local cameras: { [GuiObject]: boolean } = {}
	function arbiter.begin(pointer: InputObject, owner: GuiObject, origin: Vector2, options: Options): boolean
		local held = contacts[pointer]
		if held and (held.owner == owner or held.kind ~= "pending" or not owner:IsDescendantOf(held.owner)) then
			return held.owner == owner
		end
		local threshold = options.threshold or 6
		assert(threshold > 0 and threshold < math.huge, "Facet gesture threshold must be finite and positive")
		contacts[pointer] = { owner = owner, origin = origin, kind = "pending" :: Kind, options = table.clone(options) }
		return true
	end
	function arbiter.move(pointer: InputObject, position: Vector2): Kind?
		local contact = contacts[pointer]
		if not contact then
			return nil
		end
		if contact.kind ~= "pending" then
			return contact.kind
		end
		local delta = position - contact.origin
		local options = contact.options
		if delta.Magnitude < (options.threshold or 6) then
			return "pending"
		end
		local along = (options.axis ~= "X" or math.abs(delta.X) >= math.abs(delta.Y))
			and (options.axis ~= "Y" or math.abs(delta.Y) >= math.abs(delta.X))
		contact.kind = if options.pickup == "immediate" and along
			then "drag"
			elseif options.scroll then "scroll"
			else "pan"
		return contact.kind
	end
	function arbiter.claim(pointer: InputObject, owner: GuiObject, kind: Kind): boolean
		local contact = contacts[pointer]
		if not contact or contact.owner ~= owner then
			return false
		end
		if contact.kind ~= "pending" then
			return contact.kind == kind
		end
		if kind == "drag" and contact.options.pickup == nil then
			return false
		end
		if kind == "pan" or kind == "scroll" then
			return false
		end
		contact.kind = kind
		return true
	end
	function arbiter.get(pointer: InputObject): Decision?
		local contact = contacts[pointer]
		return if contact then { owner = contact.owner, origin = contact.origin, kind = contact.kind } else nil
	end
	function arbiter.finish(pointer: InputObject, owner: GuiObject, cancelled: boolean?): Kind?
		local contact = contacts[pointer]
		if not contact or contact.owner ~= owner then
			return nil
		end
		contacts[pointer] = nil
		return if cancelled then "cancelled" elseif contact.kind == "pending" then "press" else contact.kind
	end
	function arbiter.capture(owner: GuiObject, callback: () -> ())
		assert(captureOwner == nil, "Facet capture callbacks cannot start another capture")
		captureOwner = owner
		table.clear(cameras)
		local ok, failure = pcall(function(): unknown
			callback()
			return nil
		end)
		captureOwner = nil
		table.clear(cameras)
		if not ok then
			error(failure, 0)
		end
	end
	function arbiter.claimCamera(surface: GuiObject): boolean
		local owner = captureOwner
		if not owner or cameras[surface] then
			return false
		end
		cameras[surface] = true
		return true
	end
	function arbiter.cancelOwner(owner: GuiObject)
		for pointer, contact in contacts do
			if contact.owner == owner then
				contacts[pointer] = nil
			end
		end
	end
	return arbiter
end

return arbitration
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">gesture_service</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local arbitration = require("./gesture_arbitration")
local services = setmetatable({} :: { [UserInputService]: arbitration.Arbiter }, { __mode = "k" })
local fallbacks = setmetatable({} :: { [Types.Context]: arbitration.Arbiter }, { __mode = "k" })

return function(ctx: Types.Context): arbitration.Arbiter
	local input = ctx.config.userInputService
	if input then
		if not services[input] then
			services[input] = arbitration.new()
		end
		return services[input]
	end
	if not fallbacks[ctx] then
		fallbacks[ctx] = arbitration.new()
	end
	return fallbacks[ctx]
end
]]></string>
            </Properties>
