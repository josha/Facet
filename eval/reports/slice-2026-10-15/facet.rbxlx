			end)
			local _, skin = ctx.skin(plate, "field", {
				disabled = function(use: ComposeTypes.Use)
					return not enabled(use)
				end,
			})
			if skin then
				runtime.decorate(skin, {
					Visible = function(use: ComposeTypes.Use): boolean
