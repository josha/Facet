          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">date_time_time</string>
              <string name="Source"><![CDATA[--!strict
local civil = require("./civil_date")
local Shared = require("./types")
local DTP = require("./date_time_picker_types")
local CollectionProps = require("./collection_props")
local NavigationProps = require("./navigation_props")
local ComposeTypes = require("../vendor/compose/core")
local Parts = require("./date_time_parts")
local Options = require("./date_time_options")
local PickerState = require("./date_time_state")
local Calendar = require("./date_time_calendar")

type CivilDate = DTP.CivilDate
type Use = ComposeTypes.Use
type Readable<T> = ComposeTypes.Readable<T>
type TimeRow = { id: string, hour: number, minute: number }

local ROW = Parts.ROW

return function(
	ctx: Shared.Context,
	UI: Parts.Deps,
	options: Options.Options,
	state: PickerState.State,
	calendar: Calendar.Calendar
): () -> Frame
	local Host, Compose = ctx.Host, ctx.Compose
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local draft, minuteStep, hourCycle, clock = options.draft, options.minuteStep, options.hourCycle, options.clock
	local value, anchorDate = state.value, state.anchorDate
	local interactive, propose, commit = state.interactive, state.propose, state.commit
	local downTarget = calendar.downTarget

	local function timeSection(): Frame
		local function base(): CivilDate
			local v = value:peek()
			if v ~= nil and v.hour ~= nil then
				return v
			end
			local d = civil.dateOf(v or anchorDate())
			d.hour, d.minute = 0, 0
			return d
		end
		local function field(
			name: string,
			lo: number,
			hi: number,
			step: number,
			get: (CivilDate) -> number,
			with: (CivilDate, number) -> CivilDate
		): TextBox | Frame
			local text = Compose.cell("")
			local number = Compose.cell(lo)
			Compose.watch(function(use: Use)
				local v = use(value)
				local n = if v ~= nil and v.hour ~= nil then get(v) else lo
				number:set(n)
				text:set(if v ~= nil then string.format("%02d", n) else "")
			end)
			return UI.NumberInput(name)({
				label = name,
				Size = D2.new(0, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
				Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }) :: Shared.Child,
				value = text,
				numericValue = number,
				min = lo,
				max = hi,
				step = step,
				precision = 0,
				stepButtons = true,
				enabled = function(use: Use)
					return interactive(use)
				end,
				format = function(n: number): string
					return string.format("%02d", n)
				end,
				onCommit = function(n: number)
					local v = value:peek()
					if not propose(with(base(), n)) then
						local held = if v ~= nil and v.hour ~= nil then get(v) else lo
						number:set(held)
						text:set(if v ~= nil then string.format("%02d", held) else "")
					elseif not draft then
						commit()
					end
				end,
			})
		end
		local function withHour(d: CivilDate, h: number): CivilDate
			local out = table.clone(d)
			local pm = (d.hour or 0) >= 12
			out.hour = if hourCycle == 12 then (h % 12) + (if pm then 12 else 0) else h
			return out
		end
		local function withMinute(d: CivilDate, m: number): CivilDate
			local out = table.clone(d)
			out.minute = m
			return out
		end
		local hour = field("Hour", if hourCycle == 12 then 1 else 0, if hourCycle == 12 then 12 else 23, 1, function(v)
			local h = v.hour or 0
			return if hourCycle == 12 then (if h % 12 == 0 then 12 else h % 12) else h
		end, withHour)
		local minute = field("Minute", 0, 60 - minuteStep, minuteStep, function(v)
			return v.minute or 0
		end, withMinute)
		downTarget:set(hour:FindFirstChild("Field", true) :: GuiObject?)
		local parts: { Shared.Child } = {}
		if hourCycle == 12 then
			local half = Compose.cell("AM")
			Compose.watch(function(use: Use)
				local v = use(value)
				half:set(if v ~= nil and v.hour ~= nil and v.hour >= 12 then "PM" else "AM")
			end)
			local halfSpec: NavigationProps.SinglePickerSpec<string> = {
				Name = "Half",
				options = { { value = "AM", label = "AM" }, { value = "PM", label = "PM" } },
				selected = half,
				style = "segmented" :: "segmented",
				sizing = "hug" :: "hug",
				Size = D2.fromOffset(0, 0),
				AutomaticSize = E.AutomaticSize.XY,
				enabled = function(use: Use)
					return interactive(use)
				end,
				onChanging = function(word: string): boolean?
					local v = value:peek()
					if v == nil or v.hour == nil then
						return false
					end
					local next = table.clone(v)
					next.hour = (v.hour :: number) % 12 + (if word == "PM" then 12 else 0)
					if not propose(next) then
						return false
					end
					if not draft then
						commit()
					end
					return true
				end,
			}
			table.insert(parts, UI.Picker(halfSpec))
		end
		local fields = ctx.row(
			{ hour, minute },
			{ Name = "Fields", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y }
		)
		assert(fields:FindFirstChildWhichIsA("UIListLayout")).VerticalAlignment = E.VerticalAlignment.Bottom
		local times: { TimeRow } = {}
		for minutes = 0, 24 * 60 - 1, minuteStep do
			table.insert(times, { id = `{minutes // 60}:{minutes % 60}`, hour = minutes // 60, minute = minutes % 60 })
		end
		local list = Compose.show(function(use: Use)
			return state.prefers(E.PreferredInput.Touch, use)
		end, function()
			local at: CivilDate = value:peek() or clock()
			if at.hour == nil then
				at = clock()
			end
			local first = if at.hour ~= nil then (at.hour * 60 + (at.minute or 0)) // minuteStep else 0
			local timesSpec: CollectionProps.KeyedCollectionSpec<TimeRow, string> = {
				Name = "Times",
				LayoutOrder = 2,
				from = times,
				key = "id",
				itemSize = ROW,
				Size = D2.new(1, 0, 0, 4 * ROW),
				CanvasPosition = V2.new(0, first * ROW),
				render = function(row: Readable<TimeRow>): GuiObject
					local t = row:peek()
					return UI.Button({
						Name = "Time",
						label = civil.formatTime(
							{ year = 2000, month = 1, day = 1, hour = t.hour, minute = t.minute },
							hourCycle
						),
						Size = D2.new(1, 0, 0, ROW),
						AutomaticSize = E.AutomaticSize.None,
						enabled = function(use: Use)
							return interactive(use)
						end,
						selected = function(use: Use)
							local v = use(value)
							return v ~= nil and v.hour == t.hour and v.minute == t.minute
						end,
						onActivate = function()
							local next = civil.dateOf(value:peek() or anchorDate())
							next.hour, next.minute = t.hour, t.minute
							if propose(next) and not draft then
								commit()
							end
						end,
					})
				end,
			}
			return UI.VirtualList(timesSpec)
		end)
		table.insert(parts, 1, fields)
		table.insert(parts, list)
		return ctx.column(parts, { Name = "Time", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
	end

	return timeSection
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">drag</string>
              <string name="Source"><![CDATA[--!strict
local Shared = require("./types")
local Env = require("./environment_types")
local activation = require("./activation")
local DragTypes = require("./drag_types")
local sessionOf = require("./drag_session")
local gestureOf = require("./gesture_service")
local Gesture = require("./gesture_arbitration")
local scrollLock = require("./scroll_lock")
local pointerOf = require("./drag_pointer")

return function(ctx: Shared.Context, UI: Env.EnvironmentControls)
	local Compose, Host, E = ctx.Compose, ctx.Host, ctx.types.Enum
	local service = sessionOf(ctx)
	local arbiter = gestureOf(ctx)
	UI.gestureArbiter = function(surface: GuiObject): Gesture.Binding
		assert(Compose.currentOwner() ~= nil, "Facet UI.gestureArbiter must run inside a Compose owner")
		Compose.cleanup(function()
			arbiter.cancelOwner(surface)
		end)
		return {
			begin = function(pointer, position, options)
				return arbiter.begin(pointer, surface, position, options)
			end,
			move = arbiter.move,
			claim = function(pointer, kind)
				return arbiter.claim(pointer, surface, kind)
			end,
			get = arbiter.get,
			finish = function(pointer, cancelled)
				return arbiter.finish(pointer, surface, cancelled)
			end,
		}
	end
	local input, gui = ctx.config.userInputService, ctx.config.guiService
	local function keyActivation(node: GuiObject, callback: () -> boolean): boolean
		if not activation.marked(node) then
			return false
		end
		Compose.cleanup(activation.intercept(node, function(value: unknown): boolean
			local kind = if value then (value :: InputObject).UserInputType else nil
			if kind == E.UserInputType.MouseButton1 or kind == E.UserInputType.Touch then
				return false
			end
			return callback()
		end))
		return true
	end
	UI.draggable = function(source: GuiObject, spec: Env.DraggableSpec)
		assert(Compose.currentOwner() ~= nil, "Facet UI.draggable must run inside a component or Compose owner")
		assert(spec.payload ~= nil, "Facet UI.draggable needs a payload")
		assert(
			spec.touchPickup == nil or spec.touchPickup == "longPress" or spec.touchPickup == "immediate",
			"Facet UI.draggable touchPickup must be longPress or immediate"
		)
		assert(
			spec.touchDragAxis == nil
				or spec.touchDragAxis == "X"
				or spec.touchDragAxis == "Y"
				or spec.touchDragAxis == "XY",
			"Facet UI.draggable touchDragAxis must be X, Y or XY"
		)
		service.own(source)
		local pressed: InputObject? = nil
		local origin: Vector2? = nil
		local active, dragged = false, false
		local scrolling = false
		local eligible: boolean? = nil
		local releaseScrollers: (() -> ())? = nil
		local function held(): boolean
			local current = service.state:peek()
			return current ~= nil and current.source == source
		end
		local function activateTap(): boolean
			local target: Instance? = source
			while target and target:IsA("GuiObject") do
				if activation.trigger(target, pressed, 1) then
					return true
				end
				if target:IsA("GuiButton") then
					return false
				end
				target = target.Parent
			end
			return false
		end
		local function enabled(use: Shared.Use?): boolean
			return spec.enabled == nil or ctx.read(spec.enabled, use) == true
		end
		local function unlock()
			if releaseScrollers then
				releaseScrollers()
				releaseScrollers = nil
			end
		end
		local ownedSpec = table.clone(spec) :: DragTypes.SourceSpec
		ownedSpec.valid = function()
			return enabled(nil) and (spec.valid == nil or spec.valid())
		end
		ownedSpec.onEnd = function(accepted, reason)
			active = false
			unlock()
			if spec.onEnd then
				spec.onEnd(accepted, reason)
			end
		end
		local function begin(mode: "pointer" | "armed")
			service.begin(
				source,
				ownedSpec,
				mode,
				pressed,
				nil,
				if origin then { position = origin, source = source } else nil
			)
			active = held()
			if not active then
				unlock()
			end
			dragged = true
		end
		local function lock()
			if not releaseScrollers then
				releaseScrollers = scrollLock.holdAncestors(source)
			end
		end
		local function contact(position: Vector2): Vector2
			return if pressed and pressed.UserInputType == E.UserInputType.Touch
				then ctx.types.Vector2.new(pressed.Position.X, pressed.Position.Y)
				else position
		end
		local detector = Host.UIDragDetector({
			Name = "FacetDragDetector",
			DragStyle = E.UIDragDetectorDragStyle.TranslatePlane,
			ResponseStyle = E.UIDragDetectorResponseStyle.CustomOffset,
			Enabled = function(use)
				return enabled(use) and ctx.effectiveInput()(use) ~= "Touch"
			end,
			DragStart = function(position)
				origin = if eligible == false then nil else pointerOf(ctx, position)
			end,
			DragContinue = function(position)
				position = pointerOf(ctx, position)
				if not active and origin and (position - origin).Magnitude >= 6 and enabled(nil) then
					local touch = pressed ~= nil and pressed.UserInputType == E.UserInputType.Touch

					if not touch and (pressed == nil or arbiter.move(pressed, position) == "drag") then
						lock()
						begin("pointer")
					end
				end
				if active then
					service.update(position)
				end
			end,
			DragEnd = function(position)
				if pressed then
					arbiter.finish(pressed, source, pressed.UserInputState == E.UserInputState.Cancel)
				end
				position = pointerOf(ctx, position)
				local tap = origin ~= nil and not dragged and (position - origin).Magnitude < 6
				origin = nil
				if active then
					service.update(position)
					service.commit(nil)
				elseif tap and enabled(nil) then
					if activateTap() then
						activation.consume(pressed)
					end
				end
			end,
		})
		detector.Parent = source
		ctx.runtime.connect(source, "InputBegan", function(value: InputObject)
			if value.UserInputType == E.UserInputType.MouseButton1 or value.UserInputType == E.UserInputType.Touch then
				if active then
					return
				end
				eligible = false
				local at = ctx.types.Vector2.new(value.Position.X, value.Position.Y)
				local hit = spec.hitArea or source
				local offset, size = at - hit.AbsolutePosition, hit.AbsoluteSize
				if spec.hitArea and (offset.X < 0 or offset.Y < 0 or offset.X >= size.X or offset.Y >= size.Y) then
					return
				end
				if
					not enabled(nil)
					or not arbiter.begin(value, source, at, {
						pickup = if value.UserInputType == E.UserInputType.Touch
							then spec.touchPickup or "longPress"
							else "immediate",
						axis = spec.touchDragAxis or "XY",
						scroll = source:FindFirstAncestorWhichIsA("ScrollingFrame") ~= nil,
					})
				then
					return
				end
				eligible = true
				activation.release(value)
				pressed, dragged, scrolling = value, false, false
				origin = at
			end
		end)
		ctx.runtime.connect(source, "TouchLongPress", function(positions: { Vector2 }, phase: Enum.UserInputState)
			if phase ~= E.UserInputState.Begin or not enabled(nil) or active or spec.touchPickup == "immediate" then
				return
			end
			if not pressed or not arbiter.claim(pressed, source, "drag") then
				return
			end
			lock()
			begin("pointer")
			if positions[1] then
				service.update(contact(pointerOf(ctx, positions[1])))
			end
		end)
		if input then
			ctx.runtime.connect(input, "InputBegan", activation.release)
			ctx.runtime.connect(input, "InputChanged", function(value: InputObject)
				local touch = value == pressed and value.UserInputType == E.UserInputType.Touch
				local mouse = pressed ~= nil
					and pressed.UserInputType == E.UserInputType.MouseButton1
					and value.UserInputType == E.UserInputType.MouseMovement
				if not touch and not mouse then
					return
				end
				local position = ctx.types.Vector2.new(value.Position.X, value.Position.Y)
				local kind = arbiter.move(assert(pressed), position)
				if not active and kind == "drag" and enabled(nil) then
					lock()
					begin("pointer")
				elseif kind == "scroll" or kind == "pan" then
					scrolling = true
				end
				if active then
					service.update(position)
				end
			end)
			ctx.runtime.connect(input, "InputEnded", function(value: InputObject)
				if value == pressed then
					arbiter.finish(value, source, value.UserInputState == E.UserInputState.Cancel)
				end
				if value == pressed and value.UserInputState == E.UserInputState.Cancel then
					origin, eligible = nil, false
					dragged, scrolling = true, true
					activation.consume(value)
					if held() then
						service.finish(false, "Cancelled")
					end
				end
				if active and value == pressed then
					if value.UserInputType == E.UserInputType.Touch then
						service.update(ctx.types.Vector2.new(value.Position.X, value.Position.Y))
					end
					service.commit(nil)
				end
				if
					value == pressed
					and spec.armOnTap
					and value.UserInputState ~= E.UserInputState.Cancel
					and value.UserInputType == E.UserInputType.Touch
					and not dragged
					and not scrolling
					and not active
					and service.state:peek() == nil
				then
					begin("armed")
				end
			end)
			ctx.runtime.connect(input, "WindowFocusReleased", function()
				arbiter.cancelOwner(source)
				pressed = nil
				if held() then
					service.finish(false, "Window lost focus")
				end
			end)
		end
		local selected = if gui then ctx.observe.SelectedObject(gui) else nil
		if selected then
			Compose.watch(function(use)
				local target = use(selected)
				local current = service.state:peek()
				if current and current.source == source and current.mode == "armed" then
					service.hover(service.targetOf(target), nil)
				end
			end)
		end
		local function pickUp(): boolean
			if service.state:peek() ~= nil or not enabled(nil) then
				return false
			end
			begin("armed")
			return true
		end
		if not keyActivation(source, pickUp) then
			ctx.action(source, "DragPickUp", { E.KeyCode.Return, E.KeyCode.ButtonA }, function(use)
				local node = if selected then use(selected) else nil
				return use(service.state) == nil
					and enabled(use)
					and node ~= nil
					and (node == source or node:IsDescendantOf(source))
			end, pickUp, { priority = 250 })
		end
		ctx.action(source, "DragCancel", { E.KeyCode.Escape, E.KeyCode.ButtonB }, function(use)
			local current = use(service.state)
			return current ~= nil and current.source == source
		end, function()
			service.finish(false, "Cancelled")
		end, { priority = 250 })
		Compose.cleanup(function()
			arbiter.cancelOwner(source)
			if held() then
				service.finish(false, "The source was removed")
			end
			unlock()
		end)
	end
	UI.dropTarget = function(target: Env.DropDestination, spec: Env.DropTargetSpec)
		assert(Compose.currentOwner() ~= nil, "Facet UI.dropTarget must run inside a component or Compose owner")
		assert(type(spec.onDrop) == "function", "Facet UI.dropTarget needs onDrop")
		service.register(target, (spec :: unknown) :: DragTypes.TargetSpec)
		local focusTarget = spec.focusTarget or (if target:IsA("GuiObject") then target else nil)
		if not focusTarget then
			return
		end
		local function drop(): boolean
			local current = service.state:peek()
			if not current or current.mode ~= "armed" then
				return false
			end
			service.commit(target)
			return true
		end
		ctx.runtime.connect(focusTarget, "InputBegan", function(value: InputObject)
			if value.UserInputType == E.UserInputType.MouseButton1 or value.UserInputType == E.UserInputType.Touch then
				if drop() then
					activation.consume(value)
				end
			end
		end)
		if not keyActivation(focusTarget, drop) then
			local selected = if gui then ctx.observe.SelectedObject(gui) else nil
			ctx.action(focusTarget, "DragDrop", { E.KeyCode.Return, E.KeyCode.ButtonA }, function(use)
				local current = use(service.state)
				return current ~= nil and current.mode == "armed" and selected ~= nil and use(selected) == focusTarget
			end, drop, { priority = 250 })
		end
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">drag_pointer</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")

return function(_ctx: Types.Context, position: Vector2): Vector2
	return position
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">drag_session</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local EngineTypes = require("./engine_types")
local Drag = require("./drag_types")
local Env = require("./environment_types")
local activation = require("./activation")
local motion = require("./motion")
local travel = require("./drag_travel")
local gestureOf = require("./gesture_service")
local services = setmetatable({} :: { [Types.Context]: Drag.Service }, { __mode = "kv" })

return function(ctx: Types.Context): Drag.Service
	if services[ctx] then
		return services[ctx]
	end
	local Compose, V2, D2 = ctx.Compose, ctx.types.Vector2, ctx.types.UDim2
	local targets: { [Instance]: Drag.RegisteredTarget } = {}
	local proxies: { [Instance]: Instance } = {}
	local current: Drag.Session? = nil
	local returning: { [Instance]: () -> () } = {}
	local state = Compose.cell(nil :: Drag.Session?)
	local service = { state = state } :: Drag.Service
	services[ctx] = service

	local function ancestor(node: Instance?): Instance?
		while node do
			local target = proxies[node] or node
			local spec = targets[target]
			local pass = current and spec and spec.passThrough and spec.passThrough(current.payload)
			if current and spec and spec.collectionAxis and current.mode == "pointer" and current.position then
				local axis = spec.collectionAxis
				local gui = target :: GuiObject
				local extent = if axis == "X" then gui.AbsoluteSize.X else gui.AbsoluteSize.Y
				local offset = if axis == "X"
					then current.position.X - gui.AbsolutePosition.X
					else current.position.Y - gui.AbsolutePosition.Y
				local parent = target.Parent
				while parent and not targets[parent] do
					parent = parent.Parent
				end
				pass = pass or (parent ~= nil and (offset < extent * 0.25 or offset > extent * 0.75))
			end
			if spec and not pass then
				return target
			end
			node = node.Parent
		end
		return nil
	end
	local function available(node: Instance): boolean
		if node.Parent == nil then
			return false
		end
		local at: Instance? = node
		while at do
			if at:IsA("GuiObject") and not at.Visible then
				return false
			elseif at:IsA("ScreenGui") and not at.Enabled then
				return false
			end
			at = at.Parent
		end
		return true
	end
	local function contains(node: GuiObject, at: Vector2): boolean
		local origin = node.AbsolutePosition
		local size = if node:IsA("ScrollingFrame") then node.AbsoluteWindowSize else node.AbsoluteSize
		return at.X >= origin.X and at.Y >= origin.Y and at.X <= origin.X + size.X and at.Y <= origin.Y + size.Y
	end
	local function hitTest(at: Vector2): (Instance?, RaycastResult?)
		local source = (current :: Drag.Session).source
		local playerGui = source:FindFirstAncestorWhichIsA("BasePlayerGui")
		local players = ctx.config.services.Players
		if playerGui == nil and players and players.LocalPlayer then
			playerGui = players.LocalPlayer:FindFirstChildWhichIsA("PlayerGui")
		end
		if playerGui then
			for _, node in (playerGui :: PlayerGui):GetGuiObjectsAtPosition(at.X, at.Y) do
				local excluded, pass = false, node:GetAttribute("FacetDropPassThrough") == true
				local parent: Instance? = node
				while parent do
					if parent:GetAttribute("FacetDragFeedback") == true then
						excluded = true
						break
					end
					parent = parent.Parent
				end
				if not excluded and available(node) then
					local target = ancestor(node)
					if target then
						return target, nil
					end
					if
						not pass
						and (
							node.Active
							or node:IsA("GuiButton")
							or node:IsA("TextBox")
							or (node:GetStyled("BackgroundTransparency") :: number) < 1
						)
					then
						return nil, nil
					end
				end
			end
		else
			local best: GuiObject? = nil
			for target in targets do
				if
					target:IsA("GuiObject")
					and available(target)
					and contains(target, at)
					and ancestor(target) == target
				then
					local clipped = false
					local parent = target.Parent
					while parent do
						if parent:IsA("GuiObject") and parent.ClipsDescendants and not contains(parent, at) then
							clipped = true
							break
						end
						parent = parent.Parent
					end
					if not clipped and (best == nil or target:IsDescendantOf(best) or target.ZIndex > best.ZIndex) then
						best = target
					end
				end
			end
			if best then
				return best, nil
			end
		end
		local workspace = ctx.config.services.Workspace
		local camera = if workspace then workspace.CurrentCamera else nil
		if camera then
			local ray = camera:ScreenPointToRay(at.X, at.Y)
			local hit = assert(workspace):Raycast(ray.Origin, ray.Direction * 10000)
			return if hit then ancestor(hit.Instance) else nil, hit
		end
		return nil, nil
	end
	local function info(target: Instance): Drag.Proposal
		local session = current :: Drag.Session
		return {
			source = session.source,
			target = target :: Env.DropDestination,
			mode = session.mode,
			operation = ctx.read(targets[target].operation or "move") :: Env.DropOperation,
			position = session.position,
			hit = session.hit,
			complete = function()
				return false
			end,
		}
	end
	local function validate(target: Instance, proposal: Drag.Proposal): (boolean, string?)
		local session = current :: Drag.Session
		local valid = session.spec.valid
		local operations = session.spec.operations
		local spec = targets[target]
		if not spec or not available(target) then
			return false, "The destination is no longer available"
		end
		if valid and not valid() then
			return false, "The source changed"
		end
		if operations and not table.find(operations, proposal.operation) then
			return false, "This operation is not supported"
		end
		if spec.propose then
			spec.propose(session.payload, proposal)
		end
		if spec.accepts then
			return spec.accepts(session.payload, proposal)
		end
		return true, nil
	end
	local function leave(session: Drag.Session)
		local target = session.target
		if target then
			target:SetAttribute("FacetDropState", nil)
			target:SetAttribute("FacetDropReason", nil)
			local spec = targets[target]
			if spec and spec.feedback then
				((spec.feedback :: unknown) :: { Enabled: boolean }).Enabled = false
			end
			if spec and spec.onLeave then
				spec.onLeave(session.payload)
			end
		end
	end
	local function nativeScale(node: Instance?): number
		local scaler = node and node:FindFirstChildWhichIsA("UIScale")
		return if scaler and scaler.Scale > 0 then scaler.Scale else 1
	end
	local function effectiveScale(node: Instance?, stop: Instance?): number
		local scale = 1
		while node and node ~= stop do
			scale *= nativeScale(node)
			node = node.Parent
		end
		return scale
	end
	local function localPoint(ghost: GuiObject, position: Vector2): UDim2
		local layer = ghost.Parent
		local origin = if layer and layer:IsA("GuiBase2d") then layer.AbsolutePosition else V2.zero
		local scale = 1
		if layer then
			for _, child in layer:GetChildren() do
				if child:IsA("UIScale") and child.Scale > 0 then
					scale = child.Scale
				end
			end
		end
		return D2.fromOffset((position.X - origin.X) / scale, (position.Y - origin.Y) / scale)
	end
	local function localExtent(ghost: GuiObject, extent: Vector2): UDim2
		local scale = nativeScale(ghost.Parent) * nativeScale(ghost)
		return D2.fromOffset(extent.X / scale, extent.Y / scale)
	end
	local function raiseStatus(ghost: GuiObject)
		local label = (current :: Drag.Session).status
		if not label then
			return
		end
		local top = ghost.ZIndex
		for _, node in ghost:GetDescendants() do
			if node:IsA("GuiObject") or node:IsA("Path2D") then
				top = math.max(top, node.ZIndex)
			end
		end
		(label.Parent :: GuiObject).ZIndex = top + 1
		label.ZIndex = top + 2
	end

	local function updateStatus(session: Drag.Session)
		local label = session.status
		if not label then
			return
		end
		label.Text = if session.spec.statusLabels == false
			then ""
			elseif session.pending then "Waiting for confirmation…"
			elseif session.accepted then ({ move = "Move", copy = "Copy", apply = "Apply" })[session.operation]
			elseif session.target then session.reason or "Cannot drop here"
			elseif session.mode == "armed" then "Choose a destination"
			else "Cannot drop here"
		if
			session.spec.statusLabels ~= false
			and session.accepted
			and session.target
			and targets[session.target].label
			and not session.pending
		then
			label.Text ..= " to " .. ctx.read(targets[session.target].label)
		end
		if session.mode == "armed" and not session.pending then
			local input = (session.effectiveInput :: (Types.Use?) -> "Touch" | "Gamepad" | "KeyboardAndMouse")(nil)
			if label.Text ~= "" then
				label.Text ..= " · "
			end
			label.Text ..= if input == "Gamepad"
				then "A: drop · B: cancel"
				elseif input == "Touch" then "Tap a destination"
				else "Enter: drop · Esc: cancel · Tab: destination"
			if input == "Gamepad" and session.spec.navigationHint then
				label.Text ..= " · " .. session.spec.navigationHint
			end
		end
		local panel = label.Parent :: GuiObject
		panel.Visible = label.Text ~= ""
			and (session.pending or session.mode == "armed" or not session.accepted or session.operation ~= "move")
		local layer = panel.Parent :: GuiBase2d
		local destination = session.target and targets[session.target]
		local anchor = destination and (destination.focusTarget or session.target)
		local point = session.position
			or (if anchor and anchor:IsA("GuiObject") then anchor.AbsolutePosition else session.origin)
		local at = localPoint(panel, point)
		local origin = layer.AbsolutePosition
		local boundsAt = localPoint(panel, origin + layer.AbsoluteSize)
		local sizeAt = localPoint(panel, origin + panel.AbsoluteSize)
		local size = V2.new(sizeAt.X.Offset, sizeAt.Y.Offset)
		local bounds = V2.new(boundsAt.X.Offset, boundsAt.Y.Offset)
		local gap = ctx.metric("space.s")
		local ghost = session.ghost
		if session.mode == "armed" and ghost then
			local preview = session.armedPreview
			local origin = if preview
					and preview.Parent
					and (session.target == nil or session.target == session.source)
				then preview.AbsolutePosition
				else point
			local pickup = localPoint(ghost, origin)
			local extent = session.previewSize :: Vector2
			local beside = anchor and anchor:IsA("GuiObject") and session.target ~= session.source
			local x = pickup.X.Offset + gap
			local y = pickup.Y.Offset + gap
			if beside then
				local guiAnchor = anchor :: GuiObject
				local edge = localPoint(ghost, guiAnchor.AbsolutePosition + guiAnchor.AbsoluteSize)
				x = edge.X.Offset + gap
				y = pickup.Y.Offset - extent.Y - size.Y - gap * 3
				if y < gap and edge.Y.Offset + extent.Y + size.Y + gap * 3 <= bounds.Y then
					y = edge.Y.Offset + gap
				end
			end
			ghost.AnchorPoint = V2.zero
			ghost.Position = D2.fromOffset(
				math.clamp(x, gap, math.max(gap, bounds.X - extent.X - gap)),
				math.clamp(y, gap, math.max(gap, bounds.Y - extent.Y - size.Y - gap * 3))
			)
			at = D2.fromOffset(
				ghost.Position.X.Offset - gap,
				ghost.Position.Y.Offset + extent.Y + gap - ctx.metric("targetSizes.minimum")
			)
		end
		(label:FindFirstChildWhichIsA("UISizeConstraint") :: UISizeConstraint).MaxSize =
			V2.new(math.max(1, math.min(280, bounds.X - gap * 4)), math.huge)
		panel.Position = D2.fromOffset(
			math.clamp(at.X.Offset + gap, gap, math.max(gap, bounds.X - size.X - gap)),
			math.clamp(at.Y.Offset + ctx.metric("targetSizes.minimum"), gap, math.max(gap, bounds.Y - size.Y - gap))
		)
	end
	function service.own(source: GuiObject)
		Compose.cleanup(function()
			if returning[source] then
				returning[source]()
			end
		end)
	end
	local function releaseFeedbackGhost(session: Drag.Session, accepted: boolean?)
		local ghost = session.ghost
		if not ghost then
			return
		end
		local function destroy()
			if session.stopPreview then
				session.stopPreview()
			end
			ghost:Destroy()
		end
		local gui = ctx.config.guiService
		local reduced = motion.resolve(
			ctx.read(ctx.config.motionLevel),
			gui ~= nil and gui.ReducedMotionEnabled == true
		) ~= "normal"
		if reduced or (not accepted and not available(session.source)) or not ghost.Parent then
			destroy()
			return
		end
		local point = if session.spec.returnPosition
			then session.spec.returnPosition()
			else session.source.AbsolutePosition + session.source.AbsoluteSize / 2
		point = (point or session.origin)
			- session.pickupSize / 2
			+ ghost.AnchorPoint * (session.previewSize :: Vector2)
		local from, goal = ghost.Position, localPoint(ghost, point)
		local scale: UIScale?
		local stopScale: (() -> ())?
		local originalScale = 1
		if accepted then
			scale = ghost:FindFirstChildWhichIsA("UIScale")
			if not scale then
				local stop, mounted = ctx.runtime.mount(function()
					return ctx.Host.UIScale {}
				end, ghost)
				stopScale, scale = stop, mounted :: UIScale
			end
			originalScale = assert(scale).Scale
		end
		local stopMotion: (() -> ())?
		local stopped = false
		local function stop()
			if stopped then
				return
			end
			stopped = true
			returning[session.source] = nil
			if stopMotion then
				stopMotion()
			end
			if stopScale then
				stopScale()
			end
			destroy()
		end
		returning[session.source] = stop
		stopMotion = travel(ctx, assert(ghost.Parent), function(progress)
			if scale then
				scale.Scale = originalScale * (1 - progress)
			else
				ghost.Position = from:Lerp(goal, progress)
			end
		end, stop)
	end
	local function releaseGhost(session: Drag.Session, accepted: boolean?, complete: () -> ())
		if not session.spec.returnTravel and not session.travelled then
			complete()
			releaseFeedbackGhost(session, accepted)
			return
		end
		local ghost = session.ghost
		if not ghost then
			complete()
			return
		end
		local function destroy()
			if session.stopPreview then
				session.stopPreview()
			end
			ghost:Destroy()
			complete()
		end
		local gui = ctx.config.guiService
		local reduced = motion.resolve(
			ctx.read(ctx.config.motionLevel),
			gui ~= nil and gui.ReducedMotionEnabled == true
		) ~= "normal"
		if
			reduced
			or (session.travelled and accepted)
			or (not accepted and not available(session.source))
			or not ghost.Parent
		then
			destroy()
			return
		end
		local point = if session.spec.returnPosition
			then session.spec.returnPosition()
			else session.source.AbsolutePosition + session.source.AbsoluteSize / 2
		point = (point or session.origin)
			- session.pickupSize / 2
			+ ghost.AnchorPoint * (session.previewSize :: Vector2)
		local from, goal = ghost.Position, localPoint(ghost, point)
		local scale: UIScale?
		local stopScale: (() -> ())?
		local originalScale = 1
		if accepted then
			scale = ghost:FindFirstChildWhichIsA("UIScale")
			if not scale then
				local stop, mounted = ctx.runtime.mount(function()
					return ctx.Host.UIScale {}
				end, ghost)
				stopScale, scale = stop, mounted :: UIScale
			end
			originalScale = assert(scale).Scale
		end
		local stopMotion: (() -> ())?
		local stopped = false
		local function stop()
			if stopped then
				return
			end
			stopped = true
			returning[session.source] = nil
			if stopMotion then
				stopMotion()
			end
			if stopScale then
				stopScale()
			end
			destroy()
		end
		returning[session.source] = stop
		stopMotion = travel(ctx, assert(ghost.Parent), function(progress)
			if scale then
				scale.Scale = originalScale * (1 - progress)
			else
				ghost.Position = from:Lerp(goal, progress)
			end
		end, stop)
	end
	function service.finish(accepted: boolean?, reason: string?)
		local session = current
		if not session then
			return
		end
		current = nil
		if session.stopTravel then
			session.stopTravel()
			session.stopTravel = nil
		end
		state:set(nil)
		if session.stop then
			session.stop()
		end
		leave(session)
		if session.pendingTarget and session.pendingTarget ~= session.target then
			session.pendingTarget:SetAttribute("FacetDropState", nil)
			session.pendingTarget:SetAttribute("FacetDropReason", nil)
		end
		if session.stopStatus then
			session.stopStatus()
		end
		local concluded = false
		local function conclude()
			if concluded then
				return
			end
			concluded = true
			session.source:RemoveTag("facet-drag-held")
			session.source:SetAttribute("FacetDragHeld", nil)
			if session.spec.onEnd then
				session.spec.onEnd(accepted == true, reason)
			end
		end
		if accepted or not session.spec.returnTravel then
			conclude()
		end
		releaseGhost(session, accepted, conclude)
		if session.highlight then
			session.highlight:Destroy()
		end
		if session.press and accepted == true then
			local stop: (() -> ())? = nil
			stop = assert(ctx.runtime.host.frames).onFrame(function()
				activation.release(session.press)
				if stop then
					stop()
				end
			end)
		end
	end
	function service.hover(target: Instance?, hit: RaycastResult?)
		if not current or current.pending then
			return
		end
		if current.target ~= target then
			leave(current)
			current.target = target
			if current.highlight then
				current.highlight:Destroy()
				current.highlight = nil
			end
			local onEnter = target and targets[target].onEnter
			if onEnter then
				onEnter(current.payload)
			end
		end
		current.hit = hit
		current.accepted, current.reason, current.operation = false, nil, nil
		if target then
			local proposal = info(target)
			local accepted, reason = validate(target, proposal)
			current.accepted, current.reason, current.operation = accepted, reason, proposal.operation
			target:SetAttribute("FacetDropState", if accepted then "accepted" else "rejected")
			target:SetAttribute("FacetDropReason", reason)
			local feedback = targets[target].feedback
			if feedback then
				((feedback :: unknown) :: { Enabled: boolean }).Enabled = accepted
				if feedback:IsA("UIStroke") then
					feedback:RemoveTag("facet-drop-accepted")
					feedback:RemoveTag("facet-drop-rejected")
					feedback:AddTag(if accepted then "facet-drop-accepted" else "facet-drop-rejected")
				end
			end
			local onUpdate = targets[target].onUpdate
			if onUpdate then
				onUpdate(current.payload, proposal, accepted, reason)
			end
		end
		updateStatus(current)
		state:set(table.clone(current))
	end
	function service.update(position: Vector2)
		if not current or current.pending then
			return
		end
		current.position = position
		local ghost = current.ghost
		if ghost then
			ghost.Position = localPoint(ghost, position)
		end
		service.hover(hitTest(position))
	end
	function service.commit(target: Instance?): boolean
		if not current or current.pending then
			return false
		end
		if target == nil and current.mode == "pointer" and current.position then
			service.hover(hitTest(current.position))
		end
		target = target or current.target
		if not target or not targets[target] then
			service.finish(false, "No destination")
			return false
		end
		local session, spec, destination = current, targets[target], target
		local proposal = info(destination)
		local accepted, reason = validate(destination, proposal)
		if not accepted then
			service.finish(false, reason)
			if spec.onReject then
				spec.onReject(session.payload, reason)
			end
			return false
		end
		if spec.travel and not session.travelled and session.ghost then
			local ghost = session.ghost
			local gui = ctx.config.guiService
			local reduced = motion.resolve(
				ctx.read(ctx.config.motionLevel),
				gui ~= nil and gui.ReducedMotionEnabled == true
			) ~= "normal"
			local rect = if spec.landing
				then spec.landing(proposal)
				elseif destination:IsA("GuiObject") then {
					x = destination.AbsolutePosition.X,
					y = destination.AbsolutePosition.Y,
					w = destination.AbsoluteSize.X,
					h = destination.AbsoluteSize.Y,
				}
				else nil
			if rect and not reduced then
				session.pending = true
				session.pendingTarget = destination
				destination:SetAttribute("FacetDropState", "pending")
				state:set(table.clone(session))
				local from = ghost.Position
				local previewSize = session.previewSize or session.pickupSize
				local goalExtent = V2.new(
					rect.w * (if session.pickupSize.X > 0 then previewSize.X / session.pickupSize.X else 1),
					rect.h * (if session.pickupSize.Y > 0 then previewSize.Y / session.pickupSize.Y else 1)
				)
				local goal = localPoint(ghost, V2.new(rect.x, rect.y) + ghost.AnchorPoint * goalExtent)
				local scaler = ghost:FindFirstChildWhichIsA("UIScale")
				local capturedScale = nativeScale(ghost)
				local goalScale = if destination:IsA("GuiObject")
					then effectiveScale(destination, nil) / nativeScale(ghost.Parent)
					elseif session.pickupSize.Y > 0 and rect.h > 0 then capturedScale * rect.h / session.pickupSize.Y
					else capturedScale
				if not scaler then
					local stop, mounted = ctx.runtime.mount(function()
						return ctx.Host.UIScale { Scale = capturedScale }
					end, ghost)
					scaler = mounted :: UIScale
					local previous = session.stopPreview
					session.stopPreview = function()
						if previous then
							previous()
						end
						stop()
					end
				end
				local movingScale = assert(scaler)
				session.stopTravel = travel(ctx, assert(ghost.Parent), function(progress)
					movingScale.Scale = capturedScale + (goalScale - capturedScale) * progress
					ghost.Position = from:Lerp(goal, progress)
					ghost.Size = localExtent(ghost, previewSize:Lerp(goalExtent, progress))
				end, function()
					if current ~= session then
						return
					end
					session.pending = false
					session.travelled = true
					service.commit(destination)
				end)
				return true
			end
		end
		local completed = false
		proposal.complete = function(ok: boolean, why: string?): boolean
			if completed or current ~= session then
				return false
			end
			completed = true
			if ok then
				ok, why = validate(destination, proposal)
			end
			service.finish(ok, why)
			if not ok and spec.onReject then
				spec.onReject(session.payload, why)
			end
			return ok
		end
		session.pending = true
		session.pendingTarget = destination
		session.executing = true
		updateStatus(session)
		state:set(session)
		destination:SetAttribute("FacetDropState", "pending")
		local ok, result =
			pcall(spec.onDrop :: (unknown, Env.DropInfo) -> (boolean | "pending")?, session.payload, proposal)
		session.executing = false
		if not ok then
			proposal.complete(false, tostring(result))
			return false
		end
		if result ~= "pending" and not completed and current == session then
			completed = true
			service.finish(result ~= false, if result == false then "Drop rejected" else nil)
			if result == false and spec.onReject then
				spec.onReject(session.payload, "Drop rejected")
			end
		end
		return result ~= false
	end
	function service.begin(
		source: GuiObject,
		spec: Drag.SourceSpec,
		mode: "pointer" | "armed",
		press: InputObject?,
		preview: (GuiObject | false)?,
		pickup: { position: Vector2, source: GuiObject }?
	)
		if current then
			return
		end
		if returning[source] then
			returning[source]()
		end
		local payload = if type(spec.payload) == "function"
			then (spec.payload :: (GuiObject) -> unknown)(source)
			else spec.payload
		if payload == nil then
			return
		end
		local picked = if pickup then pickup.source else source
		local size = picked.AbsoluteSize
		local offset = if pickup then pickup.position - picked.AbsolutePosition else size / 2
		local anchor = V2.new(
			if size.X > 0 then math.clamp(offset.X / size.X, 0, 1) else 0.5,
			if size.Y > 0 then math.clamp(offset.Y / size.Y, 0, 1) else 0.5
		)
		local created: Drag.Session = {
			pickupSize = size,
			pickupAnchor = anchor,
			position = if mode == "pointer" and pickup then pickup.position else nil,
			source = source,
			spec = spec,
			mode = mode,
			payload = payload,
			press = press,
			origin = if spec.returnPosition
				then spec.returnPosition()
				else source.AbsolutePosition + source.AbsoluteSize / 2,
		}
		current = created
		local layer = source:FindFirstAncestorWhichIsA("LayerCollector")
		if layer then
			local session = created
			session.stopStatus = ctx.runtime.mount(function()
				session.effectiveInput = ctx.effectiveInput()
				local label = ctx.styled(
					ctx.Host.TextLabel {
						Name = "DragStatusText",
						Size = D2.fromOffset(0, 0),
						AutomaticSize = ctx.types.Enum.AutomaticSize.XY,
						TextWrapped = true,
						Text = "Choose a destination",
						ZIndex = 1002,
						ctx.Host.UISizeConstraint {
							MaxSize = V2.new(math.max(1, math.min(280, layer.AbsoluteSize.X - 32)), math.huge),
						},
					},
					"text"
				)
				session.status = label
				local panelProps: Types.FrameProps = {
					Name = "DragStatus",
					Size = D2.fromOffset(0, 0),
					AutomaticSize = ctx.types.Enum.AutomaticSize.XY,
					ZIndex = 1001,
					Attributes = { FacetDragFeedback = true } :: EngineTypes.Attributes,
					ctx.Host.UIPadding {
						PaddingTop = ctx.types.UDim.new(0, ctx.metric("space.s")),
						PaddingBottom = ctx.types.UDim.new(0, ctx.metric("space.s")),
						PaddingLeft = ctx.types.UDim.new(0, ctx.metric("space.s")),
						PaddingRight = ctx.types.UDim.new(0, ctx.metric("space.s")),
					},
					label,
				}
				return ctx.styled(ctx.Host.Frame(panelProps), "tooltip")
			end, layer)
			updateStatus(session)
		end
		if spec.mark ~= false then
			source:AddTag("facet-drag-held")
			source:SetAttribute("FacetDragHeld", true)
		end
		activation.consume(press)
		if preview ~= false then
			local layer = source:FindFirstAncestorWhichIsA("LayerCollector")
			if layer then
				local ghost = (preview or source):Clone()
				local nodes = ghost:GetDescendants()
				table.insert(nodes, ghost)
				for _, node in nodes do
					if node:IsA("GuiObject") then
						node.Interactable, node.Active, node.Selectable = false, false, false
					elseif node:IsA("UIDragDetector") or node:IsA("InputContext") then
						((node :: unknown) :: { Enabled: boolean }).Enabled = false
					end
				end
				ghost:RemoveTag("facet-drag-held")
				ghost:SetAttribute("FacetDragHeld", nil)
				ghost.Name, ghost.ZIndex, ghost.AnchorPoint = "DragGhost", 1000, anchor
				ghost:SetAttribute("FacetDragFeedback", true)
				ghost.Parent = layer
				local capturedScale = effectiveScale(preview or source, layer)
				local scaler = ghost:FindFirstChildWhichIsA("UIScale")
				if scaler then
					scaler.Scale = capturedScale
				elseif capturedScale ~= 1 then
					created.stopPreview = ctx.runtime.mount(function()
						return ctx.Host.UIScale { Scale = capturedScale }
					end, ghost)
				end
				ghost.Size = localExtent(ghost, source.AbsoluteSize)
				local active = created
				active.previewSize = source.AbsoluteSize
				ghost.Position = localPoint(ghost, (created).position or (created).origin)
				active.ghost = ghost
				raiseStatus(ghost)
			end
		end
		state:set(table.clone(created))
		local onStart = spec.onStart
		if onStart then
			gestureOf(ctx).capture(source, function()
				onStart(payload, mode)
			end)
		end
		local session = current
		if not session then
			return
		end
		session.stop = assert(ctx.runtime.host.frames).onFrame(function(delta)
			if current ~= session then
				return
			end
			if spec.valid and not spec.valid() then
				service.finish(false, "The source changed")
				return
			end
			local destination = session.pendingTarget or session.target
			if destination and not available(destination) then
				service.finish(false, "The destination was removed")
				return
			end
			updateStatus(session)
			if session.mode == "armed" and not session.pending then
				service.hover(session.target, nil)
			end
			if session.position and not session.pending then
				service.update(session.position)
				local node = session.target
				local destination = if node then targets[node] else nil
				if destination and destination.autoscroll == false then
					return
				end
				if destination and destination.scroll then
					if destination.scroll(session.position, delta) then
						return
					end
					node = (node :: Instance).Parent
				end
				while node do
					if node:IsA("ScrollingFrame") and node.ScrollingEnabled then
						local at = session.position - node.AbsolutePosition
						local size = node.AbsoluteWindowSize
						local function speed(p: number, extent: number)
							local edge = math.min(40, extent / 4)
							if edge <= 0 or p < 0 or p > extent then
								return 0
							end
							return if p < edge
								then -(edge - p) / edge
								elseif p > extent - edge then (p - extent + edge) / edge
								else 0
						end
						local before = node.CanvasPosition
						local limit = node.AbsoluteCanvasSize - size
						local next = V2.new(
							math.clamp(before.X + speed(at.X, size.X) * 600 * delta, 0, math.max(0, limit.X)),
							math.clamp(before.Y + speed(at.Y, size.Y) * 600 * delta, 0, math.max(0, limit.Y))
						)
						if next ~= before then
							node.CanvasPosition = next
							break
						end
					end
					node = node.Parent
				end
			end
		end)
	end
	function service.preview(image: GuiObject, body: ScrollingFrame, frontSize: UDim2?)
		if not current then
			return
		end
		local layer = body:FindFirstAncestorWhichIsA("LayerCollector")
		if not layer then
			return
		end
		if current.ghost then
			if current.stopPreview then
				current.stopPreview()
				current.stopPreview = nil
			end
			current.ghost:Destroy()
		end
		local ghost = image:Clone()
		local size = image.Size
		local unit = body:FindFirstChild("LayoutUnit") :: GuiObject?
		local scale = if unit and unit.AbsoluteSize.X > 0 then unit.AbsoluteSize.X else 1
		local extent = V2.new(
			size.X.Offset * scale + size.X.Scale * body.AbsoluteWindowSize.X,
			size.Y.Offset * scale + size.Y.Scale * body.AbsoluteWindowSize.Y
		)
		ghost.Size = D2.fromOffset(extent.X / scale, extent.Y / scale)
		local front = if frontSize
			then V2.new(
				frontSize.X.Offset * scale + frontSize.X.Scale * extent.X,
				frontSize.Y.Offset * scale + frontSize.Y.Scale * extent.Y
			)
			else extent
		ghost.Name, ghost.Visible = "DragGhost", true
		ghost.AnchorPoint = V2.new(
			if extent.X > 0 then current.pickupAnchor.X * front.X / extent.X else 0.5,
			if extent.Y > 0 then current.pickupAnchor.Y * front.Y / extent.Y else 0.5
		)
		ghost:SetAttribute("FacetDragFeedback", true)
		ghost.Parent = layer
		if scale ~= 1 then
			current.stopPreview = ctx.runtime.mount(function()
				return ctx.Host.UIScale { Scale = scale }
			end, ghost)
		end
		current.previewSize = extent
		current.armedPreview = if current.mode == "armed" then image else nil
		ghost.Position = localPoint(ghost, current.position or current.origin)
		current.ghost = ghost
		raiseStatus(ghost)
	end

	function service.register(target: Instance, spec: Drag.TargetSpec)
		local owned = (table.clone(spec) :: unknown) :: Drag.RegisteredTarget
		local feedback: (UIStroke | Highlight)?
		if spec.feedback == false then
			feedback = nil
		elseif target:IsA("GuiObject") then
			feedback = ctx.Host.UIStroke({
				Name = "FacetDropOutline",
				Enabled = false,
				Thickness = function(use)
					return ctx.metric("strokes.hairline", use)
				end,
				ApplyStrokeMode = ctx.types.Enum.ApplyStrokeMode.Border,
				BorderStrokePosition = ctx.types.Enum.BorderStrokePosition.Inner,
			})
		else
			feedback = ctx.Host.Highlight({
				Name = "FacetDropHighlight",
				FillTransparency = 1,
				Enabled = false,
				Adornee = Compose.static(target),
				DepthMode = ctx.types.Enum.HighlightDepthMode.Occluded,
			})
		end
		if feedback then
			((feedback :: unknown) :: { Parent: Instance? }).Parent = target
		end
		owned.feedback = feedback
		targets[target] = owned
		if spec.focusTarget then
			proxies[spec.focusTarget] = target
		end
		Compose.cleanup(function()
			if current and not current.executing and current.target == target then
				service.finish(false, "The destination was removed")
			end
			targets[target] = nil
			if spec.focusTarget then
				proxies[spec.focusTarget] = nil
			end
		end)
	end
	service.targetOf = ancestor
	return service
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">drag_travel</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local travelEngine = require("./travel_engine")
local reducedMotion = require("./motion").reduced

return function(ctx: Types.Context, parent: Instance, sample: (number) -> (), complete: () -> ()): () -> ()
	local stop = ctx.runtime.mount(function()
		travelEngine(ctx, {
			initial = { 0 },
			target = function()
				return { 1 }
			end,
			sample = function(values)
				sample(values[1])
			end,
			complete = complete,
			reduced = reducedMotion(ctx),
			motion = "ease",
			duration = ctx.metric("motion.durations.travel"),
			ease = ctx.motionEase("travel"),
			spring = ctx.motionSpring("travel"),
		})
		return ctx.Host.Folder { Name = "FacetDragTravel" }
	end, parent)
	return stop
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">drag_types</string>
              <string name="Source"><![CDATA[--!strict
local Shared = require("./types")
local Env = require("./environment_types")

export type SourceSpec = Env.DraggableSpec & {
	mark: boolean?,
	navigationHint: string?,
	returnPosition: (() -> Vector2)?,
}
export type Proposal = Env.DropInfo & { invalid: string? }
export type TargetOptions = {
	travel: boolean?,
	landing: ((Env.DropInfo) -> Env.ScrollRect)?,
	label: Shared.ValueString?,
	onDrop: ((unknown, Proposal) -> ())
		| ((unknown, Proposal) -> boolean | "pending")
		| ((unknown, Proposal) -> (boolean | "pending")?),
	operation: Shared.Value<Env.DropOperation>?,
	passThrough: ((unknown) -> boolean)?,
	focusTarget: GuiObject?,
	accepts: ((unknown, Proposal) -> (boolean, string?))?,
	onReject: ((unknown, string?) -> ())?,
	onEnter: ((unknown) -> ())?,
	onLeave: ((unknown) -> ())?,
	onUpdate: ((unknown, Proposal, boolean, string?) -> ())?,
	propose: ((unknown, Proposal) -> ())?,
	collectionAxis: ("X" | "Y")?,
	autoscroll: boolean?,
	scroll: ((Vector2, number) -> boolean)?,
}
export type TargetSpec = TargetOptions & { feedback: boolean? }
export type RegisteredTarget = TargetOptions & { feedback: (UIStroke | Highlight)? }
export type Session = {
	source: GuiObject,
	spec: SourceSpec,
	mode: "pointer" | "armed",
	payload: unknown,
	press: InputObject?,
	origin: Vector2,
	pickupSize: Vector2,
	pickupAnchor: Vector2,
	position: Vector2?,
	target: Instance?,
	hit: RaycastResult?,
	accepted: boolean?,
	reason: string?,
	operation: Env.DropOperation?,
	pending: boolean?,
	pendingTarget: Instance?,
	executing: boolean?,
	ghost: GuiObject?,
	highlight: Highlight?,
	status: TextLabel?,
	previewSize: Vector2?,
	armedPreview: GuiObject?,
	effectiveInput: ((Shared.Use?) -> "Touch" | "Gamepad" | "KeyboardAndMouse")?,
	stop: (() -> ())?,
	stopPreview: (() -> ())?,
	stopStatus: (() -> ())?,
	stopTravel: (() -> ())?,
	travelled: boolean?,
}
export type Service = {
	state: Shared.Cell<Session?>,
	own: (GuiObject) -> (),
	finish: (boolean?, string?) -> (),
	hover: (Instance?, RaycastResult?) -> (),
	update: (Vector2) -> (),
	commit: (Instance?) -> boolean,
	begin: (
		GuiObject,
		SourceSpec,
		"pointer" | "armed",
		InputObject?,
		(GuiObject | false)?,
		{ position: Vector2, source: GuiObject }?
	) -> (),
	preview: (GuiObject, ScrollingFrame, UDim2?) -> (),
	register: (Instance, TargetSpec) -> (),
	targetOf: (Instance?) -> Instance?,
}
return {}
]]></string>
            </Properties>
