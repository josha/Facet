            <Properties>
              <string name="Name">color_picker</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Shared = require("./types")
local Nav = require("./navigation_types")
local InputProps = require("./input_props")
local Kit = require("./color_picker_kit")
local createState = require("./color_picker_state")
local createPanel = require("./color_picker_panel")
local createWell = require("./color_picker_well")

type Use = ComposeTypes.Use
type Spec = InputProps.ColorPickerProps
type Deps = Kit.Deps

local KEYS = {
	"value",
	"onChange",
	"onCommit",
	"alpha",
	"onAlphaChange",
	"allowEmpty",
	"placeholder",
	"modes",
	"swatches",
	"onSaveSwatch",
	"onRemoveSwatch",
	"style",
	"draft",
	"isPresented",
	"onPresentedChange",
	"onDismiss",
	"enabled",
	"readOnly",
	"label",
	"requiredMark",
	"hint",
	"errorText",
	"controlSize",
	"appearance",
	"corners",
}

return function(ctx: Shared.Context, UI: Deps, surfaces: Nav.Surfaces): ()
	local runtime = ctx.runtime
	local E, D2 = ctx.types.Enum, ctx.types.UDim2
	local kit = Kit.new(ctx)
	local chrome, color = kit.chrome, kit.color

	local function build(spec: Spec): Frame
		local state = createState(ctx, kit, spec)
		local style, labelled, diagnostics = state.style, state.labelled, state.diagnostics
		local held, canon, presented = state.held, state.canon, state.presented
		local placement, hexError = state.placement, state.hexError
		local columns, editing, enabled = state.columns, state.editing, state.enabled
		local panelView = createPanel(ctx, UI, surfaces, kit, state)

		local rootProps = ctx.props(spec, KEYS, {
			Name = "ColorPicker",
			BackgroundTransparency = 1,
			Size = if labelled or style == "inline" then D2.new(1, 0, 0, 0) else D2.fromOffset(0, 0),
			AutomaticSize = if labelled or style == "inline" then E.AutomaticSize.Y else E.AutomaticSize.XY,
		})
		local root: Frame
		if style == "inline" then
			local view = panelView(false, function()
				return false
			end, ctx.Compose.cell(math.huge))
			if chrome.present(spec) then
				root = chrome.wrap({
					control = "ColorPicker",
					spec = {
						label = spec.label,
						requiredMark = spec.requiredMark,
						hint = spec.hint,
						errorText = spec.errorText,
						appearance = spec.appearance,
					},
					plate = view.panel,
					focus = function() end,
					enabled = enabled,
					native = rootProps,
				})
			else
				root = ctx.column({ view.panel }, rootProps)
			end
		else
			root = createWell(ctx, UI, surfaces, kit, state, panelView, rootProps)
		end
		runtime.decorate(root, {
			Attributes = {
				value = function(use: Use): string
					local value = use(held)
					return if value == nil then "" else color.hex(value)
				end,
				text = function(use: Use): string
					return state.valueText(use)
				end,
				hue = function(use: Use): number
					return use(canon).h * 360
				end,
				saturation = function(use: Use): number
					return use(canon).s * 100
				end,
				brightness = function(use: Use): number
					return use(canon).v * 100
				end,
				mode = function(use: Use): string
					return use(state.modeCell)
				end,
				format = function(use: Use): string
					return use(state.formatCell)
				end,
				presented = function(use: Use): boolean
					return presented(use)
				end,
				placement = function(use: Use): string
					return use(placement)
				end,
				hexError = function(use: Use): string
					return use(hexError)
				end,
				columns = function(use: Use): number
					return use(columns)
				end,
				editing = function(use: Use): boolean
					return use(editing)
				end,
				diagnostics = function(use: Use): string
					return table.concat(use(diagnostics), "\n")
				end,
			} :: Shared.Attributes,
		})
		local picker: Frame = root
		return ctx.styled(picker, "color-picker")
	end

	local constructor = ctx.construct("ColorPicker", build)
	UI.ColorPicker = (constructor :: unknown) :: Shared.Constructor<Spec, Frame>
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">color_picker_kit</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Shared = require("./types")
local colorValue = require("./color_value")
local fieldChrome = require("./field_chrome")
local ControlTypes = require("./control_types")

type Use = ComposeTypes.Use
export type Hsv = colorValue.Hsv
export type Item = colorValue.Swatch
export type Paint = { color: Color3?, alpha: number }
export type Deps = ControlTypes.BuilderControls
export type Kit = {
	chrome: fieldChrome.Chrome,
	color: colorValue.ColorValue,
	WHITE: Color3,
	BLACK: Color3,
	LIGHT: Color3,
	DARK: Color3,
	normalize: (unknown) -> ({ Item }?, string?),
	ring: (string) -> Frame,
	swatch: (string, Shared.Value<UDim2>, (Use) -> Paint) -> Frame,
}

local MODE_LABEL: { [string]: string } =
	{ swatches = "Swatches", spectrum = "Spectrum", sliders = "Sliders", brick = "Bricks" }
local CELL, GAP, PAD, SPACE, MARGIN = 44, 4, 12, 8, 8
local MAX_COLUMNS = 8
local GRID_WIDTH = MAX_COLUMNS * CELL + (MAX_COLUMNS - 1) * GAP
local RING, BUBBLE = 20, 44

local function isColor(value: unknown): boolean
	return typeof(value) == "Color3"
end

local function unit(value: unknown): boolean
	return type(value) == "number" and value == value and value >= 0 and value <= 1
end

local function writable(source: unknown): boolean
	return type(source) == "table" and type((source :: { [string]: unknown }).set) == "function"
end

local function new(ctx: Shared.Context): Kit
	local Host = ctx.Host
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local C3 = ctx.types.Color3
	local chrome = fieldChrome(ctx)
	local color = colorValue({ Color3 = C3, BrickColor = ctx.types.BrickColor })
	local WHITE, BLACK = C3.new(1, 1, 1), C3.new(0, 0, 0)
	local LIGHT, DARK, MUTED = C3.fromRGB(255, 255, 255), C3.fromRGB(204, 204, 204), C3.fromRGB(128, 128, 128)

	local function normalize(list: unknown): ({ Item }?, string?)
		if type(list) ~= "table" then
			return nil, "is an array of Color3 or { color, label? }"
		end
		local out: { Item } = {}
		local seen: { [string]: boolean } = {}
		for index, entry in list :: { unknown } do
			local paint: unknown, label: unknown = entry, nil
			if type(entry) == "table" then
				local fields = entry :: { [unknown]: unknown }
				paint, label = fields.color, fields.label
				for key in fields do
					if key ~= "color" and key ~= "label" then
						return nil, `item {index} has an unknown key '{tostring(key)}' (it is \{ color, label? })`
					end
				end
			end
			if not isColor(paint) or (label ~= nil and type(label) ~= "string") then
				return nil, `item {index} is a Color3 or \{ color = Color3, label = string? }`
			end
			local c = paint :: Color3
			local words = label :: string?
			local key = words or color.hex(c)
			if seen[key] then
				return nil, `repeats '{key}' (a label or hex is the item's key)`
			end
			seen[key] = true
			table.insert(out, { color = c, label = words, key = key })
		end
		return out, nil
	end

	local function ring(name: string): Frame
		local function stroke(tint: Color3, thickness: number): UIStroke
			return Host.UIStroke "Stroke" { Color = tint, Thickness = thickness, Transparency = 0 }
		end
		return Host.Frame(name)({
			Size = D2.fromOffset(RING, RING),
			BackgroundTransparency = 1,
			ctx.corner(RING) :: Shared.Child,
			stroke(BLACK, 1),
			Host.Frame "Band" {
				AnchorPoint = V2.new(0.5, 0.5),
				Position = D2.fromScale(0.5, 0.5),
				Size = D2.new(1, -2, 1, -2),
				BackgroundTransparency = 1,
				ctx.corner(RING) :: Shared.Child,
				stroke(WHITE, 3),
				Host.Frame "Inner" {
					AnchorPoint = V2.new(0.5, 0.5),
					Position = D2.fromScale(0.5, 0.5),
					Size = D2.new(1, -6, 1, -6),
					BackgroundTransparency = 1,
					ctx.corner(RING) :: Shared.Child,
					stroke(BLACK, 1),
				},
			},
		})
	end

	local function swatch(name: string, edge: Shared.Value<UDim2>, paint: (Use) -> Paint): Frame
		local function checkerView(): Frame
			local cells: { Shared.Child } = {}
			for index, place in { { 0, 0 }, { 0.5, 0 }, { 0, 0.5 }, { 0.5, 0.5 } } do
				table.insert(
					cells,
					Host.Frame(string.char(64 + index))({
						Size = D2.fromScale(0.5, 0.5),
						Position = D2.fromScale(place[1], place[2]),
						BorderSizePixel = 0,
						BackgroundColor3 = if index == 1 or index == 4 then LIGHT else DARK,
					})
				)
			end
			local checker: Shared.FrameNativeProps = {
				Name = "Checker",
				Size = D2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Visible = function(use: Use)
					local p = paint(use)
					return p.color ~= nil and p.alpha < 1
				end,
			}
			for _, cell in cells do
				checker[#checker + 1] = cell
			end
			return Host.Frame(checker)
		end
		return ctx.styled(
			Host.Frame(name)({
				Size = edge,
				BorderSizePixel = 0,
				BackgroundColor3 = function(use: Use)
					return paint(use).color or WHITE
				end,
				BackgroundTransparency = function(use: Use)
					local p = paint(use)
					return if p.color ~= nil and p.alpha >= 1 then 0 else 1
				end,
				ctx.corner() :: Shared.Child,
				Host.UIStroke({ Thickness = 1, ApplyStrokeMode = E.ApplyStrokeMode.Border }),
				ctx.Compose.show(function(use: Use): boolean
					local p = paint(use)
					return p.color ~= nil and p.alpha < 1
				end, function(): CanvasGroup
					return Host.CanvasGroup {
						Name = "Paint",
						Size = D2.fromScale(1, 1),
						BorderSizePixel = 0,
						BackgroundTransparency = 1,
						ctx.corner() :: Shared.Child,
						checkerView(),
						Host.Frame "Plate" {
							Size = D2.fromScale(1, 1),
							BorderSizePixel = 0,
							BackgroundColor3 = function(use: Use)
								return paint(use).color or WHITE
							end,
							BackgroundTransparency = function(use: Use)
								local p = paint(use)
								return if p.color == nil then 1 else 1 - p.alpha
							end,
						},
					}
				end),
				Host.Frame "Empty" {
					AnchorPoint = V2.new(0.5, 0.5),
					Position = D2.fromScale(0.5, 0.5),
					Size = D2.new(1, 0, 0, 1),
					Rotation = -45,
					BorderSizePixel = 0,
					BackgroundColor3 = MUTED,
					Visible = function(use: Use)
						return paint(use).color == nil
					end,
				},
			}),
			"color-swatch"
		)
	end

	return {
		chrome = chrome,
		color = color,
		WHITE = WHITE,
		BLACK = BLACK,
		LIGHT = LIGHT,
		DARK = DARK,
		normalize = normalize,
		ring = ring,
		swatch = swatch,
	}
end

return {
	MODE_LABEL = MODE_LABEL,
	CELL = CELL,
	GAP = GAP,
	PAD = PAD,
	SPACE = SPACE,
	MARGIN = MARGIN,
	MAX_COLUMNS = MAX_COLUMNS,
	GRID_WIDTH = GRID_WIDTH,
	RING = RING,
	BUBBLE = BUBBLE,
	isColor = isColor,
	unit = unit,
	writable = writable,
	new = new,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">color_picker_panel</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Shared = require("./types")
local Nav = require("./navigation_types")
local InputProps = require("./input_props")
local NavigationProps = require("./navigation_props")
local Kit = require("./color_picker_kit")
local PickerState = require("./color_picker_state")
local createSliders = require("./color_picker_sliders")
local createSpectrum = require("./color_picker_spectrum")
local createSwatches = require("./color_picker_swatches")
local createReadout = require("./color_picker_readout")

type Use = ComposeTypes.Use
type Measure = (Use) -> number
export type PanelView = { panel: Frame, chrome: Measure, tech: Measure }
export type Panel = (boolean, (Use) -> boolean, ComposeTypes.Readable<number>) -> PanelView

local MODE_LABEL, CELL, GAP, PAD, SPACE, MAX_COLUMNS =
	Kit.MODE_LABEL, Kit.CELL, Kit.GAP, Kit.PAD, Kit.SPACE, Kit.MAX_COLUMNS

return function(
	ctx: Shared.Context,
	UI: Kit.Deps,
	surfaces: Nav.Surfaces,
	kit: Kit.Kit,
	state: PickerState.State
): Panel
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local E, D, D2 = ctx.types.Enum, ctx.types.UDim, ctx.types.UDim2
	local modes, draft = state.modes, state.draft
	local modeCell, columns = state.modeCell, state.columns
	local touch, close = state.touch, state.close
	local sliders = createSliders(ctx, UI, kit, state)
	local planeView = createSpectrum(ctx, UI, surfaces, kit, state, sliders)
	local swatches = createSwatches(ctx, UI, surfaces, kit, state)
	local readoutView = createReadout(ctx, UI, kit, state)
	local swatchesView, slidersView, brickView = swatches.swatchesView, sliders.slidersView, swatches.brickView

	local function panelView(overlay: boolean, sheet: (Use) -> boolean, room: ComposeTypes.Readable<number>): PanelView
		local builders: { [string]: () -> Frame } =
			{ swatches = swatchesView, spectrum = planeView, sliders = slidersView, brick = brickView }
		local shows: { Frame } = {}
		local technique: Shared.FrameNativeProps = {
			Name = "Technique",
			BackgroundTransparency = 1,
		}
		for _, mode in modes do
			local visited = Compose.cell(mode ~= "brick" or modeCell:peek() == mode)
			if not visited:peek() then
				Compose.watch(function(use: Use)
					if use(modeCell) == mode then
						visited:set(true)
					end
				end)
			end
			local show = Host.Frame(`Show{MODE_LABEL[mode]}`)({
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Visible = function(use: Use)
					return use(modeCell) == mode
				end,
				Compose.show(visited, builders[mode]),
			})
			table.insert(shows, show)
			technique[#technique + 1] = show
		end
		local heights: { ComposeTypes.Readable<Vector2> } = {}
		for _, show in shows do
			table.insert(heights, ctx.observe.AbsoluteSize(show))
		end
		local techniqueNode = Host.Frame(technique)
		local unit = ctx.layoutUnit(techniqueNode)
		local function tech(use: Use): number
			local tallest, list = 0, 0
			for index, size in heights do
				local h = use(size).Y / use(unit)
				if modes[index] == "brick" then
					list = h
				else
					tallest = math.max(tallest, h)
				end
			end
			return if tallest > 0 then tallest else list
		end
		local function active(use: Use): number
			local index = table.find(modes, use(modeCell))
			return if index then use(heights[index]).Y / use(unit) else 0
		end
		local width = ctx.observe.AbsoluteSize(techniqueNode)
		Compose.watch(function(use: Use)
			local w = use(width).X / use(unit)
			columns:set(if w > 0 then math.clamp(math.floor((w + GAP) / (CELL + GAP)), 1, MAX_COLUMNS) else MAX_COLUMNS)
		end)
		local measured: { { node: GuiObject, size: ComposeTypes.Readable<Vector2> } } = {}
		local function measure(node: GuiObject): GuiObject
			local size: ComposeTypes.Readable<Vector2> = ctx.observe.AbsoluteSize(node)
			table.insert(measured, { node = node, size = size })
			return node
		end
		local children: { Shared.Child } = {}
		if #modes > 1 then
			local options: { Nav.PickerOption<string> } = {}
			for _, mode in modes do
				table.insert(options, { value = mode, label = MODE_LABEL[mode] })
			end
			local modeProps: NavigationProps.SinglePickerSpec<string> = {
				Name = "Modes",
				selected = modeCell,
				style = "automatic" :: "automatic",
				options = options,
				LayoutOrder = 1,
			}
			table.insert(children, measure(UI.Picker(modeProps)))
		end
		local readout = readoutView()
		runtime.decorate(readout, {
			LayoutOrder = function(use: Use)
				return if touch(use) then 2 else 5
			end,
		})
		table.insert(children, measure(readout))
		local body = Host.ScrollingFrame "Body" {
			LayoutOrder = 3,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Selectable = false,
			ScrollBarThickness = 4,
			VerticalScrollBarInset = E.ScrollBarInset.ScrollBar,
			ScrollingDirection = E.ScrollingDirection.Y,
			AutomaticCanvasSize = E.AutomaticSize.Y,
			CanvasSize = D2.fromOffset(0, 0),
			Size = function(use: Use)
				local height = math.ceil(tech(use))
				return D2.new(1, 0, 0, if overlay then math.min(height, math.max(0, use(room))) else height)
			end,
			techniqueNode :: Shared.Child,
		}
		runtime.decorate(techniqueNode, {
			Size = function(use: Use)
				return D2.new(1, 0, 0, active(use))
			end,
		})
		table.insert(children, body)
		if state.hasAlpha then
			table.insert(children, measure(sliders.opacitySlider()))
		end
		local actions: { Shared.Child } = {}
		if draft then
			local cancelProps: InputProps.ButtonProps = {
				Name = "Cancel",
				label = "Cancel",
				role = "cancel" :: "cancel",
				onActivate = function()
					if overlay then
						close("cancel")
					else
						state.restore()
					end
				end,
			}
			table.insert(actions, UI.Button(cancelProps))
			table.insert(
				actions,
				UI.Button("Apply")({
					label = "Apply",
					appearance = "emphasis",
					onActivate = function()
						state.apply()
						if overlay then
							close("apply")
						end
					end,
				})
			)
		elseif overlay then
			table.insert(
				actions,
				UI.Button("Done")({
					label = "Done",
					onActivate = function()
						close("activate")
					end,
				})
			)
		end
		if #actions > 0 then
			local row = ctx.row(actions, {
				Name = "Actions",
				LayoutOrder = 6,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
				Visible = if draft
					then true
					else function(use: Use)
						return sheet(use)
					end,
			})
			assert(row:FindFirstChildWhichIsA("UIListLayout")).HorizontalAlignment = E.HorizontalAlignment.Right
			table.insert(children, measure(row))
		end
		local props: Shared.FrameNativeProps = {
			Name = "Panel",
			BackgroundTransparency = if overlay then 0 else 1,
			Size = D2.new(1, 0, 0, 0),
			AutomaticSize = if overlay then E.AutomaticSize.None else E.AutomaticSize.Y,
			Host.UIListLayout({ SortOrder = E.SortOrder.LayoutOrder, Padding = D.new(0, SPACE) }),
		}
		if overlay then
			props[#props + 1] = ctx.padding(PAD, PAD)
			props[#props + 1] = ctx.corner()
		end
		for _, child in children do
			props[#props + 1] = child
		end
		local panel = if overlay
			then ctx.fade((props :: unknown) :: Shared.CanvasGroupNativeProps)
			else Host.Frame(props)
		local visibility: { ComposeTypes.Readable<boolean> } = {}
		for _, entry in measured do
			table.insert(visibility, ctx.observe.Visible(entry.node))
		end
		local function chromeHeight(use: Use): number
			local total, count = 0, 1
			for index, entry in measured do
				if use(visibility[index]) then
					local extent: Vector2 = use(entry.size)
					total += extent.Y / use(unit)
					count += 1
				end
			end
			return total
				+ (count - 1) * SPACE
				+ (
					if overlay
						then surfaces.inset(PAD, "top", nil, use) + surfaces.inset(PAD, "bottom", nil, use)
						else 0
				)
		end
		return { panel = panel, chrome = chromeHeight, tech = tech }
	end

	return panelView
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">color_picker_readout</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Shared = require("./types")
local InputProps = require("./input_props")
local NavigationProps = require("./navigation_props")
local Kit = require("./color_picker_kit")
local PickerState = require("./color_picker_state")

type Use = ComposeTypes.Use
type Hsv = Kit.Hsv

local FORMATS = { { value = "rgb", label = "RGB" }, { value = "hsv", label = "HSV" }, { value = "hex", label = "Hex" } }
local CELL, GAP = Kit.CELL, Kit.GAP

return function(ctx: Shared.Context, UI: Kit.Deps, kit: Kit.Kit, state: PickerState.State): () -> Frame
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local E, D2 = ctx.types.Enum, ctx.types.UDim2
	local color = kit.color
	local hasAlpha, held, alphaHeld, canon = state.hasAlpha, state.held, state.alphaHeld, state.canon
	local formatCell, hexError = state.formatCell, state.hexError
	local interactive, propose, commit = state.interactive, state.propose, state.commit

	local function numberField(
		name: string,
		words: string,
		max: number,
		get: (Color3, Hsv) -> number,
		with: (number) -> Hsv?
	): GuiObject
		local text, number = Compose.cell(""), Compose.cell(0)
		local function resync()
			local value = held:peek()
			local n = if value == nil then nil else get(value, canon:peek())
			number:set(n or 0)
			text:set(if n == nil then "" else tostring(n))
		end
		Compose.watch(function(use: Use)
			use(held)
			use(canon)
			resync()
		end)
		local props: InputProps.NumberInputProps = {
			Name = name,
			label = words,
			value = text,
			numericValue = number,
			min = 0,
			max = max,
			precision = 0,
			enabled = function(use: Use): boolean
				return interactive(use)
			end,
			Size = D2.fromScale(0, 0),
			onCommit = function(n: number)
				local next = with(n)
				if next ~= nil and propose(next) then
					commit()
				end
				resync()
			end,
		}
		return UI.NumberInput(props)
	end
	local function fieldsRow(fields: { Shared.Child }): Frame
		local row = ctx.row(fields, { Name = "Fields", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
		assert(row:FindFirstChildWhichIsA("UIListLayout")).HorizontalFlex = E.UIFlexAlignment.Fill
		return row
	end
	local function rgbFields(): Frame
		local function channel(index: number, words: string): GuiObject
			return numberField(`Field{words}`, words, 255, function(value: Color3): number
				return (select(index, color.channels(value)))
			end, function(n: number): Hsv?
				local r, g, b = color.channels(held:peek() or color.toColor(canon:peek()))
				local bytes = { r, g, b }
				bytes[index] = n
				return color.hsvOf(color.fromBytes(bytes[1], bytes[2], bytes[3]), canon:peek())
			end)
		end
		return fieldsRow({ channel(1, "R"), channel(2, "G"), channel(3, "B") })
	end
	local function hsvFields(): Frame
		local function channel(key: "h" | "s" | "v", words: string, max: number): GuiObject
			return numberField(`Field{words}`, words, max, function(_: Color3, c: Hsv): number
				local amount = if key == "h" then c.h elseif key == "s" then c.s else c.v
				return math.floor(amount * max + 0.5)
			end, function(n: number): Hsv?
				local c = table.clone(canon:peek())
				if key == "h" then
					c.h = n / max
				elseif key == "s" then
					c.s = n / max
				else
					c.v = n / max
				end
				return c
			end)
		end
		return fieldsRow({ channel("h", "H", 360), channel("s", "S", 100), channel("v", "V", 100) })
	end
	local function hexFields(): Frame
		local text = Compose.cell("")
		local function formatted(): string
			local value = held:peek()
			return if value == nil then "" else color.hex(value, if hasAlpha then alphaHeld:peek() else nil)
		end
		Compose.watch(function(use: Use)
			use(held)
			use(alphaHeld)
			use(formatCell)
			text:set(formatted())
			hexError:set("")
		end)
		local props: InputProps.TextInputProps = {
			Name = "FieldHex",
			label = "Hex",
			value = text,
			errorText = hexError,
			Size = D2.fromScale(1, 0),
			AutomaticSize = E.AutomaticSize.Y,
			enabled = function(use: Use): boolean
				return interactive(use)
			end,
			onCommit = function(typed: string)
				local parsed, a, why = color.parseHex(typed, hasAlpha)
				if parsed == nil then
					hexError:set(why or "Check this colour.")
					return
				end
				hexError:set("")
				local moved = propose(color.hsvOf(parsed, canon:peek()))
				if a ~= nil then
					moved = state.proposeAlpha(a) or moved
				end
				if moved then
					commit()
				end
				text:set(formatted())
			end,
		}
		return fieldsRow({ UI.TextInput(props) })
	end
	local function readoutView(): Frame
		local builders: { [string]: () -> Frame } = { rgb = rgbFields, hsv = hsvFields, hex = hexFields }
		local values: Shared.FrameNativeProps = {
			Name = "Values",
			Size = D2.new(1, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
			BackgroundTransparency = 1,
		}
		for _, format in FORMATS do
			local fields = builders[format.value]()
			fields.Name = "Content"
			values[#values + 1] = Host.CanvasGroup("Fields" .. format.label)({
				BackgroundTransparency = 1,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
				GroupTransparency = function(use: Use): number
					return if use(formatCell) == format.value then 0 else 1
				end,
				Interactable = function(use: Use): boolean
					return use(formatCell) == format.value
				end,
				fields,
			})
		end
		local valuesNode = Host.Frame(values)
		local formatProps: NavigationProps.SinglePickerSpec<string> = {
			Name = "Format",
			selected = formatCell,
			style = "segmented" :: "segmented",
			options = FORMATS,
			Size = D2.fromOffset(0, CELL),
			AutomaticSize = E.AutomaticSize.X,
		}
		local picker = UI.Picker(formatProps)
		runtime.mount(function()
			return Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill })
		end, picker)
		local head = ctx.row({
			kit.swatch("Preview", D2.fromOffset(2 * CELL + GAP, CELL), state.currentPaint),
			picker,
		}, { Name = "Head", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
		assert(head:FindFirstChildWhichIsA("UIListLayout")).VerticalAlignment = E.VerticalAlignment.Center
		return ctx.column(
			{ head, valuesNode },
			{ Name = "Readout", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y }
		)
	end

	return readoutView
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">color_picker_sliders</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local textMeasure = require("./text_measure")
local Shared = require("./types")
local Inputs = require("./input_types")
local InputProps = require("./input_props")
local Kit = require("./color_picker_kit")
local PickerState = require("./color_picker_state")

type Use = ComposeTypes.Use
type Hsv = Kit.Hsv
export type Sliders = {
	channelSlider: (
		string,
		string,
		number,
		(Hsv) -> number,
		(Hsv, number) -> Hsv,
		(() -> Instance)?,
		((Inputs.SliderKnob) -> Instance)?
	) -> Frame,
	bubble: ((Use) -> Color3, (Use) -> boolean, Shared.FrameNativeProps) -> Frame,
	ringKnob: ((Inputs.SliderKnob) -> (Use) -> Color3) -> (Inputs.SliderKnob) -> Instance,
	hueSlider: () -> Frame,
	slidersView: () -> Frame,
	opacitySlider: () -> Frame,
}

local RING, BUBBLE, SPACE = Kit.RING, Kit.BUBBLE, Kit.SPACE
local STRIP = 12
local CHECKER_CELLS = 24

return function(ctx: Shared.Context, UI: Kit.Deps, kit: Kit.Kit, state: PickerState.State): Sliders
	local Host, runtime = ctx.Host, ctx.runtime
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local color, ring, WHITE = kit.color, kit.ring, kit.WHITE
	local held, canon = state.held, state.canon
	local interactive, propose, commit, touch = state.interactive, state.propose, state.commit, state.touch

	local function channelSlider(
		name: string,
		words: string,
		max: number,
		get: (Hsv) -> number,
		with: (Hsv, number) -> Hsv,
		track: (() -> Instance)?,
		knob: ((Inputs.SliderKnob) -> Instance)?
	): Frame
		local props: InputProps.SliderProps = {
			Name = name,
			label = words,
			value = function(use: Use): number
				return get(use(canon)) * max
			end,
			min = 0,
			max = max,
			step = 1,
			enabled = function(use: Use): boolean
				return interactive(use)
			end,
			format = function(n: number): string
				return tostring(math.floor(n + 0.5))
			end,
			trackContent = track,
			thumbContent = knob,
			onChange = function(n: number)
				propose(with(canon:peek(), n / max))
			end,
			onCommit = function()
				commit()
			end,
		}
		local node = UI.Slider(props)
		local found = node:FindFirstChild("Track", true)
		if found then
			found:SetAttribute("AccessibleLabel", words)
		end
		return node
	end
	local function bubble(paint: (Use) -> Color3, shown: (Use) -> boolean, place: Shared.FrameNativeProps): Frame
		local props: Shared.FrameNativeProps = {
			Name = "Bubble",
			Size = D2.fromOffset(BUBBLE, BUBBLE),
			BorderSizePixel = 0,
			ZIndex = 6,
			BackgroundColor3 = paint,
			Visible = function(use: Use)
				return touch(use) and shown(use)
			end,
			ctx.corner(BUBBLE) :: Shared.Child,
			Host.UIStroke({ Color = WHITE, Thickness = 2, Transparency = 0 }),
		}
		for key, value in (place :: unknown) :: { [string]: unknown } do
			((props :: unknown) :: { [string]: unknown })[key] = value
		end
		return Host.Frame(props)
	end
	local function ringKnob(paint: (Inputs.SliderKnob) -> (Use) -> Color3): (Inputs.SliderKnob) -> Instance
		return function(info: Inputs.SliderKnob): Instance
			return Host.Frame "Mark" {
				Size = D2.fromOffset(RING, RING),
				BackgroundTransparency = 1,
				ring("Ring"),
				bubble(paint(info), function(use: Use)
					return use(info.dragging)
				end, {
					AnchorPoint = V2.new(0.5, 1),
					Position = D2.new(0.5, 0, 0, -SPACE),
				}),
			}
		end
	end
	local function hueStrip(): Instance
		local points: { ColorSequenceKeypoint } = {}
		for index = 0, 6 do
			table.insert(
				points,
				ctx.types.ColorSequenceKeypoint.new(index / 6, color.toColor({ h = (index % 6) / 6, s = 1, v = 1 }))
			)
		end
		return Host.Frame "HueStrip" {
			AnchorPoint = V2.new(0.5, 0.5),
			Position = D2.fromScale(0.5, 0.5),
			Size = D2.new(1, 0, 0, STRIP),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			ctx.corner(STRIP) :: Shared.Child,
			Host.UIGradient "Rainbow" { Color = ctx.types.ColorSequence.new(points), Rotation = 0 },
		}
	end
	local function alphaStrip(): Instance
		local rows: { Shared.Child } = {}
		for row = 1, 2 do
			local cells: { Shared.Child } = {}
			for index = 1, CHECKER_CELLS do
				table.insert(
					cells,
					Host.Frame(`C{index}`)({
						Size = D2.fromScale(1 / CHECKER_CELLS, 1),
						BorderSizePixel = 0,
						LayoutOrder = index,
						BackgroundColor3 = if (index + row) % 2 == 0 then kit.LIGHT else kit.DARK,
					})
				)
			end
			local props: Shared.FrameNativeProps = {
				Name = if row == 1 then "Top" else "Bottom",
				Size = D2.fromScale(1, 0.5),
				Position = D2.fromScale(0, (row - 1) / 2),
				BackgroundTransparency = 1,
				Host.UIListLayout({
					FillDirection = E.FillDirection.Horizontal,
					SortOrder = E.SortOrder.LayoutOrder,
				}),
			}
			for _, cell in cells do
				props[#props + 1] = cell
			end
			table.insert(rows, Host.Frame(props))
		end
		local checker: Shared.FrameNativeProps = {
			Name = "Checker",
			Size = D2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
		}
		for _, row in rows do
			checker[#checker + 1] = row
		end
		return Host.Frame "AlphaStrip" {
			AnchorPoint = V2.new(0.5, 0.5),
			Position = D2.fromScale(0.5, 0.5),
			Size = D2.new(1, 0, 0, STRIP),
			BackgroundTransparency = 1,
			Host.Frame(checker),
			Host.Frame "Ramp" {
				Size = D2.fromScale(1, 1),
				BorderSizePixel = 0,
				BackgroundColor3 = function(use: Use)
					return use(held) or color.toColor(use(canon))
				end,
				Host.UIGradient({
					Transparency = ctx.types.NumberSequence.new({
						ctx.types.NumberSequenceKeypoint.new(0, 1),
						ctx.types.NumberSequenceKeypoint.new(1, 0),
					}),
					Rotation = 0,
				}),
			},
		}
	end
	local function hueSlider(): Frame
		return channelSlider(
			"Hue",
			"Hue",
			360,
			function(c: Hsv): number
				return c.h
			end,
			function(c: Hsv, f: number): Hsv
				return { h = f, s = c.s, v = c.v }
			end,
			hueStrip,
			ringKnob(function(info: Inputs.SliderKnob): (Use) -> Color3
				return function(use: Use): Color3
					return color.toColor({ h = use(info.value) / 360, s = 1, v = 1 })
				end
			end)
		)
	end

	local function slidersView(): Frame
		local sliders = {
			hueSlider(),
			channelSlider("Saturation", "Saturation", 100, function(c: Hsv): number
				return c.s
			end, function(c: Hsv, f: number): Hsv
				return { h = c.h, s = f, v = c.v }
			end),
			channelSlider("Brightness", "Brightness", 100, function(c: Hsv): number
				return c.v
			end, function(c: Hsv, f: number): Hsv
				return { h = c.h, s = c.s, v = f }
			end),
		}
		local labels: { TextLabel } = {}
		local bounds: { ComposeTypes.Readable<Vector2> } = {}
		for _, slider in sliders do
			local label = slider:FindFirstChild("Label") :: TextLabel
			table.insert(labels, label)
			table.insert(
				bounds,
				textMeasure.natural(ctx, label, function()
					local rendered, unit = ctx.observe.TextBounds(label), ctx.layoutUnit(label)
					return ctx.Compose.formula(function(use: Use): Vector2
						return use(rendered) / use(unit)
					end)
				end)
			)
		end
		for _, label in labels do
			local padding = label:FindFirstChildWhichIsA("UIPadding")
			local inset = if padding then padding.PaddingLeft.Offset + padding.PaddingRight.Offset else 0
			runtime.decorate(label, {
				Size = function(use: Use)
					local widest = 0
					for _, size in bounds do
						local width = use(size).X
						if width < math.huge then
							widest = math.max(widest, width)
						end
					end
					return D2.fromOffset(math.ceil(widest) + inset, 0)
				end,
			})
		end
		return ctx.column(sliders, { Name = "Sliders", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
	end

	local function opacitySlider(): Frame
		local opacity: InputProps.SliderProps = {
			Name = "Opacity",
			label = "Opacity",
			LayoutOrder = 4,
			value = function(use: Use): number
				return use(state.alphaHeld) * 100
			end,
			min = 0,
			max = 100,
			step = 1,
			enabled = function(use: Use): boolean
				return interactive(use)
			end,
			format = function(n: number): string
				return `{math.floor(n + 0.5)}%`
			end,
			trackContent = alphaStrip,
			thumbContent = ringKnob(function(): (Use) -> Color3
				return function(use: Use): Color3
					return use(held) or color.toColor(use(canon))
				end
			end),
			onChange = function(n: number)
				state.proposeAlpha(n / 100)
			end,
			onCommit = function()
				commit()
			end,
		}
		local slider = UI.Slider(opacity)
		local track = slider:FindFirstChild("Track", true)
		if track then
			track:SetAttribute("AccessibleLabel", "Opacity")
		end
		return slider
	end

	return {
		channelSlider = channelSlider,
		bubble = bubble,
		ringKnob = ringKnob,
		hueSlider = hueSlider,
		slidersView = slidersView,
		opacitySlider = opacitySlider,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">color_picker_spectrum</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Shared = require("./types")
local Nav = require("./navigation_types")
local InputProps = require("./input_props")
local Kit = require("./color_picker_kit")
local PickerState = require("./color_picker_state")
local Sliders = require("./color_picker_sliders")

type Use = ComposeTypes.Use
type Hsv = Kit.Hsv

local CELL, SPACE, RING, BUBBLE = Kit.CELL, Kit.SPACE, Kit.RING, Kit.BUBBLE
local STICK_SPEED, DEADZONE = 0.6, 0.2

return function(
	ctx: Shared.Context,
	UI: Kit.Deps,
	surfaces: Nav.Surfaces,
	kit: Kit.Kit,
	state: PickerState.State,
	sliders: Sliders.Sliders
): () -> Frame
	local Compose, Host, runtime, read = ctx.Compose, ctx.Host, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local color, ring, WHITE = kit.color, kit.ring, kit.WHITE
	local held, canon, selected = state.held, state.canon, state.selected
	local interactive, mayEdit, propose, commit, touch, gamepad =
		state.interactive, state.mayEdit, state.propose, state.commit, state.touch, state.gamepad
	local bubble, hueSlider = sliders.bubble, sliders.hueSlider

	local function planeView(): Frame
		local hueChannel = Compose.formula(function(use: Use): number
			return use(canon).h
		end)
		local dragging = Compose.cell(false)
		local dragStart: Hsv? = nil
		local surface: Frame
		local plane: Frame
		local planeSize: ComposeTypes.Readable<Vector2>
		local function fractions(position: Vector2): (number?, number?)
			local at, size = surface.AbsolutePosition, surface.AbsoluteSize
			if size.X <= 0 or size.Y <= 0 then
				return nil, nil
			end
			return math.clamp((position.X - at.X) / size.X, 0, 1), math.clamp((position.Y - at.Y) / size.Y, 0, 1)
		end
		local function setFrom(position: Vector2)
			local fx, fy = fractions(position)
			if fx == nil or fy == nil then
				return
			end
			local now = canon:peek()
			propose({ h = now.h, s = fx, v = 1 - fy })
		end
		local function beginDrag(position: Vector2)
			if not mayEdit() or (gamepad() and read(selected) == (surface :: GuiObject?)) then
				return
			end
			if not dragging:peek() then
				dragStart = canon:peek()
				dragging:set(true)
			end
			setFrom(position)
		end
		local function endDrag()
			if not dragging:peek() then
				return
			end
			dragging:set(false)
			dragStart = nil
			commit()
		end
		local function cancelDrag()
			if not dragging:peek() then
				return
			end
			dragging:set(false)
			local start = dragStart
			dragStart = nil
			if start ~= nil then
				propose(start)
			end
		end
		local first = true
		Compose.watch(function(use: Use)
			use(state.preferred)
			if not first then
				cancelDrag()
			end
			first = false
		end)
		Compose.watch(function(use: Use)
			if not interactive(use) then
				cancelDrag()
			end
		end)
		local function spot(use: Use, size: number): (number, number)
			local extent = use(planeSize)
			local c = use(canon)
			local x, y = c.s * extent.X, (1 - c.v) * extent.Y
			return math.clamp(x, size / 2, math.max(size / 2, extent.X - size / 2)),
				math.clamp(y, size / 2, math.max(size / 2, extent.Y - size / 2))
		end
		local mark = ring("Ring")
		surface = Host.Frame "Surface" {
			Size = D2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 5,
			Selectable = function(use: Use)
				return interactive(use)
			end,
			Host.UIDragDetector "Drag" {
				ResponseStyle = E.UIDragDetectorResponseStyle.CustomOffset,
				Enabled = function(use: Use)
					return interactive(use)
				end,
				DragStart = beginDrag,
				DragContinue = function(position: Vector2)
					if dragging:peek() then
						setFrom(position)
					end
				end,
				DragEnd = endDrag,
			},
		}
		surface:SetAttribute("AccessibleLabel", "Saturation and brightness")
		runtime.connect(surface, "SelectionGained", function() end)
		plane = Host.Frame "Plane" {
			Size = D2.new(1, 0, 0, 4 * CELL),
			BackgroundTransparency = 1,
			Host.Frame "Field" {
				Size = D2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Host.Frame "Hue" {
					Size = D2.fromScale(1, 1),
					BorderSizePixel = 0,
					BackgroundColor3 = WHITE,
					Host.UIGradient "Gradient" {
						Rotation = 0,
						Color = function(use: Use)
							local hue = color.toColor({ h = use(hueChannel), s = 1, v = 1 })
							return ctx.types.ColorSequence.new({
								ctx.types.ColorSequenceKeypoint.new(0, WHITE),
								ctx.types.ColorSequenceKeypoint.new(1, hue),
							})
						end,
					},
				},
				Host.Frame "Value" {
					Size = D2.fromScale(1, 1),
					BorderSizePixel = 0,
					BackgroundColor3 = kit.BLACK,
					Host.UIGradient "Gradient" {
						Rotation = 90,
						Transparency = ctx.types.NumberSequence.new({
							ctx.types.NumberSequenceKeypoint.new(0, 1),
							ctx.types.NumberSequenceKeypoint.new(1, 0),
						}),
					},
				},
			},
			surface,
		}
		planeSize = ctx.observe.AbsoluteSize(plane)
		runtime.decorate(mark, {
			AnchorPoint = V2.new(0.5, 0.5),
			ZIndex = 4,
			Visible = function(use: Use)
				return use(held) ~= nil
			end,
			Position = function(use: Use)
				local extent = use(planeSize)
				if extent.X <= 0 then
					local c = use(canon)
					return D2.fromScale(c.s, 1 - c.v)
				end
				local x, y = spot(use, RING)
				return D2.fromOffset(x, y)
			end,
		})
		surfaces.attach(plane, {
			mark,
			surfaces.overlay(plane, function(use: Use): boolean
				return touch(use) and use(dragging)
			end, function(): Frame
				local layer = assert(surfaces.parent(plane))
				local at, origin = ctx.observe.AbsolutePosition(plane), ctx.observe.AbsolutePosition(layer)
				local bounds = ctx.observe.AbsoluteSize(layer)
				local unit, layerUnit = ctx.layoutUnit(plane), ctx.layoutUnit(layer)
				local preview = bubble(function(use: Use): Color3
					return color.toColor(use(canon))
				end, function(use: Use): boolean
					return use(dragging)
				end, {
					AnchorPoint = V2.new(0.5, 1),
					ZIndex = 102,
					Position = function(use: Use)
						local scale = use(unit)
						local extent = use(planeSize)
						local x, y = spot(use, RING * scale)
						local half = BUBBLE / 2 * scale
						local offset = use(at) - use(origin)
						local above = offset.Y + y - (RING / 2 + SPACE) * scale
						local screen = use(bounds)
						if screen.Y > 0 and above < BUBBLE * scale then
							local side = (RING / 2 + SPACE + BUBBLE / 2) * scale
							local across = offset.X + x
							local beside = if across + side + half <= screen.X then across + side else across - side
							return D2.fromOffset(
								math.clamp(beside, half, math.max(half, screen.X - half)) / use(layerUnit),
								math.clamp(offset.Y + y + half, 2 * half, math.max(2 * half, screen.Y)) / use(layerUnit)
							)
						end
						return D2.fromOffset(
							(offset.X + math.clamp(x, half, math.max(half, extent.X - half))) / use(layerUnit),
							above / use(layerUnit)
						)
					end,
				})
				return surfaces.attach(preview, {
					Host.UIScale({
						Scale = function(use: Use): number
							return use(unit) / use(layerUnit)
						end,
					}),
				})
			end),
		})
		local function planeSelected(use: Use?): boolean
			return (read(selected, use) :: Instance?) == (surface :: Instance)
		end
		local stick = V2.zero
		local stopFrames: (() -> ())? = nil
		local function endSession()
			local stop = stopFrames
			if stop then
				stopFrames = nil
				stop()
				commit()
			end
		end
		local function steer(dt: number)
			if dt <= 0 then
				return
			end
			if not planeSelected() or not mayEdit() then
				endSession()
				return
			end
			local now = canon:peek()
			propose({
				h = now.h,
				s = math.clamp(now.s + stick.X * STICK_SPEED * dt, 0, 1),
				v = math.clamp(now.v + stick.Y * STICK_SPEED * dt, 0, 1),
			})
		end
		local steerAction = ctx.action(surface, "ColorPlaneSteer", { E.KeyCode.Thumbstick2 }, function(use: Use)
			return planeSelected(use) and interactive(use)
		end, function() end, { priority = 2200 })
		runtime.decorate(steerAction, {
			Type = E.InputActionType.Direction2D,
			StateChanged = function(value: unknown)
				if typeof(value) ~= "Vector2" then
					return
				end
				local direction = value :: Vector2
				if direction.Magnitude < DEADZONE then
					stick = V2.zero
					endSession()
					return
				end
				stick = direction
				if stopFrames == nil then
					stopFrames = assert(runtime.host.frames).onFrame(steer)
				end
			end,
		})
		Compose.watch(function(use: Use)
			if not planeSelected(use) then
				stick = V2.zero
				endSession()
			end
		end)
		Compose.cleanup(function()
			local stop = stopFrames
			stopFrames = nil
			if stop then
				stop()
			end
		end)
		local hintProps: InputProps.ShortcutHintProps =
			{ Name = "StickKey", keys = { { "Right Stick" } }, controlSize = "compact" :: "compact" }
		local hint = ctx.row({
			UI.ShortcutHint(hintProps),
			ctx.styled(ctx.text({ Name = "Words", Text = "Move saturation and brightness" }), "type-caption"),
		}, {
			Name = "StickHint",
			Visible = function(use: Use)
				return gamepad(use) and planeSelected(use)
			end,
		})
		return ctx.column({ plane, hint, hueSlider() }, {
			Name = "Spectrum",
			Size = D2.new(1, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
		})
	end

	return planeView
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">color_picker_state</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Shared = require("./types")
local Types = require("./color_picker_types")
local InputProps = require("./input_props")
local Kit = require("./color_picker_kit")

type Use = ComposeTypes.Use
type Cell<T> = ComposeTypes.Cell<T>
type Hsv = Kit.Hsv
type Item = Kit.Item
type Paint = Kit.Paint
type Spec = InputProps.ColorPickerProps
export type State = {
	spec: Spec,
	hasAlpha: boolean,
	style: string,
	draft: boolean,
	modes: { string },
	labelled: boolean,
	diagnostics: Cell<{ string }>,
	held: Cell<Color3?>,
	alphaHeld: Cell<number>,
	canon: Cell<Hsv>,
	enabled: (Use?) -> boolean,
	interactive: (Use?) -> boolean,
	mayEdit: () -> boolean,
	propose: (Hsv) -> boolean,
	proposeAlpha: (number) -> boolean,
	commit: () -> (),
	apply: () -> (),
	restore: () -> (),
	brickName: (Color3?) -> string?,
	valueText: (Use?) -> string,
	semanticName: (Use?) -> string,
	currentPaint: (Use) -> Paint,
	gui: GuiService?,
	selected: ComposeTypes.Readable<GuiObject?>,
	preferred: Cell<Enum.PreferredInput> | Cell<unknown>,
	touch: (Use?) -> boolean,
	gamepad: (Use?) -> boolean,
	presented: (Use?) -> boolean,
	requestPresented: (boolean) -> (),
	close: (Types.DismissReason) -> (),
	modeCell: Cell<string>,
	formatCell: Cell<string>,
	hexError: Cell<string>,
	placement: Cell<string>,
	columns: Cell<number>,
	editing: Cell<boolean>,
	saving: boolean,
	removing: boolean,
	swatchList: ComposeTypes.Formula<{ Item }>,
}

local isColor, unit, writable = Kit.isColor, Kit.unit, Kit.writable
local MODE_LABEL, MAX_COLUMNS = Kit.MODE_LABEL, Kit.MAX_COLUMNS

return function(ctx: Shared.Context, kit: Kit.Kit, spec: Spec): State
	local Compose, read, readSource = ctx.Compose, ctx.read, ctx.readSource
	local E = ctx.types.Enum
	local color, normalize = kit.color, kit.normalize
	local function refuse(message: string): never
		error(`Facet UI.ColorPicker: {message}`, 0)
	end
	local options = (spec :: unknown) :: { [string]: unknown }
	if spec.allowEmpty ~= nil and type(spec.allowEmpty) ~= "boolean" then
		refuse("`allowEmpty` is true or false.")
	end
	local allowEmpty = spec.allowEmpty == true
	local initial: unknown = read(spec.value)
	if not (isColor(initial) or (initial == nil and allowEmpty)) then
		refuse("`value` is a Color3 (or a readable one); nil only with `allowEmpty = true`.")
	end
	for _, key in
		{
			"onChange",
			"onCommit",
			"onAlphaChange",
			"onPresentedChange",
			"onDismiss",
			"onSaveSwatch",
			"onRemoveSwatch",
		}
	do
		if options[key] ~= nil and type(options[key]) ~= "function" then
			refuse(`\`{key}\` is a function.`)
		end
	end
	local readOnlyNow: unknown = read(spec.readOnly)
	if readOnlyNow ~= nil and type(readOnlyNow) ~= "boolean" then
		refuse("`readOnly` is a boolean or a readable boolean.")
	end
	if spec.onChange == nil and not writable(spec.value) and readOnlyNow ~= true then
		refuse(
			"an interactive ColorPicker needs `onChange(color)` or a writable cell; only a readOnly one may omit it."
		)
	end
	local hasAlpha = spec.alpha ~= nil
	if hasAlpha then
		if not unit(read(spec.alpha)) then
			refuse("`alpha` is a number from 0 to 1 (or a readable one).")
		end
		if spec.onAlphaChange == nil and not writable(spec.alpha) and readOnlyNow ~= true then
			refuse("`alpha` needs `onAlphaChange(alpha)`: the pair mounts the opacity control.")
		end
	elseif spec.onAlphaChange ~= nil then
		refuse("`onAlphaChange` needs `alpha`: without it there is no opacity to change.")
	end
	local style = spec.style or "automatic"
	if style ~= "automatic" and style ~= "inline" then
		refuse('`style` is "automatic" (a well that opens the panel) or "inline" (the panel in place).')
	end
	if style == "inline" and (spec.isPresented ~= nil or spec.onPresentedChange ~= nil) then
		refuse("an inline panel is always shown: `isPresented` and `onPresentedChange` belong to the well.")
	end
	if spec.draft ~= nil and type(spec.draft) ~= "boolean" then
		refuse("`draft` is true or false.")
	end
	local draft = spec.draft == true
	if spec.placeholder ~= nil and type(spec.placeholder) ~= "string" then
		refuse("`placeholder` is a string.")
	end
	local modes: { string } = {}
	do
		local listed: unknown = spec.modes
			or if ctx.types.BrickColor
				then { "swatches", "spectrum", "sliders", "brick" }
				else { "swatches", "spectrum", "sliders" }
		if Compose.isReadable(listed) or type(listed) ~= "table" or #(listed :: { unknown }) == 0 then
			refuse(
				'`modes` is a non-empty list of "swatches" | "spectrum" | "sliders" | "brick", fixed at construction.'
			)
		end
		local seen: { [string]: boolean } = {}
		for _, word in listed :: { unknown } do
			if type(word) ~= "string" or MODE_LABEL[word] == nil or seen[word] then
				refuse(
					`\`modes\` names each of "swatches" | "spectrum" | "sliders" | "brick" at most once (got '{tostring(
						word
					)}').`
				)
			end
			seen[word :: string] = true
			table.insert(modes, word :: string)
		end
	end
	local brickMode = table.find(modes, "brick") ~= nil
	if brickMode and ctx.types.BrickColor == nil then
		refuse("the brick mode needs BrickColor in the controls' `types`.")
	end
	if spec.swatches ~= nil then
		local _, why = normalize(read(spec.swatches))
		if why ~= nil then
			refuse(`\`swatches\` {why}.`)
		end
	end
	kit.chrome.check("ColorPicker", spec)
	local labelled = spec.label ~= nil

	local diagnostics = Compose.cell({} :: { string })
	local function note(line: string)
		local list = diagnostics:peek()
		if list[#list] ~= line then
			local nextList = table.clone(list)
			table.insert(nextList, line)
			if #nextList > 16 then
				table.remove(nextList, 1)
			end
			diagnostics:set(nextList)
		end
	end
	local function legalColor(value: unknown): boolean
		return isColor(value) or (value == nil and allowEmpty)
	end
	local held = Compose.cell(initial :: Color3?)
	Compose.watch(function(use: Use)
		local value: unknown = read(spec.value, use)
		if legalColor(value) then
			held:set(value :: Color3?)
		else
			note(
				`Facet UI.ColorPicker: \`value\` {if allowEmpty then "is a Color3 or nil" else "is a Color3"}; keeping the last legal value`
			)
		end
	end)
	local alphaHeld = Compose.cell(if hasAlpha then read(spec.alpha) :: number else 1)
	if hasAlpha then
		Compose.watch(function(use: Use)
			local value: unknown = read(spec.alpha, use)
			if unit(value) then
				alphaHeld:set(value :: number)
			else
				note("Facet UI.ColorPicker: `alpha` is a number from 0 to 1; keeping the last legal value")
			end
		end)
	end
	if spec.swatches ~= nil then
		Compose.watch(function(use: Use)
			local _, why = normalize(read(spec.swatches, use))
			if why ~= nil then
				note(`Facet UI.ColorPicker: \`swatches\` {why}; showing none`)
			end
		end)
	end
	local function enabled(use: Use?): boolean
		return read(spec.enabled, use) ~= false
	end
	local function interactive(use: Use?): boolean
		return enabled(use) and read(spec.readOnly, use) ~= true
	end
	local disposed = false
	Compose.cleanup(function()
		disposed = true
	end)
	local function mayEdit(): boolean
		return not disposed and interactive()
	end

	local canon = Compose.cell(color.hsvOf((initial :: Color3?) or kit.WHITE))
	local snapshot: { value: Color3?, alpha: number, canon: Hsv } =
		{ value = held:peek(), alpha = alphaHeld:peek(), canon = canon:peek() }
	local function takeSnapshot()
		snapshot = { value = held:peek(), alpha = alphaHeld:peek(), canon = canon:peek() }
	end
	local echo: Color3? = nil
	local alphaEcho: number? = nil
	Compose.watch(function(use: Use)
		local value = use(held)
		if echo ~= nil and value ~= nil and color.same(value, echo) then
			echo = nil
		else
			if value ~= nil and not color.same(value, color.toColor(canon:peek())) then
				canon:set(color.hsvOf(value, canon:peek()))
			end
			snapshot.value, snapshot.canon = held:peek(), canon:peek()
		end
	end)
	Compose.watch(function(use: Use)
		local value = use(alphaHeld)
		if alphaEcho ~= nil and value == alphaEcho then
			alphaEcho = nil
		else
			snapshot.alpha = value
		end
	end)

	local function change(next: Color3?)
		if spec.onChange then
			((spec.onChange :: unknown) :: (Color3?) -> ())(next)
		elseif writable(spec.value) then
			((spec.value :: unknown) :: ComposeTypes.Cell<Color3?>):set(next)
		end
	end
	local function changeAlpha(next: number)
		if spec.onAlphaChange then
			spec.onAlphaChange(next)
		elseif writable(spec.alpha) then
			((spec.alpha :: unknown) :: ComposeTypes.Cell<number>):set(next)
		end
	end
	local function current(): Color3?
		local value: unknown = read(spec.value)
		return if isColor(value) then value :: Color3 else nil
	end
	local function propose(next: Hsv): boolean
		if not mayEdit() then
			return false
		end
		local proposal = color.toColor(next)
		local now = current()
		if now ~= nil and color.same(now, proposal) then
			canon:set(next)
			return true
		end
		echo = proposal
		change(proposal)
		now = current()
		if now ~= nil and color.same(now, proposal) then
			canon:set(next)
			return true
		end
		echo = nil
		return false
	end
	local function proposeAlpha(next: number): boolean
		if not mayEdit() or not hasAlpha then
			return false
		end
		next = math.clamp(next, 0, 1)
		if next == alphaHeld:peek() then
			return false
		end
		alphaEcho = next
		changeAlpha(next)
		local now: unknown = read(spec.alpha)
		if now == next then
			return true
		end
		alphaEcho = nil
		return false
	end
	local function commit()
		local onCommit = spec.onCommit
		if disposed or draft or onCommit == nil then
			return
		end
		local value = held:peek()
		if value ~= nil then
			onCommit(value)
		end
	end
	local function apply()
		local value = held:peek()
		if spec.onCommit ~= nil and value ~= nil then
			spec.onCommit(value)
		end
		takeSnapshot()
	end
	local function restore()
		local saved = snapshot
		if disposed then
			return
		end
		local now = held:peek()
		if (now == nil) ~= (saved.value == nil) or not color.same(now, saved.value) then
			echo = saved.value
			change(saved.value)
		end
		if hasAlpha and alphaHeld:peek() ~= saved.alpha then
			alphaEcho = saved.alpha
			changeAlpha(saved.alpha)
		end
		canon:set(saved.canon)
	end

	local function brickName(c: Color3?): string?
		if c == nil or not brickMode then
			return nil
		end
		for _, entry in color.brick() do
			if color.same(entry.color, c) then
				return entry.label
			end
		end
		return nil
	end
	local function valueText(use: Use?): string
		local value = readSource(held, use)
		if value == nil then
			return spec.placeholder or ""
		end
		local a = readSource(alphaHeld, use)
		return color.hex(value, if hasAlpha and a < 1 then a else nil)
	end
	local function semanticName(use: Use?): string
		local words = brickName(readSource(held, use)) or valueText(use)
		local label = read(spec.label, use)
		return if type(label) == "string" and label ~= "" then `{label}, {words}` else words
	end
	local function currentPaint(use: Use): Paint
		return { color = use(held), alpha = use(alphaHeld) }
	end

	local gui = ctx.config.services.GuiService
	local input = ctx.config.services.UserInputService
	local selected = if gui then ctx.observe.SelectedObject(gui) else Compose.cell(nil :: GuiObject?)
	local preferred = if input then ctx.observe.PreferredInput(input) else Compose.cell(nil :: unknown)
	local function touch(use: Use?): boolean
		return read(preferred, use) == E.PreferredInput.Touch
	end
	local function gamepad(use: Use?): boolean
		return read(preferred, use) == E.PreferredInput.Gamepad
	end

	local ownOpen = Compose.cell(false)
	local function presented(use: Use?): boolean
		if spec.isPresented ~= nil then
			return read(spec.isPresented, use) == true
		end
		return readSource(ownOpen, use)
	end
	local function requestPresented(next: boolean)
		if next and (disposed or not interactive()) then
			return
		end
		if spec.onPresentedChange then
			spec.onPresentedChange(next)
		elseif spec.isPresented ~= nil then
			if writable(spec.isPresented) then
				((spec.isPresented :: unknown) :: ComposeTypes.Cell<boolean>):set(next)
			end
		else
			ownOpen:set(next)
		end
	end
	local wasOpen = false
	Compose.watch(function(use: Use)
		local open = presented(use)
		if open and not wasOpen then
			takeSnapshot()
		end
		wasOpen = open
	end)
	local function close(reason: Types.DismissReason)
		if style == "inline" or not presented() then
			return
		end
		if draft and reason ~= "apply" then
			restore()
		end
		requestPresented(false)
		if spec.onDismiss then
			spec.onDismiss(reason)
		end
	end

	local modeCell = Compose.cell(modes[1])
	local formatCell = Compose.cell("rgb")
	local hexError = Compose.cell("")
	local placement = Compose.cell(if style == "inline" then "inline" else "closed")
	local columns = Compose.cell(MAX_COLUMNS)
	local editing = Compose.cell(false)
	local saving = spec.onSaveSwatch ~= nil
	local removing = spec.onRemoveSwatch ~= nil
	local swatchList = Compose.formula(function(use: Use): { Item }
		if spec.swatches == nil then
			return color.standard(use(columns))
		end
		return (normalize(read(spec.swatches, use))) or {}
	end)

	return {
		spec = spec,
		hasAlpha = hasAlpha,
		style = style,
		draft = draft,
		modes = modes,
		labelled = labelled,
		diagnostics = diagnostics,
		held = held,
		alphaHeld = alphaHeld,
		canon = canon,
		enabled = enabled,
		interactive = interactive,
		mayEdit = mayEdit,
		propose = propose,
		proposeAlpha = proposeAlpha,
		commit = commit,
		apply = apply,
		restore = restore,
		brickName = brickName,
		valueText = valueText,
		semanticName = semanticName,
		currentPaint = currentPaint,
		gui = gui,
		selected = selected,
		preferred = preferred,
		touch = touch,
		gamepad = gamepad,
		presented = presented,
		requestPresented = requestPresented,
		close = close,
		modeCell = modeCell,
		formatCell = formatCell,
		hexError = hexError,
		placement = placement,
		columns = columns,
		editing = editing,
		saving = saving,
		removing = removing,
		swatchList = swatchList,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">color_picker_swatches</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Shared = require("./types")
local Nav = require("./navigation_types")
local Kit = require("./color_picker_kit")
local PickerState = require("./color_picker_state")

type Use = ComposeTypes.Use
type Item = Kit.Item
type Paint = Kit.Paint
export type Swatches = { swatchesView: () -> Frame, brickView: () -> Frame }

local CELL, GAP, SPACE = Kit.CELL, Kit.GAP, Kit.SPACE
local SAVE_KEY = "\0save"

return function(
	ctx: Shared.Context,
	UI: Kit.Deps,
	surfaces: Nav.Surfaces,
	kit: Kit.Kit,
	state: PickerState.State
): Swatches
	local Compose, Host, read, readSource = ctx.Compose, ctx.Host, ctx.read, ctx.readSource
	local E, D, D2, V2 = ctx.types.Enum, ctx.types.UDim, ctx.types.UDim2, ctx.types.Vector2
	local color = kit.color
	local spec, removing = state.spec, state.removing
	local gui, selected, held, canon = state.gui, state.selected, state.held, state.canon
	local columns, editing, swatchList = state.columns, state.editing, state.swatchList
	local interactive, propose = state.interactive, state.propose

	local function landAfterRemoval(grid: Instance, index: number)
		if not gui then
			return
		end
		local cells: { GuiObject } = {}
		for _, child in grid:GetChildren() do
			if child:IsA("GuiObject") then
				table.insert(cells, child)
			end
		end
		table.sort(cells, function(a: GuiObject, b: GuiObject): boolean
			return a.LayoutOrder < b.LayoutOrder
		end)
		local target = cells[math.min(index, #cells)]
		if target then
			gui.SelectedObject = target
		end
	end

	local function gridView(name: string, items: (Use) -> { Item }, removable: boolean, mode: string): Frame
		local owned: { [Instance]: { item: ComposeTypes.Readable<Item>, index: ComposeTypes.Readable<number> } } = {}
		local grid: Frame
		local function removeAt(item: Item, index: number)
			if not state.mayEdit() then
				return
			end
			local remove = spec.onRemoveSwatch
			if remove == nil then
				return
			end
			remove({ color = item.color, label = item.label, key = item.key })
			if grid:FindFirstChild(item.key) == nil then
				landAfterRemoval(grid, index)
			end
		end
		local function saveCell(index: ComposeTypes.Readable<number>): TextButton
			local function fresh(use: Use?): boolean
				local value = readSource(held, use)
				if value == nil or readSource(editing, use) then
					return false
				end
				for _, entry in readSource(swatchList, use) do
					if color.same(entry.color, value) or entry.key == color.hex(value) then
						return false
					end
				end
				return true
			end
			return ctx.styled(
				UI.Button("Save")({
					name = "Save colour",
					appearance = "utility",
					Size = D2.fromOffset(CELL, CELL),
					AutomaticSize = E.AutomaticSize.None,
					LayoutOrder = function(use: Use)
						return use(index)
					end,
					enabled = function(use: Use)
						return interactive(use) and fresh(use)
					end,
					onActivate = function()
						local value = held:peek()
						local save = spec.onSaveSwatch
						if value ~= nil and save ~= nil and fresh() then
							save(value)
						end
					end,
					ctx.styled(
						Host.Frame "Plus" {
							Size = D2.fromScale(1, 1),
							BackgroundTransparency = 1,
							ctx.corner() :: Shared.Child,
							Host.UIStroke({ Thickness = 1, ApplyStrokeMode = E.ApplyStrokeMode.Border }),
							ctx.icon("increment", {
								Name = "Mark",
								AnchorPoint = V2.new(0.5, 0.5),
								Position = D2.fromScale(0.5, 0.5),
							}),
						},
						"color-swatch"
					),
				}),
				"color-cell"
			)
		end
		local function cell(
			source: ComposeTypes.Readable<Item>,
			index: ComposeTypes.Readable<number>,
			key: string
		): Instance
			if key == SAVE_KEY then
				return saveCell(index)
			end
			local function chosen(use: Use): boolean
				if use(state.modeCell) ~= mode then
					return false
				end
				local value = use(held)
				return value ~= nil and color.same(value, use(source).color)
			end
			local node = UI.Button(key)({
				name = function(use: Use): string
					local entry = use(source)
					local named = entry.label or color.hex(entry.color)
					return if removable and use(editing)
						then ctx.phrase("Facet.RemoveItem", "Remove {item}", { item = named }, use)
						else named
				end,
				appearance = "utility",
				Size = D2.fromOffset(CELL, CELL),
				AutomaticSize = E.AutomaticSize.None,
				LayoutOrder = function(use: Use)
					return use(index)
				end,
				selected = chosen,
				enabled = function(use: Use)
					return interactive(use)
				end,
				onActivate = function()
					local entry = source:peek()
					if removable and editing:peek() then
						removeAt(entry, index:peek())
						return
					end
					if propose(color.hsvOf(entry.color, canon:peek())) then
						state.commit()
					end
				end,
				kit.swatch("Swatch", D2.fromScale(1, 1), function(use: Use): Paint
					return { color = use(source).color, alpha = 1 }
				end) :: Shared.Child,
				ctx.icon("checkmark", {
					Name = "Check",
					AnchorPoint = V2.new(0.5, 0.5),
					Position = D2.fromScale(0.5, 0.5),
					Visible = function(use: Use)
						return chosen(use) and not (removable and use(editing))
					end,
				}),
			})
			if removable then
				surfaces.attach(node, {
					ctx.icon("close", {
						Name = "Remove",
						AnchorPoint = V2.new(0.5, 0.5),
						Position = D2.fromScale(0.5, 0.5),
						Visible = editing,
					}),
				})
			end
			ctx.styled(node, "color-cell")
			owned[node] = { item = source, index = index }
			Compose.cleanup(function()
				owned[node] = nil
			end)
			return node
		end
		grid = Host.Frame(name)({
			BackgroundTransparency = 1,
			Size = function(use: Use)
				local n = math.max(1, math.min(use(columns), #items(use)))
				return D2.fromOffset(n * CELL + (n - 1) * GAP, 0)
			end,
			AutomaticSize = E.AutomaticSize.Y,
			Host.UIListLayout({
				FillDirection = E.FillDirection.Horizontal,
				SortOrder = E.SortOrder.LayoutOrder,
				Wraps = true,
				Padding = D.new(0, GAP),
			}) :: Shared.Child,
			Compose.keyed({
				from = items,
				key = function(entry: Item): string
					return entry.key
				end,
				render = cell,
			}),
		})
		if removable then
			local function focused(
				use: Use?
			): { item: ComposeTypes.Readable<Item>, index: ComposeTypes.Readable<number> }?
				local node = read(selected, use)
				return if node then owned[node] else nil
			end
			ctx.action(grid, "ColorSwatchRemove", {
				E.KeyCode.Delete,
				E.KeyCode.Backspace,
				E.KeyCode.ButtonX,
			}, function(use: Use)
				return use(editing) and interactive(use) and focused(use) ~= nil
			end, function()
				local entry = focused()
				if entry and editing:peek() then
					removeAt(entry.item:peek(), entry.index:peek())
				end
			end, { priority = 2300 })
		end
		return grid
	end

	local function centred(column: Frame): Frame
		assert(column:FindFirstChildWhichIsA("UIListLayout")).HorizontalAlignment = E.HorizontalAlignment.Center
		return column
	end
	local function swatchesView(): Frame
		local items = function(use: Use): { Item }
			local list = table.clone(use(swatchList))
			if state.saving then
				table.insert(list, { key = SAVE_KEY, color = kit.WHITE })
			end
			return list
		end
		local parts: { Shared.Child } = {}
		if removing then
			table.insert(
				parts,
				UI.Button("Edit")({
					label = function(use: Use): string
						return if use(editing) then "Done" else "Edit"
					end,
					appearance = "link",
					enabled = function(use: Use): boolean
						return interactive(use)
					end,
					onActivate = function()
						editing:set(not editing:peek())
					end,
				})
			)
		end
		table.insert(parts, gridView("Swatches", items, removing, "swatches"))
		return centred(
			ctx.column(parts, { Name = "Saved", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
		)
	end

	local function brickView(): Frame
		local bricks = color.brick()
		return centred(ctx.column({
			ctx.styled(
				ctx.row({
					ctx.text({
						Name = "BrickName",
						Text = function(use: Use)
							return state.brickName(use(held)) or "No engine colour matches"
						end,
					}),
				}, { Name = "NameField", ctx.padding(SPACE, 6) :: Shared.Child }),
				"field"
			),
			gridView("BrickGrid", function(): { Item }
				return bricks
			end, false, "brick"),
		}, { Name = "Brick", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y }))
	end

	return { swatchesView = swatchesView, brickView = brickView }
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">color_picker_types</string>
              <string name="Source"><![CDATA[--!strict
local Shared = require("./types")

type Value<T> = Shared.Value<T>
export type Mode = "swatches" | "spectrum" | "sliders" | "brick"
export type Style = "automatic" | "inline"
export type DismissReason = "activate" | "outside" | "cancel" | "anchorLost" | "apply"
export type Swatch = Color3 | { color: Color3, label: string? }
export type SwatchItem = { color: Color3, label: string?, key: string }
export type ColorValue = Value<Color3?>
export type NumberValue = Shared.ValueNumber
export type FlagValue = Shared.ValueBoolean
export type WordsValue = Shared.ValueString
export type SizeValue = Value<Shared.ControlSize?>
export type SwatchesValue = Value<{ Swatch }>
export type ColorPickerOptions = {
	value: ColorValue,
	onChange: ((color: Color3) -> ())?,
	onCommit: ((color: Color3) -> ())?,
	alpha: NumberValue?,
	onAlphaChange: ((alpha: number) -> ())?,
	allowEmpty: boolean?,
	placeholder: string?,
	modes: { Mode }?,
	swatches: SwatchesValue?,
	onSaveSwatch: ((color: Color3) -> ())?,
	onRemoveSwatch: ((item: SwatchItem) -> ())?,
	style: Style?,
	draft: boolean?,
	isPresented: FlagValue?,
	onPresentedChange: ((next: boolean) -> ())?,
	onDismiss: ((reason: DismissReason) -> ())?,
	enabled: FlagValue?,
	readOnly: FlagValue?,
	label: WordsValue?,
	requiredMark: ("required" | "optional")?,
	hint: WordsValue?,
	errorText: WordsValue?,
	controlSize: SizeValue?,
	appearance: WordsValue?,
	corners: ("pill" | "square")?,
}

return {}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">color_picker_well</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Shared = require("./types")
local Nav = require("./navigation_types")
local InputProps = require("./input_props")
local Kit = require("./color_picker_kit")
local PickerState = require("./color_picker_state")
local Panel = require("./color_picker_panel")
local rest = require("./rest")

type Use = ComposeTypes.Use
type PanelView = Panel.PanelView
type Spec = InputProps.ColorPickerProps
type Placement = { edge: string, x: number, y: number, w: number, h: number }

local CELL, GAP, PAD, MARGIN, GRID_WIDTH = Kit.CELL, Kit.GAP, Kit.PAD, Kit.MARGIN, Kit.GRID_WIDTH

return function(
	ctx: Shared.Context,
	UI: Kit.Deps,
	surfaces: Nav.Surfaces,
	kit: Kit.Kit,
	state: PickerState.State,
	panelView: Panel.Panel,
	rootProps: Spec
): Frame
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local chrome = kit.chrome
	local spec, labelled, placement, columns = state.spec, state.labelled, state.placement, state.columns
	local enabled, touch, presented, requestPresented, close =
		state.enabled, state.touch, state.presented, state.requestPresented, state.close

	local function place(
		use: Use,
		view: PanelView,
		sheet: (Use) -> boolean,
		extent: ComposeTypes.Readable<Vector2>,
		origin: ComposeTypes.Readable<Vector2>,
		at: ComposeTypes.Readable<Vector2>,
		bounds: ComposeTypes.Readable<Vector2>,
		tenFoot: boolean
	): Placement
		local offer = use(extent)
		local corner = use(at) - use(origin)
		local size = use(bounds)
		if offer.X > 0 and offer.Y > 0 then
			corner = V2.new(
				math.clamp(corner.X, 0, math.max(0, offer.X - size.X)),
				math.clamp(corner.Y, 0, math.max(0, offer.Y - size.Y))
			)
		end
		local natural = view.chrome(use) + view.tech(use)
		local wide = GRID_WIDTH + surfaces.inset(PAD, "left", nil, use) + surfaces.inset(PAD, "right", nil, use)
		if sheet(use) then
			local h = if offer.Y > 0 then math.min(natural, offer.Y - 2 * PAD) else natural
			if tenFoot then
				local w = if offer.X > 0 then math.min(wide, offer.X - 2 * PAD) else wide
				return {
					edge = "center",
					x = math.max(PAD, (offer.X - w) / 2),
					y = math.max(PAD, (offer.Y - h) / 2),
					w = w,
					h = h,
				}
			end
			return { edge = "sheet", x = PAD, y = math.max(PAD, offer.Y - h - PAD), w = offer.X - 2 * PAD, h = h }
		end
		local w = if offer.X > 0 then math.min(wide, math.max(CELL, offer.X - 2 * MARGIN)) else wide
		local below = offer.Y - (corner.Y + size.Y + GAP) - MARGIN
		local above = corner.Y - GAP - MARGIN
		local x = math.clamp(corner.X, MARGIN, math.max(MARGIN, offer.X - w - MARGIN))
		if natural <= below then
			return { edge = "bottom", x = x, y = corner.Y + size.Y + GAP, w = w, h = natural }
		end
		if natural <= above then
			return { edge = "top", x = x, y = corner.Y - GAP - natural, w = w, h = natural }
		end
		local right = corner.X + size.X + GAP + w <= offer.X - MARGIN
		local left = corner.X - GAP - w >= MARGIN
		if right or left then
			local h = math.min(natural, math.max(2 * CELL, offer.Y - 2 * MARGIN))
			local y = math.clamp(corner.Y, MARGIN, math.max(MARGIN, offer.Y - h - MARGIN))
			return {
				edge = if right then "right" else "left",
				x = if right then corner.X + size.X + GAP else corner.X - GAP - w,
				y = y,
				w = w,
				h = h,
			}
		end
		if below >= above then
			return { edge = "bottom", x = x, y = corner.Y + size.Y + GAP, w = w, h = math.max(2 * CELL, below) }
		end
		local h = math.max(2 * CELL, above)
		return { edge = "top", x = x, y = corner.Y - GAP - h, w = w, h = h }
	end

	local root: Frame
	local parts: { Shared.Child } = {}
	if labelled then
		table.insert(
			parts,
			ctx.text({
				Name = "Title",
				Text = function(use: Use)
					return chrome.labelText(spec, use)
				end,
				Size = D2.new(0, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.XY,
				TextTruncate = E.TextTruncate.AtEnd,
				Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }) :: Shared.Child,
			})
		)
	end
	local edge = if labelled then 24 else 32
	table.insert(parts, kit.swatch("Swatch", D2.fromOffset(edge, edge), state.currentPaint))
	if labelled then
		table.insert(
			parts,
			ctx.styled(
				ctx.text({
					Name = "Value",
					Text = function(use: Use)
						return state.valueText(use)
					end,
					TextTruncate = E.TextTruncate.AtEnd,
				}),
				"secondary"
			)
		)
		table.insert(parts, ctx.icon("chevron.down", { Name = "Chevron" }))
	end
	local row = ctx.row(parts, {
		Name = "Row",
		Size = if labelled then D2.fromScale(1, 1) else D2.fromOffset(0, 0),
		AutomaticSize = if labelled then E.AutomaticSize.None else E.AutomaticSize.XY,
		ctx.padding(if labelled then 10 else 6, 0) :: Shared.Child,
	})
	local layout = assert(row:FindFirstChildWhichIsA("UIListLayout"))
	layout.VerticalAlignment = E.VerticalAlignment.Center
	layout.HorizontalAlignment = if labelled then E.HorizontalAlignment.Left else E.HorizontalAlignment.Center
	local well = UI.Button("Well")({
		name = function(use: Use): string
			return state.semanticName(use)
		end,
		appearance = if labelled then nil else "utility",
		enabled = function(use: Use): boolean
			return enabled(use)
		end,
		Size = function(use: Use)
			local height = math.max(CELL, (ctx.controlSize(spec.controlSize, "height", use)))
			return if labelled then D2.new(1, 0, 0, height) else D2.fromOffset(CELL, CELL)
		end,
		AutomaticSize = E.AutomaticSize.None,
		onActivate = function()
			requestPresented(true)
		end,
		row,
	})
	if labelled then
		chrome.paint("ColorPicker", well, spec)
	end
	if spec.hint ~= nil or spec.errorText ~= nil then
		root = chrome.wrap({
			control = "ColorPicker",
			spec = { hint = spec.hint, errorText = spec.errorText },
			plate = well,
			focus = function()
				requestPresented(true)
			end,
			enabled = enabled,
			native = rootProps,
		})
	else
		root = ctx.column({ well }, rootProps)
	end
	local anchorAvailable = surfaces.available(well)
	local anchorSeen = false
	Compose.watch(function(use: Use)
		if use(anchorAvailable) then
			anchorSeen = true
		elseif anchorSeen and presented() then
			close("anchorLost")
		end
	end)
	surfaces.attach(root, {
		surfaces.overlay(well, presented, function()
			local layer = surfaces.parent(well)
			local extent = if layer then ctx.observe.AbsoluteSize(layer) else Compose.cell(V2.zero)
			local origin = if layer then ctx.observe.AbsolutePosition(layer) else Compose.cell(V2.zero)
			local at, bounds = ctx.observe.AbsolutePosition(well), ctx.observe.AbsoluteSize(well)
			local tenFoot = ctx.tenFoot()
			local function sheet(use: Use): boolean
				local offer = use(extent)
				return tenFoot(use) or (touch(use) and offer.X > 0 and offer.X < 600)
			end
			local room = Compose.cell(math.huge)
			local view = panelView(true, sheet, room)
			local where = Compose.formula(function(use: Use): Placement
				return place(use, view, sheet, extent, origin, at, bounds, tenFoot(use))
			end)
			Compose.watch(function(use: Use)
				local spot = use(where)
				room:set(spot.h - view.chrome(use))
				placement:set(spot.edge)
			end)
			Compose.cleanup(function()
				placement:set("closed")
			end)
			runtime.decorate(view.panel, {
				Size = function(use: Use)
					local spot = use(where)
					return D2.fromOffset(spot.w, spot.h)
				end,
				Position = function(use: Use)
					local spot = use(where)
					return D2.fromOffset(spot.x, spot.y)
				end,
				Attributes = {
					placement = function(use: Use): string
						return use(where).edge
					end,
				} :: Shared.Attributes,
			})
			local settled = rest(ctx, function(): (string, boolean)
				local spot = where:peek()
				local technique = view.panel:FindFirstChild("Technique", true) :: GuiObject
				local size = technique.AbsoluteSize
				local modes = view.panel:FindFirstChild("Modes", true)
				local strip = if modes then modes:FindFirstChildWhichIsA("UIListLayout", true) else nil
				local wrapped = true
				local rows = ""
				if modes and modes:IsA("GuiObject") and strip then
					local picker = strip.Parent
					local held = if picker and picker:IsA("GuiObject") then picker.AbsoluteSize.Y else 0
					wrapped = strip.AbsoluteContentSize.Y <= held + 1
					rows = `{strip.AbsoluteContentSize.Y}:{held}`
				end
				local position, bounds = view.panel.AbsolutePosition, view.panel.AbsoluteSize
				return `{spot.x}:{spot.y}:{spot.w}:{spot.h}:{columns:peek()}:{size}:{rows}:{position}:{bounds}`,
					wrapped and size.X > 0 and size.Y > 0 and spot.w > 0 and spot.h > 0
			end)
			ctx.fadeTo(view.panel, function(use: Use): number
				return if use(settled) then 0 else 1
			end)
			ctx.styled(view.panel, "panel")
			surfaces.skin(view.panel)
			return surfaces.modal(function()
				return view.panel
			end, function()
				close("cancel")
			end, {
				Name = "ColorPickerModal",
				backgroundTransparency = function(use: Use): number
					return if sheet(use) then 0.5 else 1
				end,
				onOutside = function()
					close("outside")
				end,
			})
		end),
	})
	return root
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">color_value</string>
              <string name="Source"><![CDATA[--!strict
export type Hsv = { h: number, s: number, v: number }
export type Swatch = { color: Color3, label: string?, key: string }
type Ranked = { swatch: Swatch, order: { number } }
export type Engine = { Color3: typeof(Color3), BrickColor: typeof(BrickColor)? }
export type ColorValue = {
	byte: (number) -> number,
	channels: (Color3) -> (number, number, number),
	hex: (Color3, number?) -> string,
	same: (Color3?, Color3?) -> boolean,
	parseHex: (string, boolean) -> (Color3?, number?, string?),
	hsvOf: (Color3, Hsv?) -> Hsv,
	fromBytes: (number, number, number) -> Color3,
	toColor: (Hsv) -> Color3,
	standard: (number?) -> { Swatch },
	brick: () -> { Swatch },
}

local function byte(x: number): number
	return math.clamp(math.floor(x * 255 + 0.5), 0, 255)
end

return function(engine: Engine): ColorValue
	local color = {} :: ColorValue
	color.byte = byte
	function color.channels(c: Color3): (number, number, number)
		return byte(c.R), byte(c.G), byte(c.B)
	end
	function color.hex(c: Color3, alpha: number?): string
		local r, g, b = color.channels(c)
		local out = string.format("#%02X%02X%02X", r, g, b)
		return if alpha ~= nil then out .. string.format("%02X", byte(alpha)) else out
	end
	function color.same(a: Color3?, b: Color3?): boolean
		if a == nil or b == nil then
			return a == b
		end
		local ar, ag, ab = color.channels(a)
		local br, bg, bb = color.channels(b)
		return ar == br and ag == bg and ab == bb
	end
	function color.fromBytes(r: number, g: number, b: number): Color3
		return engine.Color3.fromRGB(r, g, b)
	end
	function color.parseHex(text: string, allowAlpha: boolean): (Color3?, number?, string?)
		local digits = if string.sub(text, 1, 1) == "#" then string.sub(text, 2) else text
		if string.match(digits, "^%x+$") == nil then
			return nil,
				nil,
				if allowAlpha then "Use hex digits: #RGB, #RRGGBB or #RRGGBBAA." else "Use hex digits: #RGB or #RRGGBB."
		end
		if #digits == 3 then
			digits = string.gsub(digits, "%x", "%0%0")
		end
		if #digits == 8 and not allowAlpha then
			return nil, nil, "This colour has no opacity: use #RRGGBB."
		end
		if #digits ~= 6 and #digits ~= 8 then
			return nil, nil, if allowAlpha then "Use #RGB, #RRGGBB or #RRGGBBAA." else "Use #RGB or #RRGGBB."
		end
		local function at(i: number): number
			return tonumber(string.sub(digits, i, i + 1), 16) :: number
		end
		local alpha = if #digits == 8 then at(7) / 255 else nil
		return color.fromBytes(at(1), at(3), at(5)), alpha, nil
	end
	function color.hsvOf(c: Color3, previous: Hsv?): Hsv
		local h, s, v = c:ToHSV()
		if previous ~= nil then
			if v == 0 then
				h, s = previous.h, previous.s
			elseif s == 0 then
				h = previous.h
			end
		end
		return { h = h, s = s, v = v }
	end
	function color.toColor(hsv: Hsv): Color3
		return engine.Color3.fromHSV(math.clamp(hsv.h, 0, 1), math.clamp(hsv.s, 0, 1), math.clamp(hsv.v, 0, 1))
	end
	function color.standard(hues: number?): { Swatch }
		local n = math.max(2, hues or 8)
		local out: { Swatch } = {}
		for _, step in { { 0.35, 1 }, { 0.65, 1 }, { 1, 1 }, { 1, 0.8 }, { 1, 0.55 } } do
			for i = 0, n - 1 do
				local c = color.toColor({ h = i / n, s = step[1], v = step[2] })
				table.insert(out, { color = c, key = color.hex(c) })
			end
		end
		for i = 0, n - 1 do
			local c = color.toColor({ h = 0, s = 0, v = i / (n - 1) })
			table.insert(out, { color = c, key = color.hex(c) })
		end
		return out
	end
	local brickCache: { Swatch }? = nil
	function color.brick(): { Swatch }
		if brickCache ~= nil then
			return brickCache
		end
		local palette = assert(engine.BrickColor, "Facet ColorPicker: the brick mode requires BrickColor")
		local out: { Ranked } = {}
		for i = 0, 127 do
			local brick = palette.palette(i)
			local c = brick.Color
			local h, s, v = c:ToHSV()
			table.insert(out, {
				swatch = { color = c, label = brick.Name, key = brick.Name },
				order = { if s < 0.08 then 0 else 1, if s < 0.08 then 0 else h, v, i },
			})
		end
		table.sort(out, function(a: Ranked, b: Ranked): boolean
			for k = 1, 4 do
				if a.order[k] ~= b.order[k] then
					return a.order[k] < b.order[k]
				end
			end
			return false
		end)
		local list: { Swatch } = {}
		for _, entry in out do
			table.insert(list, entry.swatch)
		end
		brickCache = list
		return list
	end
	return color
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">command_scope</string>
              <string name="Source"><![CDATA[--!strict
local Shared = require("./types")
local Commands = require("./command_types")
local ComposeTypes = require("../vendor/compose/core")
local gestureOf = require("./gesture_service")
type Record = { node: GuiObject, active: (ComposeTypes.Use) -> boolean }
local registries = setmetatable({} :: { [Shared.Context]: Shared.Cell<{ Record }> }, { __mode = "k" })

return function(ctx: Shared.Context, UI: Commands.Controls)
	local C, runtime, input, gui = ctx.Compose, ctx.runtime, ctx.config.userInputService, ctx.config.guiService
	local registry = registries[ctx]
	if registry == nil then
		registry = C.cell({} :: { Record })
		registries[ctx] = registry
	end
	local scopes = registry :: Shared.Cell<{ Record }>
	UI.commandScope = function<K>(root: GuiObject, spec: Commands.CommandSpec<K>): Commands.CommandScope<K>
		local arbiter = gestureOf(ctx)
		local owner = assert(C.currentOwner(), "Facet commandScope requires a Compose owner")
		local current = C.cell(nil :: K?)
		local version, typing = C.cell(0), C.cell(input ~= nil and not not input:GetFocusedTextBox())
		local selected: Shared.Readable<GuiObject?> = if gui
			then ctx.observe.SelectedObject(gui)
			else C.cell(nil :: GuiObject?)
		local actions: { [string]: InputAction } = {}
		local function refresh()
			version:update(function(value)
				return value + 1
			end)
		end
		local function available(node: GuiObject, use: Shared.Use?): boolean
			if root.Parent == nil or not ctx.available(node, use) then
				return false
			end
			local at: Instance? = node
			while at do
				if at:IsA("GuiObject") then
					local visible = if use then use(ctx.observe.Visible(at)) else at.Visible
					local interactable = if use then use(ctx.observe.Interactable(at)) else at.Interactable
					if not visible or not interactable then
						return false
					end
				end
				if at == root then
					return true
				end
				at = at.Parent
			end
			return false
		end
		local function targetKey(use: Shared.Use): K?
			use(version)
			local node = use(selected)
			if node == nil or not available(node, use) then
				return nil
			end
			local targets = ctx.read(spec.targets, use)
			local at: Instance? = node
			while at do
				for _, target in targets do
					if target.node == at and available(target.node, use) then
						return target.key
					end
				end
				if at == root then
					break
				end
				at = at.Parent
			end
			return nil
		end
		runtime.connect(root, "AncestryChanged", refresh)
		C.watch(function(use: Shared.Use)
			current:set(targetKey(use))
		end)
		if input then
			runtime.connect(input, "TextBoxFocused", function()
				typing:set(true)
			end)
			runtime.connect(input, "TextBoxFocusReleased", function()
				typing:set(not not input:GetFocusedTextBox())
			end)
		end
		local record: Record = {
			node = root,
			active = function(use: Shared.Use): boolean
				return not owner.isDisposed()
					and use(current) ~= nil
					and not use(typing)
					and ctx.read(spec.enabled, use) ~= false
					and ctx.available(root, use)
			end,
		}
		scopes:update(function(values)
			local next = table.clone(values)
			table.insert(next, record)
			return next
		end)
		C.cleanup(function()
			scopes:update(function(values)
				local next: { Record } = {}
				for _, value in values do
					if value ~= record then
						table.insert(next, value)
					end
				end
				return next
			end)
			current:set(nil)
		end)
		local function wins(use: Shared.Use): boolean
			if not record.active(use) then
				return false
			end
			for _, candidate in use(scopes) do
				if candidate ~= record and candidate.node:IsDescendantOf(root) and candidate.active(use) then
					return false
				end
			end
			return true
		end
		local function selectable(node: Instance): GuiObject?
			if node:IsA("GuiObject") and not available(node) then
				return nil
			end
			if node:IsA("GuiObject") and node.Selectable then
				return node
			end
			for _, child in node:GetChildren() do
				local found = selectable(child)
				if found then
					return found
				end
			end
			return nil
		end
		local targetsOwner: ComposeTypes.Owner?
		C.watch(function(use: Shared.Use)
			local targets = ctx.read(spec.targets, use)
			if targetsOwner then
				targetsOwner.dispose()
			end
			local child = owner.createChild()
			targetsOwner = child
			C.withOwner(child, function()
				local keys: { [K]: boolean } = {}
				local nodes: { [GuiObject]: boolean } = {}
				for _, target in targets do
					assert(
						not keys[target.key] and not nodes[target.node],
						"Facet commandScope targets must have unique keys and nodes"
					)
					keys[target.key], nodes[target.node] = true, true
					runtime.connect(target.node, "AncestryChanged", refresh)
					runtime.connect(target.node, "SelectionGained", refresh)
					runtime.connect(target.node, "InputBegan", function(event: InputObject)
						local contact = arbiter.get(event)
						if
							contact
							and contact.owner ~= target.node
							and not contact.owner:IsDescendantOf(target.node)
						then
							return
						end
						if
							gui
							and ctx.effectiveInput()() ~= "Touch"
							and ctx.read(spec.enabled) ~= false
							and available(target.node)
							and (
								event.UserInputType == ctx.types.Enum.UserInputType.Touch
								or event.UserInputType == ctx.types.Enum.UserInputType.MouseButton1
							)
						then
							local node = selectable(target.node)
							if node then
								gui.SelectedObject = node
							end
						end
					end)
				end
			end)
			refresh()
		end)
		C.cleanup(function()
			if targetsOwner then
				targetsOwner.dispose()
			end
		end)
		local supportedKeys: { [string]: boolean } = {}
		for _, key in ctx.types.Enum.KeyCode:GetEnumItems() do
			supportedKeys[key.Name] = true
		end
		local ids, bound = {} :: { [string]: boolean }, {} :: { [string]: boolean }
		for _, command in spec.commands do
			assert(command.id ~= "" and not ids[command.id], "Facet commandScope command ids must be unique")
			assert(#command.keys > 0, "Facet commandScope commands require keys")
			ids[command.id] = true
			for _, key in command.keys do
				assert(supportedKeys[key], "Facet commandScope has an unknown KeyCode")
				assert(not bound[key], "Facet commandScope keys belong to one command")
				bound[key] = true
			end
			local enabled = function(use: Shared.Use): boolean
				return wins(use) and ctx.read(command.enabled, use) ~= false
			end
			actions[command.id] = ctx.action(root, command.id, command.keys, enabled, function()
				local key = current:peek()
				if key ~= nil and (not input or not input:GetFocusedTextBox()) then
					command.onInvoke(key)
				end
			end, { group = "Commands", priority = 1500, sink = true, capture = true })
		end

		return {
			current = current,
			actions = actions,
			focus = function(key: K): boolean
				if owner.isDisposed() or gui == nil or ctx.read(spec.enabled) == false then
					return false
				end
				for _, target in ctx.read(spec.targets) do
					if target.key == key then
						local node = selectable(target.node)
						if node then
							gui.SelectedObject = node
							return true
						end
					end
				end
				return false
			end,
			clear = function()
				if not owner.isDisposed() and gui and current:peek() ~= nil then
					gui.SelectedObject = nil
				end
			end,
		}
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">command_types</string>
              <string name="Source"><![CDATA[--!strict
local Shared = require("./types")

export type CommandTarget<K> = { key: K, node: GuiObject }
export type Command<K> = {
	id: string,
	keys: { string },
	enabled: Shared.ValueBoolean?,
	onInvoke: (K) -> (),
}
export type CommandSpec<K> = {
	targets: Shared.Value<{ CommandTarget<K> }>,
	commands: { Command<K> },
	enabled: Shared.ValueBoolean?,
}
export type CommandScope<K> = {
	current: Shared.Readable<K?>,
	focus: (K) -> boolean,
	clear: () -> (),
	actions: { [string]: InputAction },
}
export type Controls = {
	commandScope: <K>(GuiObject, CommandSpec<K>) -> CommandScope<K>,
}
return {}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">composition</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local Layout = require("./layout_types")
local Overlay = require("./overlay_types")
local layoutKit = require("./layout_kit")
local reducedMotion = require("./motion").reduced
local resolver = require("./composition_resolve")
local ControlTypes = require("./control_types")
local LayoutProps = require("./layout_props")

type Declared = {
	zone: Layout.Zone,
	rank: number,
	mayDrop: boolean,
	sizes: { ComposeTypes.Cell<Vector2> },
	form: ComposeTypes.Cell<number>,
	animate: boolean,
	reveal: { host: (Instance) -> (), back: () -> () }?,
}

local EXPAND_EDGE: { Overlay.Edge } = { "trailing", "bottom", "leading" }

return function(ctx: Types.Context, UI: ControlTypes.Controls)
	local Host, read, Compose, runtime = ctx.Host, ctx.read, ctx.Compose, ctx.runtime
	local kit = layoutKit.of(ctx)
	local E, D, D2, V2 = ctx.types.Enum, ctx.types.UDim, ctx.types.UDim2, ctx.types.Vector2
	local declared = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [Instance]: Declared }

	UI.Region = ctx.construct("Region", function(spec: LayoutProps.RegionProps): Frame
		local zone, rank = spec.zone, spec.rank
		assert(
			type(zone) == "string" and resolver.CELLS[zone] ~= nil,
			"Facet Region zone must be topLeft, top, topRight, left, center, right, bottomLeft, bottom, bottomRight or topbar"
		)
		assert(
			type(rank) == "number" and rank >= 1 and rank % 1 == 0,
			"Facet Region rank must be a whole number, 1 or more"
		)
		assert(spec.mayDrop == nil or type(spec.mayDrop) == "boolean", "Facet Region mayDrop must be a boolean")
		assert(
			spec.form == nil or (Compose.isReadable(spec.form) and type(spec.form.set) == "function"),
			"Facet Region form must be a writable cell"
		)
		assert(
			spec.expand == nil or type(spec.expand) == "function",
			"Facet Region expand must be a function that returns the richest content"
		)
		assert(spec.reveal == nil or type(spec.reveal) == "boolean", "Facet Region reveal must be a boolean")
		local form: ComposeTypes.Cell<number> = spec.form or Compose.cell(1)
		form:set(1)
		local reduced = reducedMotion(ctx)
		local popSeconds = ctx.metric("motion.durations.regionPop")
		local present = ctx.motionEase("present")
		local pop = runtime.timeline({ duration = popSeconds, autoplay = false })
		pop:seek(popSeconds)
		local scale = Compose.formula(function(use: ComposeTypes.Use): number
			local rest = ctx.metric("motion.materialize.modal", use)
			return if reduced(use) then 1 else rest + (1 - rest) * present(use(pop.progress))
		end)
		local properties = (
			ctx.props(spec, { "zone", "rank", "mayDrop", "form", "expand", "reveal" }, {
				BorderSizePixel = 0,
				Size = D2.new(),
				AutomaticSize = E.AutomaticSize.XY,
				Visible = function(use: ComposeTypes.Use): boolean
					return use(form) > 0
				end,
			}) :: unknown
		) :: Types.FrameNativeProps
		local open, hosted = Compose.cell(false), Compose.cell(false)
		local richest = properties[1] :: GuiObject?
		if spec.mayDrop == true and spec.reveal ~= false then
			properties[#properties + 1] = ctx.styled(
				Host.Frame "Reveal" {
					Size = D2.fromOffset(28, 20),
					Host.UICorner({ CornerRadius = ctx.round }),
					ctx.icon("more", {
						AnchorPoint = V2.new(0.5, 0.5),
						Position = D2.fromScale(0.5, 0.5),
						Size = D2.fromOffset(16, 16),
					}),
				},
				"badge"
			)
		end
		local sizes: { ComposeTypes.Cell<Vector2> } = {}
		for index = 1, #properties do
			local child = properties[index] :: GuiObject
			assert(
				type(child) ~= "string" and type(child.IsA) == "function" and child:IsA("GuiObject"),
				"Facet Region forms must be GuiObjects, richest first"
			)
			local observed, settled = ctx.layoutSize(child), Compose.cell(V2.zero)
			Compose.watch(function(use: ComposeTypes.Use)
				local size = use(observed)
				if use(scale) == 1 and not (index == 1 and use(hosted)) then
					settled:set(size)
				end
			end)
			sizes[index] = settled
			properties[index] = Host.Frame("Form" .. index)({
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = D2.new(),
				AutomaticSize = E.AutomaticSize.XY,
				Visible = function(use: ComposeTypes.Use): boolean
					return use(form) == index
				end,
				child,
			})
		end
		assert(#sizes > 0, "Facet Region needs at least one form")
		local floor = ctx.hitFloor()
		properties[#properties + 1] = Host.UIScale "Pop" { Scale = scale }
		local owner = assert(Compose.currentOwner())
		local home = properties[1] :: Instance
		local function returnHome()
			if owner.isDisposed() then
				return
			end
			local content = assert(richest)
			if content.Parent ~= home then
				content.Parent = home
			end
			hosted:set(false)
		end
		local function hostInto(parent: Instance)
			if spec.expand then
				spec.expand().Parent = parent
				return
			end
			hosted:set(true)
			assert(richest).Parent = parent
		end
		if spec.reveal ~= false and (#sizes > 1 or spec.expand) then
			local content = spec.expand
				or function(): Instance
					local holder = Host.Frame "Hosted" {
						BackgroundTransparency = 1,
						Size = D2.new(),
						AutomaticSize = E.AutomaticSize.XY,
					}
					hostInto(holder)
					Compose.cleanup(returnHome)
					return holder
				end
			local cell = resolver.CELLS[zone]
			local edge: Overlay.Edge = if cell[1] == 2 and cell[2] == 3 then "top" else EXPAND_EDGE[cell[1]]
			Compose.watch(function(use: ComposeTypes.Use)
				if use(form) <= 1 and open:peek() then
					open:set(false)
				end
			end)
			properties[#properties + 1] = UI.Popover "Expand" {
				isPresented = open,
				onPresentedChange = function(value: boolean)
					open:set(value and form:peek() > 1)
				end,
				compact = "popover" :: "popover",
				edge = edge,
				content = content,
				trigger = Host.TextButton "Expand" {
					Text = "",
					BackgroundTransparency = 1,
					ZIndex = -1,
					AnchorPoint = V2.new(0.5, 0.5),
					Position = D2.fromScale(0.5, 0.5),
					Size = D2.fromScale(1, 1),
					Visible = function(use: ComposeTypes.Use): boolean
						return use(form) > 1
					end,
				},
			}
		end
		if spec.Size == nil and spec.AutomaticSize == nil then
			properties.AutomaticSize = E.AutomaticSize.None
			properties.Size = function(use: ComposeTypes.Use): UDim2
				local index = use(form)
				local shown = sizes[index]
				local size = if shown then use(shown) else V2.zero
				local minimum = if index > 1
						and spec.reveal ~= false
						and (#sizes > 1 or spec.expand)
					then floor(use)
					else 0
				return D2.fromOffset(math.max(size.X, minimum), math.max(size.Y, minimum))
			end
		end
		local node = kit.plain(Host.Frame(properties), spec)
		local shown: number? = nil
		Compose.watch(function(use: ComposeTypes.Use)
			local current = use(form)
			node:SetAttribute("FacetForm", current)
			if shown ~= nil and current > 0 and current ~= shown and declared[node].animate and not reduced() then
				pop:restart()
			end
			shown = current
		end)
		declared[node] = {
			zone = zone :: Layout.Zone,
			rank = rank,
			mayDrop = spec.mayDrop == true,
			sizes = sizes,
			form = form,
			animate = false,
			reveal = if spec.reveal ~= false and spec.mayDrop == true
				then { host = hostInto, back = returnHome }
				else nil,
		}
		return node
	end)

	local function zoneFrame(
		name: string,
		column: number,
		row: number,
		gap: Types.Value<Types.Space>,
		children: { Frame }
	): Frame
		local fields: Types.FrameNativeProps = {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AnchorPoint = V2.new((column - 1) / 2, (row - 1) / 2),
			Position = D2.fromScale((column - 1) / 2, (row - 1) / 2),
			Size = D2.new(),
			AutomaticSize = E.AutomaticSize.XY,
			Host.UIListLayout({
				SortOrder = E.SortOrder.LayoutOrder,
				HorizontalAlignment = if column == 1
					then E.HorizontalAlignment.Left
					elseif column == 2 then E.HorizontalAlignment.Center
					else E.HorizontalAlignment.Right,
				Padding = function(use: ComposeTypes.Use): UDim
					return D.new(0, kit.spacing(gap, use))
				end,
			}),
		}
		for _, child in children do
			fields[#fields + 1] = child
		end
		return Host.Frame(name)(fields)
	end

	UI.Composition = ctx.construct("Composition", function(spec: LayoutProps.CompositionProps): Frame
		local properties = (ctx.props(spec, { "gap", "padding", "topbar" }) :: unknown) :: Types.FrameNativeProps
		local regions: { Frame } = {}
		local helpers: { Instance } = {}
		for index = 1, #properties do
			local child = properties[index] :: GuiObject
			if declared[child] then
				table.insert(regions, child :: Frame)
			else
				assert(
					type(child) == "table" or typeof(child) == "Instance",
					"Facet Composition children must be UI.Region nodes"
				)
				assert(
					type(child.IsA) == "function" and child:IsA("UIFlexItem"),
					"Facet Composition children must be UI.Region nodes or a UIFlexItem"
				)
				table.insert(helpers, child)
			end
			properties[index] = nil
		end
		for _, helper in helpers do
			properties[#properties + 1] = helper
		end
		local gap: Types.Value<Types.Space> = if spec.gap == nil then "s" else spec.gap
		local base: Types.Value<Types.Padding> = if spec.padding == nil then "s" else spec.padding
		local under = Compose.cell(0)
		properties.BorderSizePixel = 0
		properties.Size = if properties.Size == nil then D2.fromScale(1, 1) else properties.Size
		properties[#properties + 1] = kit.insets(function(use: ComposeTypes.Use): Types.Padding
			local value = read(base, use)
			local sides: Types.Sides = if type(value) == "table"
				then value :: Types.Sides
				else { top = value, right = value, bottom = value, left = value }
			return {
				top = kit.spacing(sides.top, use) + use(under),
				right = sides.right,
				bottom = sides.bottom,
				left = sides.left,
			}
		end)
		local members: { [string]: { Frame } } = {}
		local stripRegions: { Frame } = {}
		for order, region in regions do
			local zone = declared[region].zone
			region.LayoutOrder = order
			local home = if zone == "topbar" then "top" else zone
			members[home] = members[home] or {}
			if zone == "topbar" then
				table.insert(stripRegions, region)
			else
				table.insert(members[home], region)
			end
		end
		local zones: { [string]: Frame } = {}
		local placed: { Frame } = {}
		for zone, children in members do
			local cell = resolver.CELLS[zone]
			local frame =
				zoneFrame(string.upper(string.sub(zone, 1, 1)) .. string.sub(zone, 2), cell[1], cell[2], gap, children)
			zones[zone] = frame
			table.insert(placed, frame)
		end
		local safe = Host.Frame "Zones" {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = D2.fromScale(1, 1),
			table.unpack(placed),
		}
		properties[#properties + 1] = safe
		local root = kit.plain(Host.Frame(properties), spec)
		kit.underTopbar(root, under)
		local riding: (ComposeTypes.Use) -> boolean = function()
			return false
		end
		local stripGui: ScreenGui? = nil
		if #stripRegions > 0 then
			local screen: ComposeTypes.Cell<ScreenGui?> = Compose.cell(nil :: ScreenGui?)
			local holder: ComposeTypes.Cell<Instance?> = Compose.cell(nil :: Instance?)
			local enabled = Compose.cell(true)
			local watched: RBXScriptConnection? = nil
			local function locate()
				local host = root:FindFirstAncestorWhichIsA("ScreenGui")
				if host ~= screen:peek() then
					if watched then
						watched:Disconnect()
						watched = nil
					end
					if host then
						local current = host
						watched = current:GetPropertyChangedSignal("Enabled"):Connect(function()
							enabled:set(current.Enabled)
						end)
						enabled:set(current.Enabled)
					end
				end
				screen:set(host)
				holder:set(if host then host.Parent else nil)
			end
			runtime.connect(root, "AncestryChanged", locate)
			Compose.cleanup(function()
				if watched then
					watched:Disconnect()
				end
			end)
			locate()
			local band = if ctx.config.guiService then ctx.observe.TopbarInset(ctx.config.guiService) else nil
			riding = function(use: ComposeTypes.Use): boolean
				local rect: Rect? = if band then use(band) else nil
				return read(spec.topbar, use) ~= false and use(holder) ~= nil and rect ~= nil and rect.Width > 0
			end
			local topbarZone = Host.Frame "Topbar" {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				LayoutOrder = 0,
				Size = function(use: ComposeTypes.Use): UDim2
					return if riding(use) then D2.fromScale(1, 1) else D2.new()
				end,
				AutomaticSize = function(use: ComposeTypes.Use): Enum.AutomaticSize
					return if riding(use) then E.AutomaticSize.None else E.AutomaticSize.XY
				end,
				Host.UIListLayout({
					FillDirection = function(use: ComposeTypes.Use): Enum.FillDirection
						return if riding(use) then E.FillDirection.Horizontal else E.FillDirection.Vertical
					end,
					SortOrder = E.SortOrder.LayoutOrder,
					HorizontalAlignment = E.HorizontalAlignment.Center,
					VerticalAlignment = E.VerticalAlignment.Center,
					Padding = function(use: ComposeTypes.Use): UDim
						return D.new(0, kit.spacing(gap, use))
					end,
				}),
				table.unpack(stripRegions),
			}
			local created = Host.ScreenGui "CompositionTopbar" {
				ResetOnSpawn = false,
				ZIndexBehavior = E.ZIndexBehavior.Sibling,
				ScreenInsets = E.ScreenInsets.TopbarSafeInsets,
				DisplayOrder = function(use: ComposeTypes.Use): number
					local host = use(screen)
					return if host then host.DisplayOrder else 0
				end,
				Enabled = enabled,
				Host.StyleLink({
					StyleSheet = function(use: ComposeTypes.Use): StyleSheet?
						local host = use(screen)
						local link = host and host:FindFirstChildWhichIsA("StyleLink")
						return if link then link.StyleSheet else nil
					end,
				}),
			}
			stripGui = created
			runtime.decorate(created, {
				Parent = function(use: ComposeTypes.Use): Instance?
					return if riding(use) then use(holder) else nil
				end,
			})
			runtime.decorate(topbarZone, {
				Parent = function(use: ComposeTypes.Use): Instance?
					return if riding(use) then created else zones.top
				end,
			})
		end
		local safeUnit = ctx.layoutUnit(safe)
		local floor = ctx.hitFloor()
		local safeBox = ctx.layoutSize(safe, safeUnit)
		for zone, children in members do
			local revealing = false
			for _, region in children do
				revealing = revealing or declared[region].reveal ~= nil
			end
			if not revealing then
				continue
			end
			local cell = resolver.CELLS[zone]
			local column, row = cell[1], cell[2]
			local frame = zones[zone]
			local zoneSize = ctx.observe.AbsoluteSize(frame)
			local anchor = V2.new((column - 1) / 2, (row - 1) / 2)
			local dropped = Compose.formula(function(use: ComposeTypes.Use): { Frame }
				local list = {}
				for _, region in children do
					local entry = declared[region]
					if entry.reveal and use(entry.form) == 0 then
						table.insert(list, region)
					end
				end
				return list
			end)
			local open = Compose.cell(false)
			local hosting: { Frame } = {}
			local function release()
				for _, region in hosting do
					assert(declared[region].reveal).back()
				end
				hosting = {}
			end
			local gathered = dropped:peek()
			Compose.watch(function(use: ComposeTypes.Use)
				local list = use(dropped)
				local same = #list == #gathered
				for index, region in list do
					same = same and gathered[index] == region
				end
				gathered = list
				if not same and open:peek() then
					open:set(false)
				end
			end)
			local function place(use: ComposeTypes.Use): (UDim2, Vector2)
				local unit, space = use(safeUnit), kit.spacing(gap, use)
				local size = use(zoneSize) / unit
				local at = (use(safeBox) - size) * anchor
				if column == 2 then
					return if row == 3
						then D2.fromOffset(at.X + size.X / 2, at.Y - space)
						else D2.fromOffset(at.X + size.X / 2, at.Y + size.Y + space),
						V2.new(0.5, if row == 3 then 1 else 0)
				end
				local x = if column == 1 then at.X + size.X + space else at.X - space
				return D2.fromOffset(x, at.Y + size.Y * (row - 1) / 2),
					V2.new(if column == 1 then 0 else 1, (row - 1) / 2)
			end
			runtime.mount(function()
				return UI.Popover("Hidden" .. frame.Name) {
					isPresented = open,
					onPresentedChange = function(value: boolean)
						open:set(value and #dropped:peek() > 0)
					end,
					compact = "popover" :: "popover",
					edge = (if column == 2 and row == 3 then "top" else EXPAND_EDGE[column]) :: Overlay.Edge,
					content = function(): Instance
						release()
						local slots: Types.FrameNativeProps = {
							Name = "ZoneHidden",
							BackgroundTransparency = 1,
							Size = D2.new(),
							AutomaticSize = E.AutomaticSize.XY,
							Host.UIListLayout({
								SortOrder = E.SortOrder.LayoutOrder,
								Padding = function(use: ComposeTypes.Use): UDim
									return D.new(0, kit.spacing(gap, use))
								end,
							}),
						}
						local slotFrames = {}
						for index, region in dropped:peek() do
							local slot = Host.Frame("Hidden" .. region.Name)({
								LayoutOrder = index,
								BackgroundTransparency = 1,
								Size = D2.new(),
								AutomaticSize = E.AutomaticSize.XY,
							})
							slots[#slots + 1] = slot
							slotFrames[region] = slot
						end
						local holder = Host.Frame(slots)
						for region, slot in slotFrames do
							assert(declared[region].reveal).host(slot)
							table.insert(hosting, region)
						end
						Compose.cleanup(release)
						return holder
					end,
					trigger = Host.TextButton("ZoneReveal" .. frame.Name) {
						Text = "",
						BackgroundTransparency = 1,
						ZIndex = 5,
						Size = function(use: ComposeTypes.Use): UDim2
							return D2.fromOffset(floor(use), floor(use))
						end,
						Position = function(use: ComposeTypes.Use): UDim2
							return (place(use))
						end,
						AnchorPoint = function(use: ComposeTypes.Use): Vector2
							local _, anchor = place(use)
							return anchor
						end,
						Visible = function(use: ComposeTypes.Use): boolean
							return #use(dropped) > 0
						end,
						ctx.styled(
							Host.Frame "Badge" {
								AnchorPoint = V2.new(0.5, 0.5),
								Position = D2.fromScale(0.5, 0.5),
								Size = D2.fromOffset(28, 20),
								Host.UICorner({ CornerRadius = ctx.round }),
								ctx.icon("more", {
									AnchorPoint = V2.new(0.5, 0.5),
									Position = D2.fromScale(0.5, 0.5),
									Size = D2.fromOffset(16, 16),
								}),
							},
							"badge"
						),
					},
				}
			end, safe)
		end
		local box = ctx.layoutSize(safe, safeUnit)
		local last: Vector2? = nil
		local stripUnit = if stripGui then ctx.layoutUnit(stripGui) else nil
		local stripSize = if stripGui then ctx.layoutSize(stripGui, stripUnit) else nil
		Compose.watch(function(use: ComposeTypes.Use)
			local extent = use(box)
			local rides = riding(use)
			local list: { resolver.Declared } = {}
			for index, region in regions do
				local entry = declared[region]
				local measured = {}
				for form, observed in entry.sizes do
					local value = use(observed)
					measured[form] = { x = value.X, y = value.Y }
				end
				list[index] = { zone = entry.zone, rank = entry.rank, mayDrop = entry.mayDrop, sizes = measured }
			end
			local band = if stripSize and rides then use(stripSize) else nil
			local chosen = resolver.resolve(
				extent.X,
				extent.Y,
				kit.spacing(gap, use),
				list,
				if band and band.X > 0 then { x = band.X, y = band.Y } else nil
			)
			local moved = last ~= nil and last.X > 0 and last ~= extent
			last = extent
			for index, region in regions do
				declared[region].animate = moved
				declared[region].form:set(chosen[index])
			end
		end)
		return root
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">composition_resolve</string>
              <string name="Source"><![CDATA[--!strict
export type Zone =
	"topLeft"
	| "top"
	| "topRight"
	| "left"
	| "center"
	| "right"
	| "bottomLeft"
	| "bottom"
	| "bottomRight"
	| "topbar"
export type Declared = {
	zone: Zone,
	rank: number,
	mayDrop: boolean,
	sizes: { { x: number, y: number } },
}

local CELLS: { [string]: { number } } = {
	topLeft = { 1, 1 },
	top = { 2, 1 },
	topRight = { 3, 1 },
	left = { 1, 2 },
	center = { 2, 2 },
	right = { 3, 2 },
	bottomLeft = { 1, 3 },
	bottom = { 2, 3 },
	bottomRight = { 3, 3 },
	topbar = { 2, 1 },
}

local function cellOf(zone: string, riding: boolean): (number, number)
	if zone == "topbar" and riding then
		return 0, 0
	end
	local cell = CELLS[zone]
	return cell[1], cell[2]
end

return {
	CELLS = CELLS,
	resolve = function(
		width: number,
		height: number,
		gap: number,
		regions: { Declared },
		strip: { x: number, y: number }?
	): { number }
		local forms = table.create(#regions, 1)
		if width <= 0 or height <= 0 then
			return forms
		end
		local lane = (width - 2 * gap) / 3
		local riding = strip ~= nil
		while true do
			local zoneW: { [number]: number }, zoneH: { [number]: number }, members: { [number]: { number } } =
				{}, {}, {}
			for index, region in regions do
				local column, row = cellOf(region.zone, riding)
				local key = column * 4 + row
				members[key] = members[key] or {}
				table.insert(members[key], index)
				local form = forms[index]
				local size = if form > 0 then region.sizes[form] else nil
				if size and size.x > 0 and size.y > 0 then
					if key == 0 then
						zoneW[key] = (zoneW[key] or -gap) + gap + size.x
						zoneH[key] = math.max(zoneH[key] or 0, size.y)
					else
						zoneW[key] = math.max(zoneW[key] or 0, size.x)
						zoneH[key] = (zoneH[key] or -gap) + gap + size.y
					end
				end
			end
			local failing: { [number]: boolean } = {}
			local function fail(key: number, wider: number?)
				for _, index in members[key] or ({} :: { number }) do
					local form = forms[index]
					local size = if form > 0 then regions[index].sizes[form] else nil
					if wider == nil or (size and size.x > wider) then
						failing[index] = true
					end
				end
			end
			local function check(key: number, width: number, tall: number)
				if (zoneH[key] or 0) > tall then
					fail(key)
				elseif (zoneW[key] or 0) > width then
					fail(key, width)
				end
			end
			if strip then
				if (zoneW[0] or 0) > strip.x then
					fail(0)
				elseif (zoneH[0] or 0) > strip.y then
					for _, index in members[0] or ({} :: { number }) do
						local form = forms[index]
						local size = if form > 0 then regions[index].sizes[form] else nil
						if size and size.y > strip.y then
							failing[index] = true
						end
					end
				end
			end
			for column = 1, 3 do
				local top, middle, bottom = column * 4 + 1, column * 4 + 2, column * 4 + 3
				for row, key in { top, middle, bottom } do
					local room = lane
					if column == 2 then
						local side = math.max(zoneW[4 + row] or 0, zoneW[12 + row] or 0)
						room = math.max(lane, width - 2 * (side + gap))
						local wide = zoneW[key] or 0
						if wide > room and wide <= width - 2 * gap and (zoneH[key] or 0) <= height then
							local spare = (width - wide) / 2 - gap
							fail(4 + row, spare)
							fail(12 + row, spare)
						end
					end
					check(key, room, height)
				end
				local h1, h2, h3 = zoneH[top] or 0, zoneH[middle] or 0, zoneH[bottom] or 0
				if h2 > 0 then
					if h1 > 0 and h1 + gap > (height - h2) / 2 then
						fail(top)
						fail(middle)
					end
					if h3 > 0 and (height + h2) / 2 + gap > height - h3 then
						fail(bottom)
						fail(middle)
					end
				elseif h1 > 0 and h3 > 0 and h1 + gap + h3 > height then
					fail(top)
					fail(bottom)
				end
			end
			local chosen: number? = nil
			for index, region in regions do
				local form = forms[index]
				local steppable = failing[index] and form > 0 and (form < #region.sizes or region.mayDrop)
				if steppable and (chosen == nil or region.rank >= regions[chosen].rank) then
					chosen = index
				end
			end
			if chosen == nil then
				return forms
			end
			local region = regions[chosen]
			forms[chosen] = if forms[chosen] < #region.sizes then forms[chosen] + 1 else 0
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">content_props</string>
              <string name="Source"><![CDATA[--!strict
local Compose = require("../vendor/compose/core")
local Engine = require("./engine_types")
local Content = require("./content_types")

local frame = (nil :: unknown) :: Engine.FrameProps
local pagination = (nil :: unknown) :: Content.PaginationOptions
local stepIndicator = (nil :: unknown) :: Content.StepIndicatorOptions
local vote = (nil :: unknown) :: Content.VoteOptions
local card = (nil :: unknown) :: Content.CardOptions

export type PaginationSpec = {
	Changed: typeof(frame.Changed),
	Attributes: typeof(frame.Attributes),
	AncestryChanged: typeof(frame.AncestryChanged),
	Archivable: typeof(frame.Archivable),
	AttributeChanged: typeof(frame.AttributeChanged),
	Capabilities: typeof(frame.Capabilities),
	ChildAdded: typeof(frame.ChildAdded),
	ChildRemoved: typeof(frame.ChildRemoved),
	DescendantAdded: typeof(frame.DescendantAdded),
	DescendantRemoving: typeof(frame.DescendantRemoving),
	Destroying: typeof(frame.Destroying),
	Name: typeof(frame.Name),
	Parent: typeof(frame.Parent),
	Sandboxed: typeof(frame.Sandboxed),
	StyledPropertiesChanged: typeof(frame.StyledPropertiesChanged),
	AutoLocalize: typeof(frame.AutoLocalize),
	RootLocalizationTable: typeof(frame.RootLocalizationTable),
	SelectionBehaviorDown: typeof(frame.SelectionBehaviorDown),
	SelectionBehaviorLeft: typeof(frame.SelectionBehaviorLeft),
	SelectionBehaviorRight: typeof(frame.SelectionBehaviorRight),
	SelectionBehaviorUp: typeof(frame.SelectionBehaviorUp),
	SelectionChanged: typeof(frame.SelectionChanged),
	SelectionGroup: typeof(frame.SelectionGroup),
	Active: typeof(frame.Active),
	AnchorPoint: typeof(frame.AnchorPoint),
	AutomaticSize: typeof(frame.AutomaticSize),
	BackgroundColor3: typeof(frame.BackgroundColor3),
	BackgroundTransparency: typeof(frame.BackgroundTransparency),
	BorderColor3: typeof(frame.BorderColor3),
	BorderMode: typeof(frame.BorderMode),
	BorderSizePixel: typeof(frame.BorderSizePixel),
	ClipsDescendants: typeof(frame.ClipsDescendants),
	InputBegan: typeof(frame.InputBegan),
	InputChanged: typeof(frame.InputChanged),
	InputEnded: typeof(frame.InputEnded),
	InputSink: typeof(frame.InputSink),
