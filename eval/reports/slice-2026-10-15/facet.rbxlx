	rule(
		".facet-menu-hairline",
		{ BackgroundColor3 = c("hairline"), BackgroundTransparency = extra.hairlineOpacity, BorderSizePixel = 0 }
	)
	for _, state in { "", ":Hover", ":Press" } do
		rule(".facet-menu-item.facet-selected" .. state, {
			BackgroundTransparency = 0,
			BackgroundColor3 = c("accent"),
			TextColor3 = c("onAccent"),
		})
	end
	rule(".facet-menu-item.facet-selected >> .facet-button-caption", { TextColor3 = c("onAccent") })
	rule(".facet-menu-item.facet-selected >> .facet-text", { TextColor3 = c("onAccent") })
	rule(".facet-menu-item.facet-selected >> .facet-icon", { ImageColor3 = c("onAccent") })
	rule(".facet-radial-sector", { Color3 = c("surfaceStrong") })
	rule(".facet-radial-sector.facet-radial-candidate", { Color3 = c("controlSelected") })
	rule(".facet-radial-item::UIPadding", {
		PaddingLeft = types.UDim.new(0, 0),
		PaddingRight = types.UDim.new(0, 0),
		PaddingTop = types.UDim.new(0, 0),
		PaddingBottom = types.UDim.new(0, 0),
	})
	rule(".facet-button.facet-radial-row", { BackgroundTransparency = 0 })
	rule(".facet-page-indicator", { BackgroundTransparency = 1 })
	rule(".facet-page-indicator:Hover", { BackgroundTransparency = 1 })
	rule(".facet-page-indicator:Press", { BackgroundTransparency = 1 })
	rule(".facet-page-indicator.facet-selected", { BackgroundTransparency = 1 })
	rule(".facet-page-dot", { BackgroundColor3 = c("contentSecondary"), BackgroundTransparency = 0 })
	rule(".facet-page-indicator:Hover >> .facet-page-dot", { BackgroundColor3 = c("content") })
	rule(".facet-page-indicator.facet-selected >> .facet-page-dot", {
		BackgroundColor3 = c("accent"),
		BackgroundTransparency = 0,
	})
	rule(".facet-floating::UIStroke", { Color = c("hairline"), Transparency = 0.3, Thickness = 1 })
	rule(".facet-tail", { BackgroundColor3 = c("surfaceStrong"), BackgroundTransparency = 0, BorderSizePixel = 0 })
	local outlineInk = color(types, source("hairline")) :: Color3
	local outlineFill = color(types, source("surfaceStrong")) :: Color3
	rule(".facet-outlined::UIStroke", { Transparency = 1 })
	rule(".facet-outline", { Color3 = outlineInk:Lerp(outlineFill, 0.3), Thickness = 1 })
	rule(".facet-outline-tooltip", { Color3 = outlineInk:Lerp(outlineFill, 0.4) })
	rule(".facet-step-circle::UIStroke", { Color = c("contentSecondary"), Thickness = 1 })
	rule(".facet-invalid::UIStroke", { Color = c("danger"), Thickness = 1 })
	rule(".facet-date-time-picker", { BackgroundTransparency = 1 })
	rule(".facet-radio-mark::UIStroke", { Color = c("contentSecondary"), Thickness = 1.5 })
	rule(".facet-segmented-stroke", { BackgroundTransparency = 1 })
	rule(".facet-segmented-stroke::UIStroke", { Color = c("hairline"), Thickness = 1 })
	rule(".facet-segmented-utility", { BackgroundTransparency = 1 })
	rule(".facet-card-option::UIStroke", { Color = c("hairline"), Thickness = 1 })
	rule(".facet-color-picker", { BackgroundTransparency = 1 })
	rule(".facet-color-swatch::UIStroke", { Color = c("hairline"), Transparency = 0, Thickness = 1 })
	rule(".facet-color-swatch >> UICorner", { CornerRadius = types.UDim.new(0, package.metrics.radii.control) })
	rule(".facet-color-cell::UIPadding", {
		PaddingLeft = types.UDim.new(0, 0),
		PaddingRight = types.UDim.new(0, 0),
		PaddingTop = types.UDim.new(0, 0),
		PaddingBottom = types.UDim.new(0, 0),
	})
	for _, member in { ".facet-avatar", ".facet-button" } do
		rule(".facet-avatar-stack > " .. member .. "::UIStroke", {
			Color = c("surface"),
			Thickness = 2,
			ApplyStrokeMode = types.Enum.ApplyStrokeMode.Border,
			BorderStrokePosition = types.Enum.BorderStrokePosition.Outer,
		})
	end
	for role, ink in AVATAR_BACKGROUNDS do
		local selector = ".facet-avatar-background-" .. role
		rule(selector, { BackgroundColor3 = c(role), BackgroundTransparency = 0, TextColor3 = c(ink) })
		rule(selector .. " > .facet-text", { TextColor3 = c(ink) })
		rule(selector .. " > .facet-icon", { ImageColor3 = c(ink) })
	end
	local focus = if package.chrome then package.chrome.focus else nil
	local focusColor = if focus then focus.color else nil
	rule(".facet-focus-ring", {
		BackgroundColor3 = if type(focusColor) == "table"
			then color(types, focusColor :: ThemeTypes.RGB)
			elseif type(focusColor) == "string" then c(
				string.lower(string.sub(focusColor, 2, 2)) .. string.sub(focusColor, 3)
			) or c("accent")
			else c("accent"),
	})
	rule(".facet-focus-ring::UICorner", { CornerRadius = types.UDim.new(0, package.metrics.radii.control) })
	rule(".facet-drop-line", { BackgroundColor3 = c("accent") })
	rule(".facet-drop-accepted", { Color = c("accent") })
	rule(".facet-drop-rejected", { Color = c("danger") })
	rule(".facet-avatar-ring", { Color = c("accent"), Transparency = 0 })
	rule(".facet-avatar-hover", { Color = c("accent") })
	rule(".facet-avatar-ring-gap", { Color = c("surface"), Transparency = 0 })
	rule(".facet-quiet-destructive", { TextColor3 = c("danger") })
	rule(".facet-quiet-destructive:Hover", { TextColor3 = c("danger") })
	rule(".facet-quiet-destructive:Press", { TextColor3 = c("danger") })
	rule(".facet-quiet-destructive >> .facet-button-caption", { TextColor3 = c("danger") })
	rule(".facet-quiet-destructive >> .facet-icon", { ImageColor3 = c("danger") })

	local track, quiet, loud =
		resolved("control") :: Color3, resolved("contentSecondary") :: Color3, resolved("content") :: Color3
	local segmentInk = if contrast(quiet, track) >= 4.5 or contrast(quiet, track) >= contrast(loud, track)
		then quiet
		else loud
	rule(".facet-tab-item.facet-button-tight::UIPadding", {
		PaddingLeft = types.UDim.new(0, rowGap + (buttonInsets.left or 0)),
		PaddingRight = types.UDim.new(0, rowGap + (buttonInsets.right or 0)),
	})
	rule(".facet-tab-item", { BackgroundTransparency = 1, TextColor3 = c("contentSecondary") })
	rule(".facet-tab-item >> .facet-button-caption", { TextColor3 = c("contentSecondary") })
	rule(".facet-tab-item.facet-skinned", { TextColor3 = segmentInk })
	rule(".facet-tab-item.facet-skinned >> .facet-button-caption", { TextColor3 = segmentInk })
	rule(".facet-tab-item:Hover", { BackgroundTransparency = 1, TextColor3 = c("content") })
	rule(".facet-tab-item:Hover >> .facet-button-caption", { TextColor3 = c("content") })
	rule(".facet-tab-item:Press", { BackgroundTransparency = 1, TextColor3 = c("content") })
	rule(".facet-tab-item:Press >> .facet-button-caption", { TextColor3 = c("content") })
	rule(".facet-tab-current", { TextColor3 = c("content") })
	rule(".facet-tab-current >> .facet-button-caption", { TextColor3 = c("content") })
	rule(".facet-tab-item.facet-selected", { BackgroundTransparency = 0, TextColor3 = onSelected })
	rule(".facet-tab-item.facet-selected >> .facet-button-caption", { TextColor3 = onSelected })
	rule(
		".facet-tab-filled",
		{ BackgroundTransparency = 0, BackgroundColor3 = c("accent"), TextColor3 = c("onAccent") }
	)
	rule(".facet-tab-filled >> .facet-button-caption", { TextColor3 = c("onAccent") })
	rule(".facet-tab-filled >> .facet-icon", { ImageColor3 = c("onAccent") })
	rule(".facet-stepper-track", { BackgroundColor3 = c("control"), BackgroundTransparency = 0, BorderSizePixel = 0 })
	rule(".facet-stepper-track::UICorner", { CornerRadius = types.UDim.new(0, package.metrics.radii.control) })
	rule(".facet-skinned > #Content > .facet-stepper-track", { BackgroundTransparency = 1 })
	do
		local recipe = if package.chrome then package.chrome.stepperPlate else nil
		local inset: ThemeTypes.Insets = if recipe then recipe.contentInsets or {} else {}
		rule(".facet-skinned >> .facet-stepper-inset", {
			PaddingLeft = types.UDim.new(0, math.max(12, inset.left or 0)),
		})
	end
	rule(".facet-stepper-button", { BackgroundTransparency = 1 })
	rule(".facet-stepper-button:Hover", { BackgroundTransparency = 0, BackgroundColor3 = c("controlHover") })
	rule(".facet-stepper-button:Press", { BackgroundTransparency = 0, BackgroundColor3 = c("controlPressed") })
	rule(".facet-choice", { BackgroundTransparency = 1, TextXAlignment = types.Enum.TextXAlignment.Left })
	rule(".facet-choice:Hover", { BackgroundTransparency = 0, BackgroundColor3 = c("controlHover") })
	rule(".facet-choice:Press", { BackgroundTransparency = 0, BackgroundColor3 = c("controlPressed") })
	rule(
		".facet-choice-current",
		{ BackgroundTransparency = 0.82, BackgroundColor3 = c("accent"), TextColor3 = c("accent") }
	)
	rule(".facet-choice-current:Hover", { BackgroundTransparency = 0.72, BackgroundColor3 = c("accent") })
	rule(".facet-choice-current:Press", { BackgroundTransparency = 0.62, BackgroundColor3 = c("accent") })
	rule(".facet-choice-current >> .facet-button-caption", { TextColor3 = c("accent") })
	rule(".facet-choice-current >> .facet-icon", { ImageColor3 = c("accent") })
	rule(".facet-segmented", { BackgroundColor3 = c("control"), BackgroundTransparency = 0, BorderSizePixel = 0 })
	local trackRadius = if package.metrics.radii.control > 0 then package.metrics.radii.control + 2 else 0
	rule(".facet-segmented::UICorner", { CornerRadius = types.UDim.new(0, trackRadius) })

	rule(".facet-tab-plate", { BackgroundColor3 = c("surfaceStrong") })
	local tabRadius = package.metrics.radii.tab or package.metrics.radii.control
	rule(".facet-top-tabs > .facet-tab-plate::UICorner", {
		CornerRadius = types.UDim.new(0, if tabRadius > 0 then tabRadius + 2 else 0),
	})
	rule(".facet-top-tabs > #Tabs >> .facet-tab-item::UICorner", { CornerRadius = types.UDim.new(0, tabRadius) })
	rule(".facet-tab-plate::UIStroke", {
		Color = c("hairline"),
		Transparency = extra.hairlineOpacity,
		Thickness = package.metrics.strokes.hairline or 1,
	})
	rule(".facet-segmented::UIPadding", {
		PaddingLeft = types.UDim.new(0, SEGMENT_INSET),
		PaddingRight = types.UDim.new(0, SEGMENT_INSET),
		PaddingTop = types.UDim.new(0, SEGMENT_INSET),
		PaddingBottom = types.UDim.new(0, SEGMENT_INSET),
	})
	rule(".facet-segment", { BackgroundTransparency = 1, TextColor3 = segmentInk })
	rule(".facet-segment::UICorner", { CornerRadius = types.UDim.new(0, math.max(0, trackRadius - SEGMENT_INSET)) })
	rule(".facet-segmented-pill >> .facet-segment::UICorner", { CornerRadius = types.UDim.new(1, 0) })
	rule(".facet-segmented-square >> .facet-segment::UICorner", { CornerRadius = types.UDim.new(0, 0) })
	rule(".facet-segment-fill", { BackgroundColor3 = c("accent"), BackgroundTransparency = 0, BorderSizePixel = 0 })
	rule(
		".facet-segment-fill::UICorner",
		{ CornerRadius = types.UDim.new(0, math.max(0, trackRadius - SEGMENT_INSET)) }
	)
	rule(".facet-segmented-pill >> .facet-segment-fill::UICorner", { CornerRadius = types.UDim.new(1, 0) })
	rule(".facet-segmented-square >> .facet-segment-fill::UICorner", { CornerRadius = types.UDim.new(0, 0) })
	rule(".facet-segment >> .facet-button-caption", { TextColor3 = segmentInk })
	rule(
		".facet-segment:Hover",
		{ BackgroundTransparency = 0, BackgroundColor3 = c("controlHover"), TextColor3 = c("content") }
	)
	rule(
		".facet-segment:Press",
		{ BackgroundTransparency = 0, BackgroundColor3 = c("controlPressed"), TextColor3 = c("content") }
	)
	rule(
		".facet-segment-current",
		{ BackgroundTransparency = 0, BackgroundColor3 = c("accent"), TextColor3 = c("onAccent") }
	)
	rule(".facet-segment-current:Hover", { BackgroundColor3 = c("accent"), TextColor3 = c("onAccent") })
	rule(".facet-segment-current:Press", { BackgroundColor3 = c("accent"), TextColor3 = c("onAccent") })
	rule(".facet-segment-current >> .facet-button-caption", { TextColor3 = c("onAccent") })
	rule(".facet-segment-current >> .facet-icon", { ImageColor3 = c("onAccent") })
	rule(".facet-menu-destructive >> .facet-text", { TextColor3 = c("danger") })
	rule(".facet-appearance-soft >> .facet-text", { TextColor3 = c("accent") })
	rule(".facet-appearance-link >> .facet-text", { TextColor3 = linkInk })
	rule(".facet-quiet-destructive >> .facet-text", { TextColor3 = c("danger") })
	rule(".facet-menu-item::UICorner", {
		CornerRadius = types.UDim.new(
			0,
			math.max(0, package.metrics.radii.panel - (package.metrics.space or neutral.metrics.space).xs)
		),
	})
	rule(".facet-menu-destructive", { TextColor3 = c("content") })
	rule(".facet-menu-destructive >> .facet-button-caption", { TextColor3 = c("content") })
	rule(".facet-menu-destructive >> .facet-text", { TextColor3 = c("content") })
	for _, state in { ":Hover", ":Press" } do
		rule(".facet-menu-destructive" .. state, { BackgroundTransparency = 0, BackgroundColor3 = c("danger") })
		rule(".facet-menu-destructive" .. state .. " >> .facet-button-caption", { TextColor3 = c("onDanger") })
		rule(".facet-menu-destructive" .. state .. " >> .facet-text", { TextColor3 = c("onDanger") })
		rule(".facet-menu-destructive" .. state .. " >> .facet-icon", { ImageColor3 = c("onDanger") })
	end
	rule(".facet-choice-current >> .facet-text", { TextColor3 = c("accent") })
	rule(".facet-tab-filled >> .facet-text", { TextColor3 = c("onAccent") })
	rule(".facet-segment-current >> .facet-text", { TextColor3 = c("onAccent") })
	rule(".facet-accent >> .facet-text", { TextColor3 = c("onAccent") })
	rule(".facet-accent >> .facet-icon", { ImageColor3 = c("onAccent") })
	rule(".facet-calendar-day", { BackgroundTransparency = 1 })
	rule(".facet-calendar-day::UIPadding", {
		PaddingLeft = types.UDim.new(0, 0),
		PaddingRight = types.UDim.new(0, 0),
		PaddingTop = types.UDim.new(0, 0),
		PaddingBottom = types.UDim.new(0, 0),
	})
	rule(".facet-calendar-day:Hover", { BackgroundTransparency = 0, BackgroundColor3 = c("controlHover") })
	rule(".facet-calendar-day:Press", { BackgroundTransparency = 0, BackgroundColor3 = c("controlPressed") })
	rule(".facet-calendar-band", { BackgroundColor3 = c("controlSelected"), BackgroundTransparency = 0 })
	rule(".facet-calendar-disc", { BackgroundColor3 = c("accent"), BackgroundTransparency = 0 })
	rule(".facet-calendar-end", { BackgroundColor3 = c("content") })
	rule(".facet-calendar-today::UIStroke", { Color = c("accent"), Thickness = 1 })
	rule(".facet-calendar-strike", { BackgroundColor3 = c("contentSecondary"), BackgroundTransparency = 0 })
	rule(".facet-calendar-number", { FontFace = f({ weight = "SemiBold" }) })
	rule(".facet-calendar-banded", { TextColor3 = onSelected })
	rule(".facet-calendar-dim", { TextColor3 = c("contentSecondary"), FontFace = f({ weight = "Regular" }) })
	rule(".facet-calendar-chosen", { TextColor3 = c("onAccent") })
	rule(".facet-calendar-chosen-end", { TextColor3 = c("surface") })
	rule(".facet-skinned", { BackgroundTransparency = 1 })

	for _, slot in { "control", "field", "panel" } do
		rule(".facet-skin-art-" .. slot, if extra.artTint then { ImageColor3 = c("artTint") } else {})
	end
	for status, role in statusRoles do
		rule(".facet-badge.facet-status-" .. status .. " > #SkinBoundary >> .facet-skin-art", { ImageColor3 = c(role) })
	end
	for _, appearance in { "status", "utility" } do
		rule(
			".facet-badge-" .. appearance .. " > #SkinBoundary >> .facet-skin-art",
			{ ImageColor3 = types.Color3.new(1, 1, 1) }
		)
	end
	local plate = ((package.chrome or {}) :: { [string]: ThemeTypes.SkinLayer }).control
	local selectedArt: ThemeTypes.AssetLink? = nil
	local selectedLayer = 0
	local plateLayers: { ThemeTypes.SkinLayer } = if plate == nil
		then {}
		elseif plate.kind == "layered" then plate.layers or {}
		else { plate }
	for index, layer in plateLayers do
		local link = if type(layer.asset) == "table" then (layer.asset :: ThemeTypes.AssetVariants).selected else nil
		if link ~= nil and selectedArt == nil then
			selectedArt, selectedLayer = link, index
		end
	end
	local selectedLink: { asset: string, rotation: number?, tint: ThemeTypes.RGB? }? = if type(selectedArt)
			== "string"
		then { asset = selectedArt }
		else selectedArt :: { asset: string, rotation: number?, tint: ThemeTypes.RGB? }?
	local white, black = types.Color3.new(1, 1, 1), types.Color3.new(0, 0, 0)
	local art = if selectedLink then (package.assets or {})[selectedLink.asset] else nil
	local pressedEmphasis = false
	for _, theme in package.style.themes do
		local swatch = merge(neutral.style.themes[1].colors, theme.colors)
		local fill, ink = color(types, swatch.accent), color(types, swatch.onAccent)
		if art and fill and ink and contrast(ink, black) <= contrast(fill, black) then
			pressedEmphasis = true
		end
	end
	for _, entry in
		{ { ".facet-role-destructive", "danger", "onDanger" }, { ".facet-accent", "accent", "onAccent" } } :: { { string } }
	do
		local selector, fill, ink = entry[1], resolved(entry[2]) :: Color3, resolved(entry[3]) :: Color3
		local pressed = pressedEmphasis and entry[2] == "accent"
		local tinted = not pressed and contrast(ink, black) > contrast(fill, black)
		rule(selector .. " > #SkinBoundary >> .facet-skin-art", { ImageColor3 = if tinted then c(entry[2]) else white })
		rule(selector .. ".facet-skinned", {
			BackgroundTransparency = if tinted or pressed then 1 else 0,
			TextColor3 = if pressed then onSelected else nil,
		})
		rule(selector .. " > #SkinBoundary", { Visible = tinted or pressed })
		local swapped = pressed and selectedLink ~= nil and art ~= nil
		rule(
			selector .. " > #SkinBoundary >> #control" .. math.max(selectedLayer, 1),
			if swapped
					and selectedLink
					and art
				then {
					Image = art.content or art.contentId or "",
					Rotation = selectedLink.rotation or 0,
					ImageColor3 = color(types, selectedLink.tint) or white,
				}
				else {}
		)
		rule(selector .. ".facet-skinned >> .facet-button-caption", if swapped then { TextColor3 = onSelected } else {})
		rule(selector .. ".facet-skinned >> .facet-text", if swapped then { TextColor3 = onSelected } else {})
		rule(selector .. ".facet-skinned >> .facet-icon", if swapped then { ImageColor3 = onSelected } else {})
	end
	rule(".facet-toggle-checkbox.facet-skinned::UIStroke", { Transparency = 1 })
	rule(".facet-menu.facet-skinned::UIStroke", { Transparency = 1 })
	rule(".facet-segment-current.facet-skinned", if selectedArt then {} else { BackgroundTransparency = 0 })
	rule(".facet-segment-current > #SkinBoundary", if selectedArt then {} else { Visible = false })
	rule(".facet-segment-fill", if selectedArt then { Visible = false } else {})
	rule(".facet-segmented-slides > .facet-segment-current", if selectedArt then {} else { BackgroundTransparency = 1 })
	local authoredSelection = false
	for _, theme in package.style.themes do
		if type(theme.extra) == "table" and theme.extra.selection ~= nil then
			authoredSelection = true
		end
	end
	local markPlate = if authoredSelection then c("selection") else c("controlSelected")
	local markInk = if authoredSelection then c("onSelection") else onSelected
	local markStates: { string } = if authoredSelection then { "", ":Hover", ":Press" } else { "" }
	for _, suffix in markStates do
		rule(".facet-selection-mark.facet-selected" .. suffix, { BackgroundColor3 = markPlate, TextColor3 = markInk })
	end
	rule(".facet-selection-mark.facet-selected >> .facet-button-caption", { TextColor3 = markInk })
	rule(".facet-selection-mark.facet-selected >> .facet-text", { TextColor3 = markInk })
	rule(".facet-selection-mark.facet-selected >> .facet-icon", { ImageColor3 = markInk })
	if authoredSelection then
		local linkInk = c("selection")
		rule(".facet-appearance-link.facet-selected", { TextColor3 = linkInk })
		rule(".facet-appearance-link.facet-selected >> .facet-button-caption", { TextColor3 = linkInk })
		rule(".facet-appearance-link.facet-selected >> .facet-text", { TextColor3 = linkInk })
		rule(".facet-appearance-link.facet-selected >> .facet-icon", { ImageColor3 = linkInk })
	end
	if extra.dimDisabledPlates == true then
		local dim = extra.disabledContentOpacity or 0.4
		local page = source("surface")
		local function faded(role: string): (Color3 | string)?
			local plate, base = source(role), page
			if plate == nil or base == nil then
				return c(role)
			end
			return types.Color3.new(
				plate.r + (base.r - plate.r) * dim,
				plate.g + (base.g - plate.g) * dim,
				plate.b + (base.b - plate.b) * dim
			)
		end
		for _, entry in
			{
				{ ".facet-button.facet-disabled", "control" },
				{ ".facet-button.facet-selected.facet-disabled", "controlSelected" },
				{ ".facet-accent.facet-disabled", "accent" },
				{ ".facet-appearance-soft.facet-disabled", "accent" },
				{ ".facet-appearance-inverse.facet-disabled", "inverseSurface" },
				{ ".facet-role-destructive.facet-disabled", "danger" },
				{ ".facet-disabled >> .facet-toggle-indicator", "control" },
				{ ".facet-disabled >> .facet-toggle-on", "selection" },
			} :: { { string } }
		do
			rule(entry[1], { BackgroundColor3 = faded(entry[2]) })
		end
		rule(".facet-appearance-utility.facet-disabled", { BackgroundColor3 = c("surface") })
		if authoredSelection then
			rule(".facet-selection-mark.facet-selected.facet-disabled", { BackgroundColor3 = faded("selection") })
		end
	end
	do
		local on = selectedArt ~= nil
		local tint = if selectedLink then selectedLink.tint else nil
		rule(
			".facet-skinned.facet-selected",
			if on then { BackgroundTransparency = 1, TextColor3 = onSelected } else {}
		)
		rule(".facet-skinned.facet-selected > #SkinBoundary", if on then { Visible = true } else {})
		rule(
			".facet-skinned.facet-selected > #SkinBoundary >> .facet-skin-art",
			if on then { ImageColor3 = color(types, tint) or types.Color3.new(1, 1, 1) } else {}
		)
		rule(".facet-skinned.facet-selected >> .facet-button-caption", if on then { TextColor3 = onSelected } else {})
		rule(".facet-skinned.facet-selected >> .facet-text", if on then { TextColor3 = onSelected } else {})
		rule(".facet-skinned.facet-selected >> .facet-icon", if on then { ImageColor3 = onSelected } else {})
	end
	rule(".facet-selected >> .facet-text.facet-field", { TextColor3 = c("content") })
	rule(".facet-selected >> .facet-text-input >> .facet-text", { TextColor3 = c("content") })
	rule(".facet-tab-filled.facet-skinned", if selectedArt then {} else { BackgroundTransparency = 0 })
	rule(".facet-tab-filled > #SkinBoundary", if selectedArt then {} else { Visible = false })
	return kit.finish()
end

local bound: { [typeof(ComposeTypes)]: ThemeTypes.Themes } = {}
setmetatable(bound, { __mode = "k" })

return function(Compose: typeof(ComposeTypes)): ThemeTypes.Themes
	local cached = bound[Compose]
	if cached then
		return cached
	end
	local surface: ThemeTypes.Themes = {
		SCHEMA = themes.SCHEMA,
		TYPE_ROLES = themes.TYPE_ROLES,
		REQUIRED_TYPE_ROLES = themes.REQUIRED_TYPE_ROLES,
		neutralPackage = themes.neutralPackage,
		forDistance = themes.forDistance,
		define = themes.define,
		checkCoverage = themes.checkCoverage,
		resolveIcon = themes.resolveIcon,
		createStyleSheet = function(
			runtime: ComposeTypes.Runtime,
			packageOrReadable: Engine.Value<ThemeTypes.ThemePackage>?,
			options: ThemeTypes.ThemeOptions?
		): StyleSheet
			return createStyleSheet(neutral, rulesFor, themes.forDistance, Compose, runtime, packageOrReadable, options)
		end,
		skin = function(
			runtime: ComposeTypes.Runtime,
			packageOrReadable: Engine.Value<ThemeTypes.ThemePackage>?,
			slot: string,
			options: ThemeTypes.SkinOptions?
		): Frame
			return skin(neutral, paint, Compose, runtime, packageOrReadable, slot, options)
		end,
	}
	bound[Compose] = surface
	return surface
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="228">
            <Properties>
              <string name="Name">timer</string>
              <string name="Source"><![CDATA[--!strict
local Shared = require("./types")
local Controls = require("./control_types")
local Props = require("./hud_props")
local MediaProps = require("./media_props")
local format = require("./format")

return function(ctx: Shared.Context, UI: Controls.Controls)
	local C, runtime = ctx.Compose, ctx.runtime
	UI.Timer = ctx.construct("Timer", function(spec: Props.TimerProps): TextLabel
		assert((spec.deadline ~= nil) ~= (spec.start ~= nil), "Facet Timer requires either deadline or start")
		local frames = assert(runtime.host.frames, "Facet Timer requires a runtime clock")
		local now = spec.now or frames.now
		local completed, text = C.cell(false), C.cell("")
		local fields = (
			ctx.props(spec, { "deadline", "start", "now", "hours", "textRole", "onComplete", "controls" }) :: unknown
		) :: { [string]: unknown }
		fields.textRole = spec.textRole
		fields.text = text
		local label = UI.Text((fields :: unknown) :: MediaProps.TextProps) :: TextLabel
		if spec.controls then
			spec.controls.completed = completed
			C.cleanup(function()
				if spec.controls then
					spec.controls.completed = nil
				end
			end)
		end
		C.watch(function(use: Shared.Use)
			local target = ctx.read(spec.deadline or spec.start, use)
			assert(
				target ~= nil and target == target and math.abs(target) < math.huge,
				"Facet Timer requires a finite time"
			)
			local scheduler = runtime.scheduler()
			local active = true
			C.cleanup(function()
				active = false
			end)
			completed:set(false)
			local tick: () -> ()
			tick = function()
				if not active then
					return
				end
				local at = now()
				assert(at == at and math.abs(at) < math.huge, "Facet Timer clock must be finite")
				local delta = if spec.deadline ~= nil then target - at else at - target
				local seconds = math.max(0, if spec.deadline ~= nil then math.ceil(delta) else math.floor(delta))
				text:set(format.duration(seconds, { hours = spec.hours }))
				if spec.deadline ~= nil and delta <= 0 then
					completed:set(true)
					if spec.onComplete then
						spec.onComplete()
					end
					return
				end
				local delay = if spec.deadline ~= nil then delta - seconds + 1 else seconds + 1 - delta
				scheduler.after(delay, tick)
			end
			tick()
		end)
		return label
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="229">
            <Properties>
              <string name="Name">toast_schedule</string>
              <string name="Source"><![CDATA[--!strict
local toast_schedule = {}

export type Entry = {
	id: number,
	key: string?,
	priority: number,
	duration: number,
	readFloor: number,
	data: unknown,
	shownAt: number?,
	sequence: number,
	held: boolean,
	asked: { [string]: boolean },
}
export type Options = {
	maxVisible: number?,
	queueCap: number?,
	duration: number?,
	readFloor: number?,
	now: (() -> number)?,
	onDismiss: ((Entry, string) -> ())?,
	onChange: (() -> ())?,
	onPropose: ((Entry, string) -> ())?,
}
export type Push = {
	key: string?,
	priority: number?,
	duration: number?,
	readFloor: number?,
	data: unknown,
	held: boolean?,
}
export type Schedule = {
	push: (Push) -> number,
	update: () -> (),
	dismiss: (number, string?) -> boolean,
	visible: () -> { Entry },
	queued: () -> { Entry },
	counts: () -> { visible: number, queued: number },
	isEmpty: () -> boolean,
}

toast_schedule.DEFAULTS = table.freeze({ maxVisible = 3, queueCap = 8, duration = 4, readFloor = 2.5 })

local function positive(value: unknown, fallback: number): number
	return if type(value) == "number" and value == value and value >= 0 and value < math.huge then value else fallback
end

function toast_schedule.new(options: Options?): Schedule
	local settings: Options = options or {}
	local defaults = toast_schedule.DEFAULTS
	local maxVisible = math.max(1, math.floor(positive(settings.maxVisible, defaults.maxVisible)))
	local queueCap = math.max(1, math.floor(positive(settings.queueCap, defaults.queueCap)))
	local duration = positive(settings.duration, defaults.duration)
	local readFloor = positive(settings.readFloor, defaults.readFloor)
	local now = settings.now or os.clock
	local visible: { Entry } = {}
	local queue: { Entry } = {}
	local sequence = 0
	local changed = false
	local proposals: { { entry: Entry, reason: string } } = {}
	local depth = 0
	local pending: { () -> () } = {}
	local function later(callback: () -> ())
		table.insert(pending, callback)
	end
	local function guarded<T>(body: () -> T): T
		depth += 1
		local ok, result = pcall(body)
		local failure: unknown = if ok then nil else result
		if ok and depth == 1 then
			while failure == nil and #pending > 0 do
				local callback = table.remove(pending, 1) :: () -> ()
				local done, problem = pcall(callback :: () -> unknown)
				failure = if done then nil else problem
			end
		end
		depth -= 1
		if failure ~= nil then
			table.clear(pending)
			error(failure, 0)
		end
		return result :: T
	end

	local function outranks(a: Entry, b: Entry): boolean
		if a.priority ~= b.priority then
			return a.priority > b.priority
		end
		return a.sequence < b.sequence
	end
	local function retire(entry: Entry, reason: string)
		changed = true
		local onDismiss = settings.onDismiss
		if onDismiss then
			later(function()
				onDismiss(entry, reason)
			end)
		end
	end
	local function floorMet(entry: Entry, at: number): boolean
		return entry.shownAt ~= nil and at - entry.shownAt >= entry.readFloor
	end
	local function showing(key: string?): number?
		if key == nil then
			return nil
		end
		for index, entry in visible do
			if entry.key == key then
				return index
			end
		end
		return nil
	end
	local function eligible(): number?
		for index, waiting in queue do
			if showing(waiting.key) == nil then
				return index
			end
		end
		return nil
	end
	local function weakest(): number?
		local worst: number? = nil
		for index, entry in visible do
			if worst == nil or outranks(visible[worst], entry) then
				worst = index
			end
		end
		return worst
	end
	local function ask(entry: Entry, reason: string)
		if not entry.asked[reason] then
			entry.asked[reason] = true
			table.insert(proposals, { entry = entry, reason = reason })
		end
	end
	local function show(index: number, at: number)
		local entry = table.remove(queue, index) :: Entry
		entry.shownAt = at
		table.insert(visible, entry)
		changed = true
	end

	local function resolve()
		local at = now()
		for _, entry in table.clone(visible) do
			if at - (entry.shownAt :: number) >= entry.duration then
				if entry.held then
					ask(entry, "timeout")
					continue
				end
				table.remove(visible, table.find(visible, entry) :: number)
				retire(entry, "timeout")
			end
		end
		for _, waiting in table.clone(queue) do
			local index = showing(waiting.key)
			if index and floorMet(visible[index], at) then
				if visible[index].held then
					ask(visible[index], "supersede")
					continue
				end
				retire(table.remove(visible, index) :: Entry, "supersede")
			end
		end
		while #visible < maxVisible do
			local index = eligible()
			if index == nil then
				break
			end
			show(index, at)
		end
		while #visible >= maxVisible do
			local index, worst = eligible(), weakest()
			if index == nil or worst == nil then
				break
			end
			if not outranks(queue[index], visible[worst]) or not floorMet(visible[worst], at) then
				break
			end
			if visible[worst].held then
				ask(visible[worst], "preempt")
				break
			end
			retire(table.remove(visible, worst) :: Entry, "preempt")
			show(index, at)
		end
		if changed then
			changed = false
			if settings.onChange then
				later(settings.onChange)
			end
		end
		local asked = proposals
		proposals = {}
		local onPropose = settings.onPropose
		for _, proposal in asked do
			if onPropose then
				later(function()
					onPropose(proposal.entry, proposal.reason)
				end)
			end
		end
	end

	local schedule = {}
	local function enqueue(spec: Push): number
		sequence += 1
		local entry: Entry = {
			id = sequence,
			key = if type(spec.key) == "string" then spec.key else nil,
			priority = if type(spec.priority) == "number" and math.abs(spec.priority) < math.huge
				then spec.priority
				else 0,
			duration = if spec.duration == math.huge then math.huge else positive(spec.duration, duration),
			readFloor = positive(spec.readFloor, readFloor),
			data = spec.data,
			shownAt = nil,
			sequence = sequence,
			held = spec.held == true,
			asked = {},
		}
		if entry.key then
			for index = #queue, 1, -1 do
				if queue[index].key == entry.key then
					retire(table.remove(queue, index) :: Entry, "supersede")
				end
			end
		end
		table.insert(queue, entry)
		table.sort(queue, outranks)
		while #queue > queueCap do
			retire(table.remove(queue) :: Entry, "capacity")
		end
		resolve()
		return entry.id
	end
	function schedule.push(spec: Push): number
		return guarded(function()
			return enqueue(spec)
		end)
	end
	function schedule.update()
		guarded(function()
			resolve()
			return nil
		end)
	end
	function schedule.dismiss(id: number, reason: string?): boolean
		return guarded(function()
			for _, list in { visible, queue } do
				for index, entry in list do
					if entry.id == id then
						table.remove(list, index)
						retire(entry, reason or "manual")
						resolve()
						return true
					end
				end
			end
			return false
		end)
	end
	function schedule.visible(): { Entry }
		return table.clone(visible)
	end
	function schedule.queued(): { Entry }
		return table.clone(queue)
	end
	function schedule.counts(): { visible: number, queued: number }
		return { visible = #visible, queued = #queue }
	end
	function schedule.isEmpty(): boolean
		return #visible == 0 and #queue == 0
	end
	return schedule
end

return toast_schedule
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="230">
            <Properties>
              <string name="Name">travel</string>
              <string name="Source"><![CDATA[--!strict
local Shared = require("./types")
local Nav = require("./navigation_types")
local engine = require("./travel_engine")
local ControlTypes = require("./control_types")
local ZoomTravelProps = require("./zoom_travel_props")
local reducedMotion = require("./motion").reduced

return function(ctx: Shared.Context, UI: ControlTypes.Controls, surfaces: Nav.Surfaces)
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local D2, V2 = ctx.types.UDim2, ctx.types.Vector2
	local function build(spec: ZoomTravelProps.TravelProps): Frame
		assert(type(spec.content) == "function", "Facet UI.Travel: content is required")
		local anchor = Host.Frame(ctx.props(spec, {
			"destination",
			"content",
			"path",
			"onLanded",
			"motion",
			"transparency",
			"stagger",
			"lift",
			"onStarted",
		}, {
			Name = "Travel",
			BackgroundTransparency = 1,
			Size = D2.fromOffset(0, 0),
		}))
		local node = spec.content()
		runtime.decorate(node, { AutomaticSize = ctx.types.Enum.AutomaticSize.None })
		local restingDepth = node.ZIndex
		local liftScale: UIScale? = nil
		if spec.lift then
			liftScale = node:FindFirstChildWhichIsA("UIScale") :: UIScale?
			if not liftScale then
				liftScale = Host.UIScale { Name = "TravelLift", Parent = Compose.static(node) }
			end
		end
		local restingScale = if liftScale then liftScale.Scale else 1
		local liftStart, lifted = 1, 1
		local styleCopy = Host.StyleLink {}
		styleCopy.Parent = node
		local reduce = reducedMotion(ctx)
		local owner = assert(Compose.currentOwner())
		local destination: GuiObject = ctx.read(spec.destination)
		local watchedDestination: GuiObject? = nil
		local releaseDestination: (() -> ())? = nil
		Compose.cleanup(function()
			if releaseDestination then
				releaseDestination()
			end
		end)
		local function retire()
			if task and task.defer then
				task.defer(owner.dispose)
			else
				owner.dispose()
			end
		end
		runtime.connect(node, "Destroying", retire)
		runtime.connect(anchor, "Destroying", retire)
		local previous: GuiObject? = nil
		local parent: GuiBase2d? = nil
		local overlay: GuiBase2d? = nil
		local values = { 0, 0, 0, 0, 1 }
		local target = table.clone(values)
		local inPlace = false
		local moving = false
		local motion: engine.Handle
		local units: { [GuiBase2d]: Shared.Readable<number> } = {}
		local function contentInsets(slot: GuiObject): (number, number, number, number)
			local unit = 1
			local at: Instance? = slot
			while at do
				local scale = at:FindFirstChildWhichIsA("UIScale") :: UIScale?
				if scale then
					unit *= scale:GetStyled("Scale") :: number
				end
				at = at.Parent
			end
			local border = if (slot:GetStyled("BorderMode") :: Enum.BorderMode) == ctx.types.Enum.BorderMode.Inset
				then (slot:GetStyled("BorderSizePixel") :: number) * unit
				else 0
			local left, top, right, bottom = border, border, border, border
			local padding = slot:FindFirstChildWhichIsA("UIPadding") :: UIPadding?
			if padding then
				local size = slot.AbsoluteSize
				local function pixels(property: string, dimension: number): number
					local value = padding:GetStyled(property) :: UDim
					return value.Scale * math.max(0, dimension - border * 2) + value.Offset * unit
				end
				left += pixels("PaddingLeft", size.X)
				right += pixels("PaddingRight", size.X)
				top += pixels("PaddingTop", size.Y)
				bottom += pixels("PaddingBottom", size.Y)
			end
			return left, top, right, bottom
		end
		local function bounds(slot: GuiObject): { number }
			local point, size = slot.AbsolutePosition, slot.AbsoluteSize
			if size.X <= 0 or size.Y <= 0 then
				point = V2.new(slot.Position.X.Offset, slot.Position.Y.Offset)
				size = V2.new(slot.Size.X.Offset, slot.Size.Y.Offset)
			end
			local left, top, right, bottom = contentInsets(slot)
			return {
				point.X + left,
				point.Y + top,
				math.max(0, size.X - left - right),
				math.max(0, size.Y - top - bottom),
				1,
			}
		end
		local function common(a: GuiObject, b: GuiObject): GuiBase2d?
			local ancestors: { Instance } = {}
			local at: Instance? = a.Parent
			while at do
				table.insert(ancestors, at)
				at = at.Parent
			end
			at = b.Parent
			while at and not table.find(ancestors, at) do
				at = at.Parent
			end
			local root = at
			local function clear(slot: GuiObject): boolean
				local current: Instance? = slot
				while current and current ~= root do
					if
						current:FindFirstChildWhichIsA("UIScale")
						or (current:IsA("GuiObject") and (current :: GuiObject).ClipsDescendants)
					then
						return false
					end
					current = current.Parent
				end
				return true
			end
			return if root
					and root:IsA("GuiBase2d")
					and not root:FindFirstChildWhichIsA("UILayout")
					and clear(a)
					and clear(b)
				then root :: GuiBase2d
				else nil
		end
		local function paint(sample: { number })
			if owner.isDisposed() then
				return
			end
			if previous and (destination.Parent == nil or node.Parent == nil) then
				owner.dispose()
				return
			end
			values = table.clone(sample)
			local container = parent
			if not container then
				return
			end
			local unit = math.max(units[container]:peek(), 0.001)
			local progress = math.clamp(sample[5], 0, 1)
			lifted = if moving and spec.lift
				then liftStart
					+ (1 - liftStart) * progress
					+ (ctx.metric("motion.scales.travelLift") - 1) * 4 * progress * (1 - progress)
				else 1
			if liftScale then
				liftScale.Scale = restingScale * lifted
			end
			local arc = if spec.path == "arc" and spec.motion ~= "spring"
				then -4 * ctx.metric("motion.distances.travelArc") * sample[5] * (1 - sample[5])
				else 0
			values[2] += arc * unit
			local origin = container.AbsolutePosition
			if container:IsA("ScrollingFrame") then
				origin -= (container :: ScrollingFrame).CanvasPosition
			end
			if container:IsA("GuiObject") then
				local left, top = contentInsets(container :: GuiObject)
				origin += V2.new(left, top)
			end
			node.Position = D2.fromOffset(
				(sample[1] - origin.X - sample[3] * (lifted - 1) / 2) / unit,
				(sample[2] - origin.Y - sample[4] * (lifted - 1) / 2) / unit + arc
			)
			node.Size = D2.fromOffset(sample[3] / unit, sample[4] / unit)
			node.Visible = true
			if node.Parent ~= container then
				node.Parent = container
			end
		end
		local function land()
			if owner.isDisposed() or destination.Parent == nil then
				owner.dispose()
				return
			end
			moving = false
			local depth = restingDepth
			local ownDepth = destination:GetStyled("ZIndex") :: number
			if ownDepth > restingDepth or destination:IsA("GuiButton") then
				depth = math.max(depth, ownDepth + 1)
			end
			for _, child in destination:GetDescendants() do
				if child:IsA("GuiObject") and child ~= node and not child:IsDescendantOf(node) then
					local paintDepth = child:GetStyled("ZIndex") :: number
					if paintDepth >= restingDepth then
						depth = math.max(depth, paintDepth + 1)
					end
				end
			end
			node.ZIndex = depth
			liftStart, lifted = 1, 1
			if not inPlace then
				parent = destination
				if not units[destination] then
					Compose.withOwner(owner, function()
						units[destination] = ctx.layoutUnit(destination)
					end)
				end
			end
			motion.snap(target)
			previous = destination
			anchor:SetAttribute("FacetTravelMoving", false)
			if spec.onLanded then
				spec.onLanded(destination)
			end
		end
		motion = engine(ctx, {
			initial = values,
			carrier = node,
			target = function()
				local goal = bounds(destination)
				if spec.path == "arc" and spec.motion == "spring" then
					local unit = if parent and units[parent] then units[parent]:peek() else 1
					goal[2] -= 4 * ctx.metric("motion.distances.travelArc") * unit * values[5] * (1 - values[5])
				end
				return goal
			end,
			sample = paint,
			complete = land,
			start = function()
				local floor = restingDepth
				local container = parent
				if container then
					for _, sibling in container:GetChildren() do
						if sibling:IsA("GuiObject") and sibling ~= node then
							floor = math.max(floor, (sibling :: GuiObject).ZIndex)
						end
					end
				end
				node.ZIndex = floor + motion.depth
				if spec.onStarted then
					spec.onStarted(destination)
				end
			end,
			delay = function()
				local index = if type(spec.stagger) == "function" then spec.stagger() else spec.stagger or 0
				assert(index >= 0 and index < math.huge, "Facet UI.Travel: stagger must be finite and nonnegative")
				return index * ctx.metric("motion.durations.travelStagger")
			end,
			reduced = reduce,
			motion = spec.motion or "ease",
			duration = ctx.metric("motion.durations.travel"),
			ease = ctx.motionEase("travel"),
			spring = ctx.motionSpring("travel"),
		})
		motion.snap(values)
		local function retarget()
			if owner.isDisposed() then
				return
			end
			if previous and node.Parent == nil then
				owner.dispose()
				return
			end
			if not destination.Parent then
				if previous then
					owner.dispose()
					return
				end
				node.Visible = false
				return
			end
			target = bounds(destination)
			if previous == destination and not moving then
				motion.snap(target)
				return
			end
			if not moving and previous and node.AbsoluteSize.X > 0 and node.AbsoluteSize.Y > 0 then
				values =
					{ node.AbsolutePosition.X, node.AbsolutePosition.Y, node.AbsoluteSize.X, node.AbsoluteSize.Y, 1 }
			end
			if target[3] <= 0 or target[4] <= 0 then
				return
			end
			local same = if previous then common(previous, destination) else common(destination, destination)
			inPlace = same ~= nil
			parent = same or overlay
			if not parent then
				return
			end
			if not units[parent] then
				local container = parent
				Compose.withOwner(owner, function()
					units[container] = ctx.layoutUnit(container)
				end)
			end
			if previous == nil and not moving then
				land()
			else
				liftStart = lifted
				moving = true
				values[5] = 0
				motion.rebase(values)
				anchor:SetAttribute("FacetTravelMoving", true)
				motion.retarget()
			end
		end
		local portal = surfaces.overlay(anchor, true, function(): Instance
			overlay = surfaces.parent(anchor)
			local holder = Host.Folder { Name = "TravelPortal" }
			runtime.connect(holder, "ChildAdded", function(child: Instance)
				if child:IsA("StyleLink") then
					local source = child :: StyleLink
					styleCopy.StyleSheet = source.StyleSheet
					runtime.connect(source, "Changed", function(property: string)
						if property == "StyleSheet" and not owner.isDisposed() then
							styleCopy.StyleSheet = source.StyleSheet
						end
					end)
				end
			end)
			retarget()
			return holder
		end)
		runtime.mountFragment(function()
			return { portal }
		end, anchor)
		Compose.watch(function(use: Shared.Use)
			local next: GuiObject = ctx.read(spec.destination, use)
			assert(next:IsA("GuiObject"), "Facet UI.Travel: destination must be a GuiObject")
			ctx.read(ctx.observe.AbsolutePosition(next), use)
			ctx.read(ctx.observe.AbsoluteSize(next), use)
			ctx.read(ctx.observe.Position(next), use)
			if watchedDestination ~= next then
				if releaseDestination then
					releaseDestination()
				end
				watchedDestination = next
				Compose.withOwner(owner, function()
					releaseDestination = runtime.connect(next, "Destroying", retire)
				end)
			end
			local changed = destination ~= next
			destination = next
			if moving and not changed then
				target = bounds(destination)
			else
				retarget()
			end
		end)
		runtime.connect(anchor, "AncestryChanged", retarget)
		Compose.watch(function(use: Shared.Use)
			if reduce(use) and moving then
				motion.retarget()
			end
		end)
		if spec.transparency then
			assert(node:IsA("CanvasGroup"), "Facet UI.Travel: transparency requires CanvasGroup content")
			local group = node :: CanvasGroup
			local fade = runtime.tween(function(use: Shared.Use)
				return ctx.read(spec.transparency, use)
			end, {
				seconds = ctx.metric("motion.durations.travelFade"),
				ease = ctx.motionEase("travel"),
				reducedMotion = reduce,
			})
			Compose.watch(function(use: Shared.Use)
				group.GroupTransparency = use(fade)
			end)
		end
		return anchor
	end
	UI.Travel = ctx.construct("Travel", function(spec: ZoomTravelProps.TravelProps): Frame
		local owner = assert(Compose.currentOwner()).createChild()
		return Compose.withOwner(owner, function(): Frame
			return build(spec)
		end)
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="231">
            <Properties>
              <string name="Name">travel_engine</string>
              <string name="Source"><![CDATA[--!strict
local Shared = require("./types")

export type Options = {
	initial: { number },
	carrier: GuiObject?,
	target: () -> { number },
	sample: ({ number }) -> (),
	complete: (() -> ())?,
	start: (() -> ())?,
	delay: (() -> number)?,
	reduced: () -> boolean,
	motion: "ease" | "spring",
	duration: number,
	ease: (number) -> number,
	spring: { period: number, damping: number },
}
export type Handle = {
	retarget: () -> (),
	stop: () -> (),
	snap: ({ number }) -> (),
	rebase: ({ number }) -> (),
	velocity: () -> { number },
	depth: number,
}
type Entry = { tick: (number) -> (), active: boolean, depth: number }
type Service = { entries: { Entry }, carriers: { [GuiObject]: Entry }, disconnect: (() -> ())? }
local services = setmetatable({} :: { [Shared.Runtime]: Service }, { __mode = "k" })

return function(ctx: Shared.Context, options: Options): Handle
	local service = services[ctx.runtime]
	if not service then
		service = { entries = {}, carriers = {} }
		services[ctx.runtime] = service
	end
	local owner = assert(ctx.Compose.currentOwner())
	local shared = service
	local state = ctx.Compose.createSpringState(options.initial, #options.initial)
	local reference = table.clone(options.initial)
	local elapsed = 0
	local depth = 1
	while true do
		local occupied = false
		for _, leased in shared.entries do
			occupied = occupied or leased.depth == depth
		end
		if not occupied then
			break
		end
		depth += 1
	end
	local entry: Entry = { active = true, tick = function() end, depth = depth }
	local stopped = false
	local hadParent = options.carrier ~= nil and options.carrier.Parent ~= nil
	local stop: () -> ()
	local function alive(): boolean
		return not stopped
			and not owner.isDisposed()
			and not (hadParent and options.carrier and options.carrier.Parent == nil)
	end
	local waiting = 0
	local started = true
	local function start()
		if alive() and not started then
			started = true
			if options.start then
				options.start()
			end
		end
	end
	local function finish(target: { number })
		if not alive() then
			return
		end
		for index, value in target do
			state.position[index], state.velocity[index] = value, 0
		end
		entry.active = false
		options.sample(state.position)
		if alive() and options.complete then
			options.complete()
		end
	end
	entry.tick = function(delta: number)
		if options.carrier and options.carrier.Parent ~= nil then
			hadParent = true
		end
		if not alive() then
			stop()
			return
		end
		if not entry.active then
			return
		end
		local target = options.target()
		if not alive() then
			return
		end
		if options.reduced() then
			start()
			finish(target)
			return
		end
		if waiting > 0 then
			local consumed = math.min(waiting, delta)
			waiting -= consumed
			delta -= consumed
			if waiting > 0 then
				return
			end
		end
		start()
		if not alive() then
			return
		end
		if options.motion == "spring" then
			ctx.Compose.stepSpring(state, target, delta, options.spring.period, options.spring.damping)
			options.sample(state.position)
			if ctx.Compose.springAtRest(state, target, reference, 0.001) then
				finish(target)
			end
		else
			elapsed += delta
			local fraction = if options.duration <= 0 then 1 else math.min(1, elapsed / options.duration)
			local eased = options.ease(fraction)
			for index, value in target do
				state.position[index] = reference[index] + (value - reference[index]) * eased
			end
			options.sample(state.position)
			if fraction >= 1 then
				finish(target)
			end
		end
	end
	if options.carrier then
		assert(shared.carriers[options.carrier] == nil, "Facet travel carrier is already leased")
		shared.carriers[options.carrier] = entry
	end
	table.insert(shared.entries, entry)
	if not shared.disconnect then
		local frames = assert(ctx.runtime.host.frames, "Facet travel requires a Compose frame clock")
		shared.disconnect = frames.onFrame(function(delta: number)
			for _, current in table.clone(shared.entries) do
				current.tick(delta)
			end
		end)
	end
	stop = function()
		if stopped then
			return
		end
		stopped = true
		entry.active = false
		if options.carrier then
			shared.carriers[options.carrier] = nil
		end
		local index = table.find(shared.entries, entry)
		if index then
			table.remove(shared.entries, index)
		end
		if #shared.entries == 0 and shared.disconnect then
			shared.disconnect()
			shared.disconnect = nil
		end
	end
	if options.carrier then
		ctx.runtime.connect(options.carrier, "Destroying", stop)
	end
	ctx.Compose.cleanup(stop)
	return {
		depth = depth,
		rebase = function(values: { number })
			if not alive() then
				return
			end
			for index, value in values do
				state.position[index] = value
			end
		end,
		snap = function(values: { number })
			if not alive() then
				return
			end
			for index, value in values do
				state.position[index], state.velocity[index] = value, 0
			end
			reference = table.clone(values)
			entry.active = false
			options.sample(state.position)
			if options.carrier and options.carrier.Parent ~= nil then
				hadParent = true
			end
		end,
		retarget = function()
			if not alive() then
				return
			end
			local interrupted = entry.active and started
			reference = table.clone(state.position)
			waiting = if interrupted or options.delay == nil then 0 else options.delay()
			assert(waiting >= 0 and waiting < math.huge, "Facet travel delay must be finite and nonnegative")
			elapsed, entry.active, started = 0, true, false
			if waiting == 0 or options.reduced() then
				start()
			end
			if options.reduced() or (options.motion == "ease" and options.duration <= 0 and waiting == 0) then
				finish(options.target())
			end
		end,
		stop = stop,
		velocity = function()
			return table.clone(state.velocity)
		end,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="232">
            <Properties>
              <string name="Name">travel_geometry</string>
              <string name="Source"><![CDATA[--!strict
local geometry = {}

function geometry.point(from: number, to: number, progress: number): number
	return from + (to - from) * progress
end

function geometry.arc(progress: number, height: number): number
	return -4 * height * progress * (1 - progress)
end

return geometry
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="233">
            <Properties>
              <string name="Name">types</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Engine = require("./engine_types")
local Theme = require("./theme_types")

export type ComposeModule = typeof(ComposeTypes)
export type Runtime = ComposeTypes.Runtime
export type Source<T> = ComposeTypes.Source<T>
