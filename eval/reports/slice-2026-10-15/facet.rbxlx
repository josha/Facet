          <Item class="ModuleScript" referent="19">
            <Properties>
              <string name="Name">collection_reorder</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local createState = require("./collection_reorder_state")
local createPointer = require("./collection_reorder_pointer")
local createRow = require("./collection_reorder_row")
local registerDrop = require("./collection_reorder_drop")
local createFeedback = require("./collection_reorder_feedback")
local bindKeys = require("./collection_reorder_keys")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local CollectionTypes = require("./collection_types")
export type Editor<V, K> = {
	placement: (K, ComposeTypes.Placement, ComposeTypes.Use) -> ComposeTypes.Placement,
	wrap: (GuiObject, ComposeTypes.Readable<V>, K, boolean?) -> Frame,
	overlay: (boolean?) -> Frame,
	leading: ComposeTypes.Readable<number>,
	trailing: ComposeTypes.Readable<number>,
	header: ComposeTypes.Readable<number>,
	press: (K, InputObject) -> (),
	mouseDown: (Vector2) -> (),
	finish: (InputObject) -> (),
	busy: () -> boolean,
	pickUp: (K, InputObject?) -> boolean,
	deleteSelected: (...unknown) -> (),
	canDeleteSelected: (ComposeTypes.Use?) -> boolean,
}
return function<V, K>(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	spec: CollectionTypes.ReorderShape<V, K>,
	source: Types.Value<{ V }>,
	keyOf: (V, number) -> K,
	controls: ComposeTypes.OrderedCollectionControls<K>,
	bodyOf: () -> ScrollingFrame,
	selection: ComposeTypes.Cell<CollectionTypes.Selection<K>>,
	sort: ComposeTypes.Cell<CollectionTypes.Sort?>,
	editing: Types.ValueBoolean?,
	grid: boolean?,
	location: (({ K }, number) -> (boolean, number, K?))?,
	instantLayout: boolean?,
	reservedSlots: Types.Value<{ K }>?
): Editor<V, K>
	local read = ctx.read
	local E = ctx.types.Enum
	local shared = createState(
		ctx,
		UI,
		spec,
		source,
		keyOf,
		controls,
		bodyOf,
		selection,
		sort,
		editing,
		grid,
		location,
		instantLayout,
		reservedSlots
	)
	local moving = shared.moving
	local pointer = createPointer(shared)
	local wrap = createRow(shared, pointer)
	local function overlay(insideBody: boolean?): Frame
		local body = bodyOf()
		registerDrop(shared, body)
		local canvasAt, bodyAt = ctx.observe.CanvasPosition(body), ctx.observe.Position(body)
		pointer.listen(body)
		local root = createFeedback(shared, body, insideBody, canvasAt, bodyAt)
		bindKeys(shared, root, body)
		return root
	end
	return {
		placement = function(key: K, at: ComposeTypes.Placement, use: ComposeTypes.Use): ComposeTypes.Placement
			local move, proposal = use(moving), use(shared.incoming)
			local session = use(shared.drag.state)
			if session == nil or session.target ~= bodyOf() or session.accepted ~= true then
				return at
			end
			if move then
				local ordered = table.clone(move.remaining)
				for index, carried in move.keys do
					table.insert(ordered, move.slot + index, carried)
				end
				local index = table.find(ordered, key)
				if index and reservedSlots then
					local live: { [K]: boolean } = {}
					for row, item in read(source, use) do
						live[keyOf(item, row)] = true
					end
					local occupied = 0
					for slot, candidate in read(reservedSlots, use) do
						if live[candidate] then
							occupied += 1
							if occupied == index then
								return assert(controls.placementOf)(slot)
							end
						end
					end
				end
				return if index then assert(controls.placementOf)(index) else at
			end
			if proposal then
				local data = if type(session.payload) == "table" then session.payload :: { keys: { K }? } else nil
				local keys = if data then data.keys else nil
				if reservedSlots and keys and table.find(read(reservedSlots, use), keys[1]) then
					return at
				end
				local index = assert(controls.indexOfKey)(key)
				local before = proposal.beforeKey
				local start = if before ~= nil then assert(controls.indexOfKey)(before :: K) else nil
				if index and start and index >= start then
					return assert(controls.placementOf)(index + (if keys then math.max(1, #keys) else 1))
				end
			end
			return at
		end,
		pickUp = function(key: K, input: InputObject?): boolean
			if not spec.drag or input == nil or input.UserInputType == E.UserInputType.MouseButton1 then
				return false
			end
			if moving:peek() == nil then
				shared.begin(key, nil, nil, input.UserInputType == E.UserInputType.Touch)
			end
			return moving:peek() ~= nil
		end,
		wrap = wrap,
		overlay = overlay,
		leading = shared.leading,
		trailing = shared.trailing,
		header = shared.header,
		press = pointer.press,
		mouseDown = pointer.mouseDown,
		finish = pointer.finish,
		busy = function(): boolean
			return moving:peek() ~= nil
		end,
		deleteSelected = function()
			shared.remove(true)
		end,
		canDeleteSelected = shared.canDeleteSelected,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="20">
            <Properties>
              <string name="Name">collection_reorder_drop</string>
              <string name="Source"><![CDATA[--!strict
local DragTypes = require("./drag_types")
local Env = require("./environment_types")
local State = require("./collection_reorder_state")
return function<V, K>(shared: State.Reorder<V, K>, body: ScrollingFrame): ()
	local ctx, spec = shared.ctx, shared.spec
	local read = ctx.read
	local moving, incoming, drag = shared.moving, shared.incoming, shared.drag
	local source, controls, reservedSlots = shared.source, shared.controls, shared.reservedSlots
	local collectionId, sourceIndex, location = shared.collectionId, shared.sourceIndex, shared.location
	local horizontal, scaleOf, alongBody = shared.horizontal, shared.scaleOf, shared.alongBody
	local axis, crossAxis = shared.axis, shared.crossAxis
	local focus = shared.focus
	local destination = (if spec.drop then table.clone(spec.drop) else {}) :: DragTypes.TargetSpec
	local accept, drop, update = destination.accepts, destination.onDrop, destination.onUpdate
	if reservedSlots and destination.landing == nil then
		destination.landing = function(info: Env.DropInfo): Env.ScrollRect
			local session = drag.state:peek()
			local payload = if session then session.payload else nil
			local data = if type(payload) == "table" then payload :: { keys: { K }? } else nil
			local key = if data and data.keys then data.keys[1] else nil
			local index = if key ~= nil and table.find(read(reservedSlots), key)
				then assert(controls.indexOfKey)(key :: K)
				else nil
			if index == nil and info.insertion then
				local before = info.insertion.beforeKey
				index = if before ~= nil then assert(controls.indexOfKey)(before :: K) else nil
			end
			local at = assert(controls.placementOf)(index or (#read(reservedSlots) + 1))
			local scale = scaleOf(body)
			local items = body:FindFirstChild("Items") :: GuiObject?
			local origin = if items then items.AbsolutePosition else body.AbsolutePosition - body.CanvasPosition * scale
			return {
				x = origin.X + (if horizontal then at.offset else at.crossOffset) * scale,
				y = origin.Y + (if horizontal then at.crossOffset else at.offset) * scale,
				w = (if horizontal then at.size else at.crossSize) * scale,
				h = (if horizontal then at.crossSize else at.size) * scale,
			}
		end
	end
	local noCarried: { K } = {}
	local cachedRows: { V }? = nil
	local cachedCarried: { K }? = nil
	local remaining: { K } = {}
	local rowIndices: { number } = {}
	local remainingIndex: { [K]: number } = {}
	local function insertion(payload: unknown, info: DragTypes.Proposal)
		local rows: { V } = read(source)
		local data = payload :: { collection: unknown, keys: { K }? }
		local same = type(payload) == "table" and data.collection == collectionId and info.operation == "move"
		local carried = if same then data.keys or noCarried else noCarried
		if rows ~= cachedRows or carried ~= cachedCarried then
			cachedRows, cachedCarried = rows, carried
			remaining, rowIndices, remainingIndex = {}, {}, {}
			local included: { [K]: boolean } = {}
			for _, key in carried :: { K } do
				included[key] = true
			end
			for index, item in rows do
				local key = shared.keyOf(item, index)
				if not included[key] then
					table.insert(remaining, key)
					table.insert(rowIndices, assert(controls.indexOfKey)(key) or index)
					remainingIndex[key] = #remaining
				end
			end
		end
		local slot = 0
		local offset, across = math.huge, math.huge
		if info.position then
			offset = alongBody(body, info.position) + axis(body.CanvasPosition)
			across = crossAxis(info.position - body.AbsolutePosition) / scaleOf(body) + crossAxis(body.CanvasPosition)
		end
		local low, high = 1, #remaining
		while low <= high do
			local middle = math.floor((low + high) / 2)
			local at = assert(controls.placementOf)(rowIndices[middle])
			local crossed = if shared.grid
				then offset >= at.offset + at.size
					or (
						offset >= at.offset
						and offset < at.offset + at.size
						and across >= at.crossOffset + at.crossSize / 2
					)
				else offset >= at.offset + at.size / 2
			if crossed then
				slot, low = middle, middle + 1
			else
				high = middle - 1
			end
		end
		local move = moving:peek()
		if move and move.keyboard and same then
			slot = move.slot
		end
		if info.insertion then
			local before, after = info.insertion.beforeKey, info.insertion.afterKey
			local beforeIndex = if before ~= nil then remainingIndex[before :: K] else nil
			local afterIndex = if after ~= nil then remainingIndex[after :: K] else nil
			if (before ~= nil or after ~= nil) and beforeIndex == nil and afterIndex == nil then
				info.invalid = "The insertion neighbors were removed"
				return
			end
			slot = if beforeIndex then beforeIndex - 1 elseif afterIndex then afterIndex else 0
		end
		info.insertion =
			{ collection = collectionId, beforeKey = remaining[slot + 1], afterKey = remaining[slot], slot = slot }
	end
	local function localMove(payload: unknown, info: DragTypes.Proposal): boolean
		local data = payload :: { collection: unknown, keys: { K }? }
		if
			type(payload) ~= "table"
			or data.collection ~= collectionId
			or not spec.onReorder
			or info.operation ~= "move"
		then
			return false
		end
		if type(data.keys) ~= "table" or #(data.keys :: { K }) == 0 then
			return false
		end
		local live = sourceIndex:peek()
		for _, key in data.keys :: { K } do
			if live[key] == nil then
				return false
			end
		end
		return true
	end
	destination.propose = insertion
	destination.accepts = function(payload: unknown, info: DragTypes.Proposal): (boolean, string?)
		if info.invalid then
			return false, info.invalid
		end
		if read(shared.sort) ~= nil then
			return false, "Clear sorting before inserting items"
		end
		if localMove(payload, info) then
			if location then
				local accepted = location((payload :: { keys: { K } }).keys, (info.insertion :: Env.DropInsertion).slot)
				return accepted, if accepted then nil else "Move items within the same folder"
			end
			return true, nil
		end
		if accept then
			return accept(payload, info)
		end
		return drop ~= nil, "This collection does not accept these items"
	end
	destination.onDrop = function(payload: unknown, info: DragTypes.Proposal): (boolean | "pending")?
		if localMove(payload, info) then
			shared.commitLocal((payload :: { keys: { K } }).keys, (info.insertion :: Env.DropInsertion).slot)
			return true
		end
		return if drop
			then ((drop :: unknown) :: (unknown, Env.DropInfo) -> (boolean | "pending")?)(payload, info)
			else false
	end
	local leave = destination.onLeave
	destination.onLeave = function(payload)
		incoming:set(nil)
		if leave then
			leave(payload)
		end
	end
	destination.onUpdate = function(payload, info, accepted, reason)
		local session = drag.state:peek()
		incoming:set(if accepted and session and session.source ~= body then info.insertion else nil)
		local move = moving:peek()
		if move and not move.keyboard and accepted and move.slot ~= (info.insertion :: Env.DropInsertion).slot then
			local next = table.clone(move)
			next.slot = (info.insertion :: Env.DropInsertion).slot
			moving:set(next)
		end
		if update then
			update(payload, info, accepted, reason)
		end
	end
	destination.autoscroll = spec.autoscroll
	destination.scroll = function(position: Vector2, delta: number): boolean
		local scale = scaleOf(body)
		local size = axis(body.AbsoluteWindowSize) / scale
		local edge = math.min(40, size / 4)
		local at = alongBody(body, position)
		local speed = if edge <= 0
				or at < 0
				or at > size
			then 0
			elseif at < edge then -(edge - at) / edge
			elseif at > size - edge then (at - size + edge) / edge
			else 0
		local rows = read(source)
		local last = if #rows > 0 then assert(controls.placementOf)(#rows) else nil
		local limit = if last then math.max(0, last.offset + last.size - size) else 0
		local now = axis(body.CanvasPosition)
		local next = math.clamp(now + speed * 600 * delta, 0, limit)
		if next == now then
			return false
		end
		shared.canvasOffset(body, next)
		if moving:peek() then
			shared.movePointer(position)
		end
		return true
	end
	if spec.drop or spec.onReorder then
		destination.feedback = false
		drag.register(body, destination)
	end
	drag.own(body)
	ctx.Compose.watch(function(use)
		local node = use(focus)
		local session = drag.state:peek()
		if session and session.source == body and session.mode == "armed" then
			drag.hover(drag.targetOf(node), nil)
		end
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="21">
            <Properties>
              <string name="Name">collection_reorder_feedback</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local EngineTypes = require("./engine_types")
local InputProps = require("./input_props")
local State = require("./collection_reorder_state")
local STACK = 6
local FEEDBACK_Z = 1000
return function<V, K>(
	shared: State.Reorder<V, K>,
	body: ScrollingFrame,
	insideBody: boolean?,
	canvasAt: ComposeTypes.Cell<Vector2>,
	bodyAt: ComposeTypes.Cell<UDim2>
): Frame
	local ctx, spec, gesture = shared.ctx, shared.spec, shared.gesture
	local Compose, Host = ctx.Compose, ctx.Host
	local read = ctx.read
	local D2, V2 = ctx.types.UDim2, ctx.types.Vector2
	local moving, incoming, choosingDestination, drag =
		shared.moving, shared.incoming, shared.choosingDestination, shared.drag
	local source, controls, rowNodes = shared.source, shared.controls, shared.rowNodes
	local grid, horizontal, scaleOf = shared.grid, shared.horizontal, shared.scaleOf
	local axis, crossAxis = shared.axis, shared.crossAxis
	local function dragImage(dropY: (ComposeTypes.Use) -> number): (Frame, number, UDim2)
		local move = assert(moving:peek())
		local source = rowNodes[move.key]
		local index = assert(controls.indexOfKey)(move.key)
		local placement = if index then assert(controls.placementOf)(index) else nil
		local extent = if placement then placement.size else 0
		local nativeSize = if source then source.AbsoluteSize / scaleOf(body) else V2.zero
		local crossSize = if crossAxis(nativeSize) > 0
			then crossAxis(nativeSize)
			elseif placement then placement.crossSize
			else 0
		local previewKeys = { move.key }
		for _, key in move.keys do
			if key ~= move.key then
				table.insert(previewKeys, key)
			end
		end
		local layers = math.min(3, #move.keys)
		local stack = STACK * (layers - 1)
		local function sized(inset: number): UDim2
			return if grid
				then (if horizontal then D2.fromOffset(extent, crossSize) else D2.fromOffset(crossSize, extent))
				elseif horizontal then D2.new(0, extent, 1, -inset)
				else D2.new(1, -inset, 0, extent)
		end
		local imageProps: Types.FrameProps = {
			Name = "DragImage",
			ZIndex = FEEDBACK_Z + 1,
			BackgroundTransparency = 1,
			Interactable = false,
			Size = if grid
				then (if horizontal
					then D2.fromOffset(extent + stack, crossSize + stack)
					else D2.fromOffset(crossSize + stack, extent + stack))
				elseif horizontal then D2.new(0, extent + stack, 1, 0)
				else D2.new(1, 0, 0, extent + stack),
			Position = function(use: ComposeTypes.Use)
				local live = use(moving)
				local base = if horizontal then use(bodyAt).X.Offset else use(bodyAt).Y.Offset
				local window = axis(body.AbsoluteWindowSize) / scaleOf(body)
				local along = if live and live.pointer
					then math.clamp(
						shared.alongBody(body, live.pointer) + base - extent / 2,
						base,
						math.max(base, base + window - extent - stack)
					)
					else dropY(use)
				local across = 0
				if grid then
					local pointer = if live and live.pointer
						then crossAxis(live.pointer - body.AbsolutePosition) / scaleOf(body) - crossSize / 2
						else (if placement then placement.crossOffset else 0)
					if live and live.keyboard then
						local candidate = live.remaining[live.slot + 1]
						local index = if candidate then assert(controls.indexOfKey)(candidate) else #live.rows
						local at = assert(controls.placementOf)(index or 1)
						pointer = at.crossOffset + (if candidate then 0 else at.crossSize) - crossAxis(use(canvasAt))
					end
					across = math.clamp(
						pointer,
						0,
						math.max(0, crossAxis(body.AbsoluteWindowSize) / scaleOf(body) - crossSize - stack)
					)
				end
				return if horizontal then D2.fromOffset(along, across) else D2.fromOffset(across, along)
			end,
			ctx.styled(
				ctx.text({
					Name = "DragLabel",
					ZIndex = FEEDBACK_Z + 2,
					BackgroundTransparency = 0,
					AnchorPoint = V2.new(1, 0),
					Position = D2.fromScale(1, 0),
					Visible = #move.keys > 1,
					Text = function(use: ComposeTypes.Use)
						local live = use(moving)
						if live == nil then
							return ""
						end
						if #live.keys > 1 then
							return tostring(#live.keys) .. " selected"
						end
						local index = assert(controls.indexOfKey)(live.key)
						return if spec.dragLabel and index then spec.dragLabel(live.rows[index]) else tostring(live.key)
					end,
				}),
				"badge"
			),
		}
		local image = Host.Frame(imageProps)
		local top = FEEDBACK_Z + 1
		for layer = layers, 1, -1 do
			local original = rowNodes[previewKeys[layer]] or source
			local parent = if original then original.Parent else nil
			local painted = if parent
					and parent:IsA("Frame")
					and parent:HasTag("facet-tablerow")
				then parent
				else original
			local copy = if painted then painted:Clone() else nil
			if copy then
				local cells = copy:FindFirstChild("Cells", true)
				if cells and cells:IsA("GuiObject") then
					cells.Visible = true
				end
				local row = if copy.Name == "Reorderable" then copy else copy:FindFirstChild("Reorderable", true)
				if row then
					for _, name in { "Move", "SelectMark", "Minus", "Confirm" } do
						local control = row:FindFirstChild(name)
						if control and control:IsA("GuiObject") then
							control.Visible = false
						end
					end
				end
				for _, node in copy:GetDescendants() do
					if node:GetAttribute("FacetDragExclude") == true then
						node:Destroy()
					end
				end
				local nodes = copy:GetDescendants()
				table.insert(nodes, copy)
				local base = top
				for _, node in nodes do
					local rest = node:GetAttribute("FacetDragRestX")
					if type(rest) == "number" and node:IsA("GuiObject") then
						node.Position =
							D2.new(node.Position.X.Scale, rest, node.Position.Y.Scale, node.Position.Y.Offset)
					end
					if node:IsA("GuiObject") then
						node.Interactable, node.Active, node.Selectable = false, false, false
						node.ZIndex += base
						top = math.max(top, node.ZIndex)
					elseif node:IsA("Path2D") then
						node.ZIndex += base
						top = math.max(top, node.ZIndex)
					elseif node:IsA("UIDragDetector") or node:IsA("InputContext") then
						((node :: unknown) :: { Enabled: boolean }).Enabled = false
					end
				end
				copy.Name = "Reorderable"
				copy.AnchorPoint = V2.zero
				copy.Position = D2.fromOffset(STACK * (layer - 1), STACK * (layer - 1))
				copy.Size = sized(stack)
				copy.ZIndex = base + 1
				copy.Parent = image
			end
		end
		(image:FindFirstChild("DragLabel") :: GuiObject).ZIndex = top + 1
		return image, top + 2, sized(stack)
	end
	local rootProps: Types.FrameProps = {
		Name = "ReorderFeedback",
		ZIndex = FEEDBACK_Z,
		Position = function(use: ComposeTypes.Use)
			return if insideBody then D2.fromOffset(use(canvasAt).X, use(canvasAt).Y) else D2.fromOffset(0, 0)
		end,
		Size = D2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Attributes = { FacetDragFeedback = true } :: EngineTypes.Attributes,
		Compose.show(function(use)
			return use(incoming) ~= nil
		end, function()
			local function placement(use: ComposeTypes.Use)
				local proposal = use(incoming)
				local rows = read(source, use)
				if #rows == 0 then
					return { offset = 0, size = 44, crossOffset = 0, crossSize = 44 }, true
				end
				local key = proposal and proposal.beforeKey
				local index = if key ~= nil then assert(controls.indexOfKey)(key :: K) else #rows
				return assert(controls.placementOf)(index or #rows), key ~= nil
			end
			return ctx.styled(
				Host.Frame {
					Name = "InsertionLine",
					BorderSizePixel = 0,
					ZIndex = FEEDBACK_Z,
					Size = function(use: ComposeTypes.Use)
						local at = placement(use)
						return if grid
							then (if horizontal then D2.fromOffset(at.size, 2) else D2.fromOffset(2, at.size))
							elseif horizontal then D2.new(0, 2, 1, 0)
							else D2.new(1, 0, 0, 2)
					end,
					Position = function(use: ComposeTypes.Use)
						local at, before = placement(use)
						local offset = if insideBody
							then V2.zero
							else V2.new(use(bodyAt).X.Offset, use(bodyAt).Y.Offset)
						local along = at.offset + (if not grid and not before then at.size else 0) - axis(use(canvasAt))
						local across = if grid
							then at.crossOffset + (if before then 0 else at.crossSize) - crossAxis(use(canvasAt))
							else 0
						return D2.fromOffset(
							offset.X + (if horizontal then along else across),
							offset.Y + (if horizontal then across else along)
						)
					end,
				},
				"drop-line"
			)
		end),
		Compose.show(function(use: ComposeTypes.Use)
			return use(moving) ~= nil
		end, function()
			local function dropY(use: ComposeTypes.Use): number
				local move = use(moving)
				if move == nil then
					return 0
				end
				local candidate = move.remaining[move.slot + 1]
				local index = if candidate then assert(controls.indexOfKey)(candidate) else #move.rows
				local at = assert(controls.placementOf)(index or 1)
				return (if insideBody then 0 elseif horizontal then use(bodyAt).X.Offset else use(bodyAt).Y.Offset)
					+ at.offset
					+ (if candidate then 0 else at.size)
					- axis(use(canvasAt))
			end
			local image, targetZ, frontSize = dragImage(dropY)
			drag.preview(image, body, frontSize)
			image.Visible = false
			local keyboardTargetProps: InputProps.ButtonProps = {
				Name = "Drop",
				label = "Drop",
				Position = D2.new(1, -100, 0, 0),
				Size = D2.fromOffset(100, 40),
				ZIndex = targetZ,
				Visible = function(use: ComposeTypes.Use)
					local move = use(moving)
					return move ~= nil
						and move.keyboard
						and not use(choosingDestination)
						and (spec.onReorder ~= nil or spec.drop ~= nil)
				end,
				onActivate = shared.commit,
			}
			gesture.keyboardTarget = shared.UI.Button(keyboardTargetProps)
			local nativeProps: Types.FrameProps = {
				Name = "DropFeedback",
				ZIndex = FEEDBACK_Z,
				gesture.keyboardTarget :: ComposeTypes.Child,
				Size = D2.fromScale(1, 1),
				BackgroundTransparency = 1,
				ctx.styled(
					Host.Frame "DropLine" {
						Visible = function(use)
							local session = use(drag.state)
							local move = use(moving)
							return (spec.onReorder ~= nil or spec.drop ~= nil)
								and session ~= nil
								and (
									(move and move.keyboard and not use(choosingDestination))
									or (session.target == body and body:GetAttribute("FacetDropState") == "accepted")
								)
						end,
						Size = function(use: ComposeTypes.Use): UDim2
							local move = use(moving)
							if grid and move then
								local candidate = move.remaining[move.slot + 1]
								local index = if candidate then assert(controls.indexOfKey)(candidate) else #move.rows
								local at = assert(controls.placementOf)(index or 1)
								return if horizontal then D2.fromOffset(at.size, 2) else D2.fromOffset(2, at.size)
							end
							return if horizontal then D2.new(0, 2, 1, 0) else D2.new(1, 0, 0, 2)
						end,
						BorderSizePixel = 0,
						ZIndex = FEEDBACK_Z,
						Position = function(use: ComposeTypes.Use)
							local move = use(moving)
							if grid and move then
								local candidate = move.remaining[move.slot + 1]
								local index = if candidate then assert(controls.indexOfKey)(candidate) else #move.rows
								local at = assert(controls.placementOf)(index or 1)
								local along = at.offset - axis(use(canvasAt))
								local across = at.crossOffset
									+ (if candidate then 0 else at.crossSize)
									- crossAxis(use(canvasAt))
								return if horizontal then D2.fromOffset(along, across) else D2.fromOffset(across, along)
							end
							return if horizontal then D2.fromOffset(dropY(use), 0) else D2.fromOffset(0, dropY(use))
						end,
					},
					"divider"
				),
				image,
			}
			return Host.Frame(nativeProps)
		end),
	}
	local root = Host.Frame(rootProps)
	return root
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="22">
            <Properties>
              <string name="Name">collection_reorder_keys</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local State = require("./collection_reorder_state")
return function<V, K>(shared: State.Reorder<V, K>, root: Frame, body: ScrollingFrame): ()
	local ctx, spec, gesture = shared.ctx, shared.spec, shared.gesture
	local E = ctx.types.Enum
	local moving, choosingDestination, drag, focus =
		shared.moving, shared.choosingDestination, shared.drag, shared.focus
	local rowNodes, gui, horizontal = shared.rowNodes, shared.gui, shared.horizontal
	local reorderable, deletable, begin, step = shared.reorderable, shared.deletable, shared.begin, shared.step
	local commit, chosen = shared.commit, shared.chosen
	local function keyboardActive(use: ComposeTypes.Use): boolean
		local move = use(moving)
		local node = use(focus)
		return (spec.onReorder ~= nil or spec.drop ~= nil)
			and move ~= nil
			and move.keyboard
			and not use(choosingDestination)
			and (node == nil or node == gesture.keyboardTarget or node:IsDescendantOf(body))
	end
	if spec.drag then
		local function focusedKey(use: ComposeTypes.Use?): K?
			local node = if use then use(focus) else focus:peek()
			if not node then
				return nil
			end
			for key, frame in rowNodes do
				if frame.Parent and node:IsDescendantOf(frame.Parent) then
					return key
				end
			end
			return nil
		end
		ctx.action(root, "CollectionPickUp", { E.KeyCode.Return, E.KeyCode.ButtonA }, function(use)
			return use(moving) == nil and use(drag.state) == nil and focusedKey(use) ~= nil
		end, function()
			local key = focusedKey(nil)
			if key ~= nil then
				begin(key)
			end
		end, { priority = 400 })
	end
	if spec.drag and (spec.onReorder or spec.drop) then
		ctx.action(root, "ChooseDropDestination", { E.KeyCode.ButtonY }, function(use)
			local move = use(moving)
			local session = use(drag.state)
			return move ~= nil and move.keyboard and session ~= nil and not session.pending
		end, function()
			choosingDestination:set(not choosingDestination:peek())
			if gui then
				local move = moving:peek()
				local row = move and rowNodes[move.key]
				local hit = row and row.Parent and row.Parent:FindFirstChild("RowHit")
				gui.SelectedObject = if choosingDestination:peek()
						and hit
						and hit:IsA("GuiObject")
					then hit
					else gesture.keyboardTarget
			end
			local session = drag.state:peek()
			if session then
				session.spec.navigationHint = if choosingDestination:peek()
					then "Y: reorder here"
					else "Y: choose destination"
				drag.hover(drag.targetOf(focus:peek()), nil)
			end
		end, { priority = 400 })
	end
	local earlier = if horizontal then { E.KeyCode.Left, E.KeyCode.DPadLeft } else { E.KeyCode.Up, E.KeyCode.DPadUp }
	local later = if horizontal
		then { E.KeyCode.Right, E.KeyCode.DPadRight }
		else { E.KeyCode.Down, E.KeyCode.DPadDown }
	ctx.action(root, "ReorderUp", earlier, keyboardActive, function()
		step(-1, true)
	end, { priority = 400, capture = true })
	ctx.action(root, "ReorderDown", later, keyboardActive, function()
		step(1, true)
	end, { priority = 400, capture = true })
	if shared.grid then
		ctx.action(
			root,
			"ReorderCrossEarlier",
			if horizontal then { E.KeyCode.Up, E.KeyCode.DPadUp } else { E.KeyCode.Left, E.KeyCode.DPadLeft },
			keyboardActive,
			function()
				step(-1)
			end,
			{ priority = 400, capture = true }
		)
		ctx.action(
			root,
			"ReorderCrossLater",
			if horizontal then { E.KeyCode.Down, E.KeyCode.DPadDown } else { E.KeyCode.Right, E.KeyCode.DPadRight },
			keyboardActive,
			function()
				step(1)
			end,
			{ priority = 400, capture = true }
		)
	end
	ctx.action(root, "ReorderCancel", { E.KeyCode.Escape, E.KeyCode.ButtonB }, function(use: ComposeTypes.Use)
		return use(moving) ~= nil
	end, shared.cancel, { priority = 400 })
	ctx.action(root, "ReorderDrop", { E.KeyCode.Return, E.KeyCode.ButtonA }, function(use)
		local move = use(moving)
		return move ~= nil
			and move.keyboard
			and not use(choosingDestination)
			and (spec.onReorder ~= nil or spec.drop ~= nil)
	end, commit, { priority = 400 })
	if reorderable then
		local function nudge(delta: number)
			local keys = chosen()
			if #keys > 0 then
				begin(keys[1], nil, true)
				step(delta)
				commit()
			end
		end
		local function ready(use: ComposeTypes.Use): boolean
			return use(moving) == nil and #chosen(use) > 0
		end
		ctx.action(root, "MoveRowsEarlier", { E.KeyCode.ButtonL1 }, ready, function()
			nudge(-1)
		end, { priority = 400 })
		ctx.action(root, "MoveRowsLater", { E.KeyCode.ButtonR1 }, ready, function()
			nudge(1)
		end, { priority = 400 })
	end
	if deletable then
		ctx.action(
			root,
			"DeleteRows",
			{ E.KeyCode.Delete, E.KeyCode.Backspace, E.KeyCode.ButtonX },
			shared.canDelete,
			function()
				shared.remove(false)
			end,
			{ priority = 400 }
		)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="23">
            <Properties>
              <string name="Name">collection_reorder_pointer</string>
              <string name="Source"><![CDATA[--!strict
local activation = require("./activation")
local ComposeTypes = require("../vendor/compose/core")
local DragTypes = require("./drag_types")
local State = require("./collection_reorder_state")
local SLOP = 10
export type Pointer<K> = {
	mouseDown: (Vector2) -> (),
	press: (K, InputObject) -> (),
	finish: (InputObject) -> (),
	listen: (ScrollingFrame) -> (),
}
return function<V, K>(shared: State.Reorder<V, K>): Pointer<K>
	local ctx, spec, gesture = shared.ctx, shared.spec, shared.gesture
	local read = ctx.read
	local V2, E = ctx.types.Vector2, ctx.types.Enum
	local moving, source = shared.moving, shared.source
	local reorderable, arbiter = shared.reorderable, shared.arbiter
	local grid, pluginGui, editing = shared.grid, shared.pluginGui, shared.editing
	local disarm, begin, axis, movePointer = shared.disarm, shared.begin, shared.axis, shared.movePointer
	local cancel, commit, input = shared.cancel, shared.commit, shared.input
	local pressed: K? = nil
	local pressOrigin: Vector2? = nil
	local nativeOrigin: Vector2? = nil
	local pointerOffset = V2.new()
	local function mouseDown(position: Vector2)
		if pluginGui then
			nativeOrigin = position
			gesture.pickupPosition = position
			if gesture.pendingInput then
				pressOrigin = position
				pointerOffset = position - V2.new(gesture.pendingInput.Position.X, gesture.pendingInput.Position.Y)
			end
		end
	end
	local function press(key: K, value: InputObject): ()
		local at: Vector3? = value.Position
		if not reorderable or at == nil or moving:peek() ~= nil then
			return
		end
		if gesture.touchOrigin then
			return
		end
		local row = shared.rowNodes[key]
		local options: DragTypes.SourceSpec? = nil
		if value.UserInputType == E.UserInputType.Touch and spec.drag then
			local items, keys = {}, {}
			local selected = read(shared.selection)
			for index, item in read(spec.selectionFrom or source) do
				local candidate = shared.keyOf(item, index)
				if shared.movable(item) and (candidate == key or (selected[key] and selected[candidate])) then
					table.insert(items, item)
					table.insert(keys, candidate)
				end
			end
			if #keys == 0 then
				return
			end
			options = table.clone(spec.drag(items, keys)) :: DragTypes.SourceSpec
			gesture.touchTransfer =
				{ key = key, pointer = value, options = options :: DragTypes.SourceSpec, keys = keys, items = items }
		end
		if
			row
			and (value.UserInputType == E.UserInputType.MouseButton1 or value.UserInputType == E.UserInputType.Touch)
		then
			if
				not arbiter.begin(value, row, V2.new(at.X, at.Y), {
					pickup = if value.UserInputType == E.UserInputType.Touch
						then (options and options.touchPickup) or "longPress"
						else "immediate",
					axis = (options and options.touchDragAxis)
						or (if grid then "XY" elseif shared.horizontal then "X" else "Y"),
					scroll = true,
				})
			then
				return
			end
			gesture.gestureOwner = row
		end
		if value.UserInputType == E.UserInputType.MouseButton1 then
			if pluginGui then
				activation.release(value)
			end
			pressed, pressOrigin, gesture.pendingInput = key, V2.new(at.X, at.Y), value
			if pluginGui and nativeOrigin then
				pressOrigin = nativeOrigin
				pointerOffset = nativeOrigin - V2.new(at.X, at.Y)
			end
			gesture.pickupPosition = pressOrigin
		elseif value.UserInputType == E.UserInputType.Touch and (editing == nil or editing == false) then
			disarm()
			gesture.touchKey, gesture.touchOrigin, gesture.pendingInput = key, V2.new(at.X, at.Y), value
			gesture.pickupPosition = gesture.touchOrigin
		end
	end
	local function moveMouse(position: Vector2)
		if pressed ~= nil and pressOrigin ~= nil and gesture.captured == nil then
			if
				(if grid then (position - pressOrigin).Magnitude else math.abs(axis(position) - axis(pressOrigin))) >= 6
			then
				local key = pressed
				pressed, pressOrigin = nil, nil
				begin(key, position)
				activation.consume(gesture.pendingInput)
			end
		end
		local move = moving:peek()
		if move and move.pointer and not move.keyboard then
			movePointer(position)
		end
	end
	local function finishMouse(value: InputObject)
		if value.UserInputType ~= E.UserInputType.MouseButton1 then
			return
		end
		if pluginGui and value == gesture.pendingInput and value.UserInputState ~= E.UserInputState.Cancel then
			moveMouse(V2.new(value.Position.X, value.Position.Y) + pointerOffset)
		end
		pressed, pressOrigin, nativeOrigin = nil, nil, nil
		pointerOffset = V2.new()
		local move = moving:peek()
		if move and move.pointer and not move.keyboard then
			if value.UserInputState == E.UserInputState.Cancel then
				cancel()
			else
				commit()
			end
		end
	end
	local function listen(body: ScrollingFrame): ()
		if pluginGui then
			ctx.runtime.connect(body, "MouseMoved", function(x: number, y: number)
				moveMouse(V2.new(x, y))
			end)
			ctx.runtime.connect(pluginGui, "WindowFocusReleased", function()
				pressed, pressOrigin = nil, nil
				cancel()
			end)
		end
		if input then
			ctx.runtime.connect(input, "InputBegan", activation.release)
			ctx.runtime.connect(input, "InputChanged", function(value: InputObject)
				if gesture.pendingInput and value.UserInputType == E.UserInputType.MouseMovement then
					arbiter.move(gesture.pendingInput, V2.new(value.Position.X, value.Position.Y))
				end
				if gesture.touchOrigin and value == gesture.pendingInput then
					local position = V2.new(value.Position.X, value.Position.Y)
					local kind = arbiter.move(value, position)
					if kind == "drag" and gesture.touchKey ~= nil then
						local key = gesture.touchKey
						disarm()
						begin(key, position)
						movePointer(position)
						return
					end
					if kind == "scroll" or kind == "pan" or (position - gesture.touchOrigin).Magnitude > SLOP then
						disarm()
					end
					return
				end
				if
					pluginGui ~= nil
					and pressed ~= nil
					and pressOrigin ~= nil
					and gesture.captured == nil
					and value.UserInputType == E.UserInputType.MouseMovement
				then
					local position = V2.new(value.Position.X, value.Position.Y)
					if
						(
							if grid
								then (position - pressOrigin).Magnitude
								else math.abs(axis(position) - axis(pressOrigin))
						) >= 6
					then
						local key = pressed
						pressed, pressOrigin = nil, nil
						begin(key, position)
						movePointer(position)
					end
					return
				end
				if
					gesture.captured
					and (
						value == gesture.captured
						or (
							gesture.captured.UserInputType == E.UserInputType.MouseButton1
							and value.UserInputType == E.UserInputType.MouseMovement
						)
					)
				then
					if value.UserInputState == E.UserInputState.Cancel then
						cancel()
					else
						local position = V2.new(value.Position.X, value.Position.Y)
						if gesture.origin then
							gesture.travel = math.max(gesture.travel, (position - gesture.origin).Magnitude)
						end
						movePointer(position)
					end
				end
			end)
			ctx.runtime.connect(input, "InputEnded", function(value: InputObject)
				if gesture.gestureOwner then
					arbiter.finish(value, gesture.gestureOwner, value.UserInputState == E.UserInputState.Cancel)
				end
				if value.UserInputType == E.UserInputType.MouseButton1 then
					pressed, pressOrigin = nil, nil
				end
				if gesture.touchOrigin and value == gesture.pendingInput then
					disarm()
				end
				if
					gesture.captured
					and (
						value == gesture.captured
						or (
							gesture.captured.UserInputType == E.UserInputType.MouseButton1
							and value.UserInputType == E.UserInputType.MouseButton1
						)
					)
				then
					if value.UserInputState == E.UserInputState.Cancel then
						cancel()
					else
						commit()
					end
				end
			end)
			ctx.runtime.connect(input, "WindowFocusReleased", cancel)
			local touch, mouse, keyboard, gamepad =
				ctx.observe.TouchEnabled(input),
				ctx.observe.MouseEnabled(input),
				ctx.observe.KeyboardEnabled(input),
				ctx.observe.GamepadEnabled(input)
			ctx.Compose.watch(function(use: ComposeTypes.Use)
				local move = use(moving)
				if
					move
					and (
						(
							gesture.captured
							and gesture.captured.UserInputType == E.UserInputType.Touch
							and use(touch) == false
						)
						or (gesture.captured and gesture.captured.UserInputType == E.UserInputType.MouseButton1 and use(
							mouse
						) == false)
						or (
							move.keyboard
							and use(keyboard) == false
							and use(gamepad) == false
							and (not move.tap or use(touch) == false)
						)
					)
				then
					cancel()
				end
			end)
		end
	end
	return { mouseDown = mouseDown, press = press, finish = finishMouse, listen = listen }
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="24">
            <Properties>
              <string name="Name">collection_reorder_row</string>
              <string name="Source"><![CDATA[--!strict
local policy = require("./collection_policy")
local activation = require("./activation")
local scrollLock = require("./scroll_lock")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local EngineTypes = require("./engine_types")
local InputTypes = require("./input_types")
local InputProps = require("./input_props")
local pointerOf = require("./drag_pointer")
local State = require("./collection_reorder_state")
local Pointer = require("./collection_reorder_pointer")
local TAP = 3
return function<V, K>(
	shared: State.Reorder<V, K>,
	pointer: Pointer.Pointer<K>
): (GuiObject, ComposeTypes.Readable<V>, K, boolean?) -> Frame
	local ctx, UI, spec, gesture = shared.ctx, shared.UI, shared.spec, shared.gesture
	local Compose, Host = ctx.Compose, ctx.Host
	local read = ctx.read
	local D2, V2, E = ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local moving, selection, sort = shared.moving, shared.selection, shared.sort
	local grid, reorderable, preferred = shared.grid, shared.reorderable, shared.preferred
	local controlsShown, leading, trailing, header =
		shared.controlsShown, shared.leading, shared.trailing, shared.header
	local mode, minusShown = shared.mode, shared.minusShown
	local rowNodes, rowKeys = shared.rowNodes, shared.rowKeys
	local gui, movable = shared.gui, shared.movable
	local begin, commit, movePointer = shared.begin, shared.commit, shared.movePointer
	local axis, crossAxis = shared.axis, shared.crossAxis
	local selectedObject: ComposeTypes.Readable<unknown>? = if ctx.config.guiService
		then ctx.observe.SelectedObject(ctx.config.guiService)
		else nil
	local function wrap(row: GuiObject, current: ComposeTypes.Readable<V>, key: K, painted: boolean?): Frame
		rowKeys[row] = key
		local handleNode: Instance? = nil
		local function toggle()
			if moving:peek() then
				commit()
			else
				begin(key)
			end
		end
		local function activate(activation: InputObject?)
			if
				activation
				and (
					activation.UserInputType == E.UserInputType.MouseButton1
					or activation.UserInputType == E.UserInputType.Touch
				)
			then
				return
			end
			toggle()
		end
		local armed = false
		local confirming = Compose.cell(false)
		Compose.watch(function(use: ComposeTypes.Use)
			if not use(controlsShown) and confirming:peek() then
				confirming:set(false)
			end
		end)
		local handle = if reorderable
			then Compose.show(controlsShown, function()
				local handleProps: InputProps.ButtonProps = {
					Name = "Move",
					Visible = function(use: ComposeTypes.Use)
						return use(controlsShown) and not use(confirming)
					end,
					AnchorPoint = V2.new(1, 0),
					Position = D2.fromScale(1, 0),
					Size = if grid then D2.fromOffset(44, 44) else D2.new(0, 44, 1, 0),
					AutomaticSize = E.AutomaticSize.None,
					appearance = "utility",
					label = "",
					ctx.icon(function(use: ComposeTypes.Use)
						local move = use(moving)
						return if move and move.key == key then "checkmark" elseif grid then "view.grid" else "menu"
					end, {
						Name = "ReorderIcon",
						AnchorPoint = V2.new(0.5, 0.5),
						Position = D2.fromScale(0.5, 0.5),
					}) :: ComposeTypes.Child,
					enabled = function(use: ComposeTypes.Use)
						return movable(use(current)) and read(sort, use) == nil
					end,
					onActivate = activate,
					ctx.Host.UIDragDetector({
						DragStyle = if grid
							then E.UIDragDetectorDragStyle.TranslatePlane
							else E.UIDragDetectorDragStyle.TranslateLine,
						DragAxis = if shared.horizontal then V2.new(1, 0) else V2.new(0, 1),
						ResponseStyle = E.UIDragDetectorResponseStyle.CustomOffset,
						Enabled = function(use: ComposeTypes.Use)
							local selected = if selectedObject then use(selectedObject) else nil
							local held = preferred ~= nil
								and use(preferred) == E.PreferredInput.Gamepad
								and handleNode ~= nil
								and rawequal(selected, handleNode)
							return movable(use(current)) and read(sort, use) == nil and not held
						end,
						DragStart = function(position)
							position = pointerOf(ctx, position)
							local current = moving:peek()
							gesture.origin, gesture.travel = position, 0
							gesture.pickupPosition = position
							armed = current ~= nil and current.keyboard
							if not armed then
								begin(key, position)
								gesture.selectedPickup = moving:peek() ~= nil
									and gui ~= nil
									and handleNode ~= nil
									and rawequal(gui.SelectedObject, handleNode)
							end
						end,
						DragContinue = function(position)
							position = pointerOf(ctx, position)
							if gesture.origin then
								gesture.travel = math.max(gesture.travel, (position - gesture.origin).Magnitude)
							end
							if not armed or gesture.travel >= TAP then
								movePointer(position)
							end
						end,
						DragEnd = function()
							local tapped = gesture.origin ~= nil and gesture.travel < TAP
							gesture.origin = nil
							if armed then
								armed = false
								commit()
								return
							end
							if tapped then
								shared.cancel()
								toggle()
							else
								commit()
							end
						end,
					}),
				}
				local handle = UI.Button(handleProps)
				handleNode = handle
				if handle then
					ctx.runtime.connect(handle, "InputBegan", function(value: InputObject)
						if
							value.UserInputType == E.UserInputType.MouseButton1
							or value.UserInputType == E.UserInputType.Touch
						then
							gesture.pendingInput = value
							local move = moving:peek()
							if move and move.pointer and gesture.captured == nil then
								gesture.captured = value
								activation.consume(value)
								if value.UserInputType == E.UserInputType.Touch and not gesture.releaseScrollers then
									gesture.releaseScrollers = scrollLock.holdAncestors(handle)
								end
							end
						end
					end)
				end
				return handle
			end)
			else nil
		local function deletableRow(use: ComposeTypes.Use): boolean
			local item = use(current)
			return policy.allows(spec.rowDeletable, item) and not policy.disabled(spec.disabled, item)
		end
		local minusProps: InputProps.ButtonProps = {
			Name = "Minus",
			label = "−",
			name = "Delete",
			shape = "circle" :: "circle",
			role = "destructive" :: InputTypes.ButtonRole,
			AnchorPoint = V2.new(0.5, 0.5),
			Position = if grid then D2.fromOffset(22, 22) else D2.new(0, 22, 0.5, 0),
			Size = D2.fromOffset(28, 28),
			Visible = controlsShown,
			enabled = deletableRow,
			onActivate = function()
				confirming:set(not confirming:peek())
			end,
		}
		local confirmProps: InputProps.ButtonProps = {
			Name = "Delete",
			label = "Delete",
			role = "destructive" :: InputTypes.ButtonRole,
			AnchorPoint = V2.new(1, 0),
			Position = D2.fromScale(1, 0),
			Size = if grid then D2.fromOffset(88, 44) else D2.new(0, 88, 1, 0),
			AutomaticSize = E.AutomaticSize.None,
			Visible = function(use: ComposeTypes.Use)
				return use(controlsShown) and use(confirming)
			end,
			enabled = deletableRow,
			onActivate = function()
				confirming:set(false)
				if spec.onDelete then
					spec.onDelete({ key })
				end
			end,
		}
		local minus = if minusShown then UI.Button(minusProps) else nil
		local confirm = if minusShown then UI.Button(confirmProps) else nil
		local mark = if shared.marked
			then ctx.styled(
				Host.Frame "SelectMark" {
					AnchorPoint = V2.new(0.5, 0.5),
					Position = if grid then D2.fromOffset(22, 22) else D2.new(0, 22, 0.5, 0),
					Size = D2.fromOffset(18, 18),
					BackgroundTransparency = 1,
					Selectable = false,
					Visible = shared.markShown,
					ctx.corner(if mode == "multiple" then 3 else 9) :: Types.Child,
					(if mode == "multiple"
						then ctx.icon("checkmark", {
							Name = "Check",
							AnchorPoint = V2.new(0.5, 0.5),
							Position = D2.fromScale(0.5, 0.5),
							Size = D2.fromOffset(14, 14),
							Visible = function(use: ComposeTypes.Use)
								return use(selection)[key] == true
							end,
						})
						else ctx.styled(
							Host.Frame "Dot" {
								AnchorPoint = V2.new(0.5, 0.5),
								Position = D2.fromScale(0.5, 0.5),
								Size = D2.fromOffset(8, 8),
								Visible = function(use: ComposeTypes.Use)
									return use(selection)[key] == true
								end,
								ctx.corner(4) :: Types.Child,
							},
							"fill"
						)) :: Types.Child,
				},
				"radio-mark"
			)
			else nil
		local function rightOf(use: ComposeTypes.Use): number
			return if use(confirming) then 88 else use(trailing)
		end
		local edgeSpring = ctx.motionSpring("snappy")
		local left = ctx.runtime.spring(function(use: ComposeTypes.Use)
			return use(leading)
		end, { period = edgeSpring.period, damping = edgeSpring.damping })
		local right = ctx.runtime.spring(rightOf, { period = edgeSpring.period, damping = edgeSpring.damping })
		local function edges(use: ComposeTypes.Use): Vector2
			if shared.instantLayout or shared.motionReduced(use) then
				return V2.new(use(leading), rightOf(use))
			end
			return V2.new(use(left), use(right))
		end
		local nativeProps: Types.FrameProps = {
			Name = "Reorderable",
			Size = D2.fromScale(1, 1),
			BackgroundTransparency = if painted then nil else 1,
			Attributes = {
				FacetDragging = function(use: ComposeTypes.Use)
					local move = use(moving)
					return move ~= nil and move.included[key] == true
				end,
			} :: EngineTypes.Attributes,
			Host.Frame "Cells" {
				Visible = function(use: ComposeTypes.Use)
					local move = use(moving)
					return move == nil or not move.included[key]
				end,
				Position = function(use: ComposeTypes.Use)
					return if grid
						then D2.fromOffset(0, use(header))
						else D2.fromOffset(math.floor(edges(use).X + 0.5), 0)
				end,
				Size = function(use: ComposeTypes.Use)
					local at = edges(use)
					return if grid
						then D2.new(1, 0, 1, -use(header))
						else D2.new(1, -math.floor(at.X + at.Y + 0.5), 1, 0)
				end,
				BackgroundTransparency = 1,
				row,
			},
		}
		for _, control in { handle, minus, confirm, mark } :: { ComposeTypes.Child } do
			if control then
				nativeProps[#nativeProps + 1] = control
			end
		end
		local frame = Host.Frame(nativeProps)
		rowNodes[key] = frame
		ctx.runtime.connect(frame, "TouchLongPress", function(positions: { Vector2 }, state: Enum.UserInputState)
			if state ~= E.UserInputState.Begin or gesture.touchKey ~= key or moving:peek() ~= nil then
				return
			end
			local position = if gesture.pendingInput
				then V2.new(gesture.pendingInput.Position.X, gesture.pendingInput.Position.Y)
				elseif positions[1] then pointerOf(ctx, positions[1])
				else gesture.touchOrigin
			shared.disarm()
			if position then
				begin(key, position)
			end
		end)
		local rowOrigin: Vector2? = nil
		local rowDragged = false
		local function continueRowDrag(position: Vector2)
			if
				rowOrigin
				and not moving:peek()
				and (position - rowOrigin).Magnitude >= 6
				and (
					grid
					or math.abs(axis(position) - axis(rowOrigin))
						>= math.abs(crossAxis(position) - crossAxis(rowOrigin))
				)
			then
				rowDragged = true
				if gesture.pendingInput == nil or gesture.pendingInput.UserInputType ~= E.UserInputType.Touch then
					begin(key, position)
				end
			end
			if moving:peek() then
				movePointer(position)
			end
		end
		local detector = Host.UIDragDetector({
			Name = "FacetCollectionDrag",
			DragStyle = E.UIDragDetectorDragStyle.TranslatePlane,
			ResponseStyle = E.UIDragDetectorResponseStyle.CustomOffset,
			Enabled = function(use: ComposeTypes.Use)
				return reorderable
					and movable(use(current))
					and read(sort, use) == nil
					and (
						preferred == nil
						or (use(preferred) ~= E.PreferredInput.Touch and use(preferred) ~= E.PreferredInput.Gamepad)
					)
			end,
			DragStart = function(position)
				position = pointerOf(ctx, position)
				rowOrigin, rowDragged = position, false
				gesture.pickupPosition = position
			end,
			DragContinue = function(position)
				continueRowDrag(pointerOf(ctx, position))
			end,
			DragEnd = function(position: Vector2?)
				if position and rowOrigin and not rowDragged then
					continueRowDrag(pointerOf(ctx, position))
				end
				local tapped = rowOrigin ~= nil
					and not rowDragged
					and not moving:peek()
					and gesture.pendingInput ~= nil
					and gesture.pendingInput.UserInputState ~= E.UserInputState.Cancel
				local tapPosition = rowOrigin
				rowOrigin = nil
				if not tapped then
					gesture.lastTap = nil
				end
				if gesture.captured == nil and moving:peek() then
					commit()
				elseif tapped and row:IsA("GuiButton") and not activation.consumed(gesture.pendingInput) then
					if activation.trigger(row, gesture.pendingInput, 0) then
						activation.consume(gesture.pendingInput)
					end
				elseif tapped and not activation.consumed(gesture.pendingInput) then
					local host = frame.Parent
					local hit = if host then host:FindFirstChild("RowHit") else nil
					if hit then
						local frames = ctx.runtime.host.frames
						local now = if frames then frames.now() else os.clock()
						local previous = gesture.lastTap
						local position = tapPosition :: Vector2
						local double = previous ~= nil
							and previous.key == key
							and now - previous.at <= 0.5
							and (position - previous.position).Magnitude <= 6
						gesture.lastTap = if double then nil else { key = key, position = position, at = now }
						local target = hit
						local layer = frame:FindFirstAncestorWhichIsA("BasePlayerGui")
						if layer and not double then
							for _, candidate in (layer :: PlayerGui):GetGuiObjectsAtPosition(position.X, position.Y) do
								if candidate.Name == "EditLabel" and candidate:IsDescendantOf(frame) then
									target = candidate
									break
								end
							end
						end
						activation.trigger(target, gesture.pendingInput, if double then 2 else 1)
						activation.consume(gesture.pendingInput)
					end
				end
			end,
		})
		detector.Parent = row
		Compose.cleanup(activation.provideDrag(frame, function(phase, position)
			if phase == "start" then
				rowOrigin = position
				gesture.pickupPosition = position
			elseif phase == "move" and position then
				if
					rowOrigin
					and not moving:peek()
					and (position - rowOrigin).Magnitude >= 6
					and gesture.pendingInput
					and gesture.pendingInput.UserInputType == E.UserInputType.MouseButton1
					and (
						grid
						or math.abs(axis(position) - axis(rowOrigin))
							>= math.abs(crossAxis(position) - crossAxis(rowOrigin))
					)
				then
					begin(key, position)
				end
				if moving:peek() then
					movePointer(position)
					return true
				end
			elseif phase == "end" then
				rowOrigin = nil
				if moving:peek() then
					commit()
					return true
				end
			end
			return false
		end))
		Compose.cleanup(function()
			if rowNodes[key] == frame then
				rowNodes[key] = nil
				local move = moving:peek()
				if move and move.key == key then
					gesture.recycled = true
				end
			end
		end)
		ctx.runtime.connect(row, "InputBegan", function(value: InputObject)
			pointer.press(key, value)
		end)
		if row:IsA("GuiButton") then
			if shared.pluginGui then
				ctx.runtime.connect(row, "MouseButton1Down", function(x: number, y: number)
					pointer.mouseDown(V2.new(x, y))
				end)
				ctx.runtime.connect(row, "InputEnded", function(value: InputObject)
					pointer.finish(value)
				end)
			end
		end
		rowKeys[frame] = key
		return frame
	end
	return wrap
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="25">
            <Properties>
              <string name="Name">collection_reorder_state</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local policy = require("./collection_policy")
local activation = require("./activation")
local scrollLock = require("./scroll_lock")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local CollectionTypes = require("./collection_types")
local gestureOf = require("./gesture_service")
local arbitration = require("./gesture_arbitration")
local sessionOf = require("./drag_session")
local DragTypes = require("./drag_types")
local Env = require("./environment_types")
local reducedMotion = require("./motion").reduced
export type Move<V, K> = {
	key: K,
	keys: { K },
	included: { [K]: boolean },
	remaining: { K },
	slot: number,
	rows: { V },
	pointer: Vector2?,
	keyboard: boolean,
	tap: boolean,
	navigationCross: number?,
}
export type Gesture<V, K> = {
	captured: InputObject?,
	recycled: boolean,
	selectedPickup: boolean,
	lastTap: { key: K, position: Vector2, at: number }?,
	pendingInput: InputObject?,
	pickupPosition: Vector2?,
	origin: Vector2?,
	travel: number,
	keyboardTarget: TextButton?,
	touchKey: K?,
	touchOrigin: Vector2?,
	touchTransfer: { key: K, pointer: InputObject, options: DragTypes.SourceSpec, keys: { K }, items: { V } }?,
	releaseScrollers: (() -> ())?,
	gestureOwner: GuiObject?,
}
export type Reorder<V, K> = {
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	spec: CollectionTypes.ReorderShape<V, K>,
	source: Types.Value<{ V }>,
	keyOf: (V, number) -> K,
	controls: ComposeTypes.OrderedCollectionControls<K>,
	bodyOf: () -> ScrollingFrame,
	selection: ComposeTypes.Cell<CollectionTypes.Selection<K>>,
	sort: ComposeTypes.Cell<CollectionTypes.Sort?>,
	editing: Types.ValueBoolean?,
	grid: boolean?,
	location: (({ K }, number) -> (boolean, number, K?))?,
	instantLayout: boolean?,
	reservedSlots: Types.Value<{ K }>?,
	gesture: Gesture<V, K>,
	moving: ComposeTypes.Cell<Move<V, K>?>,
	choosingDestination: ComposeTypes.Cell<boolean>,
	incoming: ComposeTypes.Cell<Env.DropInsertion?>,
	reorderable: boolean,
	drag: DragTypes.Service,
	arbiter: arbitration.Arbiter,
	collectionId: unknown,
	rowNodes: { [K]: Frame },
	deletable: boolean,
	preferred: ComposeTypes.Readable<Enum.PreferredInput>?,
	controlsShown: ComposeTypes.Formula<boolean>,
	mode: string,
	marked: boolean,
	minusShown: boolean,
	markShown: ComposeTypes.Formula<boolean>,
	leading: ComposeTypes.Formula<number>,
	trailing: ComposeTypes.Formula<number>,
	header: ComposeTypes.Formula<number>,
	motionReduced: (ComposeTypes.Use?) -> boolean,
	horizontal: boolean,
	axis: (Vector2) -> number,
	crossAxis: (Vector2) -> number,
	scaleOf: (ScrollingFrame) -> number,
	alongBody: (ScrollingFrame, Vector2) -> number,
	canvasOffset: (ScrollingFrame, number) -> (),
	input: UserInputService?,
	rowKeys: { [Instance]: K },
	gui: GuiService?,
	focus: ComposeTypes.Readable<GuiObject?>,
	pluginGui: Instance?,
	disarm: () -> (),
	cancel: () -> (),
	movable: (V) -> boolean,
	sourceIndex: ComposeTypes.Formula<{ [K]: V }>,
	begin: (K, Vector2?, boolean?, boolean?) -> (),
	commitLocal: ({ K }, number) -> (),
	commit: (...unknown) -> (),
	movePointer: (Vector2) -> (),
	step: (number, boolean?) -> (),
	chosen: (ComposeTypes.Use?, boolean?, boolean?) -> { K },
	canDelete: (ComposeTypes.Use?) -> boolean,
	canDeleteSelected: (ComposeTypes.Use?) -> boolean,
	remove: (boolean?) -> (),
}
return function<V, K>(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	spec: CollectionTypes.ReorderShape<V, K>,
	source: Types.Value<{ V }>,
	keyOf: (V, number) -> K,
	controls: ComposeTypes.OrderedCollectionControls<K>,
	bodyOf: () -> ScrollingFrame,
	selection: ComposeTypes.Cell<CollectionTypes.Selection<K>>,
	sort: ComposeTypes.Cell<CollectionTypes.Sort?>,
	editing: Types.ValueBoolean?,
	grid: boolean?,
	location: (({ K }, number) -> (boolean, number, K?))?,
	instantLayout: boolean?,
	reservedSlots: Types.Value<{ K }>?
): Reorder<V, K>
	local Compose = ctx.Compose
	local read = ctx.read
	local V2, E = ctx.types.Vector2, ctx.types.Enum
	local moving: ComposeTypes.Cell<Move<V, K>?> = Compose.cell(nil :: Move<V, K>?)
	local choosingDestination = Compose.cell(false)
	local incoming: ComposeTypes.Cell<Env.DropInsertion?> = Compose.cell(nil :: Env.DropInsertion?)
	local reorderable = spec.reorderable == true or spec.drag ~= nil
	local drag = sessionOf(ctx)
	local arbiter = gestureOf(ctx)
	local collectionId = spec.collectionId or source
	local rowNodes: { [K]: Frame } = {}
	local stopLocal: () -> () = function() end
	local deletable = spec.deletable == true
	local preferred: ComposeTypes.Readable<Enum.PreferredInput>? = if ctx.config.userInputService
		then ctx.observe.PreferredInput(ctx.config.userInputService)
		else nil
	local controlsShown = Compose.formula(function(use: ComposeTypes.Use): boolean
		local kind = if preferred then use(preferred) else nil
		return kind == nil or read(editing, use) == true
	end)

	local mode = spec.selectionMode or (if spec.selection or spec.onSelectionChange then "single" else "none")
	local marked = spec.selectionIndicator ~= false and (mode == "multiple" or (mode ~= "none" and not deletable))
	local minusShown = deletable and not marked
	local markShown = Compose.formula(function(use: ComposeTypes.Use): boolean
		return marked
			and read(editing, use) == true
			and (preferred == nil or use(preferred) ~= E.PreferredInput.KeyboardAndMouse)
	end)
	local leading = Compose.formula(function(use: ComposeTypes.Use): number
		return if (minusShown and use(controlsShown)) or use(markShown) then 44 else 0
	end)
	local trailing = Compose.formula(function(use: ComposeTypes.Use): number
		return if reorderable and use(controlsShown) then 44 else 0
	end)
	local header = Compose.formula(function(use: ComposeTypes.Use): number
		local kind = if preferred then use(preferred) else nil
		local reserved = editing ~= nil
			and (marked or reorderable or deletable)
			and (kind == E.PreferredInput.Touch or kind == E.PreferredInput.Gamepad)
		return if grid then math.max(use(leading), use(trailing), if reserved then 44 else 0) else 0
	end)
	local motionReduced = reducedMotion(ctx)
	local horizontal = spec.direction == "horizontal"
	local function axis(position: Vector2): number
		return if horizontal then position.X else position.Y
	end

	local function crossAxis(position: Vector2): number
		return if horizontal then position.Y else position.X
	end

	local function scaleOf(body: ScrollingFrame): number
		local unit = body:FindFirstChild("LayoutUnit") :: GuiObject?
		local scale = if unit then unit.AbsoluteSize.X else 0
		return if scale > 0 then scale else 1
	end
	local function alongBody(body: ScrollingFrame, position: Vector2): number
		return (axis(position) - axis(body.AbsolutePosition)) / scaleOf(body)
	end
	local function canvasOffset(body: ScrollingFrame, value: number): ()
		body.CanvasPosition = if horizontal
			then V2.new(value, body.CanvasPosition.Y)
			else V2.new(body.CanvasPosition.X, value)
	end
	local input = ctx.config.userInputService
	local gesture: Gesture<V, K> = {
		captured = nil,
		recycled = false,
		selectedPickup = false,
		lastTap = nil,
		pendingInput = nil,
		pickupPosition = nil,
		origin = nil,
		travel = 0,
		keyboardTarget = nil,
		touchKey = nil,
		touchOrigin = nil,
		touchTransfer = nil,
		releaseScrollers = nil,
		gestureOwner = nil,
	}
	local rowKeys = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [Instance]: K }
	local gui = ctx.config.guiService
	local focus: ComposeTypes.Readable<GuiObject?> = if gui and gui.GetPropertyChangedSignal
		then ctx.observe.SelectedObject(gui)
		else Compose.cell(nil :: GuiObject?)
	local function disarm()
		gesture.touchKey, gesture.touchOrigin = nil, nil
	end
	local function clearMove()
		if gesture.gestureOwner then
			arbiter.cancelOwner(gesture.gestureOwner)
			gesture.gestureOwner = nil
		end
		local move, selected = moving:peek(), gui and gui.SelectedObject
		local restore = move ~= nil and move.keyboard and selected == gesture.keyboardTarget
		gesture.captured = nil
		gesture.touchTransfer = nil
		gesture.selectedPickup = false
		disarm()
		if gesture.releaseScrollers then
			gesture.releaseScrollers()
			gesture.releaseScrollers = nil
		end
		if restore and move and gui then
			gui.SelectedObject = nil
			local index = assert(controls.indexOfKey)(move.key)
			if index then
				local body = bodyOf()
				canvasOffset(
					body,
					assert(controls.offsetOf)(index, "center", axis(body.AbsoluteWindowSize) / scaleOf(body))
				)
			end
		end
		moving:set(nil)
		if restore and move and gui then
			local row = rowNodes[move.key]
			local handle = row and row:FindFirstChild("Move")
			if handle and handle:IsA("GuiObject") and handle.Visible then
				gui.SelectedObject = handle
			end
		end
	end
	stopLocal = clearMove
	local function cancel()
		local session = drag.state:peek()
		if session and session.executing then
			return
		end
		if session and session.source == bodyOf() then
			drag.finish(false, "Cancelled")
		end
		clearMove()
	end
	Compose.cleanup(cancel)
	local function movable(item: V): boolean
		return policy.allows(spec.movable, item) and not policy.disabled(spec.disabled, item)
	end
	local sourceIndex = Compose.formula(function(use: ComposeTypes.Use): { [K]: V }
		local result: { [K]: V } = {}
		for index, item in read(spec.selectionFrom or source, use) do
			result[keyOf(item, index)] = item
		end
		return result
	end)
	local function begin(key: K, position: Vector2?, quiet: boolean?, tap: boolean?): ()
		gesture.lastTap = nil
		local session = drag.state:peek()
		if session and session.source ~= bodyOf() then
			return
		end
		if
			not reorderable
			or read(sort) ~= nil
			or (not spec.onReorder and not spec.drag)
			or (position ~= nil and gesture.captured ~= nil and moving:peek() ~= nil)
		then
			return
		end
		if position and gesture.pendingInput then
			local node = rowNodes[key]
			local decision = arbiter.get(gesture.pendingInput)
			if decision and (decision.owner ~= node or (decision.kind ~= "pending" and decision.kind ~= "drag")) then
				return
			end
			if node then
				if not decision then
					arbiter.begin(
						gesture.pendingInput,
						node,
						gesture.pickupPosition or position,
						{ pickup = "immediate" }
					)
				end
				if not arbiter.claim(gesture.pendingInput, node, "drag") then
					return
				end
				gesture.gestureOwner = node
			end
		end
		local rows, selected = read(source), read(selection)
		for index, item in rows do
			if keyOf(item, index) == key and not movable(item) then
				return
			end
		end
		local keys: { K } = {}
		local indices: { [K]: boolean } = {}
		local items: { V } = {}
		for index, item in read(spec.selectionFrom or source) do
			local candidate = keyOf(item, index)
			if movable(item) and (candidate == key or (selected[key] and selected[candidate])) then
				table.insert(keys, candidate)
				table.insert(items, item)
				indices[candidate] = true
			end
		end
		local prepared = if position ~= nil or tap then gesture.touchTransfer else nil
		if prepared and prepared.key == key and prepared.pointer == gesture.pendingInput then
			keys, items = table.clone(prepared.keys), table.clone(prepared.items)
			table.clear(indices)
			for _, capturedKey in keys do
				indices[capturedKey] = true
			end
		end
		local remaining: { K } = {}
		local before, started = 0, false
		for index, item in rows do
			local candidate = keyOf(item, index)
			if indices[candidate] then
				started = true
			else
				table.insert(remaining, candidate)
				if not started then
					before += 1
				end
			end
		end
		if #keys > 0 then
			local options = (
				if prepared
						and prepared.key == key
						and prepared.pointer == gesture.pendingInput
					then prepared.options
					elseif spec.drag then spec.drag(items, keys)
					else {
						payload = { collection = collectionId, keys = keys, items = items },
						operations = { "move" :: "move" },
					}
			) :: DragTypes.SourceSpec
			if tap and not options.armOnTap then
				return
			end
			local live = gesture.pendingInput ~= nil
				and gesture.pendingInput.UserInputState ~= E.UserInputState.End
				and gesture.pendingInput.UserInputState ~= E.UserInputState.Cancel
			gesture.captured = if position and live then gesture.pendingInput else nil
			local row = rowNodes[key]
			if
				gesture.captured
				and gesture.captured.UserInputType == E.UserInputType.Touch
				and row
				and not gesture.releaseScrollers
			then
				gesture.releaseScrollers = scrollLock.holdAncestors(row)
			end
			gesture.recycled = false
			activation.consume(gesture.captured)
			local nextMove: Move<V, K> = {
				key = key,
				keys = keys,
				included = indices,
				remaining = remaining,
				slot = before,
				rows = rows,
				pointer = position,
				keyboard = position == nil,
				tap = tap == true,
			}
			local valid, ended = options.valid, options.onEnd
			options = table.clone(options)
			options.mark = false
			choosingDestination:set(false)
			if spec.drag and (spec.onReorder or spec.drop) then
				options.navigationHint = "Y: choose destination"
			end
			local original = rowNodes[key]
			local origin = if original then original.AbsolutePosition + original.AbsoluteSize / 2 else position
			options.returnPosition = function()
				local row = rowNodes[key]
				return if row and row.Parent then row.AbsolutePosition + row.AbsoluteSize / 2 else origin :: Vector2
			end
			options.valid = function()
				if valid and not valid() then
					return false
				end
				local live = sourceIndex:peek()
				for _, key in keys do
					local item = live[key]
					if item == nil or not movable(item) then
						return false
					end
				end
				return true
			end
			options.onEnd = function(accepted, reason)
				stopLocal()
				if ended then
					ended(accepted, reason)
				end
			end
			drag.begin(
				bodyOf(),
				options,
				if position then "pointer" else "armed",
				gesture.captured,
				false,
				if original
					then {
						position = if position
							then gesture.pickupPosition or position
							else original.AbsolutePosition + original.AbsoluteSize / 2,
						source = original :: GuiObject,
					}
					else nil
			)
			moving:set(nextMove)
			if position then
				drag.update(position)
			end
			if
				position == nil
				and not quiet
				and gesture.keyboardTarget
				and gesture.keyboardTarget.Visible
				and ctx.config.guiService
			then
				ctx.config.guiService.SelectedObject = gesture.keyboardTarget
			end
		end
	end
	local function commitLocal(keys: { K }, slot: number)
		if location then
			local accepted, siblingSlot, parentKey = location(keys, slot)
			if accepted then
				assert(spec.onReorder)(keys, siblingSlot, parentKey)
			end
			return
		end
		local rows = read(source)
		local included, remaining = {}, {}
		for _, key in keys do
			included[key] = true
		end
		for index, item in rows do
			local key = keyOf(item, index)
			if not included[key] then
				table.insert(remaining, key)
			end
		end
		local move = { rows = rows, remaining = remaining, keys = keys, slot = slot }
		local reordered = table.clone(move.remaining)
		local visible = {}
		for index, item in rows do
			local key = keyOf(item, index)
			if included[key] then
				table.insert(visible, key)
			end
		end
		for index, key in visible do
			table.insert(reordered, move.slot + index, key)
		end
		for index, item in move.rows do
			if not movable(item) and keyOf(item, index) ~= reordered[index] then
				return
			end
		end
		for index, item in move.rows do
			if keyOf(item, index) ~= reordered[index] then
				assert(spec.onReorder)(move.keys, move.slot)
				return
			end
		end
	end
	local function commit()
		local move = moving:peek()
		if move == nil then
			return
		end
		local session = drag.state:peek()
		if move.keyboard and (session == nil or session.target == nil) then
			drag.commit(bodyOf())
		else
			drag.commit(nil)
		end
	end
	local function movePointer(position: Vector2): ()
		local move = moving:peek()
		if move == nil then
			return
		end
		local body = bodyOf()
		local offset = alongBody(body, position) + axis(body.CanvasPosition)
		local across = crossAxis(position - body.AbsolutePosition) / scaleOf(body) + crossAxis(body.CanvasPosition)
		local low, high = 1, #move.rows + 1
		while low < high do
			local middle = math.floor((low + high) / 2)
			local at = assert(controls.placementOf)(middle)
			local crossed = if grid
				then offset >= at.offset + at.size
					or (
						offset >= at.offset
						and offset < at.offset + at.size
						and across >= at.crossOffset + at.crossSize / 2
					)
				else offset >= at.offset + at.size / 2
			if crossed then
				low = middle + 1
			else
				high = middle
			end
		end
		local nextMove, slot = table.clone(move), 0
		for index = 1, low - 1 do
			if not move.included[keyOf(move.rows[index], index)] then
				slot += 1
			end
		end
		nextMove.slot = slot
		nextMove.pointer = position
		moving:set(nextMove)
		drag.update(position)
	end
	local function step(delta: number, along: boolean?): ()
		local current = moving:peek()
		local session = drag.state:peek()
		if current and not (session and session.pending) then
			local nextMove = table.clone(current)
			nextMove.slot = math.clamp(current.slot + delta, 0, #current.remaining)
			if grid and along then
				local function point(slot: number): (number, number)
					local candidate = current.remaining[slot + 1]
					local index = if candidate then assert(controls.indexOfKey)(candidate) else #current.rows
					local at = assert(controls.placementOf)(index or 1)
					return at.offset, at.crossOffset + (if candidate then 0 else at.crossSize)
				end
				local origin, across = point(current.slot)
				across = current.navigationCross or across
				local nearest, distance = math.huge, math.huge
				nextMove.slot, nextMove.navigationCross = current.slot, across
				for slot = 0, #current.remaining do
					local offset, cross = point(slot)
					local forward, side = (offset - origin) * delta, math.abs(cross - across)
					if forward > 0 and (forward < nearest or (forward == nearest and side < distance)) then
						nearest, distance, nextMove.slot = forward, side, slot
					end
				end
			else
				nextMove.navigationCross = nil
			end
			moving:set(nextMove)
			local body = bodyOf()
			local at = current.remaining[nextMove.slot + 1] or current.remaining[nextMove.slot]
			local index = if at then assert(controls.indexOfKey)(at) else nil
			if index then
				canvasOffset(
					body,
					assert(controls.offsetOf)(index, "center", axis(body.AbsoluteWindowSize) / scaleOf(body))
				)
			end
			if current.keyboard then
				drag.hover(body, nil)
			end
		end
	end
	Compose.watch(function(use: ComposeTypes.Use)
		local rows, order = read(source, use), read(sort, use)
		local move = moving:peek()
		if move then
			local found = 0
			for index, item in read(spec.selectionFrom or source, use) do
				if move.included[keyOf(item, index)] and movable(item) then
					found += 1
				end
			end
			if order ~= nil or found ~= #move.keys then
				cancel()
			elseif rows ~= move.rows then
				local next = table.clone(move)
				next.rows, next.remaining = rows, {}
				for index, item in rows do
					local key = keyOf(item, index)
					if not move.included[key] then
						table.insert(next.remaining, key)
					end
				end
				next.slot = math.min(next.slot, #next.remaining)
				moving:set(next)
			end
		end
	end)
	local pluginGui = ctx.config.inputParent
	if pluginGui and not pluginGui:IsA("PluginGui") then
		pluginGui = nil
	end
	local function chosen(use: ComposeTypes.Use?, selectedOnly: boolean?, allSelected: boolean?): { K }
		local keys, selected = {}, read(selection, use)
		for index, item in read(if allSelected then spec.selectionFrom or source else source, use) do
			local key = keyOf(item, index)
			if selected[key] then
				table.insert(keys, key)
			end
		end
		if #keys == 0 and not selectedOnly and read(editing, use) == true then
			local body = bodyOf()
			local at: Instance? = if use then use(focus) else focus:peek()
			if at and not at:IsDescendantOf(body) then
				at = nil
			end
			while at and at ~= body and #keys == 0 do
				local key = rowKeys[at]
				if key == nil then
					for _, node in at:GetChildren() do
						key = rowKeys[node]
						if key ~= nil then
							break
						end
					end
				end
				if key ~= nil then
					table.insert(keys, key)
				end
				at = at.Parent
			end
		end
		return keys
	end
	local function deletes(selectedOnly: boolean?): (ComposeTypes.Use?) -> boolean
		return function(use: ComposeTypes.Use?): boolean
			if not selectedOnly then
				local at: Instance? = read(focus, use)
				while at do
					if at:GetAttribute("FacetSelectionOwner") == true then
						if at ~= bodyOf() then
							return false
						end
						break
					end
					at = at.Parent
				end
			end
			return deletable
				and (if use then use(moving) else moving:peek()) == nil
				and #chosen(use, selectedOnly, true) > 0
		end
	end
	local canDelete, canDeleteSelected = deletes(false), deletes(true)
	local function remove(selectedOnly: boolean?): ()
		local keys = {}
		for _, key in chosen(nil, selectedOnly, true) do
			for index, item in read(spec.selectionFrom or source) do
				if
					keyOf(item, index) == key
					and policy.allows(spec.rowDeletable, item)
					and not policy.disabled(spec.disabled, item)
				then
					table.insert(keys, key)
				end
			end
		end
		if #keys > 0 and spec.onDelete then
			spec.onDelete(keys)
		end
	end
	return {
		ctx = ctx,
		UI = UI,
		spec = spec,
		source = source,
		keyOf = keyOf,
		controls = controls,
		bodyOf = bodyOf,
		selection = selection,
		sort = sort,
		editing = editing,
		grid = grid,
		location = location,
		instantLayout = instantLayout,
		reservedSlots = reservedSlots,
		gesture = gesture,
		moving = moving,
		choosingDestination = choosingDestination,
		incoming = incoming,
		reorderable = reorderable,
		drag = drag,
		arbiter = arbiter,
		collectionId = collectionId,
		rowNodes = rowNodes,
		deletable = deletable,
		preferred = preferred,
		controlsShown = controlsShown,
		mode = mode,
		marked = marked,
		minusShown = minusShown,
		markShown = markShown,
		leading = leading,
		trailing = trailing,
		header = header,
		motionReduced = motionReduced,
		horizontal = horizontal,
		axis = axis,
		crossAxis = crossAxis,
		scaleOf = scaleOf,
		alongBody = alongBody,
		canvasOffset = canvasOffset,
		input = input,
		rowKeys = rowKeys,
		gui = gui,
		focus = focus,
		pluginGui = pluginGui,
		disarm = disarm,
		cancel = cancel,
		movable = movable,
		sourceIndex = sourceIndex,
		begin = begin,
		commitLocal = commitLocal,
		commit = commit,
		movePointer = movePointer,
		step = step,
		chosen = chosen,
		canDelete = canDelete,
		canDeleteSelected = canDeleteSelected,
		remove = remove,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">collection_row_actions</string>
              <string name="Source"><![CDATA[--!strict
local activation = require("./activation")
local scrollLock = require("./scroll_lock")
local reducedMotion = require("./motion").reduced
local settling = require("./settle")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local CollectionTypes = require("./collection_types")
local InputTypes = require("./input_types")
local NavigationTypes = require("./navigation_types")
local CollectionProps = require("./collection_props")
local ControlTypes = require("./control_types")
local InputProps = require("./input_props")
local NavigationProps = require("./navigation_props")
type RowEdge = CollectionTypes.RowEdge
type RowAction = CollectionTypes.RowAction
return function(ctx: Types.Context, UI: ControlTypes.BuilderControls): ()
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local read = ctx.read
	local readSource = ctx.readSource
	local D2, V2, E = ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local behavior = {
		"content",
		"leading",
		"trailing",
		"actionWidth",
		"actionPlacement",
		"fullSwipe",
		"open",
		"onOpenChange",
		"coordinator",
		"enabled",
		"reducedMotion",
		"onActivate",
		"editing",
		"swipeEnabled",
	}
	local FULL_SWIPE = 0.6
	local RESISTANCE = 0.55
	UI.RowActions = ctx.construct("RowActions", function(spec: CollectionProps.RowActionsSpec): Frame
		assert(
			spec.actionPlacement == nil or spec.actionPlacement == "trailing" or spec.actionPlacement == "bottom",
			"RowActions.actionPlacement must be trailing or bottom"
		)
		local bottom = spec.actionPlacement == "bottom"
		local leading: Types.Value<{ RowAction }> = spec.leading or {}
		local trailing: Types.Value<{ RowAction }> = spec.trailing or {}
		local content = if type(spec.content) == "function" then spec.content() else spec.content
		assert(typeof(content) == "Instance" or type(content) == "table", "Facet.RowActions requires content")
		local cellEdits = activation.edits(content)
		local open: ComposeTypes.Cell<RowEdge?> = spec.open or Compose.cell(nil :: RowEdge?)
		local menuOpen = Compose.cell(false)
		local drag: ComposeTypes.Cell<number?> = Compose.cell(nil :: number?)
		local dimensions = Compose.cell(V2.zero)
		local editWidth = Compose.cell(72)
		local measuredActionSize = Compose.cell(V2.zero)
		local actionWidths: ComposeTypes.Cell<{ [string]: number }> = Compose.cell({})
		local rowToken = {}
		local departure = runtime.timeline({ duration = ctx.metric("motion.durations.rowDeparture"), autoplay = false })
		local committing: ComposeTypes.Cell<{ action: RowAction, edge: RowEdge, from: number }?> =
			Compose.cell(nil :: { action: RowAction, edge: RowEdge, from: number }?)
		local fired = false
		local motionReduced = reducedMotion(ctx)
		local function reduced(use: ComposeTypes.Use?): boolean
			return if spec.reducedMotion == nil then motionReduced(use) else read(spec.reducedMotion, use) == true
		end
		local function actions(edge: string, use: ComposeTypes.Use?): { RowAction }
			return read(if edge == "leading" then leading else trailing, use)
		end
		local function bandWidth(edge: string, use: ComposeTypes.Use?): number
			local list = actions(edge, use)
			local iconic = #list > 0
			for _, action in list do
				iconic = iconic and action.icon ~= nil
			end
			local width = read(spec.actionWidth or (if iconic then 64 else 88), use)
			local measuredWidths = readSource(actionWidths, use)
			for _, action in list do
				width = math.max(width, measuredWidths[edge .. ":" .. action.id] or 0)
			end
			return math.min(width * #list, readSource(dimensions, use).X)
		end
		local function fullSwipe(edge: RowEdge): boolean
			local choice = spec.fullSwipe
			return if type(choice) == "table"
				then (if edge == "leading" then choice.leading else choice.trailing) ~= false
				else choice ~= false
		end
		local function setOpen(edge: RowEdge?): ()
			if spec.coordinator and edge then
				spec.coordinator:set(rowToken)
			end
			if spec.onOpenChange then
				spec.onOpenChange(edge)
			elseif type(open.set) == "function" then
				open:set(edge)
			end
		end
		Compose.watch(function(use: ComposeTypes.Use)
			local edge = readSource(open, use) :: RowEdge?
			if edge ~= nil and #actions(edge, use) == 0 then
				setOpen(nil)
			end
		end)
		if spec.coordinator then
			Compose.watch(function(use: ComposeTypes.Use)
				if readSource(open, use) ~= nil and spec.coordinator:peek() ~= rowToken then
					spec.coordinator:set(rowToken)
				end
			end)
			Compose.watch(function(use: ComposeTypes.Use)
				local active = use(spec.coordinator)
				if active ~= rowToken then
					menuOpen:set(false)
					if readSource(open) ~= nil then
						setOpen(nil)
					end
				end
			end)
			Compose.cleanup(function()
				if spec.coordinator:peek() == rowToken then
					spec.coordinator:set(nil)
				end
			end)
		end
		local offset = Compose.formula(function(use: ComposeTypes.Use)
			local commit = use(committing)
			if commit then
				local fraction = if reduced(use) then 1 else math.min(1, use(departure.progress) / 0.7)
				local target = (if commit.edge == "leading" then 1 else -1) * use(dimensions).X
				return commit.from + (target - commit.from) * fraction
			end
			local live = use(drag)
			if live ~= nil then
				return live
			end
			local edge = use(open) :: RowEdge?
			return if edge == nil then 0 else bandWidth(edge, use) * (if edge == "leading" then 1 else -1)
		end)
		local shownOffset = offset:peek()
		local rowSettle = settling(
			ctx,
			function(): number
				return shownOffset
			end,
			ctx.motionSpring("snappy"),
			function(): boolean
				return reduced()
			end
		)
		Compose.watch(function(use: ComposeTypes.Use)
			local live = use(offset)
			if use(drag) ~= nil or use(committing) ~= nil then
				shownOffset = live
				return
			end
			if rowSettle.value:peek() == nil and math.abs(live - shownOffset) > 0.5 then
				rowSettle.launch(shownOffset, 0)
			end
			shownOffset = live
		end)
		local function current(): number
			return if drag:peek() ~= nil or reduced() then offset:peek() else (rowSettle.value:peek() or offset:peek())
		end
		local function invoke(action: RowAction): ()
			if action.onActivate then
				action.onActivate()
			end
		end
		local frames = assert(runtime.host.frames)
		local stopSettle: (() -> ())?
		local function settle(): ()
			if stopSettle then
				return
			end
			stopSettle = frames.onFrame(function()
				if stopSettle then
					stopSettle()
					stopSettle = nil
				end
				committing:set(nil)
				fired = false
			end)
		end
		Compose.cleanup(function()
			if stopSettle then
				stopSettle()
				stopSettle = nil
			end
		end)
		local function execute(action: RowAction, edge: string?): ()
			if committing:peek() or read(spec.enabled) == false or read(action.enabled) == false then
				return
			end
			local from = current()
			drag:set(nil)
			menuOpen:set(false)
			setOpen(nil)
			if action.role == "destructive" then
				committing:set({
					action = action,
					edge = (if edge == "leading" then "leading" else "trailing") :: RowEdge,
					from = from,
				})
				if reduced() then
					fired = true
					settle()
					invoke(action)
				else
					departure:restart()
				end
			else
				invoke(action)
			end
		end
		Compose.watch(function(use: ComposeTypes.Use)
			if readSource(open, use) ~= nil and fired then
				fired = false
				committing:set(nil)
			end
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			if use(departure.completed) and not fired then
				local commit = committing:peek()
				if commit then
					fired = true
					settle()
					invoke(commit.action)
				end
			end
		end)

		local function paintedOffset(use: ComposeTypes.Use): number
			return if use(drag) ~= nil
					or use(committing) ~= nil
					or reduced(use)
				then use(offset)
				else (use(rowSettle.value) or use(offset))
		end
		local function armed(edge: RowEdge, use: ComposeTypes.Use): boolean
			local commit = use(committing)
			if commit then
				return commit.edge == edge
			end
			local live = use(drag)
			return live ~= nil
				and fullSwipe(edge)
				and #actions(edge, use) > 0
				and (if edge == "leading" then live > 0 else live < 0)
				and math.abs(live) >= use(dimensions).X * FULL_SWIPE
		end
		local function tray(edge: RowEdge): Frame
			local nativeProps: Types.FrameProps = {
				Name = edge,
				AnchorPoint = V2.new(if edge == "leading" then 0 else 1, 0),
				Position = D2.fromScale(if edge == "leading" then 0 else 1, 0),
				Size = function(use: ComposeTypes.Use)
					local reveal = math.abs(paintedOffset(use))
					return D2.new(0, reveal, 1, 0)
				end,
				Visible = function(use: ComposeTypes.Use)
					local x = paintedOffset(use)
					return if edge == "leading" then x > 0 else x < 0
				end,
				BackgroundTransparency = 1,
				ClipsDescendants = true,
				Attributes = { FacetDragExclude = true } :: Types.Attributes,
				Host.UIListLayout({
					FillDirection = E.FillDirection.Horizontal,
					HorizontalAlignment = if edge == "leading"
						then E.HorizontalAlignment.Right
						else E.HorizontalAlignment.Left,
					SortOrder = E.SortOrder.LayoutOrder,
				}) :: ComposeTypes.Child,
				Compose.keyed({
					from = function(use: ComposeTypes.Use)
						return actions(edge, use)
					end,
					key = function(action: RowAction)
						return action.id
					end,
					render = function(current: ComposeTypes.Readable<RowAction>, index: ComposeTypes.Readable<number>)
						local iconic = current:peek().icon ~= nil
						local function words(use: ComposeTypes.Use): string
							return read(use(current).label, use)
						end
						local function first(use: ComposeTypes.Use): boolean
							return use(index) == 1
						end
						local buttonProps: InputProps.ButtonProps = {
							Name = current:peek().id,
							LayoutOrder = function(use: ComposeTypes.Use)
								return if edge == "leading" then -use(index) else use(index)
							end,
							Size = function(use: ComposeTypes.Use)
								if armed(edge, use) and first(use) then
									return D2.fromScale(1, 1)
								end
								local width = bandWidth(edge, use)
								local stretch = if first(use)
									then math.max(0, math.abs(paintedOffset(use)) - width)
									else 0
								return D2.new(0, width / math.max(1, #actions(edge, use)) + stretch, 1, 0)
							end,
							Visible = function(use: ComposeTypes.Use)
								return not armed(edge, use) or first(use)
							end,
							AutomaticSize = E.AutomaticSize.None,
							label = if iconic then "" else words,
							name = if iconic then words else nil,
							role = current:peek().role,
							icon = current:peek().icon,
							enabled = function(use: ComposeTypes.Use)
								return read(spec.enabled, use) ~= false and read(use(current).enabled, use) ~= false
							end,
							onActivate = function()
								execute(current:peek(), edge)
							end,
						}
						local button = UI.Button(buttonProps)
						button:AddTag("facet-row-action")
						local caption = button:FindFirstChild("Title", true)
						local bounds = if caption and caption:IsA("TextLabel")
							then ctx.observe.TextBounds(caption)
							else ctx.observe.TextBounds(button)
						Compose.watch(function(use: ComposeTypes.Use)
							local size, action = use(bounds), use(current)
							local width = (if size then size.X else 0)
								+ 32
								+ (if action.icon then ctx.controlSize(nil, "iconSize", use) + 8 else 0)
							local id = edge .. ":" .. action.id
							if actionWidths:peek()[id] ~= width then
								local widths = table.clone(actionWidths:peek())
								widths[id] = width
								actionWidths:set(widths)
							end
						end)
						return button
					end,
				}),
			}
			return Host.Frame(nativeProps)
		end
		local root: Frame
		local contentFrame: Frame
		local activeInput: InputObject?
		local reveal: () -> ()
		local function began(input: InputObject): ()
			if input.UserInputType == E.UserInputType.Touch or input.UserInputType == E.UserInputType.MouseButton1 then
				activeInput = input
			end
		end
		local start: Vector2? = nil
		local startOffset = 0
		local axis: ("horizontal" | "vertical")? = nil
		local function cancelDrag()
			start, axis, activeInput = nil, nil, nil
			drag:set(nil)
		end
		local previousX, previousTime, velocity = 0, 0, 0
		local now = assert(ctx.runtime.host.frames).now
		local function begin(position: Vector2): ()
			if committing:peek() or read(spec.enabled) == false or not ctx.available(root) then
				return
			end
			start, startOffset, axis = position, current(), nil
			rowSettle.halt()
			previousX, previousTime, velocity = position.X, now(), 0
		end
		local function move(position: Vector2): ()
			if start == nil or read(spec.enabled) == false then
				return
			end
			local currentTime = now()
			local elapsed = currentTime - previousTime
			if elapsed >= 0.005 then
				velocity = (position.X - previousX) / elapsed
				previousX, previousTime = position.X, currentTime
			end
			local delta = position - start
			if axis == nil and math.max(math.abs(delta.X), math.abs(delta.Y)) >= 8 then
				axis = if math.abs(delta.X) > math.abs(delta.Y) then "horizontal" else "vertical"
			end
			if axis == "horizontal" then
				local maxLeading = if #actions("leading") > 0 then dimensions:peek().X else 0
				local maxTrailing = if #actions("trailing") > 0 then dimensions:peek().X else 0
				local raw = startOffset + delta.X
				local edge: RowEdge = if raw > 0 then "leading" else "trailing"
				local band = bandWidth(edge)
				if not fullSwipe(edge) and math.abs(raw) > band then
					raw = math.sign(raw) * (band + (math.abs(raw) - band) * RESISTANCE)
				end
				drag:set(math.clamp(raw, -maxTrailing, maxLeading))
			end
		end
		local pressed: InputObject?
		local function collectionRow(): Instance?
			local host = root.Parent
			while host and host:GetAttribute("FacetCollectionRow") ~= true do
				host = host.Parent
			end
			return host
		end
		local function tap(input: InputObject?): ()
			if readSource(open) ~= nil then
				setOpen(nil)
				return
			end
			local host = collectionRow()
			local hit = if host then host:FindFirstChild("RowHit") else nil
			if hit and activation.trigger(hit, input or pressed) then
				return
			end
			for _, node in contentFrame:GetDescendants() do
				if activation.trigger(node) then
					return
				end
			end
		end
		local function finish()
			if read(spec.enabled) == false then
				start, axis = nil, nil
				drag:set(nil)
				return
			end
			local value = drag:peek()
			local fling = if now() - previousTime < 0.1 then velocity else 0
			if value ~= nil and value ~= 0 and axis == "horizontal" and dimensions:peek().X > 0 then
				local edge: RowEdge = if value > 0 then "leading" else "trailing"
				local available = actions(edge)
				local width = dimensions:peek().X
				local flung = if now() - previousTime < 0.1 then velocity * ctx.metric("motion.fling.projection") else 0
				local projected = if flung * value > 0 then value + flung else value
				if fullSwipe(edge) and #available > 0 and width > 0 and math.abs(projected) >= width * FULL_SWIPE then
					execute(available[1], edge)
				elseif
					#available > 0
					and value ~= 0
					and (
						math.abs(value) >= bandWidth(edge) * 0.5
						or (math.abs(velocity) > 600 and velocity * value > 0 and now() - previousTime < 0.1)
					)
				then
					setOpen(edge)
				else
					setOpen(nil)
				end
			end
			start, axis = nil, nil
			drag:set(nil)
			if value ~= nil and committing:peek() == nil then
				rowSettle.launch(value, fling)
			end
		end
		local function release(): ()
			local tapped = start ~= nil and axis == nil and committing:peek() == nil
			finish()
			if tapped and read(spec.enabled) ~= false then
				tap()
			end
		end
		local preferred = if ctx.config.userInputService
			then ctx.observe.PreferredInput(ctx.config.userInputService)
			else nil
		local function touchFirst(use: ComposeTypes.Use?): boolean
			return preferred ~= nil and readSource(preferred, use) == E.PreferredInput.Touch
		end
		local function actionSize(use: ComposeTypes.Use): number
			return if #cellEdits > 0
					and read(spec.enabled, use) ~= false
					and preferred
					and use(preferred) ~= E.PreferredInput.KeyboardAndMouse
				then math.max(44, ctx.controlSize(nil, "height", use))
				else 0
		end
		local function actionWidth(use: ComposeTypes.Use): number
			local size = actionSize(use)
			return if size > 0 then math.max(size, use(measuredActionSize).X) else 0
		end
		local function actionHeight(use: ComposeTypes.Use): number
			local size = actionSize(use)
			return if bottom and size > 0 then math.max(size, use(measuredActionSize).Y) else 0
		end
		local panned = false
		local stopPan: (() -> ())? = nil
		local function settlePan(): ()
			if stopPan then
				return
			end
			stopPan = frames.onFrame(function()
				if stopPan then
					stopPan()
					stopPan = nil
				end
				panned = false
			end)
		end
		Compose.cleanup(function()
			if stopPan then
				stopPan()
				stopPan = nil
			end
		end)
		local releaseScrollers: (() -> ())? = nil
		local function freeScrollers(): ()
			if releaseScrollers then
				releaseScrollers()
				releaseScrollers = nil
			end
		end
		local function holdScrollers(): ()
			if releaseScrollers == nil then
				releaseScrollers = scrollLock.holdOwnedAncestors(root)
			end
		end
		Compose.cleanup(freeScrollers)
		local function pan(
			positions: { Vector2 },
			translation: Vector2,
			panVelocity: Vector2,
			state: Enum.UserInputState
		): ()
			if state == E.UserInputState.Begin then
				local position: Vector2? = positions[1]
				if position == nil then
					return
				end
				panned = true
				begin(position - translation)
			end
			if state == E.UserInputState.Begin or state == E.UserInputState.Change or state == E.UserInputState.End then
				if start then
					move(start + translation)
					velocity, previousTime = panVelocity.X, now()
				end
				if state == E.UserInputState.End then
					freeScrollers()
					finish()
					settlePan()
				elseif axis == "horizontal" then
					holdScrollers()
				end
			else
				freeScrollers()
				cancelDrag()
				settlePan()
			end
		end
		local function swipeable(use: ComposeTypes.Use): boolean
			return #cellEdits == 0
				and use(committing) == nil
				and read(spec.editing, use) ~= true
				and read(spec.swipeEnabled, use) ~= false
				and read(spec.enabled, use) ~= false
				and (#actions("leading", use) + #actions("trailing", use)) > 0
		end
		local function swipeDetector(use: ComposeTypes.Use): boolean
			return swipeable(use)
				and not touchFirst(use)
				and not (preferred ~= nil and readSource(preferred, use) == E.PreferredInput.Gamepad)
		end
		local detectorDrag = false
		Compose.watch(function(use: ComposeTypes.Use)
			if not swipeDetector(use) and detectorDrag then
				detectorDrag = false
				cancelDrag()
			end
		end)
		local menuItems = Compose.formula(function(use: ComposeTypes.Use)
			local result: { NavigationTypes.MenuItem<string> } = {}
			local edges: { RowEdge } = { "leading" :: RowEdge, "trailing" :: RowEdge }
			for _, edge in edges do
				for _, action in actions(edge :: RowEdge, use) do
					table.insert(result, {
						id = edge .. ":" .. action.id,
						label = action.label,
						icon = action.icon,
						role = action.role,
						enabled = action.enabled,
						onSelect = function()
							execute(action, edge)
						end,
					})
				end
			end
			return result
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			if read(spec.enabled, use) == false then
				start, axis = nil, nil
				drag:set(nil)
				menuOpen:set(false)
				setOpen(nil)
			end
		end)
		root = Host.Frame(ctx.props(spec, behavior, {
			Size = D2.new(1, 0, 0, 44),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			tray("leading") :: ComposeTypes.Child,
			tray("trailing"),
			Host.Frame "Content" {
				Visible = function(use: ComposeTypes.Use): boolean
					return use(committing) == nil or (not reduced(use) and use(departure.progress) < 0.7)
				end,
				Size = function(use: ComposeTypes.Use)
					return D2.new(
						1,
						(if read(spec.editing, use) then -use(editWidth) else 0)
							- (if bottom then 0 else actionWidth(use)),
						1,
						-actionHeight(use)
					)
				end,
				BackgroundTransparency = 1,
				Position = function(use: ComposeTypes.Use)
					local gutter = if read(spec.editing, use) then use(editWidth) else 0
					return D2.fromOffset(gutter + paintedOffset(use), 0)
				end,
				Attributes = {
					FacetDragRestX = function(use: ComposeTypes.Use)
						return if read(spec.editing, use) then use(editWidth) else 0
					end,
				} :: Types.Attributes,
				content :: ComposeTypes.Child,
				Host.TextButton "SwipeGrip" {
					Size = D2.fromScale(1, 1),
					BackgroundTransparency = 1,
					Text = "",
					AutoButtonColor = false,
					Selectable = false,
					ZIndex = if content:IsA("GuiButton") then 4 else 0,
					Visible = swipeable,
					InputBegan = function(input: InputObject)
						began(input)
						pressed = input
						local host = collectionRow()
						local hit = if host then host:FindFirstChild("RowHit") else nil
						if hit then
							activation.press(hit, input)
						end
					end,
					Activated = function(input: InputObject?)
						if touchFirst() and not panned and start == nil then
							tap(input)
						end
					end,
					Host.UIDragDetector({
						Enabled = swipeDetector,
						DragStyle = E.UIDragDetectorDragStyle.TranslateLine,
						DragAxis = V2.new(1, 0),
						ResponseStyle = E.UIDragDetectorResponseStyle.CustomOffset,
						DragStart = function(position: Vector2)
							detectorDrag = true
							activation.drag(root, "start", position)
							begin(position)
						end,
						DragContinue = function(position: Vector2)
							if detectorDrag then
								if activation.drag(root, "move", position) then
									return
								end
								move(position)
							end
						end,
						DragEnd = function()
							if detectorDrag then
								detectorDrag = false
								activation.drag(root, "end", nil)
								release()
							end
						end,
					}),
				},
				Host.TextButton "DismissTray" {
					Size = D2.fromScale(1, 1),
					BackgroundTransparency = 1,
					Text = "",
					Active = true,
					AutoButtonColor = false,
					Selectable = false,
					ZIndex = 5,
					Visible = function(use: ComposeTypes.Use)
						return readSource(open, use) ~= nil and use(committing) == nil
					end,
					InputBegan = function(input: InputObject)
						if
							input.UserInputType ~= E.UserInputType.MouseButton1
							and input.UserInputType ~= E.UserInputType.Touch
						then
							return
						end
						local host = collectionRow()
						local hit = if host then host:FindFirstChild("RowHit") else nil
						if hit then
							activation.press(hit, input)
						end
						if readSource(open) ~= nil and committing:peek() == nil then
							setOpen(nil)
						end
					end,
					Activated = function()
						if readSource(open) ~= nil and committing:peek() == nil then
							setOpen(nil)
						end
					end,
				},
			},
		}))
		local menuSpec: NavigationProps.MenuSpec<string> = {
			trigger = root,
			closeButton = true,
			items = menuItems,
			isPresented = menuOpen,
			triggers = { "secondary" :: "secondary" },
			enabled = function(use: ComposeTypes.Use?): boolean
				return read(spec.enabled, use) ~= false
					and readSource(committing, use) == nil
					and #readSource(menuItems, use) > 0
			end,
			onOpen = function()
				setOpen(nil)
				if spec.coordinator then
					spec.coordinator:set(rowToken)
				end
			end,
		}
		UI.Menu(menuSpec)
		if #cellEdits > 0 then
			runtime.mount(function()
				local button = UI.Button {
					Name = "CellActions",
					icon = "more",
					label = "",
					name = "Item actions",
					appearance = if bottom then "utility" else "plain",
					shape = if bottom then "circle" :: "circle" else nil,
					AnchorPoint = V2.new(1, if bottom then 1 else 0.5),
					Position = D2.fromScale(1, if bottom then 1 else 0.5),
					Size = function(use)
						return D2.fromOffset(actionSize(use), actionSize(use))
					end,
					Visible = function(use)
						return actionSize(use) > 0
					end,
					enabled = spec.enabled,
					onActivate = function()
						reveal()
					end,
					ZIndex = 5,
				}
				local size, unit = ctx.observe.AbsoluteSize(button), ctx.layoutUnit(root)
				Compose.watch(function(use: ComposeTypes.Use)
					measuredActionSize:set(use(size) / use(unit))
				end)
				return button
			end, root)
		end
		contentFrame = assert(root:FindFirstChild("Content")) :: Frame
		local grip = assert(contentFrame:FindFirstChild("SwipeGrip"))
		runtime.connect(grip, "TouchPan", pan)
		runtime.decorate(root, {
			Size = function(use: ComposeTypes.Use)
				local size = read(spec.Size, use) or D2.new(1, 0, 0, 44)
				local fraction = if use(committing)
					then (if reduced(use) then 1 else math.clamp((use(departure.progress) - 0.7) / 0.3, 0, 1))
					else 0
				return D2.new(
					size.X.Scale,
					size.X.Offset,
					size.Y.Scale * (1 - fraction),
					size.Y.Offset * (1 - fraction)
				)
			end,
		})
		local measured = ctx.observe.AbsoluteSize(root)
		Compose.watch(function(use: ComposeTypes.Use)
			dimensions:set(use(measured))
		end)
		function reveal()
			if
				read(spec.enabled) ~= false
				and committing:peek() == nil
				and ctx.available(root)
				and #menuItems:peek() > 0
			then
				setOpen(nil)
				if spec.coordinator then
					spec.coordinator:set(rowToken)
				end
				menuOpen:set(true)
			end
		end

		runtime.connect(root, "InputBegan", began)
		local inputService = ctx.config.userInputService
		if inputService then
			local function cancelInput(input: InputObject): ()
				if activeInput == input and input.UserInputState == E.UserInputState.Cancel then
					cancelDrag()
				end
			end
			runtime.connect(inputService, "InputChanged", cancelInput)
			runtime.connect(inputService, "InputEnded", cancelInput)
			runtime.connect(inputService, "WindowFocusReleased", cancelDrag)
		end
		if inputService then
			local service = inputService
			local function outside(input: InputObject): boolean
				local layer = root:FindFirstAncestorWhichIsA("LayerCollector")
				if layer == nil or not layer:IsA("ScreenGui") then
					return false
				end
				local point = V2.new(input.Position.X, input.Position.Y)
				local guiService = ctx.config.guiService
				if (layer :: ScreenGui).IgnoreGuiInset and guiService then
					point += guiService:GetGuiInset()
				end
				local at, size = root.AbsolutePosition, root.AbsoluteSize
				return point.X < at.X or point.Y < at.Y or point.X > at.X + size.X or point.Y > at.Y + size.Y
			end
			local listening: RBXScriptConnection? = nil
			local function release(): ()
				if listening then
					listening:Disconnect()
					listening = nil
				end
			end
			Compose.watch(function(use: ComposeTypes.Use)
				if readSource(open, use) == nil then
					release()
				elseif listening == nil then
					listening = service.InputBegan:Connect(function(input: InputObject)
						local kind = input.UserInputType
						if
							(kind == E.UserInputType.MouseButton1 or kind == E.UserInputType.Touch)
							and committing:peek() == nil
							and readSource(open) ~= nil
							and outside(input)
						then
							setOpen(nil)
						end
					end)
				end
			end)
			Compose.cleanup(release)
		end
		local function longPress(_: { Vector2 }, state: Enum.UserInputState)
			if state == E.UserInputState.Begin and #cellEdits == 0 then
				reveal()
			end
		end
		runtime.connect(root, "TouchLongPress", longPress)
		runtime.connect(grip, "TouchLongPress", longPress)
		local gui = ctx.config.guiService
		local selected: ComposeTypes.Cell<GuiObject?> = if gui
			then ctx.observe.SelectedObject(gui)
			else Compose.cell(nil :: GuiObject?)
		local function scope(): Instance
			return collectionRow() or root
		end
		local function eligible(use: ComposeTypes.Use): boolean
			local node = readSource(selected, use)
			return node ~= nil
				and node:IsDescendantOf(scope())
				and read(spec.enabled, use) ~= false
				and readSource(committing, use) == nil
				and not (node:IsA("TextBox") and node:IsFocused())
		end
		ctx.action(
			root,
			"RowActionsReveal",
			{ E.KeyCode.ButtonX, E.KeyCode.Menu },
			eligible,
			reveal,
			{ priority = 450 }
		)
		ctx.action(root, "RowActionsClose", { E.KeyCode.Escape, E.KeyCode.ButtonB }, function(use: ComposeTypes.Use)
			return eligible(use) and (readSource(open, use) ~= nil or use(menuOpen))
		end, function()
			menuOpen:set(false)
			setOpen(nil)
		end, { priority = 300 })
		local function destructive(use: ComposeTypes.Use?): (RowAction?, RowEdge?)
			local edges: { RowEdge } = { "trailing" :: RowEdge, "leading" :: RowEdge }
			for _, edge in edges do
				for _, action in actions(edge :: RowEdge, use) do
					if action.role == "destructive" and read(action.enabled, use) ~= false then
						return action, edge :: RowEdge
					end
				end
			end
			return nil, nil
		end
		local function delete()
			local action, edge = destructive()
			if action then
				execute(action, edge)
			end
		end
		ctx.action(root, "RowActionsDelete", { E.KeyCode.Delete, E.KeyCode.Backspace }, function(use: ComposeTypes.Use)
			return eligible(use) and readSource(open, use) == nil and not use(menuOpen) and destructive(use) ~= nil
		end, delete, { priority = 300 })
		local toggleKeys: { Types.InputBindingNativeProps } = {
			{ KeyCode = E.KeyCode.Return, PrimaryModifier = E.KeyCode.LeftShift },
			{ KeyCode = E.KeyCode.Return, PrimaryModifier = E.KeyCode.RightShift },
		}
		ctx.action(root, "RowActionsToggle", toggleKeys, eligible, function()
			if menuOpen:peek() then
				menuOpen:set(false)
			else
				reveal()
			end
		end, { priority = 300 })
		ctx.shiftRoute(root, function()
			if read(spec.enabled) == false then
				return
			end
			if menuOpen:peek() then
				menuOpen:set(false)
			else
				reveal()
			end
		end)
		if spec.editing then
			runtime.mountFragment(function()
				return {
					Compose.show(function(use: ComposeTypes.Use)
						return read(spec.editing, use) == true and destructive(use) ~= nil
					end, function()
						local buttonProps: InputProps.ButtonProps = {
							Name = "Delete",
							Size = function(use: ComposeTypes.Use)
								return D2.new(0, use(editWidth), 1, 0)
							end,
							ZIndex = 5,
							label = function(use: ComposeTypes.Use): string
								local action = destructive(use)
								return if action then read(action.label, use) else "Delete"
							end,
							role = "destructive" :: InputTypes.ButtonRole,
							onActivate = delete,
						}
						local button = UI.Button(buttonProps)
						local caption = button:FindFirstChild("Title", true)
						local bounds = if caption and caption:IsA("TextLabel")
							then ctx.observe.TextBounds(caption)
							else ctx.observe.TextBounds(button)
						Compose.watch(function(use: ComposeTypes.Use)
							local size = use(bounds)
							editWidth:set(math.min(use(dimensions).X, math.max(72, (if size then size.X else 0) + 32)))
						end)
						return button
					end),
				}
			end, root)
		end
		local previousSelection: GuiObject?
		Compose.watch(function(use: ComposeTypes.Use)
			local edge = use(open) :: RowEdge?
			if gui == nil then
				return
			end
			if edge ~= nil then
				local current = gui.SelectedObject
				if current and current:IsDescendantOf(scope()) then
					previousSelection = current
					local trayNode = root:FindFirstChild(edge)
					if trayNode then
						for _, child in trayNode:GetChildren() do
							if child:IsA("GuiButton") and child.Selectable and child.Interactable then
								gui.SelectedObject = child
								break
							end
						end
					end
				end
			elseif previousSelection and previousSelection.Parent then
				gui.SelectedObject = previousSelection
				previousSelection = nil
			end
		end)

		return ctx.styled(root, "RowActions")
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="27">
            <Properties>
              <string name="Name">collection_rows</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local activation = require("./activation")
local adaptive = require("./adaptive")
local preparePaint = require("./collection_paint")
local reorder = require("./collection_reorder")
local policy = require("./collection_policy")
local travelEngine = require("./travel_engine")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local EngineTypes = require("./engine_types")
local CollectionTypes = require("./collection_types")
local State = require("./collection_state")
local Slots = require("./collection_slots")
return function<V, K>(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	view: State.View<V, K>,
	editor: reorder.Editor<V, K>?,
	slots: Slots.Slots<V, K>
): (CollectionTypes.Follow?) -> ComposeTypes.Child
	type SlotRecord = Slots.Slot<V, K>
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local read = ctx.read
	local readSource = ctx.readSource
	local observe = ctx.observe
	local D2, V2, E = ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local gui = ctx.config.guiService
	local spec, tree = view.spec, view.tree
	local kind: ComposeTypes.OrderedCollectionLayoutKind = view.kind
	local source, viewport, cross = view.source, view.viewport, view.cross
	local mountedVersion, status, controls, selection = view.mountedVersion, view.status, view.controls, view.selection
	local coordinator, selectionMode = view.coordinator, view.selectionMode
	local measured, containsCards, horizontal = view.measured, view.containsCards, view.horizontal
	local reduced, focusActive = view.reduced, view.focusActive
	local mounted, cellEdits, placed, poolOwner = view.mounted, view.cellEdits, view.placed, view.poolOwner
	local preparing, waiting = view.preparing, view.waiting
	local crossEdge, fullSizes = view.crossEdge, view.fullSizes
	local slotSource, withSlots = slots.source, slots.wrap
	local function select(key: K, current: ComposeTypes.Readable<V>, input: InputObject?, clicks: number?): ()
		if policy.disabled(spec.disabled, current:peek()) or activation.consumed(input) then
			return
		end
		if editor and spec.onActivate == nil and read(spec.editing) ~= true and editor.pickUp(key, input) then
			return
		end
		local pointer = input ~= nil and input.UserInputType == E.UserInputType.MouseButton1
		local double = pointer and (clicks or 0) >= 2
		if not double then
			view.selectRow(key, current:peek(), input)
		end
		local choosing = selectionMode ~= "none" and read(spec.editing) == true
		if spec.onActivate and not choosing and (selectionMode == "none" or not pointer or double) then
			spec.onActivate(current:peek(), key, input, clicks)
		end
	end
	local function captureSelection(node: Instance, key: K): ()
		if view.scope == nil then
			return
		end
		focusActive:set(true)
		view.focusOwned = true
		local path: { string } = {}
		local current: Instance? = node
		while current and current ~= mounted[key] do
			table.insert(path, 1, current.Name)
			current = current.Parent
		end
		view.focusedPath = path
		view.scope.focus(key)
	end
	local function wireSelection(node: Instance, key: K): ()
		if node:IsA("GuiObject") and (node.Selectable or node:IsA("GuiButton") or node:IsA("TextBox")) then
			runtime.connect(node, "SelectionGained", function()
				captureSelection(node, key)
			end)
		end
		for _, child in node:GetChildren() do
			wireSelection(child, key)
		end
	end
	local function orderedRows(follow: CollectionTypes.Follow?): ComposeTypes.Child
		return Compose.OrderedCollection({
			from = slotSource,
			key = function(record: SlotRecord, _index: number): K
				return record.key
			end,
			mode = spec.mode or "windowed",
			direction = spec.direction or "vertical",
			viewport = viewport,
			status = status,
			controls = controls,
			overscan = spec.overscan or 2,
			measured = Compose.formula(function(use: ComposeTypes.Use)
				local sizes = fullSizes(use)
				return if tree
					then tree.sizes(use, sizes, read(spec.itemSize or 40, use) :: number, read(spec.gap or 0, use))
					else sizes
			end),
			follow = follow,
			followThreshold = spec.followThreshold,
			layout = function(use: ComposeTypes.Use)
				local columns = if kind == "grid" then math.max(1, math.floor(read(spec.columns or 1, use))) else 1
				if spec.minColumnWidth ~= nil then
					local minimum = read(spec.minColumnWidth, use)
					assert(
						kind == "grid" and spec.columns == nil and minimum > 0 and minimum < math.huge,
						"Facet minColumnWidth needs a grid, a positive width and no columns"
					)
					columns = adaptive.columnsFor(
						math.max(0, use(cross) - 2 * crossEdge(use)),
						minimum,
						read(spec.crossGap or spec.gap or 0, use)
					)
				end
				local gap: number = read(spec.gap or 0, use)
				local crossGap: number = read(spec.crossGap or gap, use)
				return {
					kind = kind,
					columns = columns,
					itemSize = if view.cardsMode
						then (view.cardLayout(use))
						else read(spec.itemSize or 40, use) :: number,
					gap = if tree then 0 else gap,
					crossGap = crossGap,
					crossSize = math.max(0, (use(cross) - 2 * crossEdge(use) - crossGap * (columns - 1)) / columns),
				}
			end,
			render = withSlots(
				function(
					rowItem: ComposeTypes.Readable<V>,
					rowPlacement: ComposeTypes.Readable<ComposeTypes.Placement>,
					key: K
				)
					local lease = view.pool.acquire()
					local node = runtime.borrow(lease.value.node) :: Frame
					local contentOwner = poolOwner.createChild()
					local function retained<T>(row: ComposeTypes.Readable<T>): ComposeTypes.Readable<T>
						local held = Compose.withOwner(contentOwner, function(): ComposeTypes.Cell<T>
							return Compose.cell(row:peek())
						end)
						Compose.watch(function(use: ComposeTypes.Use)
							held:set(use(row))
						end)
						return held
					end
					local current, placement = retained(rowItem), retained(rowPlacement)
					local glide = Compose.cell(0)
					local stopGlide: (() -> ())? = nil
					local function halt()
						if stopGlide then
							stopGlide()
							stopGlide = nil
						end
					end
					Compose.cleanup(halt)
					local function shift(use: ComposeTypes.Use?): number
						return if use then use(glide) else glide:peek()
					end
					local paintPlacement = Compose.formula(function(use: ComposeTypes.Use): ComposeTypes.Placement
						local at = use(placement)
						return if editor and (spec.drag or spec.drop) then editor.placement(key, at, use) else at
					end)
					local reservedPosition = Compose.cell(V2.new(placement:peek().crossOffset, placement:peek().offset))
					local springPlacement = spec.slots ~= nil or spec.drag ~= nil or spec.drop ~= nil
					if springPlacement then
						local engine = travelEngine(ctx, {
							initial = { placement:peek().crossOffset, placement:peek().offset },
							target = function()
								local at = paintPlacement:peek()
								return { at.crossOffset, at.offset }
							end,
							sample = function(values)
								reservedPosition:set(V2.new(values[1], values[2]))
							end,
							reduced = reduced,
							motion = "spring",
							duration = ctx.metric("motion.durations.travel"),
							ease = ctx.motionEase("travel"),
							spring = ctx.motionSpring("travel"),
						})
						Compose.watch(function(use: ComposeTypes.Use)
							use(paintPlacement)
							engine.retarget()
						end)
					end
					local previous = placement:peek()
					Compose.watch(function(use: ComposeTypes.Use)
						local at = use(placement)
						local delta = previous.offset + glide:peek() - at.offset
						local moved = at.index ~= previous.index
						previous = at
						if
							springPlacement
							or tree
							or not moved
							or kind ~= "list"
							or math.abs(delta) > viewport:peek().size
							or reduced()
						then
							return
						end
						halt()
						local elapsed = 0
						local seconds = ctx.metric("motion.durations.glide")
						local present = ctx.motionEase("present")
						glide:set(delta)
						stopGlide = view.frames.onFrame(function(step: number)
							elapsed = math.min(seconds, elapsed + step)
							glide:set(delta * (1 - present(elapsed / seconds)))
							if elapsed >= seconds then
								halt()
							end
						end)
					end)
					Compose.withOwner(contentOwner, function()
						runtime.decorate(node, {
							Name = tostring(key),
							ClipsDescendants = tree ~= nil,
							Interactable = function(use: ComposeTypes.Use)
								return (tree == nil or tree.visible(key, use))
									and not policy.disabled(spec.disabled, use(current))
							end,
							LayoutOrder = function(use: ComposeTypes.Use)
								return use(placement).index
							end,
							Position = function(use: ComposeTypes.Use)
								local at = use(placement)
								if springPlacement then
									local position = use(reservedPosition)
									return if horizontal
										then D2.fromOffset(position.Y, position.X)
										else D2.fromOffset(position.X, position.Y)
								end
								local offset = at.offset + shift(use)
								return if horizontal
									then D2.fromOffset(offset, at.crossOffset)
									else D2.fromOffset(at.crossOffset, offset)
							end,
							Size = function(use: ComposeTypes.Use)
								local at = use(placement)
								return if horizontal
									then D2.fromOffset(at.size, at.crossSize)
									else D2.fromOffset(at.crossSize, at.size)
							end,
						})
					end)
					mounted[key] = node
					placed[key] = placement
					local measuredNode: GuiObject
					local actionHeight: ComposeTypes.Readable<number>? = nil
					local painted = Compose.cell(false)
					local stop, mountedContent = Compose.withOwner(contentOwner, function()
						return runtime.mount(function(): CanvasGroup
							local rendered = spec.render(current, placement, key)
							if tree and not tree.columnar then
								rendered = tree.wrap(rendered, current, key)
							end
							measuredNode = rendered
							if kind == "grid" and rendered:GetAttribute("FacetBody") ~= nil then
								containsCards:set(true)
							end
							cellEdits[key] = {}
							for _, edit in activation.edits(rendered) do
								local gated = table.clone(edit)
								gated.enabled = function(use: ComposeTypes.Use?): boolean
									return edit.enabled(use)
										and not policy.disabled(spec.disabled, readSource(current, use))
								end
								table.insert(cellEdits[key], gated)
							end
							if not view.actionsWrapped then
								rendered, actionHeight = policy.actions(
									ctx,
									spec,
									current,
									key,
									rendered,
									UI.RowActions,
									coordinator,
									kind == "grid"
								)
							end
							if editor then
								rendered = editor.wrap(rendered, current, key)
								local press = editor.press
								Compose.cleanup(activation.providePress(rendered, function(value: InputObject)
									press(key, value)
								end))
							end
							local children: Types.FrameProps = {
								Name = "Content",
								Size = if tree
									then function(use: ComposeTypes.Use): UDim2
										return D2.new(
											1,
											0,
											0,
											math.max(read(spec.itemSize or 40, use) :: number, fullSizes(use)[key] or 0)
										)
									end
									else D2.fromScale(1, 1),
								BackgroundTransparency = 1,
								Attributes = { FacetCollectionRow = true } :: EngineTypes.Attributes,
								ClipsDescendants = function(use)
									return read(spec.contentOverflow, use) == "clip"
								end,
								rendered,
							}
							if
								spec.onSelectionChange
								or spec.onActivate
								or spec.selection
								or spec.selectionMode
								or spec.rowDrop
								or #cellEdits[key] > 0
								or editor
							then
								local hit: TextButton
								hit = Host.TextButton "RowHit" {
									AnchorPoint = V2.new(0.5, 0.5),
									Position = D2.fromScale(0.5, 0.5),
									Size = D2.fromScale(1, 1),
									Text = "",
									BackgroundTransparency = 1,
									Selectable = true,
									Interactable = function(use: ComposeTypes.Use)
										return (tree == nil or tree.visible(key, use))
											and not policy.disabled(spec.disabled, use(current))
									end,
									Activated = function(input: InputObject?, clicks: number?)
										if not activation.intercepted(hit, input) then
											select(key, current, input, clicks)
										end
									end,
									Attributes = {
										FacetSelectionRequired = selectionMode ~= "none",
										FacetOnlySelected = function(use: ComposeTypes.Use)
											return use(view.onlySelected) == key
										end,
										FacetSelected = function(use: ComposeTypes.Use)
											return read(selection, use)[key] == true
										end,
									} :: EngineTypes.Attributes,
								}
								Compose.cleanup(activation.provide(hit, function(input: unknown, clicks: unknown)
									if not activation.intercepted(hit, input) then
										select(key, current, input :: InputObject?, clicks :: number?)
									end
								end))
								local function pressed(value: InputObject)
									activation.press(rendered, value)
								end
								runtime.connect(hit, "InputBegan", pressed)
								if editor and ctx.config.inputParent and ctx.config.inputParent:IsA("PluginGui") then
									runtime.connect(hit, "MouseButton1Down", function(x: number, y: number)
										editor.mouseDown(V2.new(x, y))
									end)
									runtime.connect(hit, "InputEnded", editor.finish)
								end
								Compose.cleanup(activation.providePress(hit, pressed))
								table.insert((children :: unknown) :: { unknown }, 1, hit)
							end
							local paintSelection = spec.selectionIndicator ~= false and selectionMode ~= "none"
							if paintSelection then
								children.BackgroundTransparency = nil
							end
							local groupProperties = (children :: unknown) :: Types.CanvasGroupNativeProps
							groupProperties.GroupTransparency = function(use: ComposeTypes.Use): number
								return if use(painted) then 0 else 1
							end
							groupProperties.AutomaticSize = if read(spec.contentOverflow) == "clip"
								then E.AutomaticSize.None
								else E.AutomaticSize.XY
							local content = Host.CanvasGroup(groupProperties)
							policy.drop(ctx, spec, current, key, content, kind == "grid" or horizontal)
							if paintSelection then
								ctx.styled(content, "TableRow")
								if kind == "grid" or horizontal then
									ctx.skin(content, "control", {
										selected = function(use: ComposeTypes.Use): boolean
											return use(selection)[key] == true
										end,
									})
								end
								Compose.watch(function(use: ComposeTypes.Use)
									if use(selection)[key] == true then
										content:AddTag("facet-selected")
									else
										content:RemoveTag("facet-selected")
									end
								end)
							end
							return content
						end, node)
					end)
					local content = mountedContent :: CanvasGroup
					local ready = Compose.withOwner(contentOwner, function()
						return preparePaint(ctx, content)
					end)
					preparing[node] = {
						ready = ready,
						painted = painted,
						required = function(): boolean
							local at, window = placement:peek(), viewport:peek()
							return spec.mode == "all"
								or window.size <= 0
								or (at.offset + at.size > window.offset and at.offset < window.offset + window.size)
						end,
					}
					waiting:update(function(value)
						return value + 1
					end)
					local parked: Instance? = nil
					local previousParent: Instance? = node.Parent
					local released = false
					local restoringParent = false
					local destroyed = node.Destroying:Connect(function()
						parked = nil
					end)
					local restore = node.AncestryChanged:Connect(function()
						if node.Parent and parked == nil then
							previousParent = node.Parent
						end
						if parked and not restoringParent and not poolOwner.isDisposed() and node.Parent == nil then
							restoringParent = true
							local ok = pcall(function()
								node.Parent = parked
							end)
							restoringParent = false
							if not ok then
								parked = nil
							end
						end
					end)
					local function release()
						if released then
							return
						end
						released = true
						parked = nil
						restore:Disconnect()
						destroyed:Disconnect()
						stop()
						contentOwner.dispose()
						lease.release()
					end
					wireSelection(content, key)
					if spec.measure or (tree and not tree.columnar) then
						local size: ComposeTypes.Cell<Vector2> = observe.AbsoluteSize(measuredNode)
						local lift = measuredNode:FindFirstChildWhichIsA("UIScale")
						local layoutUnit = if measuredNode:GetAttribute("FacetBody")
							then measuredNode:FindFirstChild("LayoutUnit")
							else nil
						local measurementUnit: Frame? = if lift
							then if layoutUnit and layoutUnit:IsA("Frame")
								then layoutUnit
								else Host.Frame({
									Name = "MeasurementUnit",
									Size = D2.fromOffset(1, 1),
									Visible = false,
								})
							else nil
						if measurementUnit then
							measurementUnit.Parent = measuredNode
						end
						local paintedSize = if measurementUnit then observe.AbsoluteSize(measurementUnit) else nil
						local factor: ComposeTypes.Readable<number> = if lift
							then observe.Scale(lift)
							else Compose.cell(1)
						Compose.watch(function(use: ComposeTypes.Use)
							local ancestors = use(view.unitSize).X
							if ancestors <= 0 then
								ancestors = 1
							end
							local liftScale = use(factor)
							local painted = if paintedSize then use(paintedSize).X else 0
							local scale = math.max(if painted > 0 then painted else liftScale * ancestors, 0.001)
							local dimensions = use(size)
							local extent = (if horizontal then dimensions.X else dimensions.Y) / scale
								+ (if editor and not horizontal then use(editor.header) else 0)
								+ (if actionHeight and not horizontal then use(actionHeight) else 0)
							extent = math.round(extent)
							local previous = measured:peek()[key]
							if previous and liftScale ~= 1 and math.abs(extent - previous) <= 1 then
								return
							end
							if extent > 0 and previous ~= extent then
								local nextSizes = table.clone(measured:peek())
								nextSizes[key] = extent
								measured:set(nextSizes)
							end
						end)
					end
					Compose.cleanup(function()
						if gui and State.belongsTo(gui.SelectedObject, node) then
							view.focusOwned = true
							gui.SelectedObject = nil
						end
						mounted[key] = nil
						placed[key] = nil
						cellEdits[key] = nil
						if preparing[node] then
							preparing[node] = nil
							waiting:update(function(value)
								return math.max(0, value - 1)
							end)
						end
						local wanted = false
						local pendingReplacement = false
						local nextRows = source(function<T>(cell: ComposeTypes.Readable<T>): T
							return cell:peek()
						end)
						for index, item in nextRows do
							local nextKey = view.keyOf(item, index)
							wanted = wanted or nextKey == key
							local window = viewport:peek()
							local at = if controls.placementOf then controls.placementOf(index) else nil
							local inWindow = spec.mode == "all"
								or window.size <= 0
								or (
									at ~= nil
									and at.offset + at.size > window.offset
									and at.offset < window.offset + window.size
								)
							pendingReplacement = pendingReplacement or (mounted[nextKey] == nil and inWindow)
						end
						if
							not wanted
							and pendingReplacement
							and painted:peek()
							and not poolOwner.isDisposed()
							and #source(function<T>(cell: ComposeTypes.Readable<T>): T
									return cell:peek()
								end)
								> 0
						then
							parked = previousParent
							node.Parent = parked
							content.Interactable = false
							view.retiring[node] = release
						else
							release()
						end
					end)
					runtime.connect(node, "AncestryChanged", function()
						mountedVersion:update(function(value)
							return value + 1
						end)
					end)
					return node
				end
			),
		})
	end
	return orderedRows
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">collection_selection</string>
              <string name="Source"><![CDATA[--!strict
local policy = require("./collection_policy")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local CollectionTypes = require("./collection_types")
return function<V, K>(
	ctx: Types.Context,
	spec: CollectionTypes.SelectionOptions<V, K>,
	source: Types.Value<{ V }>,
	keyOf: (V, number) -> K,
	controls: ComposeTypes.OrderedCollectionControls<K>,
	selection: ComposeTypes.Cell<CollectionTypes.Selection<K>>,
	defaultMode: "none" | "single" | "multiple"
): ((K, V, InputObject?) -> (), (K?, K) -> ())
	local Compose, read, E = ctx.Compose, ctx.read, ctx.types.Enum
	local anchor: K?
	local mode = spec.selectionMode or defaultMode
	assert(
		mode == "none" or mode == "single" or mode == "multiple",
		`Facet collection selectionMode must be none, single or multiple (got {tostring(mode)})`
	)
	local function publish(value: CollectionTypes.Selection<K>): ()
		if spec.onSelectionChange then
			spec.onSelectionChange(value)
		elseif type(selection.set) == "function" then
			selection:set(value)
		end
	end
	Compose.watch(function(use: ComposeTypes.Use)
		local existing = use(selection)
		if next(existing) == nil then
			return
		end
		local valid: { [K]: boolean } = {}
		for index, item in read(spec.selectionFrom or source, use) do
			valid[keyOf(item, index)] = true
		end
		local pruned: CollectionTypes.Selection<K> = {}
		local changed = false
		for key, value in existing do
			if value and valid[key] then
				pruned[key] = true
			else
				changed = true
			end
		end
		if changed then
			publish(pruned)
		end
	end)
	local base: CollectionTypes.Selection<K> = {}
	local shift = { E.KeyCode.LeftShift, E.KeyCode.RightShift }
	local toggle = {
		E.KeyCode.LeftControl,
		E.KeyCode.RightControl,
		E.KeyCode.LeftMeta,
		E.KeyCode.RightMeta,
		E.KeyCode.LeftSuper,
		E.KeyCode.RightSuper,
	}
	local function held(keys: { Enum.KeyCode }): boolean
		local input = ctx.config.userInputService
		if input == nil then
			return false
		end
		for _, keyCode in keys do
			if input:IsKeyDown(keyCode) then
				return true
			end
		end
		return false
	end
	local function eligible(item: V): boolean
		return policy.allows(spec.selectable, item) and not policy.disabled(spec.disabled, item)
	end
	local function range(from: K, to: K): boolean
		local first, last = assert(controls.indexOfKey)(from), assert(controls.indexOfKey)(to)
		if first == nil or last == nil then
			return false
		end
		local selected: CollectionTypes.Selection<K> = {}
		local current = selection:peek()
		for key in base do
			if current[key] then
				selected[key] = true
			end
		end
		local rows = read(source)
		for index = math.min(first, last), math.max(first, last) do
			local candidate = rows[index]
			if candidate ~= nil and eligible(candidate) then
				selected[keyOf(candidate, index)] = true
			end
		end
		publish(selected)
		return true
	end
	local function anchorAt(key: K, selected: CollectionTypes.Selection<K>): ()
		anchor = key
		base = table.clone(selected)
	end
	local function choose(key: K, item: V, _input: InputObject?): ()
		if mode == "none" or not eligible(item) then
			return
		end
		if mode ~= "multiple" then
			local selected = if read(spec.editing) == true and selection:peek()[key] then {} else { [key] = true }
			anchorAt(key, selected)
			publish(selected)
			return
		end
		if anchor ~= nil and held(shift) and range(anchor, key) then
			return
		end
		local selected: CollectionTypes.Selection<K> = {}
		if held(toggle) or read(spec.editing) == true then
			local current = selection:peek()
			for other, on in current do
				if on and other ~= key then
					selected[other] = true
				end
			end
			if not current[key] then
				selected[key] = true
			end
		else
			selected[key] = true
		end
		anchorAt(key, selected)
		publish(selected)
	end
	local function extend(from: K?, to: K): ()
		if mode ~= "multiple" or from == nil or from == to or not held(shift) then
			return
		end
		if anchor == nil or assert(controls.indexOfKey)(anchor :: K) == nil then
			local selected = table.clone(selection:peek())
			selected[from] = true
			anchorAt(from, selected)
		end
		range(anchor :: K, to)
	end
	return choose, extend
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">collection_slots</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local EngineTypes = require("./engine_types")
local CollectionTypes = require("./collection_types")
local State = require("./collection_state")
export type Slot<V, K> = { key: K, item: V? }
export type Slots<V, K> = {
	source: ComposeTypes.Formula<{ Slot<V, K> }>,
	wrap: (
		CollectionTypes.RowRender<V, K>
	) -> (ComposeTypes.Readable<Slot<V, K>>, ComposeTypes.Readable<ComposeTypes.Placement>, K) -> GuiObject,
}
return function<V, K>(ctx: Types.Context, view: State.View<V, K>): Slots<V, K>
	local Compose, Host = ctx.Compose, ctx.Host
	local read = ctx.read
	local D2 = ctx.types.UDim2
	local spec, source, keyOf, horizontal = view.spec, view.source, view.keyOf, view.horizontal
	local slotNodes: { [K]: GuiObject } = {}
	if spec.slotControls then
		assert(spec.slots ~= nil, "Facet collection slotControls requires slots")
		spec.slotControls.nodeOfKey = function(key: K): GuiObject?
			return slotNodes[key]
		end
		Compose.cleanup(function()
			(spec.slotControls :: CollectionTypes.SlotControls<K>).nodeOfKey = nil
		end)
	end
	type SlotRecord = { key: K, item: V? }
	local slotSource = Compose.formula(function(use: ComposeTypes.Use): { SlotRecord }
		local items, result, included = {} :: { [K]: V }, {} :: { SlotRecord }, {} :: { [K]: boolean }
		local rows = source(use)
		for index, item in rows do
			items[keyOf(item, index)] = item
		end
		for _, key in read(spec.slots or {}, use) do
			assert(not included[key], "Facet collection slots must have unique keys")
			included[key] = true
			table.insert(result, { key = key, item = items[key] })
		end
		for index, item in rows do
			local key = keyOf(item, index)
			if not included[key] then
				table.insert(result, { key = key, item = item })
			end
		end
		return result
	end, function(before: { SlotRecord }?, after: { SlotRecord }): boolean
		if before == nil or spec.slots == nil or #before ~= #after then
			return false
		end
		for index, entry in before do
			if entry.key ~= after[index].key then
				return false
			end
		end
		return true
	end)
	local function withSlots(renderItem: CollectionTypes.RowRender<V, K>)
		return function(
			record: ComposeTypes.Readable<SlotRecord>,
			placement: ComposeTypes.Readable<ComposeTypes.Placement>,
			key: K
		)
			if spec.slots == nil then
				return renderItem(
					Compose.formula(function(use: ComposeTypes.Use): V
						return assert(use(record).item)
					end),
					placement,
					key
				)
			end
			local function itemForKey(use: ComposeTypes.Use): V?
				for index, item in source(use) do
					if keyOf(item, index) == key then
						return item
					end
				end
				return nil
			end
			local last = record:peek().item
			local current = Compose.formula(function(use: ComposeTypes.Use): V
				local item = itemForKey(use)
				if item ~= nil then
					last = item
				end
				return assert(last)
			end)
			local recess: GuiObject = ctx.styled(
				Host.Frame {
					Name = "ReservedSlot",
					Visible = function(use: ComposeTypes.Use): boolean
						return itemForKey(use) == nil
					end,
					Interactable = false,
					Selectable = false,
					Attributes = { FacetReservedKey = tostring(key) } :: EngineTypes.Attributes,
					Position = function(use: ComposeTypes.Use): UDim2
						local at = use(placement)
						return if horizontal
							then D2.fromOffset(at.offset, at.crossOffset)
							else D2.fromOffset(at.crossOffset, at.offset)
					end,
					Size = function(use: ComposeTypes.Use): UDim2
						local at = use(placement)
						return if horizontal
							then D2.fromOffset(at.size, at.crossSize)
							else D2.fromOffset(at.crossSize, at.size)
					end,
				},
				"fill"
			)
			slotNodes[key] = recess
			Compose.cleanup(function()
				if slotNodes[key] == recess then
					slotNodes[key] = nil
				end
			end)
			local shellProps: Types.FrameProps = {
				Name = "Slot",
				BackgroundTransparency = 1,
				Size = D2.fromScale(1, 1),
				Compose.show(function(use: ComposeTypes.Use): boolean
					return itemForKey(use) ~= nil
				end, function()
					return renderItem(current, placement, key)
				end),
				recess,
			}
			return Host.Frame(shellProps)
		end
	end
	return { source = slotSource, wrap = withSlots }
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">collection_snap</string>
              <string name="Source"><![CDATA[--!strict
local reducedMotion = require("./motion").reduced
local settling = require("./settle")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
type SnapOptions = { direction: ComposeTypes.OrderedCollectionDirection?, reducedMotion: Types.Value<boolean>? }
return function<K>(
	ctx: Types.Context,
	spec: SnapOptions,
	root: ScrollingFrame,
	controls: ComposeTypes.OrderedCollectionControls<K>,
	status: ComposeTypes.Cell<ComposeTypes.OrderedCollectionStatus>,
	viewport: ComposeTypes.Cell<ComposeTypes.OrderedCollectionViewport>,
	setOffset: (number) -> (),
	frameworkWrite: () -> boolean,
	enabled: (() -> boolean)?
): ()
	local Compose, runtime, E = ctx.Compose, ctx.runtime, ctx.types.Enum
	local frames = assert(runtime.host.frames)
	local clock = frames.now
	local idle, target = 0, 0
	local motionReduced = reducedMotion(ctx)
	local function reduced(): boolean
		return if spec.reducedMotion == nil then motionReduced() else ctx.read(spec.reducedMotion) == true
	end
	local glide = settling(ctx, function(): number
		return target
	end, ctx.motionSpring("control"), reduced)
	local held, running, writing = false, false, false
	local stopWait: ComposeTypes.Dispose? = nil
	local previous, previousTime, velocity, gestureStart = 0, clock(), 0, 0
	local function cancel()
		running = false
		glide.halt()
		if stopWait then
			stopWait()
			stopWait = nil
		end
	end
	local function write(value: number): ()
		writing = true
		setOffset(value)
		writing = false
		previous = value
	end
	local function lowerBound(offset: number, total: number): number
		local low, high = 1, total + 1
		while low < high do
			local middle = math.floor((low + high) / 2)
			if assert(controls.placementOf)(middle).offset < offset then
				low = middle + 1
			else
				high = middle
			end
		end
		return low
	end
	local function settle()
		if enabled and not enabled() then
			return
		end
		local current, box = status:peek(), viewport:peek()
		if current == nil or current.total == nil or current.total == 0 then
			return
		end
		local maximum = math.max(0, current.extent - box.size)
		local index = lowerBound(box.offset, current.total)
		local before = assert(controls.placementOf)(math.max(1, index - 1))
		if
			before.size > box.size or (index <= current.total and assert(controls.placementOf)(index).size > box.size)
		then
			return
		end
		local desired, distance = maximum, math.abs(maximum - box.offset)
		for _, at in { math.max(1, index - 1), math.min(current.total, index) } do
			local boundary = math.clamp(assert(controls.placementOf)(at).offset, 0, maximum)
			local difference = math.abs(boundary - box.offset)
			if difference < distance then
				desired, distance = boundary, difference
			end
		end
		if math.abs(velocity) > 350 and clock() - previousTime < 0.25 then
			if velocity > 0 and desired <= gestureStart then
				local nextIndex = lowerBound(gestureStart + 0.01, current.total)
				desired = if nextIndex <= current.total
					then math.min(maximum, assert(controls.placementOf)(nextIndex).offset)
					else maximum
			elseif velocity < 0 and desired >= gestureStart then
				local previousIndex = lowerBound(gestureStart, current.total) - 1
				desired = if previousIndex > 0 then assert(controls.placementOf)(previousIndex).offset else 0
			end
		end
		velocity = 0
		if math.abs(desired - box.offset) < 0.5 then
			return
		end
		target, running = desired, true
		if not glide.launch(box.offset, 0) then
			running = false
			write(desired)
		end
	end
	local function waitForRest()
		idle = 0
		if stopWait then
			return
		end
		stopWait = frames.onFrame(function(delta)
			idle += delta
			if idle >= 0.12 and not held then
				local stop = stopWait
				stopWait = nil
				assert(stop)()
				settle()
			end
		end)
	end
	Compose.watch(function(use: ComposeTypes.Use)
		local value = use(glide.value)
		if running then
			write(value or target)
			if value == nil then
				running = false
			end
		end
	end)
	Compose.cleanup(assert(runtime.host.observation).observeProperty(root, "CanvasPosition", function()
		local offset = if spec.direction == "horizontal" then root.CanvasPosition.X else root.CanvasPosition.Y
		if writing then
			return
		end
		if frameworkWrite() then
			cancel()
			previous, velocity, gestureStart = offset, 0, offset
			return
		end
		if running then
			cancel()
		end
		if not held and stopWait == nil then
			gestureStart = previous
		end
		local now = clock()
		if now > previousTime then
			velocity = (offset - previous) / (now - previousTime)
		end
		previous, previousTime = offset, now
		if not held then
			waitForRest()
		end
	end))
	local function begin(input: InputObject): ()
		if input.UserInputType == E.UserInputType.Touch or input.UserInputType == E.UserInputType.MouseButton1 then
			cancel()
			held, gestureStart, previous, previousTime, velocity =
				true, viewport:peek().offset, viewport:peek().offset, clock(), 0
		end
	end
	local function finish(input: InputObject): ()
		if
			held
			and (input.UserInputType == E.UserInputType.Touch or input.UserInputType == E.UserInputType.MouseButton1)
		then
			held = false
			if input.UserInputState == E.UserInputState.Cancel then
				cancel()
			else
				waitForRest()
			end
		end
	end
	runtime.connect(root, "InputBegan", begin)
	runtime.connect(ctx.config.userInputService or root, "InputEnded", finish)
	if ctx.config.userInputService then
		runtime.connect(ctx.config.userInputService, "WindowFocusReleased", function()
			held = false
			cancel()
		end)
	end
	Compose.cleanup(cancel)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">collection_state</string>
              <string name="Source"><![CDATA[--!strict
local TreeTypes = require("./collection_tree")
local activation = require("./activation")
local createSelection = require("./collection_selection")
local reducedMotion = require("./motion").reduced
local adaptive = require("./adaptive")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local CollectionTypes = require("./collection_types")
export type PooledRow = { node: Frame, owner: ComposeTypes.Owner }
export type Preparing = {
	ready: ComposeTypes.Readable<boolean>,
	painted: ComposeTypes.Cell<boolean>,
	required: () -> boolean,
}
export type View<V, K> = {
	spec: CollectionTypes.CollectionShape<V, K>,
	kind: ComposeTypes.OrderedCollectionLayoutKind,
	keyOf: (V, number) -> K,
	tree: TreeTypes.Tree<V, K>?,
	actionsWrapped: boolean?,
	source: (ComposeTypes.Use) -> { V },
	viewport: ComposeTypes.Cell<ComposeTypes.OrderedCollectionViewport>,
	cross: ComposeTypes.Cell<number>,
	mountedVersion: ComposeTypes.Cell<number>,
	status: ComposeTypes.Cell<ComposeTypes.OrderedCollectionStatus>,
	controls: ComposeTypes.OrderedCollectionControls<K>,
	selection: ComposeTypes.Cell<CollectionTypes.Selection<K>>,
	onlySelected: ComposeTypes.Formula<K?>,
	coordinator: ComposeTypes.Cell<{}?>,
	selectionMode: "none" | "single" | "multiple",
	selectRow: (K, V, InputObject?) -> (),
	extendSelection: (K?, K) -> (),
	measured: ComposeTypes.Cell<{ [K]: number }>,
	containsCards: ComposeTypes.Cell<boolean>,
	horizontal: boolean,
	cardsMode: boolean,
	preferred: ComposeTypes.Readable<Enum.PreferredInput>?,
	frames: ComposeTypes.Frames,
	reduced: () -> boolean,
	unit: Frame,
	unitSize: ComposeTypes.Cell<Vector2>,
	focusActive: ComposeTypes.Cell<boolean>,
	noFocusCandidates: { V },
	initialFollow: boolean,
	focusedPath: { string },
	focusOwned: boolean,
	scope: ComposeTypes.FocusScope<K>?,
	mounted: { [K]: Frame? },
	cellEdits: { [K]: { activation.EditAction } },
	placed: { [K]: ComposeTypes.Readable<ComposeTypes.Placement> },
	poolOwner: ComposeTypes.Owner,
	preparing: { [Frame]: Preparing },
	retiring: { [Frame]: () -> () },
	waiting: ComposeTypes.Cell<number>,
	pool: ComposeTypes.Pool<PooledRow>,
	mainEdge: (ComposeTypes.Use?) -> number,
	crossEdge: (ComposeTypes.Use?) -> number,
	cardLayout: (ComposeTypes.Use?) -> (number, number),
	fullSizes: (ComposeTypes.Use) -> { [K]: number },
}
local function belongsTo(node: Instance?, ancestor: Instance): boolean
	return node ~= nil and (node == ancestor or node:IsDescendantOf(ancestor))
end
local function findSelectable(node: Instance, names: { string }?, depth: number): GuiObject?
	if node:IsA("GuiObject") and (not node.Visible or not node.Interactable) then
		return nil
	end
	if names and names[depth] then
		for _, child in node:GetChildren() do
			if child.Name == names[depth] then
				local found = findSelectable(child, names, depth + 1)
				if found then
					return found
				end
			end
		end
	end
	if node:IsA("GuiObject") and node.Selectable and node.Visible and node.Interactable then
		return node
	end
	for _, child in node:GetChildren() do
		local found = findSelectable(child, nil, 1)
		if found then
			return found
		end
	end
	return nil
end
local function create<V, K>(
	ctx: Types.Context,
	spec: CollectionTypes.CollectionShape<V, K>,
	kind: ComposeTypes.OrderedCollectionLayoutKind,
	keyOf: (V, number) -> K,
	tree: TreeTypes.Tree<V, K>?,
	actionsWrapped: boolean?,
	source: (ComposeTypes.Use) -> { V }
): View<V, K>
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local read = ctx.read
	local readSource = ctx.readSource
	local observe = ctx.observe
	local D2, E = ctx.types.UDim2, ctx.types.Enum
	local viewport: ComposeTypes.Cell<ComposeTypes.OrderedCollectionViewport> = Compose.cell({ offset = 0, size = 0 })
	local cross, mountedVersion = Compose.cell(0), Compose.cell(0)
	local emptyStatus: ComposeTypes.OrderedCollectionStatus = {
		mode = "windowed",
		direction = "vertical",
		total = 0,
		retained = 0,
		first = 0,
		last = 0,
		firstRow = 0,
		lastRow = 0,
		rowCount = 0,
		extent = 0,
		following = false,
		measured = 0,
	}
	local status = (spec.status or Compose.cell(emptyStatus)) :: ComposeTypes.Cell<ComposeTypes.OrderedCollectionStatus>
	if status:peek() == nil then
		status:set(emptyStatus)
	end
	local controls: ComposeTypes.OrderedCollectionControls<K> = spec.controls or {}
	local selection: ComposeTypes.Cell<CollectionTypes.Selection<K>> = spec.selection or Compose.cell({})
	local onlySelected = Compose.formula(function(use: ComposeTypes.Use): K?
		local only: K? = nil
		local chosen: CollectionTypes.Selection<K> = use(selection)
		for key, selected in chosen do
			if selected then
				if only ~= nil then
					return nil
				end
				only = key
			end
		end
		return only
	end)
	local coordinator = Compose.cell(nil :: {}?)
	local selectionMode: "none" | "single" | "multiple" = spec.selectionMode
		or (if spec.selection or spec.onSelectionChange then "single" else "none")
	local selectRow, extendSelection = createSelection(ctx, spec, source, keyOf, controls, selection, selectionMode)
	local measured: ComposeTypes.Cell<{ [K]: number }> = Compose.cell({})
	local containsCards = Compose.cell(false)
	local horizontal = spec.direction == "horizontal"
	local cardsMode = spec.itemSize == "cards"
	assert(not cardsMode or horizontal, 'Facet collection: itemSize = "cards" needs a horizontal list')
	assert(spec.cards == nil or cardsMode, 'Facet collection: cards needs itemSize = "cards"')
	local preferred: ComposeTypes.Readable<Enum.PreferredInput>? = if ctx.config.userInputService
		then observe.PreferredInput(ctx.config.userInputService)
		else nil
	local frames = assert(runtime.host.frames)
	local motionReduced = reducedMotion(ctx)
	local function reduced(): boolean
		return if spec.reducedMotion == nil then motionReduced() else read(spec.reducedMotion) == true
	end
	local unit = Host.Frame({
		Name = "LayoutUnit",
		Size = D2.fromOffset(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
	})
	local unitSize: ComposeTypes.Cell<Vector2> = observe.AbsoluteSize(unit)
	local focusActive = Compose.cell(spec.focus ~= nil or spec.initialFocus ~= nil or spec.autoFocus == true)
	local noFocusCandidates: { V } = {}
	local initialFollow = read(spec.follow) == "end" and spec.CanvasPosition == nil
	local mounted: { [K]: Frame? } = {}
	local cellEdits: { [K]: { activation.EditAction } } = {}
	local placed: { [K]: ComposeTypes.Readable<ComposeTypes.Placement> } = {}
	local poolOwner = assert(Compose.currentOwner()).createChild()
	local preparing: {
		[Frame]: {
			ready: ComposeTypes.Readable<boolean>,
			painted: ComposeTypes.Cell<boolean>,
			required: () -> boolean,
		},
	} =
		{}
	local retiring: { [Frame]: () -> () } = {}
	local waiting = Compose.cell(0)
	Compose.watch(function(use: ComposeTypes.Use)
		use(waiting)
		use(viewport)
		for _, entry in preparing do
			if entry.required() and not use(entry.ready) then
				return
			end
		end
		for node, entry in preparing do
			if use(entry.ready) then
				entry.painted:set(true)
				preparing[node] = nil
			end
		end
		waiting:set(0)
		for node, release in retiring do
			retiring[node] = nil
			release()
		end
	end)
	local pool: ComposeTypes.Pool<PooledRow> = Compose.createPool({
		maxRetained = spec.maxRetained or 32,
		create = function()
			local owner = poolOwner.createChild()
			local node = Compose.withOwner(owner, function()
				local nativeProps: Types.FrameProps = {
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					ClipsDescendants = false,
				}
				return Host.Frame(nativeProps)
			end)
			return { node = node, owner = owner }
		end,
		reset = function(record: PooledRow)
			if record.node.Parent ~= nil then
				record.node.Parent = nil
			end
		end,
		destroy = function(record: PooledRow)
			record.owner.dispose()
		end,
	})
	local function edgeOf(gutter: Types.Value<number>?, use: ComposeTypes.Use?): number
		return if kind == "grid" then math.ceil(math.max(0, read(gutter or 0, use)) / 2) else 0
	end
	local function mainEdge(use: ComposeTypes.Use?): number
		local edge = edgeOf(spec.gap, use)
		if kind ~= "grid" or not readSource(containsCards, use) then
			return edge
		end
		local extent = read(spec.itemSize or 40, use) :: number
		for _, size in readSource(measured, use) do
			extent = math.max(extent, size)
		end
		for _, size in read(spec.measured or {}, use) do
			extent = math.max(extent, size)
		end
		return math.max(edge, math.ceil(extent * math.max(0, ctx.metric("motion.materialize.lift", use) - 1)))
	end
	local function crossEdge(use: ComposeTypes.Use?): number
		local edge = edgeOf(spec.crossGap or spec.gap, use)
		if kind ~= "grid" or not readSource(containsCards, use) then
			return edge
		end
		local available = readSource(cross, use)
		local columns = if spec.minColumnWidth ~= nil
			then adaptive.columnsFor(
				available,
				read(spec.minColumnWidth, use),
				read(spec.crossGap or spec.gap or 0, use)
			)
			else math.max(1, math.floor(read(spec.columns or 1, use)))
		return math.max(
			edge,
			math.ceil(available / columns * math.max(0, ctx.metric("motion.materialize.lift", use) - 1))
		)
	end
	local function cardLayout(use: ComposeTypes.Use?): (number, number)
		local options: { perView: number?, minWidth: number?, peek: number? } = spec.cards or {}
		local available = if use then use(viewport).size else viewport:peek().size
		local gap: number = read(spec.gap or 0, use)
		local touch = preferred ~= nil and readSource(preferred, use) == E.PreferredInput.Touch
		local perView = options.perView
			or if touch and available < adaptive.BREAKPOINTS.regular
				then 1
				else adaptive.columnsFor(available, options.minWidth or 200, gap)
		local peek = options.peek
			or if perView == 1 and options.perView == nil then math.clamp(available * 0.1, 24, 56) else 0
		local extent = (available - peek - gap * (perView - 1) - (if peek > 0 then gap else 0)) / perView
		return math.max(1, math.floor(extent)), perView
	end
	local function fullSizes(use: ComposeTypes.Use): { [K]: number }
		local combined = table.clone(use(measured))
		for key, size in read(spec.measured or {}, use) do
			combined[key] = size
		end
		return combined
	end
	return {
		spec = spec,
		kind = kind,
		keyOf = keyOf,
		tree = tree,
		actionsWrapped = actionsWrapped,
		source = source,
		viewport = viewport,
		cross = cross,
		mountedVersion = mountedVersion,
		status = status,
		controls = controls,
		selection = selection,
		onlySelected = onlySelected,
		coordinator = coordinator,
		selectionMode = selectionMode,
		selectRow = selectRow,
		extendSelection = extendSelection,
		measured = measured,
		containsCards = containsCards,
		horizontal = horizontal,
		cardsMode = cardsMode,
		preferred = preferred,
		frames = frames,
		reduced = reduced,
		unit = unit,
		unitSize = unitSize,
		focusActive = focusActive,
		noFocusCandidates = noFocusCandidates,
		initialFollow = initialFollow,
		focusedPath = {},
		focusOwned = false,
		scope = nil,
		mounted = mounted,
		cellEdits = cellEdits,
		placed = placed,
		poolOwner = poolOwner,
		preparing = preparing,
		retiring = retiring,
		waiting = waiting,
		pool = pool,
		mainEdge = mainEdge,
		crossEdge = crossEdge,
		cardLayout = cardLayout,
		fullSizes = fullSizes,
	}
end
return { create = create, belongsTo = belongsTo, findSelectable = findSelectable }
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">collection_table</string>
              <string name="Source"><![CDATA[--!strict
local createTree = require("./collection_tree")
local ListTypes = require("./collections")
local layoutKit = require("./layout_kit")
local reorder = require("./collection_reorder")
local createMetrics = require("./collection_table_metrics")
local createColumns = require("./collection_table_columns")
local createHeader = require("./collection_table_header")
local createRows = require("./collection_table_rows")
local createToolbar = require("./collection_table_toolbar")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local CollectionTypes = require("./collection_types")
local tableEditors = require("./collection_table_editors")
local CollectionProps = require("./collection_props")
local ControlTypes = require("./control_types")

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, buildList: ListTypes.BuildList): ()
	local lists = layoutKit.of(ctx)
	local editors = tableEditors(ctx, UI)
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local read = ctx.read
	local D2, V2, E = ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local behavior = {
		"children",
		"expanded",
		"onExpansionChange",
		"indent",
		"from",
		"selectionFrom",
		"selectionIndicator",
		"focusPolicy",
		"initialFocus",
		"autoFocus",
		"wrapFocus",
		"maxRetained",
		"onReachEnd",
		"key",
		"columns",
		"itemSize",
		"gap",
		"overscan",
		"sort",
		"onSortChange",
		"widths",
		"onWidthsChange",
		"selection",
		"selectionMode",
		"onSelectionChange",
		"onActivate",
		"rowActions",
		"headerHeight",
		"status",
		"controls",
		"focus",
		"disabled",
		"measure",
		"measured",
		"follow",
		"followThreshold",
		"reducedMotion",
		"reorderable",
		"collectionId",
		"drag",
		"drop",
		"rowDrop",
		"onReorder",
		"movable",
		"selectable",
		"editing",
		"scrolls",
		"mode",
		"snap",
		"header",
		"dragLabel",
		"autoscroll",
		"onCellChange",
		"alternatingRows",
		"deletable",
		"rowDeletable",
		"onDelete",
	}
	local function create<V, K>(spec: CollectionTypes.TableShape<V, K>, keyOf: (V, number) -> K): Frame
		assert(spec.columns ~= nil, "Facet.Table requires columns")
		local manageable = spec.reorderable == true or spec.deletable == true
		local ownsToggle = manageable and spec.editing == nil and spec.header ~= false
		local editing: Types.ValueBoolean? = if ownsToggle then Compose.cell(false) else spec.editing
		local rowPolicySpec = table.clone(spec)
		rowPolicySpec.editing = editing
		Compose.watch(function(use: ComposeTypes.Use)
			editors.check(read(spec.columns, use), spec.onCellChange)
		end)
		local sort: ComposeTypes.Cell<CollectionTypes.Sort?> = spec.sort or Compose.cell(nil :: CollectionTypes.Sort?)
		local widths: ComposeTypes.Cell<{ [string]: number }> = spec.widths or Compose.cell({})
		local selection: ComposeTypes.Cell<CollectionTypes.Selection<K>> = spec.selection or Compose.cell({})
		local emptyStatus: ComposeTypes.OrderedCollectionStatus = {
			mode = "windowed",
			direction = "vertical",
			total = 0,
			retained = 0,
			first = 0,
			last = 0,
			firstRow = 0,
			lastRow = 0,
			rowCount = 0,
			extent = 0,
			following = false,
			measured = 0,
		}
		local status = (
			spec.status or Compose.cell(emptyStatus)
		) :: ComposeTypes.Cell<ComposeTypes.OrderedCollectionStatus>
		if status:peek() == nil then
			status:set(emptyStatus)
		end
		local contentExtent = Compose.formula(function(use: ComposeTypes.Use): number
			local current = use(status)
			return if current then current.extent else 0
		end)
		local coordinator: ComposeTypes.Cell<{}?> = Compose.cell(nil :: {}?)
		local queries: ComposeTypes.OrderedCollectionControls<K> = spec.controls or {}
		local body: ScrollingFrame
		local unitScale = Compose.cell(1)
		local rowMeasures: ComposeTypes.Cell<{ [K]: number }> = Compose.cell({})
		local actionGutters: ComposeTypes.Cell<{ [K]: number }> = Compose.cell({})
		local headerMeasures: ComposeTypes.Cell<{ [string]: number }> = Compose.cell({})
		local truncatedRows: ComposeTypes.Cell<{ [K]: { [string]: boolean } }> = Compose.cell({})
		local metrics = createMetrics(ctx, spec, ownsToggle, unitScale, headerMeasures)
		local minimumRow, toolbarHeight, headerHeight = metrics.minimumRow, metrics.toolbarHeight, metrics.headerHeight
		local topHeight, textInsets = metrics.topHeight, metrics.textInsets
		local function field(item: V, column: CollectionTypes.TableColumn<V, K>): unknown
			if column.value then
				return column.value(item)
			end
			if type(item) == "table" then
				return (item :: { [string]: unknown })[column.id]
			end
			return nil
		end
		local function sortRows(rows: { V }, use: ComposeTypes.Use): { V }
			local order = use(sort)
			if order == nil then
				return rows
			end
			local column: CollectionTypes.TableColumn<V, K>?
			for _, candidate in read(spec.columns, use) do
				if candidate.id == order.column then
					column = candidate
					break
				end
			end
			if column == nil then
				return rows
			end
			local indexed: { { item: V, index: number } } = table.create(#rows)
			for index, item in rows do
				indexed[index] = { item = item, index = index }
			end
			table.sort(indexed, function(a, b)
				local left = field(a.item, assert(column))
				local right = field(b.item, assert(column))
				if left == right then
					return a.index < b.index
				end
				local before
				if left == nil then
					before = true
				elseif right == nil then
					before = false
				elseif type(left) == "number" and type(right) == "number" then
					before = left < right
				else
					before = tostring(left) < tostring(right)
				end
				return if order.direction == "descending" then not before else before
			end)
			local result: { V } = table.create(#rows)
			for index, entry in indexed do
				result[index] = entry.item
			end
			return result
		end
		local tree = if spec.children then createTree(ctx, UI, spec, keyOf, sortRows) else nil
		if tree then
			tree.columnar = true
		end
		local ordered = if tree
			then tree.from
			else Compose.formula(function(use: ComposeTypes.Use): { V }
				return sortRows(read(spec.from, use), use)
			end)
		Compose.watch(function(use: ComposeTypes.Use)
			local valid: { [K]: boolean } = {}
			for index, item in read(if tree then tree.all else spec.from, use) do
				valid[keyOf(item, index)] = true
			end
			local sizes: { [K]: number } = {}
			local changed = false
			for key, height in rowMeasures:peek() do
				if valid[key] then
					sizes[key] = height
				else
					changed = true
				end
			end
			if changed then
				rowMeasures:set(sizes)
			end
		end)
		local layout = createColumns(ctx, spec, widths, truncatedRows, metrics.touchRows)
		local viewportWidth, narrowest, disclosureWidth = layout.viewportWidth, layout.narrowest, layout.disclosureWidth
		local headerCells = createHeader(ctx, UI, spec, sort, widths, headerMeasures, metrics, layout)
		local editor: reorder.Editor<V, K>? = nil
		local function reorderGutter(use: ComposeTypes.Use): number
			return if editor then use(editor.leading) else 0
		end
		local function trailingGutter(use: ComposeTypes.Use): number
			local gutter = 0
			for _, width in use(actionGutters) do
				gutter = math.max(gutter, width)
			end
			return (if editor then use(editor.trailing) else 0) + gutter
		end
		local window = Compose.cell(V2.zero)
		local scrolledX = Compose.cell(0)
		local function laneWidth(use: ComposeTypes.Use): number?
			local width = use(window).X
			return if width > 0
				then math.max(use(narrowest), width - reorderGutter(use) - trailingGutter(use) - use(disclosureWidth))
				else nil
		end
		local headerLayout = lists.list({}, false)
		local headerProps: Types.FrameProps = {
			Name = "Header",
			BackgroundTransparency = 1,
			Visible = spec.header ~= false,
			Size = function(use: ComposeTypes.Use)
				return D2.new(1, 0, 0, use(headerHeight))
			end,
			headerLayout :: ComposeTypes.Child,
			headerCells,
		}
		local header = Host.Frame(headerProps)
		local headerExtent = ctx.observe.AbsoluteContentSize(headerLayout)
		local selectable = (
			spec.selectionMode or (if spec.selection or spec.onSelectionChange then "single" else "none")
		) ~= "none"
		if spec.drag or spec.drop or manageable or (spec.editing ~= nil and selectable) then
			editor = reorder(ctx, UI, spec, ordered, keyOf, queries, function()
				return body
			end, selection, sort, editing, false, if tree then tree.location else nil, true)
		end
		local bodySpec: CollectionProps.KeyedCollectionSpec<V, K> = {
			Name = "Body",
			Position = function(use: ComposeTypes.Use)
				return D2.fromOffset(0, use(topHeight))
			end,
			Size = function(use: ComposeTypes.Use)
				return if spec.scrolls == false
					then D2.new(1, 0, 0, use(contentExtent))
					else D2.new(1, 0, 1, -use(topHeight))
			end,
			ScrollingEnabled = spec.scrolls ~= false,
			ClipsDescendants = spec.scrolls ~= false,
			mode = if spec.scrolls == false then "all" :: ComposeTypes.OrderedCollectionMode else spec.mode,
			ScrollingDirection = E.ScrollingDirection.XY,
			CanvasSize = function(use: ComposeTypes.Use)
				return D2.fromOffset(
					use(headerExtent).X / use(unitScale)
						+ reorderGutter(use)
						+ trailingGutter(use)
						+ use(disclosureWidth),
					use(contentExtent)
				)
			end,
			from = ordered,
			key = keyOf,
			itemSize = minimumRow,
			gap = spec.gap,
			overscan = spec.overscan,
			status = status,
			controls = queries,
			focus = spec.focus,
			focusPolicy = spec.focusPolicy,
			initialFocus = spec.initialFocus,
			autoFocus = spec.autoFocus,
			wrapFocus = spec.wrapFocus,
			maxRetained = spec.maxRetained,
			onReachEnd = spec.onReachEnd,
			selectionFrom = spec.selectionFrom or (if tree then tree.all else nil),
			selectionIndicator = false,
			rowDrop = spec.rowDrop,
			disabled = spec.disabled,
			measure = spec.measure,
			measured = function(use: ComposeTypes.Use)
				local result = table.clone(use(rowMeasures))
				for key, height in result do
					result[key] = math.max(height, use(minimumRow))
				end
				local external: { [K]: number } = read(spec.measured or {}, use)
				for key, height in external do
					result[key] = height
				end
				return result
			end,
			follow = spec.follow,
			snap = spec.snap,
			reducedMotion = spec.reducedMotion,
			followThreshold = spec.followThreshold,
			selection = selection,
			selectionMode = spec.selectionMode,
			selectable = spec.selectable,
			onSelectionChange = spec.onSelectionChange,
			onActivate = function(item, key, input, clicks)
				if editor and spec.onActivate == nil and read(editing) ~= true and editor.pickUp(key, input) then
					return
				end
				if spec.onActivate then
					spec.onActivate(item, key, input, clicks)
				elseif tree then
					tree.toggle(key)
				end
			end,
			editing = editing,

			render = createRows(ctx, UI, {
				spec = spec,
				rowPolicySpec = rowPolicySpec,
				selection = selection,
				coordinator = coordinator,
				rowMeasures = rowMeasures,
				actionGutters = actionGutters,
				truncatedRows = truncatedRows,
				unitScale = unitScale,
				scrolledX = scrolledX,
				editors = editors,
				field = field,
				tree = tree,
				editor = editor,
				laneWidth = laneWidth,
				metrics = metrics,
				layout = layout,
			}),
		}
		local previousSort = sort:peek()
		body = buildList(bodySpec, tree, true, function(use: ComposeTypes.Use, viewport): number?
			local rows = read(ordered, use)
			local order = use(sort)
			if order == previousSort then
				return nil
			end
			for index, item in rows do
				if assert(queries.indexOfKey)(keyOf(item, index)) ~= index then
					return nil
				end
			end
			previousSort = order
			local selected = selection:peek()
			for index, item in rows do
				if selected[keyOf(item, index)] then
					local at = assert(queries.placementOf)(index)
					if at.offset < viewport.offset then
						return assert(queries.offsetOf)(index, "start", viewport.size)
					elseif at.offset + at.size > viewport.offset + viewport.size then
						return assert(queries.offsetOf)(index, "end", viewport.size)
					end
					return viewport.offset
				end
			end
			return 0
		end)
		local unit = Host.Frame({
			Name = "LayoutUnit",
			Size = D2.fromOffset(1, 1),
			BackgroundTransparency = 1,
			Visible = false,
		})
		local position, rendered = ctx.observe.CanvasPosition(body), ctx.observe.AbsoluteWindowSize(body)
		local unitSize = ctx.observe.AbsoluteSize(unit)
		Compose.watch(function(use: ComposeTypes.Use)
			local scale = use(unitSize).X
			unitScale:set(if scale > 0 then scale else 1)
			local size = use(rendered)
			window:set(if scale > 0 then size / scale else size)
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			use(position)
			viewportWidth:set(use(window).X - reorderGutter(use) - trailingGutter(use))
			coordinator:set(nil)
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			scrolledX:set(use(position).X / use(unitScale))
		end)
		runtime.decorate(header, {
			Position = function(use: ComposeTypes.Use)
				return D2.fromOffset(reorderGutter(use) - use(scrolledX), use(toolbarHeight))
			end,
			Size = function(use: ComposeTypes.Use)
				local lane = laneWidth(use)
				return if lane
					then D2.fromOffset(lane, use(headerHeight))
					else D2.new(
						1,
						-reorderGutter(use) - trailingGutter(use) - use(disclosureWidth),
						0,
						use(headerHeight)
					)
			end,
		})
		local root = ctx.styled(
			Host.Frame(ctx.props(spec, behavior, {
				Size = function(use: ComposeTypes.Use)
					return if spec.scrolls == false
						then D2.new(1, 0, 0, use(contentExtent) + use(topHeight))
						else D2.fromScale(1, 1)
				end,
				BackgroundTransparency = 1,
				ClipsDescendants = spec.scrolls ~= false,
				unit :: ComposeTypes.Child,
				textInsets :: ComposeTypes.Child,
				ctx.styled(
					Host.Frame({
						Name = "HeaderBand",
						Visible = spec.header ~= false,
						Position = function(use: ComposeTypes.Use)
							return D2.fromOffset(0, use(toolbarHeight))
						end,
						Size = function(use: ComposeTypes.Use)
							return D2.new(1, 0, 0, use(headerHeight))
						end,
					}),
					"TableHead"
				) :: ComposeTypes.Child,
				header,
				createToolbar(ctx, UI, spec, editing, editor, metrics),
				body,
				if editor then editor.overlay() else nil,
			})),
			"Table"
		)
		local function seedWindow()
			if body.AbsoluteWindowSize.X > 0 and body.AbsoluteWindowSize.Y > 0 then
				return
			end
			local parent: Instance? = root.Parent
			local scale = 1
			local ancestor: Instance? = root
			while ancestor do
				local transform = ancestor:FindFirstChildWhichIsA("UIScale")
				if transform then
					scale *= transform.Scale
				end
				ancestor = ancestor.Parent
			end
			while parent do
				if parent:IsA("GuiObject") and parent.AbsoluteSize.X > 0 and parent.AbsoluteSize.Y > 0 then
					local bounds, authored = parent.AbsoluteSize / math.max(scale, 0.001), root.Size
					unitScale:set(scale)
					window:set(
						V2.new(
							bounds.X * authored.X.Scale + authored.X.Offset,
							math.max(0, bounds.Y * authored.Y.Scale + authored.Y.Offset - topHeight:peek())
						)
					)
					return
				end
				parent = parent.Parent
			end
		end
		runtime.connect(root, "AncestryChanged", seedWindow)
		seedWindow()
		return root
	end
	local function constructor<V, K>(spec: CollectionProps.TableSpec<V, K>): Frame
		if spec.key == nil then
			return create((spec :: unknown) :: CollectionTypes.TableShape<V, V>, function(item: V, _index: number): V
				return item
			end)
		end
		local key: unknown = spec.key
		if type(key) == "string" then
			assert(key ~= "", "Facet UI.Table: key field must not be empty")
			local fieldSpec = (spec :: unknown) :: CollectionTypes.TableShape<V, string>
			return create(fieldSpec, function(item: V, _index: number): string
				return tostring(((item :: unknown) :: { [string]: unknown })[key])
			end)
		end
		assert(type(key) == "function", "Facet UI.Table: key must be a function or a field name")
		return create((spec :: unknown) :: CollectionTypes.TableShape<V, K>, (key :: unknown) :: (V, number) -> K)
	end
	local tableConstructor: ControlTypes.TableConstructor = ctx.construct("Table", constructor)
	UI.Table = tableConstructor
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">collection_table_columns</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local CollectionTypes = require("./collection_types")
export type Columns<V, K> = {
	viewportWidth: ComposeTypes.Cell<number>,
	setPrimaryMeasure: (K, number?) -> (),
	minimumOf: (CollectionTypes.TableColumn<V, K>) -> number,
	collapsed: ComposeTypes.Formula<{ [string]: boolean }>,
	disclosureWidth: ComposeTypes.Formula<number>,
	disclosureShare: ComposeTypes.Formula<number>,
	narrowest: ComposeTypes.Formula<number>,
	textWrap: (CollectionTypes.TableColumn<V, K>, ComposeTypes.Use) -> boolean,
	columnFrame: (
		ComposeTypes.Readable<CollectionTypes.TableColumn<V, K>>,
		ComposeTypes.Readable<number>,
		GuiObject,
		GuiObject?,
		GuiObject?
	) -> Frame,
}
return function<V, K>(
	ctx: Types.Context,
	spec: CollectionTypes.TableShape<V, K>,
	widths: ComposeTypes.Cell<{ [string]: number }>,
	truncatedRows: ComposeTypes.Cell<{ [K]: { [string]: boolean } }>,
	touchRows: (ComposeTypes.Use) -> boolean
): Columns<V, K>
	local Compose, Host = ctx.Compose, ctx.Host
	local read = ctx.read
	local readSource = ctx.readSource
	local D2, V2, E = ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local viewportWidth = Compose.cell(0)
	local primaryNatural = Compose.cell(0)
	local primaryMeasures: { [K]: number? } = {}
	local primaryCounts: { [number]: number? } = {}
	local function setPrimaryMeasure(key: K, width: number?)
		local before = primaryMeasures[key]
		if before == width then
			return
		end
		if before then
			local count = (primaryCounts[before] or 0) - 1
			primaryCounts[before] = if count > 0 then count else nil
		end
		primaryMeasures[key] = width
		if width then
			primaryCounts[width] = (primaryCounts[width] or 0) + 1
		end
		local largest = primaryNatural:peek()
		if width and width > largest then
			primaryNatural:set(width)
		elseif before == largest and primaryCounts[largest] == nil then
			largest = 0
			for measured in primaryCounts do
				largest = math.max(largest, measured)
			end
			primaryNatural:set(largest)
		end
	end
	local function minimumOf(column: CollectionTypes.TableColumn<V, K>): number
		return column.minWidth or 48
	end
	local function boundedWidth(column: CollectionTypes.TableColumn<V, K>, width: number): number
		return math.clamp(width, minimumOf(column), column.maxWidth or 1000000)
	end
	local collapsed = Compose.formula(function(use: ComposeTypes.Use)
		local columns, offer, resized = read(spec.columns, use), use(viewportWidth), readSource(widths, use)
		local hidden: { [string]: boolean } = {}
		local candidates: { { id: string, width: number, priority: number } } = {}
		local needed = 0
		for index, column in columns do
			local fixed = resized[column.id] or column.width
			local width = boundedWidth(column, fixed or minimumOf(column))
			needed += if index == 1 and fixed == nil
				then boundedWidth(column, math.max(width, use(primaryNatural)))
				else width
			if index > 1 and type(column.priority) == "number" then
				table.insert(candidates, { id = column.id, width = width, priority = column.priority })
			end
		end
		table.sort(candidates, function(a, b)
			return a.priority > b.priority
		end)
		if offer > 0 then
			for _, candidate in candidates do
				if needed <= offer then
					break
				end
				if next(hidden) == nil then
					offer -= 48
				end
				hidden[candidate.id] = true
				needed -= candidate.width
			end
		end
		return hidden
	end)
	local disclosureWidth = Compose.formula(function(use: ComposeTypes.Use)
		if next(use(collapsed)) ~= nil then
			return 48
		end
		for _, value in use(truncatedRows) do
			if next(value) ~= nil then
				return 48
			end
		end
		return 0
	end)
	local disclosureShare = Compose.formula(function(use: ComposeTypes.Use): number
		if next(use(collapsed)) ~= nil then
			return 0
		end
		local hidden, resized, flexible = use(collapsed), readSource(widths, use), 0
		for _, column in read(spec.columns, use) do
			if not hidden[column.id] and resized[column.id] == nil and column.width == nil then
				flexible += 1
			end
		end
		return if flexible > 0 then use(disclosureWidth) / flexible else 0
	end)
	local narrowest = Compose.formula(function(use: ComposeTypes.Use): number
		local hidden, resized, total = use(collapsed), readSource(widths, use), 0
		for _, column in read(spec.columns, use) do
			if not hidden[column.id] then
				total += boundedWidth(column, resized[column.id] or column.width or minimumOf(column))
			end
		end
		return total
	end)
	local function columnWidth(
		current: ComposeTypes.Readable<CollectionTypes.TableColumn<V, K>>,
		use: ComposeTypes.Use
	): number?
		local column = use(current)
		local fixed = readSource(widths, use)[column.id] or column.width
		return if fixed ~= nil then boundedWidth(column, fixed) else nil
	end
	local allocatedWidths = Compose.formula(function(use: ComposeTypes.Use): { [string]: number }
		local offer = use(viewportWidth)
		if offer <= 0 then
			return {}
		end
		local result: { [string]: number } = {}
		local flexible: { CollectionTypes.TableColumn<V, K> } = {}
		local lower, columns, hidden, resized = 0, read(spec.columns, use), use(collapsed), readSource(widths, use)
		for _, column in columns do
			if not hidden[column.id] then
				local fixed = resized[column.id] or column.width
				local width = boundedWidth(column, fixed or minimumOf(column))
				result[column.id] = width
				lower += width
				if fixed == nil then
					table.insert(flexible, column)
				end
			end
		end
		local remaining = math.floor(math.max(0, offer - use(disclosureWidth) - lower))
		local primary = columns[1]
		if primary and result[primary.id] and resized[primary.id] == nil and primary.width == nil then
			local extra = math.floor(
				math.min(
					remaining,
					math.max(0, math.min(primary.maxWidth or math.huge, use(primaryNatural)) - result[primary.id])
				)
			)
			result[primary.id] += extra
			remaining -= extra
		end
		while remaining > 0 and #flexible > 0 do
			local weight = 0
			for _, column in flexible do
				weight += 1 / (1 + math.max(0, if type(column.priority) == "number" then column.priority else 0))
			end
			local spent, nextFlexible = 0, {}
			for _, column in flexible do
				local share = remaining
					/ weight
					/ (1 + math.max(0, if type(column.priority) == "number" then column.priority else 0))
				local extra =
					math.floor(math.min(share, math.max(0, (column.maxWidth or math.huge) - result[column.id])))
				result[column.id] += extra
				spent += extra
				if result[column.id] < (column.maxWidth or math.huge) then
					table.insert(nextFlexible, column)
				end
			end
			if spent <= 0 then
				for _, column in nextFlexible do
					if result[column.id] + 1 <= (column.maxWidth or math.huge) then
						result[column.id] += 1
						spent = 1
						break
					end
				end
				if spent <= 0 then
					break
				end
			end
			remaining -= spent
			flexible = nextFlexible
		end
		return result
	end)
	local function textWrap(column: CollectionTypes.TableColumn<V, K>, use: ComposeTypes.Use): boolean
		local value = column.wrap
		assert(value == nil or type(value) == "boolean", "Facet.Table column.wrap must be a boolean")
		return if value == nil then touchRows(use) else value
	end
	local function columnFrame(
		current: ComposeTypes.Readable<CollectionTypes.TableColumn<V, K>>,
		index: ComposeTypes.Readable<number>,
		content: GuiObject,
		extra: GuiObject?,
		more: GuiObject?
	): Frame
		local nativeProps: Types.FrameProps = {
			Name = current:peek().id,
			Visible = function(use: ComposeTypes.Use)
				return not use(collapsed)[use(current).id]
			end,
			LayoutOrder = index,
			BackgroundTransparency = 1,
			Size = function(use: ComposeTypes.Use)
				return D2.new(0, use(allocatedWidths)[use(current).id] or columnWidth(current, use) or 0, 1, 0)
			end,
			Host.UISizeConstraint({
				MinSize = function(use: ComposeTypes.Use)
					return V2.new(minimumOf(use(current)), 0)
				end,
				MaxSize = function(use: ComposeTypes.Use)
					return V2.new(
						math.min(use(allocatedWidths)[use(current).id] or 1000000, use(current).maxWidth or 1000000),
						1000000
					)
				end,
			}) :: ComposeTypes.Child,
			Host.UIFlexItem({
				FlexMode = function(use: ComposeTypes.Use)
					return if columnWidth(current, use) == nil then E.UIFlexMode.Fill else E.UIFlexMode.None
				end,
			}),
			content,
			extra,
			more,
		}
		return Host.Frame(nativeProps)
	end
	return {
		viewportWidth = viewportWidth,
		setPrimaryMeasure = setPrimaryMeasure,
		minimumOf = minimumOf,
		collapsed = collapsed,
		disclosureWidth = disclosureWidth,
		disclosureShare = disclosureShare,
		narrowest = narrowest,
		textWrap = textWrap,
		columnFrame = columnFrame,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">collection_table_editors</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local CollectionTypes = require("./collection_types")
local activation = require("./activation")
local policy = require("./collection_policy")
local CollectionProps = require("./collection_props")
local ControlTypes = require("./control_types")
local InputProps = require("./input_props")
local NavigationProps = require("./navigation_props")
local EDITORS = { text = true, number = true, toggle = true, menu = true }
local SETTINGS = { "options", "min", "max", "step", "draft", "validate", "editLabel", "editable" }

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls)
	local Compose, read = ctx.Compose, ctx.read
	local D, D2, V2, E = ctx.types.UDim, ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local editors = {}
	local function build(spec: CollectionProps.CellEditorSpec): Frame
		assert(EDITORS[spec.editor], "Facet CellEditor: editor must be text, number, toggle or menu")
		assert(type(spec.onChange) == "function", "Facet CellEditor needs onChange")
		assert(spec.editor ~= "menu" or spec.options ~= nil, "Facet CellEditor: menu needs options")
		assert(
			spec.draft == nil or spec.editor == "text" or spec.editor == "number",
			"Facet CellEditor: only text and number accept a draft"
		)
		assert(
			spec.editing == nil or spec.editor == "text" or spec.editor == "number",
			"Facet CellEditor: only text and number accept editing"
		)
		local draft: ComposeTypes.Cell<CollectionTypes.CellDraft?> = spec.draft
			or Compose.cell(nil :: CollectionTypes.CellDraft?)
		local errorText = Compose.cell("")
		local editing: ComposeTypes.Cell<boolean> = spec.editing or Compose.cell(false)
		local alive = true
		Compose.cleanup(function()
			alive = false
		end)
		local function enabled(use: ComposeTypes.Use?): boolean
			return read(spec.enabled, use) ~= false and read(spec.busy, use) ~= true
		end
		local function value(use: ComposeTypes.Use?): unknown
			return read(spec.value, use)
		end
		local function text(current: unknown): string
			return if current == nil then "" else tostring(current)
		end
		local function parsed(current: CollectionTypes.CellDraft): unknown
			return if spec.editor == "number" then tonumber(current.text) else current.text
		end
		local function propose(nextValue: unknown)
			if not alive or not enabled() then
				return
			end
			local failure = if spec.validate then spec.validate(nextValue) else nil
			if failure then
				errorText:set(failure)
				local current = draft:peek()
				if current then
					local nextDraft = table.clone(current)
					nextDraft.error = failure
					draft:set(nextDraft)
				end
				return
			end
			errorText:set("")
			if nextValue ~= value() then
				spec.onChange(nextValue)
			end
			if value() == nextValue then
				draft:set(nil)
			elseif read(spec.busy) ~= true then
				errorText:set("Change not accepted. Try again or cancel.")
				local current = draft:peek()
				if current then
					local nextDraft = table.clone(current)
					nextDraft.error = errorText:peek()
					draft:set(nextDraft)
				end
			end
		end
		local child: GuiObject
		local display: TextLabel? = nil
		local fieldHeight: ComposeTypes.Readable<UDim2>? = nil
		if spec.editor == "toggle" then
			child = UI.Toggle(({
				Name = "Editor",
				presentation = "checkbox",
				appearance = "plain",
				label = "",
				name = spec.label,
				value = function(use: ComposeTypes.Use): boolean
					return value(use) == true
				end,
				onChange = propose,
				enabled = enabled,
			} :: unknown) :: InputProps.ToggleProps)
		elseif spec.editor == "menu" then
			local selected = Compose.cell(value())
			Compose.watch(function(use: ComposeTypes.Use)
				selected:set(value(use))
			end)
			child = UI.Picker(({
				Name = "Editor",
				style = "menu",
				appearance = "utility",
				options = spec.options,
				selected = selected,
				enabled = enabled,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
				onChanging = function(nextValue: unknown): boolean
					propose(nextValue)
					return false
				end,
			} :: unknown) :: NavigationProps.SinglePickerSpec<unknown>)
		else
			local input = Compose.cell("")
			local numeric = Compose.cell(tonumber(value()) or 0)
			Compose.watch(function(use: ComposeTypes.Use)
				local confirmed, current = value(use), use(draft)
				if current and parsed(current) == confirmed then
					draft:set(nil)
					current = nil
				end
				input:set(if current then current.text else text(confirmed))
				numeric:set(tonumber(confirmed) or 0)
				errorText:set(
					if current
						then current.error or (if current.original ~= confirmed
							then "Value changed elsewhere. Cancel to use the latest value."
							else "")
						else ""
				)
			end)
			local props = {
				Name = "Editor",
				appearance = "utility",
				controlSize = "compact",
				value = input,
				Attributes = { AccessibleLabel = spec.label or spec.editLabel or "Edit value" },
				readOnly = function(use: ComposeTypes.Use): boolean
					return not enabled(use)
				end,
				Selectable = enabled,
				Interactable = enabled,
				errorText = errorText,
				Visible = editing,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
				onChange = function(nextText: string)
					if not alive then
						return
					end
					input:set(nextText)
					local current = draft:peek()
					draft:set({ text = nextText, original = if current then current.original else value() })
				end,
				onCommit = propose,
				onCancel = function()
					draft:set(nil)
					errorText:set("")
					editing:set(false)
				end,
				FocusLost = function()
					if errorText:peek() == "" and read(spec.busy) ~= true then
						editing:set(false)
					end
				end,
				Focused = function()
					editing:set(true)
				end,
			}
			local inputKind = ctx.effectiveInput()
			fieldHeight = Compose.formula(function(use: ComposeTypes.Use)
				return D2.new(
					1,
					0,
					0,
					math.max(
						ctx.controlSize("compact", "height", use),
						ctx.controlSize("compact", "iconSize", use),
						if inputKind(use) == "KeyboardAndMouse"
							then 0
							else math.max(44, ctx.metric("targetSizes.minimum", use))
					)
				)
			end)
			do
				local hit: TextButton
				local function rowHit(): GuiObject?
					local parent: Instance? = hit.Parent
					while parent and not parent:IsA("LayerCollector") do
						local row = parent:FindFirstChild("RowHit")
						if row then
							return row :: GuiObject
						end
						parent = parent.Parent
					end
					return nil
				end
				local function activate(input: InputObject?, clicks: number?)
					if activation.consumed(input) then
						return
					end
					local row = rowHit()
					local service = ctx.config.userInputService
					local modified = false
					if service then
						for _, code in
							{
								E.KeyCode.LeftControl,
								E.KeyCode.RightControl,
								E.KeyCode.LeftMeta,
								E.KeyCode.RightMeta,
								E.KeyCode.LeftShift,
								E.KeyCode.RightShift,
							}
						do
							modified = modified or service:IsKeyDown(code)
						end
					end
					if
						not modified
						and enabled()
						and (row == nil or (input and input.UserInputType == E.UserInputType.MouseButton1))
						and (row == nil or (clicks or 0) == 0)
						and (row == nil or row.Interactable)
						and (
							row == nil
							or row:GetAttribute("FacetSelectionRequired") == false
							or row:GetAttribute("FacetOnlySelected") == true
						)
					then
						editing:set(true)
					elseif row then
						activation.trigger(row, input, clicks)
					end
					activation.consume(input)
				end
				hit = ctx.Host.TextButton({
					Name = "EditLabel",
					Attributes = {
						AccessibleLabel = function(use: ComposeTypes.Use): string
							return read(spec.label or spec.editLabel or "Edit value", use)
						end,
					} :: Types.Attributes,
					Text = "",
					Size = D2.fromScale(1, 1),
					BackgroundTransparency = 1,
					AutoButtonColor = false,
					Selectable = false,
					Activated = function(input: InputObject?, clicks: number?)
						activate(input, math.max(0, (clicks or 1) - 1))
					end,
				})
				ctx.runtime.connect(hit, "AncestryChanged", function()
					hit.Selectable = rowHit() == nil
				end)
				Compose.cleanup(activation.provide(hit, function(input, clicks)
					activate(input :: InputObject?, clicks :: number?)
				end))
				display = ctx.styled(
					ctx.text({
						Name = "Value",
						Text = function(use: ComposeTypes.Use): string
							return text(value(use))
						end,
						Visible = function(use: ComposeTypes.Use): boolean
							return not use(editing)
						end,
						Size = function(use: ComposeTypes.Use)
							return D2.new(1, 0, 0, use(assert(fieldHeight)).Y.Offset)
						end,
						AutomaticSize = E.AutomaticSize.None,
						BackgroundTransparency = 1,
						TextWrapped = false,
						TextTruncate = E.TextTruncate.AtEnd,
						TextYAlignment = E.TextYAlignment.Center,
						ctx.Host.UIPadding {
							PaddingLeft = D.new(0, 10),
							PaddingRight = D.new(0, 10),
						} :: ComposeTypes.Child,
						hit,
					}),
					"Text"
				) :: TextLabel
				local initialized = Compose.cell(false)
				Compose.watch(function(use: ComposeTypes.Use)
					if use(editing) then
						initialized:set(true)
					end
				end)
				child = ctx.Host.Frame {
					Name = "EditorHost",
					BackgroundTransparency = 1,
					Size = D2.new(1, 0, 0, 0),
					AutomaticSize = E.AutomaticSize.Y,
					Visible = editing,
					Compose.show(initialized, function()
						local editor: GuiObject
						if spec.editor == "number" then
							local numberProps = (props :: unknown) :: InputProps.NumberInputCellProps
							numberProps.numericValue = numeric
							numberProps.min, numberProps.max, numberProps.step = spec.min, spec.max, spec.step
							editor = UI.NumberInput(numberProps)
						else
							editor = UI.TextInput((props :: unknown) :: InputProps.TextInputProps)
						end
						local field = (
							if editor:IsA("TextBox") then editor else editor:FindFirstChildWhichIsA("TextBox", true)
						) :: TextBox
						local function focus()
							if
								alive
								and editing:peek()
								and enabled()
								and field:FindFirstAncestorWhichIsA("LayerCollector")
								and policy.selectionVisible(field)
								and not field:IsFocused()
							then
								local gui, input = ctx.config.guiService, ctx.config.userInputService
								if gui and (input == nil or input.PreferredInput ~= E.PreferredInput.Touch) then
									gui.SelectedObject = field
								end
								field:CaptureFocus()
							end
						end
						local function requestFocus()
							if task and task.defer then
								task.defer(focus)
							else
								focus()
							end
						end
						local wasEditing = false
						Compose.watch(function(use: ComposeTypes.Use)
							local active = use(editing)
							if read(spec.enabled, use) == false and active then
								active = false
								editing:set(false)
							end
							if active then
								requestFocus()
							elseif field:IsFocused() then
								field:ReleaseFocus()
							end
							local gui = ctx.config.guiService
							if wasEditing and not active and gui then
								local selected = gui.SelectedObject
								if selected and (selected == field or selected:IsDescendantOf(editor)) then
									local target = rowHit() or hit
									gui.SelectedObject = if target.Selectable and policy.selectionVisible(target)
										then target
										else nil
								end
							end
							wasEditing = active
						end)
						ctx.runtime.connect(field, "AncestryChanged", requestFocus)
						local position = ctx.observe.AbsolutePosition(field)
						local size = ctx.observe.AbsoluteSize(field)
						Compose.watch(function(use: ComposeTypes.Use)
							use(position)
							use(size)
							if editing:peek() then
								requestFocus()
							end
						end)
						return editor
					end),
				}
			end
		end
		local defaults: Types.FrameProps = {
			Size = D2.new(1, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
			BackgroundTransparency = 1,
			child :: ComposeTypes.Child,
			display :: ComposeTypes.Child,
			if fieldHeight
				then ctx.Host.UISizeConstraint {
					Name = "FieldSize",
					MinSize = function(use: ComposeTypes.Use)
						return V2.new(0, use(assert(fieldHeight)).Y.Offset)
					end,
				}
				else nil,
		}
		local root = ctx.Host.Frame(ctx.props(spec, {
			"editor",
			"value",
			"onChange",
			"draft",
			"editing",
			"editLabel",
			"validate",
			"label",
			"enabled",
			"busy",
			"options",
			"min",
			"max",
			"step",
		}, defaults))
		if spec.editor == "text" or spec.editor == "number" then
			Compose.cleanup(activation.provideEdit(root, {
				label = spec.editLabel or "Edit value",
				enabled = enabled,
				onActivate = function()
					if enabled() then
						editing:set(true)
					end
				end,
			}))
		end
		return root
	end
	UI.CellEditor = ctx.construct("CellEditor", build)

	function editors.check<V, K>(columns: { CollectionTypes.TableColumn<V, K> }, onCellChange: unknown)
		for _, column in columns do
			assert(
				column.align == nil or column.align == "start" or column.align == "center" or column.align == "end",
				"Facet Table: align must be start, center or end"
			)
			local editor = column.editor
			if editor == nil then
				for _, setting in SETTINGS do
					assert(
						((column :: unknown) :: { [string]: unknown })[setting] == nil,
						`Facet UI.Table: column '{column.id}' sets {setting} without an editor`
					)
				end
				continue
			end
			assert(
				EDITORS[editor] and column.render == nil,
				`Facet UI.Table: column '{column.id}' editor must be text, number, toggle or menu, without render`
			)
			assert(
				editor ~= "menu" or type(column.options) == "table",
				`Facet UI.Table: menu column '{column.id}' needs options`
			)
			assert(type(onCellChange) == "function", "Facet UI.Table: an editor column needs onCellChange")
		end
	end

	function editors.render<V, K>(
		column: CollectionTypes.TableColumn<V, K>,
		raw: (V) -> unknown,
		onCellChange: (key: K, column: string, value: unknown) -> (),
		enabled: (ComposeTypes.Use) -> boolean
	): CollectionTypes.RowRender<V, K>
		return function(current: ComposeTypes.Readable<V>, _placement, key: K): GuiObject
			return UI.CellEditor {
				Name = "CellEditor",
				editor = assert(column.editor),
				label = column.label or column.id,
				editLabel = column.editLabel or function(use: ComposeTypes.Use): string
					return "Edit " .. read(column.label or column.id, use)
				end,
				value = function(use: ComposeTypes.Use): unknown
					return raw(use(current))
				end,
				onChange = function(nextValue: unknown)
					onCellChange(key, column.id, nextValue)
				end,
				draft = if column.draft then column.draft(key) else nil,
				validate = column.validate,
				enabled = function(use: ComposeTypes.Use): boolean
					return enabled(use) and policy.allows(column.editable, use(current))
				end,
				options = column.options,
				min = column.min,
				max = column.max,
				step = column.step,
			}
		end
	end
	return editors
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">collection_table_header</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local activation = require("./activation")
local scrollLock = require("./scroll_lock")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local CollectionTypes = require("./collection_types")
local InputProps = require("./input_props")
local Metrics = require("./collection_table_metrics")
local Columns = require("./collection_table_columns")
return function<V, K>(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	spec: CollectionTypes.TableShape<V, K>,
	sort: ComposeTypes.Cell<CollectionTypes.Sort?>,
	widths: ComposeTypes.Cell<{ [string]: number }>,
	headerMeasures: ComposeTypes.Cell<{ [string]: number }>,
	metrics: Metrics.Metrics,
	layout: Columns.Columns<V, K>
): ComposeTypes.Directive
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local read = ctx.read
	local readSource = ctx.readSource
	local D2, V2, E = ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local input, preferredInput = metrics.input, metrics.preferredInput
	local function setWidths(value: { [string]: number }): ()
		if spec.onWidthsChange then
			spec.onWidthsChange(value)
		else
			widths:set(value)
		end
	end
	local headerCells = Compose.keyed({
		from = function(use: ComposeTypes.Use)
			return read(spec.columns, use)
		end,
		key = function(column: CollectionTypes.TableColumn<V, K>)
			return column.id
		end,
		render = function(
			current: ComposeTypes.Readable<CollectionTypes.TableColumn<V, K>>,
			index: ComposeTypes.Readable<number>
		)
			local column = current:peek()
			local buttonProps: InputProps.ButtonProps = {
				Name = "Sort",
				Size = D2.fromScale(1, 1),
				AutomaticSize = E.AutomaticSize.None,
				TextXAlignment = function(use: ComposeTypes.Use)
					local align = use(current).align or "start"
					return if align == "end"
						then E.TextXAlignment.Right
						elseif align == "center" then E.TextXAlignment.Center
						else E.TextXAlignment.Left
				end,
				label = function(use: ComposeTypes.Use): string
					local value, order = use(current), readSource(sort, use)
					local suffix = if order and order.column == value.id
						then (if order.direction == "descending" then " ↓" else " ↑")
						else ""
					return tostring(read(value.label or value.id, use)) .. suffix
				end,
				enabled = function(use: ComposeTypes.Use): boolean
					return use(current).sortable ~= false
				end,
				onActivate = function()
					if column.sortable == false then
						return
					end
					local order = readSource(sort)
					local descending = order and order.column == column.id and order.direction == "ascending"
					local nextSort: CollectionTypes.Sort = {
						column = column.id,
						direction = if descending then "descending" else "ascending",
					}
					if spec.onSortChange then
						spec.onSortChange(nextSort)
					else
						sort:set(nextSort)
					end
				end,
			}
			local button = ctx.styled(UI.Button(buttonProps), "TableHeading")
			local frame: Frame
			local resizeUnit: ComposeTypes.Readable<number>
			local grip: TextButton?
			local minimum = Compose.formula(function(use)
				local value = use(current)
				return if value.width ~= nil then value.minWidth or 48 else layout.minimumOf(value)
			end)
			if column.resizable ~= false then
				local startingPosition, startingWidth = 0, 0
				local releaseScrollers: (() -> ())? = nil
				local function finishResize()
					if releaseScrollers then
						releaseScrollers()
						releaseScrollers = nil
					end
				end
				Compose.cleanup(finishResize)
				if input then
					runtime.connect(input, "WindowFocusReleased", finishResize)
				end
				local gripProps: Types.TextButtonProps = {
					Name = "Resize",
					Text = "",
					Attributes = {
						AccessibleLabel = (function(use: ComposeTypes.Use): string
							local value = use(current)
							return "Resize " .. tostring(read(value.label or value.id, use))
						end) :: Types.Value<Types.AttributeValue?>,
					},
					Selectable = function(use: ComposeTypes.Use)
						return not (preferredInput ~= nil and use(preferredInput) == E.PreferredInput.Gamepad)
					end,
					AnchorPoint = V2.new(0.5, 0),
					Position = D2.fromScale(1, 0),
					Size = function(use: ComposeTypes.Use)
						return D2.new(
							0,
							if preferredInput and use(preferredInput) == E.PreferredInput.Touch then 44 else 12,
							1,
							0
						)
					end,
					BackgroundTransparency = 1,
					ZIndex = 3,
					Host.UIDragDetector({
						Enabled = function(use: ComposeTypes.Use): boolean
							return not (preferredInput ~= nil and use(preferredInput) == E.PreferredInput.Gamepad)
						end,
						DragStyle = E.UIDragDetectorDragStyle.TranslateLine,
						DragAxis = V2.new(1, 0),
						ResponseStyle = E.UIDragDetectorResponseStyle.CustomOffset,
						DragStart = function(position)
							startingPosition, startingWidth = position.X, frame.AbsoluteSize.X / resizeUnit:peek()
							finishResize()
							releaseScrollers = scrollLock.holdOwnedAncestors(frame)
						end,
						DragContinue = function(position)
							local value = current:peek()
							local nextWidths = table.clone(readSource(widths))
							nextWidths[value.id] = math.clamp(
								startingWidth + (position.X - startingPosition) / resizeUnit:peek(),
								minimum:peek(),
								value.maxWidth or 1000000
							)
							setWidths(nextWidths)
						end,
						DragEnd = finishResize,
					}),
				}
				grip = Host.TextButton(gripProps)
			end
			frame = ctx.styled(layout.columnFrame(current, index, button, grip), "TableHeader")
			runtime.decorate(frame, {
				ZIndex = function(use: ComposeTypes.Use)
					return #read(spec.columns, use) - use(index) + 1
				end,
			})
			resizeUnit = ctx.layoutUnit(frame)
			Compose.cleanup((runtime.mount(function()
				return ctx.styled(
					Host.Frame({
						Name = "ColumnDivider",
						AnchorPoint = V2.new(0, 0.5),
						Position = D2.fromScale(0, 0.5),
						Size = function(use: ComposeTypes.Use)
							return D2.new(0, ctx.metric("strokes.hairline", use), 0.6, 0)
						end,
						Visible = function(use: ComposeTypes.Use)
							return use(index) > 1
						end,
						ZIndex = 2,
					}),
					"divider"
				)
			end, frame)))
			metrics.recordHeight(headerMeasures, column.id, button, 16)
			if grip then
				local selected = Compose.cell(false)
				runtime.connect(grip, "SelectionGained", function()
					selected:set(true)
				end)
				runtime.connect(grip, "SelectionLost", function()
					selected:set(false)
				end)
				local function adjust(delta: number): ()
					local value = current:peek()
					local nextWidths = table.clone(readSource(widths))
					nextWidths[value.id] = math.clamp(
						(nextWidths[value.id] or frame.AbsoluteSize.X / resizeUnit:peek()) + delta,
						minimum:peek(),
						value.maxWidth or 1000000
					)
					setWidths(nextWidths)
				end
				ctx.action(grip, "NarrowColumn", { E.KeyCode.Left, E.KeyCode.DPadLeft }, selected, function()
					adjust(-8)
				end, { priority = 300, capture = true })
				ctx.action(grip, "WidenColumn", { E.KeyCode.Right, E.KeyCode.DPadRight }, selected, function()
					adjust(8)
				end, { priority = 300, capture = true })
				local heading = Compose.cell(false)
				runtime.connect(button, "SelectionGained", function()
					heading:set(true)
				end)
				runtime.connect(button, "SelectionLost", function()
					heading:set(false)
				end)
				local function engaged(use: ComposeTypes.Use): boolean
					return use(selected) or use(heading)
				end
				ctx.action(grip, "NarrowColumnKey", { E.KeyCode.Comma, E.KeyCode.ButtonL1 }, engaged, function()
					adjust(-8)
				end, { priority = 300 })
				ctx.action(grip, "WidenColumnKey", { E.KeyCode.Period, E.KeyCode.ButtonR1 }, engaged, function()
					adjust(8)
				end, { priority = 300 })
				ctx.action(
					grip,
					"SortColumn",
					{ E.KeyCode.Up, E.KeyCode.Down, E.KeyCode.DPadUp, E.KeyCode.DPadDown },
					selected,
					function()
						activation.trigger(button)
					end,
					{ priority = 300, capture = true }
				)
				ctx.action(grip, "ReleaseColumn", { E.KeyCode.Escape, E.KeyCode.ButtonB }, selected, function()
					local gui = ctx.config.guiService
					if gui then
						gui.SelectedObject = button
					end
				end, { priority = 300 })
			end
			return frame
		end,
	})
	return headerCells
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">collection_table_metrics</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local CollectionTypes = require("./collection_types")
local CELL_PADDING = 16
export type Metrics = {
	cellPadding: number,
	input: UserInputService?,
	preferredInput: ComposeTypes.Readable<Enum.PreferredInput>?,
	touchRows: (ComposeTypes.Use) -> boolean,
	minimumRow: ComposeTypes.Formula<number>,
	toolbarShown: (ComposeTypes.Use) -> boolean,
	toolbarHeight: ComposeTypes.Formula<number>,
	headerHeight: ComposeTypes.Formula<number>,
	topHeight: ComposeTypes.Formula<number>,
	recordHeight: (ComposeTypes.Cell<{ [string]: number }>, string, TextLabel | TextButton, number) -> (),
	textInsets: TextLabel,
	textInsetSize: ComposeTypes.Cell<Vector2>,
}
return function<V, K>(
	ctx: Types.Context,
	spec: CollectionTypes.TableShape<V, K>,
	ownsToggle: boolean,
	unitScale: ComposeTypes.Cell<number>,
	headerMeasures: ComposeTypes.Cell<{ [string]: number }>
): Metrics
	local Compose = ctx.Compose
	local read = ctx.read
	local D2, E = ctx.types.UDim2, ctx.types.Enum
	local input = ctx.config.userInputService
	local preferredInput: ComposeTypes.Readable<Enum.PreferredInput>? = if input
		then ctx.observe.PreferredInput(input)
		else nil
	local tenFoot = ctx.tenFoot()
	local function touchRows(use: ComposeTypes.Use): boolean
		return preferredInput ~= nil and use(preferredInput) == E.PreferredInput.Touch
	end
	local function lineBox(use: ComposeTypes.Use): number
		return math.ceil(ctx.metric("typography.body.size", use) * ctx.metric("typography.body.lineHeight", use))
	end

	local minimumRow = Compose.formula(function(use: ComposeTypes.Use)
		if spec.itemSize ~= nil then
			return read(spec.itemSize, use)
		end
		if touchRows(use) then
			local lines = 1
			for _, column in read(spec.columns, use) do
				if column.render == nil and column.wrap ~= false then
					lines = 2
				end
			end
			return math.max(ctx.metric("targetSizes.minimum", use), lines * lineBox(use) + CELL_PADDING)
		end
		if tenFoot(use) then
			return math.max(ctx.controlSize("large", "height", use), lineBox(use) + CELL_PADDING)
		end
		local kind = if preferredInput then use(preferredInput) else nil
		return math.max(40, ctx.controlSize(nil, "height", use), if kind == E.PreferredInput.Gamepad then 44 else 0)
	end)
	local function coarse(use: ComposeTypes.Use): boolean
		local kind = if preferredInput then use(preferredInput) else nil
		return kind == E.PreferredInput.Touch or kind == E.PreferredInput.Gamepad
	end
	local mouse = if input then ctx.observe.MouseEnabled(input) else nil
	local keyboard = if input then ctx.observe.KeyboardEnabled(input) else nil
	local function toolbarShown(use: ComposeTypes.Use): boolean
		local keysOnly = spec.reorderable == true
			and keyboard ~= nil
			and use(keyboard) == true
			and mouse ~= nil
			and use(mouse) == false
		return ownsToggle and (coarse(use) or keysOnly)
	end
	local toolbarHeight = Compose.formula(function(use: ComposeTypes.Use)
		return if toolbarShown(use)
			then math.max(ctx.controlSize(nil, "height", use), 44) + ctx.metric("space.s", use)
			else 0
	end)
	local headerHeight = Compose.formula(function(use: ComposeTypes.Use)
		if spec.header == false then
			return 0
		end
		local size = read(spec.headerHeight, use) or 40
		if coarse(use) then
			size = math.max(size, 44)
		end
		for _, column in read(spec.columns, use) do
			size = math.max(size, use(headerMeasures)[column.id] or 0)
		end
		return size
	end)
	local topHeight = Compose.formula(function(use: ComposeTypes.Use)
		return use(toolbarHeight) + use(headerHeight)
	end)
	local function recordHeight(
		cell: ComposeTypes.Cell<{ [string]: number }>,
		id: string,
		node: TextLabel | TextButton,
		extra: number
	): ()
		local observed: ComposeTypes.Readable<Vector2> = if node:IsA("TextLabel")
			then ctx.observe.TextBounds(node)
			else ctx.observe.TextBounds(node)
		Compose.watch(function(use: ComposeTypes.Use)
			local bounds = use(observed)
			local height = bounds.Y / use(unitScale) + extra
			if height > 0 and cell:peek()[id] ~= height then
				local nextHeights = table.clone(cell:peek())
				nextHeights[id] = height
				cell:set(nextHeights)
			end
		end)
	end
	local textInsets = ctx.styled(
		ctx.text({
			Name = "CellTextInsets",
			Text = "",
			TextTransparency = 1,
			Interactable = false,
			TextWrapped = false,
			TextTruncate = E.TextTruncate.None,
			Size = D2.fromOffset(0, 0),
			AutomaticSize = E.AutomaticSize.XY,
		}),
		"TableValue"
	)
	local textInsetSize = ctx.observe.AbsoluteSize(textInsets)
	return {
		cellPadding = CELL_PADDING,
		input = input,
		preferredInput = preferredInput,
		touchRows = touchRows,
		minimumRow = minimumRow,
		toolbarShown = toolbarShown,
		toolbarHeight = toolbarHeight,
		headerHeight = headerHeight,
		topHeight = topHeight,
		recordHeight = recordHeight,
		textInsets = textInsets,
		textInsetSize = textInsetSize,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">collection_table_rows</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local layoutKit = require("./layout_kit")
local reorder = require("./collection_reorder")
local policy = require("./collection_policy")
local activation = require("./activation")
local TreeTypes = require("./collection_tree")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local EngineTypes = require("./engine_types")
local CollectionTypes = require("./collection_types")
local Metrics = require("./collection_table_metrics")
local Columns = require("./collection_table_columns")
export type Rows<V, K> = {
	spec: CollectionTypes.TableShape<V, K>,
	rowPolicySpec: CollectionTypes.TableShape<V, K>,
	selection: ComposeTypes.Cell<CollectionTypes.Selection<K>>,
	coordinator: ComposeTypes.Cell<{}?>,
	rowMeasures: ComposeTypes.Cell<{ [K]: number }>,
	actionGutters: ComposeTypes.Cell<{ [K]: number }>,
	truncatedRows: ComposeTypes.Cell<{ [K]: { [string]: boolean } }>,
	unitScale: ComposeTypes.Cell<number>,
	scrolledX: ComposeTypes.Cell<number>,
	editors: {
		render: <Item, Key>(
			CollectionTypes.TableColumn<Item, Key>,
			(Item) -> unknown,
			(Key, string, unknown) -> (),
			(ComposeTypes.Use) -> boolean
		) -> CollectionTypes.RowRender<Item, Key>,
	},
	field: (V, CollectionTypes.TableColumn<V, K>) -> unknown,
	tree: TreeTypes.Tree<V, K>?,
	editor: reorder.Editor<V, K>?,
	laneWidth: (ComposeTypes.Use) -> number?,
	metrics: Metrics.Metrics,
	layout: Columns.Columns<V, K>,
}
return function<V, K>(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	shared: Rows<V, K>
): CollectionTypes.RowRender<V, K>
	local lists = layoutKit.of(ctx)
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local read = ctx.read
	local D2, E = ctx.types.UDim2, ctx.types.Enum
	local spec, rowPolicySpec, selection, coordinator =
		shared.spec, shared.rowPolicySpec, shared.selection, shared.coordinator
	local rowMeasures, actionGutters, truncatedRows = shared.rowMeasures, shared.actionGutters, shared.truncatedRows
	local unitScale, scrolledX, editors, field = shared.unitScale, shared.scrolledX, shared.editors, shared.field
	local tree, editor, laneWidth = shared.tree, shared.editor, shared.laneWidth
	local metrics, layout = shared.metrics, shared.layout
	local CELL_PADDING, minimumRow = metrics.cellPadding, metrics.minimumRow
	local collapsed, disclosureWidth = layout.collapsed, layout.disclosureWidth
	local setPrimaryMeasure = layout.setPrimaryMeasure
	return function(
		current: ComposeTypes.Readable<V>,
		placement: ComposeTypes.Readable<ComposeTypes.Placement>,
		key: K
	): GuiObject
		local cellHeights: ComposeTypes.Cell<{ [string]: number }> = Compose.cell({})
		local truncated: ComposeTypes.Cell<{ [string]: boolean }> = Compose.cell({})
		Compose.cleanup(function()
			if truncatedRows:peek()[key] == nil then
				return
			end
			local rows = table.clone(truncatedRows:peek())
			rows[key] = nil
			truncatedRows:set(rows)
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			local height = use(minimumRow)
			local sizes, hidden = use(cellHeights), use(collapsed)
			for _, column in read(spec.columns, use) do
				if not hidden[column.id] then
					height = math.max(height, sizes[column.id] or 0)
				end
			end
			if (height > use(minimumRow) or rowMeasures:peek()[key] ~= nil) and rowMeasures:peek()[key] ~= height then
				local nextHeights = table.clone(rowMeasures:peek())
				nextHeights[key] = height
				rowMeasures:set(nextHeights)
			end
		end)
		local rowProps: Types.FrameProps = {
			Name = "Row",
			Size = D2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Attributes = {
				FacetSelected = function(use: ComposeTypes.Use)
					return read(selection, use)[key] == true
				end,
			} :: EngineTypes.Attributes,
			lists.list({}, false) :: ComposeTypes.Child,
			Compose.keyed({
				from = function(use: ComposeTypes.Use)
					return read(spec.columns, use)
				end,
				key = function(column: CollectionTypes.TableColumn<V, K>)
					return column.id
				end,
				render = function(
					column: ComposeTypes.Readable<CollectionTypes.TableColumn<V, K>>,
					index: ComposeTypes.Readable<number>
				)
					local definition = column:peek()
					local render: CollectionTypes.RowRender<V, K>? = definition.render
						or if definition.editor
							then editors.render(
								definition,
								function(item: V): unknown
									return field(item, definition)
								end,
								assert(spec.onCellChange),
								function(use: ComposeTypes.Use): boolean
									return not policy.disabled(spec.disabled, use(current))
								end
							)
							else nil
					local function valueText(use: ComposeTypes.Use): string
						local result = field(use(current), use(column))
						return if result == nil then "" else tostring(result)
					end
					local function words(use: ComposeTypes.Use): string
						local lines: { string } = {}
						for word in string.gmatch(valueText(use), "%S+") do
							table.insert(lines, word)
						end
						return table.concat(lines, "\n")
					end
					local function probe(
						name: string,
						text: (ComposeTypes.Use) -> string,
						share: boolean,
						lines: (ComposeTypes.Use) -> boolean
					): TextLabel
						return ctx.styled(
							ctx.text({
								Name = name,
								TextWrapped = false,
								TextTransparency = 1,
								Interactable = false,
								Size = function(use: ComposeTypes.Use)
									return D2.new(
										1,
										if share then use(layout.disclosureShare) else 0,
										if lines(use) then 0 else 1,
										0
									)
								end,
								AutomaticSize = function(use: ComposeTypes.Use)
									return if lines(use) then E.AutomaticSize.Y else E.AutomaticSize.None
								end,
								Text = text,
							}),
							"TableValue"
						)
					end
					local longestWord = if render
						then nil
						else probe("LongestWord", words, false, function()
							return true
						end)
					local undisclosed = if render
						then nil
						else probe("Undisclosed", function(use: ComposeTypes.Use): string
							return valueText(use)
						end, true, metrics.touchRows)
					local wordFits = if longestWord then ctx.observe.TextFits(longestWord) else nil
					local custom = render
					local content: GuiObject = if custom
						then ctx.styled(
							Host.Frame "Inset" {
								BackgroundTransparency = 1,
								custom(current, placement, key) :: ComposeTypes.Child,
								Host.UIListLayout {
									FillDirection = E.FillDirection.Vertical,
									VerticalAlignment = E.VerticalAlignment.Center,
									SortOrder = E.SortOrder.LayoutOrder,
								} :: ComposeTypes.Child,
							},
							"TableCellInset"
						)
						elseif render then render(current, placement, key)
						else ctx.styled(
							ctx.text({
								Name = "Value",
								TextXAlignment = function(use: ComposeTypes.Use)
									local align = use(column).align or "start"
									return if align == "end"
										then E.TextXAlignment.Right
										elseif align == "center" then E.TextXAlignment.Center
										else E.TextXAlignment.Left
								end,
								TextTruncate = E.TextTruncate.AtEnd,
								TextWrapped = function(use: ComposeTypes.Use): boolean
									return layout.textWrap(use(column), use) and use(assert(wordFits)) ~= false
								end,
								Size = D2.fromScale(1, 1),
								AutomaticSize = E.AutomaticSize.None,
								Text = valueText,
							}),
							"TableValue"
						)
					if render then
						local measured = if custom then content:GetChildren()[1] :: GuiObject else content
						local size = ctx.observe.AbsoluteSize(measured)
						local automatic = ctx.observe.AutomaticSize(measured)
						local authored = ctx.observe.Size(measured)
						Compose.watch(function(use: ComposeTypes.Use)
							local sizing = use(automatic)
							if
								sizing == E.AutomaticSize.Y
								or sizing == E.AutomaticSize.XY
								or use(authored).Y.Scale == 0
							then
								local height = use(size).Y / use(unitScale) + CELL_PADDING
								if height > 0 and cellHeights:peek()[definition.id] ~= height then
									local nextHeights = table.clone(cellHeights:peek())
									nextHeights[definition.id] = height
									cellHeights:set(nextHeights)
								end
							end
						end)
					end
					if not render and index:peek() == 1 then
						local natural = ctx.observe.TextBounds(assert(undisclosed))
						Compose.watch(function(use: ComposeTypes.Use)
							local padding = content:FindFirstChildWhichIsA("UIPadding")
							local inset = if padding
								then (padding:GetStyled("PaddingLeft") :: UDim).Offset + (padding:GetStyled(
									"PaddingRight"
								) :: UDim).Offset
								else math.max(CELL_PADDING, use(metrics.textInsetSize).X / use(unitScale))
							setPrimaryMeasure(key, math.ceil(use(natural).X / use(unitScale)) + inset)
						end)
						Compose.cleanup(function()
							setPrimaryMeasure(key, nil)
						end)
					end
					if not render then
						metrics.recordHeight(cellHeights, definition.id, content :: TextLabel, CELL_PADDING)
						local fits = ctx.observe.TextFits(assert(undisclosed))
						Compose.watch(function(use: ComposeTypes.Use)
							local id = use(column).id
							local hidden = use(fits) == false
							if (truncated:peek()[id] == true) ~= hidden then
								local cells = table.clone(truncated:peek())
								if hidden then
									cells[id] = true
								else
									cells[id] = nil
								end
								truncated:set(cells)
								local rows = table.clone(truncatedRows:peek())
								if next(cells) then
									rows[key] = cells
								else
									rows[key] = nil
								end
								truncatedRows:set(rows)
							end
						end)
					end
					if tree and index:peek() == 1 then
						content = tree.wrap(content, current, key)
						local outlineSize = ctx.observe.AbsoluteSize(content)
						Compose.watch(function(use: ComposeTypes.Use)
							local sizes = table.clone(cellHeights:peek())
							sizes[definition.id] = use(outlineSize).Y / use(unitScale)
							cellHeights:set(sizes)
						end)
					end
					local cell =
						ctx.styled(layout.columnFrame(column, index, content, longestWord, undisclosed), "TableCell")
					cell.ClipsDescendants = true
					return cell
				end,
			}),
		}
		local row = Host.Frame(rowProps)
		runtime.decorate(row, {
			Size = function(use: ComposeTypes.Use)
				local lane = laneWidth(use)
				return if lane then D2.new(0, lane, 1, 0) else D2.new(1, -use(disclosureWidth), 1, 0)
			end,
			Position = function(use: ComposeTypes.Use)
				return D2.fromOffset(-use(scrolledX), 0)
			end,
		})
		local cellRow = row
		local rowProps: Types.FrameProps = {
			Name = "DisclosingRow",
			Size = D2.fromScale(1, 1),
			ClipsDescendants = true,
			cellRow :: ComposeTypes.Child,
			Compose.show(function(use: ComposeTypes.Use)
				return use(disclosureWidth) > 0
			end, function()
				local open = Compose.cell(false)
				return UI.Popover {
					isPresented = open,
					onPresentedChange = function(value: boolean)
						open:set(value)
					end,
					trigger = UI.Button "Details" {
						icon = "status.info",
						name = "Show details",
						appearance = "utility",
						Size = D2.new(0, 48, 1, 0),
						Position = D2.new(1, -48, 0, 0),
						AutomaticSize = E.AutomaticSize.None,
					} :: GuiButton,
					content = function(): Instance
						return ctx.column({
							Compose.keyed({
								from = function(use: ComposeTypes.Use)
									local hidden, result = use(collapsed), {}
									for _, column in read(spec.columns, use) do
										if hidden[column.id] or use(truncated)[column.id] then
											table.insert(result, column)
										end
									end
									return result
								end,
								key = function(column: CollectionTypes.TableColumn<V, K>)
									return column.id
								end,
								render = function(
									column: ComposeTypes.Readable<CollectionTypes.TableColumn<V, K>>,
									index: ComposeTypes.Readable<number>
								)
									return ctx.column({
										ctx.text({
											Text = function(use: ComposeTypes.Use)
												return tostring(use(column).label or use(column).id)
											end,
										}),
										if column:peek().detailRender
											then (assert(column:peek().detailRender))(current, placement, key)
											else ctx.text({
												Name = "FullValue",
												TextWrapped = true,
												Size = D2.new(1, 0, 0, 0),
												AutomaticSize = E.AutomaticSize.Y,
												Text = function(use: ComposeTypes.Use)
													local value, item = use(column), use(current)
													local result = if value.value
														then value.value(item)
														else field(item, value)
													return if result == nil then "" else tostring(result)
												end,
											}),
									}, {
										Name = column:peek().id,
										LayoutOrder = index,
										Size = D2.new(1, 0, 0, 0),
										AutomaticSize = E.AutomaticSize.Y,
									})
								end,
							}),
						}, { Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
					end,
				}
			end),
		}
		if editor then
			rowProps.BackgroundTransparency = 1
		end
		row = Host.Frame(rowProps)
		local disclosing = row
		row = policy.actions(ctx, rowPolicySpec, current, key, row, UI.RowActions, coordinator) :: Frame
		local actionButton = row:FindFirstChild("CellActions")
		if actionButton and actionButton:IsA("GuiObject") then
			local visible = ctx.observe.Visible(actionButton)
			local size = ctx.observe.AbsoluteSize(actionButton)
			Compose.watch(function(use: ComposeTypes.Use)
				local width = if use(visible) then use(size).X / use(unitScale) else 0
				if actionGutters:peek()[key] ~= width then
					local gutters = table.clone(actionGutters:peek())
					gutters[key] = width
					actionGutters:set(gutters)
				end
			end)
			Compose.cleanup(function()
				local gutters = table.clone(actionGutters:peek())
				gutters[key] = nil
				actionGutters:set(gutters)
			end)
		end
		if editor then
			row = editor.wrap(row, current, key, true)
		end
		local painted = ctx.styled(if editor then row else disclosing, "TableRow")
		runtime.decorate(painted, {
			Position = function(use: ComposeTypes.Use)
				return D2.fromOffset(use(scrolledX), 0)
			end,
		})
		Compose.watch(function(use: ComposeTypes.Use)
			if read(spec.alternatingRows, use) == true and use(placement).index % 2 == 0 then
				painted:AddTag("facet-tablerow-alternate")
			elseif painted:HasTag("facet-tablerow-alternate") then
				painted:RemoveTag("facet-tablerow-alternate")
			end
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			local on = read(selection, use)[key] == true
			if on ~= painted:HasTag("facet-selected") then
				if on then
					painted:AddTag("facet-selected")
				else
					painted:RemoveTag("facet-selected")
				end
			end
		end)
		if editor then
			local press = editor.press
			Compose.cleanup(activation.providePress(row, function(value: InputObject)
				press(key, value)
			end))
		end
		return row
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">collection_table_toolbar</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local motion = require("./motion")
local reorder = require("./collection_reorder")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local CollectionTypes = require("./collection_types")
local InputTypes = require("./input_types")
local Metrics = require("./collection_table_metrics")
return function<V, K>(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	spec: CollectionTypes.TableShape<V, K>,
	editing: Types.ValueBoolean?,
	editor: reorder.Editor<V, K>?,
	metrics: Metrics.Metrics
): ComposeTypes.Directive
	local Host, runtime = ctx.Host, ctx.runtime
	local read = ctx.read
	local D2, V2, E = ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local preferredInput = metrics.preferredInput
	return ctx.Compose.show(metrics.toolbarShown, function()
		local progress = runtime.tween(function(use: ComposeTypes.Use): number
			return if read(editing, use) then 1 else 0
		end, {
			seconds = function(use: ComposeTypes.Use): number
				local timing = ctx.motionTiming("reveal", use)
				return if read(editing, use) then timing.enter else timing.exit
			end,
			ease = ctx.motionEase("fade"),
			reducedMotion = motion.reduced(ctx),
		})
		local function fraction(use: ComposeTypes.Use): number
			return math.clamp(use(progress), 0, 1)
		end
		local button = UI.Button("Edit")({
			label = function(use: ComposeTypes.Use): string
				return if read(editing, use) then "Done" else "Edit"
			end,
			AnchorPoint = V2.new(1, 0),
			Position = D2.fromScale(1, 0),
			Size = D2.new(0, 0, 1, 0),
			AutomaticSize = E.AutomaticSize.X,
			onActivate = function()
				local cell = (editing :: unknown) :: ComposeTypes.Cell<boolean>
				cell:set(not cell:peek())
			end,
		})
		local font, size = ctx.observeStyled.FontFace(button), ctx.observeStyled.TextSize(button)

		runtime.decorate(button, { TextTransparency = 1 })
		local function hideLabel(node: Instance)
			if node:IsA("TextLabel") and (node.Name == "Label" or node.Name == "Title") then
				node.TextTransparency = 1
			end
		end
		for _, node in button:GetDescendants() do
			hideLabel(node)
		end
		runtime.connect(button, "DescendantAdded", hideLabel)
		local function caption(word: string): TextLabel
			return ctx.styled(
				ctx.text({
					Name = word .. "Caption",
					Text = word,
					FontFace = font,
					TextSize = size,
					TextColor3 = ctx.observeStyled.TextColor3(button),
					TextXAlignment = E.TextXAlignment.Center,
					TextTransparency = function(use: ComposeTypes.Use)
						return if word == "Edit" then fraction(use) else 1 - fraction(use)
					end,
					Size = D2.fromScale(1, 1),
					AutomaticSize = E.AutomaticSize.None,
					Interactable = false,
				}),
				"button-caption"
			)
		end
		runtime.mountFragment(function()
			return { caption("Edit"), caption("Done") }
		end, button)
		local function reserve(word: string): TextLabel
			return ctx.text({
				Name = word,
				Text = word,
				TextTransparency = 1,
				FontFace = font,
				TextSize = size,
			})
		end
		runtime.mount(function()
			return Host.Frame({
				Name = "WidthReserve",
				BackgroundTransparency = 1,
				AutomaticSize = E.AutomaticSize.XY,
				reserve("Edit") :: ComposeTypes.Child,
				reserve("Done"),
			})
		end, button)
		local words: { string } = {}
		if spec.deletable then
			table.insert(words, "X Delete")
		end
		if spec.reorderable then
			table.insert(words, "L1 / R1 Move")
		end
		local function pad(use: ComposeTypes.Use): boolean
			return preferredInput ~= nil and use(preferredInput) == E.PreferredInput.Gamepad
		end
		local remove = if spec.deletable and editor
			then UI.Button "DeleteSelected" {
				label = "Delete",
				role = "destructive" :: InputTypes.ButtonRole,
				Size = D2.new(0, 0, 1, 0),
				AutomaticSize = E.AutomaticSize.X,
				Visible = function(use: ComposeTypes.Use)
					return (read(editing, use) == true or fraction(use) > 0) and not pad(use)
				end,
				enabled = function(use: ComposeTypes.Use)
					return read(editing, use) == true and editor.canDeleteSelected(use)
				end,
				onActivate = editor.deleteSelected,
			}
			else nil
		return Host.Frame({
			Name = "Toolbar",
			BackgroundTransparency = 1,
			Size = function(use: ComposeTypes.Use)
				return D2.new(1, 0, 0, use(metrics.toolbarHeight) - ctx.metric("space.s", use))
			end,
			button :: ComposeTypes.Child,
			ctx.styled(
				ctx.text({
					Name = "PadHints",
					Text = table.concat(words, " · "),
					AnchorPoint = V2.new(0, 0.5),
					Position = D2.fromScale(0, 0.5),
					AutomaticSize = E.AutomaticSize.XY,
					Visible = function(use: ComposeTypes.Use)
						return read(editing, use) == true and pad(use)
					end,
				}),
				"secondary"
			),
			if remove
				then ctx.fade {
					Name = "DeleteFade",
					BackgroundTransparency = 1,
					Size = D2.new(0, 0, 1, 0),
					AutomaticSize = E.AutomaticSize.X,
					GroupTransparency = function(use: ComposeTypes.Use)
						return 1 - fraction(use)
					end,
					remove,
				}
				else nil,
		})
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">collection_tree</string>
              <string name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local Collections = require("./collection_types")
local motion = require("./motion")
local policy = require("./collection_policy")
local sessionOf = require("./drag_session")

type Node<V, K> = { item: V, key: K, parent: K?, depth: number, branch: boolean, visible: boolean }
type Snapshot<V, K> = {
	nodes: { Node<V, K> },
	byKey: { [K]: Node<V, K> },
	changing: { Node<V, K> },
	groups: { { Node<V, K> } },
	start: number,
	weights: { [K]: number },
}
export type Tree<V, K> = {
	from: ComposeTypes.Readable<{ V }>,
	all: ComposeTypes.Readable<{ V }>,
	columnar: boolean?,
	visible: (K, ComposeTypes.Use?) -> boolean,
	ancestor: (K) -> K?,
	sizes: (ComposeTypes.Use, { [K]: number }, number, number) -> { [K]: number },
	wrap: (GuiObject, ComposeTypes.Readable<V>, K) -> GuiObject,
	bind: (ScrollingFrame, Collections.FocusControls<K>) -> (),
	toggle: (K) -> (),
	location: ({ K }, number) -> (boolean, number, K?),
}

return function<V, K>(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	spec: Collections.HierarchyOptions<V, K> & Collections.OptionalChildren<V> & {
		from: Types.Value<{ V }>,
		disabled: Collections.RowPredicate<V>?,
		reducedMotion: Types.ValueBoolean?,
	},
	keyOf: (V, number) -> K,
	order: (({ V }, ComposeTypes.Use) -> { V })?
): Tree<V, K>
	local C, Host, runtime, read = ctx.Compose, ctx.Host, ctx.runtime, ctx.read
	local D2, V2, E = ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local expanded: ComposeTypes.Cell<Collections.Selection<K>> = spec.expanded
		or C.cell({} :: Collections.Selection<K>)
	assert(expanded.set, "Facet outline expanded requires a writable Compose cell")
	assert(type(spec.children) == "function" or type(spec.children) == "string", "Facet outline requires children")
	local reduced = motion.reduced(ctx)
	local timing = ctx.motionTiming("reveal")
	local inputKind = ctx.effectiveInput()
	local function targetFloor(use: ComposeTypes.Use?): number
		return if inputKind(use) == "KeyboardAndMouse" then 0 else ctx.metric("targetSizes.minimum", use)
	end
	local clockTarget = C.cell(0)
	local clock = runtime.tween(function(use: ComposeTypes.Use): number
		return use(clockTarget)
	end, {
		seconds = timing.enter,
		ease = ctx.motionEase("present"),
		reducedMotion = function(use: ComposeTypes.Use): boolean
			return reduced(use) or read(spec.reducedMotion, use) == true
		end,
	})
	local data =
		C.cell({ nodes = {}, byKey = {}, changing = {}, groups = {}, weights = {}, start = -1 } :: Snapshot<V, K>)
	local settled = C.formula(function(use: ComposeTypes.Use): boolean
		return reduced(use) or read(spec.reducedMotion, use) == true or use(clock) >= use(data).start + 1
	end)
	local animatedWeights = C.formula(function(use: ComposeTypes.Use): { [K]: number }
		local current = use(data)
		local result: { [K]: number } = {}
		if use(settled) then
			return result
		end
		local progress = math.clamp(use(clock) - current.start, 0, 1)
		for _, group in current.groups do
			local previous = 0
			for _, node in group do
				previous += current.weights[node.key] or 0
			end
			local destination = if group[1].visible then #group else 0
			local extent = previous + (destination - previous) * progress
			for index, node in group do
				result[node.key] = math.clamp(extent - index + 1, 0, 1)
			end
		end
		return result
	end)
	local function weight(key: K, use: ComposeTypes.Use?): number
		local current = if use then use(data) else data:peek()
		local node = current.byKey[key]
		if not node then
			return 0
		end
		local destination = if node.visible then 1 else 0
		local weights = read(animatedWeights, use)
		return if weights[key] ~= nil then weights[key] else destination
	end
	local initialized = false
	local priorExpanded = expanded:peek()
	C.watch(function(use: ComposeTypes.Use)
		local open = use(expanded)
		local expansionChanged = initialized and open ~= priorExpanded
		priorExpanded = open
		local nodes: { Node<V, K> }, byKey: { [K]: Node<V, K> } = {}, {}
		local function visit(items: { V }, parent: K?, depth: number, visible: boolean)
			local ordered: { V } = if order then order(items, use) else items
			for index, item in ordered do
				local key = keyOf(item, index)
				assert(key ~= nil and byKey[key] == nil, "Facet outline requires unique keys and an acyclic tree")
				local accessor = spec.children
				local children = if type(accessor) == "function"
					then accessor(item)
					else ((item :: unknown) :: { [string]: { V }? })[accessor :: string]
				assert(children == nil or type(children) == "table", "Facet outline children must be an array or nil")
				local node = {
					item = item,
					key = key,
					parent = parent,
					depth = depth,
					branch = children ~= nil,
					visible = visible,
				}
				byKey[key] = node
				table.insert(nodes, node)
				if children then
					visit(children, key, depth + 1, visible and open[key] == true)
				end
			end
		end
		visit(read(spec.from, use), nil, 0, true)
		local weights: { [K]: number } = {}
		local changing: { Node<V, K> } = {}
		local groups: { { Node<V, K> } } = {}
		local group: { Node<V, K> }? = nil
		for _, node in nodes do
			weights[node.key] = if expansionChanged and data:peek().byKey[node.key] ~= nil
				then weight(node.key)
				else if node.visible then 1 else 0
			if weights[node.key] ~= (if node.visible then 1 else 0) then
				table.insert(changing, node)
				if group == nil or group[1].visible ~= node.visible then
					local nextGroup: { Node<V, K> } = {}
					group = nextGroup
					table.insert(groups, nextGroup)
				end
				table.insert(assert(group), node)
			else
				group = nil
			end
		end
		local start = if #changing > 0 then clock:peek() else -1

		data:set({
			nodes = nodes,
			byKey = byKey,
			changing = changing,
			groups = groups,
			weights = weights,
			start = start,
		})
		if #changing > 0 then
			clockTarget:set(start + 1)
		end
		initialized = true
	end)
	local function change(key: K, value: boolean)
		local node = data:peek().byKey[key]
		if not node or not node.branch or policy.disabled(spec.disabled, node.item) then
			return
		end
		local nextOpen = table.clone(expanded:peek())
		if value then
			nextOpen[key] = true
		else
			nextOpen[key] = nil
		end
		if spec.onExpansionChange then
			spec.onExpansionChange(nextOpen)
		else
			expanded:set(nextOpen)
		end
	end
	local locatedSnapshot: Snapshot<V, K>? = nil
	local locatedRows: { V }? = nil
	local locatedKeys: { K }? = nil
	local remainingKeys: { K } = {}
	local siblingSlots: { [K]: number } = {}
	local remainingSiblings = 0
	local tree: Tree<V, K>
	tree = {
		from = C.formula(function(use: ComposeTypes.Use): { V }
			local rows = {}
			local snapshot, weights = use(data), use(animatedWeights)
			for _, node in snapshot.nodes do
				if if weights[node.key] ~= nil then weights[node.key] > 0 else node.visible then
					table.insert(rows, node.item)
				end
			end
			return rows
		end),
		all = C.formula(function(use: ComposeTypes.Use): { V }
			local rows = {}
			for _, node in use(data).nodes do
				table.insert(rows, node.item)
			end
			return rows
		end),
		visible = function(key: K, use: ComposeTypes.Use?): boolean
			local snapshot = if use then use(data) else data:peek()
			local node = snapshot.byKey[key]
			return node ~= nil and node.visible
		end,
		ancestor = function(key: K): K?
			local snapshot = data:peek()
			local node: Node<V, K>? = snapshot.byKey[key]
			if not node or node.visible then
				return nil
			end
			while node and not node.visible do
				node = if node.parent ~= nil then snapshot.byKey[node.parent] else nil
			end
			return if node then node.key else nil
		end,
		sizes = function(use: ComposeTypes.Use, sizes: { [K]: number }, minimum: number, gap: number): { [K]: number }
			local result = {}
			local snapshot = use(data)
			for key, size in sizes do
				if snapshot.byKey[key] and snapshot.byKey[key].visible then
					result[key] = math.max(minimum, size) + gap
				end
			end
			if gap > 0 then
				for _, node in snapshot.nodes do
					if node.visible and result[node.key] == nil then
						result[node.key] = minimum + gap
					end
				end
			end
			if not use(settled) then
				for _, node in snapshot.changing do
					result[node.key] = (math.max(minimum, sizes[node.key] or minimum) + gap) * weight(node.key, use)
				end
			end
			return result
		end,
		toggle = function(key: K)
			change(key, expanded:peek()[key] ~= true)
		end,
		location = function(keys: { K }, slot: number): (boolean, number, K?)
			local snapshot = data:peek()
			local first = snapshot.byKey[keys[1]]
			if not first then
				return false, 0, nil
			end
			local parent, carried = first.parent, {}
			for _, key in keys do
				local node = snapshot.byKey[key]
				if not node or node.parent ~= parent then
					return false, 0, nil
				end
				carried[key] = true
			end
			local rows = tree.from:peek()
			if snapshot ~= locatedSnapshot or rows ~= locatedRows or keys ~= locatedKeys then
				locatedSnapshot, locatedRows, locatedKeys = snapshot, rows, keys
				remainingKeys, siblingSlots, remainingSiblings = {}, {}, 0
				for _, item in rows do
					local key = keyOf(item, 1)
					if not carried[key] then
						table.insert(remainingKeys, key)
					end
				end
				for _, node in snapshot.nodes do
					siblingSlots[node.key] = remainingSiblings
					if node.parent == parent and not carried[node.key] then
						remainingSiblings += 1
					end
				end
			end
			local remaining = remainingKeys
			local before = remaining[slot + 1]
			local target = if before ~= nil then snapshot.byKey[before] else nil
			if target == nil or target.parent ~= parent then
				if target and target.depth > first.depth then
					return false, 0, nil
				end
				local previousKey = remaining[slot]
				local previous = if previousKey ~= nil then snapshot.byKey[previousKey] else nil
				while previous and previous.key ~= parent and previous.parent ~= parent do
					previous = if previous.parent ~= nil then snapshot.byKey[previous.parent] else nil
				end
				if parent ~= nil and previous == nil then
					return false, 0, nil
				end
			end
			return true, if before ~= nil then siblingSlots[before] else remainingSiblings, parent
		end,
		wrap = function(content: GuiObject, current: ComposeTypes.Readable<V>, key: K): GuiObject
			local natural, authored, automatic =
				ctx.observe.AbsoluteSize(content), ctx.observe.Size(content), ctx.observe.AutomaticSize(content)
			local unit = Host.Frame { Name = "OutlineUnit", Size = D2.fromOffset(1, 1), Visible = false }
			local unitSize = ctx.observe.AbsoluteSize(unit)
			local function scale(use: ComposeTypes.Use): number
				return if use(unitSize).X > 0 then use(unitSize).X else 1
			end
			local function side(use: ComposeTypes.Use): number
				return math.max(ctx.controlSize("compact", "height", use), targetFloor(use))
			end

			local width = C.cell(0)
			local function left(use: ComposeTypes.Use): number
				local node = use(data).byKey[key]
				local step = read(spec.indent, use) or ctx.metric("space.l", use)
				assert(step >= 0 and step < math.huge, "Facet outline indent must be a finite non-negative number")
				return ctx.metric("space.s", use)
					+ math.min((if node then node.depth else 0) * step, math.max(0, use(width) - side(use) * 3))
			end
			local disclosure = C.show(function(use: ComposeTypes.Use): boolean
				local node = use(data).byKey[key]
				return node ~= nil and node.branch
			end, function()
				local angle = runtime.tween(function(use: ComposeTypes.Use): number
					return if use(expanded)[key] then 90 else 0
				end, {
					seconds = timing.enter,
					ease = ctx.motionEase("present"),
					reducedMotion = function(use: ComposeTypes.Use): boolean
						return reduced(use) or read(spec.reducedMotion, use) == true
					end,
				})
				local button = UI.Button {
					Name = "Disclosure",
					name = function(use: ComposeTypes.Use): string
						return if use(expanded)[key] then "Collapse" else "Expand"
					end,
					controlSize = "compact" :: "compact",
					icon = "chevron.trailing",
					appearance = "utility",
					Visible = function(use: ComposeTypes.Use): boolean
						local node = use(data).byKey[key]
						return node ~= nil and node.branch
					end,
					enabled = function(use: ComposeTypes.Use): boolean
						return tree.visible(key, use) and not policy.disabled(spec.disabled, use(current))
					end,
					onActivate = function()
						tree.toggle(key)
					end,
				}
				local caret = button:FindFirstChild("Content")
				if caret and caret:IsA("GuiObject") then
					runtime.decorate(caret, { Rotation = angle })
				end
				runtime.decorate(button, {
					AutomaticSize = E.AutomaticSize.None,
					AnchorPoint = V2.new(0, 0.5),
					Position = function(use: ComposeTypes.Use): UDim2
						return D2.new(0, left(use), 0.5, 0)
					end,
					Size = function(use: ComposeTypes.Use): UDim2
						local size = math.max(ctx.controlSize("compact", "height", use), targetFloor(use))
						return D2.fromOffset(size, size)
					end,
				})
				return button
			end)
			local root = Host.Frame {
				Name = "OutlineRow",
				AnchorPoint = V2.new(0, 0.5),
				Position = D2.fromScale(0, 0.5),
				BackgroundTransparency = 1,
				ClipsDescendants = true,
				Size = function(use: ComposeTypes.Use): UDim2
					local auto, size = use(automatic), use(authored)
					local height = if auto == E.AutomaticSize.Y
							or auto == E.AutomaticSize.XY
							or size.Y.Scale == 0
						then use(natural).Y / scale(use)
						else 0
					return D2.new(
						1,
						0,
						0,
						math.max(side(use), height) + ctx.metric("space.xs", use) + ctx.metric("space.xs", use)
					)
				end,
				disclosure :: ComposeTypes.Child,
				unit :: ComposeTypes.Child,
				Host.Frame {
					Name = "OutlineContent",
					BackgroundTransparency = 1,
					ClipsDescendants = true,
					Position = function(use: ComposeTypes.Use): UDim2
						return D2.fromOffset(left(use) + side(use), ctx.metric("space.xs", use))
					end,
					Size = function(use: ComposeTypes.Use): UDim2
						return D2.new(
							1,
							-left(use) - side(use) - ctx.metric("space.s", use),
							1,
							-ctx.metric("space.xs", use) - ctx.metric("space.xs", use)
						)
					end,
					Host.UIListLayout {
						FillDirection = E.FillDirection.Vertical,
						VerticalAlignment = E.VerticalAlignment.Center,
						SortOrder = E.SortOrder.LayoutOrder,
					} :: ComposeTypes.Child,
					content :: ComposeTypes.Child,
				},
			}
			local bounds = ctx.observe.AbsoluteSize(root)
			C.watch(function(use: ComposeTypes.Use)
				width:set(use(bounds).X / scale(use))
				local node = use(data).byKey[key]
				root:SetAttribute("FacetOutlineDepth", if node then node.depth else 0)
				root:SetAttribute("FacetExpanded", use(expanded)[key] == true)
			end)
			return root
		end,
		bind = function(root: ScrollingFrame, controls: Collections.FocusControls<K>)
			local gui = ctx.config.guiService
			local selected = if gui then ctx.observe.SelectedObject(gui) else C.cell(nil :: GuiObject?)
			local drag = sessionOf(ctx)
			local function enabled(use: ComposeTypes.Use): boolean
				local selected = use(selected)
				local session = use(drag.state)
				return (session == nil or (session.mode == "armed" and not session.pending))
					and selected ~= nil
					and selected:IsDescendantOf(root)
					and (selected.Name == "RowHit" or selected.Name == "Disclosure")
			end
			local function current(use: ComposeTypes.Use): Node<V, K>?
				local key = if controls.current then use(controls.current) else nil
				return if key ~= nil then use(data).byKey[key] else nil
			end
			local function expands(use: ComposeTypes.Use): boolean
				local node = current(use)
				return enabled(use) and node ~= nil and node.branch == true
			end
			local function collapses(use: ComposeTypes.Use): boolean
				local node = current(use)
				return enabled(use)
					and node ~= nil
					and ((node.branch == true and use(expanded)[node.key] == true) or node.parent ~= nil)
			end
			ctx.action(root, "OutlineExpand", { E.KeyCode.Right, E.KeyCode.DPadRight }, expands, function()
				local key = controls.current and controls.current:peek()
				local node = if key ~= nil then data:peek().byKey[key] else nil
				if node and node.branch then
					if not expanded:peek()[node.key] then
						change(node.key, true)
					elseif controls.focus then
						for _, child in data:peek().nodes do
							if child.parent == node.key and not policy.disabled(spec.disabled, child.item) then
								controls.focus(child.key)
								break
							end
						end
					end
				end
			end, { priority = 300, capture = true })
			ctx.action(root, "OutlineCollapse", { E.KeyCode.Left, E.KeyCode.DPadLeft }, collapses, function()
				local key = controls.current and controls.current:peek()
				local node = if key ~= nil then data:peek().byKey[key] else nil
				if node then
					if node.branch and expanded:peek()[node.key] then
						change(node.key, false)
					elseif node.parent ~= nil and controls.focus then
						controls.focus(node.parent)
					end
				end
			end, { priority = 300, capture = true })
		end,
	}
	return tree
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">collection_types</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local Env = require("./environment_types")
local InputTypes = require("./input_types")

export type FocusControls<K> = {
	current: typeof(((nil :: unknown) :: ComposeTypes.FocusScope<K>).current)?,
	focus: typeof(((nil :: unknown) :: ComposeTypes.FocusScope<K>).focus)?,
	clear: typeof(((nil :: unknown) :: ComposeTypes.FocusScope<K>).clear)?,
	next: typeof(((nil :: unknown) :: ComposeTypes.FocusScope<K>).next)?,
	previous: typeof(((nil :: unknown) :: ComposeTypes.FocusScope<K>).previous)?,
	move: typeof(((nil :: unknown) :: ComposeTypes.FocusScope<K>).move)?,
	first: typeof(((nil :: unknown) :: ComposeTypes.FocusScope<K>).first)?,
	last: typeof(((nil :: unknown) :: ComposeTypes.FocusScope<K>).last)?,
	isFocused: typeof(((nil :: unknown) :: ComposeTypes.FocusScope<K>).isFocused)?,
}
export type SlotControls<K> = { nodeOfKey: ((K) -> GuiObject?)? }
export type Selection<K> = { [K]: boolean }
export type Children<V> = ((item: V) -> { V }?) | string
export type OptionalChildren<V> = { children: Children<V>? }
export type RequiredChildren<V> = { children: Children<V> }
export type HierarchyOptions<V, K> = {
	expanded: ComposeTypes.Cell<Selection<K>>?,
	onExpansionChange: ((expanded: Selection<K>) -> ())?,
	indent: Types.ValueNumber?,
}
export type Sort = { column: string, direction: "ascending" | "descending" }
export type RowPredicate<V> = (item: V) -> boolean
export type Follow = "end" | "none"
export type RowRender<V, K> = (
	current: ComposeTypes.Readable<V>,
	placement: ComposeTypes.Readable<ComposeTypes.Placement>,
	key: K
) -> GuiObject
export type SelectionOptions<V, K> = {
	selection: ComposeTypes.Cell<Selection<K>>?,
	selectionFrom: Types.Value<{ V }>?,
	selectionIndicator: boolean?,
	selectionMode: ("none" | "single" | "multiple")?,
	selectable: RowPredicate<V>?,
	disabled: RowPredicate<V>?,
	onSelectionChange: ((selection: Selection<K>) -> ())?,
	editing: Types.ValueBoolean?,
}
export type ReorderOptions<V, K> = {
	collectionId: unknown?,
	drag: ((items: { V }, keys: { K }) -> Env.DraggableSpec)?,
	drop: Env.DropTargetSpec?,
	rowDrop: ((ComposeTypes.Readable<V>, K) -> Env.DropTargetSpec?)?,
	reorderable: boolean?,
	movable: RowPredicate<V>?,
	onReorder: ((keys: { K }, slot: number, parentKey: K?) -> ())?,
	deletable: boolean?,
	rowDeletable: RowPredicate<V>?,
	onDelete: ((keys: { K }) -> ())?,
	dragLabel: ((item: V) -> string)?,
	autoscroll: boolean?,
	direction: ComposeTypes.OrderedCollectionDirection?,
}
export type Activate<V, K> = (item: V, key: K, input: InputObject?, clickCount: number?) -> ()
export type CollectionOptions<V, K> = {
	from: Types.Value<{ V }>,
	slots: Types.Value<{ K }>?,
	slotControls: SlotControls<K>?,
	render: RowRender<V, K>,
	mode: ComposeTypes.OrderedCollectionMode?,
	itemSize: (Types.ValueNumber | "cards")?,
	cards: { perView: number?, minWidth: number?, peek: number? }?,
	gap: Types.ValueNumber?,
	crossGap: Types.ValueNumber?,
	columns: Types.ValueNumber?,
	minColumnWidth: Types.ValueNumber?,
	rowActions: ((current: ComposeTypes.Readable<V>, key: K) -> RowActionsShape?)?,
	overscan: number?,
	measured: Types.Value<{ [K]: number }>?,
	measure: boolean?,
	status: (
		ComposeTypes.Cell<ComposeTypes.OrderedCollectionStatus>
		| ComposeTypes.Cell<ComposeTypes.OrderedCollectionStatus?>
	)?,
	controls: ComposeTypes.OrderedCollectionControls<K>?,
	follow: Types.Value<Follow>?,
	followThreshold: number?,
	scrollReset: Types.Value<string>?,
	maxRetained: number?,
	focus: FocusControls<K>?,
	focusPolicy: ("key" | "index")?,
	initialFocus: K?,
	autoFocus: boolean?,
	wrapFocus: boolean?,
	snap: ("none" | "item")?,
	reducedMotion: Types.ValueBoolean?,
	onActivate: Activate<V, K>?,
	onReachEnd: (() -> ())?,
	contentOverflow: Types.Value<"visible" | "clip">?,
}
export type Keyed<V, K> = { key: ((item: V, index: number) -> K) | string }
export type Identity = { key: nil? }

export type RowAction = {
	id: string,
	label: Types.ValueString,
	icon: Types.ValueString?,
	role: InputTypes.ButtonRole?,
	enabled: Types.ValueBoolean?,
	onActivate: (() -> ())?,
}
export type RowEdge = "leading" | "trailing"
export type RowActionsFields = {
	actionPlacement: ("trailing" | "bottom")?,
	swipeEnabled: Types.ValueBoolean?,
	leading: Types.Value<{ RowAction }>?,
	trailing: Types.Value<{ RowAction }>?,
	actionWidth: Types.ValueNumber?,
	fullSwipe: (boolean | { leading: boolean?, trailing: boolean? })?,
	open: ComposeTypes.Cell<RowEdge?>?,
	onOpenChange: ((edge: RowEdge?) -> ())?,
	coordinator: ComposeTypes.Cell<{}?>?,
	enabled: Types.ValueBoolean?,
	reducedMotion: Types.ValueBoolean?,
	editing: Types.ValueBoolean?,
}
export type RowActionsShape = Types.FrameProps & RowActionsFields
export type RowActionsContent = { content: Types.GuiInstance | (() -> GuiObject) }
export type CellDraft = { text: string, original: unknown, error: string? }
export type CellEditorOptions = {
	editor: "text" | "number" | "toggle" | "menu",
	value: Types.Value<unknown>,
	onChange: (unknown) -> (),
	draft: ComposeTypes.Cell<CellDraft?>?,
	editing: ComposeTypes.Cell<boolean>?,
	editLabel: Types.ValueString?,
	validate: ((unknown) -> string?)?,
	label: Types.ValueString?,
	enabled: Types.ValueBoolean?,
	busy: Types.ValueBoolean?,
	options: { { value: unknown, label: Types.ValueString } }?,
	min: number?,
	max: number?,
	step: number?,
}
export type TableColumn<V, K> = {
	id: string,
	label: Types.ValueString?,
	width: number?,
	minWidth: number?,
	maxWidth: number?,
	priority: (number | "always")?,
	resizable: boolean?,
	sortable: boolean?,
	value: ((item: V) -> unknown)?,
	align: ("start" | "center" | "end")?,
	wrap: boolean?,
	draft: ((key: K) -> ComposeTypes.Cell<CellDraft?>)?,
	editLabel: Types.ValueString?,
	editable: ((item: V) -> boolean)?,
	validate: ((value: unknown) -> string?)?,
	render: RowRender<V, K>?,
	detailRender: RowRender<V, K>?,
	editor: ("text" | "number" | "toggle" | "menu")?,
	options: { { value: unknown, label: Types.ValueString } }?,
	min: number?,
	max: number?,
	step: number?,
}
export type TableOptions<V, K> = {
	focusPolicy: ("key" | "index")?,
	initialFocus: K?,
	autoFocus: boolean?,
	wrapFocus: boolean?,
	maxRetained: number?,
	onReachEnd: (() -> ())?,
	from: Types.Value<{ V }>,
	columns: Types.Value<{ TableColumn<V, K> }>,
	itemSize: Types.ValueNumber?,
	gap: Types.ValueNumber?,
	overscan: number?,
	sort: ComposeTypes.Cell<Sort?>?,
	onSortChange: ((sort: Sort) -> ())?,
	widths: ComposeTypes.Cell<{ [string]: number }>?,
	onWidthsChange: ((widths: { [string]: number }) -> ())?,
	onActivate: Activate<V, K>?,
	rowActions: ((current: ComposeTypes.Readable<V>, key: K) -> RowActionsShape?)?,
	headerHeight: Types.ValueNumber?,
	header: boolean?,
	status: (
		ComposeTypes.Cell<ComposeTypes.OrderedCollectionStatus>
		| ComposeTypes.Cell<ComposeTypes.OrderedCollectionStatus?>
	)?,
	controls: ComposeTypes.OrderedCollectionControls<K>?,
	focus: FocusControls<K>?,
	measure: boolean?,
	measured: Types.Value<{ [K]: number }>?,
	follow: Types.Value<Follow>?,
	followThreshold: number?,
	reducedMotion: Types.ValueBoolean?,
	onCellChange: ((key: K, column: string, value: unknown) -> ())?,
	alternatingRows: Types.ValueBoolean?,
	scrolls: boolean?,
	mode: ComposeTypes.OrderedCollectionMode?,
	snap: ("none" | "item")?,
}
export type ReorderShape<V, K> = SelectionOptions<V, K> & ReorderOptions<V, K>
export type CollectionShape<V, K> =
	Types.ScrollingFrameProps
	& SelectionOptions<V, K>
	& ReorderOptions<V, K>
	& HierarchyOptions<V, K>
	& OptionalChildren<V>
	& CollectionOptions<V, K>
export type TableShape<V, K> =
	Types.FrameProps
	& SelectionOptions<V, K>
	& ReorderOptions<V, K>
	& HierarchyOptions<V, K>
	& OptionalChildren<V>
	& TableOptions<V, K>
return {}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">collections</string>
              <string name="Source"><![CDATA[--!strict
local createTree = require("./collection_tree")
local TreeTypes = require("./collection_tree")
local State = require("./collection_state")
local createSlots = require("./collection_slots")
local createRows = require("./collection_rows")
local attachFling = require("./collection_fling")
local createFocus = require("./collection_focus")
local bindNavigation = require("./collection_navigation")
local scrollLock = require("./scroll_lock")
local initialScroll = require("./scroll_initial")
local reorder = require("./collection_reorder")
local attachSnap = require("./collection_snap")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local EngineTypes = require("./engine_types")
local CollectionTypes = require("./collection_types")
local CollectionProps = require("./collection_props")
local ControlTypes = require("./control_types")

export type ScrollPolicy = (ComposeTypes.Use, ComposeTypes.OrderedCollectionViewport) -> number?

export type BuildList = <V, K>(
	CollectionProps.KeyedCollectionSpec<V, K>,
	TreeTypes.Tree<V, K>?,
	boolean?,
	ScrollPolicy?
) -> ScrollingFrame

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls): BuildList
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local read = ctx.read
	local observe = ctx.observe
	local D2, V2, E = ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local behavior = {
		"children",
		"expanded",
		"onExpansionChange",
		"indent",
		"from",
		"slots",
		"slotControls",
		"selectionFrom",
		"selectionIndicator",
		"minColumnWidth",
		"rowActions",
		"key",
		"render",
		"contentOverflow",
		"mode",
		"snap",
		"reducedMotion",
		"direction",
		"itemSize",
		"cards",
		"gap",
		"crossGap",
		"columns",
		"overscan",
		"measured",
		"measure",
		"status",
		"controls",
		"follow",
		"followThreshold",
		"scrollReset",
		"maxRetained",
		"focus",
		"initialFocus",
		"focusPolicy",
		"autoFocus",
		"wrapFocus",
		"disabled",
		"selection",
		"selectionMode",
		"selectable",
		"reorderable",
		"collectionId",
		"drag",
		"drop",
		"rowDrop",
		"onReorder",
		"movable",
		"deletable",
		"rowDeletable",
		"onDelete",
		"editing",
		"dragLabel",
		"autoscroll",
		"onSelectionChange",
		"onActivate",
		"onReachEnd",
	}
	local function collection<V, K>(
		spec: CollectionTypes.CollectionShape<V, K>,
		kind: ComposeTypes.OrderedCollectionLayoutKind,
		keyOf: (V, number) -> K,
		tree: TreeTypes.Tree<V, K>?,
		actionsWrapped: boolean?,
		scrollPolicy: ScrollPolicy?
	): ScrollingFrame
		assert(
			spec.contentOverflow == nil or table.find({ "visible", "clip" }, read(spec.contentOverflow)),
			"Facet collection contentOverflow must be visible or clip"
		)
		assert(
			spec.snap == nil or spec.snap == "none" or spec.snap == "item",
			"Facet collection snap must be none or item"
		)
		assert(type(spec.render) == "function", "Facet collection requires render(current, placement, key)")
		tree = tree or (if spec.children then createTree(ctx, UI, spec, keyOf) else nil)
		if tree then
			assert(kind == "list" and spec.direction ~= "horizontal", "Facet hierarchy needs a vertical list")
			spec = table.clone(spec)
			spec.selectionFrom = spec.selectionFrom or tree.all
			spec.focus = spec.focus or {}
			local hierarchy = tree
			spec.onActivate = spec.onActivate or function(_item, key)
				hierarchy.toggle(key)
			end
		end
		local source = function(use: ComposeTypes.Use): { V }
			return read(if tree then tree.from else spec.from, use)
		end
		local view = State.create(ctx, spec, kind, keyOf, tree, actionsWrapped, source)
		local viewport, cross, status, controls = view.viewport, view.cross, view.status, view.controls
		local measured, horizontal = view.measured, view.horizontal
		local retiring = view.retiring
		local mainEdge, crossEdge = view.mainEdge, view.crossEdge
		local root: ScrollingFrame
		local writingOffset = false
		local function setOffset(requested: number): ()
			local edge = mainEdge()
			local offset = requested
			if edge > 0 then
				local current, box = status:peek(), viewport:peek()
				local last = if current and current.extent then current.extent - box.size else math.huge
				offset = if requested <= 0 then 0 elseif requested >= last then math.max(0, last) else requested + edge
			end
			local position = root.CanvasPosition
			local nextPosition = if horizontal then V2.new(offset, position.Y) else V2.new(position.X, offset)
			if position ~= nextPosition then
				writingOffset = true
				root.CanvasPosition = nextPosition
				writingOffset = false
			end
		end
		local editor: reorder.Editor<V, K>?
		editor = if spec.drag
				or spec.drop
				or spec.reorderable
				or spec.deletable
				or (spec.editing ~= nil and view.selectionMode ~= "none" and spec.selectionIndicator ~= false)
			then reorder(
				ctx,
				UI,
				spec,
				source,
				keyOf,
				controls,
				function()
					return root
				end,
				view.selection,
				Compose.cell(nil :: CollectionTypes.Sort?),
				spec.editing,
				kind == "grid",
				if tree then tree.location else nil,
				nil,
				spec.slots
			)
			else nil
		local overlayReorder = if editor then editor.overlay else nil
		local slots = createSlots(ctx, view)
		local orderedRows = createRows(ctx, UI, view, editor, slots)
		local function followOf(use: ComposeTypes.Use?): CollectionTypes.Follow
			local value = read(spec.follow, use)
			assert(value == nil or value == "end" or value == "none", "Facet collection follow must be none or end")
			return if value == "end" then "end" else "none"
		end
		local directive = if Compose.isReadable(spec.follow) or type(spec.follow) == "function"
			then Compose.switch(followOf, {
				none = function()
					return orderedRows("none")
				end,
				["end"] = function()
					return orderedRows("end")
				end,
			})
			else orderedRows(followOf())
		local contentExtent = Compose.formula(function(use: ComposeTypes.Use): number
			local current = use(status)
			local extent = if current and current.extent then current.extent else 0
			return if extent > 0 then extent + 2 * mainEdge(use) else 0
		end)
		local native = ctx.props(spec, behavior, {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = D2.fromScale(1, 1),
			AutomaticCanvasSize = E.AutomaticSize.None,
			ScrollingDirection = if horizontal then E.ScrollingDirection.X else E.ScrollingDirection.Y,
			VerticalScrollBarInset = if horizontal then E.ScrollBarInset.ScrollBar else nil,
			ScrollBarThickness = 6,
			SelectionGroup = true,
			CanvasSize = function(use: ComposeTypes.Use)
				local extent = use(contentExtent)
				return if horizontal then D2.fromOffset(extent, 0) else D2.fromOffset(0, extent)
			end,
		})
		native[#native + 1] = Compose.show(function(use: ComposeTypes.Use)
			return spec.mode == "all" or use(viewport).size > 0
		end, function()
			local nativeProps: Types.FrameProps = {
				Name = "Items",
				BackgroundTransparency = 1,
				Size = D2.fromScale(1, 1),

				Attributes = { FacetDocumentOrder = true } :: EngineTypes.Attributes,
				directive,
			}
			if kind == "grid" then
				nativeProps[#nativeProps + 1] = Host.UIPadding({
					PaddingLeft = function(use: ComposeTypes.Use)
						return ctx.types.UDim.new(0, if horizontal then mainEdge(use) else crossEdge(use))
					end,
					PaddingRight = function(use: ComposeTypes.Use)
						return ctx.types.UDim.new(0, if horizontal then 0 else crossEdge(use))
					end,
					PaddingTop = function(use: ComposeTypes.Use)
						return ctx.types.UDim.new(0, if horizontal then crossEdge(use) else mainEdge(use))
					end,
					PaddingBottom = function(use: ComposeTypes.Use)
						return ctx.types.UDim.new(0, if horizontal then crossEdge(use) else 0)
					end,
				}) :: Types.Child
			end
			return Host.Frame(nativeProps)
		end)
		table.insert(native, view.unit)
		root = ctx.styled(Host.ScrollingFrame(native), "Collection")
		Compose.cleanup(function()
			for node, release in retiring do
				retiring[node] = nil
				release()
			end
		end)
		scrollLock.own(root, ctx)
		root:SetAttribute("FacetSelectionOwner", true)
		attachFling(ctx, view, root)
		if overlayReorder then
			runtime.mount(function()
				return overlayReorder(true)
			end, root)
		end
		local size: ComposeTypes.Cell<Vector2> = observe.AbsoluteWindowSize(root)
		local position: ComposeTypes.Cell<Vector2> = observe.CanvasPosition(root)
		local mountParent = observe.Parent(root)
		local ancestryVersion = Compose.cell(0)
		runtime.connect(root, "AncestryChanged", function()
			ancestryVersion:update(function(version: number): number
				return version + 1
			end)
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			local scale = use(view.unitSize).X
			local dimensions, at = use(size), use(position)
			use(ancestryVersion)
			local ancestor = use(mountParent)
			if dimensions.X <= 0 or dimensions.Y <= 0 then
				while ancestor do
					if ancestor:IsA("GuiObject") and ancestor.AbsoluteSize.X > 0 and ancestor.AbsoluteSize.Y > 0 then
						local bounds = ancestor.AbsoluteSize
						local authored = root.Size
						local unitScale = if scale > 0 then scale else 1
						dimensions = V2.new(
							bounds.X * authored.X.Scale + authored.X.Offset * unitScale,
							bounds.Y * authored.Y.Scale + authored.Y.Offset * unitScale
						)
						break
					end
					ancestor = ancestor.Parent
				end
			end
			if scale > 0 then
				dimensions /= scale
			end
			local offset = math.max(0, (if horizontal then at.X else at.Y) - mainEdge(use))
			local extent = math.max(0, (if horizontal then dimensions.X else dimensions.Y) - 2 * mainEdge(use))
			cross:set(if horizontal then dimensions.Y else dimensions.X)
			local previous = viewport:peek()
			if previous.offset ~= offset or previous.size ~= extent then
				viewport:set({ offset = offset, size = extent, offsetRevision = previous.offsetRevision })
			end
		end)
		local resetKey: string? = nil
		Compose.watch(function(use: ComposeTypes.Use)
			local requestedReset = if spec.scrollReset ~= nil then read(spec.scrollReset, use) :: string else nil
			local reset = resetKey ~= nil and requestedReset ~= resetKey
			resetKey = requestedReset
			local current = use(status)
			local desired = if current then current.desiredOffset else nil
			local box = viewport:peek()
			if view.initialFollow and current and current.total ~= nil and box.size > 0 then
				view.initialFollow = false
				desired = math.max(0, current.extent - box.size)
			end
			local policyOffset = if scrollPolicy then scrollPolicy(use, box) else nil
			if policyOffset ~= nil then
				desired = policyOffset
			end
			if reset then
				desired = 0
			end
			if desired ~= nil then
				setOffset(desired)
			end
			if policyOffset ~= nil or reset then
				local current = viewport:peek()
				local at = root.CanvasPosition
				viewport:set({
					offset = math.max(0, (if horizontal then at.X else at.Y) - mainEdge()),
					size = current.size,
					offsetRevision = (current.offsetRevision or 0) + 1,
				})
			end
		end)
		local focusScope, eligible = createFocus(ctx, view, editor, root, setOffset)
		if spec.measure then
			Compose.watch(function(use: ComposeTypes.Use)
				local rows = source(use)
				if next(measured:peek()) == nil then
					return
				end
				local valid: { [K]: boolean } = {}
				local pruned: { [K]: number } = {}
				local changed = false
				for index, item in rows do
					valid[keyOf(item, index)] = true
				end
				for key, extent in measured:peek() do
					if valid[key] then
						pruned[key] = extent
					else
						changed = true
					end
				end
				if changed then
					measured:set(pruned)
				end
			end)
		end
		bindNavigation(ctx, view, root, focusScope, eligible)
		if spec.onReachEnd then
			local previousTotal = -1
			Compose.watch(function(use: ComposeTypes.Use)
				local current = use(status)
				if
					current
					and current.total > 0
					and current.last == current.total
					and current.total ~= previousTotal
				then
					previousTotal = current.total
					spec.onReachEnd()
				end
			end)
		end
		if spec.snap == "item" or view.cardsMode then
			attachSnap(ctx, spec, root, controls, status, viewport, setOffset, function()
				return writingOffset
			end, function()
				local _, perView = view.cardLayout()
				return spec.snap == "item" or perView == 1
			end)
		end
		initialScroll(ctx, root, spec.CanvasPosition)
		return root
	end
	local function construct<V, K>(
		spec: CollectionProps.CollectionSpec<V, K>,
		kind: ComposeTypes.OrderedCollectionLayoutKind,
		tree: TreeTypes.Tree<V, K>?,
		actionsWrapped: boolean?,
		scrollPolicy: ScrollPolicy?
	): ScrollingFrame
		if spec.key == nil then
			return collection(
				(spec :: unknown) :: CollectionTypes.CollectionShape<V, V>,
				kind,
				function(value: V, _index: number): V
					return value
				end
			)
		end
		local key: unknown = spec.key
		if type(key) == "string" then
			assert(key ~= "", "Facet collection: key field must not be empty")
			local fieldSpec = (spec :: unknown) :: CollectionTypes.CollectionShape<V, string>
			return collection(fieldSpec, kind, function(value: V, _index: number): string
				return tostring(((value :: unknown) :: { [string]: unknown })[key])
			end)
		end
		assert(type(key) == "function", "Facet collection: key must be a function or a field name")
		return collection(
			(spec :: unknown) :: CollectionTypes.CollectionShape<V, K>,
			kind,
			(key :: unknown) :: (V, number) -> K,
			tree,
			actionsWrapped,
			scrollPolicy
		)
	end
	local function list<V, K>(spec: CollectionProps.CollectionSpec<V, K>): ScrollingFrame
		return construct(spec, "list")
	end
	local function grid<V, K>(spec: CollectionProps.CollectionSpec<V, K>): ScrollingFrame
		return construct(spec, "grid")
	end

	UI.Outline = ctx.construct("Outline", function<V, K>(spec: CollectionProps.OutlineSpec<V, K>): ScrollingFrame
		assert(spec.children ~= nil, "Facet Outline requires children")
		return construct(spec, "list")
	end) :: ControlTypes.OutlineConstructor
	UI.VirtualList = ctx.construct("VirtualList", list) :: ControlTypes.CollectionConstructor
	UI.VirtualGrid = ctx.construct("VirtualGrid", grid) :: ControlTypes.CollectionConstructor
	return function<V, K>(
		spec: CollectionProps.KeyedCollectionSpec<V, K>,
		tree: TreeTypes.Tree<V, K>?,
		actionsWrapped: boolean?,
		scrollPolicy: ScrollPolicy?
	): ScrollingFrame
		return construct(spec, "list", tree, actionsWrapped, scrollPolicy)
	end
end
]]></string>
