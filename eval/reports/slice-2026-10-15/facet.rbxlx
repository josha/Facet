                <Item class="ModuleScript" referent="298">
                  <Properties>
                    <string name="Name">fragment</string>
                    <string name="Source"><![CDATA[--!strict

local Block = require "../runtime/block"
local Children = require "../runtime/children"
local Host = require "../host"
local Support = require "./support"

export type Builder = () -> { Host.Node }

local function fragment(builder: Builder): Children.Directive
	local build = Support.builderOf(builder, "fragment", "builder") :: Builder
	return function(mountPoint: Children.MountPoint)
		local owner = Support.ownerFor "fragment"
		Support.mountPointOf(mountPoint, "fragment")
		Block.mountBlock(mountPoint, owner, build, Block.nameOf(build), 1)
	end
end

return fragment
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="299">
                  <Properties>
                    <string name="Name">indexes</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local Block = require "../runtime/block"
local Children = require "../runtime/children"
local Host = require "../host"
local Support = require "./support"
local Types = require "../reactive/types"
local cellModule = require "../reactive/cell"

export type Render<V> = (value: Types.Readable<V>, index: number) -> Host.Node

type Row<V> = {
	block: Block.Block,
	value: Types.Cell<V>,
}

local function indexes<V>(source: Types.Source<{ V }>, render: Render<V>): Children.Directive
	local from = Support.sourceOf(source, "indexes", "source") :: Types.Body<{ V }>
	local build = Support.builderOf(render, "indexes", "render") :: Render<V>
	return function(mountPoint: Children.MountPoint)
		local owner = Support.ownerFor "indexes"
		Support.mountPointOf(mountPoint, "indexes")
		local rows: { Row<V> } = {}

		owner.own(function()
			table.clear(rows)
		end)

		owner.watch(function(use)
			local list = from(use)
			local wanted = #list

			for index = 1, wanted do
				local row = rows[index]
				if row ~= nil then
					row.value:set(list[index])
				else
					local value = cellModule.cell(list[index])
					local position = index
					local block = Block.mountBlock(mountPoint, owner, function(): { Host.Node }
						return { build(value, position) }
					end, "indexed row", nil)
					rows[index] = { block = block, value = value }
				end
			end

			for index = #rows, wanted + 1, -1 do
				rows[index].block.dispose()
				rows[index] = nil
			end
		end)
	end
end

return indexes
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="300">
                  <Properties>
                    <string name="Name">keyed</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local Block = require "../runtime/block"
local Children = require "../runtime/children"
local Diagnostics = require "../diagnostics"
local Host = require "../host"
local Support = require "./support"
local Types = require "../reactive/types"
local longestIncreasingSubsequence = require "./lis"
local cellModule = require "../reactive/cell"

export type Render<V, K> = (value: Types.Readable<V>, index: Types.Readable<number>, key: K) -> Host.Node

type Entry<V, K> = {
	key: K,
	block: Block.Block,
	value: Types.Cell<V>,
	index: Types.Cell<number>,
	size: number,
}

local function identity<V>(value: V, _index: number): V
	return value
end

export type Source<V> = Types.Readable<{ V }> | Types.Body<{ V }>

export type Options<V, K> = {
	from: Source<V>,
	key: ((value: V, index: number) -> K)?,
	render: Render<V, K>,
}

local KNOWN_FIELDS: { [string]: true } = { from = true, key = true, render = true }

local function keyed<V, K>(options: Options<V, K>): Children.Directive
	local settings = Support.optionsOf(options, "keyed", "from = ..., key = ..., render = ...")
	Support.noUnknownFields(settings, "keyed", KNOWN_FIELDS)
	local source = Support.sourceOf(settings.from, "keyed", "from") :: Types.Body<{ V }>
	local render = Support.builderOf(settings.render, "keyed", "render") :: Render<V, K>
	local keyOf = settings.key

	local key: (value: V, index: number) -> K
	if keyOf ~= nil then
		key = Support.builderOf(keyOf, "keyed", "key")
	else
		key = (identity :: unknown) :: (value: V, index: number) -> K
	end

	return function(mountPoint: Children.MountPoint)
		local owner = Support.ownerFor "keyed"
		Support.mountPointOf(mountPoint, "keyed")
		local ordersChildren = mountPoint.ordersChildren
		local entries: { [K]: Entry<V, K> } = {}
		local order: { K } = {}
		local positionOf: { [K]: number } = {}

		local uniform = true
		local keys: { K } = {}
		local seen: { [K]: number } = {}
		local retainedPositions: { number } = {}
		local retainedTargets: { number } = {}
		local currentList: { V } = {}

		owner.own(function()
			table.clear(entries)
			table.clear(order)
			table.clear(positionOf)
			table.clear(keys)
			table.clear(seen)
			table.clear(retainedPositions)
			table.clear(retainedTargets)
			currentList = {}
		end)

		local function startOf(liveIndex: number): number
			if uniform then
				return liveIndex
			end
			local position = 1
			for index = 1, liveIndex - 1 do
				position += entries[order[index]].size
			end
			return position
		end

		local function reindex(from: number, to: number)
			for index = from, to do
				positionOf[order[index]] = index
			end
		end

		local function mountRow(index: number, itemKey: K, at: number): number
			local value = cellModule.cell(currentList[index])
			local position = cellModule.cell(index)
			local block = Block.mountBlock(mountPoint, owner, function(): { Host.Node }
				return { render(value, position, itemKey) }
			end, "keyed row", at)
			local size = #block.nodes
			if size ~= 1 then
				uniform = false
			end
			entries[itemKey] = {
				key = itemKey,
				block = block,
				value = value,
				index = position,
				size = size,
			}
			return size
		end

		owner.watch(function(use)
			local list = source(use)
			currentList = list
			local wanted = #list

			table.clear(seen)
			for index = 1, wanted do
				local itemKey = key(list[index], index)
				if seen[itemKey] ~= nil then
					Diagnostics.raise("structure/duplicate-key", "two items in a keyed collection share a key", {
						index = index,
						detail = ("the same key is also used at index %d"):format(seen[itemKey]),
						contract = "keys identify rows across updates, so they must be unique within one update",
						fix = "pass a keyOf that returns a stable unique id, e.g. function(item) return item.id end",
					})
				end
				seen[itemKey] = index
				keys[index] = itemKey
			end

			local removedAny = false
			for index = #order, 1, -1 do
				local existing = order[index]
				if seen[existing] == nil then
					entries[existing].block.dispose()
					entries[existing] = nil
					positionOf[existing] = nil
					removedAny = true
				end
			end
			if removedAny then
				local live = 0
				local was = #order
				for index = 1, was do
					local existing = order[index]
					if entries[existing] ~= nil then
						live += 1
						order[live] = existing
						positionOf[existing] = live
					end
				end
				for index = was, live + 1, -1 do
					order[index] = nil
				end
			end

			local retained = 0
			local previousPosition = 0
			local ordered = true
			for index = 1, wanted do
				local entry = entries[keys[index]]
				if entry ~= nil then
					entry.value:set(list[index])
					entry.index:set(index)
					local at = positionOf[entry.key]
					retained += 1
					if at < previousPosition then
						ordered = false
					end
					previousPosition = at
					if ordersChildren then
						retainedPositions[retained] = at
						retainedTargets[retained] = index
					end
				end
			end

			if ordered and retained == wanted and not removedAny and order[wanted + 1] == nil then
				return
			end

			local stays: { [K]: true }? = nil
			if ordersChildren and not ordered then
				local staying = longestIncreasingSubsequence(retainedPositions, retained)
				local held: { [K]: true } = {}
				for offset = 1, retained do
					if staying[offset] then
						held[keys[retainedTargets[offset]]] = true
					end
				end
				stays = held
			end

			local failures: { string }? = nil
			if stays == nil then
				local live = 0
				for index = 1, wanted do
					local itemKey = keys[index]
					live += 1

					if entries[itemKey] == nil then
						local ok, err = pcall(mountRow, index, itemKey, startOf(live))
						if not ok then
							failures = failures or {}
							table.insert(failures :: { string }, tostring(err))
							live -= 1
							continue
						end
						table.insert(order, live, itemKey)
						reindex(live, #order)
					elseif retained < wanted and order[live] ~= itemKey then
						local from = positionOf[itemKey]
						table.remove(order, from)
						table.insert(order, live, itemKey)
						reindex(math.min(from, live), math.max(from, live))
					else
						order[live] = itemKey
						positionOf[itemKey] = live
					end
				end
				for index = #order, live + 1, -1 do
					order[index] = nil
				end
			else
				local anchor: K? = nil
				for index = wanted, 1, -1 do
					local itemKey = keys[index]
					local entry = entries[itemKey]

					local anchorLive = if anchor ~= nil then positionOf[anchor] else #order + 1

					if entry == nil then
						local ok, err = pcall(mountRow, index, itemKey, startOf(anchorLive))
						if not ok then
							failures = failures or {}
							table.insert(failures :: { string }, tostring(err))
							continue
						end
						table.insert(order, anchorLive, itemKey)
						reindex(anchorLive, #order)
					elseif not stays[itemKey] then
						local from = positionOf[itemKey]
						table.remove(order, from)
						local destination = if from < anchorLive then anchorLive - 1 else anchorLive
						table.insert(order, destination, itemKey)
						reindex(math.min(from, destination), math.max(from, destination))
						local at = startOf(destination)
						for offset, node in entry.block.nodes do
							mountPoint.moveTo(node, at + offset - 1)
						end
					end
					anchor = itemKey
				end
			end
			if failures ~= nil then
				if #failures == 1 then
					error(failures[1], 0)
				end
				error(
					("Compose: %d keyed row factories failed:\n  %s"):format(#failures, table.concat(failures, "\n  ")),
					0
				)
			end
		end)
	end
end

return keyed
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="301">
                  <Properties>
                    <string name="Name">layer-stack</string>
                    <string name="Source"><![CDATA[--!strict

local Children = require "../runtime/children"
local Diagnostics = require "../diagnostics"
local Host = require "../host"
local Support = require "./support"
local Types = require "../reactive/types"
local keyed = require "./keyed"
local retain = require "../collection/retain"

export type Retention = "all" | "top"

export type State = {
	index: number,
	depthFromTop: number,
	top: boolean,
	covered: boolean,
}

export type Options<V, K> = {
	from: keyed.Source<V>,
	key: ((value: V, index: number) -> K)?,
	render: (value: Types.Readable<V>, state: Types.Readable<State>, key: K) -> Host.Node,
	retention: Retention?,
}

local KNOWN_FIELDS: { [string]: true } = {
	from = true,
	key = true,
	render = true,
	retention = true,
}

local function identity<V>(value: V, _index: number): V
	return value
end

local function sameState(a: State, b: State): boolean
	return a.index == b.index and a.depthFromTop == b.depthFromTop and a.top == b.top and a.covered == b.covered
end

local function layerStack<V, K>(options: Options<V, K>): Children.Directive
	local settings = Support.optionsOf(options, "LayerStack", "from = ..., key = ..., render = ...")
	Support.noUnknownFields(settings, "LayerStack", KNOWN_FIELDS)
	local source = Support.sourceOf(settings.from, "LayerStack", "from") :: Types.Body<{ V }>
	local render =
		Support.builderOf(settings.render, "LayerStack", "render") :: (Types.Readable<V>, Types.Readable<State>, K) -> Host.Node
	local keyOf: (value: V, index: number) -> K = if settings.key == nil
		then (identity :: unknown) :: (value: V, index: number) -> K
		else Support.builderOf(settings.key, "LayerStack", "key")
	local retention: Retention = settings.retention or "all"
	if retention ~= "all" and retention ~= "top" then
		Diagnostics.raise("layer-stack/unknown-retention", "LayerStack was given a retention policy it does not have", {
			actual = Diagnostics.describe(retention),
			expected = '"all" or "top"',
		})
	end

	local function select(_use: Types.Use, list: { V }): retain.Selection<V, State, K>
		local total = #list
		local first = if retention == "top" then math.max(1, total) else 1
		local values: { V } = {}
		local keys: { K } = {}
		local states: { State } = {}
		for index = first, total do
			local at = #values + 1
			values[at] = list[index]
			keys[at] = keyOf(list[index], index)
			states[at] = {
				index = index,
				depthFromTop = total - index,
				top = index == total,
				covered = index < total,
			}
		end
		return { values = values, keys = keys, states = states }
	end

	return retain {
		primitive = "LayerStack",
		source = source,
		select = select,
		render = render,
		equals = sameState,
	}
end

return layerStack
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="302">
                  <Properties>
                    <string name="Name">lis</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local sharedTails: { number } = {}
local sharedPrevious: { number } = {}

local function longestIncreasingSubsequence(values: { number }, countOf: number?): { [number]: true }
	local count = if countOf ~= nil then countOf else #values
	local result: { [number]: true } = {}
	if count == 0 then
		return result
	end

	local tails = sharedTails
	local previous = sharedPrevious
	local length = 0

	for index = 1, count do
		local value = values[index]

		local low, high = 1, length
		while low <= high do
			local middle = (low + high) // 2
			if values[tails[middle]] < value then
				low = middle + 1
			else
				high = middle - 1
			end
		end

		previous[index] = if low > 1 then tails[low - 1] else 0
		tails[low] = index
		if low > length then
			length = low
		end
	end

	local cursor = tails[length]
	while cursor ~= 0 and cursor ~= nil do
		result[cursor] = true
		cursor = previous[cursor]
	end
	return result
end

return longestIncreasingSubsequence
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="303">
                  <Properties>
                    <string name="Name">mount-budget</string>
                    <string name="Source"><![CDATA[--!strict

local Children = require "../runtime/children"
local Admission = require "../collection/admission"
local Diagnostics = require "../diagnostics"
local FramePump = require "../collection/frame-pump"
local Host = require "../host"
local Support = require "./support"
local Types = require "../reactive/types"
local cellModule = require "../reactive/cell"
local keyed = require "./keyed"

export type Status = {
	total: number,
	mounted: number,
	pending: number,
}

export type Options<V, K> = {
	from: keyed.Source<V>,
	key: ((value: V, index: number) -> K)?,
	render: (value: Types.Readable<V>, index: Types.Readable<number>, key: K) -> Host.Node,
	mountsPerFrame: number,
	priority: ((value: V, index: number) -> number)?,
	status: Types.Cell<Status>?,
}

local KNOWN_FIELDS: { [string]: true } = {
	from = true,
	key = true,
	render = true,
	mountsPerFrame = true,
	priority = true,
	status = true,
}

local function identity<V>(value: V, _index: number): V
	return value
end

local function mountBudget<V, K>(options: Options<V, K>): Children.Directive
	local settings = Support.optionsOf(options, "MountBudget", "from = ..., mountsPerFrame = ..., render = ...")
	Support.noUnknownFields(settings, "MountBudget", KNOWN_FIELDS)
	local source = Support.sourceOf(settings.from, "MountBudget", "from") :: Types.Body<{ V }>
	local render =
		Support.builderOf(settings.render, "MountBudget", "render") :: (Types.Readable<V>, Types.Readable<number>, K) -> Host.Node
	local keyOf: (value: V, index: number) -> K = if settings.key == nil
		then (identity :: unknown) :: (value: V, index: number) -> K
		else Support.builderOf(settings.key, "MountBudget", "key")
	local priority: ((value: V, index: number) -> number)? = if settings.priority == nil
		then nil
		else Support.builderOf(settings.priority, "MountBudget", "priority")
	local rawLimit = settings.mountsPerFrame
	if type(rawLimit) ~= "number" or rawLimit ~= rawLimit or rawLimit < 1 then
		Diagnostics.raise("mount-budget/invalid-limit", "MountBudget needs a positive mountsPerFrame", {
			actual = Diagnostics.describe(rawLimit),
			expected = "a positive number",
		})
	end
	local limit = math.max(1, math.floor(rawLimit))
	local status = if settings.status == nil then nil else Support.writableOf(settings.status, "MountBudget", "status")

	return function(mountPoint: Children.MountPoint)
		local owner = Support.ownerFor "MountBudget"
		Support.mountPointOf(mountPoint, "MountBudget")
		local admitted: { [K]: boolean } = {}
		local selectedValues: { V } = {}
		local selected = cellModule.cell(selectedValues, function()
			return false
		end)
		local selectedKeys: { K } = {}
		local tick = cellModule.cell(0)
		local pump = FramePump(owner, mountPoint.host, tick, "MountBudget")
		local builtFor: { V }? = nil
		local keys: { K } = {}
		local queue: { number } = {}
		local priorities: { number } = {}
		local cursor = 1
		local prefix = false

		owner.watch(function(use)
			use(tick)
			local list = source(use)
			local changed = list ~= builtFor
			if changed then
				local present: { [K]: boolean } = {}
				table.clear(keys)
				table.clear(queue)
				table.clear(priorities)
				for index, value in list do
					local key = keyOf(value, index)
					if present[key] then
						Diagnostics.raise("structure/duplicate-key", "two MountBudget items share a key", {
							index = index,
							contract = "keys identify mounted items and must be unique",
						})
					end
					present[key] = true
					keys[index] = key
				end
				for key in admitted do
					if not present[key] then
						admitted[key] = nil
					end
				end
				local candidates: { number } = {}
				for index, value in list do
					local key = keys[index]
					if not admitted[key] then
						candidates[#candidates + 1] = index
						if priority ~= nil then
							local score = (priority :: (V, number) -> number)(value, index)
							if type(score) ~= "number" or score ~= score or math.abs(score) == math.huge then
								Diagnostics.raise(
									"mount-budget/invalid-priority",
									"MountBudget.priority returned an invalid score",
									{
										index = index,
										actual = Diagnostics.describe(score),
										expected = "a finite number",
									}
								)
							end
							priorities[index] = score
						end
					end
				end
				local ranked = Admission(#candidates, if priority == nil then nil else 0, function(a, b)
					local left, right = candidates[a], candidates[b]
					return if priorities[left] == priorities[right]
						then left < right
						else priorities[left] > priorities[right]
				end)
				if ranked.order == nil then
					queue = candidates
				else
					for _, at in ranked.order :: { number } do
						queue[#queue + 1] = candidates[at]
					end
				end
				cursor = 1
				builtFor = list
			end

			local added: { number } = {}
			for _ = 1, limit do
				local index = queue[cursor]
				if index == nil then
					break
				end
				cursor += 1
				admitted[keys[index]] = true
				added[#added + 1] = index
			end

			if not changed and priority == nil and prefix then
				for _, index in added do
					selectedValues[#selectedValues + 1] = list[index]
					selectedKeys[#selectedKeys + 1] = keys[index]
				end
			else
				table.clear(selectedValues)
				table.clear(selectedKeys)
				prefix = true
				local foundGap = false
				for index, value in list do
					local key = keys[index]
					if admitted[key] then
						selectedValues[#selectedValues + 1] = value
						selectedKeys[#selectedKeys + 1] = key
						if foundGap then
							prefix = false
						end
					else
						foundGap = true
					end
				end
			end
			selected:set(selectedValues)
			local pending = #list - #selectedValues
			if status ~= nil then
				status:set { total = #list, mounted = #selectedValues, pending = pending }
			end
			pump.update(pending > 0)
		end)

		local function selectedKey(_value: V, index: number): K
			return selectedKeys[index]
		end
		(keyed { from = selected, key = selectedKey, render = render })(mountPoint)
	end
end

return mountBudget
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="304">
                  <Properties>
                    <string name="Name">ordered-collection</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local Children = require "../runtime/children"
local Diagnostics = require "../diagnostics"
local Host = require "../host"
local Layout = require "../collection/layout"
local Support = require "./support"
local Types = require "../reactive/types"
local keyed = require "./keyed"
local retain = require "../collection/retain"
local cellModule = require "../reactive/cell"

export type Viewport = {
	offset: number,
	size: number,
	offsetRevision: number?,
}

export type Mode = "all" | "windowed"
export type Direction = "vertical" | "horizontal"
export type LayoutKind = "list" | "grid"
export type Align = "start" | "center" | "end"

export type LayoutOptions = {
	kind: LayoutKind?,
	columns: number?,
	itemSize: number?,
	gap: number?,
	crossSize: number?,
	crossGap: number?,
}

export type Status = {
	mode: Mode,
	direction: Direction,
	total: number,
	retained: number,
	first: number,
	last: number,
	firstRow: number,
	lastRow: number,
	rowCount: number,
	extent: number,
	following: boolean,
	desiredOffset: number?,
	measured: number,
}

export type Controls<K> = {
	offsetOf: ((index: number, align: Align?, size: number?) -> number)?,
	indexOfKey: ((key: K) -> number?)?,
	placementOf: ((index: number) -> Layout.Placement)?,
}

export type Options<V, K> = {
	from: keyed.Source<V>,
	key: ((value: V, index: number) -> K)?,
	render: (value: Types.Readable<V>, placement: Types.Readable<Layout.Placement>, key: K) -> Host.Node,
	mode: Mode?,
	viewport: (Types.Readable<Viewport> | Types.Body<Viewport>)?,
	direction: Direction?,
	layout: (LayoutOptions | Types.Readable<LayoutOptions> | Types.Body<LayoutOptions>)?,
	overscan: number?,
	measured: (Types.Readable<{ [K]: number }> | Types.Body<{ [K]: number }>)?,
	follow: ("end" | "none")?,
	followThreshold: number?,
	status: Types.Cell<Status>?,
	controls: Controls<K>?,
}

local KNOWN_FIELDS: { [string]: true } = {
	from = true,
	key = true,
	render = true,
	mode = true,
	viewport = true,
	direction = true,
	layout = true,
	overscan = true,
	measured = true,
	follow = true,
	followThreshold = true,
	status = true,
	controls = true,
}

local KNOWN_LAYOUT: { [string]: true } = {
	kind = true,
	columns = true,
	itemSize = true,
	gap = true,
	crossSize = true,
	crossGap = true,
}

local function numberOr(value: unknown, fallback: number): number
	if value == nil then
		return fallback
	end
	if type(value) == "number" and value == value then
		return value
	end
	return fallback
end

local function identity<V>(value: V, _index: number): V
	return value
end

local function geometryOptions(value: LayoutOptions): Layout.Options
	local layoutOptions = Support.optionsOf(value, "OrderedCollection.layout", "kind = ..., itemSize = ...")
	Support.noUnknownFields(layoutOptions, "OrderedCollection.layout", KNOWN_LAYOUT)
	local kind: LayoutKind = layoutOptions.kind or "list"
	if kind ~= "list" and kind ~= "grid" then
		Diagnostics.raise("collection/unknown-layout", "OrderedCollection was given a layout kind it does not have", {
			primitive = "OrderedCollection",
			actual = Diagnostics.describe(layoutOptions.kind),
			expected = '"list" or "grid"',
		})
	end
	return {
		count = 0,
		columns = if kind == "grid" then math.max(1, math.floor(numberOr(layoutOptions.columns, 1))) else 1,
		rowSize = numberOr(layoutOptions.itemSize, 1),
		gap = numberOr(layoutOptions.gap, 0),
		crossSize = numberOr(layoutOptions.crossSize, 0),
		crossGap = numberOr(layoutOptions.crossGap, 0),
	}
end

local function orderedCollection<V, K>(options: Options<V, K>): Children.Directive
	local settings = Support.optionsOf(options, "OrderedCollection", "from = ..., render = ...")
	Support.noUnknownFields(settings, "OrderedCollection", KNOWN_FIELDS)

	local source = Support.sourceOf(settings.from, "OrderedCollection", "from") :: Types.Body<{ V }>
	local render =
		Support.builderOf(settings.render, "OrderedCollection", "render") :: (Types.Readable<V>, Types.Readable<Layout.Placement>, K) -> Host.Node

	local keyOf: (value: V, index: number) -> K
	if settings.key ~= nil then
		keyOf = Support.builderOf(settings.key, "OrderedCollection", "key") :: (value: V, index: number) -> K
	else
		keyOf = (identity :: unknown) :: (value: V, index: number) -> K
	end

	local mode: Mode = (settings.mode :: Mode?) or "all"
	if mode ~= "all" and mode ~= "windowed" then
		Diagnostics.raise("collection/unknown-mode", "OrderedCollection was given a mode it does not have", {
			primitive = "OrderedCollection",
			actual = Diagnostics.describe(settings.mode),
			expected = '"all" or "windowed"',
			contract = "the retention policy is explicit; there is no population at which one becomes the other",
		})
	end

	local direction: Direction = (settings.direction :: Direction?) or "vertical"
	if direction ~= "vertical" and direction ~= "horizontal" then
		Diagnostics.raise("collection/unknown-direction", "OrderedCollection was given a direction it does not have", {
			primitive = "OrderedCollection",
			actual = Diagnostics.describe(settings.direction),
			expected = '"vertical" or "horizontal"',
		})
	end

	local layoutBody: Types.Body<LayoutOptions>? = nil
	local initialLayout: Layout.Options
	if cellModule.isReadable(settings.layout) or type(settings.layout) == "function" then
		layoutBody = Support.sourceOf(settings.layout, "OrderedCollection", "layout") :: Types.Body<LayoutOptions>
		initialLayout = geometryOptions {}
	else
		initialLayout = geometryOptions((settings.layout :: LayoutOptions?) or {})
	end
	local overscan = math.max(0, math.floor(numberOr(settings.overscan, 0)))
	local followThreshold = numberOr(settings.followThreshold, 4)
	local followEnd = settings.follow == "end"

	local viewportBody: Types.Body<Viewport>? = nil
	if settings.viewport ~= nil then
		viewportBody = Support.sourceOf(settings.viewport, "OrderedCollection", "viewport") :: Types.Body<Viewport>
	elseif mode == "windowed" then
		Diagnostics.raise("collection/no-viewport", 'OrderedCollection mode = "windowed" needs a viewport', {
			primitive = "OrderedCollection",
			contract = "a windowed collection retains what the viewport covers, so it has to be told where it is",
			fix = 'pass viewport = a cell holding { offset = ..., size = ... }, or use mode = "all"',
		})
	end

	local measuredBody: Types.Body<{ [K]: number }>? = nil
	if settings.measured ~= nil then
		measuredBody =
			Support.sourceOf(settings.measured, "OrderedCollection", "measured") :: Types.Body<{ [K]: number }>
	end

	local statusCell = if settings.status == nil
		then nil
		else Support.writableOf(settings.status, "OrderedCollection", "status")
	local controls = settings.controls
	if controls ~= nil and type(controls) ~= "table" then
		Diagnostics.raise("collection/controls-not-a-table", "OrderedCollection cannot fill in these controls", {
			key = "controls",
			actual = Diagnostics.describe(controls),
			expected = "a table, which the collection fills in on mount",
			contract = "controls is an out-parameter: the collection writes its query functions into it",
			fix = "pass a table you keep -- local controls = {} -- and read controls.placementOf after mounting",
		})
	end

	local builtFor: { V }? = nil
	local indexMap: { [K]: number }? = nil
	local geometry = Layout.create(initialLayout)
	local applied: { [K]: number } = {}

	local appliedFrom: { [K]: number }? = nil
	local measuredCount = 0
	local following = followEnd
	local lastOffset: number? = nil
	local lastOffsetRevision: number? = nil
	local requestedOffset: number? = nil
	local anchorKey: K? = nil
	local anchorOffset = 0
	local anchorIndex = 0
	local measurementsChanged = false

	local placements: { [number]: Layout.Placement } = {}
	local selection: retain.Selection<V, Layout.Placement, K> = { values = {}, keys = {}, states = {} }
	local published: Status? = nil
	local windowRange: Layout.Range = { first = 1, last = 0, firstRow = 1, lastRow = 0 }
	local anchorRange: Layout.Range = { first = 1, last = 0, firstRow = 1, lastRow = 0 }
	local wholeRange: Layout.Range = { first = 1, last = 0, firstRow = 1, lastRow = 0 }

	local function geometryChanged()
		table.clear(placements)
	end

	local function placementFor(index: number): Layout.Placement
		local held = placements[index]
		if held ~= nil then
			return held
		end
		local made = Layout.placementOf(geometry, index)
		table.freeze(made :: {})
		placements[index] = made
		return made
	end

	local function keyIndex(): { [K]: number }
		local existing = indexMap
		if existing ~= nil then
			return existing
		end
		local list = builtFor
		if list == nil then
			return {}
		end
		local map: { [K]: number } = {}
		for index = 1, #list do
			map[keyOf(list[index], index)] = index
		end
		indexMap = map
		return map
	end

	local function rebuild(list: { V }, layout: Layout.Options)
		indexMap = nil
		builtFor = list
		layout.count = #list
		geometry = Layout.create(layout)
		measurementsChanged = true
		geometryChanged()
	end

	local function findAnchorIndex(list: { V }, wanted: K): number?
		local count = #list
		if anchorIndex >= 1 and anchorIndex <= count and keyOf(list[anchorIndex], anchorIndex) == wanted then
			return anchorIndex
		end
		for distance = 1, 64 do
			local before = anchorIndex - distance
			if before >= 1 and before <= count and keyOf(list[before], before) == wanted then
				return before
			end
			local after = anchorIndex + distance
			if after >= 1 and after <= count and keyOf(list[after], after) == wanted then
				return after
			end
		end
		return keyIndex()[wanted]
	end

	local function applyMeasurements(sizes: { [K]: number })
		local map = keyIndex()
		local moved = false
		for key in applied do
			local at = map[key]
			if sizes[key] == nil or at == nil then
				if at ~= nil and Layout.setItemSize(geometry, at, geometry.rowSize) then
					moved = true
				end
				applied[key] = nil
			end
		end

		measuredCount = 0
		for key, size in sizes do
			local at = map[key]
			if at ~= nil then
				applied[key] = size
				if Layout.setItemSize(geometry, at, size) then
					moved = true
				end
				measuredCount += 1
			end
		end
		measurementsChanged = false
		if moved then
			geometryChanged()
		end
	end

	if controls ~= nil then
		controls.indexOfKey = function(key: K): number?
			return keyIndex()[key]
		end
		controls.placementOf = function(index: number): Layout.Placement
			return placementFor(index)
		end
		controls.offsetOf = function(index: number, align: Align?, size: number?): number
			local placement = Layout.placementOf(geometry, index)
			local viewportSize = numberOr(size, 0)
			local extent = Layout.totalExtent(geometry)
			local target: number
			if align == "end" then
				target = placement.offset + placement.size - viewportSize
			elseif align == "center" then
				target = placement.offset + placement.size / 2 - viewportSize / 2
			else
				target = placement.offset
			end
			return math.clamp(target, 0, math.max(0, extent - viewportSize))
		end
	end

	local function select(use: Types.Use, list: { V }): retain.Selection<V, Layout.Placement, K>
		local layout = if layoutBody ~= nil then geometryOptions(layoutBody(use)) else initialLayout
		if
			list ~= builtFor
			or layout.columns ~= geometry.columns
			or layout.rowSize ~= geometry.rowSize
			or layout.gap ~= geometry.gap
			or layout.crossSize ~= geometry.crossSize
			or layout.crossGap ~= geometry.crossGap
		then
			rebuild(list, layout)
		end

		if measuredBody ~= nil then
			local sizes = measuredBody(use)
			if measurementsChanged or sizes ~= appliedFrom then
				appliedFrom = sizes
				applyMeasurements(sizes)
			end
		end

		local count = #list
		local extent = Layout.totalExtent(geometry)
		local range: Layout.Range
		local viewportOffset = 0
		local viewportSize = extent
		local offsetRevision: number? = nil
		if mode == "windowed" then
			local read = (viewportBody :: Types.Body<Viewport>)(use)
			viewportOffset = numberOr(read.offset, 0)
			viewportSize = numberOr(read.size, 0)
			offsetRevision = read.offsetRevision
			range = windowRange
		else
			wholeRange.first = 1
			wholeRange.last = count
			wholeRange.firstRow = if count > 0 then 1 else 0
			wholeRange.lastRow = geometry.rowCount
			range = wholeRange
		end

		local scrollChanged = lastOffset ~= nil
			and (viewportOffset ~= lastOffset or offsetRevision ~= lastOffsetRevision)
		local effectiveOffset = if not scrollChanged and requestedOffset ~= nil then requestedOffset else viewportOffset
		local desiredOffset: number? = nil
		if followEnd and mode == "windowed" then
			if lastOffset == nil or scrollChanged then
				local distanceFromEnd = extent - (viewportOffset + viewportSize)
				following = distanceFromEnd <= followThreshold
			end
			if following then
				desiredOffset = math.max(0, extent - viewportSize)
			end
		end

		if desiredOffset == nil and mode == "windowed" and anchorKey ~= nil and not scrollChanged then
			local at = findAnchorIndex(list, anchorKey :: K)
			if at ~= nil then
				local moved = Layout.offsetOf(geometry, at) - anchorOffset
				if moved ~= 0 then
					desiredOffset = effectiveOffset + moved
				end
			end
		end
		if mode == "windowed" then
			effectiveOffset = math.clamp(desiredOffset or effectiveOffset, 0, math.max(0, extent - viewportSize))
			desiredOffset = if effectiveOffset ~= viewportOffset then effectiveOffset else nil
			Layout.rangeInto(geometry, effectiveOffset, viewportSize, overscan, windowRange)
		end
		requestedOffset = desiredOffset

		local first = range.first
		local last = range.last
		local values, keys, states = selection.values, selection.keys, selection.states
		local retained = 0
		for index = first, last do
			local value = list[index]
			retained += 1
			values[retained] = value
			keys[retained] = keyOf(value, index)
			states[retained] = placementFor(index)
		end
		for index = #values, retained + 1, -1 do
			values[index] = nil
			keys[index] = nil
			states[index] = nil
		end

		lastOffset = viewportOffset
		lastOffsetRevision = offsetRevision

		if retained > 0 then
			anchorIndex = if mode == "windowed"
				then Layout.rangeInto(geometry, effectiveOffset, viewportSize, 0, anchorRange).first
				else first
			anchorKey = keyOf(list[anchorIndex], anchorIndex)
			anchorOffset = Layout.offsetOf(geometry, anchorIndex)
		else
			anchorKey = nil
			anchorOffset = 0
			anchorIndex = 0
		end

		if statusCell ~= nil then
			local previous = published
			if
				previous == nil
				or previous.total ~= count
				or previous.retained ~= retained
				or previous.first ~= first
				or previous.last ~= last
				or previous.firstRow ~= range.firstRow
				or previous.lastRow ~= range.lastRow
				or previous.rowCount ~= geometry.rowCount
				or previous.extent ~= extent
				or previous.following ~= following
				or previous.desiredOffset ~= desiredOffset
				or previous.measured ~= measuredCount
			then
				local fresh: Status = {
					mode = mode,
					direction = direction,
					total = count,
					retained = retained,
					first = first,
					last = last,
					firstRow = range.firstRow,
					lastRow = range.lastRow,
					rowCount = geometry.rowCount,
					extent = extent,
					following = following,
					desiredOffset = desiredOffset,
					measured = measuredCount,
				}
				published = fresh
				statusCell:set(fresh)
			end
		end

		return selection
	end

	return retain {
		primitive = "OrderedCollection",
		source = source,
		select = select,
		render = render,
		equals = function(current: Layout.Placement, incoming: Layout.Placement): boolean
			return current.index == incoming.index
				and current.row == incoming.row
				and current.column == incoming.column
				and current.offset == incoming.offset
				and current.size == incoming.size
				and current.crossOffset == incoming.crossOffset
				and current.crossSize == incoming.crossSize
		end,
	}
end

return orderedCollection
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="305">
                  <Properties>
                    <string name="Name">portal</string>
                    <string name="Source"><![CDATA[--!strict

local Block = require "../runtime/block"
local Children = require "../runtime/children"
local Diagnostics = require "../diagnostics"
local Host = require "../host"
local Nodes = require "../ownership/nodes"
local Support = require "./support"

export type Builder = () -> { Host.Node }

local function portal(target: Host.Node, builder: Builder): Children.Directive
	if type(target) ~= "table" and type(target) ~= "userdata" then
		Diagnostics.raise("mount/target-not-a-node", "portal expects a host node to mount into", {
			actual = Diagnostics.describe(target),
			expected = "a node belonging to the host this runtime renders to",
			contract = "a portal's target is borrowed: Compose adds to it and leaves it standing",
			fix = "pass the layer node itself, e.g. portal(screenLayer, function() ... end)",
		})
	end
	local build = Support.builderOf(builder, "portal", "builder") :: Builder
	return function(mountPoint: Children.MountPoint)
		local owner = Support.ownerFor "portal"
		Support.mountPointOf(mountPoint, "portal")

		Nodes.markBorrowed(target)
		local elsewhere = Children.wholeOf(mountPoint.host, target)
		Block.mountBlock(elsewhere, owner, build, Block.nameOf(build), nil)
	end
end

return portal
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="306">
                  <Properties>
                    <string name="Name">presence</string>
                    <string name="Source"><![CDATA[--!strict

local Active = require "../ownership/active"
local Block = require "../runtime/block"
local Children = require "../runtime/children"
local Diagnostics = require "../diagnostics"
local Host = require "../host"
local Support = require "./support"
local Types = require "../reactive/types"
local cellModule = require "../reactive/cell"

export type Phase = {
	exiting: Types.Readable<boolean>,
}

export type Builder = (phase: Phase) -> Host.Node | { Host.Node }

export type Exiting = {
	completed: Types.Readable<boolean>,
}

export type Options = {
	exit: (nodes: { Host.Node }) -> Exiting,
}

local KNOWN_FIELDS: { [string]: true } = { exit = true }

local function presence<T>(condition: Types.Source<T>, builder: Builder, options: Options?): Children.Directive
	local exit: ((nodes: { Host.Node }) -> Exiting)? = nil
	if options ~= nil then
		local settings = Support.optionsOf(options, "presence", "exit = ...")
		Support.noUnknownFields(settings, "presence", KNOWN_FIELDS)
		if settings.exit ~= nil then
			exit = Support.builderOf(settings.exit, "presence", "exit")
		end
	end
	local when = Support.sourceOf(condition, "presence", "condition") :: Types.Body<T>
	local build = Support.builderOf(builder, "presence", "builder") :: Builder

	return function(mountPoint: Children.MountPoint)
		local owner = Support.ownerFor "presence"
		Support.mountPointOf(mountPoint, "presence")
		local exiting = cellModule.cell(false)
		local phase: Phase = { exiting = exiting }
		local current: Block.Block? = nil
		local shown: boolean? = nil
		local leaving: Block.Block? = nil
		local stopWatchingExit: (() -> ())? = nil

		local function forgetExit()
			local stop = stopWatchingExit
			if stop ~= nil then
				stopWatchingExit = nil
				stop()
			end
		end

		owner.own(function()
			forgetExit()
			local departing = leaving
			leaving = nil
			if departing ~= nil then
				departing.dispose()
			end
		end)

		owner.watch(function(use)
			local truthy = not not when(use)
			if truthy == shown then
				return
			end
			shown = truthy

			if truthy then
				forgetExit()
				exiting:set(false)
				local reclaimed = leaving
				if reclaimed ~= nil then
					leaving = nil
					current = reclaimed
					return
				end
				current = Block.mountBlock(mountPoint, owner, function(): { Host.Node }
					local produced = build(phase)
					if type(produced) == "table" and (produced :: { Host.Node })[1] ~= nil then
						return produced :: { Host.Node }
					end
					return { produced }
				end, Block.nameOf(build), 1)
				return
			end

			local departing = current
			current = nil
			if departing == nil then
				return
			end
			local start = exit
			if start == nil then
				departing.dispose()
				return
			end

			leaving = departing
			exiting:set(true)
			local ok, running: unknown = pcall(Active.withOwner, owner, function(): Exiting
				return start(departing.nodes)
			end)
			if not ok then
				leaving = nil
				departing.dispose()
				Diagnostics.raise("structure/exit-failed", "a presence exit raised instead of returning", {
					detail = tostring(running),
					contract = "exit starts the departure and returns something with a completed readable",
					fix = "return a timeline, or omit exit to dispose immediately",
				})
				return
			end
			if type(running) ~= "table" or (running :: { completed: unknown }).completed == nil then
				leaving = nil
				departing.dispose()
				Diagnostics.raise("structure/exit-not-completable", "a presence exit returned nothing that completes", {
					actual = Diagnostics.describe(running),
					expected = "a table with a `completed` readable, such as a timeline",
				})
				return
			end

			local exited = false
			local stop = owner.watch(function(watchUse)
				if not watchUse((running :: Exiting).completed) then
					return
				end
				local finished = leaving
				if finished == nil then
					return
				end
				leaving = nil
				exited = true
				forgetExit()
				finished.dispose()
			end)
			if exited then
				stop()
			else
				stopWatchingExit = stop
			end
		end)
	end
end

return presence
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="307">
                  <Properties>
                    <string name="Name">show</string>
                    <string name="Source"><![CDATA[--!strict

local Children = require "../runtime/children"
local Host = require "../host"
local Support = require "./support"
local Types = require "../reactive/types"

export type Builder = () -> Host.Node | Children.Directive

local function show<T>(condition: Types.Source<T>, builder: Builder, fallback: Builder?): Children.Directive
	local when = Support.sourceOf(condition, "show", "condition") :: Types.Body<T>
	local render = Support.builderOf(builder, "show", "builder") :: Builder
	local otherwise = if fallback ~= nil then Support.builderOf(fallback, "show", "fallback") :: Builder else nil
	return function(mountPoint: Children.MountPoint)
		local owner = Support.ownerFor "show"
		Support.mountPointOf(mountPoint, "show")
		local disposeCurrent: Types.Dispose? = nil
		local shown: boolean? = nil

		owner.watch(function(use)
			local truthy = not not when(use)
			if truthy == shown then
				return
			end
			shown = truthy

			if disposeCurrent ~= nil then
				disposeCurrent()
				disposeCurrent = nil
			end

			local pick = if truthy then render else otherwise
			if pick == nil then
				return
			end
			disposeCurrent = Support.mountBuilder(mountPoint, owner, pick, "show")
		end)
	end
end

return show
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="308">
                  <Properties>
                    <string name="Name">spatial-collection</string>
                    <string name="Source"><![CDATA[--!strict
--!native

local Children = require "../runtime/children"
local Admission = require "../collection/admission"
local Diagnostics = require "../diagnostics"
local FramePump = require "../collection/frame-pump"
local Grid = require "../collection/grid"
local Host = require "../host"
local Relevance = require "../collection/relevance"
local Support = require "./support"
local Types = require "../reactive/types"
local cellModule = require "../reactive/cell"
local keyed = require "./keyed"
local retain = require "../collection/retain"

export type Tier = Relevance.Tier

export type Point = {
	x: number,
	y: number,
	z: number?,
}

export type Representation = {
	tier: number,
	name: string,
	distance: number,
	pinned: boolean,
}

export type Budget = {
	mountsPerFrame: number?,
}

export type Status = {
	total: number,
	retained: number,
	queried: number,
	pending: number,
	perTier: { number },
	cells: number,
}

export type Options<V, K> = {
	from: keyed.Source<V>,
	key: ((value: V, index: number) -> K)?,
	position: (value: V) -> (number, number, number?),
	origin: Types.Readable<Point> | Types.Body<Point>,
	tiers: { Tier },
	render: (value: Types.Readable<V>, representation: Types.Readable<Representation>, key: K) -> Host.Node,
	cellSize: number?,
	hysteresis: number?,
	importance: ((value: V) -> number)?,
	pinned: (Types.Readable<{ [K]: boolean }> | Types.Body<{ [K]: boolean }>)?,
	budget: Budget?,
	status: Types.Cell<Status>?,
}

local KNOWN_FIELDS: { [string]: true } = {
	from = true,
	key = true,
	position = true,
	origin = true,
	tiers = true,
	render = true,
	cellSize = true,
	hysteresis = true,
	importance = true,
	pinned = true,
	budget = true,
	status = true,
}

local KNOWN_BUDGET: { [string]: true } = { mountsPerFrame = true }

local function numberOr(value: unknown, fallback: number): number
	if value == nil then
		return fallback
	end
	if type(value) == "number" and value == value then
		return value
	end
	return fallback
end

local function identity<V>(value: V, _index: number): V
	return value
end

local function spatialCollection<V, K>(options: Options<V, K>): Children.Directive
	local settings = Support.optionsOf(
		options,
		"SpatialCollection",
		"from = ..., position = ..., origin = ..., tiers = ..., render = ..."
	)
	Support.noUnknownFields(settings, "SpatialCollection", KNOWN_FIELDS)

	local source = Support.sourceOf(settings.from, "SpatialCollection", "from") :: Types.Body<{ V }>
	local render =
		Support.builderOf(settings.render, "SpatialCollection", "render") :: (Types.Readable<V>, Types.Readable<Representation>, K) -> Host.Node
	local positionOf =
		Support.builderOf(settings.position, "SpatialCollection", "position") :: (value: V) -> (number, number, number?)
	local originBody = Support.sourceOf(settings.origin, "SpatialCollection", "origin") :: Types.Body<Point>

	local tiers = settings.tiers
	if type(tiers) ~= "table" then
		Diagnostics.raise("collection/no-tiers", "SpatialCollection was given no tier list", {
			primitive = "SpatialCollection",
			actual = Diagnostics.describe(tiers),
			expected = '{ { name = "full", radius = 100 }, ... }',
		})
	end
	Relevance.checkTiers(tiers :: { Tier }, "SpatialCollection")
	local tierCount = #tiers
	local outerRadius = tiers[tierCount].radius

	local keyOf: (value: V, index: number) -> K
	if settings.key ~= nil then
		keyOf = Support.builderOf(settings.key, "SpatialCollection", "key") :: (value: V, index: number) -> K
	else
		keyOf = (identity :: unknown) :: (value: V, index: number) -> K
	end

	local hysteresis = math.max(0, numberOr(settings.hysteresis, 0))
	local cellSize = numberOr(settings.cellSize, math.max(1, outerRadius))
	local importance = settings.importance
	if importance ~= nil then
		importance = Support.builderOf(importance, "SpatialCollection", "importance") :: (value: V) -> number
	end

	local pinnedBody: Types.Body<{ [K]: boolean }>? = nil
	if settings.pinned ~= nil then
		pinnedBody = Support.sourceOf(settings.pinned, "SpatialCollection", "pinned") :: Types.Body<{ [K]: boolean }>
	end

	local budget: Budget = settings.budget or {}
	Support.noUnknownFields(budget, "SpatialCollection.budget", KNOWN_BUDGET)
	local mountsPerFrame = if budget.mountsPerFrame ~= nil
		then math.max(1, math.floor(numberOr(budget.mountsPerFrame, 1)))
		else nil

	local statusCell = if settings.status == nil
		then nil
		else Support.writableOf(settings.status, "SpatialCollection", "status")
	local simpleMovingPopulation = pinnedBody == nil and importance == nil and hysteresis == 0 and mountsPerFrame == nil

	return function(mountPoint: Children.MountPoint)
		local owner = Support.ownerFor "SpatialCollection"
		Support.mountPointOf(mountPoint, "SpatialCollection")
		local tick = cellModule.cell(0)
		local pump = FramePump(owner, mountPoint.host, tick, "SpatialCollection")

		local grid = Grid.create(cellSize)
		local builtFor: { V }? = nil
		local gridFor: { V }? = nil
		local allKeys: { K } = {}
		local indexOfKey: { [K]: number } = {}
		local largestImportance = 1
		local tierOf: { [K]: number } = {}
		local candidates: { number } = {}
		local seen: { [number]: boolean } = {}

		local function select(use: Types.Use, list: { V }): retain.Selection<V, Representation, K>
			local populationChanged = list ~= builtFor
			if populationChanged then
				local count = #list
				table.clear(allKeys)
				table.clear(indexOfKey)
				largestImportance = 1
				if builtFor == nil or not simpleMovingPopulation then
					for index = 1, count do
						local value = list[index]
						local key = keyOf(value, index)
						allKeys[index] = key
						if pinnedBody ~= nil then
							indexOfKey[key] = index
						end
						if importance ~= nil then
							local scale = math.max(0, numberOr((importance :: (value: V) -> number)(value), 1))
							if scale > largestImportance then
								largestImportance = scale
							end
						end
					end
				end
				if builtFor == nil then
					Grid.build(grid, list, function(value: V): (number, number, number)
						local x, y, z = positionOf(value)
						return x, y, z or 0
					end)
					gridFor = list
				else
					gridFor = nil
				end
				builtFor = list
			elseif gridFor ~= list then
				if #allKeys ~= #list then
					for index = 1, #list do
						allKeys[index] = keyOf(list[index], index)
					end
				end
				Grid.build(grid, list, function(value: V): (number, number, number)
					local x, y, z = positionOf(value)
					return x, y, z or 0
				end)
				gridFor = list
			end

			use(tick)

			local origin = originBody(use)
			local ox, oy, oz = numberOr(origin.x, 0), numberOr(origin.y, 0), numberOr(origin.z, 0)
			local pinned: { [K]: boolean }? = if pinnedBody ~= nil then pinnedBody(use) else nil

			local count = #list
			if simpleMovingPopulation and gridFor ~= list then
				local values: { V } = {}
				local keys: { K } = {}
				local states: { Representation } = {}
				local perTier = table.create(tierCount, 0)
				for index = 1, count do
					local value = list[index]
					local x, y, z = positionOf(value)
					local dx, dy, dz = x - ox, y - oy, (z or 0) - oz
					local distance = math.sqrt(dx * dx + dy * dy + dz * dz)
					local tier = Relevance.tierFor(distance, nil, tiers :: { Tier }, 0, 1)
					if tier ~= nil then
						local at = #values + 1
						values[at] = value
						keys[at] = keyOf(value, index)
						states[at] = {
							tier = tier,
							name = (tiers :: { Tier })[tier].name,
							distance = distance,
							pinned = false,
						}
						perTier[tier] += 1
					end
				end
				tierOf = {}
				if statusCell ~= nil then
					statusCell:set {
						total = count,
						retained = #values,
						queried = count,
						pending = 0,
						perTier = perTier,
						cells = 0,
					}
				end
				return { values = values, keys = keys, states = states }
			end

			local queried = 0
			table.clear(candidates)
			table.clear(seen)

			local maxRadius = outerRadius
			if importance ~= nil then
				maxRadius = outerRadius * largestImportance
			end
			maxRadius += hysteresis

			local cells = 0
			if gridFor == list then
				cells = Grid.query(grid, ox, oy, oz, maxRadius, function(index: number)
					if not seen[index] then
						seen[index] = true
						queried += 1
						candidates[#candidates + 1] = index
					end
				end)
			else
				queried = count
				for index = 1, count do
					seen[index] = true
					candidates[index] = index
				end
			end

			if pinned ~= nil then
				for key, isPinned in pinned do
					local index = indexOfKey[key]
					if isPinned and index ~= nil and not seen[index] then
						seen[index] = true
						candidates[#candidates + 1] = index
					end
				end
			end

			local keptIndices: { number } = {}
			local keptTiers: { number } = {}
			local keptDistance: { number } = {}
			local newIndices: { number } = {}
			local newTiers: { number } = {}
			local newDistance: { number } = {}

			table.sort(candidates)
			for _, index in candidates do
				local value = list[index]
				local x, y, z = positionOf(value)
				local dx, dy, dz = x - ox, y - oy, (z or 0) - oz
				local distance = math.sqrt(dx * dx + dy * dy + dz * dz)
				local key = allKeys[index]
				local current = tierOf[key]
				local scale = if importance ~= nil
					then math.max(0, numberOr((importance :: (value: V) -> number)(value), 1))
					else 1

				local tier: number?
				if pinned ~= nil and pinned[key] then
					tier = Relevance.pinnedTier(distance, current, tiers :: { Tier }, hysteresis, scale)
				else
					tier = Relevance.tierFor(distance, current, tiers :: { Tier }, hysteresis, scale)
				end

				if tier ~= nil then
					if current ~= nil then
						keptIndices[#keptIndices + 1] = index
						keptTiers[#keptTiers + 1] = tier
						keptDistance[#keptDistance + 1] = distance
					else
						newIndices[#newIndices + 1] = index
						newTiers[#newTiers + 1] = tier
						newDistance[#newDistance + 1] = distance
					end
				end
			end

			local admission = Admission(#newIndices, mountsPerFrame, function(a: number, b: number): boolean
				if newTiers[a] ~= newTiers[b] then
					return newTiers[a] < newTiers[b]
				end
				if newDistance[a] ~= newDistance[b] then
					return newDistance[a] < newDistance[b]
				end
				return newIndices[a] < newIndices[b]
			end)
			local admitted, pending = admission.admitted, admission.pending
			if admission.order ~= nil then
				local order = admission.order :: { number }
				local chosenIndices = table.create(admitted) :: { number }
				local chosenTiers = table.create(admitted) :: { number }
				local chosenDistance = table.create(admitted) :: { number }
				for position = 1, admitted do
					local at = order[position]
					chosenIndices[position] = newIndices[at]
					chosenTiers[position] = newTiers[at]
					chosenDistance[position] = newDistance[at]
				end
				newIndices, newTiers, newDistance = chosenIndices, chosenTiers, chosenDistance
			end

			pump.update(pending > 0)

			local total = #keptIndices + #newIndices
			local values = table.create(total) :: { V }
			local keys = table.create(total) :: { K }
			local states = table.create(total) :: { Representation }
			local perTier = table.create(tierCount, 0)
			local nextTier: { [K]: number } = {}

			local a, b = 1, 1
			for position = 1, total do
				local takeKept: boolean
				if a > #keptIndices then
					takeKept = false
				elseif b > #newIndices then
					takeKept = true
				else
					takeKept = keptIndices[a] < newIndices[b]
				end

				local index, tier, distance
				if takeKept then
					index, tier, distance = keptIndices[a], keptTiers[a], keptDistance[a]
					a += 1
				else
					index, tier, distance = newIndices[b], newTiers[b], newDistance[b]
					b += 1
				end

				local key = allKeys[index]
				values[position] = list[index]
				keys[position] = key
				states[position] = {
					tier = tier,
					name = (tiers :: { Tier })[tier].name,
					distance = distance,
					pinned = pinned ~= nil and pinned[key] == true,
				}
				perTier[tier] += 1
				nextTier[key] = tier
			end

			tierOf = nextTier

			if statusCell ~= nil then
				statusCell:set {
					total = count,
					retained = total,
					queried = queried,
					pending = pending,
					perTier = perTier,
					cells = cells,
				}
			end

			return { values = values, keys = keys, states = states }
		end

		local inner = retain {
			primitive = "SpatialCollection",
			source = source,
			select = select,
			render = render,
			equals = function(current: Representation, incoming: Representation): boolean
				return current.tier == incoming.tier
					and current.distance == incoming.distance
					and current.pinned == incoming.pinned
			end,
		}
		inner(mountPoint)
	end
end

return spatialCollection
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="309">
                  <Properties>
                    <string name="Name">support</string>
                    <string name="Source"><![CDATA[--!strict

local Active = require "../ownership/active"
local Children = require "../runtime/children"
local Diagnostics = require "../diagnostics"
local Host = require "../host"
local Nodes = require "../ownership/nodes"
local Owner = require "../ownership/owner"
local Types = require "../reactive/types"
local cellModule = require "../reactive/cell"

local function ownerFor(primitive: string): Owner.Owner
	local owner = Active.current()
	if owner == nil then
		Diagnostics.raise("structure/no-active-owner", ("%s ran outside a mount"):format(primitive), {
			contract = "structural primitives belong to the subtree that contains them",
			fix = "use it as a child inside a constructor call, or inside runtime.mount(component, target)",
		})
	end
	return owner :: Owner.Owner
end

local function mountPointOf(mountPoint: unknown, primitive: string): Children.MountPoint
	if type(mountPoint) == "table" and rawget(mountPoint :: { [string]: unknown }, "insert") ~= nil then
		return mountPoint :: Children.MountPoint
	end
	Diagnostics.raise(
		"structure/directive-needs-a-mount-point",
		("%s was called without a mount point"):format(primitive),
		{
			actual = Diagnostics.describe(mountPoint),
			expected = "a mount point, which the parent holding the directive supplies",
			contract = "a structural directive is a child, not a component: it is placed in a parent's "
				.. "children and handed a window on that parent's slot",
			fix = ("use %s as a child inside a constructor call -- Frame { ... } -- and pass the "):format(primitive)
				.. "component that returns that node to runtime.mount(component, target)",
		}
	)
	error("unreachable", 0)
end

local function writableOf<T>(value: unknown, primitive: string, field: string): Types.Cell<T>
	if type(value) == "table" and type((value :: { set: unknown }).set) == "function" then
		return value :: Types.Cell<T>
	end
	Diagnostics.raise(
		"structure/status-not-a-cell",
		("%s was given a %s it cannot write to"):format(primitive, field),
		{
			key = field,
			actual = Diagnostics.describe(value),
			expected = "a cell, created with Compose.cell(...)",
			contract = ("%s writes its report into the cell the caller names, so the caller can read it"):format(
				primitive
			),
			fix = ("create it once -- local %s = Compose.cell(nil) -- and pass that cell"):format(field),
		}
	)
	error("unreachable", 0)
end

local function sourceOf<T>(value: unknown, primitive: string, field: string): Types.Body<T>
	if cellModule.isReadable(value) then
		local readable = value :: Types.Readable<T>
		return function(use: Types.Use): T
			return use(readable)
		end
	end
	if type(value) == "function" then
		return value :: Types.Body<T>
	end
	Diagnostics.raise("structure/source-not-readable", ("%s was given a %s it cannot read"):format(primitive, field), {
		primitive = primitive,
		field = field,
		actual = Diagnostics.describe(value),
		expected = "a cell, a formula, or a function taking `use`",
		fix = ("pass the cell itself -- %s = items -- or a body that reads one"):format(field),
	})
	error("unreachable", 0)
end

local function builderOf<F>(value: F, primitive: string, field: string): F
	if type(value) == "function" then
		return value :: F
	end
	Diagnostics.raise(
		"structure/builder-not-a-function",
		("%s was given a %s it cannot call"):format(primitive, field),
		{
			primitive = primitive,
			field = field,
			actual = Diagnostics.describe(value),
			expected = "a function returning a node, or a list of nodes",
		}
	)
	error("unreachable", 0)
end

local function mountBuilder(
	mountPoint: Children.MountPoint,
	parent: Owner.Owner,
	builder: () -> Host.Node | Children.Directive,
	primitive: string
): Types.Dispose
	local owner = parent.createChild()
	local ok, produced = pcall(Active.withOwner, owner, builder)
	if not ok then
		owner.dispose()
		error(produced, 0)
	end

	if type(produced) == "function" then
		local mounted, err: unknown = pcall(Active.runWith, owner, produced :: Children.Directive, mountPoint)
		if not mounted then
			owner.dispose()
			error(err, 0)
		end
		return owner.dispose
	end

	local kind = type(produced)
	if kind ~= "table" and kind ~= "userdata" then
		owner.dispose()
		Diagnostics.raise(
			"mount/not-a-child",
			("a %s branch returned neither a node nor a directive"):format(primitive),
			{
				actual = Diagnostics.describe(produced),
				expected = "a node, or a directive such as fragment(...) or keyed(...)",
			}
		)
	end

	local inserted, err: unknown = pcall(mountPoint.insert, produced, 1)
	if not inserted then
		owner.dispose()
		error(err, 0)
	end
	owner.own(function()
		mountPoint.remove(produced)
		Nodes.forget(produced)
	end)
	return owner.dispose
end

local function optionsOf<T>(value: T, primitive: string, fields: string): T
	if cellModule.isReadable(value) then
		Diagnostics.raise(
			"structure/options-not-a-table",
			("%s takes one table of named options, and was given a source"):format(primitive),
			{
				primitive = primitive,
				actual = "a cell or formula, passed positionally",
				expected = ("{ %s }"):format(fields),
				fix = ("write %s { %s } -- the arguments are named because they are not distinguishable"):format(
					primitive,
					fields
				),
			}
		)
	end
	if type(value) == "table" then
		return value :: T
	end
	Diagnostics.raise("structure/options-not-a-table", ("%s takes one table of named options"):format(primitive), {
		primitive = primitive,
		actual = Diagnostics.describe(value),
		expected = ("{ %s }"):format(fields),
		fix = ("write %s { %s }"):format(primitive, fields),
	})
	error("unreachable", 0)
end

local function noUnknownFields(options: unknown, primitive: string, known: { [string]: true })
	for field in options :: { [string]: unknown } do
		if known[field] == nil then
			local names: { string } = {}
			for name in known do
				table.insert(names, name)
			end
			table.sort(names)
			Diagnostics.raise(
				"structure/unknown-option",
				("%s was given an option it does not have"):format(primitive),
				{
					primitive = primitive,
					option = tostring(field),
					expected = table.concat(names, ", "),
				}
			)
		end
	end
end

return {
	ownerFor = ownerFor,
	mountPointOf = mountPointOf,
	writableOf = writableOf,
	mountBuilder = mountBuilder,
	sourceOf = sourceOf,
	builderOf = builderOf,
	optionsOf = optionsOf,
	noUnknownFields = noUnknownFields,
}
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="310">
                  <Properties>
                    <string name="Name">switch</string>
                    <string name="Source"><![CDATA[--!strict

local Children = require "../runtime/children"
local Host = require "../host"
local Support = require "./support"
local Types = require "../reactive/types"

export type Builder = () -> Host.Node | Children.Directive

local function switch<K>(source: Types.Source<K>, branches: { [K]: Builder }, fallback: Builder?): Children.Directive
	local from = Support.sourceOf(source, "switch", "source") :: Types.Body<K>
	if type(branches) ~= "table" then
		Support.optionsOf(branches, "switch", "a table of branches keyed by value")
	end
	return function(mountPoint: Children.MountPoint)
		local owner = Support.ownerFor "switch"
		Support.mountPointOf(mountPoint, "switch")
		local disposeCurrent: Types.Dispose? = nil
		local selected: K? = nil
		local started = false

		owner.watch(function(use)
			local key = from(use)
			if started and key == selected then
				return
			end
			started = true
			selected = key

			if disposeCurrent ~= nil then
				disposeCurrent()
				disposeCurrent = nil
			end

			local chosen: Builder? = branches[key]
			if chosen == nil then
				chosen = fallback
			end
			if chosen == nil then
				return
			end

			local pick = chosen :: Builder
			disposeCurrent = Support.mountBuilder(mountPoint, owner, pick, "switch")
		end)
	end
end

return switch
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="311">
                  <Properties>
                    <string name="Name">tile-collection</string>
                    <string name="Source"><![CDATA[--!strict

local Children = require "../runtime/children"
local Diagnostics = require "../diagnostics"
local Host = require "../host"
local Support = require "./support"
local Types = require "../reactive/types"
local keyed = require "./keyed"

export type Viewport = { x: number, y: number, width: number, height: number }
export type Size = { width: number, height: number }
export type Placement = { column: number, row: number, x: number, y: number, width: number, height: number }
export type Options<V> = {
	viewport: Types.Source<Viewport>,
	tileSize: Size,
	overscan: number?,
	read: (use: Types.Use, column: number, row: number) -> V?,
	render: (value: Types.Readable<V>, placement: Placement) -> Host.Node,
}

local KNOWN_FIELDS: { [string]: true } =
	{ viewport = true, tileSize = true, overscan = true, read = true, render = true }

local function finite(value: number): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function tileCollection<V>(options: Options<V>): Children.Directive
	local settings =
		Support.optionsOf(options, "TileCollection", "viewport = ..., tileSize = ..., read = ..., render = ...")
	Support.noUnknownFields(settings, "TileCollection", KNOWN_FIELDS)
	local viewport = Support.sourceOf(settings.viewport, "TileCollection", "viewport") :: Types.Body<Viewport>
	local read = Support.builderOf(settings.read, "TileCollection", "read") :: (Types.Use, number, number) -> V?
	local render =
		Support.builderOf(settings.render, "TileCollection", "render") :: (Types.Readable<V>, Placement) -> Host.Node
	local size = settings.tileSize
	if
		type(size) ~= "table"
		or not finite(size.width)
		or not finite(size.height)
		or size.width <= 0
		or size.height <= 0
	then
		Diagnostics.raise("tile-collection/invalid-size", "TileCollection needs positive finite tile dimensions", {})
	end
	Support.noUnknownFields(size, "TileCollection.tileSize", { width = true, height = true })
	local width, height = size.width, size.height
	local overscan = settings.overscan or 0
	if not finite(overscan) or overscan < 0 or overscan % 1 ~= 0 then
		Diagnostics.raise(
			"tile-collection/invalid-overscan",
			"TileCollection overscan must be a non-negative integer",
			{}
		)
	end

	return function(mountPoint: Children.MountPoint)
		local owner = Support.ownerFor "TileCollection"
		Support.mountPointOf(mountPoint, "TileCollection")
		local keys: { string } = {}
		local placements: { [string]: Placement } = {}
		owner.own(function()
			table.clear(keys)
			table.clear(placements)
		end)

		local function select(use: Types.Use): { V }
			local view = viewport(use)
			if
				not finite(view.x)
				or not finite(view.y)
				or not finite(view.width)
				or not finite(view.height)
				or view.width < 0
				or view.height < 0
			then
				Diagnostics.raise(
					"tile-collection/invalid-viewport",
					"TileCollection needs a finite viewport with non-negative dimensions",
					{}
				)
			end
			local values: { V } = {}
			local nextKeys: { string } = {}
			local nextPlacements: { [string]: Placement } = {}
			if view.width > 0 and view.height > 0 then
				local firstColumn = math.floor(view.x / width) - overscan
				local lastColumn = math.ceil((view.x + view.width) / width) - 1 + overscan
				local firstRow = math.floor(view.y / height) - overscan
				local lastRow = math.ceil((view.y + view.height) / height) - 1 + overscan
				for _, coordinate in { firstColumn, lastColumn, firstRow, lastRow } do
					if not finite(coordinate) or math.abs(coordinate) > 9007199254740990 then
						Diagnostics.raise(
							"tile-collection/invalid-viewport",
							"TileCollection coordinates must be safely representable integers",
							{}
						)
					end
				end
				for row = firstRow, lastRow do
					for column = firstColumn, lastColumn do
						local value = read(use, column, row)
						if value ~= nil then
							local key = string.format("%.0f:%.0f", column + 0, row + 0)
							local placement: Placement? = placements[key]
							if placement == nil then
								local fresh: Placement = {
									column = column,
									row = row,
									x = column * width,
									y = row * height,
									width = width,
									height = height,
								}
								table.freeze(fresh :: {})
								placement = fresh
							end
							values[#values + 1] = value
							nextKeys[#values] = key
							nextPlacements[key] = placement :: Placement
						end
					end
				end
			end
			keys = nextKeys
			placements = nextPlacements
			return values
		end

		keyed {
			from = select,
			key = function(_value: V, index: number): string
				return keys[index]
			end,
			render = function(value: Types.Readable<V>, _index: Types.Readable<number>, key: string): Host.Node
				return render(value, placements[key])
			end,
		}(mountPoint)
	end
end

return tileCollection
]]></string>
                  </Properties>
                </Item>
              </Item>
              <Item class="ModuleScript" referent="312">
                <Properties>
                  <string name="Name">weak</string>
                  <string name="Source"><![CDATA[--!strict

local WEAK_KEYS = table.freeze { __mode = "k" }
local WEAK_VALUES = table.freeze { __mode = "v" }

local function keys<K, V>(): { [K]: V }
	return (setmetatable({} :: { [K]: V }, WEAK_KEYS) :: unknown) :: { [K]: V }
end

local function values<K, V>(): { [K]: V }
	return (setmetatable({} :: { [K]: V }, WEAK_VALUES) :: unknown) :: { [K]: V }
end

return {
	keys = keys,
	values = values,
}
]]></string>
                </Properties>
              </Item>
            </Item>
            <Item class="ModuleScript" referent="313">
