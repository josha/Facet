					table.insert(up, "..")
					at = at.Parent
				end
				table.insert(up, "..")
				node:SetAttribute("FacetFocusPart", table.concat(up, "/"))
			end
			root = chrome.wrap({
				control = control,
				spec = spec,
				plate = plate,
				focus = function()
					if not node:IsFocused() then
						node:CaptureFocus()
					end
				end,
				enabled = enabled,
				message = if numeric or spec.invalid then validationMessage else nil,
				native = rootProps,
			})
		end

		local drawnHeight: ComposeTypes.Readable<number>
		if spec.multiline == true then
			local shown = ctx.observe.Text(node)
			local measure = ctx.text({
				Name = "Measure",
				Text = function(use: ComposeTypes.Use): string
					local text = use(shown)
					return if string.sub(text, -1) == "\n" then text .. " " else text
				end,
				Size = D2.new(1, 0, 0, 100000),
				AutomaticSize = E.AutomaticSize.None,
				Visible = false,
				TextWrapped = true,
				TextTransparency = 1,
				TextXAlignment = E.TextXAlignment.Left,
				TextYAlignment = E.TextYAlignment.Top,
				FontFace = ctx.observeStyled.FontFace(node),
				TextSize = ctx.observeStyled.TextSize(node),
				LineHeight = ctx.observeStyled.LineHeight(node),
			})
			runtime.mount(function()
				return measure
			end, node)
			local measured = ctx.observe.TextBounds(measure)
			drawnHeight = Compose.formula(function(use: ComposeTypes.Use): number
				return use(measured).Y
			end)
		elseif messageNode then
			local bounds = ctx.observe.TextBounds(node)
			drawnHeight = Compose.formula(function(use: ComposeTypes.Use): number
				return use(bounds).Y
			end)
		end
		if spec.multiline == true and not messageNode then
			Compose.watch(function(use: ComposeTypes.Use)
				textHeight:set(use(drawnHeight))
			end)
		end
		if messageNode then
			local messageBounds = ctx.observe.TextBounds(messageNode)
			Compose.watch(function(use: ComposeTypes.Use)
				textHeight:set(use(drawnHeight))
				messageHeight:set(use(messageBounds).Y)
			end)
		end
		if mayReject then
			local wasInvalid = false
			Compose.watch(function(use: ComposeTypes.Use)
				local sourceInvalid = read(spec.invalid, use) == true
				if sourceInvalid and not wasInvalid and not invalid:peek() then
					markInvalid(true)
				end
				if not sourceInvalid and wasInvalid then
					markInvalid(false)
				end
				wasInvalid = sourceInvalid
				if assert(errorReduced)(use) then
					assert(errorTimeline):pause()
					assert(errorTimeline):seek(0.24)
				end
			end)
		end
		attachEditing = Compose.bindOwner(function()
			ctx.action(node, "TextEditing", {
				E.KeyCode.Up,
				E.KeyCode.Down,
				E.KeyCode.Left,
				E.KeyCode.Right,
				E.KeyCode.DPadUp,
				E.KeyCode.DPadDown,
				E.KeyCode.DPadLeft,
				E.KeyCode.DPadRight,
			}, editing, function() end, { priority = 10000 })
			local _, editingContext = ctx.action(
				node,
				"Cancel",
				{ E.KeyCode.Escape, E.KeyCode.ButtonB },
				editing,
				cancel,
				{ priority = 10000 }
			)
			local nativeEditingAvailable = ctx.observe.Enabled(editingContext)
			Compose.watch(function(use: ComposeTypes.Use)
				if not use(nativeEditingAvailable) and editing:peek() then
					editing:set(false)
					releaseFocus()
				end
			end)
		end)
		local inputService = ctx.config.services.UserInputService
		if inputService then
			local touchLive = ctx.observe.TouchEnabled(inputService)
			local keyboardLive = ctx.observe.KeyboardEnabled(inputService)
			local hadTouch = touchLive:peek() == true
			Compose.watch(function(use: ComposeTypes.Use)
				local touchNow = use(touchLive) == true
				local keyboardNow = use(keyboardLive) == true
				if hadTouch and not touchNow and not keyboardNow and editing:peek() then
					releaseFocus()
				end
				hadTouch = touchNow
			end)
		end
		runtime.connect(node, "ReturnPressedFromOnScreenKeyboard", function()
			if spec.multiline ~= true then
				commit("submit")
				releaseFocus()
			end
		end)
		attributes(node, {
			invalid = function(use: ComposeTypes.Use)
				return use(invalid) or read(spec.invalid, use) == true
			end,
			validationMessage = function(use: ComposeTypes.Use): string
				return use(validationMessage)
			end,
			readOnly = function(use: ComposeTypes.Use)
				return readOnly(use)
			end,
		})
		if spec.label ~= nil or spec.presentation == "search" then
			attributes(node, {
				AccessibleLabel = function(use: ComposeTypes.Use): string
					if spec.label ~= nil then
						return chrome.labelText(spec, use)
					end
					local placeholder = read(spec.placeholder, use)
					return if placeholder ~= nil and placeholder ~= "" then placeholder else "Search"
				end,
			})
		end
		if spec.selectOnFocus ~= nil then
			attributes(node, {
				selectOnFocus = function(use: ComposeTypes.Use): string
					local ok, policy = pcall(policyOf, read(spec.selectOnFocus, use))
					return if ok then policy :: string else lastPolicy
				end,
			})
		end
		if spec.selectOnFocus ~= nil and dynamic(spec.selectOnFocus) then
			Compose.watch(function(use: ComposeTypes.Use)
				lastPolicy = policyOf(read(spec.selectOnFocus, use))
			end)
		end
		Compose.cleanup(assert(runtime.host.observation).observeProperty(node, "Text", function()
			if not writing and editing:peek() then
				propose(node.Text)
			end
		end))
		Compose.watch(function(use: ComposeTypes.Use)
			setText(read(spec.value, use))
			if enabled(use) then
				node:RemoveTag("facet-disabled")
			else
				node:AddTag("facet-disabled")
			end
			if not enabled(use) and editing:peek() then
				editing:set(false)
				releaseFocus()
			end
		end)

		local function endScrub(restore: boolean)
			local active = scrubbing
			if active == nil then
				return
			end
			scrubbing = nil
			if restore and not disposed then
				assert(spec.numericValue):set(active.start)
				updateValue(active.text)
				setText(read(spec.value))
			elseif restore then
				assert(spec.numericValue):set(active.start)
				if writable(spec.value) then
					(spec.value :: ComposeTypes.Cell<string>):set(active.text)
				end
			end
		end
		local function scrubAllowed(use: ComposeTypes.Use?): boolean
			return read(spec.scrub, use) == true and editable(use)
		end
		local onScrub: textPress.Scrub? = nil
		if numeric and spec.scrub ~= nil then
			onScrub = function(phase: textPress.Phase, argument: (string | number)?): boolean
				if disposed then
					return false
				end
				local numericValue = assert(spec.numericValue)
				if phase == "press" then
					return scrubAllowed()
				elseif phase == "begin" then
					if not scrubAllowed() then
						return false
					end
					local start = numericValue:peek()
					local text = if editing:peek() then snapshot else read(spec.value)
					scrubbing = { start = start, text = text, written = start, promoted = true }
					updateValue(text)
					setText(read(spec.value))
					markInvalid(false)
					return true
				elseif phase == "move" then
					local active = scrubbing
					if active == nil or type(argument) ~= "number" then
						return false
					end
					local travel = argument :: number
					local count = math.floor(math.abs(travel) / SCRUB_PIXELS) * (if travel < 0 then -1 else 1)
					local number = stepped(active.start, count)
					if number ~= numericValue:peek() then
						active.written = number
						settleNumber(number, "submit", false)
						active.written = numericValue:peek()
					end
					return true
				elseif phase == "end" then
					local active = scrubbing
					if active == nil then
						return false
					end
					scrubbing = nil
					if spec.onCommit then
						(spec.onCommit :: (number, InputTypes.CommitReason) -> ())(numericValue:peek(), "submit")
					end
					return true
				end
				endScrub(true)
				return true
			end
			Compose.watch(function(use: ComposeTypes.Use)
				local number = use(assert(spec.numericValue))
				local active = scrubbing
				if active ~= nil and number ~= active.written then
					scrubbing = nil
				end
			end)
			Compose.watch(function(use: ComposeTypes.Use)
				if not scrubAllowed(use) then
					endScrub(true)
				end
			end)
			local input = ctx.config.services.UserInputService
			if input then
				local preferred = ctx.observe.PreferredInput(input)
				local first = true
				Compose.watch(function(use: ComposeTypes.Use)
					use(preferred)
					if not first then
						endScrub(true)
					end
					first = false
				end)
			end
		end
		local input = ctx.config.services.UserInputService
		if input and (spec.selectOnFocus ~= nil or onScrub ~= nil) then
			Compose.cleanup(textPress({
				box = node,
				input = input,
				Enum = (E :: unknown) :: typeof(Enum),
				policy = function(): string?
					return lastPolicy
				end,
				disabled = function(): boolean
					return not enabled()
				end,
				onScrub = onScrub,
			}))
		end
		Compose.cleanup(function()
			endScrub(true)
			disposed = true
		end)
		if not framed then
			ctx.skin(node, "field", {
				disabled = function(use: ComposeTypes.Use)
					return not enabled(use)
				end,
			})
		end
		if pulse then
			local geometry = if framed then rootProps else nativeProps
			feedbackPaint(ctx, root, pulse, { Size = geometry.Size, AutomaticSize = geometry.AutomaticSize })
		end
		return root
	end
	local textInput = ctx.construct("TextInput", function(spec: Spec): TextBox | Frame
		return build("TextInput", spec)
	end)
	UI.TextInput = (textInput :: unknown) :: typeof(UI.TextInput)
	local numberInput = ctx.construct("NumberInput", function(spec: Spec): TextBox | Frame
		if spec.presentation ~= nil then
			error("Facet UI.NumberInput: NumberInput IS the number presentation; remove presentation", 0)
		end
		local number = table.clone(spec)
		number.presentation = "number"
		return build("NumberInput", number)
	end)
	UI.NumberInput = (numberInput :: unknown) :: typeof(UI.NumberInput)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="216">
            <Properties>
              <string name="Name">text_measure</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local ComposeTypes = require("../vendor/compose/core")

local pending = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [Instance]: number }

local function hold(node: Instance): () -> ()
	pending[node] = (pending[node] or 0) + 1
	local active = true
	return function()
		if active then
			active = false
			local remaining = (pending[node] or 1) - 1
			if remaining > 0 then
				pending[node] = remaining
			else
				pending[node] = nil
			end
		end
	end
end

local shared = (setmetatable({}, { __mode = "k" }) :: unknown) :: {
	[Instance]: ComposeTypes.AcquireSharedResource<ComposeTypes.Readable<Vector2>>,
}

local function createNatural(
	ctx: Types.Context,
	label: TextLabel | TextButton | TextBox,
	fallback: (() -> ComposeTypes.Readable<Vector2>)?,
	revision: ComposeTypes.Cell<number>?
): ComposeTypes.Readable<Vector2>
	local Compose, Host = ctx.Compose, ctx.Host
	local service = ctx.config.services.TextService
	local bounds = Compose.cell(ctx.types.Vector2.new(math.huge, 0))
	if service == nil then
		return if fallback then fallback() else bounds
	end
	local params = (
		((Host :: unknown) :: { GetTextBoundsParams: ({ Width: number }) -> GetTextBoundsParams }).GetTextBoundsParams
	)({ Width = 0 })
	local text = if revision then nil else ctx.observe.Text(label)
	local rich = if revision then nil else ctx.observe.RichText(label)
	local font = if revision then nil else ctx.observeStyled.FontFace(label)
	local points = if revision then nil else ctx.observeStyled.TextSize(label)
	local serial, alive = 0, true
	local last: string? = nil
	local thread: thread? = nil
	local release: (() -> ())? = nil
	local function cancel()
		if release then
			release()
			release = nil
		end
		if thread and coroutine.status(thread) == "suspended" and task then
			pcall(task.cancel, thread)
		end
		thread = nil
	end
	Compose.cleanup(function()
		alive = false
		cancel()
	end)
	Compose.watch(function(use: ComposeTypes.Use)
		if revision then
			use(revision)
		end
		local words = if text then use(text) else label.Text
		local markup = if rich then use(rich) else label.RichText
		local face = if font then use(font) else label:GetStyled("FontFace") :: Font
		local size = if points then use(points) else label:GetStyled("TextSize") :: number
		local key = `{#words}:{words}|{markup}|{face.Family}|{face.Weight.Name}|{face.Style.Name}|{size}`
		if key == last then
			return
		end
		last = key
		serial += 1
		local ticket = serial
		cancel()
		local completed = hold(label)
		release = completed
		if revision then
			bounds:set(ctx.types.Vector2.new(math.huge, 0))
		end
		params.Text, params.RichText, params.Font, params.Size = words, markup, face, size
		local function measure()
			local ok, value = pcall(function(): Vector2
				return service:GetTextBoundsAsync(params)
			end)
			if alive and ticket == serial then
				if ok then
					bounds:set(value)
				end
				completed()
			end
		end
		if task and task.spawn then
			thread = task.spawn(measure)
		else
			measure()
		end
	end)
	return bounds
end

return {
	hold = hold,
	natural = function(
		ctx: Types.Context,
		label: TextLabel | TextButton | TextBox,
		fallback: (() -> ComposeTypes.Readable<Vector2>)?,
		revision: ComposeTypes.Cell<number>?
	): ComposeTypes.Readable<Vector2>
		if ctx.config.services.TextService == nil then
			return if fallback then fallback() else ctx.Compose.cell(ctx.types.Vector2.new(math.huge, 0))
		end
		local acquire = shared[label]
		if not acquire then
			acquire = ctx.Compose.createSharedResource(function(): (ComposeTypes.Readable<Vector2>, (() -> ())?)
				ctx.Compose.cleanup(function()
					shared[label] = nil
				end)
				return createNatural(ctx, label, nil, revision), nil
			end)
			shared[label] = acquire
		end
		return acquire()
	end,
	ready = function(node: Instance): boolean
		if pending[node] ~= nil then
			return false
		end
		if node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox") then
			local automatic = node.AutomaticSize.Name
			if
				node.Text ~= ""
				and node.TextWrapped
				and node.TextTruncate.Name == "None"
				and (automatic == "Y" or automatic == "XY")
			then
				return node.TextFits
			end
		end
		return true
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="217">
            <Properties>
              <string name="Name">text_press</string>
              <string name="Source"><![CDATA[--!strict
export type Phase = "press" | "begin" | "move" | "end" | "cancel"
export type Scrub = (Phase, (string | number)?) -> boolean
export type Options = {
	box: TextBox,
	input: UserInputService,
	Enum: typeof(Enum),
	policy: () -> string?,
	disabled: () -> boolean,
	onScrub: Scrub?,
}
type Press = {
	touch: InputObject?,
	connections: { RBXScriptConnection },
	start: Vector3?,
	scrub: boolean,
	promoted: boolean,
	gate: number,
}

local POINTER_SLOP, TOUCH_SLOP = 6, 14

return function(options: Options): () -> ()
	local box, input, E = options.box, options.input, options.Enum
	local pending: string? = nil
	local press: Press? = nil
	local function select(policy: string)
		if options.disabled() or not box:IsFocused() then
			return
		end
		box.CursorPosition = #box.Text + 1
		box.SelectionStart = if policy == "all" then 1 else -1
	end
	local function finish(phase: Phase)
		local ended = press
		if ended ~= nil then
			press = nil
			for _, connection in ended.connections do
				connection:Disconnect()
			end
			if ended.promoted and options.onScrub then
				options.onScrub(phase)
			end
		end
	end
	local function follow(touch: InputObject?): Press
		local current: Press = { touch = touch, connections = {}, scrub = false, promoted = false, gate = POINTER_SLOP }
		press = current
		table.insert(
			current.connections,
			input.InputEnded:Connect(function(event: InputObject)
				local origin = if current.touch ~= nil
					then event == current.touch
					else event.UserInputType == E.UserInputType.MouseButton1
				if not origin then
					return
				end
				finish("end")
				if pending ~= nil then
					local policy = pending
					pending = nil
					select(policy)
				end
			end)
		)
		table.insert(
			current.connections,
			input.InputChanged:Connect(function(event: InputObject)
				local moved = if current.touch ~= nil
					then event == current.touch
					else event.UserInputType == E.UserInputType.MouseMovement
				local start = current.start
				if not current.scrub or not moved or start == nil then
					return
				end
				local dx, dy = event.Position.X - start.X, event.Position.Y - start.Y
				if not current.promoted then
					if dx * dx + dy * dy < current.gate * current.gate then
						return
					end
					local scrub = options.onScrub
					if math.abs(dx) <= math.abs(dy) or scrub == nil or not scrub("begin") then
						current.scrub = false
						return
					end
					current.promoted, pending = true, nil
					if box:IsFocused() then
						box:ReleaseFocus(false)
					end
				end
				local scrub = options.onScrub
				if scrub then
					scrub("move", dx)
				end
			end)
		)
		table.insert(
			current.connections,
			input.InputBegan:Connect(function(event: InputObject)
				if current.promoted and (event.KeyCode == E.KeyCode.Escape or event.KeyCode == E.KeyCode.ButtonB) then
					finish("cancel")
				end
			end)
		)
		return current
	end
	local connections: { RBXScriptConnection } = {
		box.InputBegan:Connect(function(event: InputObject)
			local touch = event.UserInputType == E.UserInputType.Touch
			if not touch and event.UserInputType ~= E.UserInputType.MouseButton1 then
				return
			end
			local current = press
			if not touch and current ~= nil and current.start ~= nil and current.touch == nil then
				finish("cancel")
				current = nil
			end
			if current ~= nil and (current.start ~= nil or touch or current.touch ~= nil) then
				return
			end
			local scrub = options.onScrub ~= nil and options.onScrub("press", if touch then "touch" else "pointer")
			if current == nil then
				local policy = options.policy()
				local selects = policy == "all" or policy == "end"
				if not scrub and not (touch and selects) then
					return
				end
				current = follow(if touch then event else nil)
			end
			local active = assert(current)
			active.start, active.scrub = event.Position, scrub == true
			active.gate = if touch then TOUCH_SLOP else POINTER_SLOP
		end),
		box.Focused:Connect(function()
			local policy = options.policy()
			pending = nil
			if policy ~= "all" and policy ~= "end" then
				return
			end
			local held = (
				input :: unknown
			) :: { IsMouseButtonPressed: ((UserInputService, Enum.UserInputType) -> boolean)? }
			local mouseDown = held.IsMouseButtonPressed ~= nil
				and input:IsMouseButtonPressed(E.UserInputType.MouseButton1)
			if press ~= nil or mouseDown then
				pending = policy
				if press == nil then
					follow(nil)
				end
			else
				select(policy)
			end
		end),
		box.FocusLost:Connect(function()
			pending = nil
		end),
	}
	return function()
		pending = nil
		finish("cancel")
		for _, connection in connections do
			connection:Disconnect()
		end
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="218">
            <Properties>
              <string name="Name">text_reveal</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local ComposeTypes = require("../vendor/compose/core")
local reducedMotion = require("./motion").reduced

local PAUSE, GLYPHS_PER_SECOND, SLACK = 1.2, 3, 2

local moving = setmetatable({} :: { [Types.Context]: TextLabel? }, { __mode = "k" })

return function(ctx: Types.Context, label: TextLabel, plateShown: ComposeTypes.Readable<boolean>)
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local D2 = ctx.types.UDim2
	local frames = runtime.host.frames
	if frames == nil then
		return
	end
	local reduced = reducedMotion(ctx)
	local fits, text = ctx.observe.TextFits(label), ctx.observe.Text(label)
	local travel = Compose.cell(0)
	local phase, clock = "rest", 0
	local seconds: number? = nil
	local unmount: (() -> ())? = nil
	local stopFrames: (() -> ())? = nil
	local function release()
		if unmount then
			unmount()
			unmount = nil
		end
		if moving[ctx] == label then
			moving[ctx] = nil
		end
		seconds = nil
	end
	local function strip(): { Instance }
		local full = ctx.text({
			Name = "Full",
			Text = function(use: ComposeTypes.Use): string
				return use(text)
			end,
			Size = D2.fromScale(0, 1),
			AutomaticSize = ctx.types.Enum.AutomaticSize.X,
			TextYAlignment = label.TextYAlignment,
			RichText = label.RichText,
		})
		for _, tag in label:GetTags() do
			full:AddTag(tag)
		end
		local bounds = ctx.observe.TextBounds(label)
		local window = Host.Frame "Reveal" {
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Size = function(use: ComposeTypes.Use): UDim2
				return D2.new(1, 0, 0, use(bounds).Y)
			end,
			full,
		}
		local room, width = ctx.observe.AbsoluteSize(window), ctx.observe.AbsoluteSize(full)
		runtime.decorate(full, {
			Position = function(use: ComposeTypes.Use): UDim2
				local inside = use(room).X
				local over = math.max(0, use(width).X - inside)
				over += if over > 0 then SLACK else 0
				return D2.fromScale(if inside > 0 then -over / inside * use(travel) else 0, 0)
			end,
		})
		Compose.watch(function(use: ComposeTypes.Use)
			local inside, whole = use(room).X, use(width).X
			local glyphs = utf8.len(use(text)) or 0
			seconds = if whole > 0 then math.max(0, whole - inside) / whole * glyphs / GLYPHS_PER_SECOND else nil
		end)
		return { window, Host.UIGradient "RevealHold" { Transparency = ctx.types.NumberSequence.new(1) } }
	end
	local function step(delta: number)
		clock += delta
		if phase == "rest" then
			if clock >= PAUSE and moving[ctx] == nil then
				moving[ctx] = label
				unmount = runtime.mountFragment(strip, label)
				phase, clock = "out", 0
			end
		elseif phase == "end" then
			if clock >= PAUSE then
				phase, clock = "back", 0
			end
		elseif seconds == nil then
			clock = 0
		else
			local total = seconds :: number
			local progress = if total > 0 then math.min(1, clock / total) else 1
			travel:set(if phase == "out" then progress else 1 - progress)
			if progress >= 1 then
				if phase == "back" then
					release()
				end
				phase, clock = if phase == "out" then "end" else "rest", 0
			end
		end
	end
	local function reset()
		if stopFrames then
			stopFrames()
			stopFrames = nil
		end
		release()
		phase, clock = "rest", 0
		travel:set(0)
	end
	Compose.watch(function(use: ComposeTypes.Use)
		use(text)
		local active = not use(fits) and not reduced(use) and not use(plateShown)
		reset()
		if active then
			stopFrames = frames.onFrame(step)
		end
	end)
	Compose.cleanup(reset)
end
]]></string>
            </Properties>
