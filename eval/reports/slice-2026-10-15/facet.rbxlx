          <Item class="ModuleScript" referent="210">
            <Properties>
              <string name="Name">selection</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Shared = require("./types")
local Env = require("./environment_types")

type Level = { child: Instance, parent: Instance, siblings: { Instance } }
type Snapshot = { node: GuiObject, levels: { Level }, modal: boolean }

type Record = { root: Instance, passive: boolean, engaged: ComposeTypes.Cell<boolean> }
export type Selection = {
	track: (Instance) -> (),
	responder: (Instance, Env.ResponderOptions?) -> Env.Responder,
	spaceActivates: (Instance) -> (ComposeTypes.Use) -> boolean,
}

local RESPONDER_KEYS = { passive = true, gameplayGuard = true, traversalWrap = true }

local KEYBOARD_NAVIGATION_DEFAULT = true

return function(ctx: Shared.Context): Selection
	local Compose, runtime, config = ctx.Compose, ctx.runtime, ctx.config
	local E = ctx.types.Enum
	local gui = config.guiService
	local input = config.userInputService
	local responders = Compose.cell({} :: { Record })
	local keyboardNavigation = if config.keyboardNavigation == nil
		then KEYBOARD_NAVIGATION_DEFAULT
		else config.keyboardNavigation
	local registry = (
		setmetatable({} :: { [Instance]: boolean }, { __mode = "k" }) :: unknown
	) :: { [Instance]: boolean }
	local directionKeys = { E.KeyCode.DPadUp, E.KeyCode.DPadDown, E.KeyCode.DPadLeft, E.KeyCode.DPadRight }

	local function ordered(parent: Instance): { Instance }
		local children = parent:GetChildren()
		local sorted = parent:GetAttribute("FacetDocumentOrder") == true
		for _, child in children do
			if child:IsA("UIGridStyleLayout") and child.SortOrder == E.SortOrder.LayoutOrder then
				sorted = true
				break
			end
		end
		if not sorted then
			return children
		end
		local index: { [Instance]: number } = {}
		for position, child in children do
			index[child] = position
		end
		table.sort(children, function(a: Instance, b: Instance): boolean
			local left = if a:IsA("GuiObject") then a.LayoutOrder else 0
			local right = if b:IsA("GuiObject") then b.LayoutOrder else 0
			if left ~= right then
				return left < right
			end
			return index[a] < index[b]
		end)
		return children
	end

	local function shown(node: Instance?): boolean
		local at = node
		while at do
			if at:IsA("GuiObject") and (not at.Visible or not at.Interactable) then
				return false
			end
			if at:IsA("LayerCollector") then
				return at.Enabled
			end
			at = at.Parent
		end
		return false
	end

	local function collect(node: Instance, into: { GuiObject }): ()
		if node:IsA("GuiObject") then
			if not node.Visible or not node.Interactable then
				return
			end
			if node.Selectable then
				table.insert(into, node)
			end
		elseif node:IsA("LayerCollector") and not node.Enabled then
			return
		end
		for _, child in ordered(node) do
			collect(child, into)
		end
	end

	local function candidates(root: Instance): { GuiObject }
		local list: { GuiObject } = {}
		collect(root, list)
		return list
	end

	local function collectorOf(node: Instance): LayerCollector?
		return node:FindFirstAncestorWhichIsA("LayerCollector")
	end

	local function topModal(): Instance?
		local scopes = ctx.modalScopes:peek()
		for index = #scopes, 1, -1 do
			if shown(scopes[index]) then
				return scopes[index]
			end
		end
		return nil
	end

	local function screens(): { LayerCollector }
		local found: { [LayerCollector]: boolean } = {}
		local list: { LayerCollector } = {}
		for node in registry do
			local collector = collectorOf(node)
			if collector and not found[collector] and collector.Enabled then
				found[collector] = true
				table.insert(list, collector)
			end
		end
		table.sort(list, function(a: LayerCollector, b: LayerCollector): boolean
			local left = if a:IsA("ScreenGui") then a.DisplayOrder else 0
			local right = if b:IsA("ScreenGui") then b.DisplayOrder else 0
			return left > right
		end)
		return list
	end

	local function rectOf(node: GuiObject): ComposeTypes.FocusRect
		local at, size = node.AbsolutePosition, node.AbsoluteSize
		return { x = at.X, y = at.Y, width = size.X, height = size.Y }
	end

	local function scopeOf(selected: Instance?): { GuiObject }
		local modal = topModal()
		if modal then
			return candidates(modal)
		end
		if selected and shown(selected) then
			local collector = collectorOf(selected)
			if collector then
				return candidates(collector)
			end
		end
		local records = responders:peek()
		for index = #records, 1, -1 do
			local record = records[index]
			if record.passive and record.engaged:peek() and shown(record.root) then
				local list = candidates(record.root)
				if #list > 0 then
					return list
				end
			end
		end
		for _, screen in screens() do
			local list = candidates(screen)
			if #list > 0 then
				return list
			end
		end
		return {}
	end

	local function beyond(container: GuiObject, from: GuiObject): GuiObject?
		local fp, fs = from.AbsolutePosition, from.AbsoluteSize
		local cp, cs = container.AbsolutePosition, container.AbsoluteSize
		local dx = (cp.X + cs.X / 2) - (fp.X + fs.X / 2)
		local dy = (cp.Y + cs.Y / 2) - (fp.Y + fs.Y / 2)
		local vertical = cp.Y >= fp.Y + fs.Y or cp.Y + cs.Y <= fp.Y or math.abs(dy) >= math.abs(dx)
		local direction: ComposeTypes.FocusDirection = if vertical
			then (if dy >= 0 then "down" else "up")
			else (if dx >= 0 then "right" else "left")
		local pool, rects = {}, {}
		for _, candidate in scopeOf(from) do
			if
				candidate ~= from
				and candidate ~= container
				and not candidate:IsA("ScrollingFrame")
				and not candidate:IsDescendantOf(container)
			then
				table.insert(pool, candidate)
				table.insert(rects, rectOf(candidate))
			end
		end
		local index = Compose.focusNeighbor(rectOf(from), rects, direction)
		return if index then pool[index] else nil
	end

	local function entryOf(container: GuiObject, from: GuiObject?): GuiObject?
		local list = candidates(container)
		if list[1] == container then
			table.remove(list, 1)
		end
		if #list == 0 then
			if from == nil or not shown(from) or from:IsDescendantOf(container) then
				return nil
			end
			return beyond(container, from) or from
		end
		if from and table.find(list, from) then
			return from
		end
		local entry = container:GetAttribute("FacetEntry")
		if type(entry) == "string" then
			for _, candidate in list do
				if candidate.Name == entry then
					return candidate
				end
			end
		end
		local target = list[1]
		if from and from ~= container and not from:IsDescendantOf(container) then
			local source = from.AbsolutePosition + from.AbsoluteSize / 2
			local box, window = container.AbsolutePosition, container.AbsoluteSize
			local vertical = source.Y <= box.Y or source.Y >= box.Y + window.Y
			local best = math.huge
			for _, candidate in list do
				local at, extent = candidate.AbsolutePosition, candidate.AbsoluteSize
				local edge = if vertical
					then (if source.Y <= box.Y then at.Y - box.Y else box.Y + window.Y - at.Y - extent.Y)
					else (if source.X <= box.X then at.X - box.X else box.X + window.X - at.X - extent.X)
				local across = if vertical
					then math.abs(at.X + extent.X / 2 - source.X)
					else math.abs(at.Y + extent.Y / 2 - source.Y)
				local score = math.max(edge, 0) * 100000 + across
				if score < best then
					best, target = score, candidate
				end
			end
		end
		return target
	end

	local function wraps(node: Instance): boolean
		local at: Instance? = node
		while at do
			if at:GetAttribute("FacetTraversalWrap") == false then
				return false
			end
			at = at.Parent
		end
		return true
	end

	local function traverse(step: number): ()
		if gui == nil then
			return
		end
		local selected = gui.SelectedObject
		local list = {}
		for _, node in scopeOf(selected) do
			if not node:IsA("ScrollingFrame") or node:GetAttribute("FacetSelectionOwner") == true then
				table.insert(list, node)
			end
		end
		if #list == 0 then
			return
		end
		local position: { [GuiObject]: number } = {}
		for index, node in list do
			position[node] = index
		end
		table.sort(list, function(a: GuiObject, b: GuiObject): boolean
			if a.SelectionOrder ~= b.SelectionOrder then
				return a.SelectionOrder < b.SelectionOrder
			end
			return position[a] < position[b]
		end)
		local at = if selected then table.find(list, selected) else nil
		if at and (at + step < 1 or at + step > #list) and not wraps(list[at]) then
			return
		end
		local target = if at then list[(at - 1 + step) % #list + 1] elseif step < 0 then list[#list] else list[1]
		local editing = if input and input.GetFocusedTextBox then input:GetFocusedTextBox() else nil
		if editing and editing ~= target then
			editing:ReleaseFocus(false)
		end
		gui.SelectedObject = target
	end

	local function resting(node: Instance): boolean
		for _, record in responders:peek() do
			if record.passive and not record.engaged:peek() and node:IsDescendantOf(record.root) then
				return true
			end
		end
		return false
	end

	local function enter(): ()
		local gamepad = config.services.GamepadService
		if gui == nil or (gamepad and gamepad.GamepadCursorEnabled) then
			return
		end
		local selected = gui.SelectedObject
		if selected and shown(selected) then
			return
		end
		for _, candidate in scopeOf(nil) do
			if not resting(candidate) then
				gui.SelectedObject = candidate
				return
			end
		end
	end

	local function snapshot(node: GuiObject): Snapshot
		local levels: { Level } = {}
		local modal = false
		local scopes = ctx.modalScopes:peek()
		local child: Instance = node
		local parent = node.Parent
		while parent do
			if table.find(scopes, child) then
				modal = true
			end
			table.insert(levels, { child = child, parent = parent, siblings = ordered(parent) })
			if parent:IsA("LayerCollector") then
				break
			end
			child, parent = parent, parent.Parent
		end
		return { node = node, levels = levels, modal = modal }
	end

	local function keyed(record: Snapshot): boolean
		for _, level in record.levels do
			if level.parent:GetAttribute("FacetSelectionOwner") == true and shown(level.parent) then
				return true
			end
		end
		return false
	end

	local function survivor(record: Snapshot): GuiObject?
		for _, level in record.levels do
			local parent = level.parent
			if shown(parent) then
				local at = table.find(level.siblings, level.child) or 0
				for index = at + 1, #level.siblings do
					local sibling = level.siblings[index]
					if sibling.Parent == parent then
						local list = candidates(sibling)
						if list[1] then
							return list[1]
						end
					end
				end
				for index = at - 1, 1, -1 do
					local sibling = level.siblings[index]
					if sibling.Parent == parent then
						local list = candidates(sibling)
						if list[#list] then
							return list[#list]
						end
					end
				end
			end
		end
		return nil
	end

	local function inputHost(): Instance?
		local parent = config.inputParent
		if parent == nil then
			local players = config.services.Players
			local player = if players then players.LocalPlayer else nil
			parent = if player then player:FindFirstChildOfClass("PlayerGui") else nil
		end
		return parent
	end

	local acquire = Compose.createSharedResource(function(): (nil, (() -> ())?)
		local service = gui
		local keys = input
		if service == nil or keys == nil then
			return nil, nil
		end
		if not service.GetPropertyChangedSignal then
			return nil, nil
		end
		local selectedObject = ctx.observe.SelectedObject(service)
		local gamepad = config.services.GamepadService
		if gamepad then
			local cursor = ctx.observe.GamepadCursorEnabled(gamepad)
			Compose.watch(function(use: ComposeTypes.Use)
				if use(cursor) then
					service.SelectedObject = nil
				end
			end)
		end
		local keyboard = ctx.observe.KeyboardEnabled(keys)
		local preferred = ctx.observe.PreferredInput(keys)
		local padPreferred, padMade = false, false
		local function ownedByFacet(node: Instance?): boolean
			while node do
				if registry[node] then
					return true
				end
				node = node.Parent
			end
			return false
		end
		Compose.watch(function(use: ComposeTypes.Use)
			local selected = use(selectedObject)
			local last = if keys.GetLastInputType then keys:GetLastInputType() else nil
			padMade = last ~= nil and string.find(last.Name, "^Gamepad") ~= nil and ownedByFacet(selected)
		end)
		Compose.watch(function(use: ComposeTypes.Use)
			local pad = use(preferred) == E.PreferredInput.Gamepad
			if padPreferred and not pad and padMade and service.SelectedObject ~= nil then
				service.SelectedObject = nil
			end
			padPreferred = pad
		end)
		local record: Snapshot? = nil
		local pending = false
		local function recover(): ()
			pending = false
			local current = service.SelectedObject
			if current and shown(current) then
				return
			end
			local previous = record
			if previous == nil or previous.modal or keyed(previous) then
				return
			end
			if shown(previous.node) and previous.node.Selectable then
				return
			end
			local target = survivor(previous)
			if target then
				service.SelectedObject = target
			end
		end
		local wake = Compose.cell(0)
		Compose.watch(function(use: ComposeTypes.Use)
			if use(wake) > 0 and pending then
				recover()
			end
		end)
		local function schedule(): ()
			if pending or record == nil or record.modal or keyed(record) then
				return
			end
			pending = true
			wake:set(wake:peek() + 1)
		end
		local owner = assert(Compose.currentOwner())
		local tracking: ComposeTypes.Owner? = nil
		local function track(current: GuiObject): ()
			if tracking then
				tracking.dispose()
			end
			local child = owner.createChild()
			tracking = child
			Compose.withOwner(child, function()
				local sources: { ComposeTypes.Readable<unknown> } = { ctx.observe.Parent(current) }
				local at: Instance? = current
				while at do
					if at:IsA("GuiObject") then
						table.insert(sources, ctx.observe.Visible(at))
						table.insert(sources, ctx.observe.Interactable(at))
					elseif at:IsA("LayerCollector") then
						table.insert(sources, ctx.observe.Enabled(at))
						break
					end
					at = at.Parent
				end
				Compose.watch(function(use: ComposeTypes.Use)
					for _, source in sources do
						use(source)
					end
					if service.SelectedObject == current and not shown(current) then
						schedule()
					end
				end)
			end)
		end
		local function forward(container: ScrollingFrame): boolean
			if container:GetAttribute("FacetSelectionOwner") == true then
				return false
			end
			local target = entryOf(container, if record then record.node else nil)
			if target == nil then
				return false
			end
			service.SelectedObject = target
			return true
		end
		Compose.watch(function(use: ComposeTypes.Use)
			local current = use(selectedObject) :: GuiObject?
			if current and current:IsA("ScrollingFrame") and shown(current) and forward(current) then
				return
			end
			if current and shown(current) then
				if record == nil or record.node ~= current then
					record = snapshot(current)
					track(current)
				end
			else
				schedule()
			end
		end)
		runtime.connect(keys, "InputBegan", function(event: InputObject)
			if table.find(directionKeys, event.KeyCode) then
				enter()
			end
		end)
		local parent = inputHost()
		if parent then
			ctx.Host.InputContext({
				Name = "FacetEntry",
				Parent = parent,
				Priority = 30,
				Sink = false,
				ctx.Host.InputAction({
					Name = "Enter",
					Type = E.InputActionType.Direction2D,
					StateChanged = function(value: unknown)
						if typeof(value) == "Vector2" and (value :: Vector2).Magnitude >= 0.5 then
							enter()
						end
					end,
					ctx.Host.InputBinding({ KeyCode = E.KeyCode.Thumbstick1 }),
				}),
			})
			local traversable = Compose.formula(function(use: ComposeTypes.Use): boolean
				if not keyboardNavigation or use(keyboard) ~= true then
					return false
				end
				local current = use(selectedObject) :: Instance?
				if current ~= nil then
					if ownedByFacet(current) then
						return true
					end
					for _, record in use(responders) do
						if current == record.root or current:IsDescendantOf(record.root) then
							return true
						end
					end
					return false
				end
				local resting = false
				for _, record in use(responders) do
					if record.passive then
						if use(record.engaged) then
							return true
						end
						resting = true
					end
				end
				return not resting
			end)
			local viaAction, viaInput = false, false
			local function step()
				local back = keys.IsKeyDown ~= nil
					and (keys:IsKeyDown(E.KeyCode.LeftShift) or keys:IsKeyDown(E.KeyCode.RightShift))
				traverse(if back then -1 else 1)
			end
			ctx.reserveKeys({
				keys = { Tab = true },
				priority = 1500,
				sink = true,
				editing = ownedByFacet,
				gui = service,
				enabled = function(): boolean
					return traversable:peek()
				end,
				press = function()
					if not viaAction then
						viaInput = true
						step()
					end
				end,
				release = function()
					viaAction, viaInput = false, false
				end,
			})
			ctx.Host.InputContext({
				Name = "FacetTraversal",
				Parent = parent,
				Priority = 1500,
				Sink = true,
				Enabled = traversable,
				ctx.Host.InputAction({
					Name = "Traverse",
					Type = E.InputActionType.Bool,
					Pressed = function()
						if not viaInput then
							viaAction = true
							step()
						end
					end,
					Released = function()
						viaAction, viaInput = false, false
					end,
					ctx.Host.InputBinding({ KeyCode = E.KeyCode.Tab }),
				}),
			})
		end
		return nil, nil
	end)

	local function track(node: Instance): ()
		if gui == nil then
			return
		end
		registry[node] = true
		acquire()
	end

	local function responder(root: Instance, options: Env.ResponderOptions?): Env.Responder
		assert(Compose.currentOwner() ~= nil, "Facet UI.responder must run inside a component or Compose owner")
		assert(
			(root :: Instance?) ~= nil and root.IsA ~= nil and (root:IsA("GuiObject") or root:IsA("LayerCollector")),
			"Facet UI.responder expects a GuiObject or a LayerCollector"
		)
		local settings: Env.ResponderOptions = options or {}
		for key, value in (settings :: unknown) :: { [unknown]: unknown } do
			assert(RESPONDER_KEYS[key :: string] == true, `Facet UI.responder: unknown option '{tostring(key)}'`)
			assert(type(value) == "boolean", `Facet UI.responder: {tostring(key)} must be a boolean`)
		end
		local passive = settings.passive ~= false
		local engaged = Compose.cell(not passive)
		if settings.traversalWrap == false then
			root:SetAttribute("FacetTraversalWrap", false)
		end
		if settings.gameplayGuard == false then
			root:SetAttribute("FacetGameplayGuard", false)
		end
		local record: Record = { root = root, passive = passive, engaged = engaged }
		local list = table.clone(responders:peek())
		table.insert(list, record)
		responders:set(list)
		Compose.cleanup(function()
			local remaining = table.clone(responders:peek())
			local index = table.find(remaining, record)
			if index then
				table.remove(remaining, index)
				responders:set(remaining)
			end
		end)
		local function inside(node: Instance?): boolean
			return node ~= nil and (node == (root :: Instance) or node:IsDescendantOf(root))
		end
		local function engage(): ()
			engaged:set(true)
		end
		local function resign(): ()
			if not passive then
				return
			end
			engaged:set(false)
			if gui and inside(gui.SelectedObject) then
				gui.SelectedObject = nil
			end
		end
		local parent = inputHost()
		if passive and gui and gui.GetPropertyChangedSignal then
			local selected = ctx.observe.SelectedObject(gui)
			Compose.watch(function(use: ComposeTypes.Use)
				local current = use(selected) :: Instance?
				if current == nil then
					return
				end
				if inside(current) then
					engaged:set(true)
				elseif engaged:peek() then
					engaged:set(false)
				end
			end)
			if input then
				runtime.connect(input, "InputBegan", function(event: InputObject)
					local kind = event.UserInputType
					if kind ~= E.UserInputType.MouseButton1 and kind ~= E.UserInputType.Touch then
						return
					end
					local collector = if root:IsA("LayerCollector") then root else collectorOf(root)
					local host = (if collector then collector.Parent else nil) :: BasePlayerGui?
					if host == nil or host.GetGuiObjectsAtPosition == nil then
						return
					end
					local hits = host:GetGuiObjectsAtPosition(event.Position.X, event.Position.Y)
					for _, hit in hits do
						if inside(hit) then
							engaged:set(true)
							local at: Instance? = hit
							while at and at ~= root.Parent do
								if
									kind ~= E.UserInputType.Touch
									and input.PreferredInput ~= E.PreferredInput.Touch
									and at:IsA("GuiObject")
									and at.Selectable
								then
									gui.SelectedObject = at
									break
								end
								at = at.Parent
							end
							return
						end
					end
					if engaged:peek() then
						resign()
					end
				end)
			end
			if parent then
				ctx.Host.InputContext({
					Name = "FacetResponderCancel",
					Parent = parent,
					Priority = 30,
					Sink = false,
					Enabled = function(use: ComposeTypes.Use): boolean
						return use(engaged)
					end,
					ctx.Host.InputAction({
						Name = "Cancel",
						Type = E.InputActionType.Bool,
						Pressed = resign,
						ctx.Host.InputBinding({ KeyCode = E.KeyCode.ButtonB }),
						ctx.Host.InputBinding({ KeyCode = E.KeyCode.Escape }),
					}),
				})
				if settings.gameplayGuard ~= false then
					ctx.Host.InputContext({
						Name = "FacetGameplayGuard",
						Parent = parent,
						Priority = 3000,
						Sink = true,
						Enabled = function(use: ComposeTypes.Use): boolean
							return use(engaged)
						end,
						ctx.Host.InputAction({
							Name = "Guard",
							Type = E.InputActionType.Bool,
							ctx.Host.InputBinding({ KeyCode = E.KeyCode.Space }),
						}),
					})
				end
			end
		end
		local state = (
			Compose.formula(function(use: ComposeTypes.Use): Env.ResponderState
				return if use(engaged) then "engaged" else "passive"
			end) :: unknown
		) :: ComposeTypes.Readable<Env.ResponderState>
		return table.freeze({
			state = state,
			engage = engage,
			resign = resign,
		})
	end

	local function spaceActivates(node: Instance): (ComposeTypes.Use) -> boolean
		return function(): boolean
			if not keyboardNavigation then
				return false
			end
			local at: Instance? = node
			while at do
				if at:GetAttribute("FacetGameplayGuard") == false then
					return false
				end
				at = at.Parent
			end
			return true
		end
	end

	return {
		track = track,
		responder = responder,
		spaceActivates = spaceActivates,
	}
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="211">
            <Properties>
              <string name="Name">settle</string>
              <string name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local reducedMotion = require("./motion").reduced

export type Spring = { period: number, damping: number }
export type Settle = {
	value: ComposeTypes.Readable<number?>,
	launch: (from: number, velocity: number, spring: Spring?) -> boolean,
	halt: () -> (),
}

return function(ctx: Types.Context, target: () -> number, spring: Spring, reduced: (() -> boolean)?): Settle
	local Compose = ctx.Compose
	local frames = ctx.runtime.host.frames
	local fallback = reducedMotion(ctx)
	local reduce: () -> boolean = reduced or function(): boolean
		return fallback()
	end
	local value: ComposeTypes.Cell<number?> = Compose.cell(nil :: number?)
	local stop: (() -> ())? = nil
	local disposed = false
	local function halt()
		local current = stop
		stop = nil
		if current then
			current()
		end
		value:set(nil)
	end
	local function launch(from: number, velocity: number, override: Spring?): boolean
		halt()
		local chosen = override or spring
		local crossing = chosen.damping >= 1
		if disposed or frames == nil or reduce() then
			return false
		end
		local limit = ctx.metric("motion.fling.maxSpeed")
		local state = Compose.createSpringState({ from }, 1)
		state.velocity[1] = math.clamp(velocity, -limit, limit)
		value:set(from)
		local mine: (() -> ())? = nil
		mine = frames.onFrame(function(delta: number)
			if stop ~= mine then
				return
			end
			local goal = target()
			local before = state.position[1]
			Compose.stepSpring(state, { goal }, delta, chosen.period, chosen.damping)
			local now = state.position[1]
			if
				now ~= now
				or math.abs(now) == math.huge
				or (crossing and (now - goal) * (before - goal) < 0)
				or (math.abs(now - goal) < 0.5 and math.abs(state.velocity[1]) < 5)
			then
				halt()
				return
			end
			value:set(now)
		end)
		stop = mine
		return true
	end
	Compose.cleanup(function()
		disposed = true
		halt()
	end)
	return { value = value, launch = launch, halt = halt }
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="212">
            <Properties>
              <string name="Name">sheet_release</string>
              <string name="Source"><![CDATA[--!strict
local release = {}

release.PROJECTION_S = 0.15
release.DISMISS_FRACTION = 0.7

export type Stop = { id: string, height: number, index: number }

local function band(over: number, limit: number): number
	if limit <= 0 then
		return 0
	end
	return limit * over / (over + limit)
end

function release.choose(
	stops: { Stop },
	released: number,
	velocity: number,
	current: string,
	canDismiss: boolean
): string
	local projected = released + velocity * release.PROJECTION_S
	local threshold = stops[1].height * release.DISMISS_FRACTION
	if canDismiss and released < threshold and projected < threshold then
		return "dismiss"
	end
	local best: Stop? = nil
	local bestGap = math.huge
	for _, stop in stops do
		local gap = math.abs(stop.height - projected)
		local better = gap < bestGap
			or (
				gap == bestGap
				and best ~= nil
				and best.id ~= current
				and (stop.id == current or stop.index < best.index)
			)
		if better then
			best, bestGap = stop, gap
		end
	end
	return (best :: Stop).id
end

function release.resist(
	raw: number,
	lowest: number,
	highest: number,
	room: number,
	canDismiss: boolean,
	limit: number
): number
	if raw > highest then
		return math.min(room, highest + band(raw - highest, math.max(0, room - highest)))
	end
	if raw < lowest then
		if canDismiss then
			return math.max(1, raw)
		end
		return lowest - band(lowest - raw, limit)
	end
	return raw
end

return release
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="213">
            <Properties>
              <string name="Name">slider</string>
              <string name="Source"><![CDATA[--!strict
local valueModel = require("./input_value")
local InputTypes = require("./input_types")
local Shared = require("./types")
local ControlTypes = require("./control_types")
local ComposeTypes = require("../vendor/compose/core")

type Spec = InputTypes.SliderImplementationProps
type Range = InputTypes.SliderRange
type Thumb = InputTypes.SliderThumb
type NumberSpec = { value: Shared.Value<number>, onChange: ((number) -> ())? }
export type Adjust = {
	once: boolean?,
	vertical: boolean?,
	guard: boolean?,
	arrows: ((ComposeTypes.Use, number) -> boolean)?,
	extra: (((ComposeTypes.Use) -> boolean) -> ())?,
}
export type Helpers = {
	enabled: (Spec | NumberSpec, ComposeTypes.Use?) -> boolean,
	stopEnabled: (Spec | NumberSpec, ComposeTypes.Use?) -> boolean,
	writable: (unknown) -> boolean,
	attributes: (Instance, Shared.Attributes) -> Instance,
	valueAttributes: (GuiObject, NumberSpec, valueModel.Model) -> (),
	adjustment: (GuiObject, InputTypes.AdjustmentState, (number) -> (), (() -> ())?, number?, number?, Adjust?) -> (),
	paintedPart: (Shared.FrameProps, Shared.Value<string>?, string, string) -> Frame,
}

local SLIDER_KEYS = {
	"value",
	"min",
	"max",
	"step",
	"format",
	"enabled",
	"onChange",
	"onCommit",
	"label",
	"tapToPosition",
	"row",
	"thumbImage",
	"trackImage",
	"axis",
	"range",
	"minGap",
	"thumb",
	"thumbContent",
	"trackContent",
	"rotation",
	"controlSize",
	"contained",
}
local THICKNESS: { [string]: number } = { xsmall = 3, compact = 4, regular = 6, large = 8 }
local KNOB = 24

local function finite(value: unknown): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

return function(ctx: Shared.Context, UI: ControlTypes.Controls, h: Helpers): ()
	local runtime, Host, Compose, read = ctx.runtime, ctx.Host, ctx.Compose, ctx.read
	local readSource = ctx.readSource
	local D, D2, V2, E = ctx.types.UDim, ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local function dynamic(source: unknown): boolean
		return Compose.isReadable(source) or type(source) == "function"
	end
	local function derive<T>(compute: (ComposeTypes.Use?) -> T, ...: unknown): Shared.Value<T>
		for index = 1, select("#", ...) do
			if dynamic((select(index, ...))) then
				return compute
			end
		end
		return compute(nil)
	end
	local function enabledLive(spec: Spec): boolean
		local state = (spec :: unknown) :: { enabled: unknown, disabled: unknown, busy: unknown }
		return dynamic(state.enabled) or dynamic(state.disabled) or dynamic(state.busy)
	end
	local function enabledValue(spec: Spec): Shared.Value<boolean>
		local function compute(use: ComposeTypes.Use?): boolean
			return h.enabled(spec, use)
		end
		return if enabledLive(spec) then compute else compute(nil)
	end
	local function construction(spec: Spec)
		for _, key in { "axis", "range", "minGap", "thumb", "tapToPosition" } do
			local source = (spec :: { [unknown]: unknown })[key]
			if dynamic(source) then
				error(`Facet UI.Slider: {key} is decided at construction; pass a plain value`, 0)
			end
		end
		assert(spec.axis == nil or spec.axis == "x" or spec.axis == "y", "Facet UI.Slider: axis must be x or y")
		assert(
			spec.thumb == nil or spec.thumb == "always" or spec.thumb == "auto" or spec.thumb == "none",
			"Facet UI.Slider: thumb must be always | auto | none"
		)
		assert(spec.range == nil or type(spec.range) == "boolean", "Facet UI.Slider: range must be a boolean")
		assert(
			spec.thumbContent == nil or type(spec.thumbContent) == "function",
			"Facet UI.Slider: thumbContent must be a function"
		)
		assert(
			spec.trackContent == nil or type(spec.trackContent) == "function",
			"Facet UI.Slider: trackContent must be a function"
		)
		if spec.thumbContent and spec.thumbImage then
			error("Facet UI.Slider: thumbImage and thumbContent both draw the handle; pass one", 0)
		end
		if spec.trackContent and spec.trackImage then
			error("Facet UI.Slider: trackImage and trackContent both draw the track; pass one", 0)
		end
		if spec.controlSize ~= nil then
			ctx.controlSize(spec.controlSize, "height")
		end
	end
	local function thickness(spec: Spec, use: ComposeTypes.Use?): number
		local rung = read(spec.controlSize, use)
		return THICKNESS[rung or "regular"] or THICKNESS.regular
	end
	local function unrotate(track: GuiObject, position: Vector2 | Vector3, degrees: number): (number, number)
		local size, at = track.AbsoluteSize, track.AbsolutePosition
		local cx, cy = at.X + size.X / 2, at.Y + size.Y / 2
		local dx, dy = position.X - cx, position.Y - cy
		if degrees % 360 ~= 0 then
			local a = -math.rad(degrees)
			dx, dy = dx * math.cos(a) - dy * math.sin(a), dx * math.sin(a) + dy * math.cos(a)
		end
		return dx + size.X / 2, dy + size.Y / 2
	end
	local function travelAt(
		track: GuiObject,
		position: Vector2 | Vector3,
		vertical: boolean,
		degrees: number
	): (number, number)
		local size = track.AbsoluteSize
		local x, y = unrotate(track, position, degrees)
		if vertical then
			return size.Y - y, size.Y
		end
		return x, size.X
	end
	local function fractionAt(point: number, length: number, side: number): number?
		local travel = length - side
		if length <= 0 then
			return nil
		end
		return if travel > 0 then (point - side / 2) / travel else 0.5
	end
	local function inset(fraction: number, side: number): number
		return math.round((0.5 - fraction) * side)
	end
	local function knob(
		spec: Spec,
		name: string,
		thumb: Thumb,
		value: (ComposeTypes.Use?) -> number,
		fraction: (ComposeTypes.Use?) -> number,
		dragging: ComposeTypes.Readable<boolean>,
		shown: (ComposeTypes.Use) -> boolean,
		vertical: boolean,
		target: boolean,
		extent: ComposeTypes.Cell<number>
	): Frame
		local knobSize = function(use: ComposeTypes.Use?): number
			if spec.controlSize == nil then
				return KNOB
			end
			local icon = ctx.controlSize(spec.controlSize, "iconSize", use)
			return math.max(8, KNOB + icon - ctx.controlSize("regular", "iconSize", use))
		end
		local mode = spec.thumb or "always"
		local sizeSources = if spec.controlSize == nil then nil else ctx.config.theme
		local knobBox = derive(function(use: ComposeTypes.Use?): UDim2
			local side = knobSize(use)
			return D2.fromOffset(side, side)
		end, spec.controlSize, sizeSources)
		local knobFloor = derive(function(use: ComposeTypes.Use?): Vector2
			local side = knobSize(use)
			return V2.new(side, side)
		end, spec.controlSize, sizeSources)
		local visible: Shared.Value<boolean>? = if mode == "always" then nil elseif mode == "none" then false else shown
		local size = if target then 44 else KNOB
		local markName = if name == "ThumbStop" then "Thumb" else "Knob"
		local native: Shared.FrameNativeProps = {
			Name = name,
			AnchorPoint = V2.new(0.5, 0.5),
			Position = function(use: ComposeTypes.Use)
				local f, side = fraction(use), use(extent)
				local shift = inset(f, side)
				return if vertical then D2.new(0.5, 0, 1 - f, -shift) else D2.new(f, shift, 0.5, 0)
			end,
			Size = D2.fromOffset(size, size),
			ZIndex = 3,
		}
		local function measure(art: GuiObject): ()
			if spec.thumb == "none" then
				return
			end
			local measured = ctx.observe.AbsoluteSize(art)
			Compose.watch(function(use: ComposeTypes.Use)
				local box = use(measured) :: Vector2
				local side = if vertical then box.Y else box.X
				extent:set(if side > 0 then side else knobSize(use))
			end)
		end
		local content = spec.thumbContent
		if not target and not content then
			local part = h.paintedPart({
				Name = name,
				AnchorPoint = V2.new(0.5, 0.5),
				Position = native.Position,
				Size = knobBox,
				Visible = visible,
				ZIndex = 3,
				Host.UICorner({ CornerRadius = ctx.round }),
			}, spec.thumbImage, "slider-thumb", "sliderThumb")
			measure(part)
			return part
		end
		local mark: GuiObject
		if content then
			local built = content({
				thumb = thumb,
				value = Compose.formula(function(use: ComposeTypes.Use)
					return value(use)
				end),
				fraction = Compose.formula(function(use: ComposeTypes.Use)
					return fraction(use)
				end),
				dragging = dragging,
				enabled = Compose.formula(function(use: ComposeTypes.Use)
					return h.enabled(spec, use)
				end),
			})
			mark = Host.Frame(markName) {
				BackgroundTransparency = 1,
				AnchorPoint = V2.new(0.5, 0.5),
				Position = D2.fromScale(0.5, 0.5),
				Size = D2.fromOffset(0, 0),
				AutomaticSize = E.AutomaticSize.XY,
				Visible = visible,
				Host.UISizeConstraint({ MinSize = knobFloor }) :: ComposeTypes.Child,
				Host.UIListLayout({
					HorizontalAlignment = E.HorizontalAlignment.Center,
					VerticalAlignment = E.VerticalAlignment.Center,
				}) :: ComposeTypes.Child,
				built :: ComposeTypes.Child,
			}
		else
			mark = h.paintedPart({
				Name = markName,
				AnchorPoint = V2.new(0.5, 0.5),
				Position = D2.fromScale(0.5, 0.5),
				Size = knobBox,
				Visible = visible,
				Host.UICorner({ CornerRadius = ctx.round }),
			}, spec.thumbImage, "slider-thumb", "sliderThumb")
		end
		measure(if content then mark:FindFirstChildWhichIsA("GuiObject") or mark else mark)
		if not target then
			native.BackgroundTransparency = 1
			native.Size = D2.fromOffset(0, 0)
			native.AutomaticSize = E.AutomaticSize.XY
			native[#native + 1] = Host.UISizeConstraint({ MinSize = knobFloor })
			native[#native + 1] = mark
			return Host.Frame(native)
		end
		native.BackgroundTransparency = 1
		native[#native + 1] = mark
		native[#native + 1] = Host.UICorner({ CornerRadius = D.new(0.5, 0) })
		return Host.Frame(native)
	end

	local slider = ctx.construct("Slider", function(spec: Spec): Frame
		construction(spec)
		local isRange = spec.range == true
		local vertical = spec.axis == "y"
		local mode = spec.thumb or "always"
		local model = valueModel(spec :: valueModel.Options, read)
		local gap = spec.minGap or 0
		assert(
			spec.minGap == nil or (finite(spec.minGap) and gap >= 0 and gap <= model.max - model.min),
			"Facet UI.Slider: minGap must be a number from 0 to the width of the range"
		)
		local function problem(pair: unknown): string?
			if type(pair) ~= "table" then
				return "a range value is { lower, upper }"
			end
			local fields = pair :: { [string]: unknown }
			local lower, upper = fields.lower, fields.upper
			if not finite(lower) or not finite(upper) then
				return "a range value has finite lower and upper numbers"
			end
			local low, high = lower :: number, upper :: number
			if low > high then
				return `lower {low} is above upper {high}`
			end
			if high - low < gap - 1e-9 then
				return `the pair {low}-{high} is narrower than minGap {gap}`
			end
			return nil
		end
		if isRange then
			local initial = read(spec.value :: Shared.Value<Range>)
			local why = problem(initial)
			if why then
				error(`Facet UI.Slider: {why}`, 0)
			end
			assert(
				h.writable(spec.value) or type(spec.onChange) == "function",
				"Facet.Slider: editing a read-only value requires onChange"
			)
		else
			assert(type(read(spec.value)) == "number", "Facet.Slider: value must resolve to a number")
			assert(
				h.writable(spec.value) or type(spec.onChange) == "function",
				"Facet.Slider: editing a read-only value requires onChange"
			)
		end
		local input = ctx.config.services.UserInputService
		local preferred = if input
			then ctx.observe.PreferredInput(input) :: ComposeTypes.Readable<Enum.PreferredInput?>
			else Compose.cell(nil :: Enum.PreferredInput?)
		local function pointerDrag(use: ComposeTypes.Use): boolean
			return h.enabled(spec, use) and use(preferred) ~= E.PreferredInput.Gamepad
		end
		local degrees = function(use: ComposeTypes.Use?): number
			local turn = read(spec.rotation, use)
			assert(turn == nil or finite(turn), "Facet UI.Slider: rotation must be a finite number of degrees")
			return turn or 0
		end
		local track: Frame
		local extents: { [Thumb]: ComposeTypes.Cell<number> } = {}
		local function extent(thumb: Thumb): ()
			extents[thumb] = Compose.cell(if mode == "none" then 0 else KNOB)
		end
		if isRange then
			extent("lower")
			extent("upper")
		else
			extent("value")
		end
		local function extentOf(thumb: Thumb): ComposeTypes.Cell<number>
			return assert(extents[thumb])
		end
		local dragging = Compose.cell(false)
		local hovered = Compose.cell(false)
		local selectedInside = Compose.cell(false)
		local function shown(use: ComposeTypes.Use): boolean
			if mode == "none" then
				return false
			end
			if mode == "always" then
				return true
			end
			return use(hovered) or use(selectedInside) or use(dragging) or use(preferred) == E.PreferredInput.Touch
		end
		local diagnostics: { string } = {}
		local last: Range? = if isRange then table.clone(read(spec.value :: Shared.Value<Range>)) else nil
		local legal = Compose.cell(last)
		if isRange then
			Compose.watch(function(use: ComposeTypes.Use)
				local pair = read(spec.value :: Shared.Value<Range>, use)
				local why = problem(pair)
				if why then
					if diagnostics[#diagnostics] ~= why then
						table.insert(diagnostics, why)
						if #diagnostics > 16 then
							table.remove(diagnostics, 1)
						end
					end
					return
				end
				legal:set({ lower = pair.lower, upper = pair.upper })
			end)
		end
		local function pair(use: ComposeTypes.Use?): Range
			return assert(readSource(legal, use))
		end
		local function single(use: ComposeTypes.Use?): number
			return read(spec.value :: Shared.Value<number>, use)
		end
		local detent = ctx.haptic(true)
		local function proposeSingle(value: number): boolean
			if not h.enabled(spec) then
				return false
			end
			local nextValue = model.quantize(value)
			if single() == nextValue then
				return false
			end
			if spec.onChange then
				(spec.onChange :: (number) -> ())(nextValue)
			else
				(spec.value :: ComposeTypes.Cell<number>):set(nextValue)
			end
			local moved = single() == nextValue
			if moved and detent and spec.step ~= nil then
				detent:Play()
			end
			return moved
		end
		local function proposePair(nextPair: Range, thumb: Thumb): boolean
			if not h.enabled(spec) then
				return false
			end
			local current = pair()
			if current.lower == nextPair.lower and current.upper == nextPair.upper then
				return false
			end
			if spec.onChange then
				(spec.onChange :: (Range, InputTypes.SliderChange) -> ())(
					{ lower = nextPair.lower, upper = nextPair.upper },
					{ thumb = thumb }
				)
			else
				(spec.value :: ComposeTypes.Cell<Range>):set({ lower = nextPair.lower, upper = nextPair.upper })
			end
			if detent and spec.step ~= nil then
				detent:Play()
			end
			return true
		end
		local function moveThumb(thumb: Thumb, value: number): boolean
			local current = pair()
			local nextPair = { lower = current.lower, upper = current.upper }
			if thumb == "lower" then
				nextPair.lower = math.min(model.quantize(value), current.upper - gap)
				nextPair.lower = math.max(nextPair.lower, model.min)
			else
				nextPair.upper = math.max(model.quantize(value), current.lower + gap)
				nextPair.upper = math.min(nextPair.upper, model.max)
			end
			return proposePair(nextPair, thumb)
		end
		local function commit(thumb: Thumb)
			local onCommit = spec.onCommit
			if onCommit then
				if isRange then
					local callback = onCommit :: (Range, InputTypes.SliderChange) -> ()
					local current = pair()
					callback({ lower = current.lower, upper = current.upper }, { thumb = thumb })
				else
					(onCommit :: (number) -> ())(single())
				end
			end
		end

		local gesture: { thumb: Thumb, snapshot: unknown }? = nil
		local function cancel()
			local active = gesture
			if active == nil then
				return
			end
			gesture = nil
			dragging:set(false)
			if isRange then
				local snapshot = active.snapshot :: Range
				proposePair({ lower = snapshot.lower, upper = snapshot.upper }, active.thumb)
			else
				local snapshot = active.snapshot :: number
				if single() ~= snapshot then
					if spec.onChange then
						(spec.onChange :: (number) -> ())(snapshot)
					else
						(spec.value :: ComposeTypes.Cell<number>):set(snapshot)
					end
				end
			end
		end
		local function begin(thumb: Thumb)
			gesture = { thumb = thumb, snapshot = if isRange then table.clone(pair()) else single() }
			dragging:set(true)
		end
		local function drive(position: Vector2 | Vector3)
			local active = gesture
			if active == nil then
				return
			end
			local point, length = travelAt(track, position, vertical, degrees())
			local f = fractionAt(point, length, extentOf(active.thumb):peek())
			if f == nil then
				return
			end
			local value = model.min + math.clamp(f, 0, 1) * (model.max - model.min)
			if isRange then
				moveThumb(active.thumb, value)
			else
				proposeSingle(value)
			end
		end
		local function finish()
			local active = gesture
			if active == nil then
				return
			end
			gesture = nil
			dragging:set(false)
			commit(active.thumb)
		end
		local function nearest(position: Vector2 | Vector3): Thumb
			local point, length = travelAt(track, position, vertical, degrees())
			local current = pair()
			local function centre(thumb: Thumb): number
				local side = extentOf(thumb):peek()
				local value = if thumb == "lower" then current.lower else current.upper
				return side / 2 + model.fraction(value) * math.max(0, length - side)
			end
			local low, high = centre("lower"), centre("upper")
			if current.lower == current.upper then
				if point < low then
					return "lower"
				elseif point > high then
					return "upper"
				end
				return if current.lower <= model.min then "upper" else "lower"
			end
			return if math.abs(point - low) <= math.abs(point - high) then "lower" else "upper"
		end
		local detector = Host.UIDragDetector "Drag" {
			ResponseStyle = E.UIDragDetectorResponseStyle.CustomOffset,
			Enabled = pointerDrag,
			DragStart = function(position)
				if not h.enabled(spec) then
					return
				end
				begin(if isRange then nearest(position) else "value")
				if spec.tapToPosition ~= false then
					drive(position)
				end
			end,
			DragContinue = function(position)
				drive(position)
			end,
			DragEnd = finish,
		}
		local function fraction(value: number): number
			return model.fraction(value)
		end
		assert(
			spec.contained == nil or type(spec.contained) == "boolean",
			"Facet UI.Slider: contained must be a boolean"
		)
		local contained = spec.contained == true
		local thin = function(use: ComposeTypes.Use?): number
			local knob: number = if contained
				then ctx.readSource(extentOf(if isRange then "lower" else "value"), use)
				else 0
			if knob > 0 then
				return knob
			end
			return thickness(spec, use)
		end
		local function railCorner(): UICorner
			return if contained then Host.UICorner({ CornerRadius = ctx.round }) else ctx.corner(3)
		end
		local trackChildren: { ComposeTypes.Child } = {}
		if spec.trackContent then
			local content = spec.trackContent()
			table.insert(
				trackChildren,
				Host.Frame "TrackContent" {
					BackgroundTransparency = 1,
					AnchorPoint = V2.new(0.5, 0.5),
					Position = D2.fromScale(0.5, 0.5),
					Size = D2.fromScale(1, 1),
					content :: ComposeTypes.Child,
				}
			)
		else
			table.insert(
				trackChildren,
				h.paintedPart({
					Name = "Rail",
					Size = derive(function(use: ComposeTypes.Use?)
						return if vertical then D2.new(0, thin(use), 1, 0) else D2.new(1, 0, 0, thin(use))
					end, spec.controlSize, if contained then thin else nil),
					Position = D2.fromScale(if vertical then 0.5 else 0, 0.5),
					AnchorPoint = V2.new(if vertical then 0.5 else 0, 0.5),
					railCorner(),
				}, spec.trackImage, "slider-rail", "sliderTrack")
			)
			local fill = ctx.styled(
				Host.Frame "Fill" {
					Size = function(use: ComposeTypes.Use)
						local low, high, lowShift, highShift
						if isRange then
							local current = pair(use)
							low, high = fraction(current.lower), fraction(current.upper)
							lowShift = inset(low, use(extentOf("lower")))
							highShift = inset(high, use(extentOf("upper")))
						else
							low, high, lowShift = 0, fraction(single(use)), 0
							highShift = inset(high, use(extentOf("value")))
						end
						return if vertical
							then D2.new(0, thin(use), high - low, highShift - lowShift)
							else D2.new(high - low, highShift - lowShift, 0, thin(use))
					end,
					Position = function(use: ComposeTypes.Use)
						local low = if isRange then fraction(pair(use).lower) else 0
						local shift = if isRange then inset(low, use(extentOf("lower"))) else 0
						return if vertical then D2.new(0.5, 0, 1 - low, -shift) else D2.new(low, shift, 0.5, 0)
					end,
					AnchorPoint = V2.new(if vertical then 0.5 else 0, if vertical then 1 else 0.5),
					railCorner(),
				},
				"slider-fill"
			)
			ctx.skin(fill, "barFill")
			table.insert(trackChildren, fill)
		end
		local thumbStop = not isRange and (spec.thumb or "always") == "always" and spec.thumbContent == nil
		local handles: { [Thumb]: Frame } = {}
		if isRange then
			for index = 1, 2 do
				local thumb: Thumb = if index == 1 then "lower" else "upper"
				local handle = knob(
					spec,
					if thumb == "lower" then "HandleLower" else "HandleUpper",
					thumb,
					function(use)
						local current = pair(use)
						return if thumb == "lower" then current.lower else current.upper
					end,
					function(use)
						local current = pair(use)
						return fraction(if thumb == "lower" then current.lower else current.upper)
					end,
					dragging,
					shown,
					vertical,
					true,
					extentOf(thumb)
				)
				runtime.mountFragment(function()
					return {
						Host.UIDragDetector "Drag" {
							ResponseStyle = E.UIDragDetectorResponseStyle.CustomOffset,
							Enabled = pointerDrag,
							DragStart = function()
								if not h.enabled(spec) then
									return
								end
								begin(thumb)
							end,
							DragContinue = function(position)
								drive(position)
							end,
							DragEnd = finish,
						},
					}
				end, handle)
				handles[thumb] = handle
				table.insert(trackChildren, handle)
			end
		else
			table.insert(
				trackChildren,
				knob(spec, if thumbStop then "ThumbStop" else "Thumb", "value", function(use)
					return single(use)
				end, function(use)
					return fraction(single(use))
				end, dragging, shown, vertical, thumbStop, extentOf("value"))
			)
		end
		table.insert(trackChildren, detector)
		table.insert(trackChildren, Host.UISizeConstraint({ MinSize = V2.new(44, 44) }))
		local trackProps: Shared.FrameNativeProps = {
			Name = "Track",
			Size = if vertical then D2.new(0, 44, 1, 0) else D2.new(1, 0, 0, 44),
			BackgroundTransparency = 1,
			Rotation = if spec.rotation ~= nil
				then function(use: ComposeTypes.Use)
					return degrees(use)
				end
				else nil,
		}
		for _, child in trackChildren do
			trackProps[#trackProps + 1] = child
		end
		track = ctx.styled(Host.Frame(trackProps), "slider-track")
		local trackSlot = track
		if spec.rotation ~= nil then
			runtime.decorate(track, { Size = D2.fromScale(1, 1) })
			trackSlot = Host.Frame "TrackSlot" {
				Size = trackProps.Size,
				BackgroundTransparency = 1,
				Host.UISizeConstraint({ MinSize = V2.new(44, 44) }),
				track,
			}
		end
		local state = ctx.observe.GuiState(track)
		Compose.watch(function(use: ComposeTypes.Use)
			hovered:set(use(state) == E.GuiState.Hover)
		end)
		local trackLabel = (if spec.row then spec.row.title else nil) or spec.label
		if input then
			local first = true
			Compose.watch(function(use: ComposeTypes.Use)
				use(preferred)
				if not first then
					cancel()
				end
				first = false
			end)
		end
		if enabledLive(spec) then
			Compose.watch(function(use: ComposeTypes.Use)
				if not h.enabled(spec, use) then
					cancel()
				end
			end)
		end
		local readout = ctx.text({
			Name = "Value",
			Text = function(use: ComposeTypes.Use)
				if isRange then
					local current = pair(use)
					return `{model.format(current.lower)} – {model.format(current.upper)}`
				end
				return model.format(single(use))
			end,
		})
		if not spec.row and not vertical then
			runtime.decorate(readout, {
				Size = D2.fromOffset(44, 0),
				AutomaticSize = E.AutomaticSize.XY,
				TextXAlignment = E.TextXAlignment.Right,
			})
		end
		local parts: { ComposeTypes.Child } = {}
		local captions: { GuiObject } = {}
		if spec.row then
			local row = spec.row
			local header = { readout }
			if spec.label or row.title then
				table.insert(
					header,
					1,
					ctx.text({
						Name = "Title",
						Text = row.title or spec.label,
						Size = D2.fromOffset(0, 0),
						AutomaticSize = E.AutomaticSize.Y,
						TextWrapped = true,
						Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }),
					})
				)
			end
			table.insert(
				captions,
				ctx.row(header, { Name = "Header", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
			)
			if row.description then
				table.insert(
					captions,
					ctx.text({
						Name = "Description",
						Text = row.description,
						Size = D2.new(1, 0, 0, 0),
						AutomaticSize = E.AutomaticSize.Y,
						TextWrapped = true,
					})
				)
			end
			table.insert(captions, trackSlot)
		else
			if spec.label then
				table.insert(
					parts,
					ctx.text({
						Name = "Label",
						Text = spec.label,
						TextTruncate = E.TextTruncate.AtEnd,
						Host.UIFlexItem({ FlexMode = E.UIFlexMode.Shrink }) :: ComposeTypes.Child,
						Host.UIPadding({ PaddingRight = ctx.types.UDim.new(0, KNOB / 2 + 8) }) :: ComposeTypes.Child,
					})
				)
			end
			if not vertical then
				runtime.decorate(trackSlot, { Size = D2.fromOffset(0, 44) })
			end
			runtime.mount(function()
				return Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill })
			end, trackSlot)
			table.insert(parts, trackSlot)
			table.insert(parts, readout)
		end
		local native = ctx.props(spec, SLIDER_KEYS, {
			BackgroundTransparency = 1,
			Selectable = function(use: ComposeTypes.Use): boolean
				return h.stopEnabled(spec, use)
			end,
			Size = if vertical then D2.new(0, 0, 1, 0) else D2.new(1, 0, 0, 0),
			AutomaticSize = if vertical then E.AutomaticSize.X else E.AutomaticSize.Y,
		})
		local node: Frame
		if spec.row and not vertical then
			local content, size, mark = ctx.listRow({
				leading = if spec.row.icon then { ctx.icon(spec.row.icon, { Name = "LeadingIcon" }) } else nil,
				captions = captions,
				described = true,
				controlSize = spec.controlSize,
			})
			if spec.Size == nil then
				native.Size = size
				native.AutomaticSize = spec.AutomaticSize or E.AutomaticSize.Y
			end
			table.insert(native, content)
			table.insert(native, Host.UIPadding({}))
			node = ctx.styled(Host.Frame(native), "slider")
			mark(node)
			node:AddTag("facet-slider-settings")
		else
			node = ctx.styled(
				if spec.row
					then ctx.column(captions, native)
					elseif vertical then ctx.column(parts, native)
					else ctx.row(parts, native),
				"slider"
			)
		end
		if vertical then
			local layout = assert(node:FindFirstChildWhichIsA("UIListLayout"))
			layout.HorizontalAlignment = E.HorizontalAlignment.Center
		elseif not spec.row then
			assert(node:FindFirstChildWhichIsA("UIListLayout")).VerticalAlignment = E.VerticalAlignment.Center
		end
		local gui = ctx.config.services.GuiService
		local selection = if gui then ctx.observe.SelectedObject(gui) else nil
		if selection then
			local observed = selection
			Compose.watch(function(use: ComposeTypes.Use)
				selectedInside:set(use(observed) == node)
			end)
		end
		local function relative(part: Instance): string
			local names = {}
			local at: Instance? = part
			while at and at ~= node do
				table.insert(names, 1, at.Name)
				at = at.Parent
			end
			return table.concat(names, "/")
		end
		if not isRange then
			h.attributes(node, {
				AccessibleLabel = (function(use: ComposeTypes.Use): string
					local named = if trackLabel ~= nil then read(trackLabel, use) else nil
					return if named and named ~= "" then named else model.format(single(use))
				end) :: Shared.Value<Shared.AttributeValue?>,
			})
			node:SetAttribute(
				"FacetFocusPart",
				relative(if thumbStop then track:FindFirstChild("ThumbStop") :: Instance else track)
			)
			h.adjustment(node, (spec :: unknown) :: NumberSpec, function(direction)
				if proposeSingle(model.stepped(single(), direction)) then
					commit("value")
				end
			end, cancel, model.min, model.max, { vertical = vertical, guard = true })
		end
		if isRange then
			local adjusting: ComposeTypes.Cell<Thumb> = Compose.cell("lower" :: Thumb)
			if selection then
				local observed = selection
				Compose.watch(function(use: ComposeTypes.Use)
					if use(observed) ~= node then
						adjusting:set("lower")
					end
				end)
			end
			Compose.watch(function(use: ComposeTypes.Use)
				local thumb: Thumb = if use(adjusting) == "upper" then "upper" else "lower"
				node:SetAttribute("adjusting", thumb)
				node:SetAttribute("FacetFocusPart", relative(handles[thumb]))
			end)
			h.attributes(node, {
				AccessibleLabel = function(use: ComposeTypes.Use): string
					local named = read(spec.label, use)
					local side = use(adjusting) :: string
					return ctx.phrase(
						"Facet.RangeThumb",
						"{range} {thumb}",
						{ range = if named and named ~= "" then named else "Range", thumb = side },
						use
					)
				end,
			})
			h.adjustment(
				node,
				(spec :: unknown) :: NumberSpec,
				function(direction)
					local thumb: Thumb = adjusting:peek()
					local current = pair()
					local base = if thumb == "lower" then current.lower else current.upper
					if moveThumb(thumb, model.stepped(base, direction)) then
						commit(thumb)
					end
				end,
				cancel,
				model.min,
				model.max,
				{
					vertical = vertical,
					guard = true,
					arrows = function(use: ComposeTypes.Use, direction: number): boolean
						local current = pair(use)
						local thumb: Thumb = if use(adjusting) == "upper" then "upper" else "lower"
						local base = if thumb == "lower" then current.lower else current.upper
						return if direction < 0 then base > model.min else base < model.max
					end,
					extra = function(active: (ComposeTypes.Use) -> boolean)
						ctx.action(node, "SwitchThumb", { E.KeyCode.ButtonA, E.KeyCode.Return }, active, function()
							local keyboard = ctx.config.services.UserInputService
							if keyboard and keyboard.GetFocusedTextBox and keyboard:GetFocusedTextBox() then
								return
							end
							adjusting:set(if adjusting:peek() == "lower" then "upper" else "lower")
						end, { priority = 5000 })
					end,
				}
			)
			for index = 1, 2 do
				local thumb: Thumb = if index == 1 then "lower" else "upper"
				h.attributes(handles[thumb], {
					AccessibleLabel = function(use: ComposeTypes.Use): string
						local named = read(spec.label, use)
						return ctx.phrase(
							"Facet.RangeThumb",
							"{range} {thumb}",
							{ range = if named and named ~= "" then named else "Range", thumb = thumb },
							use
						)
					end,
					value = function(use: ComposeTypes.Use): number
						local current = pair(use)
						return if thumb == "lower" then current.lower else current.upper
					end,
					minimum = model.min,
					maximum = model.max,
				})
			end
		end
		if isRange then
			h.attributes(node, {
				lower = function(use: ComposeTypes.Use)
					return pair(use).lower
				end,
				upper = function(use: ComposeTypes.Use)
					return pair(use).upper
				end,
				minimum = model.min,
				maximum = model.max,
				semanticValue = function(use: ComposeTypes.Use)
					local current = pair(use)
					return `{model.format(current.lower)} to {model.format(current.upper)} of {model.min} to {model.max}`
				end,
				diagnostics = function(use: ComposeTypes.Use)
					use(legal)
					read(spec.value :: Shared.Value<Range>, use)
					return table.concat(diagnostics, "\n")
				end,
			})
		else
			h.valueAttributes(node, (spec :: unknown) :: NumberSpec, model)
		end
		Compose.cleanup(cancel)
		return node
	end)
	UI.Slider = (slider :: unknown) :: typeof(UI.Slider)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="214">
            <Properties>
              <string name="Name">step_indicator</string>
              <string name="Source"><![CDATA[--!strict
local Types = require("./types")
local Content = require("./content_types")
local Nav = require("./navigation_types")
local ThemeTypes = require("./theme_types")
local ComposeTypes = require("../vendor/compose/core")
local values = require("./content_values")
local ContentProps = require("./content_props")
local ControlTypes = require("./control_types")
local InputProps = require("./input_props")
local reducedMotion = require("./motion").reduced

type Snapshot = { steps: { Content.Step }, current: string?, index: { [string]: number } }

local STATES: { [string]: string } =
	{ complete = "Complete", current = "Current", upcoming = "Upcoming", error = "Error" }
local STEP_KEYS: { [string]: boolean } =
	{ id = true, label = true, description = true, state = true, navigable = true, enabled = true }

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls): ()
	local Host, Compose, read, runtime = ctx.Host, ctx.Compose, ctx.read, ctx.runtime
	local E, D2, V2, D = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2, ctx.types.UDim

	local function problem(steps: unknown, current: unknown): string?
		if type(steps) ~= "table" then
			return "steps must be an array of steps"
		end
		if current ~= nil and type(current) ~= "string" then
			return "current must be a step id or nil"
		end
		local seen: { [string]: boolean } = {}
		for index, step in steps :: { unknown } do
			if type(step) ~= "table" then
				return `step {index} must be a table`
			end
			local entry = step :: { [string]: unknown }
			for key in entry do
				if type(key) ~= "string" or not STEP_KEYS[key] then
					return `step {index} has the unknown field '{tostring(key)}'`
				end
			end
			if type(entry.id) ~= "string" or entry.id == "" then
				return `step {index} needs a nonempty string id`
			end
			if seen[entry.id :: string] then
				return `two steps share the id '{entry.id}'`
			end
			seen[entry.id :: string] = true
			if type(entry.label) ~= "string" or string.find(entry.label :: string, "%S") == nil then
				return `step '{entry.id}' needs a nonempty label`
			end
			if entry.description ~= nil and type(entry.description) ~= "string" then
				return `step '{entry.id}' description must be a string`
			end
			if entry.state ~= nil and STATES[entry.state :: string] == nil then
				return `step '{entry.id}' state must be complete, current, upcoming or error`
			end
			if entry.state == "current" and entry.id ~= current then
				return `step '{entry.id}' is marked current, but current names '{tostring(current)}'`
			end
			for _, flag in { "navigable", "enabled" } do
				if entry[flag] ~= nil and type(entry[flag]) ~= "boolean" then
					return `step '{entry.id}' {flag} must be a boolean`
				end
			end
		end
		return nil
	end

	UI.StepIndicator = ctx.construct("StepIndicator", function(spec: ContentProps.StepIndicatorSpec): Frame
		local initialSteps, initialCurrent = read(spec.steps), read(spec.current)
		local refusal = problem(initialSteps, initialCurrent)
		if refusal then
			error(`Facet UI.StepIndicator: {refusal}`, 0)
		end
		assert(
			spec.sizing == nil or spec.sizing == "fill" or spec.sizing == "hug",
			"Facet UI.StepIndicator: sizing is fill or hug"
		)
		assert(
			spec.onSelect == nil or type(spec.onSelect) == "function",
			"Facet UI.StepIndicator: onSelect must be a function"
		)
		assert(
			spec.listLabel == nil or type(spec.listLabel) == "string",
			"Facet UI.StepIndicator: listLabel must be a string"
		)
		local sizing = spec.sizing or "fill"
		local onSelect = spec.onSelect
		local checks = values(ctx, "StepIndicator")
		if spec.controls then
			spec.controls.diagnostics = checks.list
		end
		local last: Snapshot
		local function snapshot(steps: { Content.Step }, current: string?): Snapshot
			local index: { [string]: number } = {}
			for position, step in steps do
				index[step.id] = position
			end
			return { steps = steps, current = if current and index[current] then current else nil, index = index }
		end
		last = snapshot(initialSteps, initialCurrent)
		local refused = false
		local model = Compose.formula(function(use: ComposeTypes.Use): Snapshot
			local steps, current = read(spec.steps, use), read(spec.current, use)
			local reason = problem(steps, current)
			if reason == nil then
				last, refused = snapshot(steps, current), false
			elseif not refused then
				refused = true
				checks.note(`Facet UI.StepIndicator: {reason}; the last legal snapshot stays`)
			end
			return last
		end)
		local enabled = function(use: ComposeTypes.Use?): boolean
			return read(spec.enabled, use) ~= false
		end
		local function permitted(step: Content.Step): boolean
			return onSelect ~= nil and step.navigable == true and step.enabled ~= false
		end
		local function stateOf(step: Content.Step, current: string?): string
			return step.state or (if step.id == current then "current" else "upcoming")
		end
		local summary = Compose.formula(function(use: ComposeTypes.Use): string
			local m = use(model)
			if #m.steps == 0 then
				return "No steps"
			end
			if m.current == nil then
				return "No current step"
			end
			local position = m.index[m.current]
			return ctx.phrase(
				"Facet.StepOf",
				"Step {current} of {count} — {label}",
				{ current = position, count = #m.steps, label = m.steps[position].label },
				use
			)
		end)
		local function propose(id: string)
			local m = model:peek()
			local position = m.index[id]
			if onSelect == nil or not enabled() or position == nil or id == m.current then
				return
			end
			if permitted(m.steps[position]) then
				onSelect(id)
			end
		end
		local stepById = function(id: string, use: ComposeTypes.Use?): Content.Step?
			local m = read(model, use)
			local position = m.index[id]
			return if position then m.steps[position] else nil
		end
		local cueSize = function(use: ComposeTypes.Use?): number
			return (ctx.controlSize(spec.controlSize, "iconSize", use))
		end
		local function inset(side: "left" | "right" | "top" | "bottom", use: ComposeTypes.Use?): number
			local package = read(ctx.config.theme, use)
			local skin = package and package.chrome and package.chrome.control
			local insets: ThemeTypes.Insets = if skin then skin.contentInsets or {} else {}
			local floor = if side == "left" or side == "right"
				then ctx.controlSize(spec.controlSize, "paddingX", use)
				else ctx.metric("space.xs", use)
			return math.max(floor, insets[side] or 0)
		end
		local function padding(side: "left" | "right" | "top" | "bottom")
			return function(use: ComposeTypes.Use): UDim
				return D.new(0, inset(side, use))
			end
		end
		local measures = Compose.cell({} :: { [string]: { ComposeTypes.Readable<Vector2> } })
		local cells: { [string]: GuiObject } = {}
		local cellMeasures = Compose.cell({} :: { [string]: { ComposeTypes.Readable<Vector2> } })
		local function content(id: string): { Types.Child }
			local numberLabel = ctx.text({
				Name = "Number",
				Text = function(use: ComposeTypes.Use): string
					return tostring(read(model, use).index[id] or "")
				end,
				AnchorPoint = V2.new(0.5, 0.5),
				Position = D2.fromScale(0.5, 0.5),
			})
			local numberUnit = ctx.layoutUnit(numberLabel)
			local numberBounds = ctx.layoutBounds(numberLabel, numberUnit)
			local numberSize = ctx.observeStyled.TextSize(numberLabel)
			local numberExtent = ctx.observe.AbsoluteSize(numberLabel)
			local cue = Host.Frame "Cue" {
				LayoutOrder = 1,
				BackgroundTransparency = 1,
				Size = function(use: ComposeTypes.Use)
					local bounds = use(numberBounds)
					use(numberSize)
					use(numberExtent)
					local line = tonumber(numberLabel:GetStyled("TextSize")) or 0
					local side = math.max(cueSize(use), math.ceil(math.max(bounds.X, bounds.Y, line)) + 8)
					return D2.fromOffset(side, side)
				end,
				Host.UIAspectRatioConstraint({ AspectRatio = 1 }) :: Types.Child,
				ctx.styled(
					Host.Frame "Circle" {
						BackgroundTransparency = 1,
						Size = D2.fromScale(1, 1),
						Visible = function(use: ComposeTypes.Use): boolean
							local step = stepById(id, use)
							local state = if step then stateOf(step, read(model, use).current) else "upcoming"
							return state ~= "complete" and state ~= "error"
						end,
						Host.UICorner({ CornerRadius = ctx.round }) :: Types.Child,
						Host.UIStroke({ ApplyStrokeMode = E.ApplyStrokeMode.Border }) :: Types.Child,
						numberLabel :: Types.Child,
					},
					"step-circle"
				) :: Types.Child,
				ctx.icon("checkmark", {
					Name = "Check",
					Size = D2.fromScale(1, 1),
					Visible = function(use: ComposeTypes.Use): boolean
						local step = stepById(id, use)
						return step ~= nil and stateOf(step, read(model, use).current) == "complete"
					end,
				}) :: Types.Child,
				ctx.icon("status.error", {
					Name = "Error",
					Size = D2.fromScale(1, 1),
					Visible = function(use: ComposeTypes.Use): boolean
						local step = stepById(id, use)
						return step ~= nil and stateOf(step, read(model, use).current) == "error"
					end,
				}) :: Types.Child,
			}
			local label = ctx.text({
				Name = "Label",
				LayoutOrder = 1,
				Text = function(use: ComposeTypes.Use): string
					local step = stepById(id, use)
					return if step then step.label else ""
				end,
				TextTruncate = E.TextTruncate.AtEnd,
			})
			local state = ctx.text({
				Name = "State",
				LayoutOrder = 2,
				Text = function(use: ComposeTypes.Use): string
					local step = stepById(id, use)
					return if step then STATES[stateOf(step, read(model, use).current)] else ""
				end,
			})
			state:AddTag("facet-type-caption")
			state:AddTag("facet-secondary")
			local description = ctx.text({
				Name = "Description",
				LayoutOrder = 3,
				Text = function(use: ComposeTypes.Use): string
					local step = stepById(id, use)
					return if step then step.description or "" else ""
				end,
				Visible = function(use: ComposeTypes.Use): boolean
					local step = stepById(id, use)
					return step ~= nil and step.description ~= nil
				end,
			})
			description:AddTag("facet-type-caption")
			description:AddTag("facet-secondary")
			local copy = ctx.column({ label, state, description }, { Name = "Copy", LayoutOrder = 2 })
			local measure = ctx.text({
				Name = "Measure",
				Visible = false,
				Text = function(use: ComposeTypes.Use): string
					local step = stepById(id, use)
					return if step then step.label else ""
				end,
			})
			local next = table.clone(measures:peek())
			next[id] = {
				ctx.observe.TextBounds(measure),
				ctx.observe.TextBounds(state),
				ctx.observe.TextBounds(description),
			}
			measures:set(next)
			Compose.cleanup(function()
				local remaining = table.clone(measures:peek())
				remaining[id] = nil
				measures:set(remaining)
			end)
			return {
				Host.UIListLayout({
					FillDirection = E.FillDirection.Horizontal,
					SortOrder = E.SortOrder.LayoutOrder,
					VerticalAlignment = E.VerticalAlignment.Top,
					Padding = function(use: ComposeTypes.Use)
						return D.new(0, ctx.metric("space.s", use))
					end,
				}) :: Types.Child,
				Host.UIPadding({
					PaddingLeft = padding("left"),
					PaddingRight = padding("right"),
					PaddingTop = padding("top"),
					PaddingBottom = padding("bottom"),
				}) :: Types.Child,
				cue :: Types.Child,
				copy :: Types.Child,
				measure :: Types.Child,
			}
		end
		local rowItems = Compose.keyed({
			from = function(use: ComposeTypes.Use): { Content.Step }
				return use(model).steps
			end,
			key = function(step: Content.Step): string
				return step.id .. (if permitted(step) then ":button" else ":plain")
			end,
			render = function(source: ComposeTypes.Readable<Content.Step>, index: ComposeTypes.Readable<number>)
				local step = source:peek()
				local id = step.id
				local node: GuiObject
				local layout = {
					Name = `Step-{id}`,
					LayoutOrder = index,
					Size = D2.fromScale(0, 0),
					AutomaticSize = if sizing == "fill" then E.AutomaticSize.Y else E.AutomaticSize.XY,
				}
				if permitted(step) then
					local props: InputProps.ButtonProps = {
						Name = layout.Name,
						LayoutOrder = layout.LayoutOrder,
						Size = layout.Size,
						AutomaticSize = layout.AutomaticSize,
						label = "",
						name = function(use: ComposeTypes.Use): string
							local live = stepById(id, use)
							return if live then live.label else id
						end,
						enabled = enabled,
						selected = false,
						onActivate = function()
							propose(id)
						end,
					}
					for _, child in content(id) do
						props[#props + 1] = child
					end
					local button = UI.Button(props)
					node = button
				else
					local props: Types.FrameNativeProps = {
						Name = layout.Name,
						LayoutOrder = layout.LayoutOrder,
						Size = layout.Size,
						AutomaticSize = layout.AutomaticSize,
						BackgroundTransparency = 1,
						Attributes = {
							label = function(use: ComposeTypes.Use): string
								local live = stepById(id, use)
								return if live then live.label else id
							end,
						} :: Types.Attributes,
					}
					for _, child in content(id) do
						props[#props + 1] = child
					end
					node = Host.Frame(props)
					Compose.watch(function(use: ComposeTypes.Use)
						local live = stepById(id, use)
						if live and live.enabled == false or not enabled(use) then
							node:AddTag("facet-disabled")
						elseif node:HasTag("facet-disabled") then
							node:RemoveTag("facet-disabled")
						end
					end)
				end
				cells[id] = node
				local next = table.clone(cellMeasures:peek())
				next[id] = { ctx.observe.AbsolutePosition(node), ctx.observe.AbsoluteSize(node) }
				cellMeasures:set(next)
				Compose.cleanup(function()
					if cells[id] == node then
						cells[id] = nil
					end
					local remaining = table.clone(cellMeasures:peek())
					remaining[id] = nil
					cellMeasures:set(remaining)
				end)
				return node
			end,
		})
		local stripBox = Compose.cell({ x = 0, width = 0 })
		local reduced = reducedMotion(ctx)
		local target = Compose.formula(function(use: ComposeTypes.Use): { x: number, width: number, shown: boolean }
			local m = use(model)
			local measured = if m.current then use(cellMeasures)[m.current] else nil
			local box = use(stripBox)
			if measured == nil or box.width <= 0 then
				return { x = 0, width = 0, shown = false }
			end
			local at, size = use(measured[1]), use(measured[2])
			return { x = (at.X - box.x) / box.width, width = size.X / box.width, shown = true }
		end)
		local indicatorSpring = ctx.motionSpring("control")
		local springX = runtime.spring(function(use: ComposeTypes.Use)
			return use(target).x
		end, { period = indicatorSpring.period, damping = indicatorSpring.damping })
		local springWidth = runtime.spring(function(use: ComposeTypes.Use)
			return use(target).width
		end, { period = indicatorSpring.period, damping = indicatorSpring.damping })
		local rowLayout = Host.UIListLayout({
			FillDirection = E.FillDirection.Horizontal,
			SortOrder = E.SortOrder.LayoutOrder,
			VerticalAlignment = E.VerticalAlignment.Top,
			ItemLineAlignment = E.ItemLineAlignment.Stretch,
			HorizontalFlex = if sizing == "fill" then E.UIFlexAlignment.Fill else E.UIFlexAlignment.None,
			Padding = function(use: ComposeTypes.Use)
				return D.new(0, ctx.metric("space.m", use))
			end,
		})
		local laidOut = ctx.observe.AbsoluteContentSize(rowLayout)
		local row = Host.Frame "Row" {
			BackgroundTransparency = 1,
			Size = D2.fromScale(1, 0),
			AutomaticSize = E.AutomaticSize.Y,
			rowLayout :: Types.Child,
			Host.UIPadding({
				PaddingBottom = function(use: ComposeTypes.Use)
					return D.new(0, ctx.metric("space.xs", use) + 2)
				end,
			}) :: Types.Child,
			rowItems,
		}
		local underline = ctx.styled(
			Host.Frame({
				Name = "Underline",
				BorderSizePixel = 0,
				AnchorPoint = V2.new(0, 1),
				ZIndex = 2,
				Visible = function(use: ComposeTypes.Use): boolean
					return use(target).shown
				end,
				Position = function(use: ComposeTypes.Use)
					local x = if reduced(use) then use(target).x else use(springX)
					return D2.new(x, 0, 1, 0)
				end,
				Size = function(use: ComposeTypes.Use)
					local width = if reduced(use) then use(target).width else use(springWidth)
					return D2.new(width, 0, 0, 2)
				end,
			}),
			"selection-indicator"
		)
		local strip = Host.Frame "Strip" {
			BackgroundTransparency = 1,
			Size = D2.fromScale(1, 0),
			AutomaticSize = E.AutomaticSize.Y,
			row :: Types.Child,
			underline :: Types.Child,
		}
		local stripPosition, stripSize = ctx.observe.AbsolutePosition(strip), ctx.observe.AbsoluteSize(strip)
		local unit = ctx.layoutUnit(strip)
		Compose.watch(function(use: ComposeTypes.Use)
			stripBox:set({ x = use(stripPosition).X, width = use(stripSize).X })
		end)
		local root: Frame
		local offered = Compose.cell(0)
		local form = Compose.formula(function(use: ComposeTypes.Use): "row" | "summary"
			local m = use(model)
			local width = use(offered)
			if #m.steps == 0 or width <= 0 then
				return "row"
			end
			if sizing == "hug" then
				return if use(laidOut).X / use(unit) <= width then "row" else "summary"
			end
			local gap, inner = ctx.metric("space.m", use), ctx.metric("space.s", use)
			local sides = inset("left", use) + inset("right", use)
			local all = use(measures)
			local widest = 0
			for _, step in m.steps do
				local copyWidth = 0
				local cellBounds: { ComposeTypes.Readable<Vector2> } = all[step.id] or {}
				for _, bounds in ipairs(cellBounds) do
					copyWidth = math.max(copyWidth, use(bounds).X / use(unit))
				end
				local cell = cueSize(use) + inner + copyWidth + sides
				widest = math.max(widest, cell)
			end
			return if widest * #m.steps + gap * (#m.steps - 1) <= width then "row" else "summary"
		end)
		local listOpen = Compose.cell(false)
		Compose.watch(function(use: ComposeTypes.Use)
			use(model)
			if listOpen:peek() then
				listOpen:set(false)
			end
		end)
		local compact = ctx.row({
			ctx.text({ Name = "Summary", Text = summary, TextTruncate = E.TextTruncate.AtEnd }),
			Compose.show(function(use: ComposeTypes.Use): boolean
				return #use(model).steps > 0
			end, function()
				return UI.Menu({
					Name = "ShowSteps",
					label = spec.listLabel or "Steps",
					isPresented = listOpen,
					enabled = enabled,
					items = function(use: ComposeTypes.Use): { Nav.MenuItem<string> }
						local items: { Nav.MenuItem<string> } = {}
						local m = use(model)
						for _, step in m.steps do
							local id = step.id
							table.insert(items, {
								id = `Item-{id}`,
								label = step.label,
								description = STATES[stateOf(step, m.current)],
								marked = id == m.current,
								enabled = permitted(step),
								dismiss = false,
								onSelect = function()
									propose(id)
								end,
							})
						end
						return items
					end,
				})
			end),
		}, { Name = "SummaryRow" })
		root = Host.Frame(ctx.props(spec, {
			"steps",
			"current",
			"onSelect",
			"sizing",
			"listLabel",
			"controlSize",
			"enabled",
			"controls",
		}, {
			Name = "StepIndicator",
			BackgroundTransparency = 1,
			Size = D2.fromScale(1, 0),
			AutomaticSize = E.AutomaticSize.Y,
			Attributes = {
				FacetCurrent = checks.attribute(function(use: ComposeTypes.Use)
					return use(model).current
				end),
				FacetSummary = checks.attribute(summary),
				FacetForm = checks.attribute(form),
				FacetListOpen = checks.attribute(listOpen),
			} :: Types.Attributes,
			strip :: Types.Child,
			compact :: Types.Child,
		}))
		runtime.decorate(strip, {
			Visible = function(use: ComposeTypes.Use): boolean
				return use(form) == "row"
			end,
		})
		runtime.decorate(compact, {
			Visible = function(use: ComposeTypes.Use): boolean
				return use(form) == "summary"
			end,
		})
		local size = ctx.layoutSize(root, unit)
		Compose.watch(function(use: ComposeTypes.Use)
			offered:set(use(size).X)
		end)
		return root
	end)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="215">
            <Properties>
              <string name="Name">text_field</string>
              <string name="Source"><![CDATA[--!strict
local feedbackPaint = require("./feedback_paint")
local reducedMotion = require("./motion").reduced
local arithmetic = require("./arithmetic")
local fieldChrome = require("./field_chrome")
local textPress = require("./text_press")
local measuredScroll = require("./measured_scroll")
local InputTypes = require("./input_types")
local Shared = require("./types")
local ComposeTypes = require("../vendor/compose/core")
local Environment = require("./environment_types")
local ControlTypes = require("./control_types")

type Spec = InputTypes.TextInputImplementationProps
type Scrub = {
	start: number,
	text: string,
	written: number,
	promoted: boolean,
}

local TEXT_KEYS = {
	"value",
	"numericValue",
	"presentation",
	"min",
	"max",
	"parse",
	"format",
	"validate",
	"maxLength",
	"enabled",
	"disabled",
	"readOnly",
	"placeholder",
	"multiline",
	"visibleLines",
	"onChange",
	"onCommit",
	"onCancel",
	"invalid",
	"clearButton",
	"clearButtonMode",
	"selectOnFocus",
	"leading",
	"trailing",
	"label",
	"requiredMark",
	"hint",
	"errorText",
	"controlSize",
	"appearance",
	"corners",
	"step",
	"precision",
	"stepButtons",
	"prefix",
	"suffix",
	"scrub",
}
local NUMBER_KEYS = { "step", "precision", "stepButtons", "prefix", "suffix", "scrub" }
local ROOT_KEYS = { "Name", "Size", "Position", "AnchorPoint", "LayoutOrder", "Visible", "ZIndex" }
local SCRUB_PIXELS = 8

local function finite(value: unknown): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function places(value: number?): number
	if value == nil or value % 1 == 0 then
		return 0
	end
	local text = string.format("%.10f", math.abs(value)):gsub("0+$", "")
	local dot = string.find(text, ".", 1, true)
	return if dot then #text - dot else 0
end

local function round(value: number, digits: number): number
	local scale = 10 ^ digits
	local shifted = value * scale
	if not finite(shifted) then
		return value
	end
	local rounded = math.floor(math.abs(shifted) + 0.5) / scale
	return if value < 0 then -rounded else rounded
end

return function(ctx: Shared.Context, UI: ControlTypes.Controls): ()
	local runtime, Host, Compose = ctx.runtime, ctx.Host, ctx.Compose
	local read = ctx.read
	local D, D2, V2, E = ctx.types.UDim, ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local chrome = fieldChrome(ctx)
	local function carved(
		spec: Spec,
		face: number,
		side: "left" | "right" | "top" | "bottom"
	): (ComposeTypes.Use?) -> UDim
		return function(use: ComposeTypes.Use?): UDim
			local package = read(ctx.config.theme, use)
			local recipe = package and package.chrome and package.chrome.field
			local insets = (recipe and recipe.contentInsets or {}) :: { [string]: number? }
			return D.new(0, face + (if read(spec.appearance, use) == "utility" then 0 else insets[side] or 0))
		end
	end
	local function dynamic(source: unknown): boolean
		return Compose.isReadable(source) or type(source) == "function"
	end
	local function writable(source: unknown): boolean
		return type(source) == "table"
			and Compose.isReadable(source)
			and type((source :: { [string]: unknown }).set) == "function"
	end
	local function attributes(node: Instance, values: Shared.Attributes)
		runtime.decorate(node, { Attributes = values })
	end
	local function build(control: string, spec: Spec): TextBox | Frame
		local invalidSource: ComposeTypes.Readable<boolean>? = spec.invalid
		assert(type(read(spec.value)) == "string", `Facet.{control}: value must resolve to a string`)
		assert(
			writable(spec.value) or type(spec.onChange) == "function",
			`Facet.{control}: a read-only value requires onChange`
		)
		for key, callback in
			{
				parse = spec.parse,
				format = spec.format,
				validate = spec.validate,
				onChange = spec.onChange,
				onCommit = spec.onCommit,
				onCancel = spec.onCancel,
			} :: { [string]: unknown }
		do
			assert(callback == nil or type(callback) == "function", `Facet.{control}: {key} must be a function`)
		end
		local numeric = spec.presentation == "number"
		assert(
			not numeric or writable(spec.numericValue),
			`Facet.{control}: numeric presentation requires numericValue`
		)
		assert(not numeric or spec.multiline ~= true, `Facet.{control}: numeric input must be single-line`)
		assert(spec.enabled == nil or spec.disabled == nil, `Facet.{control}: use enabled or disabled, not both`)
		assert(
			spec.presentation == nil or table.find({ "plain", "search", "number" }, spec.presentation),
			`Facet.{control}: invalid presentation`
		)
		for _, bound in { spec.min, spec.max } do
			assert(bound == nil or finite(bound), `Facet.{control}: numeric bounds must be finite`)
		end
		assert(spec.min == nil or spec.max == nil or spec.min <= spec.max, `Facet.{control}: min must not exceed max`)
		assert(
			spec.maxLength == nil or (spec.maxLength >= 0 and spec.maxLength % 1 == 0),
			`Facet.{control}: maxLength must be a nonnegative integer`
		)
		assert(
			spec.invalid == nil or (Compose.isReadable(spec.invalid) and type(read(spec.invalid)) == "boolean"),
			`Facet.{control}: invalid must be a boolean readable`
		)
		assert(type(read(spec.readOnly) or false) == "boolean", `Facet.{control}: readOnly must be a boolean`)
		for _, key in NUMBER_KEYS do
			assert(
				numeric or (spec :: { [unknown]: unknown })[key] == nil,
				`Facet.{control}: {key} belongs to the number presentation`
			)
		end
		assert(
			spec.step == nil or (finite(spec.step) and (spec.step :: number) > 0),
			`Facet.{control}: step must be finite and above zero`
		)
		assert(
			spec.precision == nil
				or (finite(spec.precision) and spec.precision % 1 == 0 and spec.precision >= 0 and spec.precision <= 10),
			`Facet.{control}: precision must be a whole number from 0 to 10`
		)
		for _, key in { "prefix", "suffix" } do
			local unit = read((spec :: { [unknown]: Shared.Value<unknown> })[key])
			assert(unit == nil or type(unit) == "string", `Facet.{control}: {key} must be a string`)
		end
		assert(
			spec.scrub == nil or type(read(spec.scrub)) == "boolean",
			`Facet.{control}: scrub must be a boolean or a readable boolean`
		)
		assert(spec.visibleLines == nil or spec.multiline == true, `Facet.{control}: visibleLines requires multiline`)
		assert(
			spec.visibleLines == nil
				or (finite(spec.visibleLines) and spec.visibleLines % 1 == 0 and spec.visibleLines >= 1),
			`Facet.{control}: visibleLines must be a whole number of at least 1`
		)
		assert(
			spec.leading == nil or spec.presentation ~= "search",
			`Facet.{control}: a search field already leads with its search mark`
		)
		chrome.check(control, spec)
		local lastPolicy: InputTypes.SelectOnFocus = "none"
		local function policyOf(word: unknown): InputTypes.SelectOnFocus
			if word == nil then
				return "none"
			end
			if word ~= "none" and word ~= "all" and word ~= "end" then
				error(`Facet UI.{control}: selectOnFocus: one of none | all | end (got {tostring(word)})`, 0)
			end
			return word :: InputTypes.SelectOnFocus
		end
		lastPolicy = policyOf(read(spec.selectOnFocus))

		local framed = chrome.present(spec)
			or spec.presentation == "search"
			or spec.leading ~= nil
			or spec.trailing ~= nil
			or spec.prefix ~= nil
			or spec.suffix ~= nil
			or spec.stepButtons == true
			or spec.visibleLines ~= nil
		local enabled = function(use: ComposeTypes.Use?): boolean
			return read(spec.enabled, use) ~= false and read(spec.disabled, use) ~= true
		end
		local readOnly = function(use: ComposeTypes.Use?): boolean
			return read(spec.readOnly, use) == true
		end
		local editable = function(use: ComposeTypes.Use?): boolean
			return enabled(use) and not readOnly(use)
		end
		local editing = Compose.cell(false)
		local invalid = Compose.cell(false)
		local validationMessage = Compose.cell("")
		local mayReject = numeric or spec.invalid ~= nil
		local errorTimeline = if mayReject
			then runtime.timeline({ duration = ctx.metric("motion.durations.fieldReject"), autoplay = false })
			else nil
		local errorReduced = if errorTimeline then reducedMotion(ctx) else nil
		if errorTimeline then
			errorTimeline:seek(0.24)
		end
		local textHeight, messageHeight = Compose.cell(18), Compose.cell(0)
		local writing, disposed, snapshot = false, false, read(spec.value)
		local scrubbing: Scrub? = nil
		local node: TextBox
		local function updateValue(value: string): ()
			if read(spec.value) == value then
				return
			end
			if spec.onChange then
				spec.onChange(value)
			else
				(spec.value :: ComposeTypes.Cell<string>):set(value)
			end
		end
		local function setText(value: string): ()
			if node.Text ~= value then
				writing = true
				node.Text = value
				writing = false
			end
		end
		local function markInvalid(value: boolean, message: string?): ()
			invalid:set(value)
			validationMessage:set(if value then message or "Check this value." else "")
			if writable(invalidSource) then
				(invalidSource :: ComposeTypes.Cell<boolean>):set(value)
			end
			if value and errorTimeline and errorReduced and not errorReduced() then
				errorTimeline:restart()
			end
		end
		local function normalize(text: string): string?
			local length = utf8.len(text)
			if length == nil then
				return nil
			end
			if spec.maxLength and length > spec.maxLength then
				text = string.sub(text, 1, (utf8.offset(text, spec.maxLength + 1) :: number) - 1)
			end
			local normalized = if spec.validate then spec.validate(text) else text
			if type(normalized) ~= "string" or utf8.len(normalized) == nil then
				return nil
			end
			return normalized
		end
		local function propose(text: string): ()
			if disposed or not editable() then
				setText(read(spec.value))
				return
			end
			local accepted = normalize(text)
			if accepted == nil then
				setText(read(spec.value))
				return
			end
			updateValue(accepted)
			setText(read(spec.value))
		end
		local function releaseFocus()
			if node:IsFocused() then
				node:ReleaseFocus(false)
			end
		end
		local function cancel()
			if not editing:peek() then
				return
			end
			editing:set(false)
			updateValue(snapshot)
			setText(read(spec.value))
			releaseFocus()
			if spec.onCancel then
				spec.onCancel()
			end
		end
		local function digits(): number
			if spec.precision ~= nil then
				return spec.precision
			end
			return math.max(places(spec.step), places(spec.min))
		end
		local function formatNumber(number: number): string?
			local ok, formatted = pcall(function(value: number): string
				if spec.format then
					return spec.format(value)
				end
				if spec.precision ~= nil then
					return string.format(`%.{spec.precision}f`, value)
				end
				return tostring(value)
			end, number)
			if not ok or type(formatted) ~= "string" or utf8.len(formatted) == nil then
				return nil
			end
			if spec.validate then
				local valid, normalized = pcall(spec.validate, formatted)
				if not valid or type(normalized) ~= "string" or utf8.len(normalized) == nil then
					return nil
				end
				formatted = normalized
			end
			if spec.maxLength and (utf8.len(formatted) :: number) > spec.maxLength then
				return nil
			end
			return formatted
		end
		local function clamp(number: number): (number, boolean)
			local clamped = number
			if spec.min and clamped < spec.min then
				clamped = spec.min
			end
			if spec.max and clamped > spec.max then
				clamped = spec.max
			end
			return clamped, clamped ~= number
		end
		local function settleNumber(number: number, reason: InputTypes.CommitReason, report: boolean): boolean
			local numericValue = assert(spec.numericValue)
			local text = formatNumber(number)
			if disposed or not enabled() then
				return false
			end
			if text == nil then
				markInvalid(true)
				return false
			end
			local formatted: string = text
			local accepted = false
			runtime:batch(function()
				updateValue(formatted)
				accepted = read(spec.value) == formatted
				if accepted then
					numericValue:set(number)
				end
			end)
			if not accepted then
				setText(read(spec.value))
				markInvalid(true)
				return false
			end
			setText(formatted)
			markInvalid(false)
			if report and spec.onCommit then
				(spec.onCommit :: (number, InputTypes.CommitReason) -> ())(number, reason)
			end
			return true
		end
		local function commitNumber(reason: InputTypes.CommitReason): ()
			local numericValue = assert(spec.numericValue)
			local text = read(spec.value)
			if arithmetic.incomplete(text) then
				if spec.requiredMark == "required" then
					markInvalid(true, "Enter a number.")
					return
				end
				local previous = formatNumber(numericValue:peek())
				if previous then
					updateValue(previous)
					setText(read(spec.value))
				end
				markInvalid(false)
				return
			end
			local ok, parsed = pcall(function(value: string): number?
				return if spec.parse then spec.parse(value) else arithmetic.number(value)
			end, text)
			if disposed or not enabled() then
				return
			end
			if not ok or not finite(parsed) then
				markInvalid(true, "Enter a valid number.")
				return
			end
			local number, clamped = clamp(parsed :: number)
			if spec.precision ~= nil then
				number = round(number, spec.precision)
			end
			settleNumber(number, if clamped then "clamped" else reason, true)
		end
		local function commit(reason: InputTypes.TextCommitReason): ()
			if disposed or not editing:peek() then
				return
			end
			editing:set(false)
			if not enabled() or readOnly() then
				setText(read(spec.value))
				return
			end
			if numeric then
				commitNumber(reason)
				return
			end
			local value = read(spec.value)
			local normalized = normalize(value)
			if disposed or not enabled() then
				return
			end
			if normalized == nil then
				markInvalid(true)
				return
			end
			value = normalized
			updateValue(value)
			if read(spec.value) ~= value then
				setText(read(spec.value))
				markInvalid(true)
				return
			end
			setText(value)
			if spec.onCommit then
				(spec.onCommit :: (string, InputTypes.TextCommitReason) -> ())(value, reason)
			end
		end
		local function stepped(base: number, count: number): number
			local increment = spec.step or 1
			local target = base + count * increment
			if spec.min ~= nil and spec.max ~= nil then
				local from = spec.min
				target = from + (math.floor((base - from) / increment + 0.5) + count) * increment
			end
			local number = clamp(target)
			return round(number, digits())
		end
		local function stepBy(direction: number)
			if disposed or not editable() then
				return
			end
			if editing:peek() then
				editing:set(false)
				releaseFocus()
			end
			local numericValue = assert(spec.numericValue)
			local number = stepped(numericValue:peek(), direction)
			if number ~= numericValue:peek() or read(spec.value) ~= formatNumber(number) then
				settleNumber(number, "submit", true)
			end
		end

		local touchFloor = ctx.touchFloor()
		local nativeProps = ctx.props(spec, TEXT_KEYS, {
			Text = read(spec.value),
			PlaceholderText = spec.placeholder or "",
			ClearTextOnFocus = false,
			MultiLine = spec.multiline == true,
			TextWrapped = spec.multiline == true,
			TextXAlignment = E.TextXAlignment.Left,
			TextYAlignment = if (mayReject and not framed) or spec.multiline == true
				then E.TextYAlignment.Top
				else E.TextYAlignment.Center,
			TextEditable = function(use: ComposeTypes.Use)
				return editable(use)
			end,
			Selectable = function(use: ComposeTypes.Use)
				return enabled(use)
			end,
		})
		local rootProps: Shared.FrameNativeProps = {}
		if framed then
			local source = nativeProps :: { [unknown]: unknown }
			local target = (rootProps :: unknown) :: { [string]: unknown }
			for _, key in ROOT_KEYS do
				target[key], source[key] = source[key], nil
			end
			local moved: { Instance } = {}
			for index = #source, 1, -1 do
				local child = source[index]
				local instanceLike = typeof(child) == "Instance"
					or (type(child) == "table" and (child :: { [string]: unknown }).IsA ~= nil)
				local node = if instanceLike then child :: Instance else nil
				if node and (node:IsA("UIFlexItem") or node:IsA("UISizeConstraint")) then
					table.insert(moved, 1, node)
					table.remove(source :: { unknown }, index)
				end
			end
			for _, child in moved do
				table.insert((rootProps :: unknown) :: { unknown }, child)
			end
			nativeProps.Name = "Field"
			nativeProps.BackgroundTransparency = 1
			nativeProps.Size = if spec.visibleLines
				then D2.new(1, 0, 0, 0)
				else function(use: ComposeTypes.Use)
					local minimum = if spec.multiline == true then 96 elseif spec.controlSize then 0 else 36
					return D2.new(
						0,
						0,
						0,
						math.max(
							minimum,
							if spec.presentation == "search" then touchFloor(use) else 0,
							use(textHeight) + 12
						)
					)
				end
			nativeProps.AutomaticSize = if spec.visibleLines then E.AutomaticSize.Y else nil
		else
			nativeProps.Size = nativeProps.Size
				or function(use: ComposeTypes.Use)
					local message = if use(validationMessage) ~= "" then use(messageHeight) else 0
					local minimum = if spec.multiline == true then 96 else 44
					return D2.new(1, 0, 0, math.max(minimum, use(textHeight) + message + 16))
				end
		end
		local attachEditing: (() -> ())?
		nativeProps.Focused = function(...)
			if enabled() and not editing:peek() then
				snapshot = read(spec.value)
				editing:set(true)
				local attach = attachEditing
				if attach then
					attachEditing = nil
					attach()
				end
			end
			if spec.Focused then
				spec.Focused(...)
			end
		end
		nativeProps.FocusLost = function(enterPressed, input)
			if scrubbing ~= nil then
				editing:set(false)
			elseif input and (input.KeyCode == E.KeyCode.Escape or input.KeyCode == E.KeyCode.ButtonB) then
				cancel()
			else
				commit(if enterPressed then "submit" else "focusLost")
			end
			if spec.FocusLost then
				spec.FocusLost(enterPressed, input)
			end
		end
		local padding = ctx.padding(if framed then 0 else 10, 6)
		table.insert(nativeProps, padding)

		local messageNode: TextLabel?
		if mayReject and not framed then
			local message = ctx.styled(
				ctx.text({
					Name = "ValidationMessage",
					Text = validationMessage,
					Visible = function(use: ComposeTypes.Use)
						return use(validationMessage) ~= ""
					end,
					Size = D2.new(1, 0, 0, 0),
					AutomaticSize = E.AutomaticSize.Y,
					TextWrapped = true,
					Position = function(use: ComposeTypes.Use)
						return D2.fromOffset(0, use(textHeight) + 4)
					end,
				}),
				"validation"
			)
			messageNode = message
			table.insert(nativeProps, message)
		end
		local pulse = if errorTimeline
			then Host.UIScale "ValidationPulse" {
				Scale = function(use: ComposeTypes.Use)
					if assert(errorReduced)(use) then
						return 1
					end
					local phase = use(assert(errorTimeline).progress)
					return 1 - 0.03 * math.sin(math.pi * phase) * (1 - phase)
				end,
			}
			else nil

		local mode = spec.clearButtonMode
			or (if spec.clearButton or spec.presentation == "search" then "always" else "never")
		assert(
			table.find({ "always", "never", "whileEditing", "unlessEditing" }, mode),
			`Facet.{control}: invalid clearButtonMode`
		)
		local clear = if mode ~= "never"
			then UI.Button "Clear" {
				name = "Clear",
				icon = "close",
				appearance = "utility",
				shape = "circle" :: "circle",
				Size = function(use: ComposeTypes.Use): UDim2
					local side = math.max(36, use(textHeight) + 12) - 8
					return D2.fromOffset(side, side)
				end,
				Host.UISizeConstraint "TouchFloor" {
					MinSize = function(use: ComposeTypes.Use): Vector2
						local floor = touchFloor(use)
						return V2.new(floor, floor)
					end,
				} :: Shared.Child,
				AnchorPoint = if framed then nil else V2.new(1, 0.5),
				Position = if framed then nil else D2.fromScale(1, 0.5),
				LayoutOrder = if framed then 40 else nil,
				Visible = function(use: ComposeTypes.Use)
					return editable(use)
						and read(spec.value, use) ~= ""
						and (
							mode == "always"
							or (mode == "whileEditing" and use(editing))
							or (mode == "unlessEditing" and not use(editing))
						)
				end,
				onActivate = function()
					propose("")
				end,
			}
			else nil
		if clear and not framed then
			table.insert(nativeProps, clear)
		end
		node = ctx.styled(Host.TextBox(nativeProps), "text")
		if not framed then
			ctx.styled(ctx.styled(node, "field"), "text-input")
		end
		local root: TextBox | Frame = node
		local keyboard = ctx.config.userInputService
		if keyboard then
			local scrolling = (UI :: unknown) :: {
				scrollTo: ((ScrollingFrame, Vector2) -> boolean)?,
				scrollToVisible: ((GuiObject, Environment.ScrollRect?, Environment.ScrollOptions?) -> boolean)?,
			}
			local shown = ctx.observe.OnScreenKeyboardVisible(keyboard)
			local positionObserver = (ctx.observe :: unknown) :: {
				OnScreenKeyboardPosition: (UserInputService) -> ComposeTypes.Cell<Vector2>,
			}
			local keyboardPosition = positionObserver.OnScreenKeyboardPosition(keyboard)
			local fieldPosition, fieldSize = ctx.observe.AbsolutePosition(node), ctx.observe.AbsoluteSize(node)
			Compose.watch(function(use: ComposeTypes.Use)
				if use(shown) ~= true or not use(editing) then
					return
				end
				use(fieldPosition)
				use(fieldSize)
				local page = node:FindFirstAncestorWhichIsA("ScrollingFrame")
				if page then
					use(ctx.observe.AbsoluteWindowSize(page))
				end
				local reveal = scrolling.scrollToVisible
				local prior = if page then page.CanvasPosition.Y else 0
				if reveal then
					reveal(root, nil, { animated = false })
				end
				local revealed = if page then page.CanvasPosition.Y - prior else 0
				local top = use(keyboardPosition).Y
				local extent = node.AbsoluteSize
				local overlap = node.AbsolutePosition.Y + extent.Y + 8 - top - revealed
				local scroll = scrolling.scrollTo
				if scroll and page and top > 0 and overlap > 0 then
					scroll(page, page.CanvasPosition + V2.new(0, overlap))
				end
			end)
		end

		if framed then
			local parts: { ComposeTypes.Child } = {}
			local function slot(name: string, order: number, content: Shared.Child)
				table.insert(
					parts,
					Host.Frame(name)({
						LayoutOrder = order,
						BackgroundTransparency = 1,
						Size = D2.fromOffset(0, 0),
						AutomaticSize = E.AutomaticSize.XY,
						content,
					})
				)
			end
			if spec.presentation == "search" then
				table.insert(
					parts,
					ctx.icon("facet:search", {
						Name = "SearchIcon",
						LayoutOrder = 5,
					})
				)
			end
			if spec.leading then
				slot("Leading", 10, spec.leading)
			end
			local function unit(name: string, order: number, words: Shared.Value<string>?)
				if words ~= nil then
					table.insert(
						parts,
						ctx.styled(ctx.text({ Name = name, LayoutOrder = order, Text = words }), "secondary")
					)
				end
			end
			unit("Prefix", 20, spec.prefix)
			local editor: GuiObject = node
			if spec.visibleLines then
				local lines = spec.visibleLines
				editor = measuredScroll(ctx, {
					Name = "Viewport",
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Selectable = true,
					ScrollingDirection = E.ScrollingDirection.Y,
					Size = function(use: ComposeTypes.Use)
						local size = ctx.metric("typography.body.size", use)
						return D2.new(0, 0, 0, math.ceil(lines * size * 1.2) + 12)
					end,
				}, { node :: ComposeTypes.Child })
				local viewport = editor :: ScrollingFrame
				local caret = ctx.observe.CursorPosition(node)
				local drawn = ctx.observe.TextBounds(node)
				local window = ctx.observe.AbsoluteWindowSize(viewport)
				local canvas = ctx.observe.AbsoluteCanvasSize(viewport)
				Compose.watch(function(use: ComposeTypes.Use)
					local at, extent, view, full = tonumber(use(caret)) or -1, use(drawn), use(window), use(canvas)
					if at < 1 or extent.Y <= 0 or view.Y <= 0 then
						return
					end
					local text = node.Text
					local limit = math.max(0, full.Y - view.Y)
					local top, bottom
					if at > #text then
						top, bottom = limit, full.Y
					else
						local _, lines = string.gsub(text, "\n", "")
						local _, before = string.gsub(string.sub(text, 1, at - 1), "\n", "")
						local line = extent.Y / (lines + 1)
						top, bottom = before * line, (before + 1) * line
					end
					local position = viewport.CanvasPosition
					if bottom > position.Y + view.Y then
						viewport.CanvasPosition = V2.new(position.X, math.min(limit, bottom - view.Y))
					elseif top < position.Y then
						viewport.CanvasPosition = V2.new(position.X, math.max(0, top))
					end
				end)
			end
			runtime.mountFragment(function()
				return { Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }) }
			end, editor)
			table.insert(parts, editor)
			unit("Suffix", 32, spec.suffix)
			if clear then
				table.insert(parts, clear)
			end
			if spec.stepButtons then
				local function stepButton(name: string, glyph: string, direction: number, order: number)
					local button = UI.Button(name)({
						icon = glyph,
						name = name,
						repeatDelay = 0.4,
						repeatInterval = 0.1,
						LayoutOrder = order,
						Size = D2.fromOffset(44, 44),
						AutomaticSize = E.AutomaticSize.None,
						enabled = function(use: ComposeTypes.Use): boolean
							if not editable(use) then
								return false
							end
							local number = use(assert(spec.numericValue))
							if direction < 0 then
								return spec.min == nil or number > spec.min
							end
							return spec.max == nil or number < spec.max
						end,
						onActivate = function()
							stepBy(direction)
						end,
					})
					button:AddTag("facet-stepper-button")
					table.insert(parts, button)
				end
