	AutomaticSize: typeof(scrollingFrame.AutomaticSize),
	BackgroundColor3: typeof(scrollingFrame.BackgroundColor3),
	BackgroundTransparency: typeof(scrollingFrame.BackgroundTransparency),
	BorderColor3: typeof(scrollingFrame.BorderColor3),
	BorderMode: typeof(scrollingFrame.BorderMode),
	BorderSizePixel: typeof(scrollingFrame.BorderSizePixel),
	ClipsDescendants: typeof(scrollingFrame.ClipsDescendants),
	InputBegan: typeof(scrollingFrame.InputBegan),
	InputChanged: typeof(scrollingFrame.InputChanged),
	InputEnded: typeof(scrollingFrame.InputEnded),
	InputSink: typeof(scrollingFrame.InputSink),
	Interactable: typeof(scrollingFrame.Interactable),
	LayoutOrder: typeof(scrollingFrame.LayoutOrder),
	MouseEnter: typeof(scrollingFrame.MouseEnter),
	MouseLeave: typeof(scrollingFrame.MouseLeave),
	MouseMoved: typeof(scrollingFrame.MouseMoved),
	MouseWheelBackward: typeof(scrollingFrame.MouseWheelBackward),
	MouseWheelForward: typeof(scrollingFrame.MouseWheelForward),
	NextSelectionDown: typeof(scrollingFrame.NextSelectionDown),
	NextSelectionLeft: typeof(scrollingFrame.NextSelectionLeft),
	NextSelectionRight: typeof(scrollingFrame.NextSelectionRight),
	NextSelectionUp: typeof(scrollingFrame.NextSelectionUp),
	Position: typeof(scrollingFrame.Position),
	Rotation: typeof(scrollingFrame.Rotation),
	Selectable: typeof(scrollingFrame.Selectable),
	SelectionGained: typeof(scrollingFrame.SelectionGained),
	SelectionImageObject: typeof(scrollingFrame.SelectionImageObject),
	SelectionLost: typeof(scrollingFrame.SelectionLost),
	SelectionOrder: typeof(scrollingFrame.SelectionOrder),
	Size: typeof(scrollingFrame.Size),
	SizeConstraint: typeof(scrollingFrame.SizeConstraint),
	TouchLongPress: typeof(scrollingFrame.TouchLongPress),
	TouchPan: typeof(scrollingFrame.TouchPan),
	TouchPinch: typeof(scrollingFrame.TouchPinch),
	TouchRotate: typeof(scrollingFrame.TouchRotate),
	TouchSwipe: typeof(scrollingFrame.TouchSwipe),
	TouchTap: typeof(scrollingFrame.TouchTap),
	Visible: typeof(scrollingFrame.Visible),
	ZIndex: typeof(scrollingFrame.ZIndex),
	AutomaticCanvasSize: typeof(scrollingFrame.AutomaticCanvasSize),
	BottomImage: typeof(scrollingFrame.BottomImage),
	BottomImageContent: typeof(scrollingFrame.BottomImageContent),
	CanvasPosition: typeof(scrollingFrame.CanvasPosition),
	CanvasSize: typeof(scrollingFrame.CanvasSize),
	ElasticBehavior: typeof(scrollingFrame.ElasticBehavior),
	HorizontalScrollBarInset: typeof(scrollingFrame.HorizontalScrollBarInset),
	MidImage: typeof(scrollingFrame.MidImage),
	MidImageContent: typeof(scrollingFrame.MidImageContent),
	ScrollBarImageColor3: typeof(scrollingFrame.ScrollBarImageColor3),
	ScrollBarImageTransparency: typeof(scrollingFrame.ScrollBarImageTransparency),
	ScrollBarThickness: typeof(scrollingFrame.ScrollBarThickness),
	ScrollingDirection: typeof(scrollingFrame.ScrollingDirection),
	ScrollingEnabled: typeof(scrollingFrame.ScrollingEnabled),
	TopImage: typeof(scrollingFrame.TopImage),
	TopImageContent: typeof(scrollingFrame.TopImageContent),
	VerticalScrollBarInset: typeof(scrollingFrame.VerticalScrollBarInset),
	VerticalScrollBarPosition: typeof(scrollingFrame.VerticalScrollBarPosition),
	ref: typeof(scrollingFrame.ref),
	contentSize: typeof(zoomView.contentSize),
	content: typeof(zoomView.content),
	zoom: typeof(zoomView.zoom),
	focus: typeof(zoomView.focus),
	minZoom: typeof(zoomView.minZoom),
	maxZoom: typeof(zoomView.maxZoom),
	doubleTapZoom: typeof(zoomView.doubleTapZoom),
	enabled: typeof(zoomView.enabled),
	controls: typeof(zoomView.controls),
	[number | Engine.EventKey]: Compose.Child,
}
export type TravelProps = {
	Changed: typeof(frame.Changed),
	Attributes: typeof(frame.Attributes),
	AncestryChanged: typeof(frame.AncestryChanged),
	Archivable: typeof(frame.Archivable),
	AttributeChanged: typeof(frame.AttributeChanged),
	Capabilities: typeof(frame.Capabilities),
	ChildAdded: typeof(frame.ChildAdded),
	ChildRemoved: typeof(frame.ChildRemoved),
	DescendantAdded: typeof(frame.DescendantAdded),
	DescendantRemoving: typeof(frame.DescendantRemoving),
	Destroying: typeof(frame.Destroying),
	Name: typeof(frame.Name),
	Parent: typeof(frame.Parent),
	Sandboxed: typeof(frame.Sandboxed),
	StyledPropertiesChanged: typeof(frame.StyledPropertiesChanged),
	AutoLocalize: typeof(frame.AutoLocalize),
	RootLocalizationTable: typeof(frame.RootLocalizationTable),
	SelectionBehaviorDown: typeof(frame.SelectionBehaviorDown),
	SelectionBehaviorLeft: typeof(frame.SelectionBehaviorLeft),
	SelectionBehaviorRight: typeof(frame.SelectionBehaviorRight),
	SelectionBehaviorUp: typeof(frame.SelectionBehaviorUp),
	SelectionChanged: typeof(frame.SelectionChanged),
	SelectionGroup: typeof(frame.SelectionGroup),
	Active: typeof(frame.Active),
