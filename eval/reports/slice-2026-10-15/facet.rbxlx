                <Properties>
                  <string name="Name">input</string>
                  <string name="Source"><![CDATA[--!strict
--!nolint DeprecatedApi

local Compose = require "../core"
local Engine = require "./engine"
local PreferredInput = require "./preferred-input"

local function preferredInput(
	inputService: { PreferredInput: unknown }?,
	engine: Engine.Engine?
): Compose.Cell<PreferredInput.Class>
	local resolvedEngine = if engine ~= nil then engine else Engine.ambient()
	local resolvedService = inputService
	if resolvedService == nil then
		local globals = (
			getfenv and getfenv(0) or {}
		) :: { game: { GetService: (unknown, string) -> { PreferredInput: unknown } } }
		resolvedService = globals.game:GetService "UserInputService"
	end
	local service = resolvedService :: { PreferredInput: unknown }
	local initial: PreferredInput.Class = PreferredInput.specOf(service.PreferredInput).class
	local value: Compose.Cell<PreferredInput.Class> = Compose.cell(initial)
	local connection = resolvedEngine.propertyChanged(resolvedService, "PreferredInput"):Connect(function()
		value:set(PreferredInput.specOf(service.PreferredInput).class)
	end)
	Compose.cleanup(function()
		connection:Disconnect()
	end)
	return value
end

return {
	preferredInput = preferredInput,
	preferredInputSpec = PreferredInput.specOf,
}
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="320">
                <Properties>
                  <string name="Name">preferred-input</string>
                  <string name="Source"><![CDATA[--!strict

export type Class = "Touch" | "KeyboardAndMouse" | "Gamepad"

export type Spec = {
	class: Class,
	token: string,
}

local touch: Spec = { class = "Touch", token = "touch" }
local keyboardAndMouse: Spec = { class = "KeyboardAndMouse", token = "keyboard-and-mouse" }
local gamepad: Spec = { class = "Gamepad", token = "gamepad" }

local SPECS: { [string]: Spec } = {
	Touch = touch,
	KeyboardAndMouse = keyboardAndMouse,
	Gamepad = gamepad,
}

local function nameOf(value: unknown): string
	return (string.gsub(tostring(value), "^Enum%.PreferredInput%.", ""))
end

local function specOf(value: unknown): Spec
	return SPECS[nameOf(value)] or keyboardAndMouse
end

return {
	specOf = specOf,
}
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="321">
                <Properties>
                  <string name="Name">viewport</string>
                  <string name="Source"><![CDATA[--!strict

local Compose = require "../core"
local Engine = require "./engine"

export type Viewport = { width: number, height: number }

export type Options = {
	minimumSide: number?,
	fallback: Viewport?,
}

local DEFAULT_MINIMUM_SIDE = 100
local DEFAULT_FALLBACK: Viewport = { width = 1280, height = 720 }

local function dimensionsOf(size: Engine.Vector2): Viewport
	return { width = size.X, height = size.Y }
end

local function side(value: unknown, minimum: number): boolean
	return type(value) == "number" and value == value and value >= minimum and value < math.huge
end

local function known(size: Engine.Vector2?, minimum: number?): boolean
	local threshold = if minimum ~= nil then minimum else DEFAULT_MINIMUM_SIDE
	return size ~= nil and side(size.X, threshold) and side(size.Y, threshold)
end

local function createViewport(
	camera: { ViewportSize: Engine.Vector2 },
	engine: Engine.Engine?,
	options: Options?
): (Compose.Readable<Viewport>, Compose.Readable<boolean>)
	local resolved = if engine ~= nil then engine else Engine.ambient()
	local settings = if options ~= nil then options else {} :: Options
	local minimum = if settings.minimumSide ~= nil then settings.minimumSide else DEFAULT_MINIMUM_SIDE
	local fallback = if settings.fallback ~= nil then settings.fallback else DEFAULT_FALLBACK

	local first = camera.ViewportSize
	local settled = known(first, minimum)
	local value = Compose.cell(if settled then dimensionsOf(first) else fallback)
	local ready = Compose.cell(settled)

	local signal = resolved.propertyChanged(camera, "ViewportSize")
	local connection = signal:Connect(function()
		local size = camera.ViewportSize
		if not known(size, minimum) then
			return
		end
		value:set(dimensionsOf(size))
		ready:set(true)
	end)
	Compose.cleanup(function()
		connection:Disconnect()
	end)
	return value, ready
end

return {
	createViewport = createViewport,
	usableViewportSize = known,
}
]]></string>
                </Properties>
              </Item>
            </Item>
          </Item>
        </Item>
      </Item>
