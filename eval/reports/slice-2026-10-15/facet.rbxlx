		price = 150,
		rentPrice = 15,
		strength = 45,
		speed = 50,
		durability = 60,
	},
	{
		id = "haru",
		name = "Haru",
		series = "Circuit",
		rarity = "Common",
		price = 60,
		rentPrice = 6,
		strength = 30,
		speed = 40,
		durability = 45,
	},
	{
		id = "blaze",
		name = "Blaze",
		series = "Rally",
		rarity = "Legendary",
		price = 1000,
		rentPrice = 100,
