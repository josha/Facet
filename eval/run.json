      "studio": {
        "build": [
          "rojo",
          "build",
          "default.project.json",
          "-o",
          "{evidence}/agent.rbxlx"
        ],
        "place": "{evidence}/agent.rbxlx",
        "keep": true
      },
      "overlay": [
        "../artifacts/facetbench/run-inputs",
        "arms/plain"
      ],
      "instructions": "../artifacts/facetbench/plain-instructions.md"
