{
  "schemaVersion": 1,
  "id": "racing-hub-slice",
  "title": "Build the racing hub HUD and shop",
  "tier": "game",
  "brief": "vibe.md",
  "starter": "../starter",
  "checks": [
    {
      "id": "contract",
      "kind": "command",
      "argv": ["lute", "run", "{task}/../../../../tools/play/host/contract.luau", "{task}/../starter", "{workspace}"],
      "deadlineSeconds": 60
    },
    {
      "id": "types",
      "kind": "command",
      "argv": ["lute", "run", "{task}/../../../arms/shared/tools/typecheck/check.luau", "--workspace", "{workspace}", "--definitions", "{task}/../../../../artifacts/facetbench/arm-shared/tools/typecheck/roblox.d.luau", "--scores", "{scores}"],
      "deadlineSeconds": 600,
      "required": false,
      "scores": true
    },
    {
      "id": "play","required":false,
      "kind": "verify",
      "argv": ["lute", "run", "{task}/../hidden/play.luau", "--workspace", "{workspace}", "--outputs", "{outputs}", "--captures", "{captures}", "--report", "{report}", "--run", "{run}", "--scores", "{scores}", "--devices", "{devices}", "--systems", "hud-dock,shop"],
      "deadlineSeconds": 2400,
      "scores": true
    },
    {
      "perDevice": true,
      "dump": "{outputs}/dumps/{device}/shop.json",
      "id": "audit-shop",
      "required": false,
      "kind": "audit"
    },
    {
      "perDevice": true,
      "dump": "{outputs}/dumps/{device}/feedback.json",
      "id": "audit-feedback",
      "required": false,
      "kind": "audit"
    },
    {
      "perDevice": true,
      "dump": "{outputs}/dumps/{device}/hud.json",
      "id": "audit-hud",
      "required": false,
      "kind": "audit"
    },
    {
      "perDevice": true,
      "dump": "{outputs}/dumps/{device}/boosts.json",
      "id": "audit-boosts",
      "required": false,
      "kind": "audit"
    },
    {
      "perDevice": true,
      "dump": "{outputs}/dumps/{device}/quests.json",
      "id": "audit-quests",
      "required": false,
      "kind": "audit"
    },
    {
      "perDevice": true,
      "dump": "{outputs}/dumps/{device}/offer.json",
      "id": "audit-offer",
      "required": false,
      "kind": "audit"
    },
    {"id":"audit-universal-hub","kind":"audit","required":false,"perDevice":true,"dump":"{outputs}/dumps/{device}/universal-hub.json"},
    {"id":"audit-universal-shop","kind":"audit","required":false,"perDevice":true,"dump":"{outputs}/dumps/{device}/universal-shop.json"},
    {"id":"audit-universal-boosts","kind":"audit","required":false,"perDevice":true,"dump":"{outputs}/dumps/{device}/universal-boosts.json"},
    {"id":"audit-universal-quests","kind":"audit","required":false,"perDevice":true,"dump":"{outputs}/dumps/{device}/universal-quests.json"},
    {"id":"audit-universal-offer","kind":"audit","required":false,"perDevice":true,"dump":"{outputs}/dumps/{device}/universal-offer.json"}
  ]
}
