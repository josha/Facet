{
  "schemaVersion": 1,
  "id": "facetbench-slice",
  "tasks": [
    "tasks/racing-hub/slice"
  ],
  "arms": [
    {
      "id": "plain",
      "studio": {
        "build": [
          "rojo",
          "build",
          "default.project.json",
          "-o",
          "{evidence}/agent.rbxlx"
        ],
        "place": "{evidence}/agent.rbxlx"
      },
      "overlay": [
        "arms/shared",
        "../artifacts/facetbench/arm-shared",
        "arms/plain"
      ],
      "instructions": "arms/plain/AGENTS.md",
      "disallowedTools": [
        "WebSearch",
        "WebFetch",
        "Task",
        "Agent"
      ]
    },
    {
      "id": "facet",
      "studio": {
        "build": [
          "rojo",
          "build",
          "default.project.json",
          "-o",
          "{evidence}/agent.rbxlx"
        ],
        "place": "{evidence}/agent.rbxlx"
      },
      "overlay": [
        "arms/shared",
        "../artifacts/facetbench/arm-shared",
        "arms/facet",
        "../artifacts/facetbench/arm-facet"
      ],
      "instructions": "arms/facet/AGENTS.md",
      "disallowedTools": [
        "WebSearch",
        "WebFetch",
        "Task",
        "Agent"
      ]
    }
  ],
  "agents": [
    {
      "id": "claude-opus",
      "adapter": "claude-code",
      "model": "claude-opus-5-5",
      "options": {
        "effort": "medium",
        "settingSources": "project"
      }
    }
  ],
  "seeds": [
    1
  ],
  "parallelism": 1,
  "evidence": "../artifacts/facetbench/slice",
  "budgets": {
    "wallSeconds": 3600,
    "maxCostUsd": 40
  },
  "devices": [
    {
      "id": "desktop",
      "width": 1920,
      "height": 1080,
      "scale": 1,
      "input": [
        "mouse",
        "keyboard"
      ]
    },
    {
      "id": "phone-portrait",
      "width": 390,
      "height": 844,
      "scale": 1,
      "input": [
        "touch"
      ]
    }
  ]
}
