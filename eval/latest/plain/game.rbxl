			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!strict
return {
 Karts={
 {id="pulse",name="Pulse GT",category="Street",rarity="Common",rank=1,speed=92,handling=82,boost=65,price=0,color={25,230,235}},
 {id="comet",name="Comet R",category="Sport",rarity="Rare",rank=2,speed=108,handling=70,boost=80,price=1400,color={255,177,56}},
 {id="spectre",name="Spectre X",category="Hyper",rarity="Epic",rank=3,speed=119,handling=76,boost=92,price=3200,color={173,100,255}},
 {id="nova",name="Nova Zero",category="Hyper",rarity="Legendary",rank=4,speed=132,handling=88,boost=98,price=6500,color={255,54,154}},
 {id="vector",name="Vector S",category="Sport",rarity="Rare",rank=2,speed=102,handling=95,boost=72,price=1800,color={70,245,150}},
 },
 Parts={
 {id="motor",name="Ion motor",category="Motors",slot="Motor",price=650,effect="+12 top speed"},
 {id="boost",name="Plasma cell",category="Boosts",slot="Boost",price=500,effect="+20 boost power"},
 {id="wheels",name="Flux tires",category="Wheels",slot="Wheels",price=450,effect="+18 handling"},
 {id="halo",name="Halo trim",category="Cosmetics",slot="Cosmetic",price=300,effect="Neon signature"},
 },
 Drivers={
 {id="echo",name="Echo",group="Pilots",price=0,rent=0,stat="+3 handling"},
 {id="rex",name="Rex",group="Pros",price=1800,rent=250,stat="+8 speed"},
 {id="nyx",name="Nyx",group="Pros",price=2400,rent=350,stat="+12 boost"}
 },
 Colors={Red={255,65,82},Amber={255,183,52},Green={55,235,139},Cyan={25,230,235},Blue={65,123,255},Violet={175,91,255}}
}
]]></ProtectedString>
				<string name="ScriptGuid">{366FFDB2-BAA1-4F62-8595-5D6A461510CA}</string>
