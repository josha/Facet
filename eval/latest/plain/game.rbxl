			<Item class="LocalScript" referent="RBXFB624342CB3F4D6BAA160F3492121B67">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!strict
local P=game:GetService("Players").LocalPlayer
local RS=game:GetService("ReplicatedStorage")
local UIS=game:GetService("UserInputService")
local CAS=game:GetService("ContextActionService")
local GS=game:GetService("GuiService")
local Run=game:GetService("RunService")
local D=require(RS.ApexData)
local remote=RS.ApexRequest
local gui=Instance.new("ScreenGui",P:WaitForChild("PlayerGui")) gui.Name="NEON_APEX" gui.ResetOnSpawn=false gui.IgnoreGuiInset=false gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
local C={bg=Color3.fromRGB(10,15,28),panel=Color3.fromRGB(19,27,45),card=Color3.fromRGB(27,37,58),line=Color3.fromRGB(49,66,91),text=Color3.fromRGB(239,246,255),muted=Color3.fromRGB(143,162,188),cyan=Color3.fromRGB(33,229,235),pink=Color3.fromRGB(255,65,152),gold=Color3.fromRGB(255,192,72)}
local function corner(o,r) local a=Instance.new("UICorner",o) a.CornerRadius=UDim.new(0,r or 12) end
local function frame(parent,size,pos,col)
 local f=Instance.new("Frame") f.Size=size f.Position=pos or UDim2.new() f.BackgroundColor3=col or C.panel f.BorderSizePixel=0 f.Parent=parent corner(f) return f
end
local function label(parent,text,size,pos,fontSize,col)
 local t=Instance.new("TextLabel") t.Size=size t.Position=pos or UDim2.new() t.BackgroundTransparency=1 t.Text=text t.Font=Enum.Font.GothamMedium t.TextSize=fontSize or 14 t.TextColor3=col or C.text t.TextXAlignment=Enum.TextXAlignment.Left t.TextWrapped=true t.Parent=parent return t
end
local function button(parent,text,callback,size,pos,accent)
 local b=Instance.new("TextButton") b.Size=size or UDim2.new(1,0,0,42) b.Position=pos or UDim2.new() b.BackgroundColor3=accent or C.card b.TextColor3=accent==C.cyan and C.bg or C.text b.Text=text b.Font=Enum.Font.GothamBold b.TextSize=14 b.AutoButtonColor=true b.BorderSizePixel=0 b.Parent=parent b.Selectable=true corner(b,9)
 b.Activated:Connect(callback) return b
end
local function layout(f,gap) local l=Instance.new("UIListLayout",f) l.Padding=UDim.new(0,gap or 10) l.SortOrder=Enum.SortOrder.LayoutOrder return l end
local function pad(f,n) local p=Instance.new("UIPadding",f) p.PaddingLeft=UDim.new(0,n) p.PaddingRight=UDim.new(0,n) p.PaddingTop=UDim.new(0,n) p.PaddingBottom=UDim.new(0,n) end
local state={} local panelName=nil local render local open local close local request local draft=nil local dirty=false local selected="pulse" local search="" local category="All" local rarity="All" local sorting="A → Z" local shopCat="All" local driverGroup="All" local partySearch="" local telemetry=nil local kart=nil local busy=false local helpStep=0 local chatOpen=false local boardOpen=false
local toast=label(gui,"",UDim2.new(0.85,0,0,42),UDim2.new(0.075,0,1,-108),15,C.cyan) toast.TextXAlignment=Enum.TextXAlignment.Center toast.BackgroundColor3=C.bg corner(toast) toast.Visible=false toast.ZIndex=20
local function notify(s) toast.Text=tostring(s) toast.Visible=true local v=toast.Text task.delay(4,function() if toast.Text==v then toast.Visible=false end end) end
local header=frame(gui,UDim2.new(1,-24,0,62),UDim2.fromOffset(12,8),C.bg)
local brand=label(header,"N / A",UDim2.fromOffset(88,54),UDim2.fromOffset(16,4),25,C.cyan) brand.Font=Enum.Font.GothamBlack
local wallet=label(header,"",UDim2.new(1,-112,1,0),UDim2.fromOffset(100,0),14)
local nav=Instance.new("ScrollingFrame",gui) nav.Size=UDim2.new(1,-24,0,58) nav.Position=UDim2.new(0,12,1,-64) nav.BackgroundColor3=C.bg nav.BorderSizePixel=0 nav.ScrollBarThickness=0 nav.AutomaticCanvasSize=Enum.AutomaticSize.X nav.CanvasSize=UDim2.new() corner(nav) pad(nav,6)
local nl=layout(nav,6) nl.FillDirection=Enum.FillDirection.Horizontal
local hero=frame(gui,UDim2.fromOffset(350,330),UDim2.new(0,24,0.5,-125),C.bg) pad(hero,22)
label(hero,"SEASON 01  /  AFTER DARK",UDim2.new(1,0,0,22),UDim2.new(),12,C.cyan)
local title=label(hero,"CHASE\nTHE NEON.",UDim2.new(1,0,0,110),UDim2.fromOffset(0,28),42) title.Font=Enum.Font.GothamBlack
label(hero,"Build your machine. Own the night.\nTwo laps. Four racers. One apex.",UDim2.new(1,0,0,55),UDim2.fromOffset(0,144),15,C.muted)
button(hero,"ENTER RACE GRID  →",function() open("Race") end,UDim2.new(1,0,0,48),UDim2.fromOffset(0,211),C.cyan)
button(hero,"Explore garage",function() open("Garage") end,UDim2.new(1,0,0,38),UDim2.fromOffset(0,267))
local dailyChip=button(gui,"DAILY REWARD • READY",function() open("Rewards") end,UDim2.fromOffset(245,40),UDim2.new(1,-269,0,86),C.panel)
local modal=frame(gui,UDim2.new(0.88,0,0.76,0),UDim2.new(0.06,0,0.12,0),C.bg) modal.Visible=false
local max=Instance.new("UISizeConstraint",modal) max.MaxSize=Vector2.new(1040,780)
modal.AnchorPoint=Vector2.new(0.5,0.5) modal.Position=UDim2.fromScale(0.5,0.51)
local panelTitle=label(modal,"",UDim2.new(1,-86,0,54),UDim2.fromOffset(20,0),24,C.cyan) panelTitle.Font=Enum.Font.GothamBold
local x=button(modal,"×",function() close() end,UDim2.fromOffset(42,40),UDim2.new(1,-54,0,8))
local content=Instance.new("ScrollingFrame",modal) content.BackgroundTransparency=1 content.BorderSizePixel=0 content.Size=UDim2.new(1,-32,1,-68) content.Position=UDim2.fromOffset(16,60) content.ScrollBarThickness=4 content.ScrollBarImageColor3=C.cyan content.AutomaticCanvasSize=Enum.AutomaticSize.Y content.CanvasSize=UDim2.new() layout(content,10)
local confirmation=nil
local function confirm(text,fn)
 if confirmation then confirmation:Destroy() end
 local f=frame(gui,UDim2.new(0.88,0,0,220),UDim2.fromScale(0.5,0.5),C.panel) f.AnchorPoint=Vector2.new(0.5,0.5) f.ZIndex=50 local z=Instance.new("UISizeConstraint",f) z.MaxSize=Vector2.new(480,240) confirmation=f
 local l=label(f,text,UDim2.new(1,-40,0,115),UDim2.fromOffset(20,12),18) l.ZIndex=51
 local function done() f:Destroy() confirmation=nil end
 local cancel=button(f,"Cancel",function() done() GS.SelectedObject=x end,UDim2.new(0.44,0,0,44),UDim2.new(0.04,0,1,-60)) cancel.ZIndex=51
 local accept=button(f,"Confirm",function() done() fn() end,UDim2.new(0.44,0,0,44),UDim2.new(0.52,0,1,-60),C.cyan) accept.ZIndex=51 GS.SelectedObject=cancel
end
local function updateHUD()
 wallet.Text=string.format("◈ %s CR    ◆ %s   |   LV %s • %s/400 XP   |   %s RACES",state.coins or 0,state.gems or 0,state.level or 1,(state.xp or 0)%400,state.races or 0)
 dailyChip.Text=state.lastDaily==math.floor(os.time()/86400) and "DAILY • NEXT DAY LOCKED" or "DAILY REWARD • READY"
end
request=function(action,arg,after)
 if busy then notify("Request pending") return end busy=true notify("Saving…")
 local ok,a,b,c=pcall(function() return remote:InvokeServer(action,arg) end) busy=false
 if not ok then notify("Request failed • please retry") return end
 if a then notify(b or "Confirmed") if after then after(c) end else notify(b or "Request rejected") end
end
local function row(title,sub,h)
 local f=frame(content,UDim2.new(1,-6,0,h or 112),nil,C.card)
 label(f,title,UDim2.new(1,-24,0,29),UDim2.fromOffset(14,8),17)
 label(f,sub or "",UDim2.new(1,-24,0,40),UDim2.fromOffset(14,38),13,C.muted)
 return f
end
local function actionRow(title,sub,text,fn,accent)
 local f=row(title,sub,126)
 button(f,text,fn,UDim2.new(1,-28,0,36),UDim2.fromOffset(14,80),accent) return f
end
local function textBox(placeholder,value,fn)
 local b=Instance.new("TextBox",content) b.Size=UDim2.new(1,-6,0,44) b.BackgroundColor3=C.card b.TextColor3=C.text b.PlaceholderText=placeholder b.Text=value b.ClearTextOnFocus=false b.Font=Enum.Font.Gotham b.TextSize=15 b.BorderSizePixel=0 corner(b)
 b.FocusLost:Connect(function() fn(b.Text) end) return b
end
local function cycle(title,values,current,fn)
 button(content,title..": "..tostring(current).."   ›",function() local i=table.find(values,current) or 0 fn(values[i%#values+1]) end)
end
local function preview()
 local f=frame(content,UDim2.new(1,-6,0,180),nil,Color3.fromRGB(13,23,39))
 local vp=Instance.new("ViewportFrame",f) vp.Size=UDim2.new(0.6,0,1,0) vp.Position=UDim2.fromScale(0.4,0) vp.BackgroundTransparency=1 vp.Ambient=Color3.fromRGB(200,220,255) vp.LightColor=Color3.new(1,1,1)
 local cam=Instance.new("Camera",vp) vp.CurrentCamera=cam cam.CFrame=CFrame.lookAt(Vector3.new(10,7,12),Vector3.new(0,1,0))
 local design=draft or state.livery or {body="Cyan",accent="Violet",shade=100,decal="Circuit"}
 local function p(size,pos,col) local q=Instance.new("Part",vp) q.Size=size q.Position=pos q.Color=col q.Anchored=true return q end
 local col=Color3.fromRGB(unpack(D.Colors[design.body])):Lerp(Color3.new(),1-design.shade/100)
 p(Vector3.new(5,1,7),Vector3.new(0,1,0),col) p(Vector3.new(2.5,1.5,3),Vector3.new(0,2,0),C.bg)
 p(Vector3.new(6,0.4,1),Vector3.new(0,2.5,3),Color3.fromRGB(unpack(D.Colors[design.accent])))
 for _,a in {-3,3} do for _,b in {-2,2} do local q=p(Vector3.new(1.4,2,2),Vector3.new(a,0.7,b),C.bg) q.Shape=Enum.PartType.Cylinder q.Orientation=Vector3.new(0,0,90) end end
 label(f,"DESIGN LAB\n"..design.decal.."\n"..(dirty and "● UNSAVED" or "✓ SESSION SAVED"),UDim2.new(0.4,-10,1,-20),UDim2.fromOffset(14,10),16,C.cyan)
end
local function rebuild() if render and panelName then render() end end
render=function()
 for _,q in content:GetChildren() do if q:IsA("GuiObject") then q:Destroy() end end
 panelTitle.Text=string.upper(panelName or "")
 if panelName=="Garage" then
 textBox("Search kart names…",search,function(v) search=v rebuild() end)
 button(content,"Clear search",function() search="" rebuild() end)
 cycle("Category",{"All","Street","Sport","Hyper"},category,function(v) category=v rebuild() end)
 cycle("Rarity",{"All","Common","Rare","Epic","Legendary"},rarity,function(v) rarity=v rebuild() end)
 cycle("Sort",{"A → Z","Speed ↓","Rarity ↓"},sorting,function(v) sorting=v rebuild() end)
 local list={} for _,k in D.Karts do if string.find(string.lower(k.name),string.lower(search),1,true) and (category=="All" or k.category==category) and (rarity=="All" or k.rarity==rarity) then table.insert(list,k) end end
 table.sort(list,function(a,b) if sorting=="Speed ↓" and a.speed~=b.speed then return a.speed>b.speed elseif sorting=="Rarity ↓" and a.rank~=b.rank then return a.rank>b.rank end return a.name<b.name end)
 if #list==0 then row("No karts found","Clear search or adjust filters.") end
 for _,k in list do
 local f=row((selected==k.id and "▸ " or "")..k.name..(state.favorites[k.id] and "  ★" or "")..(state.kart==k.id and "  / NEXT RACE" or ""),k.rarity.." • "..k.category.."\nSPD "..k.speed.."  HND "..k.handling.."  BST "..k.boost,210)
 button(f,"Inspect",function() selected=k.id rebuild() end,UDim2.new(0.47,0,0,34),UDim2.new(0.02,0,0,86))
 button(f,state.favorites[k.id] and "★ Favorite" or "☆ Favorite",function() request("favorite",{id=k.id}) end,UDim2.new(0.47,0,0,34),UDim2.new(0.51,0,0,86))
 button(f,state.owned[k.id] and (state.kart==k.id and "Selected" or "Choose kart") or ("Buy • "..k.price.." CR"),function() selected=k.id if state.owned[k.id] then request("kart",{id=k.id}) else confirm("Buy "..k.name.." for "..k.price.." credits?",function() request("buy",{id=k.id}) end) end end,UDim2.new(0.96,0,0,34),UDim2.new(0.02,0,0,126),C.cyan)
 button(f,"Preview drive • exit returns to hub",function() request("try",{id=k.id},function() modal.Visible=false panelName=nil end) end,UDim2.new(0.96,0,0,34),UDim2.new(0.02,0,0,166))
 end
 elseif panelName=="Shop" then
 cycle("Browse",{"All","Motors","Boosts","Wheels","Cosmetics"},shopCat,function(v) shopCat=v rebuild() end)
 button(content,"Redeem a code  →  sample: NEON2026",function() open("Codes") end)
 for _,v in D.Parts do if shopCat=="All" or shopCat==v.category then
 actionRow(v.name.." • "..v.category,v.effect.."\n"..v.price.." CR • "..(state.owned[v.id] and "OWNED" or (state.coins>=v.price and "Affordable" or "Insufficient credits")),state.owned[v.id] and "Owned • view Inventory" or "Purchase",function() if state.owned[v.id] then open("Inventory") else confirm("Purchase "..v.name.."\nFull price: "..v.price.." credits",function() request("buy",{id=v.id}) end) end end,C.cyan)
 end end
 elseif panelName=="Inventory" then
 row("LOADOUT", "One item per slot. Equipping replaces that slot.\nDriver: "..state.driver.." • Kart: "..state.kart)
 for _,slot in {"Motor","Boost","Wheels","Cosmetic"} do row(slot.." slot",state.equipped[slot] or "EMPTY",82) end
 for _,v in D.Parts do actionRow(v.name,v.effect.." • "..(state.owned[v.id] and "OWNED" or "UNAVAILABLE"),state.equipped[v.slot]==v.id and "Unequip" or "Equip",function() request("equip",{id=v.id}) end) end
 button(content,"Choose driver",function() open("Drivers") end)
 elseif panelName=="Drivers" then
 cycle("Group",{"All","Pilots","Pros"},driverGroup,function(v) driverGroup=v rebuild() end)
 for _,d in D.Drivers do if driverGroup=="All" or d.group==driverGroup then
 local active=(state.rentals[d.id] or 0)>os.time()
 actionRow(d.name.." • "..d.group,d.stat.." • "..(state.owned[d.id] and "PERMANENT" or active and ("RENTED • "..math.ceil((state.rentals[d.id]-os.time())/60).."m left") or "UNAVAILABLE"),state.driver==d.id and "Equipped" or "Equip",function() request("driver",{id=d.id,mode="equip"}) end)
 if not state.owned[d.id] then
 button(content,"Buy "..d.name.." • "..d.price.." CR",function() confirm("Permanently own "..d.name.." for "..d.price.." credits?",function() request("driver",{id=d.id,mode="buy"}) end) end)
 button(content,"Rent "..d.name.." • 10 minutes • "..d.rent.." CR",function() confirm("Rent "..d.name.." for 10 minutes?\nFull price: "..d.rent.." credits",function() request("driver",{id=d.id,mode="rent"}) end) end)
 end end end
 elseif panelName=="Livery" then
 preview()
 cycle("Editing",{"Body","Accent"},_G.apexChannel or "Body",function(v) _G.apexChannel=v rebuild() end)
 for _,name in {"Red","Amber","Green","Cyan","Blue","Violet"} do
 button(content,name,function() draft[(_G.apexChannel or "Body")=="Body" and "body" or "accent"]=name dirty=true rebuild() end,nil,nil,Color3.fromRGB(unpack(D.Colors[name])):Lerp(Color3.new(),0.45))
 end
 cycle("Shade",{50,75,100},draft.shade,function(v) draft.shade=v dirty=true rebuild() end)
 cycle("Decal",{"Circuit","Bolt","Stars","Fang","Orbit","Stripes"},draft.decal,function(v) draft.decal=v dirty=true rebuild() end)
 button(content,"Save design",function() request("livery",draft,function() dirty=false rebuild() end) end,nil,nil,C.cyan)
 button(content,"Revert",function() if dirty then confirm("Discard unsaved design?",function() draft=table.clone(state.livery) dirty=false rebuild() end) end end)
 elseif panelName=="Upgrades" then
 cycle("Kart",{"pulse","comet","spectre","nova","vector"},selected,function(v) selected=v rebuild() end)
 for _,stat in {"speed","handling","boost"} do local level=(state.upgrades[selected] or {})[stat] or 0
 actionRow(string.upper(stat).."  /  LV "..level.."/3",level>=3 and "MAXIMUM" or ("Next: +6 "..stat.."\n"..(400*(level+1)).." CR + "..(10*(level+1)).." gems"),level>=3 and "Max level" or "Upgrade",function() confirm("Upgrade "..selected.." "..stat.."?\n"..400*(level+1).." credits + "..10*(level+1).." gems",function() request("upgrade",{id=selected,stat=stat}) end) end,C.cyan)
 end
 elseif panelName=="Race" then
 row("THE GRID • 2 LAPS","Solo: you + 3 AI rivals. Duo: local demo fill.\nQueue 8s → vote 8s → lights out.")
 if state.phase=="Queue" or state.phase=="Voting" then
 row(state.phase=="Queue" and "QUEUE JOINED" or "TRACK VOTE",state.phase=="Queue" and ("Joined "..(state.mode=="Duo" and "2 / 2" or "1 / 1").." • demo AI fill\nStarting in "..math.max(0,(state.queueEnd or 0)-os.time()).."s") or ("Deadline in "..math.max(0,(state.voteEnd or 0)-os.time()).."s"))
 if state.phase=="Voting" then
 for i,t in {"Neon Harbor","Violet Run"} do actionRow(t,(i==1 and "Electric waterfront • balanced circuit" or "Violet atmosphere • same technical oval").."\nVotes: "..((state.vote==t and 1 or 0)+(i==1 and 2 or 1))..(state.vote==t and "  ✓ YOUR VOTE" or ""), "Vote",function() request("vote",{track=t}) end) end end
 button(content,"Leave queue",function() request("leaveQueue") end)
 else
 button(content,"SOLO  •  Join queue",function() request("queue",{mode="Solo"}) end,nil,nil,C.cyan)
 button(content,"DUO  •  Join queue",function() request("queue",{mode="Duo"}) end)
 end
 elseif panelName=="Rewards" then
 local ready=state.lastDaily~=math.floor(os.time()/86400)
 row("7-DAY NIGHT SHIFT",ready and "● Reward ready • claim below" or ("Next claim in "..(86400-os.time()%86400).."s"))
 for i=1,7 do row("DAY "..i.."  "..(i<=state.daily and "✓ CLAIMED" or i==state.daily+1 and ready and "● READY" or "LOCKED"),i==7 and "700 credits + 100 gems + Halo trim" or (i*100).." credits",78) end
 button(content,"Claim daily reward",function() request("daily") end,nil,nil,C.cyan)
 actionRow("Quest • First finish","Finish a race: "..math.min(1,state.races).."/1 • 400 credits",state.quest and "Claimed" or "Claim quest",function() request("quest") end)
 actionRow("Income booster","2× race credits for 10 minutes • "..math.max(0,state.boostUntil-os.time()).."s active","Activate • 200 CR",function() confirm("Activate 2× race income for 200 credits?",function() request("boost") end) end)
 actionRow("Night starter offer",state.offerBought and "Purchased • 3 crates granted" or ("3 crates • 800 CR • expires in "..math.max(0,state.offerEnd-os.time()).."s"),"View offer",function() confirm("Buy 3 crates for 800 credits?",function() request("offer") end) end)
 elseif panelName=="Crates" then
 row("ION ARCHIVE","3 cards per crate • 300 credits\nOdds per card: Common 60% / Rare 30% / Epic 10%\nFree crates remaining: "..state.freeCrates,130)
 button(content,"Open crate",function() confirm(state.freeCrates>0 and "Use 1 free crate? 3 cards." or "Open 3-card crate for 300 credits?",function() request("crate",{},function(cards) _G.apexCards=cards _G.apexReveal=0 open("Reveal") end) end) end,nil,nil,C.cyan)
 local count=0 for _,n in {"Pulse","Comet","Nova"} do if state.cards[n] then count+=1 end end
 row("COLLECTION • "..count.."/3", "Unknown cards reveal through crates.")
 for _,n in {"Pulse","Comet","Nova"} do row(state.cards[n] and n or "???",state.cards[n] and ("Owned ×"..state.cards[n]) or "Unknown card",78) end
 elseif panelName=="Reveal" then
 local cards=_G.apexCards or {} local shown=_G.apexReveal or 0
 for i=1,#cards do row("CARD "..i,i<=shown and cards[i] or "◆ UNREVEALED",82) end
 button(content,"Reveal next",function() _G.apexReveal=math.min(#cards,shown+1) rebuild() end,nil,nil,C.cyan)
 button(content,"Reveal all",function() _G.apexReveal=#cards rebuild() end)
 button(content,"Collection",function() open("Crates") end)
 elseif panelName=="Codes" then
 row("TRANSMISSION CODES","Try NEON2026 for 500 credits + 25 gems.\nCodes ignore case and surrounding spaces.")
 local box=textBox("Enter code",_G.apexCode or "",function(v) _G.apexCode=v end)
 button(content,"Redeem",function() _G.apexCode=box.Text request("code",{code=box.Text}) end,nil,nil,C.cyan)
 button(content,"← Return to shop",function() open("Shop") end)
 elseif panelName=="Party" then
 row("YOUR CREW","Solo demo participants are clearly marked.\nAccepted members persist through filtering.")
 textBox("Search friends",partySearch,function(v) partySearch=v rebuild() end)
 button(content,"Clear search",function() partySearch="" rebuild() end)
 for _,n in {"KIRA • demo","JAX • demo","MILO • offline"} do if string.find(string.lower(n),string.lower(partySearch),1,true) then actionRow(n,(n=="KIRA • demo" and "Online • accepts demo invitation" or n=="JAX • demo" and "Racing • declines demo invitation" or "Offline").."\n"..(state.party[n] or "Not invited"),state.party[n] or "Invite",function() request("party",{name=n}) end) end end
 for n,status in state.party do if status=="Accepted" then row("PARTY MEMBER",n.." • Accepted",78) end end
 elseif panelName=="Settings" then
 row("PREFERENCES","Saved for this session • no cloud storage configured.\nSliders: use − / + with touch or controller.")
 for _,k in {"music","effects","quality"} do
 local v=state.settings[k] local f=row(string.upper(k).."  "..v,"",90)
 button(f,"−",function() request("settings",{[k]=math.max(0,v-(k=="quality" and 1 or 10))}) end,UDim2.new(0.45,0,0,34),UDim2.new(0.03,0,0,43))
 button(f,"+",function() request("settings",{[k]=math.min(k=="quality" and 3 or 100,v+(k=="quality" and 1 or 10))}) end,UDim2.new(0.45,0,0,34),UDim2.new(0.52,0,0,43))
 end
 for _,k in {"damage","shake","large","motion"} do button(content,k.."  •  "..(state.settings[k] and "ON" or "OFF"),function() request("settings",{[k]=not state.settings[k]}) end) end
 row("CONTROLS","WASD / arrows: accelerate, brake, steer\nShift / gamepad X: boost • R: recover\nTab / L1: leaderboard • Q / Y: quick chat\nB: back • touch controls appear while driving",150)
 button(content,"Reset defaults",function() confirm("Reset all settings to defaults?",function() request("settings",{music=60,effects=80,quality=3,damage=true,shake=true,large=false,motion=false}) end) end)
 button(content,"Replay tutorial",function() helpStep=1 close() end)
 elseif panelName=="Mechanic" then
 row("AXEL / PIT ENGINEER","“The night rewards a clean finish.\nWant a workshop job? Finish one race.\nI'll pay you 350 credits.”",140)
 if state.job=="none" then button(content,"Ask about job",function() request("job",{mode="ask"}) end) button(content,"Accept job",function() request("job",{mode="accept"}) end,nil,nil,C.cyan) button(content,"Decline",function() close() end)
 elseif state.job=="ready" then button(content,"Claim promised 350 CR",function() request("job",{mode="claim"}) end,nil,nil,C.cyan)
 else row(state.job=="done" and "JOB COMPLETE" or "JOB ACTIVE",state.job=="done" and "Reward paid once. See you on the grid." or "Finish a race • return to Axel.") end
 button(content,"Leave conversation",function() close() end)
 end
end
close=function()
 if confirmation then confirmation:Destroy() confirmation=nil GS.SelectedObject=x return end
 if panelName=="Livery" and dirty then confirm("Discard unsaved livery changes?\nCancel keeps your draft.",function() draft=table.clone(state.livery) dirty=false panelName=nil modal.Visible=false end) return end
 modal.Visible=false panelName=nil GS.SelectedObject=nil
end
open=function(name)
 if panelName=="Livery" and dirty and name~="Livery" then confirm("Discard unsaved livery changes?",function() dirty=false draft=table.clone(state.livery) open(name) end) return end
 panelName=name if name=="Livery" and not dirty then draft=table.clone(state.livery) end modal.Visible=true render() GS.SelectedObject=x
end
for _,n in {"Race","Garage","Shop","Inventory","Drivers","Livery","Upgrades","Rewards","Crates","Party","Settings","Mechanic"} do
 button(nav,n,function() open(n) end,UDim2.fromOffset(n=="Inventory" and 104 or 88,44))
end
local raceHUD=frame(gui,UDim2.fromOffset(260,95),UDim2.fromOffset(16,86),C.bg) raceHUD.Visible=false
local raceText=label(raceHUD,"",UDim2.new(1,-24,1,-12),UDim2.fromOffset(12,6),20,C.cyan)
local count=label(gui,"",UDim2.fromOffset(260,120),UDim2.new(0.5,-130,0.3,0),70,C.text) count.TextXAlignment=Enum.TextXAlignment.Center count.Font=Enum.Font.GothamBlack
local raceButtons=frame(gui,UDim2.fromOffset(186,146),UDim2.new(1,-202,1,-225),C.bg) raceButtons.Visible=false pad(raceButtons,5) layout(raceButtons,4)
button(raceButtons,"Recover [R]",function() request("recover") end,UDim2.new(1,0,0,40))
button(raceButtons,"Exit to hub",function() request("return") end,UDim2.new(1,0,0,40))
local scoreboard=frame(gui,UDim2.new(0.85,0,0,260),UDim2.fromScale(0.5,0.46),C.bg) scoreboard.AnchorPoint=Vector2.new(0.5,0.5) scoreboard.Visible=false local sm=Instance.new("UISizeConstraint",scoreboard) sm.MaxSize=Vector2.new(600,280)
local boardText=label(scoreboard,"",UDim2.new(1,-32,1,-62),UDim2.fromOffset(16,54),18)
label(scoreboard,"LIVE CLASSIFICATION",UDim2.new(1,-60,0,42),UDim2.fromOffset(16,5),20,C.cyan)
button(scoreboard,"×",function() boardOpen=false scoreboard.Visible=false end,UDim2.fromOffset(36,36),UDim2.new(1,-44,0,6))
local chat=frame(gui,UDim2.new(0.85,0,0,360),UDim2.fromScale(0.5,0.5),C.bg) chat.AnchorPoint=Vector2.new(0.5,0.5) chat.Visible=false local cm=Instance.new("UISizeConstraint",chat) cm.MaxSize=Vector2.new(480,360) pad(chat,12) layout(chat,5)
for _,m in {"Let's race!","Good luck!","Nice drift!","Follow me","Great race!","Thanks!","Oops!","One more?"} do button(chat,m,function() chatOpen=false chat.Visible=false request("chat",{message=m}) end,UDim2.new(1,0,0,36)) end
local chatButton=button(gui,"CHAT [Q / Y]",function() chatOpen=not chatOpen chat.Visible=chatOpen end,UDim2.fromOffset(145,36),UDim2.new(1,-161,0,132))
local boardButton=button(gui,"STANDINGS [TAB]",function() boardOpen=not boardOpen scoreboard.Visible=boardOpen end,UDim2.fromOffset(160,36),UDim2.new(1,-176,0,174))
local help=frame(gui,UDim2.new(0.9,0,0,144),UDim2.new(0.05,0,1,-224),C.panel) help.Visible=false
local helpText=label(help,"",UDim2.new(1,-24,0,74),UDim2.fromOffset(12,4),15,C.cyan)
button(help,"Back",function() if helpStep>1 then helpStep-=1 end end,UDim2.new(0.28,0,0,36),UDim2.new(0.03,0,1,-48))
button(help,"Next",function() helpStep+=1 if helpStep>3 then helpStep=0 request("help") end end,UDim2.new(0.28,0,0,36),UDim2.new(0.36,0,1,-48),C.cyan)
button(help,"Skip",function() helpStep=0 request("help") end,UDim2.new(0.25,0,0,36),UDim2.new(0.7,0,1,-48))
local throttle=0 local steer=0 local boost=false local key={}
local function bind(name,keys,fn,touch,pos,title)
 CAS:BindAction(name,function(_,s,input) fn(s,input) if not kart and touch then return Enum.ContextActionResult.Pass end return Enum.ContextActionResult.Sink end,touch,unpack(keys))
 if touch then CAS:SetPosition(name,pos) CAS:SetTitle(name,title) end
end
bind("ApexThrottle",{Enum.KeyCode.W,Enum.KeyCode.Up,Enum.KeyCode.ButtonR2},function(s) key.go=s~=Enum.UserInputState.End end,true,UDim2.new(1,-100,1,-280),"GO")
bind("ApexBrake",{Enum.KeyCode.S,Enum.KeyCode.Down,Enum.KeyCode.ButtonL2},function(s) key.brake=s~=Enum.UserInputState.End end,true,UDim2.new(1,-170,1,-230),"BRAKE")
bind("ApexLeft",{Enum.KeyCode.A,Enum.KeyCode.Left},function(s) key.left=s~=Enum.UserInputState.End end,true,UDim2.new(0,30,1,-210),"◀")
bind("ApexRight",{Enum.KeyCode.D,Enum.KeyCode.Right},function(s) key.right=s~=Enum.UserInputState.End end,true,UDim2.new(0,105,1,-210),"▶")
bind("ApexBoost",{Enum.KeyCode.LeftShift,Enum.KeyCode.ButtonX},function(s) boost=s~=Enum.UserInputState.End end,true,UDim2.new(1,-100,1,-350),"BOOST")
bind("ApexBoard",{Enum.KeyCode.Tab,Enum.KeyCode.ButtonL1},function(s) if s==Enum.UserInputState.Begin then boardOpen=not boardOpen scoreboard.Visible=boardOpen end end,false)
bind("ApexChat",{Enum.KeyCode.Q,Enum.KeyCode.ButtonY},function(s) if s==Enum.UserInputState.Begin then chatOpen=not chatOpen chat.Visible=chatOpen if chatOpen then GS.SelectedObject=chat:FindFirstChildWhichIsA("TextButton") else GS.SelectedObject=chatButton end end end,false)
bind("ApexRecover",{Enum.KeyCode.R},function(s) if s==Enum.UserInputState.Begin then request("recover") end end,false)
bind("ApexBack",{Enum.KeyCode.ButtonB},function(s) if s==Enum.UserInputState.Begin then if chatOpen then chatOpen=false chat.Visible=false GS.SelectedObject=chatButton elseif boardOpen then boardOpen=false scoreboard.Visible=false GS.SelectedObject=boardButton elseif panelName or confirmation then close() elseif helpStep>0 then if helpStep>1 then helpStep-=1 else helpStep=0 request("help") end end end end,false)
UIS.InputChanged:Connect(function(i) if i.KeyCode==Enum.KeyCode.Thumbstick1 then steer=i.Position.X end end)
local function receive(kind,data)
 if kind=="state" then state=data updateHUD() if panelName then rebuild() end local bloom=game.Lighting:FindFirstChildOfClass('BloomEffect') if bloom then bloom.Enabled=state.settings.quality>0 end game.Lighting.GlobalShadows=state.settings.quality>1
 elseif kind=="race" then kart=data GS.SelectedObject=nil modal.Visible=false panelName=nil hero.Visible=false nav.Visible=false raceHUD.Visible=true raceButtons.Visible=true if P.Character then local ff=P.Character:FindFirstChildOfClass("ForceField") if ff then ff.Visible=false end end
 elseif kind=="hub" then kart=nil workspace.CurrentCamera.CameraType=Enum.CameraType.Custom hero.Visible=true nav.Visible=true raceHUD.Visible=false raceButtons.Visible=false count.Text="" scoreboard.Visible=false
 elseif kind=="telemetry" then telemetry=data raceText.Text="LAP "..data.lap.." / 2    "..data.speed.." KM/H\nBOOST "..data.energy.."%   •   "..math.floor(data.progress*100).."%"
 count.Text=data.countdown>0 and tostring(data.countdown) or ""
 local lines={} for i,v in data.board do table.insert(lines,i..".  "..(v.you and "▶ YOU" or v.name).."   |   LAP "..v.lap.."   "..(v.finished and "FINISHED" or "RACING")) end boardText.Text=table.concat(lines,"\n\n")
 elseif kind=="results" then
 boardOpen=true scoreboard.Visible=true count.Text="FINISH" notify("P"..data.position.." • +"..data.coins.." CR + "..data.gems.." gems • Returning in 10s")
 elseif kind=="chat" then notify(data)
 elseif kind=="mechanic" then open("Mechanic")
 end
end
RS.ApexUpdate.OnClientEvent:Connect(receive)
local ok,s=remote:InvokeServer("get") if ok then receive("state",s) if not s.tutorial then helpStep=1 end end
local timer=0 local refresh=0
Run.RenderStepped:Connect(function(dt)
 timer+=dt refresh+=dt
 if timer>0.07 then timer=0 if kart then RS.ApexDrive:FireServer((key.go and 1 or 0)-(key.brake and 1 or 0),(key.right and 1 or 0)-(key.left and 1 or 0)+steer,boost) end end
 if kart and kart.Parent then
 local cam=workspace.CurrentCamera cam.CameraType=Enum.CameraType.Scriptable local cf=kart:GetPivot()
 local target=CFrame.lookAt(cf.Position-cf.LookVector*24+Vector3.new(0,13,0),cf.Position+cf.LookVector*14)
 cam.CFrame=cam.CFrame:Lerp(target,state.settings.motion and 1 or math.min(1,dt*7))
 end
 local narrow=gui.AbsoluteSize.X<650 nav.Visible=not kart dailyChip.Visible=not kart
 hero.Size=UDim2.fromOffset(narrow and math.min(330,gui.AbsoluteSize.X-32) or 350,330)
 hero.Position=narrow and UDim2.new(0,16,0,200) or UDim2.new(0,24,0.5,-125)
 brand.Visible=not narrow wallet.Position=UDim2.fromOffset(narrow and 12 or 100,0) wallet.Size=UDim2.new(1,narrow and -24 or -112,1,0) wallet.TextSize=narrow and 11 or 14
 help.Visible=helpStep>0 and not kart and not modal.Visible
 if helpStep>0 then helpText.Text="PIT GUIDE  "..helpStep.." / 3\n"..({"↓ GARAGE: inspect karts, choose your next ride. Use Garage below.","↓ SHOP: purchase parts, then equip in Inventory.","↓ RACE: enter Solo queue, vote, then accelerate at lights out."})[helpStep] end
 if panelName=="Mechanic" and P.Character and P.Character.PrimaryPart and (P.Character.PrimaryPart.Position-Vector3.new(-28,4,12)).Magnitude>65 then close() end
 for _,an in {"ApexThrottle","ApexBrake","ApexLeft","ApexRight","ApexBoost"} do local tb=CAS:GetButton(an) if tb then tb.Visible=kart~=nil end end if refresh>1 then refresh=0 if panelName=="Race" or panelName=="Rewards" then rebuild() end end
end)
]]></ProtectedString>
