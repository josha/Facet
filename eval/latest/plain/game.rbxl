			<Item class="LocalScript" referent="RBXA4A6949638C2417E917D714D3FA987B2">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Client entry: builds the interface and connects it to server state.
local RS = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local UI = script.Parent:WaitForChild("UI")
local U = require(UI.Util)
local App = require(UI.App)
require(UI.PanelsA)(App)
require(UI.PanelsB)(App)
require(UI.PanelsC)(App)
require(UI.PanelsD)(App)
local Race = require(UI.Race)(App)
require(UI.Hub)(App)
local Remotes = RS:WaitForChild("Remotes")

local ping = SoundService:WaitForChild("Effects"):FindFirstChild("Ping") :: Sound?
local theme = SoundService:WaitForChild("Music"):FindFirstChild("Theme") :: Sound?
if theme then theme:Play() end
local baseToast = U.Toast
U.Toast = function(text: string, kind: string?)
	baseToast(text, kind)
	if ping then SoundService:PlayLocalSound(ping) end
end

local first = true
local function onSnap(snap: any)
	U.Store.offset = snap.serverTime - os.time()
	U.Store.profile = snap
	App.ApplySettings(snap.settings)
	U.Emit("profile")
	if first then
		first = false
		if snap.tutorial == "new" then
			task.delay(1, function() App.StartTutorial(App.NavButtons.Help) end)
		end
	end
end
Remotes.State.OnClientEvent:Connect(onSnap)
Remotes.Notify.OnClientEvent:Connect(function(n)
	U.Toast(n.text, n.kind)
end)

-- open the vote screen when a queued race moves to voting
local lastPhase = "idle"
U.On(function(kind)
	if kind ~= "race" then return end
	local rs = U.Store.race
	if rs.phase ~= lastPhase then
		local queued = table.find(rs.queued or {}, U.Player.UserId) ~= nil
		if rs.phase == "vote" and queued and not U.Store.driving and App.CurrentPanel() ~= "Race" then
			App.Open("Race")
		end
		if rs.phase == "countdown" and App.CurrentPanel() == "Race" then
			App.RequestClose()
		end
		lastPhase = rs.phase
	end
end)

-- initial pull in case the first push arrived before listeners connected
task.spawn(function()
	local r = U.Request("GetProfile")
	if r.ok and r.profile and not U.Store.profile then onSnap(r.profile) end
end)

while true do
	task.wait(0.5)
	if U.Store.profile then U.Emit("tick") end
end
]]></ProtectedString>
