						<string name="Name">Rewards</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">0b2ac657583187020afced10000025f8</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX8EEA4C7B345C4FE19BEC58435BE203C3">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Livery editor with a live preview, unsaved-change tracking and discard confirmation.
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local UI = require(script.Parent.UI)
local Store = require(script.Parent.Store)
local W = require(script.Parent.Widgets)
local KartView = require(script.Parent.KartView)
local T = UI.T

local P = UI.panel("livery", "Livery Studio", T.violet)
local left, right = W.split(P.body, 0.45)
local view = KartView.new(left, { Size = UDim2.new(1, 0, 1, -56) })
local status = UI.label(left, "", 15, { Font = UI.Bold, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(1, 0, 0, 44), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center })
local root = W.scroll(right, nil, 8)
UI.pad(root, 10, 12)

local draft: any = nil
local function saved(): any
	return Store.profile and Store.profile.livery
end
local function same(a: any, b: any): boolean
	return a.body == b.body and a.bodyShade == b.bodyShade and a.accent == b.accent and a.accentShade == b.accentShade and a.decal == b.decal
end
local function dirty(): boolean
	local s = saved()
	return draft ~= nil and s ~= nil and not same(draft, s)
end
local function copy(t: any): any
	return { body = t.body, bodyShade = t.bodyShade, accent = t.accent, accentShade = t.accentShade, decal = t.decal }
end

local render: () -> ()
local saving = false
local firstSwatch: TextButton? = nil

local function swatchRow(title: string, field: string, order: number)
	UI.label(root, title, 14, { Font = UI.Bold, TextColor3 = T.dim, LayoutOrder = order })
	local row = UI.frame(root, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order + 1 })
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(92, 44), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }, row)
	for i, h in Config.Hues do
		local b = UI.button(row, h.name, { LayoutOrder = i, TextSize = 13, BackgroundColor3 = T.card2 })
		b.TextXAlignment = Enum.TextXAlignment.Right
		UI.pad(b, 0, 10)
		local sw = UI.frame(b, { BackgroundColor3 = h.color, Size = UDim2.fromOffset(20, 20), Position = UDim2.new(0, -2, 0.5, -10) })
		UI.corner(sw, 10)
		b:SetAttribute("Field", field)
		b:SetAttribute("Value", h.name)
		b.Activated:Connect(function()
			draft[field] = h.name
			render()
		end)
		if not firstSwatch then firstSwatch = b end
	end
end

local function optionRow(title: string, field: string, values: { any }, order: number, fmt: (any) -> string)
	UI.label(root, title, 14, { Font = UI.Bold, TextColor3 = T.dim, LayoutOrder = order })
	local row = UI.frame(root, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order + 1 })
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(92, 40), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }, row)
	for i, v in values do
		local b = UI.button(row, fmt(v), { LayoutOrder = i, TextSize = 13 })
		b:SetAttribute("Field", field)
		b:SetAttribute("Value", v)
		b.Activated:Connect(function()
			draft[field] = v
			render()
		end)
	end
end

swatchRow("BODY COLOR", "body", 10)
optionRow("BODY SHADE", "bodyShade", Config.Shades, 20, function(v) return v .. "%" end)
swatchRow("ACCENT COLOR", "accent", 30)
optionRow("ACCENT SHADE", "accentShade", Config.Shades, 40, function(v) return v .. "%" end)
local decals = {}
for _, d in Config.Decals do table.insert(decals, d) end
optionRow("DECAL", "decal", decals, 50, function(v) return v end)
local actions = UI.frame(root, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 60 })
UI.list(actions, true, 8)
local saveBtn = UI.button(actions, "Save Design", { Size = UDim2.fromOffset(150, 46), TextSize = 15 })
local revertBtn = UI.button(actions, "Revert", { Size = UDim2.fromOffset(120, 46), TextSize = 15 })

render = function()
	local p = Store.profile
	if not p or not draft then return end
	view.set(p.kart, draft, nil)
	for _, b in root:GetDescendants() do
		if b:IsA("TextButton") and b:GetAttribute("Field") then
			local f = b:GetAttribute("Field") :: string
			local on = draft[f] == b:GetAttribute("Value")
			UI.style(b, if on then "selected" else "")
			local st = b:FindFirstChildOfClass("UIStroke")
			if st and on then st.Thickness = 2 elseif st then st.Thickness = 1 end
		end
	end
	if saving then
		status.Text = "Saving design…"
		status.TextColor3 = T.amber
	elseif dirty() then
		status.Text = "● Unsaved changes"
		status.TextColor3 = T.amber
	else
		status.Text = "✓ Saved design · " .. draft.body .. " " .. draft.bodyShade .. "% / " .. draft.accent .. " " .. draft.accentShade .. "% · " .. draft.decal
		status.TextColor3 = T.green
	end
	UI.style(saveBtn, if dirty() and not saving then "primary" else "disabled")
	saveBtn:SetAttribute("DisabledReason", "No changes to save.")
	UI.style(revertBtn, if dirty() then "" else "disabled")
	revertBtn:SetAttribute("DisabledReason", "Nothing to revert.")
end

local function discardPrompt(onDiscard: () -> ())
	UI.confirm({ title = "Discard changes?", body = "You have unsaved livery edits. Discard them and restore your saved design?", confirm = "Discard", cancel = "Keep editing", danger = true }, function(yes)
		if yes then
			draft = copy(saved())
			render()
			onDiscard()
		end
	end)
end

saveBtn.Activated:Connect(function()
	if saveBtn:GetAttribute("Disabled") then return end
	saving = true
	render()
	local res = Store.call("livery_save", draft)
	saving = false
	if res.ok then
		UI.toast("Livery saved. It will appear on your kart next race.", "good")
	else
		UI.toast("Save failed: " .. (res.err or "unknown") .. " Your draft is kept.", "bad")
	end
	render()
end)
revertBtn.Activated:Connect(function()
	if not dirty() then return end
	discardPrompt(function() UI.toast("Restored your saved design.") end)
end)

P.canClose = function(proceed)
	if not dirty() then return true end
	discardPrompt(proceed)
	return false
end
P.onOpen = function()
	local s = saved()
	if s and (draft == nil or not dirty()) then draft = copy(s) end
	render()
end
P.firstFocus = function() return firstSwatch end
Store.profileChanged.Event:Connect(function()
	if UI.current == P then
		if draft and not dirty() then draft = copy(saved()) end
		render()
	end
end)

return {}
