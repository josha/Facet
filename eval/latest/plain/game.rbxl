local tutNext=button(tutorial,"NEXT",function() if tutorialStep==3 then tutorialVisible=false;send("tutorial",0);if opener then GS.SelectedObject=opener end else tutorialStep+=1;send("tutorial",tutorialStep) end end,palette.cyan);tutNext.Position=UDim2.new(.3,0,1,-48);tutNext.Size=UDim2.new(.37,-4,0,36);tutNext.ZIndex=16
local tutSkip=button(tutorial,"SKIP",function() tutorialVisible=false;send("tutorial",0);if opener then GS.SelectedObject=opener end end);tutSkip.Position=UDim2.new(.69,0,1,-48);tutSkip.Size=UDim2.new(.31,-12,0,36);tutSkip.ZIndex=16
local pointer=frame(root,UDim2.fromOffset(8,8),nil,palette.cyan);corner(pointer,4);pointer.Visible=false;pointer.ZIndex=17
local function back()
 if confirmation and confirmFn then confirmFn()
 elseif chatOpen then chatOpen=false;GS.SelectedObject=chatButton
 elseif scoreboardOpen then scoreboardOpen=false
 elseif current~="" then closePanel()
 elseif tutorialVisible then if tutorialStep>1 then tutorialStep-=1;send("tutorial",tutorialStep) else tutorialVisible=false;send("tutorial",0);if opener then GS.SelectedObject=opener end end
 end
end
CAS:BindAction("NeonBack",function(_,inputState) if inputState==Enum.UserInputState.Begin then back() end;return Enum.ContextActionResult.Sink end,false,Enum.KeyCode.ButtonB)
CAS:BindAction("NeonBoard",function(_,inputState) if inputState==Enum.UserInputState.Begin then scoreboardOpen=not scoreboardOpen end;return Enum.ContextActionResult.Sink end,false,Enum.KeyCode.Tab,Enum.KeyCode.DPadUp)
CAS:BindAction("NeonChat",function(_,inputState) if inputState==Enum.UserInputState.Begin then chatOpen=not chatOpen;if chatOpen then focusFirst(cwGrid) else GS.SelectedObject=chatButton end end;return Enum.ContextActionResult.Sink end,false,Enum.KeyCode.Q,Enum.KeyCode.ButtonY)
CAS:BindAction("NeonRecover",function(_,inputState) if inputState==Enum.UserInputState.Begin then send("recover") end;return Enum.ContextActionResult.Sink end,false,Enum.KeyCode.R)
UIS.InputChanged:Connect(function(i) if i.KeyCode==Enum.KeyCode.Thumbstick1 then analog=i.Position.X end end)
UIS.InputBegan:Connect(function(i,processed)
 if UIS:GetFocusedTextBox() then return end
 local map={[Enum.KeyCode.W]="gas",[Enum.KeyCode.Up]="gas",[Enum.KeyCode.S]="reverse",[Enum.KeyCode.Down]="reverse",[Enum.KeyCode.A]="left",[Enum.KeyCode.Left]="left",[Enum.KeyCode.D]="right",[Enum.KeyCode.Right]="right",[Enum.KeyCode.Space]="brake",[Enum.KeyCode.LeftShift]="boost",[Enum.KeyCode.ButtonR2]="gas",[Enum.KeyCode.ButtonL2]="reverse",[Enum.KeyCode.ButtonA]="boost",[Enum.KeyCode.ButtonX]="brake"}
 if map[i.KeyCode] then held[map[i.KeyCode]]=true end
end)
UIS.InputEnded:Connect(function(i)
 local map={[Enum.KeyCode.W]="gas",[Enum.KeyCode.Up]="gas",[Enum.KeyCode.S]="reverse",[Enum.KeyCode.Down]="reverse",[Enum.KeyCode.A]="left",[Enum.KeyCode.Left]="left",[Enum.KeyCode.D]="right",[Enum.KeyCode.Right]="right",[Enum.KeyCode.Space]="brake",[Enum.KeyCode.LeftShift]="boost",[Enum.KeyCode.ButtonR2]="gas",[Enum.KeyCode.ButtonL2]="reverse",[Enum.KeyCode.ButtonA]="boost",[Enum.KeyCode.ButtonX]="brake"}
 if map[i.KeyCode] then held[map[i.KeyCode]]=false end
end)
game:GetService("ProximityPromptService").PromptTriggered:Connect(function(prompt,who)
 if who~=p then return end
 local n=prompt.Parent.Name
 if n=="GARAGE" then openPanel("Garage") elseif n=="PARTS + TECH" then openPanel("Shop") elseif n=="RACE TERMINAL" then openPanel("Race") elseif n=="MECHANIC" then openPanel("Mechanic") end
end)
local lastBoard=""
local function updateBoard()
 local sig=""
 local sorted=table.clone(state.racers or {});table.sort(sorted,function(a,b) return a.rank<b.rank end)
 for _,r in ipairs(sorted) do sig..=r.name..r.rank..r.lap..tostring(r.finished) end
 if sig==lastBoard then return end;lastBoard=sig
 for _,v in ipairs(boardList:GetChildren()) do if v:IsA("GuiObject") then v:Destroy() end end
 for _,r in ipairs(sorted) do
  local localR=r.id==p.UserId
  local f=textRow(boardList,string.format("%02d",r.rank).."  "..r.name..(localR and " / YOU" or ""),r.finished and "FINISHED • "..string.format("%.1fs",r.finishTime) or "LAP "..math.min(r.lap,2).." / 2",r.finished and "FIN" or "RACING",nil,localR and palette.cyan or nil)
  f.ZIndex=31;for _,v in ipairs(f:GetDescendants()) do if v:IsA("GuiObject") then v.ZIndex=32 end end
  if localR then stroke(f,palette.cyan) end
 end
 if #sorted==0 then note(boardList,"No active race. Join the next grid.") end
end
local seenInitial=false
local lastMessage=""
E.OnClientEvent:Connect(function(data)
 local previous=state;state=data
 if not seenInitial then seenInitial=true;selected=state.kart;tutorialVisible=state.tutorial~=0;tutorialStep=math.clamp(state.tutorial,1,3) end
 wallet.Text="CR "..money(state.coins).."   /   SH "..money(state.gems)
 level.Text="LV "..state.level.."  •  "..state.xp%250 .."/250 XP  •  "..state.races.." RACES"
 xpFill.Size=UDim2.fromScale(state.xp%250/250,1)
 dailyHint.Text=state.daily.last~=math.floor(state.serverTime/86400) and "REWARD READY • DAY "..state.daily.day or "DAILY CLAIMED ✓"
 loadout.Text=find(C.Karts,state.kart).name.." / "..find(C.Drivers,state.driver).name
 if state.message~="" then notify(state.message) end
 if current=="Livery" and draft and draft.body==state.livery.body and draft.accent==state.livery.accent and draft.shade==state.livery.shade and draft.decal==state.livery.decal then dirty=false end
 if homePreview and (not previous or previous.kart~=state.kart or previous.livery.body~=state.livery.body or previous.livery.accent~=state.livery.accent or previous.livery.shade~=state.livery.shade or previous.livery.decal~=state.livery.decal) then homePreview:Destroy();homePreview=preview(home,state.livery,state.kart);homePreview.BackgroundTransparency=1 end
 local relevant=not previous or state.message~="" or previous.phase~=state.phase
 if previous and (previous.driver~=state.driver or previous.coins~=state.coins or previous.gems~=state.gems) then relevant=true end
 if relevant and current~="" and not UIS:GetFocusedTextBox() then render() end
 if previous and previous.mode~=state.mode then
  if state.mode=="Race" or state.mode=="Test" then current="";panel.Visible=false;tutorialVisible=false;held={gas=false,reverse=false,left=false,right=false,brake=false,boost=false}
  else walk=false end
 end
 if state.phase=="Results" and state.results and resultId~=state.rewardSerial then
  resultId=state.rewardSerial
  for _,v in ipairs(resultList:GetChildren()) do if v:IsA("GuiObject") then v:Destroy() end end
  heading(resultList,"RACE COMPLETE / REWARDS CONFIRMED")
  local title=label(resultList,"P"..state.results.rank.."  /  "..(state.results.rank==1 and "VICTORY" or "NICE RUN"),32,palette.cyan);title.Font=Enum.Font.GothamBlack;title.Size=UDim2.new(1,0,0,48)
  note(resultList,"+"..state.results.coins.." CREDITS  /  +"..state.results.gems.." SHARDS  /  +150 XP",palette.amber)
  local sorted=table.clone(state.racers);table.sort(sorted,function(a,b) return a.rank<b.rank end)
  for _,r in ipairs(sorted) do
   local l=label(resultList,r.rank..". "..r.name.."   "..(r.finishTime>0 and string.format("%.1fs",r.finishTime) or "DNF"),16,r.id==p.UserId and palette.cyan or palette.text);l.Size=UDim2.new(1,0,0,28)
  end
  local b=button(resultList,"RETURN TO PIT →",function() send("exit");resultsBox.Visible=false end,palette.cyan);b.Size=UDim2.new(1,0,0,42)
  for _,v in ipairs(resultList:GetDescendants()) do if v:IsA("GuiObject") then v.ZIndex=27 end end
  focusFirst(resultList)
 end
 updateBoard()
end)
homePreview=preview(home,{body="Cyan",accent="Violet",shade=1,decal="BOLT"},"ion")
homePreview.Size=UDim2.new(.43,0,.56,0);homePreview.Position=UDim2.new(.29,0,.15,0);homePreview.BackgroundTransparency=1
local cam=workspace.CurrentCamera
local networkAcc=0
local renderAcc=0
Run.RenderStepped:Connect(function(dt)
 if not state then return end
 local viewport=root.AbsoluteSize
 local compact=viewport.X<650
 top.Size=UDim2.new(1,-(compact and 16 or 32),0,57);top.Position=UDim2.fromOffset(compact and 8 or 16,10)
 wallet.TextSize=compact and 12 or 15;brand.TextSize=compact and 18 or 23;level.TextSize=compact and 9 or 12
 panel.Size=compact and UDim2.new(.96,0,.66,0) or UDim2.new(.88,0,.76,0);panel.Position=UDim2.fromScale(.5,compact and .43 or .51)
 nav.Size=UDim2.new(1,-32,0,compact and 200 or 84);nav.Position=UDim2.new(0,16,1,compact and -212 or -96)
 navGrid.CellSize=compact and UDim2.new(.33333,-6,0,42) or UDim2.new(.16666,-6,0,31)
 home.Size=UDim2.new(1,-44,1,compact and -290 or -180)
 panelTitle.TextSize=compact and 22 or 26
 title.TextSize=compact and 50 or 86;title.Size=UDim2.new(1,0,0,210);tagline.Position=UDim2.fromOffset(0,compact and 172 or 240);homePreview.Size=compact and UDim2.new(.68,0,.42,0) or UDim2.new(.43,0,.56,0);homePreview.Position=compact and UDim2.new(.27,0,.25,0) or UDim2.new(.29,0,.15,0)
 hero.Size=UDim2.new(compact and .67 or .48,0,.44,0)
 homeRight.Visible=not compact
 bottomHome.Size=UDim2.new(compact and .75 or .52,0,0,116)
 walkBtn.Visible=not compact
 music.Volume=state.settings.music/100*.25;click.Volume=state.settings.effects/100*.3
 local bloom=game:GetService("Lighting"):FindFirstChildOfClass("BloomEffect");if bloom then bloom.Enabled=state.settings.quality>1 end
 local driving=state.mode=="Race" or state.mode=="Test"
 engine.Volume=driving and state.settings.effects/100*.12 or 0
 if driving and current=="" and not confirmation and not chatOpen and not scoreboardOpen and state.phase~="Results" then GS.SelectedObject=nil end
 if controls and controlsDriving~=driving then controlsDriving=driving;if driving then controls:Disable() else controls:Enable() end end
 home.Visible=not driving and current==""
 nav.Visible=not driving
 raceHud.Visible=driving
 context.Enabled=driving and current=="" and not confirmation
 touch.Visible=UIS.TouchEnabled and driving
 raceInfo.Size=UDim2.fromOffset(compact and 180 or 250,82)
 lapText.TextSize=compact and 21 or 26;positionText.TextSize=compact and 10 or 12
 commands.Position=UDim2.new(.5,-160,0,compact and 180 or 88)
 speedBox.Size=UDim2.fromOffset(compact and 128 or 180,compact and 90 or 108)
 speedBox.Position=UDim2.new(1,compact and -140 or -198,1,UIS.TouchEnabled and -300 or -138)
 speedText.TextSize=compact and 36 or 48
 chatButton.Visible=current=="";chatButton.Position=UDim2.new(1,compact and -152 or -188,0,76);chatButton.Size=UDim2.fromOffset(compact and 136 or 170,36);chatButton.TextSize=compact and 11 or 13
 chatWheel.Size=UDim2.new(compact and .94 or .62,0,0,310)
 board.Visible=scoreboardOpen
 chatWheel.Visible=chatOpen
 resultsBox.Visible=state.phase=="Results" and state.mode=="Race" and state.results~=nil
 tutorial.Visible=tutorialVisible and not driving
 pointer.Visible=tutorial.Visible
 if tutorial.Visible then
  tutorial.Size=UDim2.new(compact and .94 or .44,0,0,168);tutorial.Position=compact and UDim2.new(.03,0,1,-390) or UDim2.new(.54,0,1,-276)
  tutTitle.Text="PIT ORIENTATION / "..tutorialStep.." OF 3"
  tutDesc.Text=({"GARAGE → Inspect a kart, try it on the circuit, then return to the same next-race selection.","SHOP → Buy a part with credits. Equip it in Inventory to change your kart's performance.","RACE → Join Solo or Duo, vote for a track, then drive two laps. Finish to earn rewards."})[tutorialStep]
  tutBack.Active=tutorialStep>1;tutBack.AutoButtonColor=tutorialStep>1;tutBack.TextTransparency=tutorialStep==1 and .6 or 0
  tutNext.Text=tutorialStep==3 and "COMPLETE" or "NEXT"
  for _,nb in pairs(navButtons) do local nst=nb:FindFirstChildOfClass("UIStroke");if nst then nst:Destroy() end end
  local target=navButtons[({"Garage","Shop","Race"})[tutorialStep]]
  pointer.Position=UDim2.fromOffset(target.AbsolutePosition.X+target.AbsoluteSize.X/2-4,target.AbsolutePosition.Y-11)
  local st=target:FindFirstChildOfClass("UIStroke");if not st then stroke(target,palette.cyan,2) end
 end
 if state.chat and state.chat.untilTime>workspace:GetServerTimeNow() then chatLine.Visible=true;chatLine.Text=state.chat.name..": "..state.chat.text else chatLine.Visible=false end
 if driving then
  local car=workspace:FindFirstChild("Kart_"..p.UserId)
  local r=nil;for _,v in ipairs(state.racers) do if v.id==p.UserId then r=v end end
  if r then
   lapText.Text=state.mode=="Test" and "TEST DRIVE" or "LAP "..math.min(r.lap,2).." / 2"
   positionText.Text="P"..r.rank.." / "..#state.racers.."  •  "..math.floor(state.raceTime).."s  /  "..C.Tracks[state.track].name
   speedText.Text=string.format("%03d",math.max(0,r.speed));engine.PlaybackSpeed=.6+r.speed/110
   boostFill.Size=UDim2.fromScale(r.energy/100,1)
  end
  if car and car:IsA("Model") and car.PrimaryPart then
   cam.CameraType=Enum.CameraType.Scriptable
   local cf=car:GetPivot()
   local target=cf.Position
   local desired=CFrame.lookAt(target-cf.LookVector*19+Vector3.new(0,12,0),target+cf.LookVector*10+Vector3.new(0,2,0))
   cam.CFrame=cam.CFrame:Lerp(desired,state.settings.motion and 1 or 1-math.exp(-dt*7));if held.boost and r and r.energy>0 and state.settings.shake and not state.settings.motion then cam.CFrame*=CFrame.new(math.sin(os.clock()*35)*.045,math.cos(os.clock()*27)*.035,0) end
   cam.FieldOfView=state.settings.motion and 70 or 70+(r and r.speed or 0)/18
  end
  networkAcc+=dt;if networkAcc>.05 then networkAcc=0
   local gas=(held.gas and 1 or 0)-(held.reverse and 1 or 0)
   local steer=(held.right and 1 or 0)-(held.left and 1 or 0)+analog
   if current~="" or UIS:GetFocusedTextBox() or confirmation then gas=0;steer=0 end
   send("drive",{gas=gas,steer=steer,brake=held.brake,boost=held.boost})
  end
  if state.phase=="Countdown" then centerCount.Text=tostring(math.max(1,math.ceil(state.deadline-workspace:GetServerTimeNow())))
  elseif state.phase=="Race" and state.raceTime<1.5 then centerCount.Text="GO!"
  else centerCount.Text="" end
 elseif not walk then
  cam.CameraType=Enum.CameraType.Scriptable;cam.FieldOfView=64
  local t=os.clock()*.04
  local pos=Vector3.new(48+math.sin(t)*4,32,219)
  cam.CFrame=cam.CFrame:Lerp(CFrame.lookAt(pos,Vector3.new(0,3,156)),1-math.exp(-dt*3))
 end
 if current=="Mechanic" and walk then
  local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
  if root and (root.Position-Vector3.new(45,4,168)).Magnitude>25 then closePanel(true);notify("Conversation ended • return to Rook anytime") end
 end
 renderAcc+=dt
 if renderAcc>1 then
  renderAcc=0
  if current=="Race" and state.phase=="Voting" and not confirmation then render() end
  if (current=="Drivers" or current=="Daily" or current=="Quests" or current=="Shop") and not confirmation and not UIS:GetFocusedTextBox() and not UIS.GamepadEnabled then render() end
  if current=="Codes" and state.codeRetry and state.codeRetry>state.serverTime and not UIS:GetFocusedTextBox() then render() end
 end
end)
task.delay(1,function() send("sync") end)
