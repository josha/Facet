	<Item class="ServerScriptService" referent="RBX3897E660186348408CFFED8A9EF0CAD6">
		<Properties>
			<bool name="LoadStringEnabled">false</bool>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
			<string name="Name">ServerScriptService</string>
			<BinaryString name="SerializedOverrides"></BinaryString>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">1532ed2b765fb7e30aeab0d4000003c1</UniqueId>
		</Properties>
		<Item class="Script" referent="RBXA6468494BDE8468EBE255C9F26BD8C6D">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local D=require(RS.ApexData)
local states={} local races={} local karts={} local controls={}
local function find(list,id) for _,v in list do if v.id==id then return v end end end
local function fresh()
 return {coins=2400,gems=120,xp=0,level=1,races=0,owned={pulse=true,echo=true},equipped={},kart="pulse",driver="echo",favorites={},upgrades={},livery={body="Cyan",accent="Violet",shade=100,decal="Circuit"},rentals={},cards={},freeCrates=1,daily=0,lastDaily=0,codes={},settings={music=60,effects=80,damage=true,shake=true,quality=3,large=false,motion=false},tutorial=false,job="none",quest=false,offerEnd=os.time()+600,offerBought=false,boostUntil=0,party={},chatAt=0,codeAt=0,codeTries=0,phase="Hub",save="Saved for this session"}
end
local function send(p) if states[p] then RS.ApexUpdate:FireClient(p,"state",states[p]) end end
local function spend(s,c,g) if s.coins<c or s.gems<(g or 0) then return false end s.coins-=c s.gems-=(g or 0) return true end
local function makeKart(p,id,pos)
 local spec=find(D.Karts,id) or D.Karts[1]
 local m=Instance.new("Model",workspace) m.Name=p and (p.Name.." • "..spec.name) or id
 local function part(n,size,cf,col,shape)
 local q=Instance.new("Part",m) q.Name=n q.Size=size q.CFrame=cf q.Color=col q.Material=Enum.Material.SmoothPlastic q.Anchored=true q.CanCollide=false if shape then q.Shape=shape end return q end
 local col=Color3.fromRGB(unpack(spec.color))
 if p then local c=D.Colors[states[p].livery.body] col=Color3.fromRGB(unpack(c)):Lerp(Color3.new(),1-states[p].livery.shade/100) end
 local body=part("Chassis",Vector3.new(5,1.2,7),CFrame.new(0,2,0),col) m.PrimaryPart=body
 part("Cockpit",Vector3.new(2.6,1.3,2.8),CFrame.new(0,3,0.6),Color3.fromRGB(12,19,32))
 part("Nose",Vector3.new(3.8,0.65,2),CFrame.new(0,2,-3),col)
 part("Wing",Vector3.new(6,0.4,1),CFrame.new(0,3.1,3),col)
 for _,x in {-2.8,2.8} do for _,z in {-2,2} do
 part("Tire",Vector3.new(2,1.4,2),CFrame.new(x,1.4,z)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(8,10,20),Enum.PartType.Cylinder)
 local q=part("Hub",Vector3.new(0.1,0.9,0.9),CFrame.new(x*1.21,1.4,z)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(25,230,235),Enum.PartType.Cylinder) q.Material=Enum.Material.Neon
 end end
 local glow=part("Tail",Vector3.new(3.5,0.3,0.2),CFrame.new(0,2,3.6),Color3.fromRGB(255,54,154)) glow.Material=Enum.Material.Neon
 m:PivotTo(pos) return m
end
local function hub(p)
 if karts[p] then karts[p]:Destroy() karts[p]=nil end
 local s=states[p] s.phase="Hub"
 local ch=p.Character if ch then ch:PivotTo(CFrame.new(0,5,25)) local h=ch:FindFirstChildOfClass("Humanoid") if h then h.WalkSpeed=20 end for _,q in ch:GetDescendants() do if q:IsA("BasePart") then q.Transparency=q.Name=="HumanoidRootPart" and 1 or 0 end end end
 send(p) RS.ApexUpdate:FireClient(p,"hub")
end
local function startRace(p)
 local s=states[p] if not s or s.phase~="Voting" then return end
 s.phase="Race" local track=s.vote or "Neon Harbor" s.track=track
 local m=makeKart(p,s.kart,CFrame.new(190,3,0)*CFrame.Angles(0,math.pi,0)) karts[p]=m
 local ch=p.Character if ch then local ff=ch:FindFirstChildOfClass("ForceField") if ff then ff.Visible=false end for _,q in ch:GetDescendants() do if q:IsA("BasePart") then q.Transparency=1 end end local h=ch:FindFirstChildOfClass("Humanoid") if h then h.WalkSpeed=0 end end
 local bots={}
 for i,n in {"KIRA / AI","JAX / AI","VEX / AI"} do bots[i]={name=n,progress=-i*0.028,speed=0.31+i*0.007,model=makeKart(nil,D.Karts[i+1].id,CFrame.new(190,3,-i*8))} end
 races[p]={angle=0,progress=0,heading=math.pi,speed=0,start=os.clock()+3,bots=bots,finish=false,last=0,track=track}
 send(p) RS.ApexUpdate:FireClient(p,"race",m)
end
local function finish(p,r)
 if r.finish then return end r.finish=true
 local s=states[p] local position=1 for _,b in r.bots do if b.progress>=math.pi*4 then position+=1 end end
 local reward=math.max(250,850-position*125) if s.boostUntil>os.time() then reward*=2 end
 s.coins+=reward s.gems+=10 s.xp+=180 s.level=1+math.floor(s.xp/400) s.races+=1 s.phase="Results"
 if s.job=="accepted" then s.job="ready" end
 send(p) RS.ApexUpdate:FireClient(p,"results",{position=position,coins=reward,gems=10})
 task.delay(10,function() if states[p] and races[p]==r then for _,b in r.bots do b.model:Destroy() end races[p]=nil hub(p) end end)
end
RS.ApexRequest.OnServerInvoke=function(p,action,arg)
 local s=states[p] if not s then return false,"Loading" end
 arg=arg or {}
 local ok=true local msg="Saved for this session" local extra=nil
 if action=="get" then return true,s end
 if action=="buy" then
 local item=find(D.Parts,arg.id) or find(D.Karts,arg.id)
 if not item then return false,"Unknown item" end
 if s.owned[item.id] then return false,"Already owned" end
 if not spend(s,item.price) then return false,"Insufficient credits" end s.owned[item.id]=true msg="Purchased "..item.name
 elseif action=="equip" then
 local item=find(D.Parts,arg.id) if not item or not s.owned[arg.id] then return false,"Not owned" end if s.equipped[item.slot]==arg.id then s.equipped[item.slot]=nil else s.equipped[item.slot]=arg.id end
 elseif action=="kart" then if not s.owned[arg.id] then return false,"Purchase this kart first" end s.kart=arg.id
 elseif action=="favorite" then if find(D.Karts,arg.id) then s.favorites[arg.id]=not s.favorites[arg.id] end
 elseif action=="driver" then
 local d=find(D.Drivers,arg.id) if not d then return false,"Unknown driver" end
 if arg.mode=="equip" then if not s.owned[d.id] and (s.rentals[d.id] or 0)<=os.time() then return false,"Driver unavailable" end s.driver=d.id
 else
 if s.owned[d.id] then return false,"Permanently owned" end
 local price=arg.mode=="rent" and d.rent or d.price
 if not spend(s,price) then return false,"Insufficient credits" end
 if arg.mode=="rent" then s.rentals[d.id]=os.time()+600 else s.owned[d.id]=true end
 end
 elseif action=="upgrade" then
 if not s.owned[arg.id] or not table.find({"speed","handling","boost"},arg.stat) then return false,"Invalid upgrade" end
 s.upgrades[arg.id]=s.upgrades[arg.id] or {} local u=s.upgrades[arg.id] local level=u[arg.stat] or 0
 if level>=3 then return false,"Maximum level reached" end
 if not spend(s,400*(level+1),10*(level+1)) then return false,"Insufficient credits or gems" end u[arg.stat]=level+1
 elseif action=="livery" then
 if not D.Colors[arg.body] or not D.Colors[arg.accent] or not table.find({50,75,100},arg.shade) or not table.find({"Circuit","Bolt","Stars","Fang","Orbit","Stripes"},arg.decal) then return false,"Invalid design" end
 s.livery={body=arg.body,accent=arg.accent,shade=arg.shade,decal=arg.decal}
 elseif action=="queue" then
 if s.phase~="Hub" then return false,"Already in an activity" end
 s.queueToken=(s.queueToken or 0)+1 local token=s.queueToken s.phase="Queue" s.mode=arg.mode=="Duo" and "Duo" or "Solo" s.queueEnd=os.time()+8
 task.delay(8,function() if states[p] and s.phase=="Queue" and s.queueToken==token then s.phase="Voting" s.vote=nil s.voteEnd=os.time()+8 send(p) task.delay(8,function() if s.queueToken==token then startRace(p) end end) end end)
 elseif action=="leaveQueue" then if s.phase=="Queue" or s.phase=="Voting" then s.queueToken=(s.queueToken or 0)+1 s.phase="Hub" end
 elseif action=="vote" then if s.phase~="Voting" or os.time()>=s.voteEnd then return false,"Voting closed" end if table.find({"Neon Harbor","Violet Run"},arg.track) then s.vote=arg.track end
 elseif action=="return" then
 if races[p] then for _,b in races[p].bots do b.model:Destroy() end races[p]=nil end hub(p)
 elseif action=="try" then
 if s.phase~="Hub" then return false,"Return to the hub first" end if not find(D.Karts,arg.id) then return false,"Invalid kart" end
 local ch=p.Character if ch then local ff=ch:FindFirstChildOfClass("ForceField") if ff then ff.Visible=false end for _,q in ch:GetDescendants() do if q:IsA("BasePart") then q.Transparency=1 end end local ff=ch:FindFirstChildOfClass("ForceField") if ff then ff.Visible=false end end s.phase="Test Drive" karts[p]=makeKart(p,arg.id,CFrame.new(190,3,0)*CFrame.Angles(0,math.pi,0))
 races[p]={angle=0,progress=0,heading=math.pi,speed=0,start=os.clock(),bots={},test=true}
 RS.ApexUpdate:FireClient(p,"race",karts[p])
 elseif action=="recover" then local r=races[p] if r and karts[p] then local a=r.progress%(math.pi*2) r.heading=-a+math.pi r.speed=0 karts[p]:PivotTo(CFrame.new(math.cos(a)*190,3,math.sin(a)*145)*CFrame.Angles(0,r.heading,0)) end
 elseif action=="daily" then
 local day=math.floor(os.time()/86400) if s.lastDaily==day then return false,"Already claimed • next reward tomorrow" end
 if s.lastDaily>0 and day-s.lastDaily>1 then s.daily=0 msg="Missed day: track restarted" end
 s.daily=s.daily%7+1 s.lastDaily=day s.coins+=s.daily*100 if s.daily==7 then s.gems+=100 s.owned.halo=true end msg="Day "..s.daily.." claimed"
 elseif action=="code" then
 if os.time()<s.codeAt then return false,"Rate limited • retry in "..(s.codeAt-os.time()).."s" end
 local code=string.upper(tostring(arg.code or "")):match("^%s*(.-)%s*$")
 if code=="" then return false,"Enter a code" end
 if s.codes[code] then return false,"Already used" end
 s.codeTries+=1 if s.codeTries%4==0 then s.codeAt=os.time()+15 end
 if code=="OLDAPEX" then return false,"Code expired" elseif code~="NEON2026" then return false,"Invalid code" end
 s.codes[code]=true s.coins+=500 s.gems+=25 msg="Redeemed • +500 credits +25 gems"
 elseif action=="crate" then
 if s.freeCrates>0 then s.freeCrates-=1 elseif not spend(s,300) then return false,"Insufficient credits" end
 extra={} for i=1,3 do local roll=math.random(100) local card=roll<=60 and "Pulse" or roll<=90 and "Comet" or "Nova" s.cards[card]=(s.cards[card] or 0)+1 table.insert(extra,card) end msg="Crate opened • 3 cards"
 elseif action=="quest" then if s.races<1 then return false,"Finish a race first" end if s.quest then return false,"Already claimed" end s.quest=true s.coins+=400 msg="Quest claimed • +400"
 elseif action=="job" then
 if arg.mode=="accept" and s.job=="none" then s.job="accepted" msg="Axel: Finish one race. I'll pay 350 credits."
 elseif arg.mode=="claim" and s.job=="ready" then s.job="done" s.coins+=350 msg="Axel: Nice work! +350 credits."
 else msg="Axel: Take a kart around the circuit. Come back after finishing!" end
 elseif action=="offer" then if os.time()>=s.offerEnd or s.offerBought then return false,"Offer unavailable" end if not spend(s,800) then return false,"Insufficient credits" end s.offerBought=true s.freeCrates+=3
 elseif action=="boost" then if not spend(s,200) then return false,"Insufficient credits" end s.boostUntil=os.time()+600
 elseif action=="settings" then
 for k,v in arg do if s.settings[k]~=nil then if type(v)==type(s.settings[k]) then if type(v)=="number" then v=math.clamp(v,0,k=="quality" and 3 or 100) end s.settings[k]=v end end end
 elseif action=="help" then s.tutorial=true
 elseif action=="party" then
 if arg.name=="MILO • offline" then return false,"Friend is offline" end
 if s.party[arg.name] then return false,"Invitation already sent" end
 if not table.find({"KIRA • demo","JAX • demo"},arg.name) then return false,"Unavailable" end
 s.party[arg.name]="Pending"
 task.delay(2,function() if states[p] then s.party[arg.name]=arg.name=="KIRA • demo" and "Accepted" or "Declined" send(p) end end)
 elseif action=="chat" then
 if os.clock()-s.chatAt<5 then return false,"Chat cooldown • "..math.ceil(5-(os.clock()-s.chatAt)).."s" end
 local presets={"Let's race!","Good luck!","Nice drift!","Follow me","Great race!","Thanks!","Oops!","One more?"}
 if not table.find(presets,arg.message) then return false,"Invalid message" end s.chatAt=os.clock() RS.ApexUpdate:FireAllClients("chat",p.DisplayName..": "..arg.message)
 else return false,"Unknown request" end
 send(p) return ok,msg,extra
end
RS.ApexDrive.OnServerEvent:Connect(function(p,t,steer,boost)
 if type(t)=="number" and type(steer)=="number" then controls[p]={math.clamp(t,-1,1),math.clamp(steer,-1,1),boost==true} end
end)
Run.Heartbeat:Connect(function(dt)
 dt=math.min(dt,0.05)
 for p,r in races do
 local m=karts[p] local s=states[p]
 if not m or not s or r.finish then continue end
 local left=math.max(0,r.start-os.clock())
 if left==0 then
 local c=controls[p] or {0,0,false}
 local spec=find(D.Karts,s.kart) local u=s.upgrades[s.kart] or {}
 local max=spec.speed+(u.speed or 0)*6+(s.equipped.Motor and 12 or 0)+(s.driver=="rex" and 8 or 0)
 local boosted=c[3] and (r.energy or 100)>0
 r.energy=math.clamp((r.energy or 100)+(boosted and -28 or 12)*dt,0,100)
 r.speed=math.clamp(r.speed+c[1]*65*dt-r.speed*0.38*dt,-25,max+(boosted and 40 or 0))
 local handling=spec.handling+(u.handling or 0)*8+(s.equipped.Wheels and 18 or 0)
 r.heading-=c[2]*dt*(1.4+handling/150)*math.clamp(math.abs(r.speed)/30,0,1)
 local pos=m:GetPivot().Position local roadAngle=math.atan2(pos.Z/145,pos.X/190) if math.abs(c[2])<0.05 then local target=-roadAngle+math.pi local delta=(target-r.heading+math.pi)%(math.pi*2)-math.pi r.heading+=delta*math.min(1,dt*2.5) end
 pos+=CFrame.Angles(0,r.heading,0).LookVector*r.speed*dt pos=Vector3.new(pos.X,3,pos.Z)
 local norm=math.sqrt((pos.X/190)^2+(pos.Z/145)^2)
 if norm<0.89 or norm>1.11 then local a=math.atan2(pos.Z/145,pos.X/190) pos=pos:Lerp(Vector3.new(math.cos(a)*190,3,math.sin(a)*145),math.min(1,dt*3)) r.speed*=0.995 end
 if norm<0.77 or norm>1.24 then
 local a=math.atan2(pos.Z/145,pos.X/190) pos=Vector3.new(math.cos(a)*190,3,math.sin(a)*145) r.heading=-a+math.pi r.speed=15
 end
 m:PivotTo(CFrame.new(pos)*CFrame.Angles(0,r.heading,0))
 if p.Character then p.Character:PivotTo(CFrame.new(pos+Vector3.new(0,0.5,0))) end
 local angle=math.atan2(pos.Z/145,pos.X/190) local diff=(angle-r.angle+math.pi)%(math.pi*2)-math.pi
 if math.abs(diff)<0.3 then r.progress+=diff end r.angle=angle
 for _,b in r.bots do b.progress=math.min(math.pi*4,b.progress+b.speed*dt) local a=b.progress b.model:PivotTo(CFrame.new(math.cos(a)*190,3,math.sin(a)*145)*CFrame.Angles(0,-a+math.pi,0)) end
 if not r.test and r.progress>=math.pi*4 then finish(p,r) end
 end
 r.last=(r.last or 0)+dt if r.last>0.16 then
 r.last=0 local board={{name=p.DisplayName,progress=r.progress,lap=math.min(2,1+math.floor(math.max(0,r.progress)/(math.pi*2))),finished=r.finish or false,you=true}}
 for _,b in r.bots do table.insert(board,{name=b.name,progress=b.progress,lap=math.min(2,1+math.floor(math.max(0,b.progress)/(math.pi*2))),finished=b.progress>=math.pi*4}) end
 table.sort(board,function(a,b) return a.progress>b.progress end)
 RS.ApexUpdate:FireClient(p,"telemetry",{speed=math.floor(math.abs(r.speed)),energy=math.floor(r.energy or 100),lap=math.min(2,1+math.floor(math.max(0,r.progress)/(math.pi*2))),countdown=math.ceil(left),board=board,progress=math.clamp(r.progress/(math.pi*4),0,1)})
 end
 end
 for p,s in states do if not s.owned[s.driver] and (s.rentals[s.driver] or 0)<=os.time() then s.driver="echo" send(p) end end
end)
Players.PlayerAdded:Connect(function(p) states[p]=fresh() p.CharacterAdded:Connect(function() task.wait(0.3) send(p) end) end)
Players.PlayerRemoving:Connect(function(p) states[p]=nil if karts[p] then karts[p]:Destroy() end races[p]=nil end)
workspace.NEON_WORLD["AXEL • Mechanic"].Mechanic.ProximityPrompt.Triggered:Connect(function(p) RS.ApexUpdate:FireClient(p,"mechanic") end)
]]></ProtectedString>
