						<ProtectedString name="Source"><![CDATA[--!strict
-- Shared UI helpers, store and request wrapper.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Config = require(RS:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = RS:WaitForChild("Remotes")

local U = {}
U.Config = Config
U.T = Config.Theme
U.Player = Players.LocalPlayer

-- ---------- store ----------
U.Store = { profile = nil :: any, race = nil :: any, offset = 0, listeners = {} :: { [number]: (string) -> () }, chatReadyAt = 0 }
local nextId = 0
function U.On(fn: (string) -> ()): () -> ()
	nextId += 1
	local id = nextId
	U.Store.listeners[id] = fn
	return function() U.Store.listeners[id] = nil end
end
function U.Emit(kind: string)
	for _, fn in pairs(U.Store.listeners) do
		task.spawn(fn, kind)
	end
end
function U.Now(): number
	return os.time() + U.Store.offset
end
function U.ServerNow(): number
	return workspace:GetServerTimeNow()
end

function U.Request(action: string, args: any?): any
	local ok, res = pcall(function()
		return Remotes.Request:InvokeServer(action, args or {})
	end)
	if not ok then return { ok = false, err = "Connection problem" } end
	return res or { ok = false, err = "No response" }
end

-- ---------- text scale ----------
U.TextScale = 1
local texts = setmetatable({}, { __mode = "k" }) :: any
function U.ApplyTextScale(scale: number)
	U.TextScale = scale
	for obj, base in pairs(texts) do
		if obj.Parent then obj.TextSize = math.floor(base * scale) end
	end
end

function U.new(class: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then (inst :: any)[k] = v end
		end
	end
	if children then for _, c in ipairs(children) do c.Parent = inst end end
	if (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) then
		texts[inst] = (inst :: any).TextSize
		;(inst :: any).TextSize = math.floor((inst :: any).TextSize * U.TextScale)
	end
	if props and props.Parent then inst.Parent = props.Parent end
	return inst
end

function U.corner(inst: Instance, r: number?): UICorner
	return U.new("UICorner", { CornerRadius = UDim.new(0, r or 10), Parent = inst })
end
function U.stroke(inst: Instance, color: Color3?, thick: number?, transp: number?): UIStroke
	return U.new("UIStroke", { Color = color or U.T.Line, Thickness = thick or 1, Transparency = transp or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = inst })
end
function U.pad(inst: Instance, p: number, p2: number?): UIPadding
	return U.new("UIPadding", { PaddingLeft = UDim.new(0, p), PaddingRight = UDim.new(0, p), PaddingTop = UDim.new(0, p2 or p), PaddingBottom = UDim.new(0, p2 or p), Parent = inst })
end
function U.list(inst: Instance, dir: Enum.FillDirection?, gap: number?, halign: Enum.HorizontalAlignment?, valign: Enum.VerticalAlignment?): UIListLayout
	return U.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical, Padding = UDim.new(0, gap or 8),
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left, VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder, Parent = inst,
	})
end

function U.label(parent: Instance?, text: string, size: number?, color: Color3?, props: { [string]: any }?): TextLabel
	local p = {
		BackgroundTransparency = 1, Text = text, TextSize = size or 16, TextColor3 = color or U.T.Text,
		Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = parent,
	}
	if props then for k, v in pairs(props) do p[k] = v end end
	return U.new("TextLabel", p)
end

local selectionImage = Instance.new("Frame")
selectionImage.BackgroundTransparency = 1
selectionImage.Size = UDim2.new(1, 8, 1, 8)
selectionImage.Position = UDim2.fromOffset(-4, -4)
do
	local s = Instance.new("UIStroke"); s.Color = Color3.fromRGB(255, 255, 255); s.Thickness = 3; s.Parent = selectionImage
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 12); c.Parent = selectionImage
end
U.SelectionImage = selectionImage

function U.btn(parent: Instance?, text: string, opts: any?): TextButton
	local o = opts or {}
	local color = o.color or U.T.Panel2
	local b = U.new("TextButton", {
		Name = o.name or text, Text = text, TextSize = o.textSize or 16, Font = Enum.Font.GothamBold,
		TextColor3 = o.textColor or (o.primary and Color3.fromRGB(12, 10, 28) or U.T.Text),
		BackgroundColor3 = o.primary and (o.color or U.T.Cyan) or color, AutoButtonColor = true,
		Size = o.size or UDim2.new(0, 120, 0, 44), LayoutOrder = o.order or 0, Selectable = true,
		SelectionImageObject = selectionImage, TextWrapped = true, Parent = parent,
	})
	U.corner(b, o.radius or 10)
	if not o.primary then U.stroke(b, o.stroke or U.T.Line, 1) end
	if o.minHeight then
		U.new("UISizeConstraint", { MinSize = Vector2.new(0, o.minHeight), Parent = b })
	end
	return b
end

function U.setEnabled(b: TextButton, enabled: boolean)
	b.Active = enabled
	b.AutoButtonColor = enabled
	b.TextTransparency = enabled and 0 or 0.45
	b.BackgroundTransparency = enabled and 0 or 0.35
	b:SetAttribute("Disabled", not enabled)
end

function U.scroll(parent: Instance?, props: any?): ScrollingFrame
	local p = {
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, ScrollBarImageColor3 = U.T.Violet,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 1),
		ScrollingDirection = Enum.ScrollingDirection.Y, Selectable = false, Parent = parent,
	}
	if props then for k, v in pairs(props) do p[k] = v end end
	return U.new("ScrollingFrame", p)
end

function U.card(parent: Instance?, props: any?): Frame
	local p = { BackgroundColor3 = U.T.Panel2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = parent }
	if props then for k, v in pairs(props) do p[k] = v end end
	local f = U.new("Frame", p)
	U.corner(f, 12)
	U.stroke(f, U.T.Line, 1, 0.2)
	return f
end

function U.chip(parent: Instance?, text: string, color: Color3, order: number?): TextLabel
	local l = U.new("TextLabel", {
		Text = " " .. text .. " ", TextSize = 13, Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(10, 8, 24),
		BackgroundColor3 = color, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 20), LayoutOrder = order or 0, Parent = parent,
	})
	U.corner(l, 6)
	U.pad(l, 4, 2)
	return l
end

function U.portrait(parent: Instance?, userId: number?, name: string, size: number): Frame
	local f = U.new("Frame", { Size = UDim2.fromOffset(size, size), BackgroundColor3 = U.T.Panel, Parent = parent, Name = "Portrait" })
	U.corner(f, size // 2)
	if userId and userId > 0 then
		U.new("ImageLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
			Image = "rbxthumb://type=AvatarHeadShot&id=" .. userId .. "&w=150&h=150", Parent = f,
		}, { U.new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		U.stroke(f, U.T.Cyan, 2)
	else
		-- placeholder portrait for local AI racers without an account
		f.BackgroundColor3 = Color3.fromRGB(60, 30, 110)
		U.stroke(f, U.T.Pink, 2)
		local initials = string.upper(string.sub(name, 1, 1)) .. "·"
		U.new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 0.62), Position = UDim2.fromScale(0, 0.08), Text = "◈", TextScaled = true, Font = Enum.Font.GothamBlack, TextColor3 = U.T.Pink, Parent = f })
		U.new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 0.32), Position = UDim2.fromScale(0, 0.62), Text = "AI " .. initials, TextScaled = true, Font = Enum.Font.GothamBold, TextColor3 = U.T.Text, Parent = f })
	end
	return f
end

function U.statBar(parent: Instance?, name: string, value: number, maxV: number, color: Color3, order: number?, bonus: number?): Frame
	local row = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = order or 0, Parent = parent })
	U.label(row, name, 13, U.T.Sub, { Size = UDim2.new(0, 80, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
	local bg = U.new("Frame", { BackgroundColor3 = U.T.Bg, Size = UDim2.new(1, -130, 0, 8), Position = UDim2.new(0, 84, 0.5, -4), Parent = row })
	U.corner(bg, 4)
	local fill = U.new("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale(math.clamp(value / maxV, 0, 1), 1), Parent = bg })
	U.corner(fill, 4)
	local txt = tostring(math.floor(value))
	if bonus and bonus ~= 0 then txt ..= string.format(" (%+d)", bonus) end
	U.label(row, txt, 13, U.T.Text, { Size = UDim2.new(0, 44, 1, 0), Position = UDim2.new(1, -44, 0, 0), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false, Font = Enum.Font.GothamBold })
	return row
end

function U.clear(inst: Instance)
	for _, c in ipairs(inst:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
end

function U.fmtTime(sec: number): string
	sec = math.max(0, math.floor(sec))
	local h = sec // 3600
	local m = (sec % 3600) // 60
	local s = sec % 60
	if h > 0 then return string.format("%dh %02dm %02ds", h, m, s) end
	return string.format("%d:%02d", m, s)
end

function U.ordinal(n: number): string
	local suf = "th"
	if n % 100 < 11 or n % 100 > 13 then
		if n % 10 == 1 then suf = "st" elseif n % 10 == 2 then suf = "nd" elseif n % 10 == 3 then suf = "rd" end
	end
	return tostring(n) .. suf
end

function U.IsGamepad(): boolean
	local t = UIS:GetLastInputType()
	return t == Enum.UserInputType.Gamepad1 or t == Enum.UserInputType.Gamepad2
end

function U.Focus(obj: GuiObject?)
	if obj and U.IsGamepad() then GuiService.SelectedObject = obj end
end

U.ReducedMotion = false
function U.Tween(obj: Instance, info: TweenInfo, goal: { [string]: any })
	if U.ReducedMotion then
		for k, v in pairs(goal) do (obj :: any)[k] = v end
		return
	end
	TweenService:Create(obj, info, goal):Play()
end

-- filled in by the app
U.Toast = function(_text: string, _kind: string?) end
U.Confirm = function(_opts: any, _onYes: () -> (), _onNo: (() -> ())?) end
U.OpenPanel = function(_name: string, _opener: GuiObject?) end
U.ClosePanel = function() end
U.Layout = { compact = false, portrait = false, w = 1280, h = 720 }

return U
]]></ProtectedString>
