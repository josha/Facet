					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Client app core: server state mirror, requests, panel navigation, Back handling, dialogs and toasts.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")
local UI = require(script.Parent.UI)
local Config = require(RS.Shared.Config)
local Remotes = RS:WaitForChild("Remotes")

local App: any = {}
App.player = Players.LocalPlayer
App.profile = nil :: any
App.lobby = nil :: any
App.race = nil :: any
App.Config = Config
App.UI = UI

local function signal()
	local s = { list = {} :: { any } }
	function s:Connect(f)
		table.insert(self.list, f)
		return { Disconnect = function() local i = table.find(s.list, f) if i then table.remove(s.list, i) end end }
	end
	function s:Fire(...)
		for _, f in table.clone(self.list) do task.spawn(f, ...) end
	end
	return s
end
App.signal = signal
App.profileChanged = signal()
App.lobbyChanged = signal()
App.raceChanged = signal()
App.layoutChanged = signal()
App.saveChanged = signal()
App.panelChanged = signal()
App.notify = signal()

function App.now(): number
	return workspace:GetServerTimeNow()
end

-- Screen roots --------------------------------------------------------
local pg = App.player:WaitForChild("PlayerGui")
local function screen(name: string, order: number): ScreenGui
	local old = pg:FindFirstChild(name)
	if old then old:Destroy() end
	return UI.new("ScreenGui", { Name = name, DisplayOrder = order, ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets, Parent = pg })
end
App.hubGui = screen("NDL_Hub", 2)
App.raceGui = screen("NDL_Race", 3)
App.panelGui = screen("NDL_Panels", 6)
App.tutorialGui = screen("NDL_Tutorial", 8)
App.modalGui = screen("NDL_Modal", 10)
App.toastGui = screen("NDL_Toast", 12)

-- Layout -------------------------------------------------------------
App.layout = { w = 1280, h = 720, compact = false, portrait = false, narrow = false, touch = UserInputService.TouchEnabled }
local function measure()
	local cam = workspace.CurrentCamera
	local v = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	local L = App.layout
	L.w, L.h = v.X, v.Y
	L.portrait = v.Y > v.X
	L.narrow = v.X < 760
	L.compact = v.X < 760 or v.Y < 520
	L.short = v.Y < 520
	L.touch = UserInputService.TouchEnabled
	App.layoutChanged:Fire(L)
end
App.measure = measure
local camConn: RBXScriptConnection? = nil
local function watchCamera()
	if camConn then camConn:Disconnect() end
	local cam = workspace.CurrentCamera
	if cam then camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(measure) end
	measure()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

-- Sound ---------------------------------------------------------------
local sfxGroup = SoundService:FindFirstChild("NDL_SFX") or UI.new("SoundGroup", { Name = "NDL_SFX", Parent = SoundService })
local musicGroup = SoundService:FindFirstChild("NDL_Music") or UI.new("SoundGroup", { Name = "NDL_Music", Parent = SoundService })
App.sfxGroup = sfxGroup
App.musicGroup = musicGroup
local clickSound = UI.new("Sound", { SoundId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.35, SoundGroup = sfxGroup, Parent = SoundService })
function App.click()
	clickSound:Play()
end

-- Requests -------------------------------------------------------------
App.save = { state = "idle", text = "" }
local pending = 0
local function setSave(state: string, text: string)
	App.save = { state = state, text = text }
	App.saveChanged:Fire(App.save)
end
local function savedText(): string
	local p = App.profile
	if not p then return "Saved" end
	if p.save.state == "failed" then return "Cloud save failed" end
	if p.save.cloud then return "Saved" end
	return "Saved · this session only"
end

local function applyProfile(p: any)
	if not p then return end
	App.profile = p
	App.profileChanged:Fire(p)
end

local MUTATING = { getFriends = false, quickChat = false, queueJoin = false, queueLeave = false, vote = false, recover = false, leaveTrack = false, testDrive = false }
function App.request(action: string, payload: any?, opts: any?): any
	local mutating = MUTATING[action] ~= false
	if mutating then
		pending += 1
		setSave("pending", "Saving…")
	end
	local ok, r = pcall(function()
		return Remotes.Request:InvokeServer(action, payload or {})
	end)
	if mutating then pending -= 1 end
	if not ok or type(r) ~= "table" then
		if mutating then setSave("failed", "Not saved: connection problem") end
		local res = { ok = false, err = "Connection problem. Nothing was changed." }
		if not (opts and opts.quiet) then App.toast(res.err, "bad") end
		return res
	end
	applyProfile(r.profile)
	if mutating and pending == 0 then
		if r.ok then setSave("ok", savedText()) else setSave("failed", "Not saved: " .. tostring(r.err)) end
	end
	if not r.ok and not (opts and opts.quiet) then App.toast(r.err or "Request rejected.", "bad") end
	if r.ok and r.data and r.data.text and not (opts and opts.silent) then App.toast(r.data.text, "good") end
	return r
end

Remotes.Profile.OnClientEvent:Connect(function(p)
	applyProfile(p)
	if App.save.state == "idle" then setSave("ok", savedText()) end
end)
Remotes.Lobby.OnClientEvent:Connect(function(l)
	App.lobby = l
	App.lobbyChanged:Fire(l)
end)
Remotes.Race.OnClientEvent:Connect(function(s)
	App.race = s
	App.raceChanged:Fire(s)
end)
Remotes.Notify.OnClientEvent:Connect(function(n)
	if n.kind == "toast" then App.toast(n.text, n.tone) end
	App.notify:Fire(n)
end)

-- Back stack (Close buttons and gamepad B) ----------------------------------
App.layers = {} :: { any }
local function syncBack()
	if #App.layers > 0 then
		ContextActionService:BindActionAtPriority("NDL_Back", function(_, state)
			if state == Enum.UserInputState.Begin then
				local top = App.layers[#App.layers]
				if top then top.back() end
			end
			return Enum.ContextActionResult.Sink
		end, false, 3000, Enum.KeyCode.ButtonB)
	else
		ContextActionService:UnbindAction("NDL_Back")
	end
end
function App.pushLayer(id: string, back: () -> ())
	App.popLayer(id)
	table.insert(App.layers, { id = id, back = back })
	syncBack()
end
function App.popLayer(id: string)
	for i = #App.layers, 1, -1 do
		if App.layers[i].id == id then table.remove(App.layers, i) end
	end
	syncBack()
end

-- Toasts ---------------------------------------------------------------
local toastHolder = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 460, 1, 0), Position = UDim2.new(0.5, 0, 0, 64), AnchorPoint = Vector2.new(0.5, 0), Parent = App.toastGui })
UI.new("UISizeConstraint", { MaxSize = Vector2.new(460, 2000), Parent = toastHolder })
toastHolder.Size = UDim2.new(0.9, 0, 1, -80)
UI.list(toastHolder, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
function App.toast(text: string, tone: string?)
	local color = if tone == "bad" then UI.T.red elseif tone == "warn" then UI.T.amber elseif tone == "good" then UI.T.green else UI.T.cyan
	local f = UI.new("Frame", { BackgroundColor3 = UI.T.panel, BackgroundTransparency = 0.05, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = toastHolder })
	UI.corner(f, 10)
	UI.stroke(f, color, 2, 0)
	UI.pad(f, 10, 14)
	UI.label(f, text, 15, { TextColor3 = UI.T.text, TextXAlignment = Enum.TextXAlignment.Center })
	task.delay(3.2, function() f:Destroy() end)
	while #toastHolder:GetChildren() > 6 do
		for _, c in toastHolder:GetChildren() do
			if c:IsA("Frame") then c:Destroy() break end
		end
	end
end

-- Confirm dialog ---------------------------------------------------------
-- opts: title, body, confirm, cancel, color, onConfirm, onCancel, refresh() -> (body, canConfirm), extra (secondary button {text, fn})
function App.confirm(opts: any)
	local prevSel = GuiService.SelectedObject
	local shade = UI.new("TextButton", { Name = "ConfirmShade", Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.new(1, 0, 1, 200), Position = UDim2.fromOffset(0, -100), Selectable = false, Parent = App.modalGui })
	local box = UI.new("Frame", { Name = "Confirm", BackgroundColor3 = UI.T.panel, Size = UDim2.new(0.9, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Parent = shade })
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(460, 600), Parent = box })
	UI.corner(box, 14)
	UI.stroke(box, opts.color or UI.T.magenta, 2, 0)
	UI.pad(box, 18, 20)
	UI.list(box, Enum.FillDirection.Vertical, 12)
	UI.label(box, opts.title or "Are you sure?", 20, { FontFace = UI.F.title, TextColor3 = opts.color or UI.T.magenta, LayoutOrder = 1 })
	local body = UI.label(box, opts.body or "", 16, { LayoutOrder = 2, TextColor3 = UI.T.text })
	local row = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 3, Parent = box })
	local lay = UI.list(row, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right)
	local closed = false
	local profConn: any = nil
	local function close()
		if closed then return end
		closed = true
		if profConn then profConn:Disconnect() end
		App.popLayer("confirm")
		shade:Destroy()
		if prevSel and prevSel.Parent then UI.focus(prevSel :: GuiObject) end
	end
	local cancelBtn = UI.button(row, opts.cancel or "Cancel", { filled = false, color = UI.T.muted, textColor = UI.T.text, size = UDim2.fromOffset(130, 46), layoutOrder = 1, name = "Cancel" }, function()
		close()
		if opts.onCancel then opts.onCancel() end
	end)
	local confirmBtn = UI.button(row, opts.confirm or "Confirm", { color = opts.color or UI.T.magenta, size = UDim2.fromOffset(170, 46), layoutOrder = 2, name = "Confirm" }, nil)
	confirmBtn.Activated:Connect(function()
		if confirmBtn:GetAttribute("Disabled") then return end
		close()
		if opts.onConfirm then opts.onConfirm() end
	end)
	local function refresh()
		if opts.refresh then
			local text, can = opts.refresh()
			body.Text = text
			UI.setEnabled(confirmBtn, can ~= false)
		end
	end
	refresh()
	profConn = App.profileChanged:Connect(function() if not closed then refresh() end end)
	App.pushLayer("confirm", function()
		close()
		if opts.onCancel then opts.onCancel() end
	end)
	shade.Activated:Connect(function() end)
	task.defer(function() UI.focus(cancelBtn) end)
	return { close = close, body = body }
end

-- Panels -----------------------------------------------------------------
App.panels = {} :: { [string]: any }
App.current = nil :: string?
App.history = {} :: { string }
function App.register(name: string, def: any)
	App.panels[name] = def
end

local function ensureBuilt(name: string): any
	local def = App.panels[name]
	if def.frame then return def end
	local frame = UI.new("Frame", { Name = "Panel_" .. name, BackgroundColor3 = UI.T.panel, BackgroundTransparency = 0.04, Visible = false, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -24, 1, -24), Parent = App.panelGui })
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(def.maxW or 1000, def.maxH or 660), Parent = frame })
	UI.corner(frame, 16)
	UI.stroke(frame, def.color or UI.T.cyan, 2, 0.1)
	UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(26, 22, 60), Color3.fromRGB(10, 12, 28)), Rotation = 90, Parent = frame })
	local header = UI.new("Frame", { Name = "Header", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), Parent = frame })
	UI.pad(header, 8, 16)
	local title = UI.label(header, def.title, 22, { Name = "Title", FontFace = UI.F.title, TextColor3 = def.color or UI.T.cyan, Size = UDim2.new(1, -150, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd })
	local closeBtn = UI.button(header, "Close ✕", { filled = false, color = UI.T.muted, textColor = UI.T.text, size = UDim2.fromOffset(110, 40), name = "Close", textSize = 15 }, function()
		App.back()
	end)
	closeBtn.AnchorPoint = Vector2.new(1, 0.5)
	closeBtn.Position = UDim2.new(1, 0, 0.5, 0)
	UI.new("Frame", { BackgroundColor3 = def.color or UI.T.cyan, BackgroundTransparency = 0.5, BorderSizePixel = 0, Size = UDim2.new(1, -32, 0, 1), Position = UDim2.new(0, 16, 0, 56), Parent = frame })
	local body = UI.new("Frame", { Name = "Body", BackgroundTransparency = 1, Size = UDim2.new(1, -24, 1, -70), Position = UDim2.fromOffset(12, 64), Parent = frame })
	def.frame = frame
	def.body = body
	def.title = title
	def.closeBtn = closeBtn
	def.build(def, body)
	return def
end

local function hide(name: string)
	local def = App.panels[name]
	if def and def.frame then
		def.frame.Visible = false
		if def.onClose then def.onClose(def) end
	end
end

-- Open a panel. stack=true keeps the current panel to return to on Back.
function App.open(name: string, arg: any?, stack: boolean?)
	local def = ensureBuilt(name)
	if App.current == name then
		if def.onOpen then def.onOpen(def, arg) end
		return
	end
	local function doOpen()
		if App.current then
			if stack then table.insert(App.history, App.current) else table.clear(App.history) end
			hide(App.current)
		end
		App.current = name
		App.lastOpener = App.lastOpener
		def.frame.Visible = true
		def.frame.Position = UDim2.fromScale(0.5, 0.53)
		UI.tween(def.frame, 0.25, { Position = UDim2.fromScale(0.5, 0.5) })
		App.pushLayer("panel", function() App.back() end)
		if def.onOpen then def.onOpen(def, arg) end
		App.panelChanged:Fire(name)
		task.defer(function()
			UI.focus(def.firstFocus or def.closeBtn)
		end)
	end
	local cur = App.current and App.panels[App.current]
	if cur and cur.guard and not stack then
		cur.guard(cur, doOpen)
	else
		doOpen()
	end
end

-- Close the current panel (asks the panel's guard first), returning to a stacked panel if any.
function App.back()
	local name = App.current
	if not name then return end
	local def = App.panels[name]
	local function doClose()
		hide(name)
		App.current = nil
		local prev = table.remove(App.history)
		if prev then
			App.current = prev
			local pdef = App.panels[prev]
			pdef.frame.Visible = true
			if pdef.onResume then pdef.onResume(pdef) end
			App.panelChanged:Fire(prev)
			task.defer(function() UI.focus(pdef.resumeFocus or pdef.firstFocus or pdef.closeBtn) end)
		else
			App.popLayer("panel")
			App.panelChanged:Fire(nil)
			local opener = App.lastOpener
			if opener and opener.Parent then task.defer(function() UI.focus(opener) end) end
		end
	end
	if def.backHandler and def.backHandler(def, doClose) then return end
	if def.guard then def.guard(def, doClose) else doClose() end
end
function App.closeAll()
	while App.current do
		local name = App.current
		hide(name)
		App.current = table.remove(App.history)
	end
	table.clear(App.history)
	App.popLayer("panel")
	App.panelChanged:Fire(nil)
end

-- Settings application ------------------------------------------------------
local Lighting = game:GetService("Lighting")
function App.applySettings(s: any)
	if not s then return end
	musicGroup.Volume = s.music / 100
	sfxGroup.Volume = s.sfx / 100
	UI.reducedMotion = s.reducedMotion
	local mult = if s.textSize == "Huge" then 1.3 elseif s.textSize == "Large" then 1.15 else 1
	if mult ~= UI.textMult then UI.setTextMult(mult) end
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if bloom then bloom.Enabled = s.graphics ~= "Low"; bloom.Intensity = if s.graphics == "High" then 0.9 else 0.5 end
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if atm then atm.Density = if s.graphics == "Low" then 0.2 else 0.32 end
	Lighting.GlobalShadows = s.graphics == "High"
	App.settings = s
end
App.profileChanged:Connect(function(p) App.applySettings(p.settings) end)

function App.kartStats(kartId: string): any
	local p = App.profile
	local k = Config.getKart(kartId) :: any
	local up = p and p.upgrades[kartId] or { speed = 0, handling = 0, boost = 0 }
	return { speed = k.speed + up.speed * 0.5, handling = k.handling + up.handling * 0.5, boost = k.boost + up.boost * 0.5, accel = k.accel }
end

return App
