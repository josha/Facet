	-- Wallet (top-right)
	local wallet = new("Frame", { Name = "Wallet", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X, Parent = root })
	UI.list(wallet, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right)
	local function pill(icon: string, color: Color3, order: number): TextLabel
		local f = new("Frame", { BackgroundColor3 = T.panel, BackgroundTransparency = 0.1, Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = order, Parent = wallet })
		UI.corner(f, 20)
		UI.stroke(f, color, 1.5, 0.2)
		UI.pad(f, 0, 12)
		UI.list(f, Enum.FillDirection.Horizontal, 6).VerticalAlignment = Enum.VerticalAlignment.Center
		local ic = UI.label(f, icon, 18, { TextColor3 = color, Size = UDim2.fromOffset(20, 40), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1, FontFace = UI.F.bold })
		local v = UI.label(f, "0", 17, { FontFace = UI.F.bold, Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X, TextYAlignment = Enum.TextYAlignment.Center, LayoutOrder = 2 })
		return v
	end
	local creditsL = pill("◆", T.amber, 1)
	local fluxL = pill("✦", T.violet, 2)
	App.walletFrame = wallet

	-- Navigation rail (right side)
	local nav = UI.scroll(root, { Name = "Nav", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 60), Size = UDim2.new(0, 84, 1, -200), ScrollBarThickness = 4, ClipsDescendants = true })
	local grid = new("UIGridLayout", { CellSize = UDim2.fromOffset(78, 66), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right, Parent = nav })
	UI.pad(nav, 3, 3)
	App.nav = {}
	local items = {
		{ id = "race", label = "RACE", icon = "🏁", color = T.magenta, panel = "queue" },
