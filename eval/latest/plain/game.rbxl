-- Shared game data for Neon Drift League. The server is the authority; clients read it for display.
local Config = {}

Config.Currency = { soft = "Credits", hard = "Flux" }
Config.Rarities = { "Common", "Rare", "Epic", "Legendary" }
Config.RarityRank = { Common = 1, Rare = 2, Epic = 3, Legendary = 4 } :: { [string]: number }
Config.RarityColor = {
	Common = Color3.fromRGB(170, 190, 210),
	Rare = Color3.fromRGB(0, 200, 255),
	Epic = Color3.fromRGB(190, 90, 255),
	Legendary = Color3.fromRGB(255, 190, 40),
} :: { [string]: Color3 }

export type Kart = { id: string, name: string, rarity: string, category: string, speed: number, handling: number, boost: number, accel: number, desc: string }
Config.Karts = {
	{ id = "volt", name = "Volt Runner", rarity = "Common", category = "Balanced", speed = 6, handling = 7, boost = 5, accel = 6, desc = "Reliable all-rounder with a forgiving grip." },
	{ id = "quark", name = "Quark Dart", rarity = "Common", category = "Handling", speed = 5, handling = 8, boost = 6, accel = 8, desc = "Tiny, twitchy and quick off the line." },
	{ id = "pulse", name = "Pulse Sprinter", rarity = "Rare", category = "Speed", speed = 8, handling = 5, boost = 6, accel = 6, desc = "Long straights are its playground." },
	{ id = "ion", name = "Ion Drifter", rarity = "Rare", category = "Handling", speed = 6, handling = 9, boost = 6, accel = 7, desc = "Carves corners and charges drift turbos fast." },
	{ id = "brute", name = "Nova Brute", rarity = "Epic", category = "Speed", speed = 9, handling = 4, boost = 7, accel = 5, desc = "Heavy plasma hauler with a huge top end." },
	{ id = "echo", name = "Echo Glider", rarity = "Epic", category = "Boost", speed = 7, handling = 7, boost = 9, accel = 6, desc = "Boost tanks the size of a small star." },
	{ id = "lance", name = "Photon Lance", rarity = "Legendary", category = "Speed", speed = 10, handling = 6, boost = 8, accel = 7, desc = "A beam of light with a seat bolted on." },
	{ id = "aurora", name = "Aurora Prime", rarity = "Legendary", category = "Balanced", speed = 9, handling = 8, boost = 8, accel = 8, desc = "Factory prototype. Balanced, brilliant, rare." },
} :: { Kart }
Config.KartCategories = { "All", "Balanced", "Speed", "Handling", "Boost" }

export type Part = { id: string, name: string, slot: string, price: number, rarity: string, effect: string, speed: number?, handling: number?, boost: number?, glow: string? }
Config.Slots = { "motor", "boost", "wheels", "cosmetic" }
Config.SlotLabel = { motor = "Motor", boost = "Boost", wheels = "Wheels", cosmetic = "Cosmetic" } :: { [string]: string }
Config.Parts = {
	{ id = "m_spark", name = "Spark Motor", slot = "motor", price = 300, rarity = "Common", effect = "+3% top speed", speed = 0.03 },
	{ id = "m_fusion", name = "Fusion Core", slot = "motor", price = 1200, rarity = "Rare", effect = "+7% top speed", speed = 0.07 },
	{ id = "m_quantum", name = "Quantum Drive", slot = "motor", price = 4000, rarity = "Legendary", effect = "+12% top speed", speed = 0.12 },
	{ id = "b_nitro", name = "Nitro Cell", slot = "boost", price = 250, rarity = "Common", effect = "+10% boost power", boost = 0.10 },
	{ id = "b_plasma", name = "Plasma Injector", slot = "boost", price = 1500, rarity = "Epic", effect = "+20% boost power", boost = 0.20 },
	{ id = "b_sing", name = "Singularity Tank", slot = "boost", price = 5000, rarity = "Legendary", effect = "+32% boost power", boost = 0.32 },
	{ id = "w_grip", name = "Grip Rings", slot = "wheels", price = 200, rarity = "Common", effect = "+5% handling", handling = 0.05 },
	{ id = "w_hover", name = "Hover Treads", slot = "wheels", price = 1400, rarity = "Rare", effect = "+10% handling", handling = 0.10 },
	{ id = "w_maglev", name = "Mag-Lev Discs", slot = "wheels", price = 4500, rarity = "Epic", effect = "+15% handling", handling = 0.15 },
	{ id = "c_glow", name = "Magenta Underglow", slot = "cosmetic", price = 500, rarity = "Common", effect = "Magenta glow under the kart", glow = "Magenta" },
	{ id = "c_spoiler", name = "Holo Spoiler", slot = "cosmetic", price = 900, rarity = "Rare", effect = "Translucent holo rear wing", glow = "Spoiler" },
	{ id = "c_trail", name = "Starstream Trail", slot = "cosmetic", price = 2500, rarity = "Epic", effect = "Leaves a starlight trail", glow = "Trail" },
} :: { Part }
Config.ConfirmThreshold = 1000

export type Driver = { id: string, name: string, group: string, speed: number, handling: number, boost: number, price: number, rent: number, bio: string }
Config.DriverGroups = { "Rookies", "Pros", "Legends" }
Config.Drivers = {
	{ id = "kai", name = "Kai", group = "Rookies", speed = 0, handling = 0, boost = 0, price = 0, rent = 0, bio = "Your first co-pilot. Always available." },
	{ id = "mira", name = "Mira", group = "Rookies", speed = 0.01, handling = 0.03, boost = 0, price = 600, rent = 60, bio = "Steady hands on tight corners." },
	{ id = "rex", name = "Rex", group = "Pros", speed = 0.04, handling = 0, boost = 0.02, price = 2000, rent = 180, bio = "Former freight pilot. Floors it." },
	{ id = "sol", name = "Sol", group = "Pros", speed = 0.02, handling = 0.02, boost = 0.05, price = 2400, rent = 220, bio = "Times boosts to the millisecond." },
	{ id = "vega", name = "Vega", group = "Legends", speed = 0.05, handling = 0.04, boost = 0.05, price = 6000, rent = 450, bio = "Five-time Neon League champion." },
	{ id = "onyx", name = "Onyx", group = "Legends", speed = 0.07, handling = 0.02, boost = 0.06, price = 7500, rent = 550, bio = "Never seen without a visor. Never seen losing." },
} :: { Driver }
Config.RentalSeconds = 600

Config.UpgradeMax = 5
Config.UpgradeStats = { "speed", "handling", "boost" }
function Config.upgradeCost(level: number): (number, number)
	-- Cost to go from `level` to `level + 1`: Credits, Flux.
	return 250 * (level + 1), 2 * (level + 1)
end
Config.UpgradeStep = 0.04

Config.Colors = {
	{ name = "Red", color = Color3.fromRGB(255, 50, 80) },
	{ name = "Amber", color = Color3.fromRGB(255, 176, 0) },
	{ name = "Green", color = Color3.fromRGB(40, 255, 130) },
	{ name = "Cyan", color = Color3.fromRGB(0, 235, 255) },
	{ name = "Blue", color = Color3.fromRGB(50, 110, 255) },
	{ name = "Violet", color = Color3.fromRGB(175, 80, 255) },
}
Config.Shades = { 50, 75, 100 }
Config.Decals = {
	{ id = "none", name = "None", glyph = "" },
	{ id = "bolt", name = "Bolt", glyph = "⚡" },
	{ id = "star", name = "Star", glyph = "★" },
	{ id = "flame", name = "Flame", glyph = "🔥" },
	{ id = "skull", name = "Skull", glyph = "☠" },
	{ id = "crown", name = "Crown", glyph = "♛" },
	{ id = "seven", name = "Lucky 7", glyph = "7" },
}
function Config.colorOf(name: string, shade: number): Color3
	for _, c in Config.Colors do
		if c.name == name then
			local k = math.clamp(shade, 0, 100) / 100
			return Color3.new(0, 0, 0):Lerp(c.color, 0.1 + 0.9 * k)
		end
	end
	return Color3.fromRGB(0, 235, 255)
end
function Config.decalGlyph(id: string): string
	for _, d in Config.Decals do if d.id == id then return d.glyph end end
	return ""
end
Config.DefaultLivery = { body = "Cyan", bodyShade = 100, accent = "Violet", accentShade = 75, decal = "bolt" }

Config.Crates = {
	{ id = "spark", name = "Spark Crate", price = 300, currency = "soft", cards = 3, odds = { Common = 70, Rare = 22, Epic = 7, Legendary = 1 } },
	{ id = "nova", name = "Nova Crate", price = 25, currency = "hard", cards = 5, odds = { Common = 40, Rare = 35, Epic = 18, Legendary = 7 } },
}
Config.Cards = {
	{ id = "c1", name = "Grid Ghost", rarity = "Common" }, { id = "c2", name = "Cyan Comet", rarity = "Common" },
	{ id = "c3", name = "Pit Drone", rarity = "Common" }, { id = "c4", name = "Neon Cone", rarity = "Common" },
	{ id = "r1", name = "Arc Rider", rarity = "Rare" }, { id = "r2", name = "Plasma Pup", rarity = "Rare" },
	{ id = "r3", name = "Orbit Ring", rarity = "Rare" }, { id = "r4", name = "Static Fox", rarity = "Rare" },
	{ id = "e1", name = "Void Wyrm", rarity = "Epic" }, { id = "e2", name = "Prism Queen", rarity = "Epic" },
	{ id = "e3", name = "Turbo Titan", rarity = "Epic" },
	{ id = "l1", name = "Singularity", rarity = "Legendary" }, { id = "l2", name = "The Last Lap", rarity = "Legendary" },
}

Config.Daily = {
	{ day = 1, label = "150 Credits", soft = 150 },
	{ day = 2, label = "250 Credits", soft = 250 },
	{ day = 3, label = "5 Flux", hard = 5 },
	{ day = 4, label = "400 Credits", soft = 400 },
	{ day = 5, label = "Free Spark Crate", crate = 1 },
	{ day = 6, label = "600 Credits + 10 Flux", soft = 600, hard = 10 },
	{ day = 7, label = "JACKPOT: 1500 Credits, 30 Flux + Starstream Trail", soft = 1500, hard = 30, part = "c_trail", special = true },
}

Config.Codes = {
	NEONRUSH = { soft = 500, hard = 5, label = "500 Credits + 5 Flux" },
	GRIDSTART = { soft = 250, label = "250 Credits" },
	LAUNCH2024 = { expired = true, soft = 1000, label = "Expired launch code" },
} :: { [string]: any }
Config.SampleCode = "NEONRUSH"

Config.Boosts = {
	{ id = "xp2", name = "Double XP", desc = "2x race XP for 15 minutes", price = 10, currency = "hard", seconds = 900 },
	{ id = "cr50", name = "Credit Surge", desc = "+50% race Credits for 15 minutes", price = 600, currency = "soft", seconds = 900 },
}

Config.Quests = {
	{ id = "race3", name = "Hit the Grid", desc = "Finish 3 races", goal = 3, soft = 300 },
	{ id = "podium", name = "Podium Finish", desc = "Finish a race in the top 3", goal = 1, soft = 400, hard = 5 },
	{ id = "drift", name = "Drift King", desc = "Fire 10 drift turbos", goal = 10, soft = 350 },
	{ id = "crate", name = "Collector", desc = "Open 2 crates", goal = 2, hard = 5 },
}

Config.Offer = { id = "starter", name = "Neon Starter Bundle", price = 15, currency = "hard", soft = 2000, part = "c_glow", seconds = 1800, maxLevel = 10, desc = "2000 Credits + Magenta Underglow" }

Config.QuickChat = { "Good luck!", "Nice drift!", "Watch out!", "On your left!", "GG!", "Rematch?", "So close!", "Boost time!" }
Config.QuickChatCooldown = 5

Config.Leagues = { { name = "Bronze", xp = 0 }, { name = "Silver", xp = 600 }, { name = "Gold", xp = 1600 }, { name = "Neon", xp = 3500 }, { name = "Quantum", xp = 7000 } }
function Config.xpForLevel(level: number): number
	return 200 + (level - 1) * 100
end

Config.RaceRewards = {
	soft = { 600, 420, 300, 220, 160, 120 },
	xp = { 160, 120, 100, 80, 70, 60 },
	hard = { 6, 3, 2, 0, 0, 0 },
}

Config.Friends = {
	{ id = "demo_juno", name = "Juno", status = "Online", reply = "accept" },
	{ id = "demo_rune", name = "Rune", status = "Online", reply = "decline" },
	{ id = "demo_pixel", name = "Pixel", status = "Online", reply = "accept" },
	{ id = "demo_volt", name = "Voltage", status = "Racing", reply = "accept" },
	{ id = "demo_nyx", name = "Nyx", status = "Offline", reply = "decline" },
	{ id = "demo_tess", name = "Tessa", status = "Offline", reply = "accept" },
}

Config.Bots = { "Zap", "Nyra", "Quasar", "Hex", "Orbit", "Flicker", "Raze", "Lumen" }
Config.BotColors = { "Red", "Amber", "Green", "Blue", "Violet", "Cyan", "Red", "Amber" }
Config.MaxRacers = 6

Config.Mechanic = { jobBolts = 3, rewardSoft = 400, rewardHard = 5 }

export type Track = { id: string, name: string, desc: string, laps: number, mode: string, origin: Vector3, points: { Vector2 }, width: number, color: Color3, pads: { number } }
Config.Tracks = {
	{ id = "cyan", name = "Cyan Circuit", desc = "Flowing city loop with two long straights. Classic race, 3 laps.", laps = 3, mode = "Race",
		origin = Vector3.new(0, 2, 700), width = 44, color = Color3.fromRGB(0, 235, 255), pads = { 8, 70 },
		points = { Vector2.new(0, 0), Vector2.new(170, 0), Vector2.new(290, -30), Vector2.new(345, -120), Vector2.new(300, -215), Vector2.new(180, -245), Vector2.new(80, -195), Vector2.new(-20, -245), Vector2.new(-165, -255), Vector2.new(-285, -185), Vector2.new(-305, -65), Vector2.new(-225, 5), Vector2.new(-110, 10) } },
	{ id = "helix", name = "Helix Drift", desc = "Tight hairpins built for drift turbos. Classic race, 3 laps.", laps = 3, mode = "Race",
		origin = Vector3.new(900, 2, 700), width = 44, color = Color3.fromRGB(255, 60, 220), pads = { 6, 60 },
		points = { Vector2.new(0, 0), Vector2.new(200, 0), Vector2.new(310, 70), Vector2.new(265, 200), Vector2.new(130, 185), Vector2.new(60, 265), Vector2.new(-85, 285), Vector2.new(-225, 205), Vector2.new(-245, 65), Vector2.new(-130, 0) } },
	{ id = "gauntlet", name = "Neon Gauntlet", desc = "KNOCKOUT: last place is OUT each lap. Survive 4 laps.", laps = 4, mode = "Knockout",
		origin = Vector3.new(-900, 2, 700), width = 46, color = Color3.fromRGB(255, 176, 0), pads = { 8, 75 },
		points = { Vector2.new(0, 0), Vector2.new(220, 0), Vector2.new(320, -60), Vector2.new(325, -180), Vector2.new(205, -225), Vector2.new(100, -145), Vector2.new(0, -205), Vector2.new(-125, -225), Vector2.new(-245, -160), Vector2.new(-265, -40), Vector2.new(-140, 0) } },
} :: { Track }
Config.TestTrack = "cyan"

local pathCache: { [string]: { Vector3 } } = {}
local function catmull(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, t: number): Vector2
	local t2, t3 = t * t, t * t * t
	return 0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 + (-p0 + 3 * p1 - 3 * p2 + p3) * t3)
end
-- Dense closed centreline in world space, roughly every 10 studs. Index 1 is the start/finish line.
function Config.getPath(trackId: string): { Vector3 }
	local cached = pathCache[trackId]
	if cached then return cached end
	local track = Config.getTrack(trackId)
	assert(track, "unknown track")
	local pts = track.points
	local n = #pts
	local out: { Vector3 } = {}
	for i = 1, n do
		local p0, p1, p2, p3 = pts[(i - 2) % n + 1], pts[i], pts[i % n + 1], pts[(i + 1) % n + 1]
		local steps = math.max(4, math.floor((p2 - p1).Magnitude / 10))
		for s = 0, steps - 1 do
			local v = catmull(p0, p1, p2, p3, s / steps)
			table.insert(out, track.origin + Vector3.new(v.X, 0, v.Y))
		end
	end
	pathCache[trackId] = out
	return out
end
function Config.getTrack(trackId: string): Track?
	for _, t in Config.Tracks do if t.id == trackId then return t end end
	return nil
end
function Config.getKart(id: string): Kart?
	for _, k in Config.Karts do if k.id == id then return k end end
	return nil
end
function Config.getPart(id: string): Part?
	for _, p in Config.Parts do if p.id == id then return p end end
	return nil
end
function Config.getDriver(id: string): Driver?
	for _, d in Config.Drivers do if d.id == id then return d end end
	return nil
end
function Config.leagueFor(totalXp: number): (string, number, number)
	local cur, base, nextXp = Config.Leagues[1].name, 0, Config.Leagues[2].xp
	for i, l in Config.Leagues do
		if totalXp >= l.xp then
			cur = l.name
			base = l.xp
			nextXp = if Config.Leagues[i + 1] then Config.Leagues[i + 1].xp else l.xp
		end
	end
	return cur, base, nextXp
end

return Config
]]></ProtectedString>
