local panelTitle=label(panel,"GARAGE",26);panelTitle.Font=Enum.Font.GothamBlack;panelTitle.Position=UDim2.fromOffset(22,14);panelTitle.Size=UDim2.new(1,-90,0,38)
local panelSub=label(panel,"",12,palette.muted);panelSub.Position=UDim2.fromOffset(22,51);panelSub.Size=UDim2.new(1,-44,0,22)
local closeBtn=button(panel,"×",function() closePanel() end);closeBtn.Position=UDim2.new(1,-58,0,17);closeBtn.Size=UDim2.fromOffset(38,38);closeBtn.TextSize=25
local content=Instance.new("ScrollingFrame");content.BackgroundTransparency=1;content.BorderSizePixel=0;content.Position=UDim2.fromOffset(20,86);content.Size=UDim2.new(1,-40,1,-124);content.CanvasSize=UDim2.new();content.AutomaticCanvasSize=Enum.AutomaticSize.Y;content.ScrollBarThickness=4;content.ScrollBarImageColor3=palette.cyan;content.Parent=panel
list(content,9);local cp=Instance.new("UIPadding");cp.PaddingRight=UDim.new(0,8);cp.PaddingBottom=UDim.new(0,12);cp.Parent=content
local saveLabel=label(panel,"SESSION STORAGE • no cloud save connected",10,palette.muted);saveLabel.Position=UDim2.new(0,22,1,-27);saveLabel.Size=UDim2.new(1,-44,0,20)
local function clearContent()
 for _,v in ipairs(content:GetChildren()) do if v:IsA("GuiObject") then v:Destroy() end end
end
local function tabs(parent,items,active,fn)
 local f=frame(parent,UDim2.new(1,0,0,42));f.BackgroundTransparency=1
 local g=Instance.new("UIGridLayout");g.CellPadding=UDim2.fromOffset(5,0);g.CellSize=UDim2.new(1/#items,-5,1,0);g.Parent=f
 for _,v in ipairs(items) do local b=button(f,v,function() fn(v) end,v==active and palette.cyan or palette.card);b.TextSize=12;if C.Colors[v] then b.BackgroundColor3=rgb(v);b.TextColor3=palette.bg;if v==active then stroke(b,palette.text,3) end end end
 return f
end
local function textbox(parent,placeholder,value,changed)
 local f=row(parent,44);local t=Instance.new("TextBox");t.Size=UDim2.new(1,-24,1,0);t.Position=UDim2.fromOffset(12,0);t.BackgroundTransparency=1;t.Text=value or "";t.PlaceholderText=placeholder;t.Font=Enum.Font.Gotham;t.TextSize=15;t.TextColor3=palette.text;t.PlaceholderColor3=palette.muted;t.ClearTextOnFocus=false;t.TextXAlignment=Enum.TextXAlignment.Left;t.Parent=f
 t:GetPropertyChangedSignal("Text"):Connect(function() changed(t.Text) end)
 return t
end
local function focusFirst(parent)
 if UIS.GamepadEnabled then for _,v in ipairs(parent:GetDescendants()) do if v:IsA("TextButton") and v.Visible then GS.SelectedObject=v;break end end end
end
local function confirm(title,desc,fn,price)
 if confirmation then confirmation:Destroy() end
 local old=GS.SelectedObject
 local layer=frame(root,UDim2.fromScale(1,1),nil,Color3.fromRGB(0,0,0));layer.BackgroundTransparency=.22;layer.ZIndex=50
 local card=frame(layer,UDim2.new(.84,0,0,262),UDim2.fromScale(.5,.5),palette.panel);card.AnchorPoint=Vector2.new(.5,.5);card.ZIndex=51;corner(card,14);stroke(card,palette.cyan)
 local mx=Instance.new("UISizeConstraint");mx.MaxSize=Vector2.new(530,400);mx.Parent=card
 local t=label(card,title,23);t.Font=Enum.Font.GothamBold;t.Position=UDim2.fromOffset(22,20);t.Size=UDim2.new(1,-44,0,35);t.ZIndex=52
 local d=label(card,desc,15,palette.muted);d.Position=UDim2.fromOffset(22,63);d.Size=UDim2.new(1,-44,0,78);d.ZIndex=52
 local pr=label(card,price or "No currency is spent until you confirm.",15,palette.amber);pr.Position=UDim2.fromOffset(22,144);pr.Size=UDim2.new(1,-44,0,32);pr.ZIndex=52
 local function dismiss() layer:Destroy();confirmation=nil;confirmFn=nil;if old and old.Parent then GS.SelectedObject=old end end
 local no=button(card,"CANCEL",dismiss);no.Position=UDim2.new(0,22,1,-66);no.Size=UDim2.new(.45,-22,0,44);no.ZIndex=52
 local yes=button(card,(string.find(string.lower(title),"discard",1,true) or string.find(string.lower(title),"unsaved",1,true)) and "DISCARD" or "CONFIRM",function() dismiss();fn() end,palette.cyan);yes.Position=UDim2.new(.5,0,1,-66);yes.Size=UDim2.new(.5,-22,0,44);yes.ZIndex=52
 confirmation=layer;confirmFn=dismiss;GS.SelectedObject=no
end
local function preview(parent,design,kartId)
 local vp=Instance.new("ViewportFrame");vp.Size=UDim2.new(1,0,0,190);vp.BackgroundColor3=Color3.fromRGB(11,20,36);vp.Ambient=Color3.fromRGB(180,195,220);vp.LightColor=Color3.fromRGB(255,255,255);vp.LightDirection=Vector3.new(-1,-2,-1);corner(vp,12);vp.Parent=parent
 local world=Instance.new("WorldModel");world.Parent=vp
 local function part(size,pos,col)
  local p1=Instance.new("Part");p1.Size=size;if size==Vector3.new(1,1.7,1.7) or size==Vector3.new(.15,.8,.8) then p1.Shape=Enum.PartType.Cylinder elseif size==Vector3.new(1.2,1.2,1.2) then p1.Shape=Enum.PartType.Ball end;p1.Position=pos;p1.Color=col;p1.Anchored=true;p1.Material=Enum.Material.SmoothPlastic;p1.Parent=world;return p1
 end
 local b=rgb(design.body,design.shade);local a=rgb(design.accent)
 part(Vector3.new(4.3,.7,6),Vector3.new(0,1.3,0),b)
 part(Vector3.new(3.6,.5,2),Vector3.new(0,1,-3.4),b)
 part(Vector3.new(2,1,2),Vector3.new(0,2,.2),palette.bg)
 part(Vector3.new(1.2,1.2,1.2),Vector3.new(0,2.8,0),a)
 part(Vector3.new(1.25,.35,.15),Vector3.new(0,2.9,-.65),palette.text)
 part(Vector3.new(5,.3,1),Vector3.new(0,2.5,2.8),a)
 for _,x in ipairs({-2.3,2.3}) do for _,z in ipairs({-1.8,2}) do part(Vector3.new(1,1.7,1.7),Vector3.new(x,.8,z),palette.bg);part(Vector3.new(.15,.8,.8),Vector3.new(x+(x>0 and .55 or -.55),.8,z),a) end end
 local dec=table.find(C.Decals,design.decal) or 1
 for i=1,math.min(dec,4) do part(Vector3.new(.2,.04,5),Vector3.new((i-(math.min(dec,4)+1)/2)*.5,1.67,-.5),a) end
 local cam=Instance.new("Camera");cam.CFrame=CFrame.lookAt(Vector3.new(8,6,-10),Vector3.new(0,1,0));cam.FieldOfView=34;cam.Parent=vp;vp.CurrentCamera=cam
 local n=label(vp,(find(C.Karts,kartId)).name,12,palette.cyan);n.Position=UDim2.fromOffset(14,9);n.Size=UDim2.new(1,-20,0,24)
 return vp
end
local garageList=nil
local function renderGarageCards()
 if not garageList then return end
 for _,v in ipairs(garageList:GetChildren()) do if v:IsA("GuiObject") then v:Destroy() end end
 local items={}
 for _,k in ipairs(C.Karts) do if string.find(string.lower(k.name),string.lower(search),1,true) and (category=="All" or k.class==category or category=="★" and state.favorites[k.id]) and (rarity==0 or k.rarity==rarity) then table.insert(items,k) end end
 table.sort(items,function(a,b)
  if sortMode==2 and a.speed~=b.speed then return a.speed>b.speed end
  if sortMode==3 and a.rarity~=b.rarity then return a.rarity>b.rarity end
  return a.name<b.name
 end)
 if #items==0 then note(garageList,"NO KARTS FOUND • Clear search or change filters.",palette.amber) end
 for _,k in ipairs(items) do
  local owned=state.ownedKarts[k.id]
  local f=textRow(garageList,(selected==k.id and "◈ " or "")..k.name..(state.favorites[k.id] and " ★" or ""),C.Rarity[k.rarity].." / "..k.class.."   SPD "..k.speed.."  GRIP "..k.handling.."  BOOST "..k.boost,"INSPECT",function() selected=k.id;render() end,selected==k.id and palette.cyan or nil)
  if selected==k.id then stroke(f,palette.cyan) end
 end
end
local function renderGarage()
 local k=find(C.Karts,selected)
 preview(content,{body=k.color,accent=state.livery.accent,shade=1,decal=state.livery.decal},selected)
 heading(content,k.name.."  /  "..C.Rarity[k.rarity])
 note(content,k.desc)
 tabs(content,{state.kart==k.id and "SELECTED" or state.ownedKarts[k.id] and "SELECT" or "BUY "..k.price,"TRY KART",state.favorites[k.id] and "★ FAVORITE" or "☆ FAVORITE"},"",function(v)
  if v=="TRY KART" then send("try",k.id);closePanel(true)
  elseif string.find(v,"FAVORITE") then send("favorite",k.id)
  elseif state.ownedKarts[k.id] then send("kart",k.id)
  else confirm("Unlock "..k.name,"Own this chassis and choose it for your next race.",function() send("kart",k.id) end,k.price.." credits") end
 end)
 local sf=frame(content,UDim2.new(1,0,0,44));sf.BackgroundTransparency=1
 local box=textbox(sf,"Search kart names…",search,function(v) search=v;renderGarageCards() end);box.Size=UDim2.new(1,-88,1,0)
 local cl=button(sf,"CLEAR",function() search="";render() end);cl.Position=UDim2.new(1,-80,0,0);cl.Size=UDim2.fromOffset(80,44)
 tabs(content,{"All","Street","Sport","Hyper","Rally","★"},category,function(v) category=v;render() end)
 tabs(content,{"Any rarity","Common","Rare","Epic","Legendary","Mythic"},({"Any rarity","Common","Rare","Epic","Legendary","Mythic"})[rarity+1],function(v) rarity=({["Any rarity"]=0,Common=1,Rare=2,Epic=3,Legendary=4,Mythic=5})[v];render() end)
 local sorts={"Name A–Z","Speed ↓","Rarity ↓"};tabs(content,sorts,sorts[sortMode],function(v) sortMode=table.find(sorts,v);render() end)
 garageList=frame(content,UDim2.new(1,0,0,0));garageList.AutomaticSize=Enum.AutomaticSize.Y;garageList.BackgroundTransparency=1;list(garageList,8);renderGarageCards()
end
local function renderShop()
 tabs(content,{"All","Motor","Boost","Wheels","Cosmetic"},shopFilter,function(v) shopFilter=v;render() end)
 textRow(content,"PIT ACCESS CODE","Try APEX for a welcome grant.","REDEEM →",function() openPanel("Codes") end,palette.cyan)
 for _,v in ipairs(C.Parts) do if shopFilter=="All" or shopFilter==v.slot then
  local owned=state.owned[v.id]
  textRow(content,v.name,v.slot.." • "..v.desc.." • "..v.price.." credits",owned and "OWNED" or state.coins<v.price and "NEED "..v.price or "BUY",function()
   if owned then notify("Already in your inventory") else confirm("Purchase "..v.name,v.desc..". Adds this part to your inventory.",function() send("buyPart",v.id) end,v.price.." credits") end
  end,owned and nil or palette.cyan)
 end end
 heading(content,"LIVE SUPPLY / LIMITED")
 textRow(content,"STARTER SUPPLY","3 crates +30 shards • 800 credits • expires in "..math.max(0,state.offerEnd-state.serverTime).."s",state.offerBought and "CLAIMED" or "VIEW OFFER",function() confirm("Starter supply","Available once before the timer expires.",function() send("offer") end,"800 credits") end)
end
local function renderInventory()
 heading(content,"EQUIPMENT / ONE PART PER SLOT")
 for _,slot in ipairs({"Motor","Boost","Wheels","Cosmetic"}) do
  local equipped=state.equipped[slot]
  local item=equipped and find(C.Parts,equipped)
  note(content,string.upper(slot).."  /  "..(item and item.name or "EMPTY SLOT"),item and palette.cyan or palette.muted)
  for _,v in ipairs(C.Parts) do if v.slot==slot then
   textRow(content,v.name,v.desc,state.owned[v.id] and (equipped==v.id and "UNEQUIP" or "EQUIP") or "UNAVAILABLE",function() if state.owned[v.id] then send("equip",v.id) else notify("Visit the shop to unlock this part") end end,equipped==v.id and palette.cyan or nil)
  end end
 end
 textRow(content,"DRIVER / "..find(C.Drivers,state.driver).name,"Choose your racing partner.","DRIVERS →",function() openPanel("Drivers") end)
end
local function renderDrivers()
 tabs(content,{"All","Pilots","Androids"},driverGroup,function(v) driverGroup=v;render() end)
 for _,d in ipairs(C.Drivers) do if driverGroup=="All" or driverGroup==d.group then
  local owned=state.drivers[d.id];local left=(state.rentals[d.id] or 0)-state.serverTime;local active=left>0
  heading(content,d.name.." / "..d.group)
  textRow(content,d.desc,owned and "PERMANENTLY OWNED" or active and "RENTAL ACTIVE • "..math.floor(left/60)..":"..string.format("%02d",left%60) or "Unavailable until owned or rented",state.driver==d.id and "EQUIPPED" or (owned or active) and "EQUIP" or "LOCKED",function() send("driver",d.id) end,state.driver==d.id and palette.cyan or nil)
  if not owned then
   tabs(content,{"BUY / "..d.price,"RENT / "..d.rent},"",function(v)
    local buy=string.sub(v,1,3)=="BUY"
    confirm((buy and "Own " or "Rent ")..d.name,buy and "Permanent access to this driver." or "10 minutes of access. Timer begins immediately; permanent ownership is separate.",function() send(buy and "buyDriver" or "rentDriver",d.id) end,(buy and d.price or d.rent).." credits")
   end)
  end
 end end
end
local function renderLivery()
 if not draft then draft=table.clone(state.livery) end
 preview(content,draft,state.kart)
 heading(content,dirty and "UNSAVED DESIGN • preview only" or "SAVED DESIGN",palette.amber)
 for _,slot in ipairs({"body","accent"}) do
  heading(content,string.upper(slot).." COLOR")
  tabs(content,{"Red","Amber","Green","Cyan","Blue","Violet"},draft[slot],function(v) draft[slot]=v;dirty=true;render() end)
 end
 tabs(content,{"50%","75%","100%"},tostring(draft.shade*100).."%",function(v) draft.shade=tonumber(string.sub(v,1,-2))/100;dirty=true;render() end)
 heading(content,"DECAL / SIX SIGNATURES")
 tabs(content,C.Decals,draft.decal,function(v) draft.decal=v;dirty=true;render() end)
 tabs(content,{"SAVE DESIGN","REVERT"},"SAVE DESIGN",function(v)
  if v=="SAVE DESIGN" then send("livery",draft);saveLabel.Text="Saving… awaiting server confirmation"
  elseif dirty then confirm("Discard unsaved design?","Your last saved colors and decal will be restored.",function() draft=table.clone(state.livery);dirty=false;render() end,"No currency cost")
  else notify("Design already matches your save") end
 end)
end
local function renderUpgrades()
 tabs(content,{"‹ PREVIOUS KART",find(C.Karts,selected).name,"NEXT KART ›"},"",function(v)
  local ix=1;for i,k in ipairs(C.Karts) do if k.id==selected then ix=i end end
  if v=="NEXT KART ›" then selected=C.Karts[ix%#C.Karts+1].id elseif v=="‹ PREVIOUS KART" then selected=C.Karts[(ix-2)%#C.Karts+1].id end;render()
 end)
 preview(content,{body=find(C.Karts,selected).color,accent="Cyan",shade=1,decal="STRIPE"},selected)
 local up=state.upgrades[selected] or {speed=0,handling=0,boost=0}
 for _,stat in ipairs({"speed","handling","boost"}) do
  local lv=up[stat];local owned=state.ownedKarts[selected]
  textRow(content,string.upper(stat).." / LEVEL "..lv.."/3",lv>=3 and "Maximum improvement reached" or "Next: +5 "..stat.." • "..400*(lv+1).." credits + "..8*(lv+1).." shards",lv>=3 and "MAXIMUM" or not owned and "KART LOCKED" or "UPGRADE",function()
   if lv>=3 then notify("Maximum level") elseif not owned then notify("Own this kart in the garage first")
   else confirm("Improve "..stat.."?",find(C.Karts,selected).name.." • level "..lv.." → "..(lv+1)..". This upgrade stays with this kart.",function() send("upgrade",{kart=selected,stat=stat}) end,400*(lv+1).." credits + "..8*(lv+1).." shards") end
  end,lv<3 and owned and palette.cyan or nil)
 end
end
local function renderCrates()
 textRow(content,"PULSE CRATE / 3 CARDS","Common 65% • Rare 25% • Epic 10%",state.freeCrates>0 and "FREE ×"..state.freeCrates or "350 CREDITS",function()
  confirm("Open Pulse crate","Contains 3 cards. Duplicate cards add to collection counts. Free crates are consumed first.",function() send("crate") end,state.freeCrates>0 and "FREE • uses 1 free crate" or "350 credits")
 end,palette.cyan)
 if state.reveal then
  if lastReveal~=state.revealSerial then lastReveal=state.revealSerial;revealCount=0 end
  heading(content,"CRATE REVEAL / "..revealCount.." OF 3")
  tabs(content,{"REVEAL NEXT","REVEAL ALL"},"",function(v) revealCount=v=="REVEAL ALL" and 3 or math.min(3,revealCount+1);render() end)
  for i=1,3 do textRow(content,i<=revealCount and C.Cards[state.reveal[i]] or "UNKNOWN CARD",i<=revealCount and "Added to collection • card "..i or "Reveal to inspect",nil) end
 end
 local count=0;for _ in pairs(state.cards) do count+=1 end
 heading(content,"COLLECTION / "..count.." OF "..#C.Cards.." DISCOVERED")
 for i,name in ipairs(C.Cards) do
  local n=state.cards[tostring(i)] or 0
  textRow(content,n>0 and name or "??? / UNDISCOVERED",i<=4 and "COMMON" or i<=8 and "RARE" or "EPIC",n>0 and "× "..n or "UNKNOWN",nil,n>0 and palette.card or nil)
 end
end
local function renderDaily()
 local day=math.floor(state.serverTime/86400);local ready=state.daily.last~=day
 note(content,ready and "REWARD READY • claim your next pit supply." or "Next claim in "..tostring(86400-state.serverTime%86400).." seconds. Resets at UTC midnight.",palette.amber)
 note(content,"Claim on consecutive UTC days. Missing a day restarts the track at Day 1.")
 for i=1,7 do
  local currentDay=state.daily.day
  local claimed=state.daily.last==day and i==(currentDay==1 and 7 or currentDay-1) or i<currentDay and state.daily.last>0
  textRow(content,"DAY "..i..(i==7 and " / GRAND SUPPLY" or ""),200+i*80 .." credits + "..(i==7 and "100 shards +2 free crates" or "5 shards"),i==currentDay and ready and "CLAIM" or claimed and "CLAIMED" or "LOCKED",function() if i==currentDay and ready then send("daily") end end,i==currentDay and ready and palette.cyan or nil)
 end
end
local function renderCodes()
 note(content,"PIT RADIO / Sample code: APEX • welcome credits and shards.",palette.cyan)
 local code=""
 local box=textbox(content,"Enter code…","",function(v) code=v end)
 local b=button(content,busy and "BUSY…" or "REDEEM CODE",function()
  if busy then return end
  busy=true;send("code",code);notify("Checking code…")
  task.delay(.7,function() busy=false end)
 end,palette.cyan);b.Size=UDim2.new(1,0,0,46)
 note(content,state.codeState or "Codes ignore case and spaces at either end.")
 if state.codeRetry and state.codeRetry>state.serverTime then note(content,"Retry in "..(state.codeRetry-state.serverTime).."s",palette.amber) end
 textRow(content,"RETURN TO PARTS","Your shop category remains selected.","← SHOP",function() openPanel("Shop") end)
end
local function renderQuests()
 heading(content,"PIT PASS / OBJECTIVES")
 textRow(content,"FIRST FINISH","Complete a race • "..math.min(1,state.quest.race).."/1 • 500 credits +15 shards",state.quest.claimed.race and "CLAIMED" or state.quest.race>=1 and "CLAIM" or "IN PROGRESS",function() send("quest","race") end)
 textRow(content,"DISTANCE RUNNER","Race 1000 studs • "..math.min(1000,state.quest.distance).."/1000 • 350 credits +10 shards",state.quest.claimed.distance and "CLAIMED" or state.quest.distance>=1000 and "CLAIM" or "IN PROGRESS",function() send("quest","distance") end)
 textRow(content,"10 MINUTE SPEED TUNE","+5 top speed • 150 credits",state.boostUntil>state.serverTime and "ACTIVE "..(state.boostUntil-state.serverTime).."s" or "ACTIVATE",function() confirm("Activate speed tune?","+5 speed for ten minutes. The timer begins now.",function() send("boostBuy") end,"150 credits") end)
 textRow(content,"DAILY SUPPLY","Seven days of rewards. Day seven has a bonus crate drop.","OPEN TRACK",function() openPanel("Daily") end)
 textRow(content,"MEET THE MECHANIC","A small job in the east pit • 400 credits +10 shards","ASK",function() openPanel("Mechanic") end)
end
local partyList=nil
local function renderPartyList()
 if not partyList then return end
 for _,v in ipairs(partyList:GetChildren()) do if v:IsA("GuiObject") then v:Destroy() end end
 for _,v in ipairs({{name="MIRA",status="Online / demo participant",id="MIRA"},{name="JAX",status="Racing / demo participant",id="JAX"},{name="SOL",status="Offline / demo participant",id="OFFLINE / SOL"}}) do
  if string.find(string.lower(v.name),string.lower(partySearch),1,true) then
   textRow(partyList,v.name,v.status,state.party[v.id] and "IN PARTY" or state.invites[v.id] or v.name=="SOL" and "OFFLINE" or "INVITE",function() send("invite",v.id) end)
  end
 end
end
local function renderParty()
 note(content,"Solo demo contacts: MIRA accepts; JAX declines. Accepted members stay in your party.",palette.muted)
 textbox(content,"Find friends…",partySearch,function(v) partySearch=v;renderPartyList() end)
 local b=button(content,"CLEAR SEARCH",function() partySearch="";render() end);b.Size=UDim2.new(1,0,0,38)
 local names={};for name in pairs(state.party) do table.insert(names,name) end
 note(content,"PARTY / YOU"..(#names>0 and " + "..table.concat(names,", ") or " • no teammates yet"),palette.cyan)
 partyList=frame(content,UDim2.new(1,0,0,0));partyList.AutomaticSize=Enum.AutomaticSize.Y;partyList.BackgroundTransparency=1;list(partyList,9);renderPartyList()
end
local function renderSettings()
 local settings=state.settings
 heading(content,"AUDIO")
 for _,key in ipairs({"music","effects"}) do
  local f=row(content,72);local l=label(f,string.upper(key).."  /  "..settings[key].."%",14);l.Position=UDim2.fromOffset(14,3);l.Size=UDim2.new(.6,0,0,25)
  local track=button(f,"",nil);track.Position=UDim2.new(0,16,0,40);track.Size=UDim2.new(1,-136,0,12);track.BackgroundColor3=palette.line
  local fill=frame(track,UDim2.fromScale(settings[key]/100,1),nil,palette.cyan);corner(fill,5)
  local function set(v) local data=table.clone(settings);data[key]=v;send("settings",data);saveLabel.Text="Saving… awaiting server confirmation" end
    local dragging=false
  local value=settings[key]
  local function updateAt(x)
   value=math.clamp(math.floor((x-track.AbsolutePosition.X)/track.AbsoluteSize.X*10+.5)*10,0,100)
   fill.Size=UDim2.fromScale(value/100,1);l.Text=string.upper(key).." / "..value.."%"
  end
  track.InputBegan:Connect(function(i)
   if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true;updateAt(i.Position.X) end
  end)
  local move=UIS.InputChanged:Connect(function(i) if dragging and (i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseMovement) then updateAt(i.Position.X) end end)
  local release=UIS.InputEnded:Connect(function(i) if dragging and (i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1) then dragging=false;set(value) end end)
  f.Destroying:Connect(function() move:Disconnect();release:Disconnect() end)

  local minus=button(f,"−",function() set(settings[key]-10) end);minus.Position=UDim2.new(1,-108,0,25);minus.Size=UDim2.fromOffset(42,38)
  local plus=button(f,"+",function() set(settings[key]+10) end);plus.Position=UDim2.new(1,-58,0,25);plus.Size=UDim2.fromOffset(42,38)
 end
 heading(content,"DISPLAY & ACCESSIBILITY")
 for _,v in ipairs({{"damage","Damage numbers"},{"shake","Camera shake"},{"large","Larger text"},{"motion","Reduced motion"}}) do
  textRow(content,v[2],"Applied to this session",settings[v[1]] and "ON" or "OFF",function() local data=table.clone(settings);data[v[1]]=not data[v[1]];send("settings",data) end,settings[v[1]] and palette.cyan or nil)
 end
 tabs(content,{"LOW","MEDIUM","HIGH"},({"LOW","MEDIUM","HIGH"})[settings.quality],function(v) local data=table.clone(settings);data.quality=({LOW=1,MEDIUM=2,HIGH=3})[v];send("settings",data) end)
 heading(content,"CONTROLS")
 note(content,"WASD / arrows: drive • Space: drift / brake • Shift: boost • R: recover • Tab: standings • Q: quick chat")
 note(content,"Controller: left stick steer • RT accelerate • LT reverse • A boost • X drift • Y chat • D-pad Up standings • B back")
 note(content,"Touch: use the road controls. Menus have native scrolling and selectable buttons.")
 textRow(content,"RESTORE DEFAULTS","Reset audio, display, and accessibility.","RESET",function() confirm("Reset settings?","Restore the default values. Cancel keeps your current settings.",function() send("settings",{music=50,effects=70,damage=true,shake=true,large=false,motion=false,quality=3}) end,"No currency cost") end)
end
local function renderMechanic()
 heading(content,"ROOK / PIT MECHANIC")
 if state.job=="new" then
  note(content,"“Hey, racer. My power cell rolled under the garage lights. Bring it back and I’ll pay 400 credits and 10 shards.”")
  tabs(content,{"ACCEPT JOB","NO THANKS"},"ACCEPT JOB",function(v) if v=="ACCEPT JOB" then send("job","accept") else send("job","decline");closePanel(true) end end)
 elseif state.job=="active" then
  note(content,"“Look for the cyan orb beside the garage, west side of the pit. Pick it up, then come find me.”",palette.amber)
  textRow(content,"JOB / FIND REPAIR CELL","Walk to the glowing cyan orb and interact with it.","WALK PIT",function() walk=true;workspace.CurrentCamera.CameraType=Enum.CameraType.Custom;workspace.CurrentCamera.CameraSubject=p.Character and p.Character:FindFirstChildOfClass("Humanoid");closePanel(true) end)
 elseif state.job=="ready" then
  note(content,"“That’s the one! Bring it over here and we’ll square up.”")
  textRow(content,"DELIVER REPAIR CELL","Stand beside Rook's terminal in the east pit.","DELIVER",function() send("job","finish") end,palette.cyan)
 else note(content,"“You saved my shift. Thanks, racer. See you on the circuit!”",palette.cyan) end
 textRow(content,"END CONVERSATION","You can return to Rook later.","LEAVE",function() closePanel(true) end)
end
local function renderRace()
 if state.mode=="Test" then textRow(content,"PREVIEW DRIVE","Your chosen race kart was preserved.","EXIT TO HUB",function() send("exit");closePanel(true) end,palette.cyan);return end
 if state.phase=="Race" or state.phase=="Countdown" or state.phase=="Results" then
  note(content,state.phase=="Results" and "Race finished • rewards have been added." or "Race in progress • watch the road.",palette.cyan)
  textRow(content,"LIVE STANDINGS","Racer, lap, position, finish state.","OPEN BOARD",function() scoreboardOpen=true;closePanel(true) end)
  textRow(content,"RETURN TO HUB","Leaving before the finish forfeits rewards.","LEAVE RACE",function() confirm("Leave this race?","Return to the hub. Unfinished races do not earn rewards.",function() send("exit");closePanel(true) end) end);return
 end
 heading(content,"QUICK RACE / TWO LAPS")
 note(content,"4 racers • local rivals fill empty slots • real circuit checkpoints • finish to earn credits, shards and XP.")
 tabs(content,{"Solo","Duo"},state.queueMode,function(v) if not state.queued then send("queue",v) end end)
 if not state.queued then
  textRow(content,"READY TO RACE",find(C.Karts,state.kart).name.." / "..find(C.Drivers,state.driver).name,"JOIN SOLO",function() send("queue","Solo") end,palette.cyan)
 else
  textRow(content,"QUEUE JOINED / "..state.queueMode,"1 racer + 3 local rivals • required "..(state.queueMode=="Duo" and "2 (demo teammate ready)" or "1"),"LEAVE QUEUE",function() send("leaveQueue") end)
 end
 if state.phase=="Voting" then
  heading(content,"TRACK VOTE / CLOSES IN "..math.max(0,math.ceil(state.deadline-workspace:GetServerTimeNow())).."s")
  for i,t in ipairs(C.Tracks) do
   local n=0;for _,v in pairs(state.votes) do if v==i then n+=1 end end
   textRow(content,t.name,t.desc.." • "..n.." vote"..(n==1 and "" or "s"),state.votes[tostring(p.UserId)]==i and "YOUR VOTE" or "VOTE",function() send("vote",i) end,state.votes[tostring(p.UserId)]==i and palette.cyan or nil)
  end
 end
end
render=function()
 if not state or current=="" then return end
 local position=content.CanvasPosition
 clearContent();garageList=nil;partyList=nil
 panelTitle.Text=string.upper(current)
 panelSub.Text=({Garage="FIND YOUR CHASSIS / inspect, test and tune",Shop="PIT SUPPLY / all prices in credits",Inventory="YOUR LOADOUT / confirmed equipment",Drivers="THE PILOT ROSTER / own or rent",Livery="DESIGN LAB / your signature on the grid",Upgrades="ENGINEERING / permanent session improvements",Crates="PULSE COLLECTION / discover all twelve",Daily="DAILY SUPPLY / seven days to the big drop",Quests="PROGRESSION / every lap counts",Party="YOUR CREW / bring a wingmate",Settings="MAKE IT YOURS / accepted settings stay in this session",Race="RACE CONTROL / choose your next grid",Mechanic="A FAMILIAR FACE IN THE PIT",Codes="PIT RADIO / redeem a supply code"})[current] or ""
 local funcs={Garage=renderGarage,Shop=renderShop,Inventory=renderInventory,Drivers=renderDrivers,Livery=renderLivery,Upgrades=renderUpgrades,Crates=renderCrates,Daily=renderDaily,Codes=renderCodes,Quests=renderQuests,Party=renderParty,Settings=renderSettings,Mechanic=renderMechanic,Race=renderRace}
 if funcs[current] then funcs[current]() end
 content.CanvasPosition=position
 saveLabel.Text="CONFIRMED • session storage only"
 if state.settings.large then
  for _,v in ipairs(content:GetDescendants()) do if v:IsA("TextLabel") or v:IsA("TextButton") then v.TextSize=math.min(24,v.TextSize+2) end end
 end
end
closePanel=function(force)
 if not force and current=="Livery" and dirty then
  confirm("Leave unsaved design?","Discard restores your saved design. Cancel keeps your draft.",function() draft=table.clone(state.livery);dirty=false;closePanel(true) end,"Unsaved colors and decal will be discarded");return
 end
 panel.Visible=false;current="";if opener and opener.Parent and UIS.GamepadEnabled then GS.SelectedObject=opener end
end
openPanel=function(name)
 if current=="Livery" and dirty and name~="Livery" then confirm("Discard unsaved design?","Cancel keeps editing. Discard restores the saved design.",function() draft=table.clone(state.livery);dirty=false;openPanel(name) end,"No currency cost");return end
 current=name;panel.Visible=true;content.CanvasPosition=Vector2.zero;render();focusFirst(content)
end
