				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Queue, track voting, race simulation, lap tracking, results and rewards.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local KartBuilder = require(RS.Shared.KartBuilder)
local DataService = require(script.Parent.DataService)
local Remotes = RS:WaitForChild("Remotes")

local RaceService = {}

local HUB_SPAWN = CFrame.new(0, 4, 30)
local kartsFolder = Instance.new("Folder")
kartsFolder.Name = "Karts"
kartsFolder.Parent = workspace

local S: any = {
	phase = "idle", mode = "Solo", queue = {}, launchAt = nil,
	votes = {}, voteEnds = nil, winner = nil, track = nil,
	goAt = nil, racers = {}, feed = {}, raceId = 0, endAt = nil, resultsUntil = nil,
}
local testDrives: { [Player]: any } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function required(): number
	return S.mode == "Duo" and 2 or 1
end

local function queueCount(): (number, { string })
	local names = {}
	local n = 0
	for _, e in ipairs(S.queue) do
		n += 1
		table.insert(names, e.player.DisplayName)
		local prof = DataService.Profiles[e.player]
		if S.mode == "Duo" and prof then
			for id in pairs(prof.party.members) do
				for _, f in ipairs(Config.DemoFriends) do
					if f.id == id and n < 2 then n += 1; table.insert(names, f.name) end
				end
			end
		end
	end
	return n, names
end

local function publicRacers(): any
	local list = {}
	for _, r in ipairs(S.racers) do
		table.insert(list, {
			id = r.id, name = r.name, userId = r.userId, isAI = r.isAI, party = r.party,
			lap = math.clamp(r.lap, 1, Config.Laps), progress = r.cum, finished = r.finished, out = r.out,
			place = r.place, time = r.finishTime, kart = r.kart,
		})
	end
	return list
end

local function sortRacers()
	table.sort(S.racers, function(a, b)
		if a.finished ~= b.finished then return a.finished end
		if a.finished and b.finished then return a.finishOrder < b.finishOrder end
		if a.out ~= b.out then return not a.out end
		if a.cum ~= b.cum then return a.cum > b.cum end
		return a.name < b.name
	end)
	for i, r in ipairs(S.racers) do r.place = i end
end

function RaceService.Broadcast()
	local n, names = queueCount()
	local votesByVoter = {}
	for voter, t in pairs(S.votes) do votesByVoter[tostring(voter)] = t end
	Remotes.Race:FireAllClients({
		type = "state", phase = S.phase, mode = S.mode, joined = n, required = required(), names = names,
		queued = (function() local ids = {} for _, e in ipairs(S.queue) do table.insert(ids, e.player.UserId) end return ids end)(),
		launchAt = S.launchAt, voteEnds = S.voteEnds, votes = votesByVoter, winner = S.winner,
		track = S.track and S.track.id, goAt = S.goAt, laps = Config.Laps, racers = publicRacers(),
		feed = S.feed, raceId = S.raceId, endAt = S.endAt, resultsUntil = S.resultsUntil, serverNow = now(),
	})
end

local function inQueue(player: Player): number?
	for i, e in ipairs(S.queue) do if e.player == player then return i end end
	return nil
end

local function returnToHub(player: Player)
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if root then
		for _, w in ipairs(root:GetChildren()) do if w.Name == "KartWeld" then w:Destroy() end end
	end
	if hum then hum.Sit = false end
	task.wait(0.3)
	if char.Parent then char:PivotTo(HUB_SPAWN * CFrame.new(math.random(-8, 8), 0, math.random(-4, 4))) end
end

local function seatPlayer(player: Player, model: Model): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local body = model.PrimaryPart
	if not root or not hum or not body or hum.Health <= 0 then return false end
	local seat = model:FindFirstChild("DriverSeat") :: BasePart
	char:PivotTo(seat.CFrame * CFrame.new(0, 2.2, 0))
	local w = Instance.new("Weld")
	w.Name = "KartWeld"
	w.Part0 = body
	w.Part1 = root
	w.C0 = CFrame.new(0, 2.6, 1)
	w.Parent = root
	hum.Sit = true
	return true
end

local function spawnPlayerKart(player: Player, track: any, sampleIdx: number, lateral: number, kartOverride: string?): (Model?, any)
	local loadout = DataService.RaceLoadout(player)
	if kartOverride then
		local p = DataService.Profiles[player]
		loadout.kart = kartOverride
		loadout.stats = Config.ComputeStats(kartOverride, p.upgrades[kartOverride], p.equipped, p.selectedDriver)
	end
	local model = KartBuilder.Build(loadout.kart, loadout.livery, loadout.cosmetic, player.DisplayName)
	model.Name = "Kart_" .. player.UserId
	model:SetAttribute("Owner", player.UserId)
	local cf = Config.SampleCFrame(track, sampleIdx, lateral) * CFrame.new(0, 1.7, 0)
	model:PivotTo(cf)
	model.PrimaryPart.Anchored = true
	model.Parent = kartsFolder
	seatPlayer(player, model)
	return model, loadout
end

local function releaseKart(player: Player, model: Model)
	if not model.Parent then return end
	model.PrimaryPart.Anchored = false
	pcall(function() model.PrimaryPart:SetNetworkOwner(player) end)
end

local function addFeed(text: string)
	table.insert(S.feed, 1, { text = text, t = now() })
	while #S.feed > 5 do table.remove(S.feed) end
end

local function cleanupRace()
	for _, r in ipairs(S.racers) do
		if r.model then r.model:Destroy() end
		if r.player and r.player.Parent then
			Remotes.Race:FireClient(r.player, { type = "driveEnd" })
			task.spawn(returnToHub, r.player)
		end
	end
	S.racers = {}
end

local function resetToIdle()
	S.phase = "idle"
	S.queue = {}
	S.launchAt = nil
	S.votes = {}
	S.voteEnds = nil
	S.winner = nil
	S.track = nil
	S.goAt = nil
	S.endAt = nil
	S.resultsUntil = nil
	RaceService.Broadcast()
end

local function grantRewards()
	local results = {}
	for _, r in ipairs(S.racers) do
		table.insert(results, { name = r.name, place = r.place, out = r.out, finished = r.finished, time = r.finishTime, isAI = r.isAI, userId = r.userId })
	end
	for _, r in ipairs(S.racers) do
		if r.player and r.player.Parent and not r.rewarded then
			r.rewarded = true
			local p = DataService.Profiles[r.player]
			if p then
				local base = r.out and Config.OutReward or Config.PlaceRewards[r.place] or Config.OutReward
				local coinMult = ((p.perks.coin2x or 0) > os.time()) and 2 or 1
				local xpMult = ((p.perks.xp2x or 0) > os.time()) and 2 or 1
				local reward = { coins = base.coins * coinMult, gems = base.gems, xp = base.xp * xpMult }
				local levelBefore = p.level
				DataService.Grant(p, reward)
				p.races += 1
				p.stats.races += 1
				p.lastIncome = reward.coins
				if not r.out and r.place <= 3 then p.stats.podiums += 1 end
				if not r.out and r.place == 1 then p.wins += 1 end
				DataService.MarkDirty(r.player)
				Remotes.Race:FireClient(r.player, {
					type = "results", raceId = S.raceId, results = results, place = r.place, out = r.out,
					reward = reward, coinMult = coinMult, xpMult = xpMult, levelUp = p.level > levelBefore, level = p.level,
					track = S.track.name,
				})
			end
		end
	end
end

local function finishRace()
	if S.phase ~= "race" then return end
	for _, r in ipairs(S.racers) do
		if not r.finished and not r.out then
			r.out = true
			addFeed(r.name .. " is OUT · time expired")
		end
	end
	sortRacers()
	S.phase = "results"
	S.resultsUntil = now() + 10
	grantRewards()
	RaceService.Broadcast()
	task.delay(10, function()
		if S.phase == "results" then
			cleanupRace()
			resetToIdle()
		end
	end)
end

local function startRace()
	local track = S.track
	S.phase = "countdown"
	S.raceId += 1
	S.feed = {}
	S.racers = {}
	local n = #track.samples
	local slot = 0
	local function slotPos(k: number): (number, number)
		local row = math.floor(k / 2)
		local lateral = (k % 2 == 0) and -10 or 10
		return (n - 4 - row * 3 - 1) % n + 1, lateral
	end
	local humans = {}
	for _, e in ipairs(S.queue) do table.insert(humans, e.player) end
	for _, player in ipairs(humans) do
		if player.Parent then
			local idx, lat = slotPos(slot)
			slot += 1
			local model, loadout = spawnPlayerKart(player, track, idx, lat)
			if model then
				table.insert(S.racers, {
					id = "p" .. player.UserId, name = player.DisplayName, userId = player.UserId, player = player, isAI = false,
					model = model, stats = loadout.stats, kart = loadout.kart, sIdx = idx, cum = idx - n - 1, lap = 1,
					finished = false, out = false, lastPos = model.PrimaryPart.Position,
				})
				Remotes.Race:FireClient(player, { type = "driveStart", kart = model, stats = loadout.stats, track = track.id, goAt = now() + Config.CountdownSeconds + 1, mode = "race" })
			end
		end
	end
	-- party members fill duo slots, then AI fill the grid
	local fillNames = {}
	for _, player in ipairs(humans) do
		local p = DataService.Profiles[player]
		if p and S.mode == "Duo" then
			for id in pairs(p.party.members) do
				for _, f in ipairs(Config.DemoFriends) do if f.id == id then table.insert(fillNames, { name = f.name, party = true }) end end
			end
		end
	end
	local ai = table.clone(Config.AINames)
	for i = #ai, 2, -1 do local j = math.random(1, i); ai[i], ai[j] = ai[j], ai[i] end
	for _, nm in ipairs(ai) do table.insert(fillNames, { name = nm }) end
	local aiIndex = 0
	while #S.racers < Config.RacerCount and #fillNames > 0 do
		local info = table.remove(fillNames, 1)
		aiIndex += 1
		local idx, lat = slotPos(slot)
		slot += 1
		local kart = Config.Karts[math.random(1, #Config.Karts)]
		local sw = Config.Swatches[math.random(1, #Config.Swatches)].name
		local ac = Config.Swatches[math.random(1, #Config.Swatches)].name
		local model = KartBuilder.Build(kart.id, { body = sw, accent = ac, shade = 100, decal = Config.Decals[math.random(2, #Config.Decals)].id }, nil, info.name)
		model.Name = "AI_" .. aiIndex
		for _, d in ipairs(model:GetDescendants()) do if d:IsA("BasePart") then d.Anchored = true end end
		local cf = Config.SampleCFrame(track, idx, lat) * CFrame.new(0, 1.7, 0)
		model:PivotTo(cf)
		model.Parent = kartsFolder
		local skill = 0.8 + math.random() * 0.14
		table.insert(S.racers, {
			id = "ai" .. aiIndex, name = info.name, isAI = true, party = info.party, model = model, kart = kart.id,
			sIdx = idx, cum = idx - n - 1, lap = 1, finished = false, out = false,
			lateral = lat, targetLateral = lat, speed = 0, skill = skill, frac = 0,
			top = Config.Physics(Config.ComputeStats(kart.id, nil, nil, nil)).topSpeed * skill,
		})
	end
	S.goAt = now() + Config.CountdownSeconds + 1
	sortRacers()
	RaceService.Broadcast()
	task.delay(Config.CountdownSeconds + 1, function()
		if S.phase ~= "countdown" then return end
		S.phase = "race"
		S.endAt = now() + Config.RaceTimeLimit
		for _, r in ipairs(S.racers) do
			if r.player and r.model then releaseKart(r.player, r.model) end
		end
		RaceService.Broadcast()
	end)
end

local function beginVote()
	S.phase = "vote"
	S.votes = {}
	S.voteEnds = now() + Config.VoteSeconds
	RaceService.Broadcast()
	-- other participants (AI / party) vote at random moments
	for i = 1, 3 do
		task.delay(1 + math.random() * (Config.VoteSeconds - 3), function()
			if S.phase ~= "vote" then return end
			S.votes["ai" .. i] = Config.Tracks[math.random(1, #Config.Tracks)].id
			RaceService.Broadcast()
		end)
	end
	task.delay(Config.VoteSeconds, function()
		if S.phase ~= "vote" then return end
		local counts = {}
		for _, t in pairs(S.votes) do counts[t] = (counts[t] or 0) + 1 end
		local best, bestN = {}, -1
		for _, t in ipairs(Config.Tracks) do
			local c = counts[t.id] or 0
			if c > bestN then best, bestN = { t }, c elseif c == bestN then table.insert(best, t) end
		end
		S.track = best[math.random(1, #best)]
		S.winner = S.track.id
		S.phase = "locked"
		RaceService.Broadcast()
		task.delay(2.5, function()
			if S.phase == "locked" then startRace() end
		end)
	end)
end

local function checkLaunch()
	if S.phase ~= "queue" then return end
	local n = queueCount()
	if #S.queue == 0 then
		resetToIdle()
		return
	end
	if n >= required() then
		if not S.launchAt then
			S.launchAt = now() + Config.QueueLaunchDelay
			local token = S.launchAt
			task.delay(Config.QueueLaunchDelay, function()
				if S.phase == "queue" and S.launchAt == token then beginVote() end
			end)
		end
	else
		S.launchAt = nil
	end
	RaceService.Broadcast()
end

function RaceService.IsBusy(player: Player): boolean
	if testDrives[player] then return true end
	for _, r in ipairs(S.racers) do if r.player == player then return true end end
	return false
end

local A = DataService.Actions

A.QueueJoin = function(player, args)
	local mode = args.mode == "Duo" and "Duo" or "Solo"
	if testDrives[player] then return { ok = false, err = "Exit the test drive first" } end
	if S.phase ~= "idle" and S.phase ~= "queue" then return { ok = false, err = "A race is in progress · try again in a moment" } end
	if inQueue(player) then return { ok = false, err = "Already in queue" } end
	if S.phase == "queue" and S.mode ~= mode then return { ok = false, err = "Queue is open for " .. S.mode .. " right now" } end
	S.phase = "queue"
	S.mode = mode
	table.insert(S.queue, { player = player })
	checkLaunch()
	return { ok = true }
end

local function leave(player: Player, reason: string?): boolean
	local i = inQueue(player)
	if not i then return false end
	if S.phase == "queue" or S.phase == "vote" or S.phase == "locked" then
		table.remove(S.queue, i)
		S.votes[player.UserId] = nil
		if S.phase ~= "queue" then
			-- someone left before start: cancel this launch
			S.phase = "queue"
			S.voteEnds = nil
			S.winner = nil
			S.track = nil
			S.votes = {}
			S.launchAt = nil
			for _, e in ipairs(S.queue) do
				Remotes.Notify:FireClient(e.player, { text = player.DisplayName .. " left · launch cancelled", kind = "warn" })
			end
		end
		checkLaunch()
		return true
	end
	return false
end

A.QueueLeave = function(player)
	if leave(player) then return { ok = true } end
	return { ok = false, err = "The race has already started" }
end

A.Vote = function(player, args)
	if S.phase ~= "vote" then return { ok = false, err = "Voting is closed" } end
	if not inQueue(player) then return { ok = false, err = "Join the race to vote" } end
	if not Config.GetTrack(args.track) or args.track == "test" then return { ok = false, err = "Unknown track" } end
	S.votes[player.UserId] = args.track
	RaceService.Broadcast()
	return { ok = true }
end

A.DriftBoost = function(player)
	for _, r in ipairs(S.racers) do
		if r.player == player and S.phase == "race" then
			r.drifts = (r.drifts or 0) + 1
			if r.drifts <= 40 then
				local p = DataService.Profiles[player]
				p.stats.driftBoosts += 1
				DataService.MarkDirty(player)
			end
		end
	end
	return { ok = true }
end

A.TestDrive = function(player, args)
	if RaceService.IsBusy(player) or inQueue(player) then return { ok = false, err = "Finish your race or leave the queue first" } end
	if not Config.GetKart(args.kart) then return { ok = false, err = "Unknown kart" } end
	local track = Config.TestTrack
	local model, loadout = spawnPlayerKart(player, track, 1, 0, args.kart)
	if not model then return { ok = false, err = "Character not ready" } end
	testDrives[player] = { model = model }
	releaseKart(player, model)
	Remotes.Race:FireClient(player, { type = "driveStart", kart = model, stats = loadout.stats, track = "test", goAt = now(), mode = "test" })
	return { ok = true }
end

A.ExitTestDrive = function(player)
	local td = testDrives[player]
	if not td then return { ok = false, err = "Not test driving" } end
	testDrives[player] = nil
	td.model:Destroy()
	Remotes.Race:FireClient(player, { type = "driveEnd" })
	task.spawn(returnToHub, player)
	return { ok = true }
end

-- quick chat with a server cooldown
local lastChat: { [Player]: number } = {}
A.Chat = function(player, args)
	local i = tonumber(args.index)
	if not i or not Config.QuickChat[i] then return { ok = false, err = "Unknown message" } end
	local t = os.clock()
	local last = lastChat[player] or -100
	if t - last < Config.ChatCooldown then
		return { ok = false, err = "Cooldown", retry = Config.ChatCooldown - (t - last) }
	end
	lastChat[player] = t
	Remotes.Chat:FireAllClients({ name = player.DisplayName, userId = player.UserId, text = Config.QuickChat[i] })
	return { ok = true, cooldown = Config.ChatCooldown }
end

-- simulation
local accum = 0
RunService.Heartbeat:Connect(function(dt)
	local track = S.track
	if (S.phase == "race" or S.phase == "results") and track then
		local n = #track.samples
		for _, r in ipairs(S.racers) do
			if r.isAI and r.model and r.model.Parent and S.phase == "race" then
				-- AI drives along the racing line with slight weaving
				local stopped = r.finished or r.out
				local target = stopped and r.top * 0.4 or r.top
				r.speed += math.clamp(target - r.speed, -40 * dt, 30 * dt)
				local a = track.samples[r.sIdx]
				local b = track.samples[r.sIdx % n + 1]
				local segLen = (b - a).Magnitude
				r.frac += r.speed * dt / math.max(segLen, 0.1)
				while r.frac >= 1 do
					r.frac -= 1
					r.sIdx = r.sIdx % n + 1
					r.cum += 1
					if math.random() < 0.02 then r.targetLateral = math.random(-14, 14) end
				end
				r.lateral += math.clamp(r.targetLateral - r.lateral, -6 * dt, 6 * dt)
				local a2 = track.samples[r.sIdx]
				local b2 = track.samples[r.sIdx % n + 1]
				local c2 = track.samples[(r.sIdx + 1) % n + 1]
				local pos = a2:Lerp(b2, r.frac)
				local look = b2:Lerp(c2, r.frac)
				local cf = CFrame.lookAt(pos, Vector3.new(look.X, pos.Y, look.Z)) * CFrame.new(r.lateral, 1.7, 0)
				r.model:PivotTo(cf)
			end
		end
	end
	accum += dt
	if accum < 0.1 then return end
	local step = accum
	accum = 0
	if S.phase ~= "race" or not track then return end
	local n = #track.samples
	for _, r in ipairs(S.racers) do
		if not r.isAI and r.model and r.model.PrimaryPart and not r.finished and not r.out then
			local pos = r.model.PrimaryPart.Position
			local moved = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(r.lastPos.X, 0, r.lastPos.Z)).Magnitude
			local phys = Config.Physics(r.stats)
			if moved > phys.topSpeed * phys.boostMult * step * 1.8 + 25 then
				-- implausible jump: ignore this sample for progress
				r.lastPos = pos
				continue
			end
			r.lastPos = pos
			local idx = Config.NearestSample(track, pos, r.sIdx, 12)
			local delta = idx - r.sIdx
			if delta < -n / 2 then delta += n elseif delta > n / 2 then delta -= n end
			r.sIdx = idx
			r.cum += delta
		end
		if not r.finished and not r.out then
			r.lap = math.floor(math.max(r.cum, 0) / n) + 1
			if r.cum >= Config.Laps * n then
				r.finished = true
				S.finishCount = (S.finishCount or 0) + 1
				r.finishOrder = S.finishCount
				r.finishTime = now() - S.goAt
				r.lap = Config.Laps
				if r.player then
					Remotes.Race:FireClient(r.player, { type = "finished", place = r.finishOrder, time = r.finishTime })
				end
			end
		end
	end
	sortRacers()
	-- end conditions
	local humansLeft = 0
	local humans = 0
	for _, r in ipairs(S.racers) do
		if not r.isAI then
			humans += 1
			if not r.finished and not r.out then humansLeft += 1 end
		end
	end
	if humans == 0 then
		finishRace()
		return
	end
	if humansLeft == 0 and not S.graceAt then
		S.graceAt = now() + Config.FinishGrace
		S.endAt = math.min(S.endAt, S.graceAt)
	end
	local allDone = true
	for _, r in ipairs(S.racers) do if not r.finished and not r.out then allDone = false end end
	if allDone or now() >= S.endAt then
		finishRace()
		return
	end
	RaceService.Broadcast()
end)

local oldStart = startRace
startRace = function()
	S.finishCount = 0
	S.graceAt = nil
	oldStart()
end

Players.PlayerRemoving:Connect(function(player)
	leave(player)
	local td = testDrives[player]
	if td then td.model:Destroy(); testDrives[player] = nil end
	for _, r in ipairs(S.racers) do
		if r.player == player then
			r.player = nil
			if not r.finished and not r.out then
				r.out = true
				addFeed(r.name .. " is OUT · left the race")
			end
			if r.model then r.model:Destroy(); r.model = nil end
		end
	end
	lastChat[player] = nil
	if S.phase == "countdown" or S.phase == "race" then RaceService.Broadcast() end
end)

function RaceService.OnCharacter(player: Player)
	-- a player who respawns mid-race is put back in their kart
	for _, r in ipairs(S.racers) do
		if r.player == player and r.model and r.model.Parent then
			task.wait(0.2)
			seatPlayer(player, r.model)
			Remotes.Race:FireClient(player, { type = "driveStart", kart = r.model, stats = r.stats, track = S.track.id, goAt = S.goAt, mode = "race" })
		end
	end
	local td = testDrives[player]
	if td then
		td.model:Destroy()
		testDrives[player] = nil
		Remotes.Race:FireClient(player, { type = "driveEnd" })
	end
end

return RaceService
