					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Local kart driving, chase camera, race HUD, standings, results and garage preview drive.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local Track = require(RS.Shared.Track)
local KartBuilder = require(RS.Shared.KartBuilder)
local UI = require(script.Parent.UI)
local Store = require(script.Parent.Store)
local Net = RS:WaitForChild("Net")
local RNotice = Net:WaitForChild("Notice") :: RemoteEvent
local RSnapshot = Net:WaitForChild("Snapshot") :: UnreliableRemoteEvent
local RDrive = Net:WaitForChild("Drive") :: UnreliableRemoteEvent
local RDriveEvent = Net:WaitForChild("DriveEvent") :: RemoteEvent
local T = UI.T

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local MoveAction = (game:GetService("StarterPlayer") :: any):WaitForChild("PlayerModule"):WaitForChild("InputContexts"):WaitForChild("CharacterContext"):WaitForChild("MoveAction")

local RaceClient = {}
RaceClient.active = false
RaceClient.preview = false
RaceClient.onExit = Instance.new("BindableEvent")

local kartsFolder = Instance.new("Folder")
kartsFolder.Name = "LocalKarts"
kartsFolder.Parent = workspace

-- State -------------------------------------------------------------------
local pts: { Vector3 } = Track.Points("neon_loop")
local me = { pos = Vector3.zero, yaw = 0, speed = 0, idx = 1, drifting = false, driftDir = 0, driftCharge = 0, boostUntil = 0, ready = false, model = nil :: Model?, phys = nil :: any }
local others: { [string]: { model: Model, target: CFrame, speed: number, boost: boolean } } = {}
local held = { drift = false, gas = false, brake = false }
local camMode = 1
local CAM_MODES = { "Chase", "Far", "Low" }
local shake = 0
local sendAcc = 0
local raceId = -1
local myKey = "p" .. player.UserId
local currentRacers: { any } = {}
local finishedShown = false

-- HUD ---------------------------------------------------------------------
local hud = UI.frame(UI.gui, { Name = "RaceHud", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 5 })
RaceClient.hud = hud
local topBox = UI.frame(hud, { BackgroundColor3 = T.panel, BackgroundTransparency = 0.2, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.fromOffset(300, 64), ZIndex = 5 })
UI.corner(topBox, 14)
UI.stroke(topBox, T.cyan, 1.5, 0.3)
local posL = UI.label(topBox, "1st", 30, { Font = UI.Title, Size = UDim2.new(0.45, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, TextColor3 = T.cyan, ZIndex = 6 })
local lapL = UI.label(topBox, "LAP 1/3", 18, { Font = UI.Title, Position = UDim2.fromScale(0.45, 0.1), Size = UDim2.new(0.55, -8, 0.45, 0), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 6 })
local timeL = UI.label(topBox, "0:00", 14, { Position = UDim2.fromScale(0.45, 0.55), Size = UDim2.new(0.55, -8, 0.35, 0), AutomaticSize = Enum.AutomaticSize.None, TextColor3 = T.dim, ZIndex = 6 })
local progBg = UI.frame(topBox, { BackgroundColor3 = T.card2, Position = UDim2.new(0, 10, 1, -6), Size = UDim2.new(1, -20, 0, 3), ZIndex = 6 })
local progFill = UI.frame(progBg, { BackgroundColor3 = T.magenta, Size = UDim2.fromScale(0, 1), ZIndex = 7 })

local speedBox = UI.frame(hud, { BackgroundColor3 = T.panel, BackgroundTransparency = 0.25, Size = UDim2.fromOffset(190, 74), ZIndex = 5 })
UI.corner(speedBox, 12)
UI.stroke(speedBox, T.magenta, 1.5, 0.3)
local speedL = UI.label(speedBox, "0", 28, { Font = UI.Bold, Position = UDim2.fromOffset(12, 4), Size = UDim2.fromOffset(100, 36), AutomaticSize = Enum.AutomaticSize.None, ZIndex = 6 })
UI.label(speedBox, "KM/H", 11, { Position = UDim2.fromOffset(112, 16), Size = UDim2.fromOffset(60, 16), AutomaticSize = Enum.AutomaticSize.None, TextColor3 = T.dim, ZIndex = 6, Font = UI.Bold })
local nitroL = UI.label(speedBox, "NITRO ×1", 13, { Position = UDim2.fromOffset(12, 40), Size = UDim2.fromOffset(90, 16), AutomaticSize = Enum.AutomaticSize.None, TextColor3 = T.cyan, Font = UI.Bold, ZIndex = 6 })
local driftBg = UI.frame(speedBox, { BackgroundColor3 = T.card2, Position = UDim2.fromOffset(12, 60), Size = UDim2.new(1, -24, 0, 6), ZIndex = 6 })
UI.corner(driftBg, 3)
local driftFill = UI.frame(driftBg, { BackgroundColor3 = T.amber, Size = UDim2.fromScale(0, 1), ZIndex = 7 })
UI.corner(driftFill, 3)
UI.label(speedBox, "DRIFT", 11, { Position = UDim2.fromOffset(110, 42), Size = UDim2.fromOffset(60, 14), AutomaticSize = Enum.AutomaticSize.None, TextColor3 = T.amber, Font = UI.Bold, ZIndex = 6, TextXAlignment = Enum.TextXAlignment.Right })

local feedBox = UI.frame(hud, { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(250, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 5 })
UI.list(feedBox, false, 4, Enum.HorizontalAlignment.Right)

local center = UI.label(hud, "", 64, { Font = UI.Title, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.33), Size = UDim2.fromOffset(600, 90), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = T.cyan, ZIndex = 8, TextStrokeTransparency = 0.4 })
local hint = UI.label(hud, "", 14, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.fromOffset(700, 20), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = T.dim, ZIndex = 5, TextStrokeTransparency = 0.6 })

-- Standings ---------------------------------------------------------------
local board = UI.frame(hud, { Name = "Standings", BackgroundColor3 = T.panel, BackgroundTransparency = 0.12, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(300, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 9 })
UI.corner(board, 12)
UI.stroke(board, T.cyan, 1.5, 0.2)
UI.pad(board, 8, 10)
UI.list(board, false, 4)
UI.label(board, "STANDINGS", 14, { Font = UI.Title, ZIndex = 10, LayoutOrder = 0, TextColor3 = T.cyan })
local boardRows = UI.frame(board, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 10, LayoutOrder = 1 })
UI.list(boardRows, false, 4)
RaceClient.board = board

local function renderBoard()
	for _, c in boardRows:GetChildren() do if c:IsA("Frame") then c:Destroy() end end
	for _, r in currentRacers do
		local mine = r.key == myKey
		local row = UI.frame(boardRows, { BackgroundColor3 = if mine then Color3.fromRGB(16, 60, 80) else T.card, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = r.place, ZIndex = 10 })
		UI.corner(row, 8)
		if mine then UI.stroke(row, T.cyan, 2) end
		UI.label(row, tostring(r.place), 18, { Font = UI.Title, Position = UDim2.fromOffset(6, 0), Size = UDim2.fromOffset(26, 40), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 11, TextColor3 = if r.place == 1 then T.amber else T.text })
		local pf = UI.portrait(row, r.userId, r.name, 30, if r.isAI then T.magenta else T.cyan)
		pf.Position = UDim2.fromOffset(36, 5)
		pf.ZIndex = 11
		for _, d in pf:GetDescendants() do if d:IsA("GuiObject") then d.ZIndex = 12 end end
		UI.label(row, r.name .. (if mine then "  (YOU)" else ""), 14, { Font = UI.Bold, Position = UDim2.fromOffset(74, 0), Size = UDim2.new(1, -160, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, ZIndex = 11 })
		local status = if r.out then "OUT" elseif r.finished then "FINISHED" else "LAP " .. r.lap
		UI.label(row, status, 12, { Font = UI.Bold, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 0), Size = UDim2.fromOffset(80, 40), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 11,
			TextColor3 = if r.out then T.red elseif r.finished then T.green else T.dim })
	end
end

function RaceClient.toggleBoard(force: boolean?)
	if force ~= nil then board.Visible = force else board.Visible = not board.Visible end
	UI.sfx("tick")
end

-- Touch / clickable race controls ------------------------------------------
local ctl = UI.frame(hud, { Name = "Controls", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.45, 0), Size = UDim2.fromOffset(150, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 6 })
local ctlGrid = UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(70, 54), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right }, ctl)
local function ctlButton(text: string, order: number, color: Color3?): TextButton
	local b = UI.button(ctl, text, { LayoutOrder = order, TextSize = 13, ZIndex = 7, BackgroundTransparency = 0.15 })
	if color then b:SetAttribute("StrokeColor", color) local st = b:FindFirstChildOfClass("UIStroke") if st then st.Color = color st.Thickness = 2 end end
	return b
end
local driftBtn = ctlButton("DRIFT", 1, T.amber)
local nitroBtn = ctlButton("NITRO", 2, T.cyan)
local boardBtn = ctlButton("STANDINGS", 3)
local chatBtn = ctlButton("CHAT", 4, T.magenta)
local resetBtn = ctlButton("RESET", 5)
local camBtn = ctlButton("CAMERA", 6)
local exitBtn = UI.button(hud, "EXIT PREVIEW", { AnchorPoint = Vector2.new(0, 0), Position = UDim2.new(0, 10, 0, 8), Size = UDim2.fromOffset(170, 46), TextSize = 15, ZIndex = 7, Visible = false })
UI.style(exitBtn, "danger")
RaceClient.chatButton = chatBtn
RaceClient.openChat = function(_: GuiObject?) end

driftBtn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then held.drift = true end end)
driftBtn.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then held.drift = false end end)

local function layout()
	local touch = UI.touch()
	local size = UI.size()
	local portrait = size.Y > size.X
	ctl.Visible = true
	driftBtn.Visible = touch
	if touch then
		ctl.Position = UDim2.new(1, -10, if portrait then 0.5 else 0.42, 0)
		speedBox.AnchorPoint = Vector2.new(0, 0)
		speedBox.Position = UDim2.new(0, 10, 0, if portrait then 76 else 8)
		board.AnchorPoint = Vector2.new(0.5, 0)
		board.Position = UDim2.new(0.5, 0, 0, 74)
		hint.Visible = false
	else
		ctl.Position = UDim2.new(1, -10, 1, -10)
		ctl.AnchorPoint = Vector2.new(1, 1)
		speedBox.AnchorPoint = Vector2.new(0, 1)
		speedBox.Position = UDim2.new(0, 10, 1, -10)
		board.AnchorPoint = Vector2.new(1, 0.5)
		board.Position = UDim2.new(1, -10, 0.45, 0)
		hint.Visible = size.X > 900
	end
	if touch then ctl.AnchorPoint = Vector2.new(1, 0.5) end
	board.Size = UDim2.fromOffset(math.min(300, size.X - 20), 0)
	topBox.Position = UDim2.new(0.5, 0, 0, 4)
	center.Size = UDim2.fromOffset(math.min(600, size.X - 20), 90)
	hint.Size = UDim2.fromOffset(math.min(900, size.X - 20), 20)
end
UI.layoutChanged.Event:Connect(layout)
task.defer(layout)

-- Floating numbers ----------------------------------------------------------
local function floatText(text: string, color: Color3)
	local p = Store.profile
	if p and not p.settings.damageNumbers then return end
	local model = me.model
	if not model or not model.PrimaryPart then return end
	local bb = UI.new("BillboardGui", { Size = UDim2.fromOffset(160, 40), StudsOffset = Vector3.new(math.random(-2, 2), 5, 0), AlwaysOnTop = true, Adornee = model.PrimaryPart }, model.PrimaryPart)
	local l = UI.label(bb, text, 22, { Font = UI.Title, Size = UDim2.fromScale(1, 1), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = color, TextStrokeTransparency = 0.3 })
	if not UI.reducedMotion() then
		UI.tween(bb, { StudsOffset = bb.StudsOffset + Vector3.new(0, 4, 0) }, 0.8)
		UI.tween(l, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.9)
	end
	task.delay(0.9, function() bb:Destroy() end)
end

-- Karts ---------------------------------------------------------------------
local function clearKarts()
	for _, c in kartsFolder:GetChildren() do c:Destroy() end
	others = {}
	me.model = nil
end

local function myPhys(kartId: string): any
	local p = Store.profile
	if not p then return Config.KartPhysics(kartId) end
	local parts = {}
	for _, slot in Config.PartSlots do
		local id = p.equipped[slot]
		if id ~= "" and p.parts[id] then table.insert(parts, id) end
	end
	return Config.KartPhysics(kartId, p.upgrades[kartId], parts, p.driver)
end

local function cosmeticOf(): string
	local p = Store.profile
	if not p then return "" end
	local id = p.equipped.cosmetic
	local def = id ~= "" and Config.FindById(Config.Parts, id)
	return if def and def.look then def.look else ""
end

local function setupRace(state: any)
	clearKarts()
	pts = Track.Points(state.trackId)
	for _, r in state.racers do
		local model = KartBuilder.Build(r.kart, r.livery, r.cosmetic)
		model.Name = r.key
		if r.key ~= myKey then
			local tag = UI.new("BillboardGui", { Size = UDim2.fromOffset(140, 26), StudsOffset = Vector3.new(0, 5, 0), MaxDistance = 160, AlwaysOnTop = false }, model.PrimaryPart)
			UI.label(tag, r.name, 14, { Font = UI.Bold, Size = UDim2.fromScale(1, 1), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, TextColor3 = if r.isAI then T.magenta else T.cyan })
			others[r.key] = { model = model, target = CFrame.new(), speed = 0, boost = false }
		else
			me.model = model
			me.phys = myPhys(r.kart)
		end
		model.Parent = kartsFolder
	end
	me.ready = false
	me.speed = 0
	me.boostUntil = 0
	me.drifting = false
	me.driftCharge = 0
	finishedShown = false
end

-- Input ---------------------------------------------------------------------
local function axis(): (number, number)
	local ok, v = pcall(function() return MoveAction:GetState() end)
	local steer, thr = 0, 0
	if ok and typeof(v) == "Vector2" then steer, thr = v.X, v.Y end
	if UIS:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonR2) then thr = 1 end
	if UIS:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL2) then thr = -1 end
	if UIS:IsKeyDown(Enum.KeyCode.Up) then thr = 1 elseif UIS:IsKeyDown(Enum.KeyCode.Down) then thr = -1 end
	if UIS:IsKeyDown(Enum.KeyCode.Left) then steer = -1 elseif UIS:IsKeyDown(Enum.KeyCode.Right) then steer = 1 end
	return math.clamp(steer, -1, 1), math.clamp(thr, -1, 1)
end

local function driftDown(): boolean
	return held.drift or UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.Space)
		or UIS:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonR1)
		or UIS:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL1)
end

local function canDrive(): boolean
	if RaceClient.preview then return true end
	local s = Store.lobby
	if not s or s.phase ~= "racing" then return false end
	for _, r in s.racers do
		if r.key == myKey then return not r.finished and not r.out end
	end
	return false
end

local function useNitro()
	if not canDrive() then return end
	if RaceClient.preview then
		me.boostUntil = os.clock() + 2
		floatText("NITRO!", T.cyan)
		return
	end
	RDriveEvent:FireServer("nitro")
end

local function resetKart()
	if RaceClient.preview then
		local idx = me.idx
		me.pos = pts[idx]
		me.yaw = Track.Yaw(Track.Direction(pts, idx))
		me.speed = 0
		return
	end
	if canDrive() then RDriveEvent:FireServer("reset") end
end

local function cycleCam()
	camMode = camMode % #CAM_MODES + 1
	UI.toast("Camera: " .. CAM_MODES[camMode])
end

nitroBtn.Activated:Connect(useNitro)
resetBtn.Activated:Connect(resetKart)
camBtn.Activated:Connect(cycleCam)
boardBtn.Activated:Connect(function() RaceClient.toggleBoard() end)
chatBtn.Activated:Connect(function() RaceClient.openChat(chatBtn) end)

UIS.InputBegan:Connect(function(input, processed)
	if not RaceClient.active then return end
	if UI.dialogOpen then return end
	local k = input.KeyCode
	if processed and input.UserInputType == Enum.UserInputType.Keyboard then return end
	if k == Enum.KeyCode.E or k == Enum.KeyCode.ButtonX then useNitro()
	elseif k == Enum.KeyCode.R or k == Enum.KeyCode.DPadDown then resetKart()
	elseif k == Enum.KeyCode.C or k == Enum.KeyCode.DPadRight then cycleCam()
	elseif k == Enum.KeyCode.L or k == Enum.KeyCode.DPadUp then
		if not RaceClient.preview then RaceClient.toggleBoard() end
	end
end)

-- Driving simulation ---------------------------------------------------------
local function clockNow(): number
	return if RaceClient.preview then os.clock() else Store.now()
end

local function stepMe(dt: number)
	local phys = me.phys
	if not phys or not me.model then return end
	local steer, thr = axis()
	local driving = canDrive()
	if not driving then
		steer, thr = 0, 0
	end
	local boosting = clockNow() < me.boostUntil
	local maxS = phys.maxSpeed * (if boosting then phys.boostMul else 1)
	if thr > 0 then
		me.speed = math.min(me.speed + phys.accel * thr * dt * (if boosting then 1.8 else 1), math.max(maxS, me.speed))
	elseif thr < 0 then
		if me.speed > 0 then me.speed = math.max(me.speed - 90 * -thr * dt, 0) else me.speed = math.max(me.speed - 25 * dt, -25) end
	else
		me.speed -= math.sign(me.speed) * math.min(math.abs(me.speed), 16 * dt)
	end
	if me.speed > maxS then me.speed = math.max(maxS, me.speed - 45 * dt) end
	if boosting and thr >= 0 and driving then me.speed = math.min(me.speed + 30 * dt, maxS) end

	local wantDrift = driving and driftDown() and math.abs(steer) > 0.25 and me.speed > 30
	if wantDrift and not me.drifting then
		me.drifting = true
		me.driftDir = math.sign(steer)
		me.driftCharge = 0
	end
	if me.drifting and (not driftDown() or me.speed < 18 or not driving) then
		me.drifting = false
		if me.driftCharge > 0.9 then
			local strength = math.min(me.driftCharge, 2.5)
			me.boostUntil = math.max(me.boostUntil, clockNow() + 0.5 + strength * 0.35)
			floatText(if strength > 1.8 then "MEGA BOOST!" else "DRIFT BOOST!", T.amber)
			UI.sfx("whoosh", 1.2)
			if not RaceClient.preview then RDriveEvent:FireServer("drift") end
		end
		me.driftCharge = 0
	end
	local turnRate = phys.turn * math.clamp(math.abs(me.speed) / 25, 0, 1) * (if me.speed >= 0 then 1 else -1)
	if me.drifting then
		local s = me.driftDir * (0.6 + 0.5 * math.clamp(steer * me.driftDir, -1, 1))
		me.yaw -= s * turnRate * 1.3 * dt
		me.driftCharge += dt * (0.6 + 0.6 * math.abs(steer))
		me.speed *= (1 - 0.06 * dt)
	else
		me.yaw -= steer * turnRate * dt
	end
	local moveYaw = if me.drifting then me.yaw + me.driftDir * 0.28 else me.yaw
	local newPos = me.pos + CFrame.Angles(0, moveYaw, 0).LookVector * me.speed * dt
	local idx, _, lateral, centerP = Track.Project(pts, newPos, me.idx, 6)
	me.idx = idx
	local limit = Track.HalfWidth - 2.6
	if math.abs(lateral) > limit then
		newPos = centerP + Track.Right(pts, idx) * math.sign(lateral) * limit
		local impact = math.abs(me.speed)
		if impact > 25 then
			floatText("-" .. math.floor(impact * 0.4), T.red)
			local p = Store.profile
			if p and p.settings.cameraShake and not UI.reducedMotion() then shake = math.min(1, impact / 80) end
			UI.sfx("snap", 0.8)
		end
		me.speed *= 0.6
		me.drifting = false
	end
	me.pos = Vector3.new(newPos.X, Track.RoadY, newPos.Z)
	me.model:SetAttribute("Speed", me.speed)
	me.model:SetAttribute("Lateral", lateral)
	me.model:SetAttribute("Driving", driving)
	local tilt = if me.drifting then CFrame.Angles(0, me.driftDir * -0.25, me.driftDir * 0.06) else CFrame.new()
	;(me.model.PrimaryPart :: BasePart).CFrame = CFrame.new(me.pos) * CFrame.Angles(0, me.yaw, 0) * tilt
	KartBuilder.SetFlame(me.model, if boosting then 1 elseif me.drifting then 0.3 else 0)

	speedL.Text = tostring(math.floor(math.abs(me.speed) * 1.6))
	driftFill.Size = UDim2.fromScale(math.clamp(me.driftCharge / 2.5, 0, 1), 1)
	driftFill.BackgroundColor3 = if me.driftCharge > 1.8 then T.magenta elseif me.driftCharge > 0.9 then T.amber else T.dim

	if not RaceClient.preview and driving then
		sendAcc += dt
		if sendAcc >= 1 / 15 then
			sendAcc = 0
			RDrive:FireServer(me.pos.X, me.pos.Z, me.yaw, me.speed)
		end
	end
end

local function stepCamera(dt: number)
	local model = me.model
	if not model or not model.PrimaryPart then return end
	local cf = CFrame.new(me.pos) * CFrame.Angles(0, me.yaw, 0)
	local mode = CAM_MODES[camMode]
	local back, up, look = 17, 7, 12
	if mode == "Far" then back, up, look = 28, 13, 16 elseif mode == "Low" then back, up, look = 10, 3.6, 20 end
	local goal = CFrame.lookAt((cf * CFrame.new(0, up, back)).Position, (cf * CFrame.new(0, 2, -look)).Position)
	local alpha = 1 - math.exp(-dt * 8)
	local c = camera.CFrame:Lerp(goal, alpha)
	if shake > 0 then
		c *= CFrame.new((math.random() - 0.5) * shake, (math.random() - 0.5) * shake, 0)
		shake = math.max(0, shake - dt * 3)
	end
	camera.CFrame = c
	local fovGoal = 70 + (if UI.reducedMotion() then 0 else math.clamp(math.abs(me.speed) / 12, 0, 14))
	camera.FieldOfView += (fovGoal - camera.FieldOfView) * alpha
end

local function stepOthers(dt: number)
	local alpha = 1 - math.exp(-dt * 14)
	for _, o in others do
		local root = o.model.PrimaryPart :: BasePart
		local predicted = o.target + o.target.LookVector * o.speed * dt
		o.target = predicted
		root.CFrame = root.CFrame:Lerp(predicted, alpha)
		KartBuilder.SetFlame(o.model, if o.boost then 1 else 0)
	end
end

RSnapshot.OnClientEvent:Connect(function(_t, list)
	if not RaceClient.active or RaceClient.preview then return end
	for _, e in list do
		local key, x, z, yaw, speed, boost = e[1], e[2], e[3], e[4], e[5], e[6]
		if key == myKey then
			if not me.ready then
				me.pos = Vector3.new(x, Track.RoadY, z)
				me.yaw = yaw
				me.idx = Track.Project(pts, me.pos)
				me.ready = true
				if me.model then (me.model.PrimaryPart :: BasePart).CFrame = CFrame.new(me.pos) * CFrame.Angles(0, yaw, 0) end
			end
		else
			local o = others[key]
			if o then
				local cf = CFrame.new(x, Track.RoadY, z) * CFrame.Angles(0, yaw, 0)
				if o.target == CFrame.new() then (o.model.PrimaryPart :: BasePart).CFrame = cf end
				o.target = cf
				o.speed = speed
				o.boost = boost
			end
		end
	end
end)

RNotice.OnClientEvent:Connect(function(kind, data)
	if kind == "correct" and RaceClient.active and not RaceClient.preview then
		if me.model then me.model:SetAttribute("Corrections", (me.model:GetAttribute("Corrections") or 0) + 1) end
		me.pos = Vector3.new(data.x, Track.RoadY, data.z)
		me.yaw = data.yaw
		me.speed = data.speed
		me.idx = Track.Project(pts, me.pos)
		me.drifting = false
	elseif kind == "nitro" then
		if data.ok then
			me.boostUntil = Store.now() + 2
			floatText("NITRO!", T.cyan)
			UI.sfx("whoosh", 0.9)
		else
			UI.toast("No nitro charges left", "warn")
		end
		nitroL.Text = "NITRO ×" .. data.left
	elseif kind == "out" then
		center.Text = "KNOCKED OUT"
		center.TextColor3 = T.red
		task.delay(2.5, function() if center.Text == "KNOCKED OUT" then center.Text = "" end end)
	end
end)

RunService:BindToRenderStep("NeonKart", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if not RaceClient.active then return end
	if camera.CameraType ~= Enum.CameraType.Scriptable then camera.CameraType = Enum.CameraType.Scriptable end
	dt = math.min(dt, 1 / 20)
	if me.ready or RaceClient.preview then stepMe(dt) end
	stepOthers(dt)
	stepCamera(dt)
	if not RaceClient.preview then
		local s = Store.lobby
		if s and (s.phase == "countdown" or s.phase == "racing") then
			local left = s.startAt - Store.now()
			if s.phase == "countdown" or left > -1.2 then
				local txt = if left > 3 then "READY" elseif left > 0 then tostring(math.ceil(left)) else "GO!"
				if center.Text ~= txt and not finishedShown then
					center.Text = txt
					center.TextColor3 = if txt == "GO!" then T.green else T.cyan
					UI.sfx("tick", if txt == "GO!" then 1.6 else 1)
				end
			elseif center.Text == "GO!" then
				center.Text = ""
			end
			if s.phase == "racing" then timeL.Text = Config.Clock(Store.now() - s.startAt) end
		end
		progFill.Size = UDim2.fromScale(math.clamp((me.idx - 1) / Track.N, 0, 1), 1)
	end
end)

-- Lobby updates --------------------------------------------------------------
local function myRacer(s: any): any
	for _, r in s.racers do if r.key == myKey then return r end end
	return nil
end

local function enter()
	RaceClient.active = true
	hud.Visible = true
	camera.CameraType = Enum.CameraType.Scriptable
	Store.setMode(if RaceClient.preview then "preview" else "race")
	board.Visible = UI.size().X > 1100 and not RaceClient.preview
	boardBtn.Visible = not RaceClient.preview
	chatBtn.Visible = true
	topBox.Visible = not RaceClient.preview
	exitBtn.Visible = RaceClient.preview
	hint.Text = "W/S or triggers: drive · A/D steer · Shift/Space/R1: drift · E/X: nitro · R/DPad↓: reset · C: camera · L/DPad↑: standings · Q/Y: chat"
	layout()
end

local function exit()
	RaceClient.active = false
	RaceClient.preview = false
	hud.Visible = false
	center.Text = ""
	clearKarts()
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 70
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then camera.CameraSubject = hum end
	Store.setMode("hub")
	RaceClient.onExit:Fire()
end
RaceClient.exit = exit

function RaceClient.lobbyUpdate(s: any)
	local r = myRacer(s)
	local inRace = r ~= nil and (s.phase == "countdown" or s.phase == "racing" or s.phase == "results")
	if inRace and s.raceId ~= raceId and s.phase ~= "results" then
		raceId = s.raceId
		if RaceClient.preview then exit() end
		setupRace(s)
		RaceClient.preview = false
		enter()
		for _, c in feedBox:GetChildren() do if c:IsA("Frame") then c:Destroy() end end
	end
	if RaceClient.active and not RaceClient.preview then
		if not inRace or s.raceId ~= raceId then
			exit()
			return
		end
		currentRacers = s.racers
		posL.Text = Config.Ordinal(r.place)
		posL.TextColor3 = if r.place == 1 then T.amber elseif r.out then T.red else T.cyan
		lapL.Text = if r.out then "OUT" elseif r.finished then "FINISHED" else "LAP " .. r.lap .. "/" .. s.laps
		nitroL.Text = "NITRO ×" .. r.nitro
		if board.Visible then renderBoard() end
		-- feed: recent knockouts and finishes
		for _, c in feedBox:GetChildren() do if c:IsA("Frame") then c:Destroy() end end
		for i, f in s.feed do
			local row = UI.frame(feedBox, { BackgroundColor3 = T.panel, BackgroundTransparency = 0.15, Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = i, ZIndex = 5 })
			UI.corner(row, 6)
			UI.pad(row, 0, 8)
			UI.stroke(row, if f.kind == "out" then T.red else T.green, 1)
			UI.label(row, f.text, 13, { Font = UI.Bold, Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 6 })
		end
		if r.finished and not finishedShown then
			finishedShown = true
			center.Text = "FINISHED " .. Config.Ordinal(r.place)
			center.TextColor3 = T.green
			UI.sfx("whoosh", 1.6)
		end
	end
end
Store.lobbyChanged.Event:Connect(RaceClient.lobbyUpdate)
board:GetPropertyChangedSignal("Visible"):Connect(function() if board.Visible then renderBoard() end end)

-- Preview drive from the garage --------------------------------------------
function RaceClient.startPreview(kartId: string): (boolean, string?)
	if RaceClient.active then return false, "Finish your race first." end
	local res = Store.call("preview_start")
	if not res.ok then return false, res.err end
	clearKarts()
	pts = Track.Points("neon_loop")
	local p = Store.profile
	local model = KartBuilder.Build(kartId, p and p.livery, cosmeticOf())
	model.Parent = kartsFolder
	me.model = model
	me.phys = myPhys(kartId)
	local pos, yaw = Track.GridSlot(pts, 1)
	me.pos, me.yaw, me.speed, me.idx, me.boostUntil, me.drifting, me.driftCharge = pos, yaw, 0, Track.N - 1, 0, false, 0
	me.ready = true
	RaceClient.preview = true
	enter()
	center.Text = ""
	nitroL.Text = "NITRO ∞"
	UI.pushBack("preview", function() RaceClient.stopPreview() end)
	task.defer(function() UI.focus(exitBtn) GuiService.SelectedObject = nil end)
	return true, nil
end

function RaceClient.stopPreview()
	if not RaceClient.preview then return end
	UI.popBack("preview")
	exit()
	Store.call("preview_end")
end
exitBtn.Activated:Connect(function() RaceClient.stopPreview() end)

return RaceClient
]]></ProtectedString>
