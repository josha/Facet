					<ProtectedString name="Source"><![CDATA[--!strict
-- Shared game data for Neon Drift Circuit. Server is authoritative; clients read this for display.
local Config = {}

Config.GameName = "NEON DRIFT CIRCUIT"
Config.Laps = 2
Config.RacerCount = 6
Config.VoteSeconds = 12
Config.CountdownSeconds = 3
Config.QueueLaunchDelay = 4
Config.RaceTimeLimit = 210
Config.FinishGrace = 15
Config.RentalSeconds = 600
Config.ChatCooldown = 5
Config.ExpensivePrice = 500

Config.Theme = {
	Bg = Color3.fromRGB(10, 8, 24),
	Panel = Color3.fromRGB(20, 17, 44),
	Panel2 = Color3.fromRGB(30, 26, 62),
	Line = Color3.fromRGB(70, 60, 130),
	Text = Color3.fromRGB(236, 236, 255),
	Sub = Color3.fromRGB(170, 168, 210),
	Cyan = Color3.fromRGB(0, 234, 255),
	Pink = Color3.fromRGB(255, 46, 170),
	Violet = Color3.fromRGB(160, 90, 255),
	Gold = Color3.fromRGB(255, 200, 60),
	Green = Color3.fromRGB(70, 240, 140),
	Red = Color3.fromRGB(255, 80, 90),
	Gem = Color3.fromRGB(120, 200, 255),
}

Config.RarityOrder = { Common = 1, Rare = 2, Epic = 3, Legendary = 4 }
Config.RarityColor = {
	Common = Color3.fromRGB(170, 180, 200),
	Rare = Color3.fromRGB(70, 160, 255),
	Epic = Color3.fromRGB(190, 90, 255),
	Legendary = Color3.fromRGB(255, 190, 50),
}

-- Karts: base stats on a 0-100 scale
Config.Karts = {
	{ id = "volt", name = "Volt Runner", category = "Balanced", rarity = "Common", speed = 62, accel = 60, handling = 60, boost = 55, color = Color3.fromRGB(0, 220, 255), desc = "Reliable all-rounder for new pilots." },
	{ id = "ember", name = "Ember Dart", category = "Speedster", rarity = "Common", speed = 70, accel = 52, handling = 50, boost = 50, color = Color3.fromRGB(255, 120, 40), desc = "Light frame, long straights." },
	{ id = "glyph", name = "Glyph Grip", category = "Grip", rarity = "Rare", speed = 60, accel = 66, handling = 78, boost = 52, color = Color3.fromRGB(90, 255, 140), desc = "Hugs every corner." },
	{ id = "nova", name = "Nova Lance", category = "Speedster", rarity = "Rare", speed = 78, accel = 58, handling = 54, boost = 60, color = Color3.fromRGB(255, 60, 180), desc = "Top speed specialist." },
	{ id = "bastion", name = "Bastion Hauler", category = "Heavy", rarity = "Rare", speed = 66, accel = 48, handling = 52, boost = 72, color = Color3.fromRGB(150, 120, 255), desc = "Heavy chassis, huge boost tank." },
	{ id = "aurora", name = "Aurora Wisp", category = "Grip", rarity = "Epic", speed = 72, accel = 70, handling = 84, boost = 60, color = Color3.fromRGB(120, 255, 230), desc = "Glides through drifts." },
	{ id = "quasar", name = "Quasar X", category = "Speedster", rarity = "Epic", speed = 86, accel = 64, handling = 58, boost = 66, color = Color3.fromRGB(255, 220, 60), desc = "A comet with wheels." },
	{ id = "zenith", name = "Zenith Prime", category = "Balanced", rarity = "Legendary", speed = 84, accel = 78, handling = 76, boost = 78, color = Color3.fromRGB(255, 255, 255), desc = "Flagship of the circuit." },
}
Config.KartCategories = { "All", "Balanced", "Speedster", "Grip", "Heavy" }
Config.Rarities = { "All", "Common", "Rare", "Epic", "Legendary" }

-- Parts: one per slot may be equipped
Config.Slots = { "Motor", "Boost", "Wheels", "Cosmetic" }
Config.Parts = {
	{ id = "m_ion", slot = "Motor", name = "Ion Motor", price = 250, rarity = "Common", stats = { speed = 4 }, desc = "+4 speed" },
	{ id = "m_plasma", slot = "Motor", name = "Plasma Core", price = 900, rarity = "Rare", stats = { speed = 8, accel = 4 }, desc = "+8 speed, +4 accel" },
	{ id = "m_fusion", slot = "Motor", name = "Fusion Heart", price = 2400, rarity = "Epic", stats = { speed = 13, accel = 6 }, desc = "+13 speed, +6 accel" },
	{ id = "b_spark", slot = "Boost", name = "Spark Cell", price = 200, rarity = "Common", stats = { boost = 5 }, desc = "+5 boost" },
	{ id = "b_nitro", slot = "Boost", name = "Nitro Coil", price = 800, rarity = "Rare", stats = { boost = 10 }, desc = "+10 boost" },
	{ id = "b_warp", slot = "Boost", name = "Warp Injector", price = 2200, rarity = "Epic", stats = { boost = 16, speed = 3 }, desc = "+16 boost, +3 speed" },
	{ id = "w_grip", slot = "Wheels", name = "Grip Rings", price = 300, rarity = "Common", stats = { handling = 5 }, desc = "+5 handling" },
	{ id = "w_mag", slot = "Wheels", name = "Mag Hover Pads", price = 1100, rarity = "Rare", stats = { handling = 10, accel = 3 }, desc = "+10 handling, +3 accel" },
	{ id = "w_quantum", slot = "Wheels", name = "Quantum Treads", price = 2600, rarity = "Epic", stats = { handling = 15, speed = 3 }, desc = "+15 handling, +3 speed" },
	{ id = "c_trail", slot = "Cosmetic", name = "Neon Trail", price = 150, rarity = "Common", stats = {}, desc = "Glowing light trail" },
	{ id = "c_halo", slot = "Cosmetic", name = "Halo Ring", price = 600, rarity = "Rare", stats = {}, desc = "Hovering halo above the kart" },
	{ id = "c_flame", slot = "Cosmetic", name = "Plasma Flames", price = 1500, rarity = "Epic", stats = {}, desc = "Exhaust flames" },
}
Config.ShopCategories = { { key = "All", label = "All" }, { key = "Motor", label = "Motors" }, { key = "Boost", label = "Boosts" }, { key = "Wheels", label = "Wheels" }, { key = "Cosmetic", label = "Cosmetics" } }

-- Drivers
Config.DriverGroups = { "Rookies", "Pros", "Legends" }
Config.Drivers = {
	{ id = "d_pip", group = "Rookies", name = "Pip", price = 0, rent = 0, stats = { accel = 2 }, desc = "Starter pilot. +2 accel", color = Color3.fromRGB(0, 220, 255) },
	{ id = "d_juno", group = "Rookies", name = "Juno", price = 400, rent = 60, stats = { handling = 4 }, desc = "+4 handling", color = Color3.fromRGB(90, 255, 140) },
	{ id = "d_rex", group = "Pros", name = "Rex Volta", price = 1200, rent = 150, stats = { speed = 5, accel = 2 }, desc = "+5 speed, +2 accel", color = Color3.fromRGB(255, 120, 40) },
	{ id = "d_mira", group = "Pros", name = "Mira Sol", price = 1400, rent = 180, stats = { handling = 6, boost = 3 }, desc = "+6 handling, +3 boost", color = Color3.fromRGB(255, 60, 180) },
	{ id = "d_orion", group = "Legends", name = "Orion Kade", price = 3500, rent = 400, stats = { speed = 8, boost = 6 }, desc = "+8 speed, +6 boost", color = Color3.fromRGB(255, 220, 60) },
	{ id = "d_lyra", group = "Legends", name = "Lyra Null", price = 3800, rent = 450, stats = { accel = 7, handling = 7 }, desc = "+7 accel, +7 handling", color = Color3.fromRGB(160, 90, 255) },
}

-- Livery
Config.Swatches = {
	{ name = "Red", color = Color3.fromRGB(255, 50, 70) },
	{ name = "Amber", color = Color3.fromRGB(255, 176, 30) },
	{ name = "Green", color = Color3.fromRGB(50, 240, 120) },
	{ name = "Cyan", color = Color3.fromRGB(0, 230, 255) },
	{ name = "Blue", color = Color3.fromRGB(60, 110, 255) },
	{ name = "Violet", color = Color3.fromRGB(170, 80, 255) },
}
Config.Shades = { 50, 75, 100 }
Config.Decals = {
	{ id = "none", name = "None", glyph = "" },
	{ id = "bolt", name = "Bolt", glyph = "⚡" },
	{ id = "star", name = "Star", glyph = "★" },
	{ id = "chevron", name = "Chevron", glyph = "≫" },
	{ id = "diamond", name = "Diamond", glyph = "◆" },
	{ id = "num7", name = "Number 7", glyph = "7" },
	{ id = "ring", name = "Orbit", glyph = "◎" },
}
Config.DefaultLivery = { body = "Cyan", accent = "Violet", shade = 100, decal = "bolt" }

function Config.SwatchColor(name: string, shade: number): Color3
	local base = Config.Swatches[1].color
	for _, s in ipairs(Config.Swatches) do
		if s.name == name then base = s.color end
	end
	local k = (shade or 100) / 100
	return Color3.new(base.R * k, base.G * k, base.B * k)
end

-- Upgrades
Config.UpgradeStats = { "speed", "handling", "boost" }
Config.UpgradeMax = 5
Config.UpgradePerLevel = 3
function Config.UpgradeCost(level: number): (number, number)
	-- cost to go from level -> level+1
	return 300 + level * 250, 2 + level * 2
end

-- Crates and cards
Config.Cards = {
	{ id = "k1", name = "Gridline", rarity = "Common" }, { id = "k2", name = "Pit Crew", rarity = "Common" },
	{ id = "k3", name = "Neon Cone", rarity = "Common" }, { id = "k4", name = "Spark Plug", rarity = "Common" },
	{ id = "k5", name = "Hover Rig", rarity = "Common" }, { id = "k6", name = "Tail Light", rarity = "Common" },
	{ id = "k7", name = "Drift King", rarity = "Rare" }, { id = "k8", name = "Night Lap", rarity = "Rare" },
	{ id = "k9", name = "Pulse Grid", rarity = "Rare" }, { id = "k10", name = "Ion Storm", rarity = "Rare" },
	{ id = "k11", name = "Quasar Gate", rarity = "Epic" }, { id = "k12", name = "Helix Dive", rarity = "Epic" },
	{ id = "k13", name = "Void Racer", rarity = "Epic" }, { id = "k14", name = "Prism Crown", rarity = "Legendary" },
	{ id = "k15", name = "Zenith Flag", rarity = "Legendary" }, { id = "k16", name = "Circuit Eternal", rarity = "Legendary" },
}
Config.Crates = {
	{ id = "basic", name = "Basic Crate", price = 300, currency = "Coins", cards = 3, odds = { Common = 70, Rare = 22, Epic = 7, Legendary = 1 } },
	{ id = "neon", name = "Neon Crate", price = 1200, currency = "Coins", cards = 4, odds = { Common = 45, Rare = 35, Epic = 15, Legendary = 5 } },
	{ id = "prism", name = "Prism Crate", price = 30, currency = "Gems", cards = 5, odds = { Common = 20, Rare = 40, Epic = 28, Legendary = 12 } },
}

-- Daily rewards (day 7 is special)
Config.Daily = {
	{ coins = 100 }, { coins = 150 }, { gems = 5 }, { coins = 250 }, { freeCrate = 1 }, { coins = 400, gems = 5 },
	{ coins = 1000, gems = 25, freeCrate = 1, special = true },
}

-- Codes
Config.Codes = {
	NEONSTART = { coins = 500, gems = 10, expires = 4102444800 },
	DRIFTKING = { coins = 250, expires = 4102444800 },
	SUMMER24 = { coins = 9999, expires = 1725148800 },
}

-- Perk boosts (timed)
Config.Perks = {
	{ id = "coin2x", name = "2x Coins", desc = "Double race coins for 15 minutes", price = 15, currency = "Gems", seconds = 900 },
	{ id = "xp2x", name = "2x XP", desc = "Double race XP for 15 minutes", price = 10, currency = "Gems", seconds = 900 },
}
Config.Offer = { id = "starter", name = "Starter Pulse Pack", desc = "1,500 Coins + 20 Gems + Spark Cell", price = 25, currency = "Gems", seconds = 1800, coins = 1500, gems = 20, part = "b_spark" }

-- Quests
Config.Quests = {
	{ id = "q_race3", name = "Hit the Grid", desc = "Finish 3 races", goal = 3, stat = "races", coins = 300, gems = 3 },
	{ id = "q_podium", name = "Podium Pilot", desc = "Finish in the top 3", goal = 1, stat = "podiums", coins = 250, gems = 2 },
	{ id = "q_drift", name = "Drift Spark", desc = "Fire 10 drift boosts", goal = 10, stat = "driftBoosts", coins = 200, gems = 2 },
	{ id = "q_shop", name = "Kit Out", desc = "Buy 1 part in the shop", goal = 1, stat = "purchases", coins = 150, gems = 1 },
}

-- Race rewards by finishing place
Config.PlaceRewards = {
	{ coins = 300, gems = 5, xp = 120 }, { coins = 220, gems = 3, xp = 100 }, { coins = 170, gems = 2, xp = 85 },
	{ coins = 130, gems = 1, xp = 70 }, { coins = 100, gems = 0, xp = 60 }, { coins = 80, gems = 0, xp = 50 },
}
Config.OutReward = { coins = 40, gems = 0, xp = 30 }
function Config.XpForLevel(level: number): number
	return 200 + (level - 1) * 100
end

Config.QuickChat = { "Good luck!", "Nice drift!", "On your left!", "GG!", "Rematch?", "Wow!", "Sorry!", "Thanks!" }

Config.DemoFriends = {
	{ id = "nova", name = "Nova (Demo)", status = "Online", reply = "accept", thumbId = 1 },
	{ id = "kiro", name = "Kiro (Demo)", status = "Online", reply = "decline", thumbId = 156 },
	{ id = "pulse", name = "Pulse (Demo)", status = "Racing", reply = "accept", thumbId = 261 },
	{ id = "vex", name = "Vex (Demo)", status = "Offline", reply = "accept", thumbId = 2 },
	{ id = "tala", name = "Tala (Demo)", status = "Online", reply = "accept", thumbId = 3 },
}

Config.AINames = { "Byte Bolt", "Sigma Rush", "Echo Drift", "Rook Neon", "Pixel Fury", "Zap Vandal", "Cobalt Ace" }

Config.Mechanic = { name = "Gizmo", scrapCount = 3, rewardCoins = 400, rewardGems = 5 }

Config.DefaultSettings = { music = 0.5, sfx = 0.8, damageNumbers = true, cameraShake = true, graphics = "High", textScale = 1, reducedMotion = false }

-- Tracks: closed loops of control points (relative to origin), sampled with Catmull-Rom
Config.Tracks = {
	{ id = "loop", name = "Neon Loop", desc = "Wide sweeping oval. Flat out, drift the hairpins.", origin = Vector3.new(0, 0, 900), color = Color3.fromRGB(0, 230, 255),
		points = { {-260,-120}, {0,-170}, {260,-120}, {340,0}, {260,130}, {0,170}, {-260,130}, {-340,0} } },
	{ id = "helix", name = "Helix Harbor", desc = "S-bends along the dock lights. Rewards clean drifts.", origin = Vector3.new(1000, 0, 900), color = Color3.fromRGB(255, 60, 180),
		points = { {-320,-150}, {-110,-210}, {90,-110}, {300,-190}, {360,40}, {190,170}, {10,70}, {-170,190}, {-350,60} } },
	{ id = "quasar", name = "Quasar Canyon", desc = "Tight technical corners under a violet sky.", origin = Vector3.new(-1000, 0, 900), color = Color3.fromRGB(170, 90, 255),
		points = { {-290,-80}, {-130,-230}, {80,-170}, {150,-10}, {320,30}, {280,210}, {40,210}, {-110,100}, {-310,130} } },
}
Config.TestTrack = { id = "test", name = "Test Ring", desc = "Garage test loop", origin = Vector3.new(0, 0, -420), color = Color3.fromRGB(255, 200, 60),
	points = { {-150,-60}, {0,-90}, {150,-60}, {190,0}, {150,60}, {0,90}, {-150,60}, {-190,0} } }
Config.TrackWidth = 46
Config.TrackY = 2

local function sampleTrack(track: any)
	local pts = {}
	for _, p in ipairs(track.points) do
		table.insert(pts, track.origin + Vector3.new(p[1], Config.TrackY, p[2]))
	end
	local n = #pts
	local samples = {}
	for i = 1, n do
		local p0, p1, p2, p3 = pts[(i - 2) % n + 1], pts[i], pts[i % n + 1], pts[(i + 1) % n + 1]
		local segLen = (p2 - p1).Magnitude
		local steps = math.max(4, math.floor(segLen / 8))
		for s = 0, steps - 1 do
			local t = s / steps
			local t2, t3 = t * t, t * t * t
			local v = 0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 + (-p0 + 3 * p1 - 3 * p2 + p3) * t3)
			table.insert(samples, v)
		end
	end
	local dist = { 0 }
	for i = 2, #samples do
		dist[i] = dist[i - 1] + (samples[i] - samples[i - 1]).Magnitude
	end
	track.samples = samples
	track.dist = dist
	track.length = dist[#samples] + (samples[1] - samples[#samples]).Magnitude
end
for _, t in ipairs(Config.Tracks) do sampleTrack(t) end
sampleTrack(Config.TestTrack)

function Config.GetTrack(id: string): any
	for _, t in ipairs(Config.Tracks) do if t.id == id then return t end end
	if id == "test" then return Config.TestTrack end
	return nil
end

-- nearest sample index searching a window around hint (or whole loop if hint nil)
function Config.NearestSample(track: any, pos: Vector3, hint: number?, window: number?): (number, number)
	local samples = track.samples
	local n = #samples
	local best, bestD = 1, math.huge
	local flat = Vector3.new(pos.X, 0, pos.Z)
	if hint then
		local w = window or 30
		for o = -w, w do
			local i = (hint - 1 + o) % n + 1
			local s = samples[i]
			local d = (Vector3.new(s.X, 0, s.Z) - flat).Magnitude
			if d < bestD then best, bestD = i, d end
		end
	else
		for i = 1, n do
			local s = samples[i]
			local d = (Vector3.new(s.X, 0, s.Z) - flat).Magnitude
			if d < bestD then best, bestD = i, d end
		end
	end
	return best, bestD
end

function Config.SampleCFrame(track: any, i: number, lateral: number?): CFrame
	local n = #track.samples
	local a = track.samples[(i - 1) % n + 1]
	local b = track.samples[i % n + 1]
	local cf = CFrame.lookAt(a, Vector3.new(b.X, a.Y, b.Z))
	return cf * CFrame.new(lateral or 0, 0, 0)
end

-- final kart stats combining kart, upgrades, parts and driver
function Config.GetKart(id: string): any
	for _, k in ipairs(Config.Karts) do if k.id == id then return k end end
	return nil
end
function Config.GetPart(id: string): any
	for _, p in ipairs(Config.Parts) do if p.id == id then return p end end
	return nil
end
function Config.GetDriver(id: string): any
	for _, d in ipairs(Config.Drivers) do if d.id == id then return d end end
	return nil
end

function Config.ComputeStats(kartId: string, upgrades: any, equipped: any, driverId: string?): any
	local k = Config.GetKart(kartId) or Config.Karts[1]
	local s = { speed = k.speed, accel = k.accel, handling = k.handling, boost = k.boost }
	if upgrades then
		for _, st in ipairs(Config.UpgradeStats) do
			s[st] += (upgrades[st] or 0) * Config.UpgradePerLevel
		end
	end
	if equipped then
		for _, slot in ipairs(Config.Slots) do
			local p = equipped[slot] and Config.GetPart(equipped[slot])
			if p then for st, v in pairs(p.stats) do s[st] += v end end
		end
	end
	local d = driverId and Config.GetDriver(driverId)
	if d then for st, v in pairs(d.stats) do s[st] += v end end
	return s
end

function Config.Physics(stats: any): any
	return {
		topSpeed = 70 + stats.speed * 0.5,
		accel = 22 + stats.accel * 0.35,
		turn = 1.2 + stats.handling * 0.014,
		boostMult = 1.25 + stats.boost * 0.004,
		boostCap = 2 + stats.boost * 0.03,
	}
end

function Config.FormatNumber(n: number): string
	local s = tostring(math.floor(n))
	local neg = string.sub(s, 1, 1) == "-"
	if neg then s = string.sub(s, 2) end
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if string.sub(out, 1, 1) == "," then out = string.sub(out, 2) end
	return (neg and "-" or "") .. out
end

function Config.Short(n: number): string
	if n >= 1e6 then return string.format("%.1fM", n / 1e6) end
	if n >= 1e4 then return string.format("%.1fK", n / 1e3) end
	return Config.FormatNumber(n)
end

return Config
]]></ProtectedString>
