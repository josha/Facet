					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXBA393705108F48468860057C4856DF9B">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Drivers, Livery and Upgrades panels.
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local U = require(script.Parent.Util)
local KartBuilder = require(RS.Shared.KartBuilder)
local Config = U.Config
local T = U.T

local DriverState = { group = "All" }
local LiveryState = { target = "body", draft = nil :: any }

local function statLine(stats: any): string
	local parts = {}
	for _, k in ipairs({ "speed", "accel", "handling", "boost" }) do
		if stats[k] then table.insert(parts, string.format("%+d %s", stats[k], k)) end
	end
	return table.concat(parts, "  ")
end

local function sameLivery(a: any, b: any): boolean
	return a.body == b.body and a.accent == b.accent and a.shade == b.shade and a.decal == b.decal
end

return function(App: any)
	-- =============== DRIVERS ===============
	App.Register("Drivers", "DRIVERS", T.Gold, function(body: Frame)
		local root = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = body })
		U.list(root, Enum.FillDirection.Vertical, 8)
		local tabs = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), LayoutOrder = 1, Parent = root })
		U.list(tabs, Enum.FillDirection.Horizontal, 6)
		local listF = U.scroll(root, { Size = UDim2.new(1, 0, 1, -50), LayoutOrder = 2 })
		U.list(listF, Enum.FillDirection.Vertical, 8)
		U.pad(listF, 4)
		local timers: { [TextLabel]: string } = {}
		local refresh
		local function buildTabs()
			U.clear(tabs)
			local opts = { "All" }
			for _, g in ipairs(Config.DriverGroups) do table.insert(opts, g) end
			for i, g in ipairs(opts) do
				local on = DriverState.group == g
				local b = U.btn(tabs, g, { order = i, size = UDim2.fromOffset(100, 38), color = on and T.Gold or T.Panel2, textColor = on and T.Bg or T.Text })
				b.Activated:Connect(function() DriverState.group = g; buildTabs(); refresh() end)
			end
		end
		local busy = false
		local function act(action: string, args: any)
			if busy then return end
			busy = true
			local r = U.Request(action, args)
			busy = false
			if r.ok then U.Toast(r.msg, "good") else U.Toast(r.err, "bad") end
		end
		refresh = function()
			local p = U.Store.profile
			if not p then return end
			local keep = listF.CanvasPosition
			U.clear(listF)
			timers = {}
			local cur = Config.GetDriver(p.selectedDriver)
			U.label(listF, "Current driver: " .. (cur and cur.name or "—") .. "  (" .. statLine(cur and cur.stats or {}) .. ")  ·  Wallet 💰 " .. Config.FormatNumber(p.coins), 14, T.Sub, { LayoutOrder = 0 })
			for i, d in ipairs(Config.Drivers) do
				if DriverState.group == "All" or d.group == DriverState.group then
					local owned = p.drivers[d.id] == true
					local rentEnd = p.rentals[d.id]
					local rented = rentEnd ~= nil and rentEnd > U.Now()
					local selected = p.selectedDriver == d.id
					local c = U.card(listF, { LayoutOrder = i, BackgroundColor3 = selected and Color3.fromRGB(46, 40, 20) or T.Panel2 })
					local st = c:FindFirstChildOfClass("UIStroke")
					if st then st.Color = selected and T.Gold or T.Line; st.Thickness = selected and 2 or 1 end
					U.pad(c, 12)
					local av = U.new("Frame", { BackgroundColor3 = d.color, Size = UDim2.fromOffset(52, 52), Parent = c })
					U.corner(av, 26)
					U.new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = string.sub(d.name, 1, 1), TextScaled = true, Font = Enum.Font.GothamBlack, TextColor3 = T.Bg, Parent = av })
					local info = U.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(64, 0), Size = UDim2.new(1, -64, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = c })
					U.list(info, Enum.FillDirection.Vertical, 3)
					U.label(info, d.name .. "  ·  " .. d.group, 17, T.Text, { Font = Enum.Font.GothamBold, LayoutOrder = 1 })
					U.label(info, "Stats: " .. statLine(d.stats), 14, T.Cyan, { LayoutOrder = 2 })
					local diff = {}
					for _, k in ipairs({ "speed", "accel", "handling", "boost" }) do
						local dv = (d.stats[k] or 0) - ((cur and cur.stats[k]) or 0)
						if dv ~= 0 then table.insert(diff, string.format("%+d %s", dv, k)) end
					end
					U.label(info, "vs current: " .. (#diff > 0 and table.concat(diff, "  ") or "same"), 13, T.Sub, { LayoutOrder = 3 })
					local status = selected and "✔ DRIVING" or owned and "OWNED" or rented and "RENTED" or "NOT OWNED"
					local stLbl = U.label(info, status, 13, selected and T.Gold or (owned or rented) and T.Green or T.Sub, { Font = Enum.Font.GothamBold, LayoutOrder = 4 })
					if rented and not owned then timers[stLbl] = d.id end
					local btns = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 5, Parent = info })
					U.list(btns, Enum.FillDirection.Horizontal, 6)
					if (owned or rented) and not selected then
						local b = U.btn(btns, "Select", { order = 1, size = UDim2.fromOffset(100, 38), primary = true, color = T.Gold })
						b.Activated:Connect(function() act("SelectDriver", { id = d.id }) end)
					end
					if not owned and d.price > 0 then
						local b = U.btn(btns, "Buy 💰 " .. Config.FormatNumber(d.price), { name = "Buy_" .. d.id, order = 2, size = UDim2.fromOffset(150, 38), textSize = 14 })
						b.Activated:Connect(function()
							U.Confirm({ title = "Buy driver " .. d.name .. "?", body = "Permanent ownership. " .. statLine(d.stats), price = "Full price: 💰 " .. Config.FormatNumber(d.price) .. " Coins", confirmText = "Buy" }, function() act("BuyDriver", { id = d.id }) end)
						end)
						if not rented then
							local r = U.btn(btns, "Rent 10 min 💰 " .. Config.FormatNumber(d.rent), { name = "Rent_" .. d.id, order = 3, size = UDim2.fromOffset(190, 38), textSize = 14 })
							r.Activated:Connect(function()
								U.Confirm({ title = "Rent " .. d.name .. " for 10 minutes?", body = "You can race with " .. d.name .. " while the rental is active. It expires automatically.", price = "Full price: 💰 " .. Config.FormatNumber(d.rent) .. " Coins", confirmText = "Rent" }, function() act("RentDriver", { id = d.id }) end)
							end)
						end
					end
				end
			end
			listF.CanvasPosition = keep
		end
		buildTabs()
		refresh()
		return {
			refresh = function(kind)
				if kind == "profile" then refresh() return end
				local p = U.Store.profile
				for lbl, id in pairs(timers) do
					local left = (p.rentals[id] or 0) - U.Now()
					lbl.Text = left > 0 and ("RENTED · " .. U.fmtTime(left) .. " left") or "Rental expired"
				end
			end,
		}
	end)

	-- =============== LIVERY ===============
	App.Register("Livery", "LIVERY STUDIO", T.Violet, function(body: Frame)
		local p = U.Store.profile
		LiveryState.draft = table.clone(p.livery)
		local compact = U.Layout.compact
		local vpf = U.new("ViewportFrame", { BackgroundColor3 = T.Panel, Ambient = Color3.fromRGB(160, 150, 200), LightColor = Color3.new(1, 1, 1), LightDirection = Vector3.new(-1, -2, -1), Parent = body })
		U.corner(vpf, 12); U.stroke(vpf, T.Violet, 1)
		local controls = U.scroll(body)
		if compact then
			vpf.Size = UDim2.new(1, 0, 0.36, 0)
			controls.Size = UDim2.new(1, 0, 0.64, -6)
			controls.Position = UDim2.new(0, 0, 0.36, 6)
		else
			vpf.Size = UDim2.new(0.48, -6, 1, 0)
			controls.Size = UDim2.new(0.52, -6, 1, 0)
			controls.Position = UDim2.new(0.48, 6, 0, 0)
		end
		U.list(controls, Enum.FillDirection.Vertical, 8)
		U.pad(controls, 4)
		local cam = Instance.new("Camera")
		cam.FieldOfView = 40
		cam.Parent = vpf
		vpf.CurrentCamera = cam
		local world = Instance.new("WorldModel"); world.Parent = vpf
		local kart = KartBuilder.Build(p.selectedKart, LiveryState.draft, nil, nil)
		kart:PivotTo(CFrame.new())
		kart.Parent = world
		local angle = 0.8
		local function placeCam()
			cam.CFrame = CFrame.lookAt(Vector3.new(math.sin(angle) * 30, 12, math.cos(angle) * 30), Vector3.new(0, 0.5, 0))
		end
		placeCam()
		local spin = RunService.RenderStepped:Connect(function(dt)
			if not U.ReducedMotion then angle += dt * 0.5; placeCam() end
		end)
		local status = U.new("TextLabel", { BackgroundColor3 = T.Bg, BackgroundTransparency = 0.2, Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(0, 30), AutomaticSize = Enum.AutomaticSize.X, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = T.Green, Text = "", Parent = vpf })
		U.corner(status, 8); U.pad(status, 10, 0)
		local refresh

		local function isDirty(): boolean
			return not sameLivery(LiveryState.draft, U.Store.profile.livery)
		end
		local function apply()
			KartBuilder.ApplyLivery(kart, LiveryState.draft)
			if isDirty() then
				status.Text = "● Unsaved changes"
				status.TextColor3 = T.Gold
			else
				status.Text = "✔ Matches saved design"
				status.TextColor3 = T.Green
			end
			App.PanelSub.Text = isDirty() and "Unsaved" or ""
		end

		local function section(title: string, order: number): Frame
			U.label(controls, title, 13, T.Sub, { Font = Enum.Font.GothamBold, LayoutOrder = order })
			local f = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order + 1, Parent = controls })
			return f
		end
		local saving = false
		refresh = function()
			U.clear(controls)
			local d = LiveryState.draft
			local tgt = section("PAINT TARGET", 1)
			U.list(tgt, Enum.FillDirection.Horizontal, 6)
			for i, t in ipairs({ { "body", "Body" }, { "accent", "Accent" } }) do
				local on = LiveryState.target == t[1]
				local b = U.btn(tgt, t[2] .. ": " .. d[t[1]], { name = "Target_" .. t[1], order = i, size = UDim2.new(0.5, -3, 0, 40), color = on and T.Violet or T.Panel2 })
				b.Activated:Connect(function() LiveryState.target = t[1]; refresh() end)
			end
			local sw = section("COLOR", 3)
			U.new("UIGridLayout", { CellSize = UDim2.new(1 / 3, -6, 0, 44), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = sw })
			for i, s in ipairs(Config.Swatches) do
				local on = d[LiveryState.target] == s.name
				local b = U.btn(sw, s.name, { name = "Swatch_" .. s.name, order = i, color = s.color, textColor = T.Bg, stroke = on and Color3.new(1, 1, 1) or s.color })
				local st = b:FindFirstChildOfClass("UIStroke")
				if st and on then st.Thickness = 3 end
				if on then b.Text = "✔ " .. s.name end
				b.Activated:Connect(function()
					LiveryState.draft[LiveryState.target] = s.name
					apply(); refresh()
				end)
			end
			local sh = section("BODY SHADE", 5)
			U.list(sh, Enum.FillDirection.Horizontal, 6)
			for i, v in ipairs(Config.Shades) do
				local on = d.shade == v
				local b = U.btn(sh, v .. "%", { name = "Shade_" .. v, order = i, size = UDim2.new(1 / 3, -4, 0, 40), color = on and T.Violet or T.Panel2 })
				b.Activated:Connect(function() LiveryState.draft.shade = v; apply(); refresh() end)
			end
			local dc = section("DECAL", 7)
			U.new("UIGridLayout", { CellSize = UDim2.new(0.25, -6, 0, 44), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = dc })
			for i, x in ipairs(Config.Decals) do
				local on = d.decal == x.id
				local b = U.btn(dc, (x.glyph ~= "" and x.glyph .. " " or "") .. x.name, { name = "Decal_" .. x.id, order = i, textSize = 13, color = on and T.Violet or T.Panel2 })
				b.Activated:Connect(function() LiveryState.draft.decal = x.id; apply(); refresh() end)
			end
			local act = section("", 9)
			U.list(act, Enum.FillDirection.Horizontal, 6)
			local save = U.btn(act, saving and "Saving…" or "💾 Save design", { name = "Save", order = 1, size = UDim2.new(0.5, -3, 0, 44), primary = true, color = T.Green })
			if saving or not isDirty() then U.setEnabled(save, false) end
			save.Activated:Connect(function()
				if saving or not isDirty() then return end
				saving = true; refresh()
				local r = U.Request("SaveLivery", { livery = LiveryState.draft })
				saving = false
				if r.ok then U.Toast("Design saved · applied to your karts", "good") else U.Toast(r.err, "bad") end
				task.wait(); apply(); refresh()
			end)
			local revert = U.btn(act, "Revert", { name = "Revert", order = 2, size = UDim2.new(0.5, -3, 0, 44) })
			if not isDirty() then U.setEnabled(revert, false) end
			revert.Activated:Connect(function()
				if not isDirty() then return end
				U.Confirm({ title = "Discard unsaved changes?", body = "Your draft will return to the saved design.", confirmText = "Discard", danger = true }, function()
					LiveryState.draft = table.clone(U.Store.profile.livery)
					apply(); refresh()
				end)
			end)
			local designs = U.Store.profile.designs
			U.label(controls, "SAVED DESIGNS (" .. #designs .. ")", 13, T.Sub, { Font = Enum.Font.GothamBold, LayoutOrder = 11 })
			if #designs == 0 then
				U.label(controls, "No saved designs yet. Save one to find it here later.", 13, T.Sub, { LayoutOrder = 12 })
			end
			for i, ds in ipairs(designs) do
				local cur = sameLivery(ds, U.Store.profile.livery)
				local b = U.btn(controls, string.format("%s · %s / %s · %d%% · %s%s", ds.name, ds.body, ds.accent, ds.shade, ds.decal, cur and "  (current)" or ""), { name = "Design_" .. i, order = 12 + i, size = UDim2.new(1, 0, 0, 40), textSize = 13 })
				b.Activated:Connect(function()
					LiveryState.draft = { body = ds.body, accent = ds.accent, shade = ds.shade, decal = ds.decal }
					apply(); refresh()
				end)
			end
		end
		apply()
		refresh()
		local function guard(proceed: () -> ())
			if isDirty() then
				U.Confirm({ title = "Leave with unsaved changes?", body = "Cancel keeps your draft. Discard restores the saved design.", confirmText = "Discard", cancelText = "Cancel", danger = true }, function()
					LiveryState.draft = table.clone(U.Store.profile.livery)
					apply()
					proceed()
				end)
			else
				proceed()
			end
		end
		return {
			refresh = function(kind) if kind == "profile" then apply() end end,
			canClose = guard,
			cleanup = function() spin:Disconnect(); App.PanelSub.Text = "" end,
			focus = controls:FindFirstChild("Target_body", true),
		}
	end)

	-- =============== UPGRADES ===============
	App.Register("Upgrades", "UPGRADE BAY", T.Green, function(body: Frame)
		local root = U.scroll(body)
		U.list(root, Enum.FillDirection.Vertical, 8)
		U.pad(root, 4)
		local kartId = App.UpgradeKart or U.Store.profile.selectedKart
		App.UpgradeKart = nil
		local busy = false
		local refresh
		refresh = function()
			local p = U.Store.profile
			U.clear(root)
			local chips = U.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 46), AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 0, LayoutOrder = 1, Selectable = false, Parent = root })
			U.list(chips, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
			for i, k in ipairs(Config.Karts) do
				local on = k.id == kartId
				local b = U.btn(chips, k.name, { name = "K_" .. k.id, order = i, size = UDim2.fromOffset(0, 40), textSize = 14, color = on and T.Green or T.Panel2, textColor = on and T.Bg or T.Text })
				b.AutomaticSize = Enum.AutomaticSize.X
				U.pad(b, 12, 0)
				b.Activated:Connect(function() kartId = k.id; refresh() end)
			end
			local k = Config.GetKart(kartId)
			local up = p.upgrades[kartId] or { speed = 0, handling = 0, boost = 0 }
			U.label(root, string.format("%s%s · Wallet 💰 %s · 💎 %s", k.name, p.selectedKart == kartId and " (next race kart)" or "", Config.FormatNumber(p.coins), Config.FormatNumber(p.gems)), 15, T.Text, { Font = Enum.Font.GothamBold, LayoutOrder = 2 })
			U.label(root, "Upgrades are saved per kart and apply whenever that kart races.", 13, T.Sub, { LayoutOrder = 3 })
			for i, stat in ipairs(Config.UpgradeStats) do
				local lvl = up[stat] or 0
				local base = k[stat]
				local c = U.card(root, { LayoutOrder = 3 + i })
				U.pad(c, 12)
				U.list(c, Enum.FillDirection.Vertical, 4)
				U.label(c, string.upper(stat) .. "  ·  Level " .. lvl .. " / " .. Config.UpgradeMax, 17, T.Text, { Font = Enum.Font.GothamBold, LayoutOrder = 1 })
				local pips = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 10), LayoutOrder = 2, Parent = c })
				U.list(pips, Enum.FillDirection.Horizontal, 4)
				for j = 1, Config.UpgradeMax do
					local pip = U.new("Frame", { BackgroundColor3 = j <= lvl and T.Green or T.Bg, Size = UDim2.new(1 / Config.UpgradeMax, -4, 1, 0), LayoutOrder = j, Parent = pips })
					U.corner(pip, 4)
				end
				local curV = base + lvl * Config.UpgradePerLevel
				if lvl >= Config.UpgradeMax then
					U.label(c, string.format("%s %d · MAXIMUM LEVEL reached", stat, curV), 14, T.Gold, { LayoutOrder = 3, Font = Enum.Font.GothamBold })
				else
					local coins, gems = Config.UpgradeCost(lvl)
					local afford = p.coins >= coins and p.gems >= gems
					U.label(c, string.format("Next: +%d %s (%d → %d)", Config.UpgradePerLevel, stat, curV, curV + Config.UpgradePerLevel), 14, T.Cyan, { LayoutOrder = 3 })
					U.label(c, string.format("Cost: 💰 %s Coins + 💎 %d Gems", Config.FormatNumber(coins), gems), 14, afford and T.Gold or T.Red, { LayoutOrder = 4, Font = Enum.Font.GothamBold })
					if not afford then
						local need = {}
						if p.coins < coins then table.insert(need, "💰 " .. Config.FormatNumber(coins - p.coins) .. " more Coins") end
						if p.gems < gems then table.insert(need, "💎 " .. (gems - p.gems) .. " more Gems") end
						U.label(c, "Insufficient funds: need " .. table.concat(need, " and "), 13, T.Red, { LayoutOrder = 5 })
					end
					local b = U.btn(c, busy and "Upgrading…" or "Upgrade", { name = "Up_" .. stat, order = 6, size = UDim2.fromOffset(160, 40), primary = afford, color = T.Green })
					if not afford or busy then U.setEnabled(b, false) end
					b.Activated:Connect(function()
						if busy or not afford then return end
						U.Confirm({ title = "Upgrade " .. k.name .. " " .. stat .. "?", body = string.format("Level %d → %d (+%d %s)", lvl, lvl + 1, Config.UpgradePerLevel, stat), price = string.format("💰 %s Coins + 💎 %d Gems", Config.FormatNumber(coins), gems), confirmText = "Upgrade" }, function()
							busy = true; refresh()
							local r = U.Request("Upgrade", { kart = kartId, stat = stat })
							busy = false
							if r.ok then U.Toast(k.name .. ": " .. r.msg, "good") else U.Toast(r.err, "bad") end
							refresh()
						end)
					end)
				end
			end
		end
		refresh()
		return { refresh = function(kind) if kind == "profile" then local keep = root.CanvasPosition; refresh(); root.CanvasPosition = keep end end }
	end)
end
]]></ProtectedString>
						<string name="ScriptGuid">{FE76BD82-6491-4853-A19F-9C98F9577DC7}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">PanelsB</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">516e08a84660d37b0af5982a0000171b</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX3A0A9824A8C44522A6FA901F4B0943EA">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Crates, Daily rewards, Codes and Quests/Boosts/Offer panels.
local U = require(script.Parent.Util)
local Config = U.Config
local T = U.T

local CodeState = { text = "", status = "", kind = "info", retryAt = 0, busy = false }

local function cardDef(id: string): any
	for _, c in ipairs(Config.Cards) do if c.id == id then return c end end
	return nil
end

local function rewardText(r: any): string
	local parts = {}
	if r.coins then table.insert(parts, "💰 " .. Config.FormatNumber(r.coins)) end
	if r.gems then table.insert(parts, "💎 " .. r.gems) end
	if r.freeCrate then table.insert(parts, "📦 Free crate") end
	return table.concat(parts, " + ")
end

return function(App: any)
	-- =============== CRATES ===============
	App.Register("Crates", "CRATES", T.Gold, function(body: Frame)
		local root = U.scroll(body)
		U.list(root, Enum.FillDirection.Vertical, 10)
		U.pad(root, 4)
		local reveal: any = nil
		local busy = false
		local refresh
		local function openCrate(crate: any)
			local p = U.Store.profile
			local free = crate.id == "basic" and p.freeCrates > 0
			local bal = crate.currency == "Gems" and p.gems or p.coins
			if not free and bal < crate.price then
				U.Toast("Not enough " .. crate.currency .. " for " .. crate.name, "bad")
				return
			end
			local priceStr = free and "FREE (uses 1 free crate)" or ((crate.currency == "Gems" and "💎 " or "💰 ") .. Config.FormatNumber(crate.price) .. " " .. crate.currency)
			U.Confirm({ title = "Open " .. crate.name .. "?", body = crate.cards .. " cards. Odds: Common " .. crate.odds.Common .. "% · Rare " .. crate.odds.Rare .. "% · Epic " .. crate.odds.Epic .. "% · Legendary " .. crate.odds.Legendary .. "%", price = "Price: " .. priceStr, confirmText = "Open" }, function()
				busy = true; refresh()
				local r = U.Request("OpenCrate", { id = crate.id })
				busy = false
				if r.ok then
					reveal = { crate = crate, cards = r.cards, shown = 0 }
				else
					U.Toast(r.err, "bad")
				end
				refresh()
			end)
		end
		refresh = function()
			local p = U.Store.profile
			U.clear(root)
			if reveal then
				U.label(root, reveal.crate.name .. " · revealed " .. reveal.shown .. " / " .. #reveal.cards, 18, T.Text, { Font = Enum.Font.GothamBlack, LayoutOrder = 1 })
				local row = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = root })
				U.new("UIGridLayout", { CellSize = UDim2.fromOffset(130, 170), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
				for i, c in ipairs(reveal.cards) do
					local def = cardDef(c.id)
					local shown = i <= reveal.shown
					local f = U.new("Frame", { BackgroundColor3 = shown and T.Panel2 or T.Panel, LayoutOrder = i, Parent = row })
					U.corner(f, 12)
					U.stroke(f, shown and Config.RarityColor[def.rarity] or T.Line, shown and 3 or 1)
					U.pad(f, 8)
					U.list(f, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
					if shown then
						U.label(f, "#" .. i, 12, T.Sub, { TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1 })
						U.label(f, def.name, 16, T.Text, { TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold, LayoutOrder = 2 })
						U.label(f, def.rarity, 14, Config.RarityColor[def.rarity], { TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold, LayoutOrder = 3 })
						if c.isNew then U.chip(f, "NEW", T.Green, 4) end
					else
						U.label(f, "?", 48, T.Line, { TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBlack, LayoutOrder = 1 })
						U.label(f, "Card " .. i, 12, T.Sub, { TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 2 })
					end
				end
				local btns = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 3, Parent = root })
				U.list(btns, Enum.FillDirection.Horizontal, 8)
				if reveal.shown < #reveal.cards then
					local nb = U.btn(btns, "Reveal next", { name = "RevealNext", order = 1, size = UDim2.fromOffset(160, 44), primary = true, color = T.Gold })
					nb.Activated:Connect(function() reveal.shown += 1; refresh(); U.Focus(root:FindFirstChild("RevealNext", true) or root:FindFirstChild("Done", true)) end)
					local ab = U.btn(btns, "Reveal all", { name = "RevealAll", order = 2, size = UDim2.fromOffset(140, 44) })
					ab.Activated:Connect(function() reveal.shown = #reveal.cards; refresh(); U.Focus(root:FindFirstChild("Done", true)) end)
				else
					local db = U.btn(btns, "Done", { name = "Done", order = 1, size = UDim2.fromOffset(140, 44), primary = true, color = T.Green })
					db.Activated:Connect(function() reveal = nil; refresh() end)
				end
				return
			end
			U.label(root, string.format("Wallet 💰 %s Coins · 💎 %s Gems · Free crates: %d", Config.FormatNumber(p.coins), Config.FormatNumber(p.gems), p.freeCrates), 14, T.Sub, { LayoutOrder = 1 })
			local grid = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = root })
			local cols = U.Layout.compact and 1 or 3
			U.new("UIGridLayout", { CellSize = UDim2.new(1 / cols, -8, 0, 200), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
			for i, crate in ipairs(Config.Crates) do
				local free = crate.id == "basic" and p.freeCrates > 0
				local c = U.new("Frame", { BackgroundColor3 = T.Panel2, LayoutOrder = i, Parent = grid })
				U.corner(c, 12); U.stroke(c, free and T.Green or T.Gold, free and 2 or 1)
				U.pad(c, 10)
				U.list(c, Enum.FillDirection.Vertical, 3)
				U.label(c, "📦 " .. crate.name, 17, T.Text, { Font = Enum.Font.GothamBold, LayoutOrder = 1 })
				local priceStr = (crate.currency == "Gems" and "💎 " or "💰 ") .. Config.FormatNumber(crate.price) .. " " .. crate.currency
				U.label(c, free and ("FREE ×" .. p.freeCrates .. "  (then " .. priceStr .. ")") or priceStr, 15, free and T.Green or T.Gold, { Font = Enum.Font.GothamBold, LayoutOrder = 2 })
				U.label(c, crate.cards .. " cards per crate", 13, T.Sub, { LayoutOrder = 3 })
				U.label(c, string.format("Common %d%% · Rare %d%%\nEpic %d%% · Legendary %d%%", crate.odds.Common, crate.odds.Rare, crate.odds.Epic, crate.odds.Legendary), 12, T.Sub, { LayoutOrder = 4 })
				local b = U.btn(c, busy and "Opening…" or (free and "Open free" or "Open"), { name = "Open_" .. crate.id, order = 5, size = UDim2.new(1, 0, 0, 38), primary = true, color = free and T.Green or T.Gold })
				if busy then U.setEnabled(b, false) end
				b.Activated:Connect(function() if not busy then openCrate(crate) end end)
			end
			local have = 0
			for _, cd in ipairs(Config.Cards) do if (p.collection[cd.id] or 0) > 0 then have += 1 end end
			U.label(root, string.format("COLLECTION · %d / %d discovered", have, #Config.Cards), 14, T.Sub, { Font = Enum.Font.GothamBold, LayoutOrder = 3 })
			local bar = U.new("Frame", { BackgroundColor3 = T.Panel, Size = UDim2.new(1, 0, 0, 8), LayoutOrder = 4, Parent = root })
			U.corner(bar, 4)
			U.corner(U.new("Frame", { BackgroundColor3 = T.Gold, Size = UDim2.fromScale(have / #Config.Cards, 1), Parent = bar }), 4)
			local col = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = root })
			U.new("UIGridLayout", { CellSize = UDim2.fromOffset(110, 62), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = col })
			for i, cd in ipairs(Config.Cards) do
				local n = p.collection[cd.id] or 0
				local f = U.new("Frame", { BackgroundColor3 = n > 0 and T.Panel2 or T.Panel, LayoutOrder = i, Parent = col })
				U.corner(f, 8); U.stroke(f, n > 0 and Config.RarityColor[cd.rarity] or T.Line, 1)
				U.pad(f, 6)
				U.label(f, n > 0 and cd.name or "???", 13, n > 0 and T.Text or T.Sub, { Font = Enum.Font.GothamBold })
				U.label(f, n > 0 and (cd.rarity .. " ×" .. n) or "Unknown", 11, n > 0 and Config.RarityColor[cd.rarity] or T.Sub, { Position = UDim2.fromOffset(0, 30) })
			end
		end
		refresh()
		return {
			refresh = function(k) if k == "profile" and not reveal then local keep = root.CanvasPosition; refresh(); root.CanvasPosition = keep end end,
			back = function() if reveal then reveal.shown = #reveal.cards; reveal = nil; refresh() return true end return false end,
		}
	end)

	-- =============== DAILY ===============
	App.Register("Daily", "DAILY REWARDS", T.Green, function(body: Frame)
		local root = U.scroll(body)
		U.list(root, Enum.FillDirection.Vertical, 10)
		U.pad(root, 4)
		local countdown: TextLabel? = nil
		local busy = false
		local refresh
		refresh = function()
			local p = U.Store.profile
			local st = p.dailyStatus
			U.clear(root)
			if st.missed then
				local m = U.card(root, { LayoutOrder = 1, BackgroundColor3 = Color3.fromRGB(60, 40, 20) })
				U.pad(m, 10)
				U.label(m, "⚠ You missed a day, so the track restarted at Day 1. Claim every day to reach the Day 7 prize.", 14, T.Gold)
			end
			local grid = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = root })
			local cols = U.Layout.compact and (U.Layout.portrait and 2 or 4) or 7
			U.new("UIGridLayout", { CellSize = UDim2.new(1 / cols, -8, 0, 130), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
			for day, r in ipairs(Config.Daily) do
				local claimed = day <= st.day
				local ready = st.ready and day == st.nextDay
				local state = claimed and "CLAIMED" or ready and "READY" or "LOCKED"
				local c = U.new("Frame", { Name = "Day" .. day, BackgroundColor3 = r.special and Color3.fromRGB(60, 40, 90) or T.Panel2, LayoutOrder = day, Parent = grid })
				U.corner(c, 12)
				U.stroke(c, ready and T.Green or claimed and T.Cyan or (r.special and T.Gold or T.Line), ready and 3 or 1)
				U.pad(c, 8)
				U.list(c, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center)
				U.label(c, "DAY " .. day .. (r.special and " ★" or ""), 15, r.special and T.Gold or T.Text, { Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1 })
				U.label(c, rewardText(r), 13, T.Text, { TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 2 })
				if r.special then U.label(c, "SPECIAL PRIZE", 11, T.Gold, { Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 4 }) end
				U.chip(c, (claimed and "✔ " or ready and "● " or "🔒 ") .. state, claimed and T.Cyan or ready and T.Green or Color3.fromRGB(110, 106, 140), 3)
				if claimed or not ready then c.BackgroundTransparency = claimed and 0.3 or 0.15 end
			end
			local claim = U.btn(root, busy and "Claiming…" or (st.ready and ("Claim Day " .. st.nextDay .. " reward") or "Claimed today"), { name = "Claim", order = 3, size = UDim2.new(1, 0, 0, 48), primary = st.ready, color = T.Green, textSize = 17 })
			if not st.ready or busy then U.setEnabled(claim, false) end
			claim.Activated:Connect(function()
				if busy or not st.ready then return end
				busy = true; refresh()
				local r = U.Request("ClaimDaily")
				busy = false
				if r.ok then U.Toast(r.msg, "good") else U.Toast(r.err, "bad") end
				refresh()
			end)
			countdown = U.label(root, "", 14, T.Sub, { LayoutOrder = 4, TextXAlignment = Enum.TextXAlignment.Center })
		end
		local function tick()
			local st = U.Store.profile.dailyStatus
			if countdown then
				local left = st.nextAt - U.Now()
				countdown.Text = st.ready and ("Ready now · next day unlocks in " .. U.fmtTime(left)) or ("Next claim in " .. U.fmtTime(left) .. " · miss a full day and the track restarts")
			end
		end
		refresh(); tick()
		return { refresh = function(k) if k == "profile" then refresh() end tick() end, focus = root:FindFirstChild("Claim") }
	end)

	-- =============== CODES ===============
	App.Register("Codes", "REDEEM CODES", T.Gold, function(body: Frame)
		local root = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = body })
		U.list(root, Enum.FillDirection.Vertical, 10)
		local returnTo = App.CodesReturn
		App.CodesReturn = nil
		if returnTo then
			local back = U.btn(root, "← Back to Shop", { name = "BackToShop", order = 0, size = UDim2.fromOffset(170, 40) })
			back.Activated:Connect(function() App.Open(returnTo) end)
		end
		U.label(root, "Enter a code to claim free rewards. Spaces and letter case don't matter.", 14, T.Sub, { LayoutOrder = 1 })
		local hint = U.card(root, { LayoutOrder = 2 })
		U.pad(hint, 10)
		U.label(hint, "💡 Try the sample code  NEONSTART  (also DRIFTKING). SUMMER24 has expired.", 14, T.Gold)
		local row = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 3, Parent = root })
		local box = U.new("TextBox", { Name = "CodeBox", Text = CodeState.text, PlaceholderText = "Enter code", ClearTextOnFocus = false, TextSize = 18, Font = Enum.Font.GothamBold, TextColor3 = T.Text, PlaceholderColor3 = T.Sub, BackgroundColor3 = T.Panel, Size = UDim2.new(1, -150, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, SelectionImageObject = U.SelectionImage, Parent = row })
		U.corner(box, 10); U.stroke(box, T.Gold, 1); U.pad(box, 12, 0)
		local redeem = U.btn(row, "Redeem", { name = "Redeem", size = UDim2.new(0, 140, 1, 0), primary = true, color = T.Gold })
		redeem.Position = UDim2.new(1, -140, 0, 0)
		local status = U.label(root, "", 16, T.Text, { LayoutOrder = 4, Font = Enum.Font.GothamBold })
		local function render()
			local left = CodeState.retryAt - os.clock()
			if CodeState.busy then
				redeem.Text = "Checking…"; U.setEnabled(redeem, false)
				status.Text = "⏳ Checking code with the server…"; status.TextColor3 = T.Sub
			elseif left > 0 then
				redeem.Text = "Wait " .. math.ceil(left) .. "s"; U.setEnabled(redeem, false)
				status.Text = "⏳ Too many attempts. Try again in " .. math.ceil(left) .. "s"; status.TextColor3 = T.Gold
			else
				redeem.Text = "Redeem"; U.setEnabled(redeem, true)
				status.Text = CodeState.status
				status.TextColor3 = CodeState.kind == "good" and T.Green or CodeState.kind == "bad" and T.Red or T.Sub
			end
		end
		box:GetPropertyChangedSignal("Text"):Connect(function() CodeState.text = box.Text end)
		local function submit()
			if CodeState.busy then
				CodeState.status = "Busy · still checking your last code"; CodeState.kind = "bad"; render()
				return
			end
			if CodeState.retryAt > os.clock() then render() return end
			local text = box.Text
			if (text:gsub("%s", "")) == "" then
				CodeState.status = "✖ Enter a code first"; CodeState.kind = "bad"; render()
				return
			end
			CodeState.busy = true; render()
			local r = U.Request("Redeem", { code = text })
			CodeState.busy = false
			if r.ok then
				CodeState.status = "✔ " .. r.msg; CodeState.kind = "good"
				box.Text = ""
			else
				local prefix = ({ invalid = "✖ Invalid: ", expired = "⌛ Expired: ", used = "✖ Already used: ", busy = "⏳ Busy: ", limited = "⏳ Rate limited: ", empty = "✖ " })[r.code or ""] or "✖ "
				CodeState.status = prefix .. (r.err or "Failed"); CodeState.kind = "bad"
				if r.retry then CodeState.retryAt = os.clock() + r.retry end
			end
			render()
		end
		redeem.Activated:Connect(function() if redeem.Active then submit() end end)
		box.FocusLost:Connect(function(enter) if enter then submit() end end)
		render()
		return {
			refresh = function() render() end,
			focus = box,
			back = function()
				if returnTo then App.Open(returnTo) return true end
				return false
			end,
		}
	end)

	-- =============== QUESTS / BOOSTS / OFFER ===============
	App.Register("Quests", "QUESTS & BOOSTS", T.Pink, function(body: Frame)
		local root = U.scroll(body)
		U.list(root, Enum.FillDirection.Vertical, 8)
		U.pad(root, 4)
		local timers: { [TextLabel]: () -> string } = {}
		local busy = false
		local function act(a: string, args: any?)
			if busy then return end
			busy = true
			local r = U.Request(a, args)
			busy = false
			if r.ok then U.Toast(r.msg, "good") else U.Toast(r.err, "bad") end
		end
		local refresh
		refresh = function()
			local p = U.Store.profile
			U.clear(root)
			timers = {}
			-- timed offer
			local o = Config.Offer
			local left = p.offer.expires - U.Now()
			local eligible = not p.offer.bought and left > 0
			local oc = U.card(root, { LayoutOrder = 1, BackgroundColor3 = Color3.fromRGB(56, 20, 60) })
			local ost = oc:FindFirstChildOfClass("UIStroke"); if ost then ost.Color = T.Pink; ost.Thickness = 2 end
			U.pad(oc, 12)
			U.list(oc, Enum.FillDirection.Vertical, 4)
			U.label(oc, "⏱ LIMITED OFFER · " .. o.name, 17, T.Text, { Font = Enum.Font.GothamBlack, LayoutOrder = 1 })
			U.label(oc, o.desc .. "  ·  Price 💎 " .. o.price .. " Gems · one per player", 14, T.Sub, { LayoutOrder = 2 })
			local ol = U.label(oc, "", 14, T.Gold, { LayoutOrder = 3, Font = Enum.Font.GothamBold })
			timers[ol] = function()
				if p.offer.bought then return "✔ Purchased · no longer available" end
				local l = U.Store.profile.offer.expires - U.Now()
				if l <= 0 then return "Expired · offer no longer available" end
				return "Ends in " .. U.fmtTime(l) .. (U.Store.profile.gems < o.price and " · need 💎 " .. (o.price - U.Store.profile.gems) .. " more" or " · eligible")
			end
			local ob = U.btn(oc, eligible and ("Buy for 💎 " .. o.price) or (p.offer.bought and "Purchased" or "Expired"), { name = "BuyOffer", order = 4, size = UDim2.fromOffset(180, 40), primary = eligible, color = T.Pink })
			if not eligible then U.setEnabled(ob, false) end
			ob.Activated:Connect(function()
				if not eligible then return end
				U.Confirm({ title = "Buy " .. o.name .. "?", body = o.desc, price = "Price: 💎 " .. o.price .. " Gems", confirmText = "Buy" }, function() act("BuyOffer") end)
			end)
			-- boosts
			U.label(root, "BOOSTS", 14, T.Sub, { Font = Enum.Font.GothamBold, LayoutOrder = 2 })
			for i, perk in ipairs(Config.Perks) do
				local active = (p.perks[perk.id] or 0) > U.Now()
				local c = U.card(root, { LayoutOrder = 2 + i })
				U.pad(c, 10)
				U.label(c, "⚡ " .. perk.name .. " · " .. perk.desc, 15, T.Text, { Font = Enum.Font.GothamBold, Size = UDim2.new(1, -170, 0, 0) })
				local tl = U.label(c, "", 13, active and T.Green or T.Sub, { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, -170, 0, 0) })
				timers[tl] = function()
					local l = (U.Store.profile.perks[perk.id] or 0) - U.Now()
					return l > 0 and ("ACTIVE · " .. U.fmtTime(l) .. " left") or ("Price 💎 " .. perk.price .. " Gems")
				end
				local b = U.btn(c, active and "Active" or ("Buy 💎 " .. perk.price), { name = "Perk_" .. perk.id, size = UDim2.fromOffset(150, 40), primary = not active, color = T.Cyan })
				b.AnchorPoint = Vector2.new(1, 0)
				b.Position = UDim2.new(1, 0, 0, 0)
				if active then U.setEnabled(b, false) end
				b.Activated:Connect(function()
					if active then return end
					U.Confirm({ title = "Activate " .. perk.name .. "?", body = perk.desc, price = "Price: 💎 " .. perk.price .. " Gems", confirmText = "Activate" }, function() act("BuyPerk", { id = perk.id }) end)
				end)
			end
			U.label(root, "QUESTS", 14, T.Sub, { Font = Enum.Font.GothamBold, LayoutOrder = 10 })
			for i, q in ipairs(Config.Quests) do
				local prog = math.min(p.stats[q.stat] or 0, q.goal)
				local done = prog >= q.goal
				local claimed = p.quests[q.id] == true
				local c = U.card(root, { LayoutOrder = 10 + i })
				U.pad(c, 10)
				U.list(c, Enum.FillDirection.Vertical, 4)
				U.label(c, q.name .. " · " .. q.desc, 15, T.Text, { Font = Enum.Font.GothamBold, LayoutOrder = 1 })
				local bar = U.new("Frame", { BackgroundColor3 = T.Bg, Size = UDim2.new(1, 0, 0, 8), LayoutOrder = 2, Parent = c })
				U.corner(bar, 4)
				U.corner(U.new("Frame", { BackgroundColor3 = done and T.Green or T.Pink, Size = UDim2.fromScale(prog / q.goal, 1), Parent = bar }), 4)
				U.label(c, string.format("%d / %d · Reward 💰 %s + 💎 %d", prog, q.goal, Config.FormatNumber(q.coins), q.gems), 13, T.Sub, { LayoutOrder = 3 })
				local b = U.btn(c, claimed and "✔ Claimed" or done and "Claim reward" or "In progress", { name = "Quest_" .. q.id, order = 4, size = UDim2.fromOffset(150, 38), primary = done and not claimed, color = T.Green })
				if claimed or not done then U.setEnabled(b, false) end
				b.Activated:Connect(function() if done and not claimed then act("ClaimQuest", { id = q.id }) end end)
			end
		end
		local function tick() for lbl, fn in pairs(timers) do lbl.Text = fn() end end
		refresh(); tick()
		return { refresh = function(k) if k == "profile" then local keep = root.CanvasPosition; refresh(); root.CanvasPosition = keep end tick() end }
	end)
end
]]></ProtectedString>
						<string name="ScriptGuid">{83519519-63A7-4C1D-BE90-B73B0FD2B2AD}</string>
