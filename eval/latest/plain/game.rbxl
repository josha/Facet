						<ProtectedString name="Source"><![CDATA[--!strict
-- Screen layout, HUD, navigation, panel manager, toasts and confirmations.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local CAS = game:GetService("ContextActionService")
local U = require(script.Parent.Util)
local Config = U.Config
local T = U.T

local App = {}
App.Panels = {} :: { [string]: any }
App.NavButtons = {} :: { [string]: TextButton }

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

local gui = U.new("ScreenGui", { Name = "NeonUI", ResetOnSpawn = false, IgnoreGuiInset = false, ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 5, Parent = pg })
local modalGui = U.new("ScreenGui", { Name = "NeonModal", ResetOnSpawn = false, ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets, DisplayOrder = 40, Parent = pg })
App.Gui = gui
App.ModalGui = modalGui

-- ===== HUD top bar =====
local top = U.new("Frame", { Name = "TopBar", BackgroundTransparency = 1, Size = UDim2.new(1, -16, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.fromOffset(8, 6), Parent = gui })
local topList = U.list(top, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
topList.Wraps = true
App.Top = top

local function pill(name: string, order: number, accent: Color3, minW: number?): (Frame, TextLabel)
	local f = U.new("Frame", { Name = name, BackgroundColor3 = T.Panel, BackgroundTransparency = 0.08, Size = UDim2.fromOffset(minW or 0, 36), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = order, Parent = top })
	U.corner(f, 18)
	U.stroke(f, accent, 1.5, 0.15)
	U.pad(f, 12, 0)
	local l = U.label(f, "", 15, T.Text, { Size = UDim2.fromOffset(0, 36), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center })
	return f, l
end
local lvlPill = U.new("Frame", { Name = "Level", BackgroundColor3 = T.Panel, BackgroundTransparency = 0.08, Size = UDim2.fromOffset(190, 36), LayoutOrder = 1, Parent = top })
U.corner(lvlPill, 18); U.stroke(lvlPill, T.Violet, 1.5, 0.15)
local lvlText = U.label(lvlPill, "Lv 1", 15, T.Text, { Size = UDim2.fromOffset(60, 36), Position = UDim2.fromOffset(12, 0), AutomaticSize = Enum.AutomaticSize.None, Font = Enum.Font.GothamBlack, TextWrapped = false })
local xpBg = U.new("Frame", { BackgroundColor3 = T.Bg, Size = UDim2.new(1, -78, 0, 8), Position = UDim2.new(0, 66, 0, 8), Parent = lvlPill })
U.corner(xpBg, 4)
local xpFill = U.new("Frame", { BackgroundColor3 = T.Violet, Size = UDim2.fromScale(0, 1), Parent = xpBg })
U.corner(xpFill, 4)
local xpText = U.label(lvlPill, "0 / 200 XP", 11, T.Sub, { Size = UDim2.new(1, -78, 0, 14), Position = UDim2.new(0, 66, 0, 18), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
local _, coinText = pill("Coins", 2, T.Gold)
local _, gemText = pill("Gems", 3, T.Gem)
local _, raceText = pill("Races", 4, T.Cyan)
local _, incomeText = pill("Income", 5, T.Green)
local _, zoneText = pill("Zone", 6, T.Pink)
local saveFrame, saveText = pill("Save", 7, T.Line)
App.CoinText = coinText

-- ===== Navigation =====
local nav = U.new("ScrollingFrame", { Name = "Nav", BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = T.Violet, Selectable = false, Parent = gui })
local navList = U.list(nav, Enum.FillDirection.Vertical, 6)
U.pad(nav, 4)
App.Nav = nav
local NAV = {
	{ "Race", "🏁 Race" }, { "Garage", "🏎 Garage" }, { "Shop", "🛒 Shop" }, { "Inventory", "🎒 Inventory" },
	{ "Drivers", "🧑‍🚀 Drivers" }, { "Livery", "🎨 Livery" }, { "Upgrades", "⚙ Upgrades" }, { "Crates", "📦 Crates" },
	{ "Daily", "📅 Daily" }, { "Quests", "🎯 Quests" }, { "Codes", "🔑 Codes" }, { "Party", "👥 Party" },
	{ "Settings", "⚙️ Settings" }, { "Help", "❔ Help" },
}
for i, n in ipairs(NAV) do
	local b = U.btn(nav, n[2], { name = n[1], order = i, size = UDim2.new(1, -8, 0, 42), textSize = 15, color = T.Panel })
	b.TextXAlignment = Enum.TextXAlignment.Left
	U.pad(b, 12, 0)
	App.NavButtons[n[1]] = b
	b.Activated:Connect(function()
		if n[1] == "Help" then
			App.StartTutorial(b)
		else
			U.OpenPanel(n[1], b)
		end
	end)
end
local dailyDot = U.new("Frame", { Name = "ReadyDot", BackgroundColor3 = T.Green, Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Visible = false, Parent = App.NavButtons.Daily })
U.corner(dailyDot, 6)
local dailyReadyText = U.label(App.NavButtons.Daily, "READY", 11, T.Green, { Size = UDim2.fromOffset(50, 14), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -24, 0.5, 0), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.GothamBlack, TextWrapped = false, Visible = false })

-- ===== Panel host =====
local host = U.new("Frame", { Name = "PanelHost", BackgroundTransparency = 1, Visible = false, Parent = gui })
local panel = U.new("Frame", { Name = "Panel", BackgroundColor3 = T.Bg, BackgroundTransparency = 0.04, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), Parent = host })
U.corner(panel, 16)
local panelStroke = U.stroke(panel, T.Cyan, 2, 0.1)
U.new("UISizeConstraint", { MaxSize = Vector2.new(1040, 720), Parent = panel })
local header = U.new("Frame", { Name = "Header", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), Parent = panel })
local titleText = U.label(header, "", 22, T.Text, { Size = UDim2.new(1, -150, 1, 0), Position = UDim2.fromOffset(18, 0), AutomaticSize = Enum.AutomaticSize.None, Font = Enum.Font.GothamBlack, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
local subText = U.label(header, "", 13, T.Sub, { Size = UDim2.new(0, 200, 1, 0), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -66, 0, 0), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false })
local closeBtn = U.btn(header, "✖", { name = "Close", size = UDim2.fromOffset(44, 44), textSize = 20, color = T.Panel2 })
closeBtn.AnchorPoint = Vector2.new(1, 0.5)
closeBtn.Position = UDim2.new(1, -10, 0.5, 0)
U.new("Frame", { BackgroundColor3 = T.Line, BorderSizePixel = 0, Size = UDim2.new(1, -24, 0, 1), Position = UDim2.new(0, 12, 0, 52), Parent = panel })
local body = U.new("Frame", { Name = "Body", BackgroundTransparency = 1, Size = UDim2.new(1, -24, 1, -66), Position = UDim2.fromOffset(12, 60), ClipsDescendants = true, Parent = panel })
App.PanelBody = body
App.PanelSub = subText

local current: any = nil
local currentName: string? = nil
local opener: GuiObject? = nil
local unsub: (() -> ())? = nil
App.CurrentPanel = function(): string? return currentName end

local confirmOpen: any = nil

local function doClose()
	if unsub then unsub(); unsub = nil end
	if current and current.cleanup then pcall(current.cleanup) end
	current = nil
	local closed = currentName
	currentName = nil
	U.clear(body)
	host.Visible = false
	CAS:UnbindAction("NeonPanelBack")
	if App.NavButtons[closed or ""] then App.NavButtons[closed :: string].BackgroundColor3 = T.Panel end
	local o = opener
	opener = nil
	if o and o.Parent and o.Visible then U.Focus(o) else GuiService.SelectedObject = nil end
	U.Emit("panelClosed")
end

local function requestClose()
	if not current then return end
	if current.canClose then
		current.canClose(doClose)
	else
		doClose()
	end
end
App.RequestClose = requestClose
U.ClosePanel = requestClose

closeBtn.Activated:Connect(requestClose)

local function onBack(_: string, state: Enum.UserInputState): Enum.ContextActionResult
	if state ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
	if confirmOpen then
		confirmOpen.cancel()
		return Enum.ContextActionResult.Sink
	end
	if current and current.back and current.back() then return Enum.ContextActionResult.Sink end
	requestClose()
	return Enum.ContextActionResult.Sink
end

function App.Open(name: string, from: GuiObject?)
	local def = App.Panels[name]
	if not def then return end
	if U.Store.driving and name ~= "Results" then
		U.Toast("Finish driving first", "warn")
		return
	end
	local function go()
		if current then
			-- switching panels keeps the original opener for focus restore
			if unsub then unsub(); unsub = nil end
			if current.cleanup then pcall(current.cleanup) end
			if App.NavButtons[currentName or ""] then App.NavButtons[currentName :: string].BackgroundColor3 = T.Panel end
			U.clear(body)
		else
			opener = from or (GuiService.SelectedObject :: GuiObject?)
		end
		currentName = name
		titleText.Text = def.title
		subText.Text = ""
		panelStroke.Color = def.accent or T.Cyan
		host.Visible = true
		if App.NavButtons[name] then App.NavButtons[name].BackgroundColor3 = T.Panel2 end
		current = def.build(body, { name = name }) or {}
		if current.refresh then
			unsub = U.On(function(kind)
				if current and current.refresh and (kind == "profile" or kind == "race" or kind == "tick") then
					-- keep controller focus on the same control when a panel rebuilds
					local sel = GuiService.SelectedObject
					local selName = sel and sel:IsDescendantOf(body) and sel.Name
					current.refresh(kind)
					if selName and (not sel or not sel:IsDescendantOf(body)) then
						local again = body:FindFirstChild(selName, true)
						if again and again:IsA("GuiObject") then GuiService.SelectedObject = again end
					end
				end
			end)
		end
		CAS:BindActionAtPriority("NeonPanelBack", onBack, false, 3000, Enum.KeyCode.ButtonB)
		task.defer(function()
			if current and current.focus then U.Focus(current.focus) else U.Focus(closeBtn) end
		end)
		U.Emit("panelOpened")
	end
	if current and current.canClose and currentName ~= name then
		current.canClose(go)
	else
		go()
	end
end
U.OpenPanel = App.Open

function App.Register(name: string, title: string, accent: Color3, build: (Frame, any) -> any)
	App.Panels[name] = { title = title, accent = accent, build = build }
end

-- ===== Toasts =====
local toastHost = U.new("Frame", { Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 96), Size = UDim2.new(0.9, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 20, Parent = modalGui })
U.new("UISizeConstraint", { MaxSize = Vector2.new(460, math.huge), Parent = toastHost })
U.list(toastHost, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
U.Toast = function(text: string, kind: string?)
	local color = kind == "good" and T.Green or kind == "warn" and T.Gold or kind == "bad" and T.Red or T.Cyan
	local f = U.new("Frame", { BackgroundColor3 = T.Panel, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = toastHost })
	U.corner(f, 10)
	U.stroke(f, color, 2)
	U.pad(f, 12, 8)
	U.label(f, text, 15, T.Text, { TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold })
	task.delay(3.2, function() f:Destroy() end)
end

-- ===== Confirm dialog =====
U.Confirm = function(opts: any, onYes: () -> (), onNo: (() -> ())?)
	if confirmOpen then confirmOpen.cancel() end
	local prevSel = GuiService.SelectedObject
	local overlay = U.new("TextButton", { Name = "ConfirmOverlay", Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1), Selectable = false, ZIndex = 30, Parent = modalGui })
	local box = U.new("Frame", { BackgroundColor3 = T.Panel, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.9, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 31, Parent = overlay })
	U.new("UISizeConstraint", { MaxSize = Vector2.new(440, 600), Parent = box })
	U.corner(box, 14)
	U.stroke(box, opts.danger and T.Red or T.Cyan, 2)
	U.pad(box, 18)
	U.list(box, Enum.FillDirection.Vertical, 12)
	U.label(box, opts.title or "Confirm", 20, T.Text, { Font = Enum.Font.GothamBlack, LayoutOrder = 1, ZIndex = 32 })
	U.label(box, opts.body or "", 16, T.Sub, { LayoutOrder = 2, ZIndex = 32 })
	if opts.price then
		U.label(box, opts.price, 22, T.Gold, { Font = Enum.Font.GothamBlack, LayoutOrder = 3, ZIndex = 32 })
	end
	local row = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 4, ZIndex = 32, Parent = box })
	U.list(row, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right)
	local cancel = U.btn(row, opts.cancelText or "Cancel", { size = UDim2.new(0.5, -5, 0, 46), order = 1 })
	local yes = U.btn(row, opts.confirmText or "Confirm", { size = UDim2.new(0.5, -5, 0, 46), order = 2, primary = true, color = opts.danger and T.Red or T.Cyan })
	cancel.ZIndex = 33; yes.ZIndex = 33
	local done = false
	local function close()
		done = true
		confirmOpen = nil
		overlay:Destroy()
		CAS:UnbindAction("NeonConfirmBack")
		if prevSel and prevSel.Parent then U.Focus(prevSel :: GuiObject) end
	end
	local state = {}
	state.cancel = function()
		if done then return end
		close()
		if onNo then onNo() end
	end
	confirmOpen = state
	cancel.Activated:Connect(state.cancel)
	yes.Activated:Connect(function()
		if done then return end
		close()
		onYes()
	end)
	CAS:BindActionAtPriority("NeonConfirmBack", function(_, st)
		if st == Enum.UserInputState.Begin then state.cancel() end
		return Enum.ContextActionResult.Sink
	end, false, 4000, Enum.KeyCode.ButtonB)
	task.defer(function()
		if U.IsGamepad() then GuiService.SelectedObject = cancel end
	end)
end
App.IsConfirmOpen = function() return confirmOpen ~= nil end

-- ===== HUD refresh =====
local function refreshHud()
	local p = U.Store.profile
	if not p then return end
	lvlText.Text = "Lv " .. p.level
	local need = Config.XpForLevel(p.level)
	xpFill.Size = UDim2.fromScale(math.clamp(p.xp / need, 0, 1), 1)
	xpText.Text = string.format("%s / %s XP", Config.FormatNumber(p.xp), Config.FormatNumber(need))
	coinText.Text = "💰 " .. Config.Short(p.coins)
	gemText.Text = "💎 " .. Config.Short(p.gems)
	raceText.Text = "🏁 " .. p.races .. (p.races == 1 and " race" or " races")
	local mult = ((p.perks.coin2x or 0) > U.Now()) and "  ×2" or ""
	incomeText.Text = "Last race +" .. Config.FormatNumber(p.lastIncome or 0) .. mult
	local s = p.save or { state = "pending", text = "…" }
	saveText.Text = (s.state == "saved" and "✔ " or s.state == "pending" and "⏳ " or "⚠ ") .. s.text
	saveText.TextColor3 = s.state == "saved" and T.Green or s.state == "pending" and T.Sub or T.Gold
	local ds = p.dailyStatus
	local ready = ds and ds.ready
	dailyDot.Visible = ready == true
	dailyReadyText.Visible = ready == true
end
App.SetZone = function(text: string)
	zoneText.Text = text
end
App.SetZone("📍 Hub")
U.On(function(kind) if kind == "profile" or kind == "tick" then refreshHud() end end)

-- ===== Layout =====
local function layout()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vp = gui.AbsoluteSize
	if vp.X < 2 then vp = cam.ViewportSize end
	local w, h = vp.X, vp.Y
	local compact = w < 760 or h < 520
	local portrait = h > w
	local topNav = compact or UIS.TouchEnabled
	U.Layout.compact = compact
	U.Layout.portrait = portrait
	U.Layout.topNav = topNav
	U.Layout.w = w
	U.Layout.h = h
	-- HUD pills shrink on compact
	incomeText.Parent.Visible = not (compact and portrait)
	saveFrame.Visible = true
	local topH = top.AbsoluteSize.Y + 8
	if topNav then
		nav.Position = UDim2.fromOffset(4, topH + 4)
		nav.Size = UDim2.new(1, -8, 0, 52)
		nav.ScrollingDirection = Enum.ScrollingDirection.X
		nav.AutomaticCanvasSize = Enum.AutomaticSize.X
		navList.FillDirection = Enum.FillDirection.Horizontal
		for _, b in pairs(App.NavButtons) do b.Size = UDim2.fromOffset(122, 42) end
		host.Position = UDim2.fromOffset(4, topH + 60)
		host.Size = UDim2.new(1, -8, 1, -(topH + 64))
	else
		nav.Position = UDim2.fromOffset(4, topH + 4)
		nav.Size = UDim2.new(0, 176, 1, -(topH + 8))
		nav.ScrollingDirection = Enum.ScrollingDirection.Y
		nav.AutomaticCanvasSize = Enum.AutomaticSize.Y
		navList.FillDirection = Enum.FillDirection.Vertical
		for _, b in pairs(App.NavButtons) do b.Size = UDim2.new(1, -8, 0, 42) end
		host.Position = UDim2.fromOffset(186, topH + 4)
		host.Size = UDim2.new(1, -194, 1, -(topH + 12))
	end
	nav.CanvasSize = UDim2.new()
	U.Emit("layout")
end
App.Layout = layout
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
top:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
task.defer(layout)

function App.SetHubVisible(visible: boolean)
	nav.Visible = visible
	if not visible and current then doClose() end
end

-- ===== Prompts in world =====
local ProximityPromptService = game:GetService("ProximityPromptService")
ProximityPromptService.PromptTriggered:Connect(function(prompt)
	local pad = prompt.Parent
	if pad and pad:GetAttribute("Panel") then
		App.Open(pad:GetAttribute("Panel"))
	end
end)

-- controller: L1 jumps into the menu so every panel is reachable without a pointer
CAS:BindAction("NeonFocusMenu", function(_, st)
	if st ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
	if U.Store.driving or not nav.Visible then return Enum.ContextActionResult.Pass end
	if current then
		GuiService.SelectedObject = closeBtn
	else
		GuiService.SelectedObject = App.NavButtons.Race
	end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.ButtonL1)

App.StartTutorial = function(_from: GuiObject?) end

return App
]]></ProtectedString>
						<string name="ScriptGuid">{5840B3BA-1F84-47B7-AAD1-EFD8EAC046DB}</string>
