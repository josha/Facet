						<ProtectedString name="Source"><![CDATA[--!strict
-- Client mirror of server-confirmed state. Panels read from here and re-render on change.
local RS = game:GetService("ReplicatedStorage")
local Net = RS:WaitForChild("Net")
local RProfile = Net:WaitForChild("Profile") :: RemoteEvent
local RLobby = Net:WaitForChild("Lobby") :: RemoteEvent
local RCall = Net:WaitForChild("Call") :: RemoteFunction
local Config = require(RS.Shared.Config)

local Store = {}
Store.profile = nil :: any
Store.lobby = nil :: any
Store.profileChanged = Instance.new("BindableEvent")
Store.lobbyChanged = Instance.new("BindableEvent")
Store.mode = "hub" -- hub | race | preview
Store.modeChanged = Instance.new("BindableEvent")

function Store.now(): number
	return workspace:GetServerTimeNow()
end

function Store.setMode(m: string)
	if Store.mode == m then return end
	Store.mode = m
	Store.modeChanged:Fire(m)
end

RProfile.OnClientEvent:Connect(function(p)
	Store.profile = p
	Store.profileChanged:Fire(p)
end)

RLobby.OnClientEvent:Connect(function(s)
	Store.lobby = s
	Store.lobbyChanged:Fire(s)
end)

-- Ask the server to do something. Returns the confirmed result table.
function Store.call(action: string, payload: any?): any
	local ok, res = pcall(function()
		return RCall:InvokeServer(action, payload)
	end)
	if not ok or type(res) ~= "table" then
		return { ok = false, err = "Connection problem. Nothing changed." }
	end
	return res
end

function Store.whenReady(): any
	while not Store.profile do
		Store.profileChanged.Event:Wait()
	end
	return Store.profile
end

function Store.affordable(price: { [string]: number }): boolean
	local p = Store.profile
	if not p then return false end
	return p.credits >= (price.credits or 0) and p.shards >= (price.shards or 0)
end

function Store.walletLine(): string
	local p = Store.profile
	if not p then return "" end
	return "Your balance: " .. Config.Comma(p.credits) .. " Credits · " .. Config.Comma(p.shards) .. " Shards"
end

function Store.myKey(): string
	return "p" .. game:GetService("Players").LocalPlayer.UserId
end

return Store
]]></ProtectedString>
