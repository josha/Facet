				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Builds the neon kart model used by races, previews and the hub showroom.
local Config = require(script.Parent.Config)

local KartBuilder = {}

export type Look = { body: string, bodyShade: number, accent: string, accentShade: number, decal: string }

local DARK = Color3.fromRGB(18, 20, 32)

local function part(model: Model, root: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	if shape then p.Shape = shape end
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Anchored = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = root.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = p
	w.Parent = p
	p.Parent = model
	return p
end

local function wedge(model: Model, root: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material): BasePart
	local p = Instance.new("WedgePart")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CFrame = root.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = p
	w.Parent = p
	p.Parent = model
	return p
end

local function addDecal(surfacePart: BasePart, decal: string, color: Color3)
	if decal == "None" then return end
	local sg = Instance.new("SurfaceGui")
	sg.Name = "Decal"
	sg.Face = Enum.NormalId.Top
	sg.CanvasSize = Vector2.new(200, 300)
	sg.LightInfluence = 0
	sg.Brightness = 2
	sg.Parent = surfacePart
	local function bar(pos: UDim2, size: UDim2, rot: number?)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = color
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = pos
		f.Size = size
		f.Rotation = rot or 0
		f.Parent = sg
		return f
	end
	if decal == "Stripe" then
		bar(UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.22, 1))
	elseif decal == "Twin" then
		bar(UDim2.fromScale(0.33, 0.5), UDim2.fromScale(0.1, 1))
		bar(UDim2.fromScale(0.67, 0.5), UDim2.fromScale(0.1, 1))
	elseif decal == "Checker" then
		for r = 0, 3 do
			for c = 0, 3 do
				if (r + c) % 2 == 0 then
					bar(UDim2.fromScale(0.125 + c * 0.25, 0.3 + r * 0.13), UDim2.fromScale(0.25, 0.13))
				end
			end
		end
	elseif decal == "Ring" then
		local f = bar(UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(130, 130))
		f.BackgroundTransparency = 1
		local c = Instance.new("UICorner") c.CornerRadius = UDim.new(1, 0) c.Parent = f
		local s = Instance.new("UIStroke") s.Color = color s.Thickness = 16 s.Parent = f
	elseif decal == "Number" then
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 0.6)
		t.Position = UDim2.fromScale(0, 0.2)
		t.Text = "77"
		t.TextScaled = true
		t.Font = Enum.Font.Michroma
		t.TextColor3 = color
		t.Rotation = 180
		t.Parent = sg
	elseif decal == "Chevron" then
		for i = 0, 2 do
			bar(UDim2.fromScale(0.32, 0.3 + i * 0.2), UDim2.fromScale(0.5, 0.06), 35)
			bar(UDim2.fromScale(0.68, 0.3 + i * 0.2), UDim2.fromScale(0.5, 0.06), -35)
		end
	end
end

-- Returns a model whose anchored PrimaryPart "Root" sits on the road surface. Move it by setting Root.CFrame.
function KartBuilder.Build(kartId: string, look: Look?, cosmetic: string?): Model
	local kart = Config.FindById(Config.Karts, kartId) or Config.Karts[1]
	local lv: Look = look or (Config.DefaultLivery :: any)
	local body = Config.HueColor(lv.body, lv.bodyShade)
	local accent = Config.HueColor(lv.accent, lv.accentShade)
	local sh = kart.shape
	local L, W = sh.len, sh.wid

	local model = Instance.new("Model")
	model.Name = "Kart_" .. kart.id
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(W, 0.2, L)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root

	local chassis = part(model, root, "Chassis", Vector3.new(W, 0.9, L), CFrame.new(0, 1.05, 0), body, Enum.Material.SmoothPlastic)
	addDecal(chassis, lv.decal, accent)
	wedge(model, root, "Nose", Vector3.new(W * 0.85, 0.8, L * 0.32), CFrame.new(0, 1.0, -L / 2 - L * 0.16) , body, Enum.Material.SmoothPlastic)
	part(model, root, "Floor", Vector3.new(W + 0.4, 0.25, L + 0.6), CFrame.new(0, 0.5, 0), DARK, Enum.Material.Metal)
	local cockpit = part(model, root, "Cockpit", Vector3.new(W * 0.5, 0.8, L * 0.32), CFrame.new(0, 1.85, L * 0.12), Color3.fromRGB(10, 12, 24), Enum.Material.Glass)
	cockpit.Transparency = 0.15
	part(model, root, "Helmet", Vector3.new(1.4, 1.4, 1.4), CFrame.new(0, 2.6, L * 0.14), Color3.fromRGB(235, 240, 255), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	part(model, root, "Visor", Vector3.new(1.1, 0.45, 0.3), CFrame.new(0, 2.65, L * 0.14 - 0.6), accent, Enum.Material.Neon)
	for _, side in { -1, 1 } do
		part(model, root, "Strip", Vector3.new(0.18, 0.22, L * 0.95), CFrame.new(side * (W / 2 + 0.05), 1.1, 0), accent, Enum.Material.Neon)
		for _, zs in { -1, 1 } do
			local wh = part(model, root, "Wheel", Vector3.new(0.9, 1.6, 1.6), CFrame.new(side * (W / 2 + 0.35), 0.8, zs * L * 0.36), DARK, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
			part(model, root, "Rim", Vector3.new(0.92, 0.9, 0.9), wh.CFrame:ToObjectSpace(wh.CFrame) * CFrame.new(side * (W / 2 + 0.37), 0.8, zs * L * 0.36), accent, Enum.Material.Neon, Enum.PartType.Cylinder)
		end
	end
	local exhaust = part(model, root, "Exhaust", Vector3.new(W * 0.5, 0.5, 0.3), CFrame.new(0, 1.1, L / 2 + 0.1), accent, Enum.Material.Neon)
	local flame = part(model, root, "Flame", Vector3.new(W * 0.35, 0.35, 2.4), CFrame.new(0, 1.1, L / 2 + 1.4), Color3.fromRGB(120, 240, 255), Enum.Material.Neon)
	flame.Transparency = 1
	if sh.wing then
		part(model, root, "Wing", Vector3.new(W * 1.05, 0.15, 0.9), CFrame.new(0, 2.5, L / 2 - 0.3), body, Enum.Material.SmoothPlastic)
		part(model, root, "WingEdge", Vector3.new(W * 1.06, 0.1, 0.12), CFrame.new(0, 2.56, L / 2 + 0.1), accent, Enum.Material.Neon)
		for _, side in { -1, 1 } do
			part(model, root, "Strut", Vector3.new(0.2, 0.9, 0.3), CFrame.new(side * W * 0.3, 2.0, L / 2 - 0.3), DARK, Enum.Material.Metal)
		end
	end
	if sh.fins then
		for _, side in { -1, 1 } do
			wedge(model, root, "Fin", Vector3.new(0.2, 1.0, 1.6), CFrame.new(side * W * 0.42, 1.9, L * 0.3), accent, Enum.Material.Neon)
		end
	end
	if sh.pods then
		for _, side in { -1, 1 } do
			part(model, root, "Pod", Vector3.new(1.0, 0.9, L * 0.45), CFrame.new(side * (W / 2 + 0.2), 1.6, L * 0.1), body, Enum.Material.SmoothPlastic, nil)
			part(model, root, "PodGlow", Vector3.new(0.7, 0.6, 0.15), CFrame.new(side * (W / 2 + 0.2), 1.6, L * 0.1 + L * 0.23), accent, Enum.Material.Neon)
		end
	end
	if cosmetic == "glow" then
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(175, 80, 255)
		light.Range = 12
		light.Brightness = 4
		light.Parent = chassis
		part(model, root, "Underglow", Vector3.new(W * 0.9, 0.1, L * 0.9), CFrame.new(0, 0.35, 0), Color3.fromRGB(175, 80, 255), Enum.Material.Neon)
	elseif cosmetic == "trail" then
		local a0 = Instance.new("Attachment") a0.Position = Vector3.new(-W * 0.3, 0, L / 2) a0.Parent = exhaust.Parent and root
		local a1 = Instance.new("Attachment") a1.Position = Vector3.new(W * 0.3, 0.6, L / 2) a1.Parent = root
		local tr = Instance.new("Trail")
		tr.Attachment0 = a0
		tr.Attachment1 = a1
		tr.Color = ColorSequence.new(Color3.fromRGB(30, 230, 255))
		tr.Transparency = NumberSequence.new(0.2, 1)
		tr.Lifetime = 0.6
		tr.LightEmission = 1
		tr.Parent = root
	elseif cosmetic == "halo" then
		part(model, root, "Halo", Vector3.new(0.15, 2.0, 2.0), CFrame.new(0, 3.6, L * 0.14) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 230, 120), Enum.Material.Neon, Enum.PartType.Cylinder)
	elseif cosmetic == "wings" then
		for _, side in { -1, 1 } do
			local wg = wedge(model, root, "AuroraWing", Vector3.new(0.15, 1.6, 3.2), CFrame.new(side * (W / 2 + 0.9), 2.0, L * 0.15) * CFrame.Angles(0, 0, math.rad(side * -30)), Color3.fromRGB(120, 255, 210), Enum.Material.Neon)
			wg.Transparency = 0.25
		end
	end
	return model
end

-- Show or hide the boost flame.
function KartBuilder.SetFlame(model: Model, amount: number)
	local f = model:FindFirstChild("Flame") :: BasePart?
	if f then
		f.Transparency = 1 - math.clamp(amount, 0, 1) * 0.85
	end
end

return KartBuilder
]]></ProtectedString>
