		{ id = "daily", label = "Daily", icon = "📅", color = T.amber, panel = "daily" },
		{ id = "missions", label = "Missions", icon = "⭐", color = T.cyan, panel = "missions" },
		{ id = "party", label = "Party", icon = "👥", color = T.green, panel = "party" },
		{ id = "settings", label = "Settings", icon = "⚙", color = T.muted, panel = "settings" },
		{ id = "help", label = "Help", icon = "?", color = T.cyan, panel = nil },
	}
	for i, it in items do
		local b = new("TextButton", { Name = "Nav_" .. it.id, Text = "", AutoButtonColor = false, BackgroundColor3 = if it.id == "race" then T.magenta else T.panel, BackgroundTransparency = if it.id == "race" then 0 else 0.1, LayoutOrder = i, Selectable = true, Parent = nav })
		UI.corner(b, 12)
		UI.stroke(b, it.color, 1.5, 0.15)
		local icon = UI.label(b, it.icon, 22, { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 6), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = if it.id == "race" then T.bg else it.color, FontFace = UI.F.bold })
		local l = UI.label(b, it.label, 12, { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, -24), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, FontFace = UI.F.bold, TextColor3 = if it.id == "race" then T.bg else T.text })
		local badge = new("TextLabel", { Name = "Badge", Visible = false, BackgroundColor3 = T.red, Text = "!", TextColor3 = Color3.new(1, 1, 1), FontFace = UI.F.bold, Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, -22, 0, 2), Parent = b })
		UI.scaleText(badge, 13)
		UI.corner(badge, 10)
		local sel = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 6, 1, 6), Position = UDim2.fromOffset(-3, -3), Visible = false, Parent = b })
		UI.corner(sel, 14)
		UI.stroke(sel, Color3.new(1, 1, 1), 3, 0)
		b.SelectionImageObject = new("Frame", { BackgroundTransparency = 1 })
		b.SelectionGained:Connect(function() sel.Visible = true end)
		b.SelectionLost:Connect(function() sel.Visible = false end)
		b.Activated:Connect(function()
			App.click()
			App.lastOpener = b
			if it.id == "help" then
				App.startTutorial(b)
			elseif it.panel then
				App.open(it.panel)
			end
		end)
		App.nav[it.id] = { button = b, badge = badge, icon = icon, label = l }
	end

	-- Queue status chip (top-centre)
	local chip = new("Frame", { Name = "QueueChip", Visible = false, BackgroundColor3 = T.panel, BackgroundTransparency = 0.05, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(0, 48), AutomaticSize = Enum.AutomaticSize.X, Parent = root })
	UI.corner(chip, 12)
	UI.stroke(chip, T.magenta, 2, 0)
	UI.pad(chip, 4, 12)
	UI.list(chip, Enum.FillDirection.Horizontal, 10).VerticalAlignment = Enum.VerticalAlignment.Center
	local chipL = UI.label(chip, "", 15, { FontFace = UI.F.bold, Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X, TextYAlignment = Enum.TextYAlignment.Center, LayoutOrder = 1, TextWrapped = false })
	local chipBtn = UI.button(chip, "Open", { size = UDim2.fromOffset(90, 38), color = T.magenta, layoutOrder = 2, textSize = 14 }, function()
		App.open("queue")
	end)

	-- Layout adaptation
	local function relayout(L: any)
		local narrow = L.narrow
		card.Size = UDim2.fromOffset(if narrow then math.min(220, L.w * 0.52) else 300, 0)
		leagueL.Visible = true
		local short = L.short
		grid.CellSize = if short then UDim2.fromOffset(70, 56) else UDim2.fromOffset(78, 66)
		local cols = if short then 2 else 1
		local cw = if short then 70 else 78
		nav.Size = UDim2.new(0, cols * (cw + 6) + 6, 1, if L.touch then -(60 + 150) else -(60 + 20))
		nav.Position = UDim2.new(1, -8, 0, if narrow then 104 else 60)
		chip.Position = UDim2.new(0.5, 0, 0, if narrow then 160 else 8)
		if narrow then
			chip.AnchorPoint = Vector2.new(0, 0)
			chip.Position = UDim2.new(0, 10, 0, 0)
			chip.Position = UDim2.new(0, 10, 0, card.AbsoluteSize.Y + 16)
		else
			chip.AnchorPoint = Vector2.new(0.5, 0)
		end
	end
	App.layoutChanged:Connect(relayout)
	relayout(App.layout)

	-- Data binding
	local function refresh()
		local p = App.profile
		if not p then return end
		creditsL.Text = UI.short(p.soft)
		fluxL.Text = UI.short(p.hard)
		lvl.Text = "LV " .. p.level
		local need = Config.xpForLevel(p.level)
		xpBar.Fill.Size = UDim2.fromScale(math.clamp(p.xp / need, 0, 1), 1)
		xpL.Text = UI.fmt(p.xp) .. " / " .. UI.fmt(need) .. " XP"
		raceL.Text = "Races " .. p.races .. " · Wins " .. p.wins
		local league, base, nextXp = Config.leagueFor(p.totalXp)
		if nextXp > base then
			leagueL.Text = string.format("%s League · %s/%s XP to next zone", league, UI.fmt(p.totalXp - base), UI.fmt(nextXp - base))
			leagueBar.Fill.Size = UDim2.fromScale((p.totalXp - base) / (nextXp - base), 1)
		else
			leagueL.Text = league .. " League · top zone reached"
			leagueBar.Fill.Size = UDim2.fromScale(1, 1)
		end
		incomeL.Text = if p.lastIncome > 0 then ("Last race income +" .. UI.fmt(p.lastIncome) .. " Credits") else "Race to earn Credits, Flux and XP"
		-- badges
		local today = math.floor(App.now() / 86400)
		App.nav.daily.badge.Visible = p.daily.lastDay ~= today
		local claimable = false
		for _, q in Config.Quests do
			local st = p.quests[q.id]
			if st and not st.claimed and st.progress >= q.goal then claimable = true end
		end
		App.nav.missions.badge.Visible = claimable
		App.nav.crates.badge.Visible = p.freeCrates > 0
		App.nav.crates.badge.Text = if p.freeCrates > 0 then tostring(p.freeCrates) else "!"
	end
	App.profileChanged:Connect(refresh)
	local function saveRefresh(s: any)
		local p = App.profile
		local text = s.text
		if s.state == "idle" or text == "" then text = if p and p.save.cloud then "Saved" else "Saved · this session only" end
		local icon = if s.state == "pending" then "◌ " elseif s.state == "failed" then "✕ " else "✓ "
		saveL.Text = icon .. text
		saveL.TextColor3 = if s.state == "failed" then T.red elseif s.state == "pending" then T.amber else T.muted
	end
	App.saveChanged:Connect(saveRefresh)
	saveRefresh(App.save)

	local function queueRefresh()
		local l = App.lobby
		if not l then chip.Visible = false return end
		local uid = App.player.UserId
		local text = nil
		if l.match and table.find(l.match.players, uid) then
			if l.match.phase == "voting" then
				text = "Track vote open · " .. math.max(0, math.ceil(l.match.deadline - App.now())) .. "s"
			else
				local w = Config.getTrack(l.match.winner)
				text = "Next track: " .. (if w then w.name else "?") .. " · loading"
			end
			chipBtn.Text = "Vote"
		else
			for mode, q in l.queues do
				if table.find(q.members, uid) then
					text = string.upper(mode) .. " queue " .. q.joined .. "/" .. q.required
					if q.endsAt then text ..= " · starting in " .. math.max(0, math.ceil(q.endsAt - App.now())) .. "s" elseif l.busy then text ..= " · waiting for track" else text ..= " · waiting for racers" end
					chipBtn.Text = "Queue"
				end
			end
		end
		chip.Visible = text ~= nil and App.current ~= "queue" and not App.inRace
		chipL.Text = text or ""
	end
	App.lobbyChanged:Connect(queueRefresh)
	App.panelChanged:Connect(queueRefresh)
	task.spawn(function()
		while true do
			task.wait(0.5)
			queueRefresh()
		end
	end)

	-- World prompts
	local promptPanels = { RaceGate = "queue", Garage = "garage", Shop = "shop", CrateLab = "crates", DriverLounge = "loadout" }
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local model = prompt.Parent and prompt.Parent.Parent
		if not model then return end
		local panel = promptPanels[model.Name]
		if panel then
			App.lastOpener = nil
			App.open(panel, if model.Name == "DriverLounge" then "drivers" else nil)
		elseif model.Name == "Mechanic" then
			App.startDialogue()
		elseif model.Name == "Bolts" then
			local id = prompt.Parent:GetAttribute("BoltId")
			App.request("pickBolt", { id = id })
		end
	end)
	local bolts = workspace:WaitForChild("Hub"):WaitForChild("Bolts")
	local function boltRefresh()
		local p = App.profile
		if not p then return end
		for _, part in bolts:GetChildren() do
			local id = part:GetAttribute("BoltId")
			local show = p.job.state == "active" and not p.job.bolts[tostring(id)]
			if part:IsA("BasePart") then
				part.Transparency = if show then (if string.find(part.Name, "Beacon") then 0.5 else 0) else 1
				local pr = part:FindFirstChildOfClass("ProximityPrompt")
				if pr then pr.Enabled = show end
			end
		end
	end
	App.profileChanged:Connect(boltRefresh)

	-- Show/hide with race state
	App.setHubVisible = function(on: boolean)
		root.Visible = on
	end
	refresh()
end
]]></ProtectedString>
