				</Item>
				<Item class="ModuleScript" referent="RBXE855C9AD55224BDAAC790B98BB19AB08">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Race queue/vote, Party and Settings panels.
local U = require(script.Parent.Util)
local Config = U.Config
local T = U.T

local RaceState = { mode = "Solo" }
local PartyState = { search = "" }
local SettingsState = { status = "", kind = "info" }

return function(App: any)
	-- =============== RACE QUEUE + VOTE ===============
	App.Register("Race", "RACE PORTAL", T.Violet, function(body: Frame)
		local root = U.scroll(body)
		U.list(root, Enum.FillDirection.Vertical, 10)
		U.pad(root, 4)
		local timerLbl: TextLabel? = nil
		local busy = false
		local refresh
		local function act(a: string, args: any?)
			if busy then return end
			busy = true
			local r = U.Request(a, args)
			busy = false
			if not r.ok then U.Toast(r.err, "bad") end
		end
		refresh = function()
			local rs = U.Store.race or { phase = "idle", joined = 0, required = 1, names = {}, queued = {}, votes = {} }
			local me = U.Player.UserId
			local queued = table.find(rs.queued or {}, me) ~= nil
			U.clear(root)
			timerLbl = nil
			local p = U.Store.profile
			local kart = Config.GetKart(p.selectedKart)
			U.label(root, string.format("Next race: %s · %s driver · %d laps", kart.name, (Config.GetDriver(p.selectedDriver) or { name = "?" }).name, Config.Laps), 14, T.Sub, { LayoutOrder = 1 })
			if rs.phase == "idle" or (rs.phase == "queue" and not queued) then
				local modes = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 64), LayoutOrder = 2, Parent = root })
				U.list(modes, Enum.FillDirection.Horizontal, 8)
				for i, md in ipairs({ { "Solo", "Solo · 1 player + AI" }, { "Duo", "Duo · 2 players (party fills)" } }) do
					local on = RaceState.mode == md[1]
					local locked = rs.phase == "queue" and rs.mode ~= md[1]
					local b = U.btn(modes, md[2], { name = "Mode_" .. md[1], order = i, size = UDim2.new(0.5, -4, 1, 0), color = on and T.Violet or T.Panel2, textSize = 15 })
					if locked then U.setEnabled(b, false) end
					b.Activated:Connect(function() if not locked then RaceState.mode = md[1]; refresh() end end)
				end
				if rs.phase == "queue" then
					U.label(root, "A " .. rs.mode .. " queue is open: " .. rs.joined .. " / " .. rs.required .. " joined.", 14, T.Gold, { LayoutOrder = 3 })
					RaceState.mode = rs.mode
				end
				local partyN = 0
				for _ in pairs(p.party.members) do partyN += 1 end
				if RaceState.mode == "Duo" then
					U.label(root, partyN > 0 and "Your accepted party member will fill the second Duo slot." or "Duo needs 2 players. Invite a demo friend in Party, or wait for another player.", 13, T.Sub, { LayoutOrder = 4 })
				end
				local join = U.btn(root, "Join " .. RaceState.mode .. " queue", { name = "JoinQueue", order = 5, size = UDim2.new(1, 0, 0, 52), primary = true, color = T.Violet, textSize = 18 })
				join.Activated:Connect(function() act("QueueJoin", { mode = RaceState.mode }) end)
				return
			end
			if rs.phase == "queue" then
				local c = U.card(root, { LayoutOrder = 2 })
				U.pad(c, 14)
				U.list(c, Enum.FillDirection.Vertical, 6)
				U.label(c, rs.mode .. " QUEUE", 14, T.Sub, { Font = Enum.Font.GothamBold, LayoutOrder = 1 })
				U.label(c, string.format("%d / %d players joined", rs.joined, rs.required), 24, T.Text, { Font = Enum.Font.GothamBlack, LayoutOrder = 2 })
				U.label(c, "In queue: " .. table.concat(rs.names or {}, ", "), 14, T.Cyan, { LayoutOrder = 3 })
				timerLbl = U.label(c, "", 18, T.Gold, { Font = Enum.Font.GothamBold, LayoutOrder = 4 })
			elseif rs.phase == "vote" or rs.phase == "locked" then
				local counts = {}
				local mine = rs.votes[tostring(me)]
				for _, t in pairs(rs.votes) do counts[t] = (counts[t] or 0) + 1 end
				U.label(root, rs.phase == "vote" and "VOTE FOR THE NEXT TRACK" or "VOTING CLOSED", 16, T.Text, { Font = Enum.Font.GothamBlack, LayoutOrder = 2 })
				timerLbl = U.label(root, "", 16, T.Gold, { Font = Enum.Font.GothamBold, LayoutOrder = 3 })
				for i, t in ipairs(Config.Tracks) do
					local isMine = mine == t.id
					local isWin = rs.winner == t.id
					local b = U.btn(root, "", { name = "Vote_" .. t.id, order = 3 + i, size = UDim2.new(1, -4, 0, 84), color = isWin and Color3.fromRGB(30, 60, 50) or isMine and Color3.fromRGB(44, 36, 90) or T.Panel2, stroke = isWin and T.Green or isMine and t.color or T.Line })
					local st = b:FindFirstChildOfClass("UIStroke"); if st and (isMine or isWin) then st.Thickness = 3 end
					U.new("Frame", { BackgroundColor3 = t.color, Size = UDim2.new(0, 6, 1, -16), Position = UDim2.fromOffset(8, 8), Parent = b }, { U.new("UICorner", { CornerRadius = UDim.new(0, 3) }) })
					U.label(b, t.name .. (isWin and "  ★ WINNER" or "") .. (isMine and "  · your vote" or ""), 17, T.Text, { Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(24, 10), Size = UDim2.new(1, -120, 0, 22), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
					U.label(b, t.desc .. string.format(" (%d m lap)", math.floor(t.length)), 13, T.Sub, { Position = UDim2.fromOffset(24, 36), Size = UDim2.new(1, -120, 0, 40), AutomaticSize = Enum.AutomaticSize.None })
					U.label(b, tostring(counts[t.id] or 0) .. ((counts[t.id] or 0) == 1 and " vote" or " votes"), 18, t.color, { Font = Enum.Font.GothamBlack, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(100, 30), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false })
					if rs.phase ~= "vote" then U.setEnabled(b, false); b.BackgroundTransparency = isWin and 0 or 0.4 end
					b.Activated:Connect(function() if rs.phase == "vote" then act("Vote", { track = t.id }) end end)
				end
				local voters = 0
				for _ in pairs(rs.votes) do voters += 1 end
				U.label(root, voters .. " participant vote(s) so far · includes other racers", 13, T.Sub, { LayoutOrder = 8 })
			else
				U.label(root, rs.phase == "results" and "Race finishing · results showing" or "A race is in progress. You can queue when it ends.", 16, T.Gold, { LayoutOrder = 2 })
			end
			if queued and (rs.phase == "queue" or rs.phase == "vote" or rs.phase == "locked") then
				local leave = U.btn(root, "Leave queue", { name = "LeaveQueue", order = 20, size = UDim2.new(1, 0, 0, 46), stroke = T.Red, textColor = T.Red })
				leave.Activated:Connect(function() act("QueueLeave") end)
			end
		end
		local function tick()
			local rs = U.Store.race
			if not timerLbl or not rs then return end
			local now = U.ServerNow()
			if rs.phase == "queue" then
				timerLbl.Text = rs.launchAt and ("Launching in " .. math.max(0, math.ceil(rs.launchAt - now)) .. "s · leave now to cancel") or ("Waiting for " .. (rs.required - rs.joined) .. " more player(s)…")
			elseif rs.phase == "vote" then
				timerLbl.Text = "Voting closes in " .. math.max(0, math.ceil(rs.voteEnds - now)) .. "s · tap a track to vote or change"
			elseif rs.phase == "locked" then
				local t = Config.GetTrack(rs.winner)
				timerLbl.Text = "Winner: " .. (t and t.name or "?") .. " · loading grid…"
			end
		end
		refresh(); tick()
		return {
			refresh = function(k)
				if k == "race" or k == "profile" then
					local sel = game:GetService("GuiService").SelectedObject
					local selName = sel and sel.Name
					refresh()
					if selName then local f = root:FindFirstChild(selName, true); if f then U.Focus(f :: GuiObject) end end
				end
				tick()
			end,
			focus = root:FindFirstChild("JoinQueue", true) or root:FindFirstChild("LeaveQueue", true),
		}
	end)

	-- =============== PARTY ===============
	App.Register("Party", "PARTY", T.Cyan, function(body: Frame)
		local root = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = body })
		U.list(root, Enum.FillDirection.Vertical, 8)
		local members = U.card(root, { LayoutOrder = 1 })
		U.pad(members, 10)
		local searchRow = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), LayoutOrder = 2, Parent = root })
		local box = U.new("TextBox", { Name = "Search", Text = PartyState.search, PlaceholderText = "Search friends…", ClearTextOnFocus = false, TextSize = 15, Font = Enum.Font.GothamMedium, TextColor3 = T.Text, PlaceholderColor3 = T.Sub, BackgroundColor3 = T.Panel, Size = UDim2.new(1, -90, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, SelectionImageObject = U.SelectionImage, Parent = searchRow })
		U.corner(box, 10); U.stroke(box, T.Line); U.pad(box, 10, 0)
		local clear = U.btn(searchRow, "Clear", { size = UDim2.new(0, 82, 1, 0) })
		clear.Position = UDim2.new(1, -82, 0, 0)
		U.label(root, "Demo participants are simulated so invites can be tried solo: Nova & Tala accept, Kiro declines, Pulse replies after racing, Vex is offline.", 12, T.Sub, { LayoutOrder = 3 })
		local list = U.scroll(root, { Size = UDim2.new(1, 0, 1, -170), LayoutOrder = 4 })
		U.list(list, Enum.FillDirection.Vertical, 6)
		U.pad(list, 4)
		local busy = false
		local refresh
		refresh = function()
			local p = U.Store.profile
			U.clear(members)
			if not members:FindFirstChildOfClass("UIListLayout") then U.list(members, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center) end
			U.label(members, "Your party:", 14, T.Sub, { Size = UDim2.fromOffset(90, 40), AutomaticSize = Enum.AutomaticSize.None, LayoutOrder = 0, Font = Enum.Font.GothamBold })
			U.portrait(members, U.Player.UserId, U.Player.DisplayName, 36).LayoutOrder = 1
			local n = 0
			for _, f in ipairs(Config.DemoFriends) do
				if p.party.members[f.id] then
					n += 1
					local chip = U.new("Frame", { BackgroundColor3 = T.Panel, Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 1 + n, Parent = members })
					U.corner(chip, 20); U.pad(chip, 4, 2)
					U.list(chip, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
					U.portrait(chip, f.thumbId, f.name, 32)
					U.label(chip, f.name, 13, T.Text, { Size = UDim2.fromOffset(0, 32), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, LayoutOrder = 2 })
					local x = U.btn(chip, "✖", { size = UDim2.fromOffset(32, 32), order = 3, textSize = 13 })
					x.Activated:Connect(function() U.Request("Kick", { id = f.id }) end)
				end
			end
			if n == 0 then U.label(members, "just you · invite a friend below", 13, T.Sub, { Size = UDim2.fromOffset(200, 40), AutomaticSize = Enum.AutomaticSize.None, LayoutOrder = 9 }) end
			local keep = list.CanvasPosition
			U.clear(list)
			local q = string.lower(PartyState.search)
			local shown = 0
			for i, f in ipairs(Config.DemoFriends) do
				if q == "" or string.find(string.lower(f.name), q, 1, true) then
					shown += 1
					local inv = p.party.invites[f.id]
					local row = U.card(list, { Name = "Friend_" .. f.id, LayoutOrder = i, AutomaticSize = Enum.AutomaticSize.None, Size = UDim2.new(1, -4, 0, 64) })
					U.portrait(row, f.thumbId, f.name, 46).Position = UDim2.fromOffset(9, 9)
					U.label(row, f.name, 16, T.Text, { Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(66, 10), Size = UDim2.new(1, -240, 0, 20), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
					local sc = f.status == "Online" and T.Green or f.status == "Racing" and T.Gold or Color3.fromRGB(120, 116, 150)
					local chip = U.chip(row, "● " .. f.status, sc)
					chip.Position = UDim2.fromOffset(66, 36)
					local label = inv == "pending" and "Pending…" or inv == "accepted" and "✔ In party" or inv == "declined" and "Declined · Invite again" or f.status == "Offline" and "Offline" or "Invite"
					local eligible = (inv == nil or inv == "declined") and f.status ~= "Offline"
					local b = U.btn(row, label, { name = "Invite_" .. f.id, size = UDim2.fromOffset(160, 42), textSize = 14, primary = eligible, color = T.Cyan, textColor = (not eligible) and (inv == "accepted" and T.Green or inv == "pending" and T.Gold or T.Sub) or nil })
					b.AnchorPoint = Vector2.new(1, 0.5)
					b.Position = UDim2.new(1, -10, 0.5, 0)
					if inv == "pending" or inv == "accepted" or f.status == "Offline" then U.setEnabled(b, false) end
					b.Activated:Connect(function()
						if busy or not b.Active then return end
						busy = true
						local r = U.Request("Invite", { id = f.id })
						busy = false
						if r.ok then U.Toast(r.msg, "info") else U.Toast(r.err, "bad") end
					end)
				end
			end
			if shown == 0 then U.label(list, "No friends match “" .. PartyState.search .. "”. Press Clear.", 15, T.Gold, { LayoutOrder = 1 }) end
			list.CanvasPosition = keep
		end
		box:GetPropertyChangedSignal("Text"):Connect(function() PartyState.search = box.Text; refresh() end)
		clear.Activated:Connect(function() box.Text = "" end)
		refresh()
		return { refresh = function(k) if k == "profile" then refresh() end end, focus = box }
	end)

	-- =============== SETTINGS ===============
	App.Register("Settings", "SETTINGS", T.Cyan, function(body: Frame)
		local root = U.scroll(body)
		U.list(root, Enum.FillDirection.Vertical, 8)
		U.pad(root, 4)
		local draft = table.clone(U.Store.profile.settings)
		local pending = 0
		local statusLbl: TextLabel
		local refresh
		local function setStatus(t: string, k: string)
			SettingsState.status = t; SettingsState.kind = k
			if statusLbl then
				statusLbl.Text = t
				statusLbl.TextColor3 = k == "good" and T.Green or k == "bad" and T.Red or T.Sub
			end
		end
		local sendToken = 0
		local function commit()
			sendToken += 1
			local my = sendToken
			pending += 1
			setStatus("⏳ Saving…", "info")
			App.ApplySettings(draft)
			task.delay(0.35, function()
				if my ~= sendToken then pending -= 1 return end
				local r = U.Request("SaveSettings", { settings = draft })
				pending -= 1
				if r.ok then
					setStatus("✔ Saved · applied", "good")
				else
					setStatus("✖ Couldn't save: " .. (r.err or "error") .. " · restored last saved values", "bad")
					draft = table.clone(U.Store.profile.settings)
					App.ApplySettings(draft)
					refresh()
				end
			end)
		end
		local function slider(name: string, key: string, order: number)
			local c = U.card(root, { LayoutOrder = order })
			U.pad(c, 10)
			U.label(c, name, 15, T.Text, { Font = Enum.Font.GothamBold, Size = UDim2.new(1, -60, 0, 20), AutomaticSize = Enum.AutomaticSize.None })
			local val = U.label(c, "", 15, T.Cyan, { Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(60, 20), Position = UDim2.new(1, -60, 0, 0), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right })
			local row = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 26), Parent = c })
			local minus = U.btn(row, "−", { name = key .. "_Minus", size = UDim2.fromOffset(44, 44), textSize = 22 })
			local plus = U.btn(row, "+", { name = key .. "_Plus", size = UDim2.fromOffset(44, 44), textSize = 22 })
			plus.Position = UDim2.new(1, -44, 0, 0)
			local track = U.new("TextButton", { Name = key .. "_Track", Text = "", AutoButtonColor = false, BackgroundColor3 = T.Bg, Size = UDim2.new(1, -112, 0, 12), Position = UDim2.new(0, 56, 0.5, -6), Selectable = false, Parent = row })
			U.corner(track, 6)
			local fill = U.new("Frame", { BackgroundColor3 = T.Cyan, Size = UDim2.fromScale(draft[key], 1), Parent = track })
			U.corner(fill, 6)
			local knob = U.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(draft[key], 0.5), Parent = track })
			U.corner(knob, 11)
			local function show()
				val.Text = math.floor(draft[key] * 100 + 0.5) .. "%"
				fill.Size = UDim2.fromScale(draft[key], 1)
				knob.Position = UDim2.fromScale(draft[key], 0.5)
			end
			local function set(v: number)
				draft[key] = math.clamp(math.floor(v * 10 + 0.5) / 10, 0, 1)
				show()
				commit()
			end
			minus.Activated:Connect(function() set(draft[key] - 0.1) end)
			plus.Activated:Connect(function() set(draft[key] + 0.1) end)
			local dragging = false
			local UIS = game:GetService("UserInputService")
			local function fromX(x: number)
				local rel = (x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
				draft[key] = math.clamp(math.floor(rel * 10 + 0.5) / 10, 0, 1)
				show()
			end
			track.InputBegan:Connect(function(io)
				if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					fromX(io.Position.X)
				end
			end)
			UIS.InputChanged:Connect(function(io)
				if dragging and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) then fromX(io.Position.X) end
			end)
			UIS.InputEnded:Connect(function(io)
				if dragging and (io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch) then
					dragging = false
					commit()
				end
			end)
			show()
			U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 72), Parent = c })
		end
		local function toggle(name: string, key: string, desc: string, order: number)
			local on = draft[key]
			local b = U.btn(root, "", { name = key, order = order, size = UDim2.new(1, -4, 0, 56), color = T.Panel2 })
			U.label(b, name, 15, T.Text, { Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -110, 0, 20), AutomaticSize = Enum.AutomaticSize.None })
			U.label(b, desc, 12, T.Sub, { Position = UDim2.fromOffset(12, 30), Size = UDim2.new(1, -110, 0, 18), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
			local chip = U.chip(b, on and "ON" or "OFF", on and T.Green or Color3.fromRGB(110, 106, 140))
			chip.AnchorPoint = Vector2.new(1, 0.5)
			chip.Position = UDim2.new(1, -12, 0.5, 0)
			b.Activated:Connect(function()
				draft[key] = not draft[key]
				commit()
				refresh()
				U.Focus(root:FindFirstChild(key) :: GuiObject)
			end)
		end
		local function choice(name: string, key: string, options: { any }, order: number)
			local c = U.card(root, { LayoutOrder = order })
			U.pad(c, 10)
			U.list(c, Enum.FillDirection.Vertical, 6)
			U.label(c, name, 15, T.Text, { Font = Enum.Font.GothamBold, LayoutOrder = 1 })
			local row = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), LayoutOrder = 2, Parent = c })
			U.list(row, Enum.FillDirection.Horizontal, 6)
			for i, o in ipairs(options) do
				local on = draft[key] == o[1]
				local b = U.btn(row, o[2], { name = key .. "_" .. tostring(o[1]), order = i, size = UDim2.new(1 / #options, -5, 1, 0), color = on and T.Cyan or T.Panel, textColor = on and T.Bg or T.Text })
				b.Activated:Connect(function()
					draft[key] = o[1]
					commit()
					refresh()
					U.Focus(root:FindFirstChild(key .. "_" .. tostring(o[1]), true) :: GuiObject)
				end)
			end
		end
		refresh = function()
			local keep = root.CanvasPosition
			U.clear(root)
			statusLbl = U.label(root, SettingsState.status, 14, T.Sub, { LayoutOrder = 0, Font = Enum.Font.GothamBold })
			setStatus(SettingsState.status, SettingsState.kind)
			U.label(root, "AUDIO", 13, T.Sub, { Font = Enum.Font.GothamBold, LayoutOrder = 1 })
			slider("Music volume", "music", 2)
			slider("Effects volume", "sfx", 3)
			U.label(root, "DISPLAY", 13, T.Sub, { Font = Enum.Font.GothamBold, LayoutOrder = 4 })
			choice("Graphics quality", "graphics", { { "Low", "Low" }, { "Medium", "Medium" }, { "High", "High" } }, 5)
			toggle("Damage numbers", "damageNumbers", "Show impact numbers when you bump walls", 6)
			toggle("Camera shake", "cameraShake", "Shake on boosts and impacts", 7)
			U.label(root, "ACCESSIBILITY", 13, T.Sub, { Font = Enum.Font.GothamBold, LayoutOrder = 8 })
			choice("Text size", "textScale", { { 1, "100%" }, { 1.15, "115%" }, { 1.3, "130%" } }, 9)
			toggle("Reduced motion", "reducedMotion", "Removes spins, tweens and camera sway", 10)
			U.label(root, "CONTROLS", 13, T.Sub, { Font = Enum.Font.GothamBold, LayoutOrder = 11 })
			local cc = U.card(root, { LayoutOrder = 12 })
			U.pad(cc, 12)
			U.label(cc, table.concat({
				"Keyboard: W/↑ accelerate · S/↓ brake & reverse · A/D steer · Space drift (release = mini-turbo) · Shift boost · R recover kart · C camera · Tab scoreboard · Q quick chat",
				"Controller: RT accelerate · LT brake · Left stick steer · RB drift · X boost · DPad↓ recover · DPad→ camera · DPad↑ scoreboard · Y quick chat · B back/close",
				"Touch: on-screen ◀ ▶ steer, GAS, BRAKE, DRIFT, BOOST, 🔄 recover, 🏆 scoreboard, 💬 chat buttons",
				"Hub: walk to glowing pads and press E / X, or use the menu buttons.",
			}, "\n\n"), 13, T.Text)
			local reset = U.btn(root, "Reset to defaults", { name = "ResetSettings", order = 13, size = UDim2.new(1, 0, 0, 46), stroke = T.Red, textColor = T.Red })
			reset.Activated:Connect(function()
				U.Confirm({ title = "Reset all settings?", body = "Audio, display and accessibility return to defaults. Cancel changes nothing.", confirmText = "Reset", danger = true }, function()
					setStatus("⏳ Saving…", "info")
					local r = U.Request("ResetSettings")
					if r.ok then
						draft = table.clone(r.settings)
						App.ApplySettings(draft)
						setStatus("✔ Defaults restored and saved", "good")
					else
						setStatus("✖ Reset failed: " .. (r.err or "error"), "bad")
					end
					refresh()
				end)
			end)
			root.CanvasPosition = keep
		end
		refresh()
		return {
			refresh = function(k)
				if k == "profile" and pending == 0 then
					local s = U.Store.profile.settings
					local changed = false
					for key, v in pairs(s) do if draft[key] ~= v then changed = true end end
					if changed then draft = table.clone(s); App.ApplySettings(draft); refresh() end
				end
			end,
			focus = root:FindFirstChild("music_Minus", true),
		}
	end)
end
]]></ProtectedString>
