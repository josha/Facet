				<Item class="ModuleScript" referent="RBXC7E4ACA416B94A62BDF3F6A543F6883C">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Shared interface toolkit: theme, widgets, panels, confirmations, toasts, back/focus routing and text scaling.
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local UIS = game:GetService("UserInputService")
local CAS = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local UI = {}

UI.T = {
	bg = Color3.fromRGB(8, 8, 20),
	panel = Color3.fromRGB(14, 14, 32),
	card = Color3.fromRGB(22, 22, 46),
	card2 = Color3.fromRGB(30, 30, 60),
	line = Color3.fromRGB(60, 60, 110),
	cyan = Color3.fromRGB(30, 230, 255),
	magenta = Color3.fromRGB(255, 60, 200),
	violet = Color3.fromRGB(175, 80, 255),
	amber = Color3.fromRGB(255, 180, 50),
	green = Color3.fromRGB(70, 235, 130),
	red = Color3.fromRGB(255, 80, 100),
	text = Color3.fromRGB(240, 242, 255),
	dim = Color3.fromRGB(160, 165, 205),
	dark = Color3.fromRGB(5, 5, 14),
}
local T = UI.T
UI.Title = Enum.Font.Michroma
UI.Bold = Enum.Font.GothamBold
UI.Body = Enum.Font.GothamMedium

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "NeonUI"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
gui.DisplayOrder = 5
gui.Parent = player:WaitForChild("PlayerGui")
UI.gui = gui

local overlay = Instance.new("ScreenGui")
overlay.Name = "NeonOverlay"
overlay.ResetOnSpawn = false
overlay.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
overlay.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
overlay.DisplayOrder = 20
overlay.Parent = player.PlayerGui
UI.overlay = overlay

-- Text scaling ------------------------------------------------------------
local texts: { [Instance]: number } = setmetatable({}, { __mode = "k" }) :: any
local userScale = 1
local function preferredFactor(): number
	local ok, v = pcall(function() return GuiService.PreferredTextSize end)
	if not ok then return 1 end
	local name = tostring(v)
	if name:find("Largest") then return 1.45 elseif name:find("Larger") then return 1.3 elseif name:find("Large") then return 1.15 end
	return 1
end
function UI.textFactor(): number
	return userScale * preferredFactor()
end
local function applyText(inst: any, base: number)
	inst.TextSize = math.floor(base * UI.textFactor() + 0.5)
end
function UI.setTextScale(pct: number)
	userScale = pct / 100
	for inst, base in texts do
		if inst.Parent then applyText(inst, base) end
	end
end
pcall(function()
	GuiService:GetPropertyChangedSignal("PreferredTextSize"):Connect(function() UI.setTextScale(userScale * 100) end)
end)

local reducedSetting = false
function UI.setReducedMotion(on: boolean) reducedSetting = on end
function UI.reducedMotion(): boolean
	local ok, v = pcall(function() return GuiService.ReducedMotionEnabled end)
	return reducedSetting or (ok and v == true)
end

function UI.tween(inst: Instance, props: { [string]: any }, time: number?)
	if UI.reducedMotion() then
		for k, v in props do (inst :: any)[k] = v end
		return
	end
	TweenService:Create(inst, TweenInfo.new(time or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

-- Sounds ------------------------------------------------------------------
local sfxVolume = 0.7
local sounds: { [string]: Sound } = {}
for name, id in { click = "rbxasset://sounds/electronicpingshort.wav", whoosh = "rbxasset://sounds/electronicpingshort.wav", tick = "rbxasset://sounds/button.wav", snap = "rbxasset://sounds/snap.mp3" } do
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = 0.5
	s.Parent = SoundService
	sounds[name] = s
end
function UI.setSfx(v: number) sfxVolume = v / 100 end
function UI.sfx(name: string, pitch: number?)
	local s = sounds[name]
	if not s or sfxVolume <= 0 then return end
	s.Volume = 0.5 * sfxVolume
	s.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(s)
end

-- Builders ----------------------------------------------------------------
function UI.new(class: string, props: { [string]: any }?, parent: Instance?): any
	local inst = Instance.new(class) :: any
	if props then
		for k, v in props do inst[k] = v end
	end
	if parent then inst.Parent = parent end
	return inst
end

function UI.corner(inst: Instance, r: number?)
	UI.new("UICorner", { CornerRadius = UDim.new(0, r or 10) }, inst)
end
function UI.stroke(inst: Instance, color: Color3?, thick: number?, transp: number?): UIStroke
	return UI.new("UIStroke", { Color = color or T.line, Thickness = thick or 1, Transparency = transp or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, inst)
end
function UI.pad(inst: Instance, a: number, b: number?)
	UI.new("UIPadding", { PaddingLeft = UDim.new(0, b or a), PaddingRight = UDim.new(0, b or a), PaddingTop = UDim.new(0, a), PaddingBottom = UDim.new(0, a) }, inst)
end
function UI.list(inst: Instance, horizontal: boolean?, gap: number?, align: Enum.HorizontalAlignment?, valign: Enum.VerticalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 6), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
	}, inst)
end

function UI.frame(parent: Instance?, props: { [string]: any }?): Frame
	local f = UI.new("Frame", { BackgroundColor3 = T.card, BorderSizePixel = 0 }, nil)
	if props then for k, v in props do f[k] = v end end
	f.Parent = parent
	return f
end

function UI.label(parent: Instance?, text: string, size: number?, props: { [string]: any }?): TextLabel
	local l = UI.new("TextLabel", {
		BackgroundTransparency = 1, Text = text, TextColor3 = T.text, Font = UI.Body,
		TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, nil)
	if props then for k, v in props do l[k] = v end end
	texts[l] = size or 15
	applyText(l, size or 15)
	l.Parent = parent
	return l
end

-- Pin an existing text object's base size into the scaling registry.
function UI.scaleText(inst: Instance, base: number)
	texts[inst] = base
	applyText(inst, base)
end

local selImage = Instance.new("Frame")
selImage.BackgroundTransparency = 1
UI.corner(selImage, 12)
UI.new("UIStroke", { Color = T.amber, Thickness = 3 }, selImage)

function UI.button(parent: Instance?, text: string, props: { [string]: any }?, onClick: (() -> ())?): TextButton
	local b = UI.new("TextButton", {
		BackgroundColor3 = T.card2, BorderSizePixel = 0, Text = text, TextColor3 = T.text, Font = UI.Bold,
		AutoButtonColor = false, Size = UDim2.new(0, 140, 0, 44), SelectionImageObject = selImage,
		TextWrapped = true,
	}, nil)
	if props then for k, v in props do b[k] = v end end
	UI.corner(b, 10)
	local st = UI.stroke(b, T.line, 1)
	texts[b] = (props and props.TextSize) or 16
	applyText(b, texts[b])
	b.MouseEnter:Connect(function() st.Color = T.cyan end)
	b.MouseLeave:Connect(function() st.Color = b:GetAttribute("StrokeColor") or T.line end)
	b.SelectionGained:Connect(function() st.Color = T.amber end)
	b.SelectionLost:Connect(function() st.Color = b:GetAttribute("StrokeColor") or T.line end)
	if onClick then
		b.Activated:Connect(function()
			if b:GetAttribute("Disabled") then
				UI.sfx("tick", 0.7)
				local why = b:GetAttribute("DisabledReason")
				if why then UI.toast(why, "warn") end
				return
			end
			UI.sfx("click")
			onClick()
		end)
	end
	b.Parent = parent
	return b
end

-- Visual style for button states.
function UI.style(b: TextButton, kind: string)
	local bg, fg, stroke = T.card2, T.text, T.line
	if kind == "primary" then bg, fg, stroke = T.cyan, T.dark, T.cyan
	elseif kind == "danger" then bg, fg, stroke = Color3.fromRGB(90, 20, 40), T.text, T.red
	elseif kind == "good" then bg, fg, stroke = Color3.fromRGB(15, 70, 45), T.text, T.green
	elseif kind == "selected" then bg, fg, stroke = Color3.fromRGB(20, 60, 80), T.text, T.cyan
	elseif kind == "disabled" then bg, fg, stroke = Color3.fromRGB(28, 28, 44), Color3.fromRGB(110, 110, 140), Color3.fromRGB(45, 45, 70)
	elseif kind == "magenta" then bg, fg, stroke = T.magenta, T.dark, T.magenta
	end
	b.BackgroundColor3 = bg
	b.TextColor3 = fg
	b:SetAttribute("StrokeColor", stroke)
	local st = b:FindFirstChildOfClass("UIStroke")
	if st then st.Color = stroke end
	b:SetAttribute("Disabled", kind == "disabled")
end

-- Input mode ---------------------------------------------------------------
local lastGamepad = false
UIS.LastInputTypeChanged:Connect(function(t)
	lastGamepad = t.Name:find("Gamepad") ~= nil
end)
lastGamepad = UIS:GetLastInputType().Name:find("Gamepad") ~= nil
function UI.gamepad(): boolean return lastGamepad end
function UI.touch(): boolean return UIS.TouchEnabled and not UIS.KeyboardEnabled end
function UI.focus(obj: GuiObject?)
	if lastGamepad and obj and obj.Parent and obj.Visible then
		GuiService.SelectedObject = obj
	end
end

-- Back routing: the top handler receives gamepad B.
local backStack: { { id: string, fn: () -> () } } = {}
local function backAction(_: string, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
	local top = backStack[#backStack]
	if top then
		top.fn()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end
local function refreshBack()
	if #backStack > 0 then
		CAS:BindActionAtPriority("NeonBack", backAction, false, 3000, Enum.KeyCode.ButtonB)
	else
		CAS:UnbindAction("NeonBack")
	end
end
function UI.pushBack(id: string, fn: () -> ())
	UI.popBack(id)
	table.insert(backStack, { id = id, fn = fn })
	refreshBack()
end
function UI.popBack(id: string)
	for i = #backStack, 1, -1 do
		if backStack[i].id == id then table.remove(backStack, i) end
	end
	refreshBack()
end

-- Viewport ----------------------------------------------------------------
UI.layoutChanged = Instance.new("BindableEvent")
function UI.size(): Vector2
	return gui.AbsoluteSize
end
function UI.compact(): boolean
	local s = gui.AbsoluteSize
	return s.X < 760 or s.Y < 480
end
function UI.isPortrait(): boolean
	local s = gui.AbsoluteSize
	return s.Y > s.X
end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	UI.layoutChanged:Fire()
end)

-- Toasts --------------------------------------------------------------------
local toastHolder = UI.frame(overlay, {
	Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 64), Size = UDim2.new(0.9, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 50,
})
UI.new("UISizeConstraint", { MaxSize = Vector2.new(520, math.huge) }, toastHolder)
UI.list(toastHolder, false, 6, Enum.HorizontalAlignment.Center)
function UI.toast(text: string, kind: string?)
	local color = if kind == "good" then T.green elseif kind == "warn" then T.amber elseif kind == "bad" then T.red else T.cyan
	local f = UI.frame(toastHolder, { BackgroundColor3 = T.panel, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 50 })
	UI.corner(f, 10)
	UI.stroke(f, color, 2)
	UI.pad(f, 10, 14)
	UI.label(f, text, 16, { TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 51, Font = UI.Bold })
	if kind == "bad" then UI.sfx("tick", 0.6) end
	task.delay(3.2, function()
		if f.Parent then f:Destroy() end
	end)
	while #toastHolder:GetChildren() > 5 do
		for _, c in toastHolder:GetChildren() do
			if c:IsA("Frame") then c:Destroy() break end
		end
	end
end

-- Portraits -----------------------------------------------------------------
-- Real players get their avatar headshot; local opponents get a distinct generated placeholder.
function UI.portrait(parent: Instance, userId: number, name: string, size: number, accent: Color3?): Frame
	local holder = UI.frame(parent, { Size = UDim2.fromOffset(size, size), BackgroundColor3 = T.card2, Name = "Portrait" })
	UI.corner(holder, size)
	if userId > 0 then
		UI.new("ImageLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
			Image = "rbxthumb://type=AvatarHeadShot&id=" .. userId .. "&w=150&h=150",
		}, holder)
		UI.new("UICorner", { CornerRadius = UDim.new(1, 0) }, holder:FindFirstChildOfClass("ImageLabel"))
		UI.stroke(holder, accent or T.cyan, 2)
	else
		holder.BackgroundColor3 = Color3.fromRGB(35, 20, 60)
		UI.stroke(holder, accent or T.magenta, 2)
		local initial = string.upper(string.sub(name, 1, 1))
		local l = UI.label(holder, initial, math.floor(size * 0.42), {
			Size = UDim2.fromScale(1, 1), AutomaticSize = Enum.AutomaticSize.None, Font = UI.Title,
			TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = accent or T.magenta,
		})
		l.TextYAlignment = Enum.TextYAlignment.Center
		local tag = UI.label(holder, "BOT", 9, {
			Size = UDim2.new(1, 0, 0, 10), AutomaticSize = Enum.AutomaticSize.None, Position = UDim2.new(0, 0, 1, -9),
			TextXAlignment = Enum.TextXAlignment.Center, Font = UI.Bold, TextColor3 = T.text, BackgroundTransparency = 0.1,
			BackgroundColor3 = Color3.fromRGB(120, 30, 100),
		})
		UI.corner(tag, 4)
	end
	return holder
end

-- Panels --------------------------------------------------------------------
export type Panel = {
	id: string, frame: Frame, body: Frame, title: TextLabel, closeBtn: TextButton,
	onOpen: (() -> ())?, onClose: (() -> ())?, canClose: ((proceed: () -> ()) -> boolean)?,
	firstFocus: (() -> GuiObject?)?, opener: GuiObject?, returnTo: string?,
}
UI.panels = {} :: { [string]: Panel }
UI.current = nil :: Panel?
UI.panelChanged = Instance.new("BindableEvent")

local scrim = UI.frame(gui, {
	Name = "Scrim", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.new(1, 0, 1, 80),
	Position = UDim2.new(0, 0, 0, -80), Visible = false, ZIndex = 20, Active = true,
})

function UI.panel(id: string, title: string, accent: Color3?): Panel
	local f = UI.frame(gui, {
		Name = "Panel_" .. id, BackgroundColor3 = T.panel, BackgroundTransparency = 0.04, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.94, 0.9), Visible = false, ZIndex = 21, Active = true,
	})
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(940, 660) }, f)
	UI.corner(f, 16)
	UI.stroke(f, accent or T.cyan, 2, 0.2)
	local head = UI.frame(f, { Name = "Head", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), ZIndex = 22 })
	UI.new("Frame", { BackgroundColor3 = accent or T.cyan, BorderSizePixel = 0, Size = UDim2.new(0, 4, 0, 26), Position = UDim2.new(0, 16, 0.5, -13), ZIndex = 22 }, head)
	local tl = UI.label(head, string.upper(title), 18, {
		Font = UI.Title, Position = UDim2.new(0, 30, 0, 0), Size = UDim2.new(1, -96, 1, 0), AutomaticSize = Enum.AutomaticSize.None,
		TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 22, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false,
	})
	local close = UI.button(head, "X", { Name = "Close", Size = UDim2.fromOffset(44, 44), Position = UDim2.new(1, -52, 0.5, -22), TextSize = 20, ZIndex = 23 })
	local body = UI.frame(f, { Name = "Body", BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 52), Size = UDim2.new(1, 0, 1, -52), ZIndex = 22, ClipsDescendants = true })
	UI.pad(body, 4, 16)
	;(body:FindFirstChildOfClass("UIPadding") :: UIPadding).PaddingBottom = UDim.new(0, 12)
	local p: Panel = { id = id, frame = f, body = body, title = tl, closeBtn = close }
	UI.panels[id] = p
	close.Activated:Connect(function()
		UI.sfx("click")
		UI.requestClose()
	end)
	return p
end

local function hideCurrent()
	local cur = UI.current
	if not cur then return end
	cur.frame.Visible = false
	UI.current = nil
	UI.popBack("panel")
	if cur.onClose then cur.onClose() end
end

function UI.open(id: string, opener: GuiObject?, returnTo: string?)
	local p = UI.panels[id]
	if not p then return end
	local cur = UI.current
	if cur == p then return end
	if cur then hideCurrent() end
	p.opener = opener or p.opener
	p.returnTo = returnTo
	scrim.Visible = true
	p.frame.Visible = true
	UI.current = p
	UI.pushBack("panel", function() UI.requestClose() end)
	if not UI.reducedMotion() then
		p.frame.Position = UDim2.new(0.5, 0, 0.5, 18)
		UI.tween(p.frame, { Position = UDim2.fromScale(0.5, 0.5) }, 0.16)
	end
	if p.onOpen then p.onOpen() end
	UI.sfx("whoosh", 1.4)
	task.defer(function()
		local first = if p.firstFocus then p.firstFocus() else nil
		UI.focus(first or p.closeBtn)
	end)
	UI.panelChanged:Fire(id)
end

-- Close immediately (after any guard has passed).
function UI.close()
	local cur = UI.current
	if not cur then return end
	hideCurrent()
	scrim.Visible = false
	if cur.returnTo then
		UI.open(cur.returnTo)
		return
	end
	GuiService.SelectedObject = nil
	if cur.opener and cur.opener.Parent then UI.focus(cur.opener) end
	UI.panelChanged:Fire(nil)
end

function UI.requestClose()
	local cur = UI.current
	if not cur then return end
	if cur.canClose then
		if not cur.canClose(function() UI.close() end) then return end
	end
	UI.close()
end

-- Confirmation dialog --------------------------------------------------------
UI.dialogOpen = false
local dlgRefresh: (() -> ())? = nil
function UI.refreshDialog()
	if dlgRefresh then dlgRefresh() end
end
export type ConfirmOpts = { title: string, body: string, confirm: string, cancel: string?, danger: boolean?, live: (() -> (string?, boolean, string?))? }
function UI.confirm(opts: ConfirmOpts, done: (boolean) -> ())
	local prevSel = GuiService.SelectedObject
	local blocker = UI.frame(overlay, { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, Size = UDim2.new(1, 0, 1, 80), Position = UDim2.new(0, 0, 0, -80), ZIndex = 60, Active = true })
	local box = UI.frame(blocker, { BackgroundColor3 = T.panel, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 40), Size = UDim2.new(0.9, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 61 })
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(460, math.huge) }, box)
	UI.corner(box, 14)
	UI.stroke(box, if opts.danger then T.red else T.amber, 2)
	UI.pad(box, 18, 20)
	UI.list(box, false, 12)
	UI.label(box, string.upper(opts.title), 17, { Font = UI.Title, ZIndex = 62, LayoutOrder = 1 })
	local bodyL = UI.label(box, opts.body, 16, { ZIndex = 62, LayoutOrder = 2, TextColor3 = T.text })
	local note = UI.label(box, "", 14, { ZIndex = 62, LayoutOrder = 3, TextColor3 = T.amber, Visible = false })
	local row = UI.frame(box, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), ZIndex = 62, LayoutOrder = 4 })
	UI.list(row, true, 10, Enum.HorizontalAlignment.Right)
	local finished = false
	local function finish(v: boolean)
		if finished then return end
		finished = true
		dlgRefresh = nil
		UI.dialogOpen = false
		UI.popBack("dialog")
		blocker:Destroy()
		if prevSel and prevSel.Parent then UI.focus(prevSel :: GuiObject) else GuiService.SelectedObject = nil end
		done(v)
	end
	local cancel = UI.button(row, opts.cancel or "Cancel", { Size = UDim2.fromOffset(130, 44), ZIndex = 63, LayoutOrder = 1 }, function() finish(false) end)
	local ok = UI.button(row, opts.confirm, { Size = UDim2.fromOffset(170, 44), ZIndex = 63, LayoutOrder = 2 }, function() finish(true) end)
	UI.style(ok, if opts.danger then "danger" else "primary")
	dlgRefresh = function()
		if not opts.live then return end
		local text, enabled, why = opts.live()
		if text then bodyL.Text = text end
		note.Visible = not enabled and why ~= nil
		note.Text = why or ""
		UI.style(ok, if not enabled then "disabled" elseif opts.danger then "danger" else "primary")
		if not enabled then ok:SetAttribute("DisabledReason", why) end
	end
	dlgRefresh()
	UI.dialogOpen = true
	UI.pushBack("dialog", function() finish(false) end)
	task.defer(function() UI.focus(cancel) end)
end

return UI
