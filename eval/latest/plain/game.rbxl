						<ProtectedString name="Source"><![CDATA[--!strict
-- Reusable panel pieces: scroll lists, chip rows, responsive split views, stat bars and wallet lines.
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local UI = require(script.Parent.UI)
local Store = require(script.Parent.Store)
local T = UI.T

local W = {}

function W.scroll(parent: Instance, props: { [string]: any }?, gap: number?): ScrollingFrame
	local s = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 5, ScrollBarImageColor3 = T.cyan, Selectable = false,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}, nil)
	if props then for k, v in props do (s :: any)[k] = v end end
	UI.list(s, false, gap or 8)
	UI.pad(s, 4, 4)
	s.Parent = parent
	return s
end

-- Horizontal row of selectable chips. Returns frame and a refresh function.
function W.chips(parent: Instance, options: { { id: string, label: string } }, get: () -> string, pick: (string) -> (), order: number?): (ScrollingFrame, () -> ())
	local row = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 44), CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollBarThickness = 3, ScrollingDirection = Enum.ScrollingDirection.X,
		LayoutOrder = order or 0, Selectable = false, ScrollBarImageColor3 = T.line,
	}, parent)
	UI.list(row, true, 6, nil, Enum.VerticalAlignment.Center)
	local buttons = {}
	local function refresh()
		local cur = get()
		for id, b in buttons do UI.style(b, if id == cur then "selected" else "") end
	end
	for i, o in options do
		local b = UI.button(row, o.label, { Size = UDim2.fromOffset(0, 38), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = i, TextSize = 14 })
		UI.pad(b, 0, 14)
		b.Activated:Connect(function()
			pick(o.id)
			refresh()
		end)
		buttons[o.id] = b
	end
	refresh()
	return row, refresh
end

-- Left/right panes that stack vertically on compact or portrait screens.
function W.split(body: Instance, leftWidth: number?): (Frame, Frame)
	local left = UI.frame(body, { Name = "Left", BackgroundTransparency = 1 })
	local right = UI.frame(body, { Name = "Right", BackgroundColor3 = T.card, BackgroundTransparency = 0.2 })
	UI.corner(right, 12)
	local function layout()
		local stacked = UI.compact() or UI.isPortrait()
		if stacked then
			left.Position = UDim2.new()
			left.Size = UDim2.new(1, 0, 0.56, -4)
			right.Position = UDim2.new(0, 0, 0.56, 4)
			right.Size = UDim2.new(1, 0, 0.44, -4)
		else
			local lw = leftWidth or 0.56
			left.Position = UDim2.new()
			left.Size = UDim2.new(lw, -6, 1, 0)
			right.Position = UDim2.new(lw, 6, 0, 0)
			right.Size = UDim2.new(1 - lw, -6, 1, 0)
		end
	end
	UI.layoutChanged.Event:Connect(layout)
	layout()
	return left, right
end

function W.statBar(parent: Instance, label: string, value: number, max: number, color: Color3, order: number?, extra: number?): Frame
	local f = UI.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = order or 0 })
	UI.label(f, label, 13, { Font = UI.Bold, Size = UDim2.new(0, 84, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center, TextColor3 = T.dim })
	local bg = UI.frame(f, { BackgroundColor3 = T.card2, Position = UDim2.new(0, 88, 0.5, -4), Size = UDim2.new(1, -136, 0, 8) })
	UI.corner(bg, 4)
	local fill = UI.frame(bg, { BackgroundColor3 = color, Size = UDim2.fromScale(math.clamp((value - (extra or 0)) / max, 0, 1), 1) })
	UI.corner(fill, 4)
	if extra and extra > 0 then
		UI.frame(bg, { BackgroundColor3 = T.green, Position = UDim2.fromScale(math.clamp((value - extra) / max, 0, 1), 0), Size = UDim2.fromScale(math.clamp(extra / max, 0, 1), 1) })
	end
	UI.label(f, tostring(math.floor(value)) .. (if extra and extra > 0 then " (+" .. extra .. ")" else ""), 13, { Font = UI.Bold, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 46, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Center })
	return f
end

function W.tag(parent: Instance, text: string, color: Color3, order: number?): Frame
	local f = UI.frame(parent, { BackgroundColor3 = color, BackgroundTransparency = 0.75, Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = order or 0 })
	UI.corner(f, 6)
	UI.stroke(f, color, 1)
	UI.pad(f, 0, 8)
	UI.label(f, text, 12, { Font = UI.Bold, TextColor3 = color, Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, TextYAlignment = Enum.TextYAlignment.Center })
	return f
end

function W.clear(parent: Instance)
	for _, c in parent:GetChildren() do
		if c:IsA("GuiObject") then c:Destroy() end
	end
end

-- Live wallet line with full (unabbreviated) amounts for stores.
function W.wallet(parent: Instance, order: number?): TextLabel
	local l = UI.label(parent, "", 14, { Font = UI.Bold, TextColor3 = T.amber, LayoutOrder = order or 0 })
	local function upd()
		local p = Store.profile
		if p then l.Text = "Wallet: " .. Config.Comma(p.credits) .. " Credits  ·  " .. Config.Comma(p.shards) .. " Shards" end
	end
	Store.profileChanged.Event:Connect(upd)
	upd()
	return l
end

-- Server round trip with a visible pending state on the button.
function W.act(button: TextButton?, action: string, payload: any?, pendingText: string?): any
	local old = if button then button.Text else ""
	if button then
		button.Text = pendingText or "Working…"
		button:SetAttribute("Disabled", true)
	end
	local res = Store.call(action, payload)
	if button and button.Parent then
		button.Text = old
		button:SetAttribute("Disabled", false)
	end
	if res.ok then
		if res.msg then UI.toast(res.msg, "good") end
	else
		UI.toast(res.err or "Request failed.", "bad")
	end
	return res
end

function W.rewardText(r: { [string]: any }): string
	local parts = {}
	if r.credits then table.insert(parts, Config.Comma(r.credits) .. " Credits") end
	if r.shards then table.insert(parts, Config.Comma(r.shards) .. " Shards") end
	if r.freeCrate then table.insert(parts, r.freeCrate .. " Free Crate" .. (if r.freeCrate > 1 then "s" else "")) end
	if r.part then
		local p = Config.FindById(Config.Parts, r.part)
		table.insert(parts, if p then p.name else r.part)
	end
	return table.concat(parts, " + ")
end

return W
]]></ProtectedString>
						<string name="ScriptGuid">{BB24E62B-B40F-4B86-95CF-636DF4CFB810}</string>
