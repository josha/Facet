						<ProtectedString name="Source"><![CDATA[--!strict
-- Kart driving, chase camera, race HUD, touch controls, scoreboard, quick chat and results.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local CAS = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local U = require(script.Parent.Util)
local Config = U.Config
local T = U.T
local Remotes = RS:WaitForChild("Remotes")

local Race = {}
local player = Players.LocalPlayer

return function(App: any)
	local gui = App.Gui
	-- ================= HUD =================
	local hud = U.new("Frame", { Name = "RaceHud", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = gui })
	local topCard = U.new("Frame", { Name = "PosCard", BackgroundColor3 = T.Bg, BackgroundTransparency = 0.25, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.fromOffset(330, 64), Parent = hud })
	U.corner(topCard, 14); U.stroke(topCard, T.Cyan, 1.5, 0.2)
	local posText = U.label(topCard, "1st", 34, T.Text, { Font = Enum.Font.GothamBlack, Size = UDim2.new(0.38, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false })
	local posSub = U.label(topCard, "/6", 14, T.Sub, { Size = UDim2.fromOffset(40, 20), Position = UDim2.new(0.33, 0, 1, -24), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
	local lapText = U.label(topCard, "LAP 1/2", 18, T.Cyan, { Font = Enum.Font.GothamBlack, Position = UDim2.new(0.42, 0, 0, 8), Size = UDim2.new(0.58, -10, 0, 22), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
	local timeText = U.label(topCard, "0:00", 14, T.Sub, { Position = UDim2.new(0.42, 0, 0, 32), Size = UDim2.new(0.58, -10, 0, 18), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
	local progBg = U.new("Frame", { BackgroundColor3 = T.Panel, Position = UDim2.new(0, 10, 1, -6), Size = UDim2.new(1, -20, 0, 3), BorderSizePixel = 0, Parent = topCard })
	local progFill = U.new("Frame", { BackgroundColor3 = T.Pink, Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = progBg })
	local countdown = U.label(hud, "", 120, T.Text, { Font = Enum.Font.GothamBlack, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.fromOffset(500, 150), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.2, TextStrokeColor3 = T.Pink, TextWrapped = false })
	local feed = U.new("Frame", { Name = "KnockoutFeed", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 4), Size = UDim2.fromOffset(240, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = hud })
	U.list(feed, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Right)
	local meter = U.new("Frame", { Name = "Meter", BackgroundColor3 = T.Bg, BackgroundTransparency = 0.25, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.fromOffset(240, 58), Parent = hud })
	U.corner(meter, 12); U.stroke(meter, T.Violet, 1, 0.3)
	local speedText = U.label(meter, "0", 26, T.Text, { Font = Enum.Font.GothamBlack, Position = UDim2.fromOffset(10, 2), Size = UDim2.fromOffset(80, 30), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
	U.label(meter, "studs/s", 11, T.Sub, { Position = UDim2.fromOffset(10, 32), Size = UDim2.fromOffset(80, 14), AutomaticSize = Enum.AutomaticSize.None })
	local boostBg = U.new("Frame", { BackgroundColor3 = T.Panel, Position = UDim2.new(0, 96, 0, 12), Size = UDim2.new(1, -106, 0, 10), Parent = meter })
	U.corner(boostBg, 5)
	local boostFill = U.new("Frame", { BackgroundColor3 = T.Cyan, Size = UDim2.fromScale(1, 1), Parent = boostBg })
	U.corner(boostFill, 5)
	local driftBg = U.new("Frame", { BackgroundColor3 = T.Panel, Position = UDim2.new(0, 96, 0, 32), Size = UDim2.new(1, -106, 0, 8), Parent = meter })
	U.corner(driftBg, 4)
	local driftFill = U.new("Frame", { BackgroundColor3 = T.Pink, Size = UDim2.fromScale(0, 1), Parent = driftBg })
	U.corner(driftFill, 4)
	local meterHint = U.label(meter, "BOOST · DRIFT", 10, T.Sub, { Position = UDim2.new(0, 96, 0, 42), Size = UDim2.new(1, -106, 0, 12), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
	local exitTest = U.btn(hud, "✖ Exit test drive", { name = "ExitTest", size = UDim2.fromOffset(180, 44), color = T.Panel, stroke = T.Gold })
	exitTest.AnchorPoint = Vector2.new(0.5, 0)
	exitTest.Position = UDim2.new(0.5, 0, 0, 74)
	exitTest.Visible = false
	exitTest.Activated:Connect(function()
		local r = U.Request("ExitTestDrive")
		if not r.ok then U.Toast(r.err, "bad") end
	end)

	-- right action rail (scoreboard + chat), usable in hub and race
	local rail = U.new("Frame", { Name = "ActionRail", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.42, 0), Size = UDim2.fromOffset(56, 120), Parent = gui })
	U.list(rail, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right)
	local sbBtn = U.btn(rail, "🏆", { name = "ScoreboardButton", order = 1, size = UDim2.fromOffset(56, 52), textSize = 24, color = T.Panel, stroke = T.Gold })
	local chatBtn = U.btn(rail, "💬", { name = "ChatButton", order = 2, size = UDim2.fromOffset(56, 52), textSize = 24, color = T.Panel, stroke = T.Cyan })

	-- ================= Touch controls =================
	local touch = U.new("Frame", { Name = "TouchDrive", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = hud })
	local input = { throttle = 0, brake = 0, steer = 0, drift = false, boost = false }
	local touchState = { left = false, right = false, gas = false, brake = false, drift = false, boost = false }
	local function touchBtn(name: string, text: string, size: number, anchor: Vector2, pos: UDim2, color: Color3, key: string)
		local b = U.new("TextButton", { Name = name, Text = text, TextSize = 18, Font = Enum.Font.GothamBlack, TextColor3 = T.Text, BackgroundColor3 = T.Bg, BackgroundTransparency = 0.25, AnchorPoint = anchor, Position = pos, Size = UDim2.fromOffset(size, size), AutoButtonColor = false, Selectable = false, Parent = touch })
		U.corner(b, size // 2)
		U.stroke(b, color, 2)
		b.InputBegan:Connect(function(io)
			if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
				touchState[key] = true
				b.BackgroundColor3 = color
				b.BackgroundTransparency = 0.4
			end
		end)
		b.InputEnded:Connect(function(io)
			if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
				touchState[key] = false
				b.BackgroundColor3 = T.Bg
				b.BackgroundTransparency = 0.25
			end
		end)
		return b
	end
	touchBtn("SteerL", "◀", 84, Vector2.new(0, 1), UDim2.new(0, 12, 1, -16), T.Cyan, "left")
	touchBtn("SteerR", "▶", 84, Vector2.new(0, 1), UDim2.new(0, 106, 1, -16), T.Cyan, "right")
	touchBtn("Gas", "GAS", 92, Vector2.new(1, 1), UDim2.new(1, -12, 1, -16), T.Green, "gas")
	touchBtn("Brake", "BRAKE", 70, Vector2.new(1, 1), UDim2.new(1, -112, 1, -16), T.Red, "brake")
	touchBtn("Drift", "DRIFT", 70, Vector2.new(1, 1), UDim2.new(1, -12, 1, -118), T.Pink, "drift")
	touchBtn("Boost", "BOOST", 70, Vector2.new(1, 1), UDim2.new(1, -90, 1, -96), T.Cyan, "boost")
	local recoverTouch = U.btn(touch, "🔄", { name = "Recover", size = UDim2.fromOffset(52, 52), textSize = 22, color = T.Bg, stroke = T.Gold })
	recoverTouch.AnchorPoint = Vector2.new(0, 1)
	recoverTouch.Position = UDim2.new(0, 12, 1, -112)

	-- ================= Scoreboard =================
	local sb = U.new("Frame", { Name = "Scoreboard", BackgroundColor3 = T.Bg, BackgroundTransparency = 0.12, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -72, 0, 76), Size = UDim2.fromOffset(330, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, Parent = gui })
	U.corner(sb, 14); U.stroke(sb, T.Gold, 1.5, 0.2); U.pad(sb, 10)
	U.list(sb, Enum.FillDirection.Vertical, 5)
	local sbOpen = false
	local function renderScoreboard()
		if not sbOpen then return end
		U.clear(sb)
		local rs = U.Store.race
		local racers = rs and rs.racers or {}
		local track = rs and rs.track and Config.GetTrack(rs.track)
		U.label(sb, "SCOREBOARD" .. (track and (" · " .. track.name) or ""), 15, T.Gold, { Font = Enum.Font.GothamBlack, LayoutOrder = 0 })
		if #racers == 0 then
			U.label(sb, "No race running. Join the queue at the Race Portal.", 13, T.Sub, { LayoutOrder = 1 })
		end
		for i, r in ipairs(racers) do
			local me = r.userId == player.UserId
			local row = U.new("Frame", { BackgroundColor3 = me and Color3.fromRGB(20, 60, 80) or T.Panel, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = i, Parent = sb })
			U.corner(row, 8)
			if me then U.stroke(row, T.Cyan, 2) end
			U.label(row, tostring(r.place or i), 18, i <= 3 and T.Gold or T.Text, { Font = Enum.Font.GothamBlack, Size = UDim2.fromOffset(28, 40), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false })
			local pt = U.portrait(row, (not r.isAI) and r.userId or (r.party and nil or nil), r.name, 32)
			pt.Position = UDim2.fromOffset(30, 4)
			U.label(row, r.name .. (me and "  (YOU)" or ""), 14, me and T.Cyan or T.Text, { Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(68, 0), Size = UDim2.new(1, -170, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
			local st = r.out and "OUT" or r.finished and ("✔ " .. string.format("%.1fs", r.time or 0)) or ("Lap " .. r.lap .. "/" .. (rs.laps or Config.Laps))
			U.label(row, st, 13, r.out and T.Red or r.finished and T.Green or T.Sub, { Font = Enum.Font.GothamBold, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0), Size = UDim2.fromOffset(96, 40), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false })
		end
		U.label(sb, "Tab · DPad↑ · 🏆 to close", 11, T.Sub, { LayoutOrder = 99 })
	end
	local function toggleScoreboard()
		sbOpen = not sbOpen
		sb.Visible = sbOpen
		renderScoreboard()
	end
	Race.ToggleScoreboard = toggleScoreboard
	sbBtn.Activated:Connect(toggleScoreboard)

	-- ================= Quick chat =================
	local chatFeed = U.new("Frame", { Name = "ChatFeed", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0.56, 0), Size = UDim2.fromOffset(260, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = gui })
	U.list(chatFeed, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Right)
	local wheel = U.new("Frame", { Name = "ChatWheel", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(440, 440), Visible = false, Parent = App.ModalGui })
	U.new("UIAspectRatioConstraint", { AspectRatio = 1, Parent = wheel })
	local wheelScale = U.new("UIScale", { Parent = wheel })
	local ring = U.new("Frame", { BackgroundColor3 = T.Bg, BackgroundTransparency = 0.3, Size = UDim2.fromScale(1, 1), Parent = wheel })
	U.corner(ring, 220); U.stroke(ring, T.Cyan, 2, 0.3)
	local center = U.btn(wheel, "Cancel", { name = "ChatCancel", size = UDim2.fromOffset(110, 110), radius = 55, color = T.Panel, textSize = 15 })
	center.AnchorPoint = Vector2.new(0.5, 0.5)
	center.Position = UDim2.fromScale(0.5, 0.5)
	local cdLabel = U.label(wheel, "", 13, T.Gold, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 40), Size = UDim2.fromOffset(160, 18), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center })
	local chatButtons = {}
	for i, msg in ipairs(Config.QuickChat) do
		local a = (i - 1) / #Config.QuickChat * math.pi * 2 - math.pi / 2
		local b = U.btn(wheel, i .. "  " .. msg, { name = "Chat_" .. i, size = UDim2.fromOffset(118, 46), textSize = 14, color = T.Panel2, stroke = T.Cyan })
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Position = UDim2.new(0.5 + math.cos(a) * 0.37, 0, 0.5 + math.sin(a) * 0.37, 0)
		chatButtons[i] = b
	end
	local wheelOpener: GuiObject? = nil
	local wheelOpen = false
	local function closeWheel()
		if not wheelOpen then return end
		wheelOpen = false
		wheel.Visible = false
		CAS:UnbindAction("NeonChatBack")
		local o = wheelOpener
		wheelOpener = nil
		if o and o.Parent and o.Visible then U.Focus(o) else GuiService.SelectedObject = nil end
	end
	local function renderCooldown()
		local left = U.Store.chatReadyAt - os.clock()
		cdLabel.Text = left > 0 and ("Cooldown " .. math.ceil(left) .. "s") or "Pick a message"
		for _, b in ipairs(chatButtons) do U.setEnabled(b, left <= 0) end
	end
	local sending = false
	local function sendChat(i: number)
		if sending then return end
		if U.Store.chatReadyAt > os.clock() then renderCooldown() return end
		sending = true
		local r = U.Request("Chat", { index = i })
		sending = false
		if r.ok then
			U.Store.chatReadyAt = os.clock() + (r.cooldown or Config.ChatCooldown)
			closeWheel()
		else
			if r.retry then U.Store.chatReadyAt = os.clock() + r.retry end
			renderCooldown()
		end
	end
	for i, b in ipairs(chatButtons) do b.Activated:Connect(function() sendChat(i) end) end
	center.Activated:Connect(closeWheel)
	local function openWheel(from: GuiObject?)
		if wheelOpen then closeWheel() return end
		wheelOpen = true
		wheelOpener = from or (GuiService.SelectedObject :: GuiObject?)
		local small = math.min(U.Layout.w, U.Layout.h)
		wheelScale.Scale = math.clamp((small - 40) / 440, 0.6, 1.1)
		wheel.Visible = true
		renderCooldown()
		CAS:BindActionAtPriority("NeonChatBack", function(_, st)
			if st == Enum.UserInputState.Begin then closeWheel() end
			return Enum.ContextActionResult.Sink
		end, false, 3500, Enum.KeyCode.ButtonB)
		task.defer(function() U.Focus(chatButtons[1]) end)
	end
	Race.OpenWheel = openWheel
	chatBtn.Activated:Connect(function() openWheel(chatBtn) end)
	Remotes.Chat.OnClientEvent:Connect(function(msg)
		local f = U.new("Frame", { BackgroundColor3 = T.Bg, BackgroundTransparency = 0.2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = chatFeed })
		U.corner(f, 8); U.pad(f, 8, 4)
		U.label(f, "💬 " .. msg.name .. ": " .. msg.text, 14, msg.userId == player.UserId and T.Cyan or T.Text, { Font = Enum.Font.GothamBold })
		task.delay(6, function() f:Destroy() end)
		if #chatFeed:GetChildren() > 5 then
			for _, c in ipairs(chatFeed:GetChildren()) do if c:IsA("Frame") then c:Destroy() break end end
		end
	end)

	-- ================= Results =================
	local results = U.new("Frame", { Name = "Results", BackgroundColor3 = T.Bg, BackgroundTransparency = 0.05, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.new(0.92, 0, 0.8, 0), Visible = false, Parent = App.ModalGui })
	U.new("UISizeConstraint", { MaxSize = Vector2.new(560, 600), Parent = results })
	U.corner(results, 16); U.stroke(results, T.Gold, 2)
	local resScroll = U.scroll(results, { Size = UDim2.new(1, -24, 1, -76), Position = UDim2.fromOffset(12, 12) })
	U.list(resScroll, Enum.FillDirection.Vertical, 6)
	local resBtns = U.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -10), Size = UDim2.new(1, -24, 0, 50), Parent = results })
	U.list(resBtns, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	local againBtn = U.btn(resBtns, "🏁 Race again", { name = "RaceAgain", order = 1, size = UDim2.new(0.5, -4, 1, 0), primary = true, color = T.Violet })
	local closeRes = U.btn(resBtns, "Back to hub", { name = "CloseResults", order = 2, size = UDim2.new(0.5, -4, 1, 0) })
	local lastResult: any = nil
	local resultsTimer: TextLabel? = nil
	local function closeResults()
		results.Visible = false
		CAS:UnbindAction("NeonResultsBack")
	end
	closeRes.Activated:Connect(function()
		if U.Store.driving then U.Toast("Returning to hub when the results timer ends", "info") return end
		closeResults()
	end)
	againBtn.Activated:Connect(function()
		if U.Store.driving then U.Toast("Hold on · returning to hub first", "info") return end
		closeResults()
		local r = U.Request("QueueJoin", { mode = lastResult and lastResult.mode or "Solo" })
		if r.ok then App.Open("Race") else U.Toast(r.err, "bad") end
	end)
	local function showResults(data: any)
		lastResult = data
		lastResult.mode = (U.Store.race and U.Store.race.mode) or "Solo"
		U.clear(resScroll)
		local head = data.out and "OUT · race time expired" or ("You finished " .. U.ordinal(data.place))
		U.label(resScroll, head, 28, data.out and T.Red or (data.place <= 3 and T.Gold or T.Text), { Font = Enum.Font.GothamBlack, LayoutOrder = 1, TextXAlignment = Enum.TextXAlignment.Center })
		U.label(resScroll, data.track .. " · final order", 14, T.Sub, { LayoutOrder = 2, TextXAlignment = Enum.TextXAlignment.Center })
		for i, r in ipairs(data.results) do
			local me = r.userId == player.UserId
			local row = U.new("Frame", { BackgroundColor3 = me and Color3.fromRGB(20, 60, 80) or T.Panel, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 2 + i, Parent = resScroll })
			U.corner(row, 8)
			if me then U.stroke(row, T.Cyan, 2) end
			U.label(row, tostring(r.place), 18, r.place <= 3 and T.Gold or T.Text, { Font = Enum.Font.GothamBlack, Size = UDim2.fromOffset(32, 40), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center })
			U.portrait(row, (not r.isAI) and r.userId or nil, r.name, 32).Position = UDim2.fromOffset(34, 4)
			U.label(row, r.name .. (me and " (YOU)" or ""), 15, me and T.Cyan or T.Text, { Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(74, 0), Size = UDim2.new(1, -180, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
			U.label(row, r.out and "OUT" or string.format("%.2fs", r.time or 0), 14, r.out and T.Red or T.Green, { Font = Enum.Font.GothamBold, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), Size = UDim2.fromOffset(90, 40), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right })
		end
		local rw = data.reward
		local rc = U.card(resScroll, { LayoutOrder = 50 })
		U.pad(rc, 12)
		U.list(rc, Enum.FillDirection.Vertical, 4)
		U.label(rc, "REWARDS EARNED (confirmed by server)", 13, T.Sub, { Font = Enum.Font.GothamBold, LayoutOrder = 1 })
		U.label(rc, string.format("💰 +%s Coins%s   💎 +%d Gems   ⭐ +%d XP%s", Config.FormatNumber(rw.coins), data.coinMult > 1 and " (×2)" or "", rw.gems, rw.xp, data.xpMult > 1 and " (×2)" or ""), 17, T.Gold, { Font = Enum.Font.GothamBold, LayoutOrder = 2 })
		if data.levelUp then U.label(rc, "LEVEL UP! You reached level " .. data.level, 16, T.Green, { Font = Enum.Font.GothamBlack, LayoutOrder = 3 }) end
		resultsTimer = U.label(resScroll, "", 13, T.Sub, { LayoutOrder = 60, TextXAlignment = Enum.TextXAlignment.Center })
		results.Visible = true
		CAS:BindActionAtPriority("NeonResultsBack", function(_, st)
			if st == Enum.UserInputState.Begin and not U.Store.driving then closeResults() end
			return Enum.ContextActionResult.Sink
		end, false, 3200, Enum.KeyCode.ButtonB)
		task.defer(function() U.Focus(againBtn) end)
	end

	-- ================= Driving =================
	local drive: any = nil
	local camMode = 1
	local shake = 0
	local controls: any = nil
	pcall(function()
		local pmod = player:WaitForChild("PlayerScripts"):FindFirstChild("PlayerModule")
		if not pmod then return end
		local pm = require(pmod :: any)
		controls = pm:GetControls()
	end)

	local function damageNumber(amount: number)
		if not U.Store.profile.settings.damageNumbers then return end
		local l = U.label(hud, "-" .. amount, 30, T.Red, { Font = Enum.Font.GothamBlack, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5 + (math.random() - 0.5) * 0.1, 0.55), Size = UDim2.fromOffset(120, 40), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3 })
		U.Tween(l, TweenInfo.new(0.8), { Position = l.Position - UDim2.fromOffset(0, 60), TextTransparency = 1 })
		task.delay(0.85, function() l:Destroy() end)
	end

	local function recover()
		if not drive or not drive.active then return end
		local track = drive.track
		local idx = Config.NearestSample(track, drive.pos, drive.hint, 20)
		local cf = Config.SampleCFrame(track, idx, 0)
		drive.pos = Vector3.new(cf.Position.X, Config.TrackY + 1.7, cf.Position.Z)
		local look = cf.LookVector
		drive.yaw = math.atan2(-look.X, -look.Z)
		drive.speed = 0
		drive.hint = idx
		U.Toast("Kart recovered to the track", "info")
	end
	recoverTouch.Activated:Connect(recover)

	local function startDrive(data: any)
		local model: Model = data.kart
		if not model then return end
		local t0 = os.clock()
		while not model.PrimaryPart and os.clock() - t0 < 5 do task.wait() end
		local body = model.PrimaryPart
		if not body then return end
		closeResults()
		local track = Config.GetTrack(data.track)
		local phys = Config.Physics(data.stats)
		local cf = body.CFrame
		local look = cf.LookVector
		drive = {
			model = model, body = body, track = track, phys = phys, mode = data.mode, goAt = data.goAt,
			pos = cf.Position, yaw = math.atan2(-look.X, -look.Z), speed = 0, hint = Config.NearestSample(track, cf.Position),
			boost = phys.boostCap, driftCharge = 0, drifting = false, turbo = 0, active = true, slide = 0, lastHit = 0, startedAt = U.ServerNow(),
		}
		local tag = body:FindFirstChild("NameTag")
		if tag and tag:IsA("BillboardGui") then tag.Enabled = false end
		U.Store.driving = true
		App.SetHubVisible(false)
		topCard.Position = UDim2.new(0.5, 0, 0, App.Top.AbsoluteSize.Y + 12)
		hud.Visible = true
		touch.Visible = UIS.TouchEnabled
		exitTest.Visible = data.mode == "test"
		topCard.Visible = data.mode ~= "test"
		if data.mode == "test" then App.SetZone("📍 Test Ring · test drive") end
		if controls then controls:Disable() end
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end
		workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
		U.Emit("drive")
	end

	local function endDrive()
		if not drive then return end
		drive.active = false
		drive = nil
		U.Store.driving = false
		hud.Visible = false
		App.SetHubVisible(true)
		if controls then controls:Enable() end
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
		if hum then cam.CameraSubject = hum end
		App.SetZone("📍 Hub")
		U.Emit("drive")
		-- the client owns its character, so it also completes the trip back to the hub
		task.delay(0.5, function()
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if char and root and Vector3.new(root.Position.X, 0, root.Position.Z).Magnitude > 200 then
				char:PivotTo(CFrame.new(math.random(-8, 8), 4, 30))
			end
		end)
	end

	Remotes.Race.OnClientEvent:Connect(function(msg)
		if msg.type == "driveStart" then
			task.spawn(startDrive, msg)
		elseif msg.type == "driveEnd" then
			endDrive()
		elseif msg.type == "finished" then
			U.Toast("FINISHED " .. U.ordinal(msg.place) .. " · " .. string.format("%.2fs", msg.time), "good")
		elseif msg.type == "results" then
			showResults(msg)
		elseif msg.type == "state" then
			msg.received = os.clock()
			U.Store.race = msg
			U.Emit("race")
		end
	end)

	local function readInput()
		local thr, brk, steer = 0, 0, 0
		local drift, boost = false, false
		if not UIS:GetFocusedTextBox() then
			if UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up) then thr = 1 end
			if UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down) then brk = 1 end
			if UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left) then steer -= 1 end
			if UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right) then steer += 1 end
			drift = UIS:IsKeyDown(Enum.KeyCode.Space)
			boost = UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)
		end
		if UIS.GamepadEnabled then
			for _, st in ipairs(UIS:GetGamepadState(Enum.UserInputType.Gamepad1)) do
				if st.KeyCode == Enum.KeyCode.Thumbstick1 and math.abs(st.Position.X) > 0.15 then steer += st.Position.X
				elseif st.KeyCode == Enum.KeyCode.ButtonR2 and st.Position.Z > 0.1 then thr = math.max(thr, st.Position.Z)
				elseif st.KeyCode == Enum.KeyCode.ButtonL2 and st.Position.Z > 0.1 then brk = math.max(brk, st.Position.Z)
				elseif st.KeyCode == Enum.KeyCode.ButtonR1 and st.UserInputState == Enum.UserInputState.Begin then drift = true
				elseif st.KeyCode == Enum.KeyCode.ButtonX and st.UserInputState == Enum.UserInputState.Begin then boost = true
				end
			end
		end
		if touchState.left then steer -= 1 end
		if touchState.right then steer += 1 end
		if touchState.gas then thr = 1 end
		if touchState.brake then brk = 1 end
		if touchState.drift then drift = true end
		if touchState.boost then boost = true end
		input.throttle, input.brake, input.steer, input.drift, input.boost = thr, brk, math.clamp(steer, -1, 1), drift, boost
	end

	RunService:BindToRenderStep("NeonDrive", Enum.RenderPriority.Camera.Value + 1, function(dt)
		dt = math.min(dt, 0.05)
		local d = drive
		local cam = workspace.CurrentCamera
		if not d then return end
		if not d.model.Parent or not d.body.Parent then endDrive() return end
		readInput()
		local now = U.ServerNow()
		local started = now >= d.goAt and not d.body.Anchored
		local phys = d.phys
		local track = d.track
		-- countdown
		if now < d.goAt then
			local left = math.ceil(d.goAt - now)
			countdown.Text = left > Config.CountdownSeconds and "READY" or tostring(left)
			countdown.TextColor3 = T.Text
		elseif now - d.goAt < 1.2 and d.mode == "race" then
			countdown.Text = "GO!"
			countdown.TextColor3 = T.Green
		else
			countdown.Text = ""
		end
		if started then
			local top = phys.topSpeed
			local boosting = false
			if d.turbo > 0 then d.turbo -= dt; boosting = true end
			if input.boost and d.boost > 0 and input.throttle > 0 then
				d.boost = math.max(0, d.boost - dt)
				boosting = true
			else
				d.boost = math.min(phys.boostCap, d.boost + dt * 0.12)
			end
			if boosting then top *= phys.boostMult end
			if input.throttle > 0 then
				local a = phys.accel * (boosting and 1.8 or 1)
				if d.speed < top * input.throttle then d.speed = math.min(top * input.throttle, d.speed + a * dt) else d.speed -= 25 * dt end
			end
			if input.brake > 0 then
				if d.speed > 0 then d.speed = math.max(0, d.speed - 70 * dt * input.brake) else d.speed = math.max(-25, d.speed - 20 * dt * input.brake) end
			end
			if input.throttle == 0 and input.brake == 0 then
				d.speed -= math.sign(d.speed) * math.min(math.abs(d.speed), 14 * dt)
			end
			-- drift
			local wantDrift = input.drift and math.abs(input.steer) > 0.2 and d.speed > 35
			if wantDrift then
				if not d.drifting then d.drifting = true; d.driftDir = math.sign(input.steer) end
				d.driftCharge += dt
			elseif d.drifting then
				d.drifting = false
				if d.driftCharge > 0.8 then
					d.turbo = math.min(1.6, 0.6 + d.driftCharge * 0.4)
					if U.Store.profile.settings.cameraShake then shake = 0.3 end
					task.spawn(U.Request, "DriftBoost")
				end
				d.driftCharge = 0
			end
			local grip = math.clamp(math.abs(d.speed) / 30, 0, 1)
			local turn = input.steer * phys.turn * grip * (d.speed >= 0 and 1 or -1)
			if d.drifting then turn = (d.driftDir * 0.55 + input.steer * 0.75) * phys.turn * 1.25 end
			d.yaw -= turn * dt
			d.slide += ((d.drifting and d.driftDir * 0.35 or 0) - d.slide) * math.min(1, dt * 6)
			local fwd = Vector3.new(-math.sin(d.yaw), 0, -math.cos(d.yaw))
			local newPos = d.pos + fwd * d.speed * dt
			-- keep on track (walls)
			local idx = Config.NearestSample(track, newPos, d.hint, 10)
			d.hint = idx
			local scf = Config.SampleCFrame(track, idx, 0)
			local rel = scf:PointToObjectSpace(Vector3.new(newPos.X, scf.Position.Y, newPos.Z))
			local limit = Config.TrackWidth / 2 - 3.5
			if math.abs(rel.X) > limit then
				local over = math.abs(rel.X) - limit
				rel = Vector3.new(math.sign(rel.X) * limit, 0, rel.Z)
				local p2 = scf:PointToWorldSpace(rel)
				newPos = Vector3.new(p2.X, newPos.Y, p2.Z)
				local localFwd = scf:VectorToObjectSpace(fwd)
				local outward = math.abs(localFwd.X)
				local impact = 0
				if localFwd.X * rel.X > 0 then
					-- scrape along the wall: turn toward the track and lose speed by impact angle
					local tl = scf.LookVector
					local tangentYaw = math.atan2(-tl.X, -tl.Z)
					local diff = (tangentYaw - d.yaw + math.pi) % (2 * math.pi) - math.pi
					d.yaw += diff * math.min(1, dt * 6)
					impact = math.abs(d.speed) * outward
					d.speed *= (1 - math.min(0.5, outward * dt * 4))
				end
				local _ = over
				if impact > 25 and os.clock() - d.lastHit > 0.6 then
					d.lastHit = os.clock()
					damageNumber(math.floor(impact / 4))
					if U.Store.profile.settings.cameraShake then shake = 0.4 end
				end
			end
			d.pos = Vector3.new(newPos.X, Config.TrackY + 1.7, newPos.Z)
			local kcf = CFrame.new(d.pos) * CFrame.Angles(0, d.yaw + d.slide, 0) * CFrame.Angles(0, 0, -input.steer * 0.04 * grip)
			d.body.CFrame = kcf
			d.body.AssemblyLinearVelocity = fwd * d.speed
			d.body.AssemblyAngularVelocity = Vector3.zero
			local fx = d.body:FindFirstChild("BoostFx", true)
			if fx and fx:IsA("ParticleEmitter") then fx.Enabled = boosting and U.Store.profile.settings.graphics ~= "Low" end
			d.boosting = boosting
		else
			d.pos = d.body.Position
		end
		-- HUD values
		speedText.Text = tostring(math.floor(math.abs(d.speed)))
		boostFill.Size = UDim2.fromScale(d.boost / phys.boostCap, 1)
		driftFill.Size = UDim2.fromScale(math.clamp(d.driftCharge / 0.8, 0, 1), 1)
		driftFill.BackgroundColor3 = d.driftCharge >= 0.8 and T.Gold or T.Pink
		meterHint.Text = d.turbo > 0 and "MINI-TURBO!" or d.drifting and (d.driftCharge >= 0.8 and "RELEASE FOR TURBO" or "DRIFTING…") or "BOOST · DRIFT"
		-- camera
		local kcf = CFrame.new(d.pos) * CFrame.Angles(0, d.yaw, 0)
		local back = camMode == 1 and Vector3.new(0, 9, 26) or camMode == 2 and Vector3.new(0, 15, 40) or Vector3.new(0, 4.5, 2)
		local target = kcf:PointToWorldSpace(back)
		local lookAt = kcf:PointToWorldSpace(Vector3.new(0, 3, -24))
		local alpha = U.ReducedMotion and 1 or math.min(1, dt * 8)
		local cur = cam.CFrame.Position
		local pos = cur:Lerp(target, alpha)
		if (cur - target).Magnitude > 60 then pos = target end
		local camCf = CFrame.lookAt(pos, lookAt)
		if shake > 0 and not U.ReducedMotion and U.Store.profile.settings.cameraShake then
			shake -= dt
			camCf *= CFrame.new((math.random() - 0.5) * shake, (math.random() - 0.5) * shake, 0)
		end
		if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end
		cam.CFrame = camCf
		cam.FieldOfView = U.ReducedMotion and 70 or (70 + math.clamp(math.abs(d.speed) / 12, 0, 14) + (d.boosting and 6 or 0))
	end)

	-- race HUD updates from server state
	local function renderRace()
		local rs = U.Store.race
		renderScoreboard()
		if not rs or not drive or drive.mode ~= "race" then
			if drive and drive.mode == "test" then App.SetZone("📍 Test Ring · test drive") end
			return
		end
		for _, r in ipairs(rs.racers) do
			if r.userId == player.UserId then
				posText.Text = r.out and "OUT" or U.ordinal(r.place)
				posText.TextColor3 = r.out and T.Red or r.place <= 3 and T.Gold or T.Text
				posSub.Text = "/" .. #rs.racers
				lapText.Text = r.finished and "FINISHED" or ("LAP " .. r.lap .. "/" .. rs.laps)
				local track = Config.GetTrack(rs.track)
				local n = track and #track.samples or 1
				local frac = math.clamp(r.progress / (rs.laps * n), 0, 1)
				progFill.Size = UDim2.fromScale(frac, 1)
				local lapFrac = math.clamp((r.progress % n) / n, 0, 1)
				App.SetZone(string.format("📍 %s · lap %d%%", track and track.name or "Track", math.floor((r.finished and 1 or lapFrac) * 100)))
			end
		end
		U.clear(feed)
		for i, f in ipairs(rs.feed or {}) do
			local l = U.new("TextLabel", { BackgroundColor3 = T.Bg, BackgroundTransparency = 0.25, Text = "✖ " .. f.text, TextSize = 13, Font = Enum.Font.GothamBold, TextColor3 = T.Red, Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = i, Parent = feed })
			U.corner(l, 6); U.pad(l, 8, 0)
		end
	end
	U.On(function(kind)
		if kind == "race" then renderRace() end
		if kind == "tick" then
			if drive and drive.mode == "race" and U.Store.race and U.Store.race.goAt then
				local t = math.max(0, U.ServerNow() - U.Store.race.goAt)
				timeText.Text = string.format("%d:%04.1f", t // 60, t % 60)
			end
			if wheelOpen then renderCooldown() end
			if resultsTimer and U.Store.race and U.Store.race.phase == "results" and U.Store.race.resultsUntil then
				resultsTimer.Text = "Returning to hub in " .. math.max(0, math.ceil(U.Store.race.resultsUntil - U.ServerNow())) .. "s"
			elseif resultsTimer then
				resultsTimer.Text = "Back in the hub · rewards and loadout kept"
			end
		end
		if kind == "layout" then
			local compact = U.Layout.compact
			local topY = App.Top.AbsoluteSize.Y + 12
			topCard.Position = UDim2.new(0.5, 0, 0, topY)
			feed.Position = UDim2.new(1, -8, 0, topY + (compact and 64 or 0))
			topCard.Size = compact and UDim2.fromOffset(250, 56) or UDim2.fromOffset(330, 64)
			posText.TextSize = compact and 26 or 34
			sb.Size = UDim2.fromOffset(math.min(330, U.Layout.w - 90), 0)
			feed.Visible = not (compact and U.Layout.portrait)
			-- keep the meter clear of the touch steering/pedal clusters
			if UIS.TouchEnabled then
				meter.AnchorPoint = Vector2.new(0.5, 0)
				meter.Position = UDim2.new(0.5, 0, 0, topY + (compact and 62 or 72))
				meter.Size = UDim2.fromOffset(compact and 200 or 240, 58)
				exitTest.Position = UDim2.new(0.5, 0, 0, topY + (compact and 126 or 136))
			else
				meter.AnchorPoint = Vector2.new(0.5, 1)
				meter.Position = UDim2.new(0.5, 0, 1, -8)
				exitTest.Position = UDim2.new(0.5, 0, 0, topY + 74)
			end
			rail.Position = UIS.TouchEnabled and UDim2.new(1, -8, 0.36, 0) or UDim2.new(1, -8, 0.42, 0)
		end
	end)

	-- ================= Bindings =================
	CAS:BindAction("NeonRecover", function(_, st)
		if st == Enum.UserInputState.Begin and drive then recover() return Enum.ContextActionResult.Sink end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.R, Enum.KeyCode.DPadDown)
	CAS:BindAction("NeonCamera", function(_, st)
		if st == Enum.UserInputState.Begin and drive then camMode = camMode % 3 + 1 return Enum.ContextActionResult.Sink end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.C, Enum.KeyCode.DPadRight)
	CAS:BindAction("NeonScoreboard", function(_, st)
		if st == Enum.UserInputState.Begin then toggleScoreboard() end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Tab, Enum.KeyCode.DPadUp)
	CAS:BindAction("NeonQuickChat", function(_, st)
		if st == Enum.UserInputState.Begin then openWheel(nil) end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Q, Enum.KeyCode.ButtonY)
	UIS.InputBegan:Connect(function(io, processed)
		if processed or not wheelOpen then return end
		local n = io.KeyCode.Value - Enum.KeyCode.One.Value + 1
		if n >= 1 and n <= 8 then sendChat(n) end
	end)

	Race.IsDriving = function() return drive ~= nil end
	return Race
end
]]></ProtectedString>
						<string name="ScriptGuid">{93AE4F3A-664D-4D83-A7EC-10CC12FFA64A}</string>
