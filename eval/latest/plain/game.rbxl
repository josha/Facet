					<ProtectedString name="Source"><![CDATA[--!strict
local C = {}
C.Karts={
{id="ion",name="ION RUNNER",class="Street",rarity=1,speed=94,handling=82,boost=70,price=0,color="Cyan",desc="Lightweight chassis. Responsive steering for your first clean lap."},
{id="comet",name="COMET GT",class="Sport",rarity=2,speed=108,handling=70,boost=82,price=1400,color="Amber",desc="Long straights, late braking. Built to chase the horizon."},
{id="phantom",name="PHANTOM X",class="Hyper",rarity=4,speed=122,handling=66,boost=94,price=4200,color="Violet",desc="A prototype with a fierce motor and explosive boost."},
{id="atlas",name="ATLAS RALLY",class="Rally",rarity=2,speed=88,handling=98,boost=76,price=1200,color="Green",desc="Grippy all-terrain tires. Stay composed through every corner."},
{id="nova",name="NOVA RS",class="Sport",rarity=3,speed=112,handling=85,boost=88,price=2600,color="Red",desc="Perfectly balanced aerospace engineering."},
{id="vector",name="VECTOR ZERO",class="Hyper",rarity=5,speed=130,handling=78,boost=100,price=7500,color="Blue",desc="The league flagship. Earn your place at the front."}
}
C.Parts={
{id="motor1",name="Flux motor",slot="Motor",price=600,effect=8,desc="+8 top speed"},
{id="motor2",name="Quantum motor",slot="Motor",price=1800,effect=16,desc="+16 top speed"},
{id="boost1",name="Pulse cell",slot="Boost",price=500,effect=15,desc="+15 boost power"},
{id="wheel1",name="Mag-grip wheels",slot="Wheels",price=450,effect=15,desc="+15 handling"},
{id="paint1",name="Prism underglow",slot="Cosmetic",price=900,effect=0,desc="A vivid violet ground glow"}
}
C.Drivers={
{id="ace",name="ACE",group="Pilots",price=0,rent=0,speed=0,handling=3,desc="League rookie • +3 handling"},
{id="nyx",name="NYX",group="Pilots",price=2200,rent=220,speed=5,handling=4,desc="Night specialist • +5 speed, +4 handling"},
{id="bolt",name="BOLT",group="Androids",price=3000,rent=300,speed=8,handling=0,desc="Precision android • +8 speed"},
{id="echo",name="ECHO",group="Androids",price=2600,rent=260,speed=2,handling=9,desc="Adaptive navigator • +2 speed, +9 handling"}
}
C.Colors={Red={255,73,101},Amber={255,188,66},Green={92,245,157},Cyan={52,225,255},Blue={69,116,255},Violet={177,105,255}}
C.Decals={"STRIPE","CHEVRON","BOLT","ORBIT","CROSS","CIRCUIT"}
C.Tracks={{name="MIDNIGHT CIRCUIT",desc="Neon skyline • balanced corners",color="Cyan"},{name="SOLAR SPEEDWAY",desc="Amber horizon • high speed",color="Amber"},{name="VIOLET VELOCITY",desc="Deep space • technical grip",color="Violet"}}
C.Cards={"Ion schematic","Comet schematic","Flux core","Nyx portrait","Nova schematic","Prism foil","Vector schematic","Echo portrait","Golden apex","Atlas schematic","Bolt portrait","Phantom foil"}
C.Rarity={"COMMON","RARE","EPIC","LEGENDARY","MYTHIC"}
return C
]]></ProtectedString>
