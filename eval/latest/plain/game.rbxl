 if walk then workspace.CurrentCamera.CameraSubject=p.Character and p.Character:FindFirstChildOfClass("Humanoid") end
 notify(walk and "Explore the pit • use E at terminals" or "Showroom camera")
end);walkBtn.AnchorPoint=Vector2.new(1,1);walkBtn.Position=UDim2.new(1,0,1,-12);walkBtn.Size=UDim2.fromOffset(154,42)
