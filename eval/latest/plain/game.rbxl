					<ProtectedString name="Source"><![CDATA[--!strict
-- Builds neon kart models used by racers, AI and previews.
local Config = require(script.Parent.Config)

local KartBuilder = {}

local function part(props: { [string]: any }, parent: Instance, body: BasePart?): BasePart
	local p: BasePart
	if props.ClassName == "Seat" then p = Instance.new("Seat") :: any else p = Instance.new("Part") end
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "ClassName" and k ~= "Offset" then (p :: any)[k] = v end
	end
	if body then
		p.CFrame = body.CFrame * (props.Offset or CFrame.new())
		local w = Instance.new("WeldConstraint")
		w.Part0 = body
		w.Part1 = p
		w.Parent = p
	end
	p.Parent = parent
	return p
end

function KartBuilder.Build(kartId: string, livery: any?, cosmetic: string?, label: string?): Model
	local kart = Config.GetKart(kartId) or Config.Karts[1]
	local model = Instance.new("Model")
	model.Name = "Kart_" .. kart.id
	local body = part({ Name = "Body", Size = Vector3.new(6, 1.2, 10), Material = Enum.Material.SmoothPlastic, Color = kart.color, CFrame = CFrame.new() }, model)
	body.Massless = false
	body.CanQuery = false
	model.PrimaryPart = body
	part({ Name = "Nose", Size = Vector3.new(5, 0.8, 3), Material = Enum.Material.SmoothPlastic, Color = kart.color, Offset = CFrame.new(0, 0.1, -5.8) }, model, body)
	part({ Name = "AccentL", Size = Vector3.new(0.6, 0.5, 10.4), Material = Enum.Material.Neon, Color = Color3.new(1, 1, 1), Offset = CFrame.new(-2.9, 0.5, 0) }, model, body)
	part({ Name = "AccentR", Size = Vector3.new(0.6, 0.5, 10.4), Material = Enum.Material.Neon, Color = Color3.new(1, 1, 1), Offset = CFrame.new(2.9, 0.5, 0) }, model, body)
	part({ Name = "Spoiler", Size = Vector3.new(5.2, 0.25, 1.2), Material = Enum.Material.Neon, Color = Color3.new(1, 1, 1), Offset = CFrame.new(0, 1.6, 4.6) }, model, body)
	part({ Name = "SpoilerPostL", Size = Vector3.new(0.3, 1, 0.4), Material = Enum.Material.Metal, Color = Color3.fromRGB(30, 30, 40), Offset = CFrame.new(-2, 1.1, 4.6) }, model, body)
	part({ Name = "SpoilerPostR", Size = Vector3.new(0.3, 1, 0.4), Material = Enum.Material.Metal, Color = Color3.fromRGB(30, 30, 40), Offset = CFrame.new(2, 1.1, 4.6) }, model, body)
	part({ Name = "Underglow", Size = Vector3.new(5.4, 0.2, 9), Material = Enum.Material.Neon, Color = kart.color, Offset = CFrame.new(0, -0.7, 0) }, model, body)
	local plate = part({ Name = "DecalPlate", Size = Vector3.new(3, 0.1, 3), Transparency = 1, Offset = CFrame.new(0, 0.66, -4.2) }, model, body)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "DecalGui"
	sg.Face = Enum.NormalId.Top
	sg.CanvasSize = Vector2.new(100, 100)
	sg.LightInfluence = 0
	sg.Parent = plate
	local glyph = Instance.new("TextLabel")
	glyph.Name = "Glyph"
	glyph.BackgroundTransparency = 1
	glyph.Size = UDim2.fromScale(1, 1)
	glyph.Rotation = 180
	glyph.Font = Enum.Font.GothamBlack
	glyph.TextScaled = true
	glyph.TextColor3 = Color3.new(1, 1, 1)
	glyph.Text = ""
	glyph.Parent = sg
	for _, w in ipairs({ { -3.2, -3.4 }, { 3.2, -3.4 }, { -3.2, 3.4 }, { 3.2, 3.4 } }) do
		local wheel = part({ Name = "Wheel", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, 2.2, 2.2), Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(20, 20, 28), Offset = CFrame.new(w[1], -0.5, w[2]) }, model, body)
		part({ Name = "Rim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.5, 1.1, 1.1), Material = Enum.Material.Neon, Color = Color3.new(1, 1, 1), Offset = CFrame.new(w[1], -0.5, w[2]) }, model, body)
		local _ = wheel
	end
	local seat = part({ Name = "DriverSeat", Size = Vector3.new(2, 0.4, 2), Transparency = 1, Offset = CFrame.new(0, 0.6, 1) }, model, body)
	local _ = seat
	-- cosmetics
	if cosmetic == "c_halo" then
		local halo = part({ Name = "Halo", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 5, 5), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 230, 120), Transparency = 0.2, Offset = CFrame.new(0, 6, 1) * CFrame.Angles(0, 0, math.pi / 2) }, model, body)
		local _ = halo
	elseif cosmetic == "c_flame" then
		local f = part({ Name = "Exhaust", Size = Vector3.new(1, 1, 1), Transparency = 1, Offset = CFrame.new(0, 0.3, 5.4) }, model, body)
		local fire = Instance.new("Fire")
		fire.Size = 3
		fire.Heat = 0
		fire.Color = Color3.fromRGB(80, 200, 255)
		fire.SecondaryColor = Color3.fromRGB(255, 60, 180)
		fire.Parent = f
	elseif cosmetic == "c_trail" then
		local a0 = Instance.new("Attachment"); a0.Position = Vector3.new(0, 0.6, 5); a0.Parent = body
		local a1 = Instance.new("Attachment"); a1.Position = Vector3.new(0, -0.4, 5); a1.Parent = body
		local tr = Instance.new("Trail")
		tr.Attachment0 = a0
		tr.Attachment1 = a1
		tr.Lifetime = 0.6
		tr.LightEmission = 1
		tr.Color = ColorSequence.new(Color3.fromRGB(0, 230, 255), Color3.fromRGB(255, 46, 170))
		tr.Transparency = NumberSequence.new(0.1, 1)
		tr.Parent = body
	end
	local boostFx = Instance.new("ParticleEmitter")
	boostFx.Name = "BoostFx"
	boostFx.Enabled = false
	boostFx.Rate = 60
	boostFx.Lifetime = NumberRange.new(0.2, 0.4)
	boostFx.Speed = NumberRange.new(8, 14)
	boostFx.SpreadAngle = Vector2.new(10, 10)
	boostFx.LightEmission = 1
	boostFx.Size = NumberSequence.new(0.8, 0)
	boostFx.Color = ColorSequence.new(Color3.fromRGB(0, 234, 255), Color3.fromRGB(255, 46, 170))
	local exhaustAtt = Instance.new("Attachment")
	exhaustAtt.Name = "ExhaustAtt"
	exhaustAtt.Position = Vector3.new(0, 0.2, 5.2)
	exhaustAtt.Orientation = Vector3.new(0, 0, 0)
	exhaustAtt.Parent = body
	boostFx.EmissionDirection = Enum.NormalId.Back
	boostFx.Parent = exhaustAtt
	if label then
		local bb = Instance.new("BillboardGui")
		bb.Name = "NameTag"
		bb.Size = UDim2.fromOffset(160, 28)
		bb.StudsOffset = Vector3.new(0, 6.5, 0)
		bb.MaxDistance = 160
		bb.AlwaysOnTop = false
		bb.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.Name = "Label"
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.GothamBold
		t.TextScaled = true
		t.TextColor3 = Color3.new(1, 1, 1)
		t.TextStrokeTransparency = 0.3
		t.Text = label
		t.Parent = bb
		bb.Parent = body
	end
	KartBuilder.ApplyLivery(model, livery or Config.DefaultLivery)
	return model
end

function KartBuilder.ApplyLivery(model: Model, livery: any)
	local bodyColor = Config.SwatchColor(livery.body, livery.shade)
	local accent = Config.SwatchColor(livery.accent, 100)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Name == "Body" or d.Name == "Nose" then
				d.Color = bodyColor
			elseif d.Name == "AccentL" or d.Name == "AccentR" or d.Name == "Spoiler" or d.Name == "Rim" or d.Name == "Underglow" then
				d.Color = accent
			end
		end
	end
	local plate = model:FindFirstChild("DecalPlate", true)
	local glyph = plate and plate:FindFirstChild("Glyph", true)
	if glyph and glyph:IsA("TextLabel") then
		local g = ""
		for _, dc in ipairs(Config.Decals) do if dc.id == livery.decal then g = dc.glyph end end
		glyph.Text = g
		glyph.TextColor3 = accent
	end
end

return KartBuilder
]]></ProtectedString>
