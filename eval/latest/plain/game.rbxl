					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Server-owned player economy: wallet, inventory, progression, rewards and settings.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local Net = RS:WaitForChild("Net")
local RProfile = Net:WaitForChild("Profile") :: RemoteEvent
local RNotice = Net:WaitForChild("Notice") :: RemoteEvent

local Profiles = {}
Profiles.handlers = {} :: { [string]: (Player, any) -> any }
Profiles.isRacing = function(_: Player): boolean return false end

local data: { [Player]: any } = {}
local store: DataStore? = nil
local storeMode = "session"

task.spawn(function()
	local ok = pcall(function()
		local s = DataStoreService:GetDataStore("NeonCircuitProfiles_v1")
		s:GetAsync("probe")
		store = s
	end)
	storeMode = if ok then "cloud" else "session"
end)

local function now(): number
	return workspace:GetServerTimeNow()
end

local function deepCopy(t: any): any
	if type(t) ~= "table" then return t end
	local c = {}
	for k, v in t do c[k] = deepCopy(v) end
	return c
end

local function newProfile(): any
	local t = now()
	return {
		credits = 1500, shards = 50, xp = 0, level = 1, races = 0, wins = 0, lastIncome = 0,
		stats = { races = 0, driftBoosts = 0, podiums = 0, upgrades = 0 },
		parts = {}, equipped = { motor = "", boost = "", wheels = "", cosmetic = "" },
		kart = "volt", favorites = {}, upgrades = {},
		drivers = { [Config.DefaultDriver] = true }, rentals = {}, driver = Config.DefaultDriver,
		livery = deepCopy(Config.DefaultLivery),
		freeCrates = 1, collection = {},
		daily = { streak = 0, lastDay = -1 },
		codesUsed = {}, codeAttempts = {},
		boosts = {}, questsClaimed = {},
		offer = { bought = false, endsAt = t + Config.Offer.duration },
		mech = { state = "none", cells = {} },
		party = { members = {}, pending = {}, results = {} },
		settings = deepCopy(Config.DefaultSettings),
		tutorial = "",
		chatUntil = 0,
		save = { state = "saved", note = "" },
	}
end

local function dailyState(p: any)
	local today = math.floor(now() / 86400)
	local d = p.daily
	local claimedToday = d.lastDay == today
	local missed = (not claimedToday) and d.lastDay >= 0 and today - d.lastDay > 1 and d.streak > 0 and d.streak < 7
	local complete = (not claimedToday) and d.streak >= 7
	local streak = if missed or complete then 0 else d.streak
	return {
		ready = not claimedToday,
		streak = streak,
		nextIndex = streak + 1,
		missed = missed,
		complete = complete,
		nextAt = (today + 1) * 86400,
	}
end

local function offerState(p: any)
	local eligible = (not p.offer.bought) and p.level <= Config.Offer.maxLevel and now() < p.offer.endsAt
	local reason = ""
	if p.offer.bought then reason = "Already purchased"
	elseif p.level > Config.Offer.maxLevel then reason = "Only for pilots level " .. Config.Offer.maxLevel .. " or lower"
	elseif now() >= p.offer.endsAt then reason = "Offer expired" end
	return { eligible = eligible, reason = reason, endsAt = p.offer.endsAt }
end

function Profiles.snapshot(player: Player): any
	local p = data[player]
	if not p then return nil end
	local snap = deepCopy(p)
	snap.codeAttempts = nil
	snap.dailyState = dailyState(p)
	snap.offerState = offerState(p)
	snap.saveMode = storeMode
	snap.serverNow = now()
	snap.xpNeeded = Config.XpForLevel(p.level)
	snap.racing = Profiles.isRacing(player)
	return snap
end

function Profiles.push(player: Player)
	local snap = Profiles.snapshot(player)
	if snap then RProfile:FireClient(player, snap) end
end

local saveQueued: { [Player]: boolean } = {}
local function markChanged(player: Player)
	local p = data[player]
	if not p then return end
	p.save = { state = "saving", note = "" }
	Profiles.push(player)
	if saveQueued[player] then return end
	saveQueued[player] = true
	task.delay(0.6, function()
		saveQueued[player] = nil
		local q = data[player]
		if not q then return end
		local s = store
		if storeMode == "cloud" and s then
			local copy = deepCopy(q)
			copy.save = nil
			local ok, err = pcall(function()
				s:SetAsync("u" .. player.UserId, copy)
			end)
			q.save = if ok then { state = "saved", note = "Saved to cloud" } else { state = "failed", note = tostring(err):sub(1, 80) }
		else
			q.save = { state = "session", note = "Saved for this session (cloud saving unavailable here)" }
		end
		Profiles.push(player)
	end)
end
Profiles.changed = markChanged

function Profiles.get(player: Player): any
	return data[player]
end

local function canAfford(p: any, price: { [string]: number }): boolean
	return p.credits >= (price.credits or 0) and p.shards >= (price.shards or 0)
end

local function shortfall(p: any, price: { [string]: number }): string
	local miss = {}
	if p.credits < (price.credits or 0) then table.insert(miss, Config.Comma((price.credits or 0) - p.credits) .. " more Credits") end
	if p.shards < (price.shards or 0) then table.insert(miss, Config.Comma((price.shards or 0) - p.shards) .. " more Shards") end
	return "Not enough funds: you need " .. table.concat(miss, " and ") .. "."
end
Profiles.shortfall = shortfall

local function spend(p: any, price: { [string]: number })
	p.credits -= price.credits or 0
	p.shards -= price.shards or 0
end

local function addXp(p: any, amount: number): number
	local ups = 0
	p.xp += amount
	while p.xp >= Config.XpForLevel(p.level) do
		p.xp -= Config.XpForLevel(p.level)
		p.level += 1
		ups += 1
	end
	return ups
end

local function grant(p: any, reward: { [string]: any })
	p.credits += reward.credits or 0
	p.shards += reward.shards or 0
	p.freeCrates += reward.freeCrate or 0
	if reward.xp then addXp(p, reward.xp) end
	if reward.part then p.parts[reward.part] = true end
end
Profiles.grant = grant

local function boostMult(p: any, kind: string): number
	local mult = 1
	for _, b in Config.Boosts do
		if b.kind == kind and (p.boosts[b.id] or 0) > now() then mult *= b.mult end
	end
	return mult
end

function Profiles.addStat(player: Player, stat: string, n: number)
	local p = data[player]
	if not p then return end
	p.stats[stat] = (p.stats[stat] or 0) + n
	markChanged(player)
end

-- Race loadout used to build the kart and its physics on both sides.
function Profiles.loadout(player: Player): any
	local p = data[player]
	if not p then return nil end
	local parts = {}
	local look = ""
	for _, slot in Config.PartSlots do
		local id = p.equipped[slot]
		if id ~= "" and p.parts[id] then
			table.insert(parts, id)
			local def = Config.FindById(Config.Parts, id)
			if def and def.look then look = def.look end
		end
	end
	local up = p.upgrades[p.kart] or { speed = 0, handling = 0, boost = 0 }
	return { kart = p.kart, upgrades = deepCopy(up), parts = parts, driver = p.driver, livery = deepCopy(p.livery), cosmetic = look }
end

-- Grants race rewards exactly once per race id.
function Profiles.grantRace(player: Player, raceId: number, place: number, isOut: boolean): any
	local p = data[player]
	if not p then return nil end
	p.rewardedRaces = p.rewardedRaces or {}
	if p.rewardedRaces[raceId] then return nil end
	p.rewardedRaces[raceId] = true
	local baseC = Config.Rewards.credits[place] or 100
	local baseX = Config.Rewards.xp[place] or 40
	local cm, xm = boostMult(p, "credits"), boostMult(p, "xp")
	local credits = baseC * cm
	local xp = baseX * xm
	p.credits += credits
	local levelsBefore = p.level
	addXp(p, xp)
	p.races += 1
	p.stats.races += 1
	if place == 1 and not isOut then p.wins += 1 end
	if place <= 3 and not isOut then p.stats.podiums += 1 end
	p.lastIncome = credits
	markChanged(player)
	return { credits = credits, xp = xp, creditMult = cm, xpMult = xm, levelUp = p.level > levelsBefore, level = p.level }
end

local H = Profiles.handlers
local function ok(extra: any?): any
	local r = extra or {}
	r.ok = true
	return r
end
local function fail(msg: string, extra: any?): any
	local r = extra or {}
	r.ok = false
	r.err = msg
	return r
end

H.profile_get = function(player)
	return ok({ profile = Profiles.snapshot(player) })
end

H.shop_buy = function(player, a)
	local p = data[player]
	local part = Config.FindById(Config.Parts, tostring(a and a.id))
	if not part then return fail("That part does not exist.") end
	if part.exclusive then return fail(part.name .. " can only be earned from the Day 7 reward.") end
	if p.parts[part.id] then return fail("You already own " .. part.name .. ".") end
	local price = { credits = part.price }
	if not canAfford(p, price) then return fail(shortfall(p, price)) end
	spend(p, price)
	p.parts[part.id] = true
	markChanged(player)
	return ok({ msg = "Purchased " .. part.name .. " for " .. Config.Comma(part.price) .. " Credits." })
end

H.equip = function(player, a)
	local p = data[player]
	local part = Config.FindById(Config.Parts, tostring(a and a.id))
	if not part or not p.parts[part.id] then return fail("You don't own that part.") end
	local prev = p.equipped[part.slot]
	p.equipped[part.slot] = part.id
	markChanged(player)
	local prevDef = prev ~= "" and Config.FindById(Config.Parts, prev)
	return ok({ msg = if prevDef and prevDef.id ~= part.id then part.name .. " replaced " .. prevDef.name .. "." else part.name .. " equipped." })
end

H.unequip = function(player, a)
	local p = data[player]
	local slot = tostring(a and a.slot)
	if p.equipped[slot] == nil then return fail("Unknown slot.") end
	p.equipped[slot] = ""
	markChanged(player)
	return ok({ msg = (Config.SlotNames[slot] or slot) .. " slot is now empty." })
end

H.kart_select = function(player, a)
	local p = data[player]
	local kart = Config.FindById(Config.Karts, tostring(a and a.id))
	if not kart then return fail("Unknown kart.") end
	if p.level < kart.level then return fail(kart.name .. " unlocks at level " .. kart.level .. ".") end
	p.kart = kart.id
	markChanged(player)
	return ok({ msg = kart.name .. " is set for your next race." })
end

H.kart_favorite = function(player, a)
	local p = data[player]
	local kart = Config.FindById(Config.Karts, tostring(a and a.id))
	if not kart then return fail("Unknown kart.") end
	p.favorites[kart.id] = if a.on then true else nil
	markChanged(player)
	return ok()
end

local function checkRentals(player: Player)
	local p = data[player]
	if not p then return end
	local changed = false
	for id, t in p.rentals do
		if t <= now() then
			p.rentals[id] = nil
			changed = true
			local d = Config.FindById(Config.Drivers, id)
			if p.driver == id and not p.drivers[id] then
				p.driver = Config.DefaultDriver
			end
			RNotice:FireClient(player, "toast", { text = "Rental ended: " .. (if d then d.name else id) .. ". Buy to keep them permanently.", kind = "warn" })
		end
	end
	if changed then markChanged(player) end
end

H.driver_buy = function(player, a)
	local p = data[player]
	local d = Config.FindById(Config.Drivers, tostring(a and a.id))
	if not d or not d.buy then return fail("That driver can't be bought.") end
	if p.drivers[d.id] then return fail("You already own " .. d.name .. ".") end
	if not canAfford(p, d.buy) then return fail(shortfall(p, d.buy)) end
	spend(p, d.buy)
	p.drivers[d.id] = true
	p.rentals[d.id] = nil
	markChanged(player)
	return ok({ msg = d.name .. " joined your team permanently." })
end

H.driver_rent = function(player, a)
	local p = data[player]
	checkRentals(player)
	local d = Config.FindById(Config.Drivers, tostring(a and a.id))
	if not d or not d.rent then return fail("That driver can't be rented.") end
	if p.drivers[d.id] then return fail("You already own " .. d.name .. ".") end
	if p.rentals[d.id] then return fail(d.name .. " is already rented (" .. Config.Clock(p.rentals[d.id] - now()) .. " left).") end
	if not canAfford(p, d.rent) then return fail(shortfall(p, d.rent)) end
	spend(p, d.rent)
	p.rentals[d.id] = now() + Config.RentalSeconds
	markChanged(player)
	return ok({ msg = d.name .. " rented for 10 minutes." })
end

H.driver_select = function(player, a)
	local p = data[player]
	checkRentals(player)
	local d = Config.FindById(Config.Drivers, tostring(a and a.id))
	if not d then return fail("Unknown driver.") end
	if not p.drivers[d.id] and not p.rentals[d.id] then return fail(d.name .. " is not owned or rented.") end
	p.driver = d.id
	markChanged(player)
	return ok({ msg = d.name .. " will drive your next race." })
end

local function validHue(n: any): boolean
	for _, h in Config.Hues do if h.name == n then return true end end
	return false
end
H.livery_save = function(player, a)
	local p = data[player]
	if type(a) ~= "table" then return fail("Invalid design.") end
	if not validHue(a.body) or not validHue(a.accent) then return fail("Invalid color.") end
	if not table.find(Config.Shades, a.bodyShade) or not table.find(Config.Shades, a.accentShade) then return fail("Invalid shade.") end
	if not table.find(Config.Decals, a.decal) then return fail("Invalid decal.") end
	p.livery = { body = a.body, bodyShade = a.bodyShade, accent = a.accent, accentShade = a.accentShade, decal = a.decal }
	markChanged(player)
	return ok({ msg = "Livery saved." })
end

H.upgrade = function(player, a)
	local p = data[player]
	local kart = Config.FindById(Config.Karts, tostring(a and a.kart))
	local stat = tostring(a and a.stat)
	if not kart or not table.find(Config.UpgradeStats, stat) then return fail("Invalid upgrade.") end
	local up = p.upgrades[kart.id] or { speed = 0, handling = 0, boost = 0 }
	local lvl = up[stat] or 0
	if lvl >= Config.UpgradeMax then return fail("Already at maximum level.") end
	local cost = Config.UpgradeCost(lvl)
	if not canAfford(p, cost) then return fail(shortfall(p, cost)) end
	spend(p, cost)
	up[stat] = lvl + 1
	p.upgrades[kart.id] = up
	p.stats.upgrades += 1
	markChanged(player)
	return ok({ msg = kart.name .. " " .. stat .. " upgraded to level " .. (lvl + 1) .. "." })
end

local rng = Random.new()
local function rollRarity(odds: { [string]: number }): string
	local total = 0
	for _, r in Config.Rarities do total += odds[r] or 0 end
	local x = rng:NextNumber(0, total)
	for _, r in Config.Rarities do
		x -= odds[r] or 0
		if x <= 0 then return r end
	end
	return "Common"
end

H.crate_open = function(player, a)
	local p = data[player]
	local crate = Config.FindById(Config.Crates, tostring(a and a.id))
	if not crate then return fail("Unknown crate.") end
	local usedFree = false
	if crate.free and p.freeCrates > 0 then
		p.freeCrates -= 1
		usedFree = true
	else
		if not canAfford(p, crate.price) then return fail(shortfall(p, crate.price)) end
		spend(p, crate.price)
	end
	local cards = {}
	for _ = 1, crate.cards do
		local rarity = rollRarity(crate.odds)
		local pool = {}
		for _, c in Config.Cards do if c.rarity == rarity then table.insert(pool, c) end end
		local card = pool[rng:NextInteger(1, #pool)]
		local isNew = (p.collection[card.id] or 0) == 0
		p.collection[card.id] = (p.collection[card.id] or 0) + 1
		table.insert(cards, { id = card.id, isNew = isNew, count = p.collection[card.id] })
	end
	markChanged(player)
	return ok({ cards = cards, usedFree = usedFree })
end

H.daily_claim = function(player)
	local p = data[player]
	local st = dailyState(p)
	if not st.ready then return fail("Already claimed today. Next reward in " .. Config.Clock(st.nextAt - now()) .. ".") end
	local idx = st.nextIndex
	local reward = Config.Daily[idx]
	grant(p, reward)
	p.daily.streak = idx
	p.daily.lastDay = math.floor(now() / 86400)
	markChanged(player)
	return ok({ day = idx, reward = reward, restarted = st.missed })
end

local codeBusy: { [Player]: boolean } = {}
H.code_redeem = function(player, a)
	local p = data[player]
	if codeBusy[player] then return fail("busy", { kind = "busy" }) end
	local t = now()
	local recent = {}
	for _, at in p.codeAttempts do
		if t - at < Config.CodeRateWindow then table.insert(recent, at) end
	end
	p.codeAttempts = recent
	if #recent >= Config.CodeRateMax then
		local retry = math.ceil(Config.CodeRateWindow - (t - recent[1]))
		return fail("Too many attempts.", { kind = "rate", retryAt = recent[1] + Config.CodeRateWindow, retryIn = retry })
	end
	local code = string.upper((tostring(a and a.code or "")):gsub("^%s+", ""):gsub("%s+$", ""))
	if code == "" then return fail("Enter a code first.", { kind = "empty" }) end
	table.insert(p.codeAttempts, t)
	codeBusy[player] = true
	task.wait(0.5)
	codeBusy[player] = nil
	local def = Config.Codes[code]
	if not def then return fail("That code isn't valid.", { kind = "invalid" }) end
	if def.expiresAt and t > def.expiresAt then return fail("That code has expired.", { kind = "expired" }) end
	if p.codesUsed[code] then return fail("You've already used this code.", { kind = "used" }) end
	p.codesUsed[code] = true
	grant(p, def.reward)
	markChanged(player)
	return ok({ kind = "success", reward = def.reward, code = code })
end

H.boost_buy = function(player, a)
	local p = data[player]
	local b = Config.FindById(Config.Boosts, tostring(a and a.id))
	if not b then return fail("Unknown boost.") end
	if not canAfford(p, b.price) then return fail(shortfall(p, b.price)) end
	spend(p, b.price)
	p.boosts[b.id] = math.max(now(), p.boosts[b.id] or 0) + b.duration
	markChanged(player)
	return ok({ msg = b.name .. " active for 15 minutes." })
end

H.quest_claim = function(player, a)
	local p = data[player]
	local q = Config.FindById(Config.Quests, tostring(a and a.id))
	if not q then return fail("Unknown quest.") end
	if p.questsClaimed[q.id] then return fail("Reward already claimed.") end
	if (p.stats[q.stat] or 0) < q.goal then return fail("Quest not complete yet.") end
	p.questsClaimed[q.id] = true
	grant(p, q.reward)
	markChanged(player)
	return ok({ msg = "Claimed: " .. Config.PriceText(q.reward) })
end

H.offer_buy = function(player)
	local p = data[player]
	local st = offerState(p)
	if not st.eligible then return fail(st.reason) end
	if not canAfford(p, Config.Offer.price) then return fail(shortfall(p, Config.Offer.price)) end
	spend(p, Config.Offer.price)
	grant(p, Config.Offer.reward)
	p.offer.bought = true
	markChanged(player)
	return ok({ msg = Config.Offer.name .. " claimed!" })
end

-- Mechanic job
H.mech_accept = function(player)
	local p = data[player]
	if p.mech.state ~= "none" then return fail("You already have this job.") end
	p.mech.state = "active"
	markChanged(player)
	return ok()
end
H.mech_decline = function(player)
	return ok()
end
H.mech_turnin = function(player)
	local p = data[player]
	if p.mech.state == "done" then return fail("Juno already paid you for this job.") end
	local count = 0
	for _ in p.mech.cells do count += 1 end
	if p.mech.state ~= "active" or count < Config.PowerCells then return fail("You still need " .. (Config.PowerCells - count) .. " more power cells.") end
	p.mech.state = "done"
	grant(p, Config.MechanicReward)
	markChanged(player)
	return ok({ msg = "Juno paid you " .. Config.PriceText(Config.MechanicReward) .. "." })
end

function Profiles.collectCell(player: Player, cellId: number)
	local p = data[player]
	if not p or p.mech.state ~= "active" then return end
	if p.mech.cells[tostring(cellId)] then return end
	p.mech.cells[tostring(cellId)] = true
	local count = 0
	for _ in p.mech.cells do count += 1 end
	RNotice:FireClient(player, "toast", { text = "Power cell collected (" .. count .. "/" .. Config.PowerCells .. ")", kind = "good" })
	markChanged(player)
end

-- Party: demo participants plus friends in this server
local DEMO = {
	{ id = -101, name = "Nova (Demo)", status = "online", reply = "accepted" },
	{ id = -102, name = "Rex (Demo)", status = "online", reply = "declined" },
	{ id = -103, name = "Lyra (Demo)", status = "online", reply = "accepted" },
	{ id = -104, name = "Pixel (Demo)", status = "racing" },
	{ id = -105, name = "Echo (Demo)", status = "offline" },
	{ id = -106, name = "Bolt (Demo)", status = "offline" },
}
local friendCache: { [Player]: { any } } = {}

local function friendList(player: Player): { any }
	local list = {}
	for _, d in DEMO do
		table.insert(list, { id = d.id, name = d.name, status = d.status, demo = true })
	end
	if not friendCache[player] then
		local real = {}
		pcall(function()
			local pages = Players:GetFriendsAsync(player.UserId)
			for _, f in pages:GetCurrentPage() do
				table.insert(real, { id = f.Id, name = f.DisplayName or f.Username, online = f.IsOnline })
			end
		end)
		friendCache[player] = real
	end
	for _, f in friendCache[player] do
		local here = Players:GetPlayerByUserId(f.id)
		local status = if here then (if Profiles.isRacing(here) then "racing" else "online") elseif f.online then "elsewhere" else "offline"
		table.insert(list, { id = f.id, name = f.name, status = status, demo = false })
	end
	return list
end

H.party_list = function(player)
	return ok({ friends = friendList(player) })
end

H.party_invite = function(player, a)
	local p = data[player]
	local id = tonumber(a and a.id)
	local target
	for _, f in friendList(player) do if f.id == id then target = f end end
	if not target then return fail("That friend isn't on your list.") end
	local key = tostring(target.id)
	if p.party.members[key] then return fail(target.name .. " is already in your party.") end
	if p.party.pending[key] then return fail("Invite to " .. target.name .. " is already pending.") end
	if target.status == "offline" then return fail(target.name .. " is offline.") end
	if target.status == "racing" then return fail(target.name .. " is in a race right now.") end
	if target.status == "elsewhere" then return fail(target.name .. " is online in another server.") end
	local count = 0
	for _ in p.party.members do count += 1 end
	if count >= 3 then return fail("Your party is full (4 racers).") end
	p.party.pending[key] = target.name
	p.party.results[key] = nil
	markChanged(player)
	local reply = "declined"
	for _, d in DEMO do if d.id == target.id then reply = d.reply or "declined" end end
	task.delay(if reply == "accepted" then 2.5 else 3, function()
		local q = data[player]
		if not q or not q.party.pending[key] then return end
		q.party.pending[key] = nil
		q.party.results[key] = reply
		if reply == "accepted" then q.party.members[key] = target.name end
		RNotice:FireClient(player, "toast", { text = target.name .. " " .. reply .. " your invite.", kind = if reply == "accepted" then "good" else "warn" })
		markChanged(player)
	end)
	return ok({ msg = "Invite sent to " .. target.name .. "." })
end

H.party_remove = function(player, a)
	local p = data[player]
	local key = tostring(a and a.id)
	if not p.party.members[key] then return fail("Not in your party.") end
	p.party.members[key] = nil
	p.party.results[key] = nil
	markChanged(player)
	return ok()
end

-- Settings
local function validSettings(s: any): (boolean, string?)
	if type(s) ~= "table" then return false, "Invalid settings." end
	if type(s.music) ~= "number" or s.music < 0 or s.music > 100 then return false, "Music volume must be 0-100." end
	if type(s.sfx) ~= "number" or s.sfx < 0 or s.sfx > 100 then return false, "Effects volume must be 0-100." end
	if type(s.damageNumbers) ~= "boolean" or type(s.cameraShake) ~= "boolean" or type(s.reducedMotion) ~= "boolean" then return false, "Invalid toggle." end
	if not table.find(Config.GraphicsOptions, s.graphics) then return false, "Invalid graphics quality." end
	if not table.find(Config.TextScales, s.textScale) then return false, "Invalid text size." end
	return true, nil
end
H.settings_save = function(player, a)
	local p = data[player]
	local valid, err = validSettings(a)
	if not valid then return fail(err or "Invalid settings.") end
	p.settings = { music = math.floor(a.music), sfx = math.floor(a.sfx), damageNumbers = a.damageNumbers, cameraShake = a.cameraShake, graphics = a.graphics, textScale = a.textScale, reducedMotion = a.reducedMotion }
	markChanged(player)
	return ok()
end
H.settings_reset = function(player)
	local p = data[player]
	p.settings = deepCopy(Config.DefaultSettings)
	markChanged(player)
	return ok()
end

H.tutorial_set = function(player, a)
	local p = data[player]
	local st = tostring(a and a.state)
	if st ~= "done" and st ~= "skipped" then return fail("Invalid state.") end
	p.tutorial = st
	markChanged(player)
	return ok()
end

H.chat_send = function(player, a)
	local p = data[player]
	local idx = tonumber(a and a.index)
	if not idx or not Config.QuickChat[idx] then return fail("Unknown message.") end
	if now() < p.chatUntil then return fail("Cooldown", { until_ = p.chatUntil }) end
	p.chatUntil = now() + Config.ChatCooldown
	RNotice:FireAllClients("chat", { from = player.DisplayName, userId = player.UserId, text = Config.QuickChat[idx] })
	Profiles.push(player)
	return ok({ until_ = p.chatUntil })
end

local function onAdded(player: Player)
	local p = newProfile()
	data[player] = p
	local s = store
	if storeMode == "cloud" and s then
		local okLoad, saved = pcall(function()
			return s:GetAsync("u" .. player.UserId)
		end)
		if okLoad and type(saved) == "table" then
			for k, v in saved do p[k] = v end
			p.save = { state = "saved", note = "Loaded from cloud" }
		end
	else
		p.save = { state = "session", note = "Progress is kept for this session only" }
	end
	Profiles.push(player)
end
Players.PlayerAdded:Connect(onAdded)
for _, pl in Players:GetPlayers() do task.spawn(onAdded, pl) end
Players.PlayerRemoving:Connect(function(player)
	data[player] = nil
	friendCache[player] = nil
end)

task.spawn(function()
	while true do
		task.wait(1)
		for player in data do
			checkRentals(player)
		end
	end
end)

return Profiles
]]></ProtectedString>
					<string name="ScriptGuid">{5677E939-C821-46FE-94E2-423F289F0E94}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Profiles</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">0b2ac657583187020afced10000015de</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX5240EB2B1ABD413BAA6BA8954FB53D8C">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Server-owned race flow: queue, track vote, AI opponents, validated driving, laps, knockouts and rewards.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local Track = require(RS.Shared.Track)
local Net = RS:WaitForChild("Net")
local RDriveEvent = Net:WaitForChild("DriveEvent") :: RemoteEvent
local RNotice = Net:WaitForChild("Notice") :: RemoteEvent
local RSnapshot = Net:WaitForChild("Snapshot") :: UnreliableRemoteEvent
local RLobby = Net:WaitForChild("Lobby") :: RemoteEvent
local RDrive = Net:WaitForChild("Drive") :: UnreliableRemoteEvent
local Profiles = require(script.Parent.Profiles)

local Race = {}
Race.handlers = {} :: { [string]: (Player, any) -> any }

local function now(): number
	return workspace:GetServerTimeNow()
end

local AI_NAMES = { "Byte", "Glitch", "Nova-7", "Static", "Lumen", "Vex", "Zephyr", "Kilo" }

local S: any = {
	phase = "idle", mode = "Solo", required = 1, queue = {}, endsAt = 0, message = "",
	votes = {}, voters = {}, trackId = "", raceId = 0, racers = {}, feed = {}, results = nil,
	startAt = 0, koDone = {}, grace = 0, returned = {},
}
local pts: { Vector3 } = Track.Points("neon_loop")
local dirty = true

local function racerOf(player: Player): any
	for _, r in S.racers do
		if r.player == player then return r end
	end
	return nil
end

function Race.isRacing(player: Player): boolean
	if S.phase == "countdown" or S.phase == "racing" or S.phase == "results" then
		local r = racerOf(player)
		return r ~= nil and not S.returned[player]
	end
	return false
end
Profiles.isRacing = Race.isRacing

local function progress(r: any): number
	return r.lapCount * Track.N + r.idx + r.frac
end

local function ordered(): { any }
	local list = table.clone(S.racers)
	table.sort(list, function(a, b)
		if a.finished ~= b.finished then return a.finished end
		if a.finished then return a.finishTime < b.finishTime end
		if a.out ~= b.out then return not a.out end
		if a.out then return a.outAt > b.outAt end
		return progress(a) > progress(b)
	end)
	for i, r in list do r.place = i end
	return list
end

local function laps(): number
	local def = Config.FindById(Config.Tracks, S.trackId)
	return if def then def.laps else 3
end

local function publicState(): any
	local racers = {}
	if #S.racers > 0 then
		for _, r in ordered() do
			table.insert(racers, {
				key = r.key, name = r.name, userId = r.userId, isAI = r.isAI, kart = r.loadout.kart,
				livery = r.loadout.livery, cosmetic = r.loadout.cosmetic,
				lap = math.clamp(r.lapCount, 1, laps()), place = r.place, finished = r.finished, out = r.out,
				finishTime = r.finishTime, nitro = r.nitroLeft,
			})
		end
	end
	local queue = {}
	for _, p in S.queue do table.insert(queue, { name = p.DisplayName, userId = p.UserId }) end
	local counts = {}
	for _, t in Config.Tracks do counts[t.id] = 0 end
	for _, tid in S.votes do counts[tid] = (counts[tid] or 0) + 1 end
	return {
		phase = S.phase, mode = S.mode, required = S.required, queue = queue, endsAt = S.endsAt, message = S.message,
		votes = S.votes, voteCounts = counts, voters = S.voters, trackId = S.trackId, laps = laps(), raceId = S.raceId,
		racers = racers, feed = S.feed, results = S.results, startAt = S.startAt, serverNow = now(),
	}
end

local function broadcast()
	dirty = false
	RLobby:FireAllClients(publicState())
end
local function markDirty()
	dirty = true
end

local function setPhase(phase: string, duration: number, msg: string?)
	S.phase = phase
	S.endsAt = now() + duration
	S.message = msg or ""
	broadcast()
end

local function sendCharacter(player: Player, toLounge: boolean)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not char or not hrp then return end
	if toLounge then
		hrp.Anchored = true
		char:PivotTo(CFrame.new(0, 305, 0))
	else
		char:PivotTo(CFrame.new(math.random(-8, 8), 4, 40 + math.random(-4, 4)))
		hrp.Anchored = false
	end
end

local function resetLobby()
	for _, r in S.racers do
		if r.player and not S.returned[r.player] then
			sendCharacter(r.player, false)
		end
	end
	S.phase = "idle"
	S.queue = {}
	S.votes = {}
	S.voters = {}
	S.racers = {}
	S.feed = {}
	S.results = nil
	S.koDone = {}
	S.returned = {}
	S.grace = 0
	S.message = ""
	for _, p in Players:GetPlayers() do Profiles.push(p) end
	broadcast()
end

local function makeRacer(i: number, player: Player?): any
	local loadout
	local name, userId, isAI
	if player then
		loadout = Profiles.loadout(player)
		name, userId, isAI = player.DisplayName, player.UserId, false
	else
		local kart = Config.Karts[math.random(1, 6)]
		local hue = Config.Hues[math.random(1, #Config.Hues)].name
		local acc = Config.Hues[math.random(1, #Config.Hues)].name
		loadout = { kart = kart.id, upgrades = {}, parts = {}, driver = "ray", cosmetic = "",
			livery = { body = hue, bodyShade = 75, accent = acc, accentShade = 100, decal = Config.Decals[math.random(2, #Config.Decals)] } }
		name, userId, isAI = AI_NAMES[i] or ("Bot " .. i), 0, true
	end
	local phys = Config.KartPhysics(loadout.kart, loadout.upgrades, loadout.parts, loadout.driver)
	return {
		key = if player then "p" .. player.UserId else "ai" .. i, name = name, userId = userId, isAI = isAI, player = player,
		loadout = loadout, phys = phys, pos = Vector3.zero, yaw = 0, speed = 0, idx = Track.N - 1, frac = 0,
		lapCount = 0, halfway = false, finished = false, finishTime = 0, out = false, outAt = 0, place = i,
		nitroLeft = phys.nitro, boostUntil = 0, lastUpdate = now(), lastDrift = 0,
		skill = 0.8 + math.random() * 0.1, lane = math.random(-8, 8), nextAct = now() + 3 + math.random() * 4,
	}
end

local function beginVoting()
	S.votes = {}
	S.voters = {}
	S.racers = {}
	local humans = table.clone(S.queue)
	for _, p in humans do
		table.insert(S.voters, { key = "p" .. p.UserId, name = p.DisplayName, isAI = false })
	end
	local aiCount = Config.RacerCount - #humans
	local names = table.clone(AI_NAMES)
	for i = 1, aiCount do
		table.insert(S.voters, { key = "ai" .. i, name = names[i], isAI = true })
		local key = "ai" .. i
		task.delay(1.5 + math.random() * 7, function()
			if S.phase == "voting" then
				S.votes[key] = Config.Tracks[math.random(1, #Config.Tracks)].id
				broadcast()
			end
		end)
	end
	setPhase("voting", 12, "Vote for the next track")
end

local function reveal()
	local counts = {}
	for _, t in Config.Tracks do counts[t.id] = 0 end
	for _, tid in S.votes do counts[tid] += 1 end
	local best, tied = -1, {}
	for _, t in Config.Tracks do
		if counts[t.id] > best then best, tied = counts[t.id], { t.id }
		elseif counts[t.id] == best then table.insert(tied, t.id) end
	end
	S.trackId = tied[math.random(1, #tied)]
	local def = Config.FindById(Config.Tracks, S.trackId)
	setPhase("reveal", 3.5, (if def then def.name else S.trackId) .. " wins the vote with " .. best .. " vote" .. (if best == 1 then "" else "s"))
end

local function startRace()
	pts = Track.Points(S.trackId)
	S.raceId += 1
	S.racers = {}
	S.feed = {}
	S.koDone = {}
	S.returned = {}
	S.grace = 0
	S.results = nil
	local humans = table.clone(S.queue)
	local slots = {}
	local aiIdx = 0
	for slot = 1, Config.RacerCount do
		local r
		if slot >= 3 and #humans > 0 then
			r = makeRacer(slot, table.remove(humans, 1))
		elseif #humans > 0 and slot > Config.RacerCount - #humans then
			r = makeRacer(slot, table.remove(humans, 1))
		else
			aiIdx += 1
			r = makeRacer(aiIdx, nil)
		end
		local pos, yaw = Track.GridSlot(pts, slot)
		r.pos = pos
		r.yaw = yaw
		local idx, t = Track.Project(pts, pos)
		r.idx, r.frac = idx, t
		table.insert(S.racers, r)
		slots[slot] = r
	end
	for _, r in S.racers do
		if r.player then
			sendCharacter(r.player, true)
			Profiles.push(r.player)
		end
	end
	S.startAt = now() + 4.5
	setPhase("countdown", 4.5, "Get ready")
end

local function addFeed(text: string, kind: string)
	table.insert(S.feed, { text = text, kind = kind, t = now() })
	while #S.feed > 4 do table.remove(S.feed, 1) end
	markDirty()
end

local function finishRace()
	local list = ordered()
	local results = { order = {}, rewards = {}, trackId = S.trackId, raceId = S.raceId }
	for i, r in list do
		local status = if r.finished then "Finished" elseif r.out then "OUT" else "DNF"
		table.insert(results.order, { place = i, name = r.name, userId = r.userId, isAI = r.isAI, key = r.key,
			status = status, time = if r.finished then r.finishTime - S.startAt else nil, kart = r.loadout.kart })
		if r.player and r.player.Parent then
			local rew = Profiles.grantRace(r.player, S.raceId, i, r.out)
			if rew then results.rewards[r.key] = rew end
		end
	end
	S.results = results
	setPhase("results", 20, "Race complete")
end

local function knockoutCheck(leaderLap: number)
	local def = Config.FindById(Config.Tracks, S.trackId)
	if not def or def.mode ~= "Knockout" then return end
	if leaderLap < 2 or leaderLap > def.laps or S.koDone[leaderLap] then return end
	local active = {}
	for _, r in ordered() do
		if not r.out and not r.finished then table.insert(active, r) end
	end
	if #active <= 2 then return end
	S.koDone[leaderLap] = true
	local last = active[#active]
	last.out = true
	last.outAt = now()
	addFeed(last.name .. " is OUT (lap " .. (leaderLap - 1) .. ")", "out")
	if last.player then
		RNotice:FireClient(last.player, "out", { text = "You were knocked out!" })
	end
end

local function updateProgress(r: any, newPos: Vector3)
	local idx, t = Track.Project(pts, newPos, r.idx, 6)
	local N = Track.N
	if r.idx >= N - 8 and idx <= 8 then
		if r.lapCount == 0 or r.halfway then
			r.lapCount += 1
			r.halfway = false
			if r.lapCount > laps() then
				r.finished = true
				r.finishTime = now()
				addFeed(r.name .. " finished " .. Config.Ordinal(#(function() local c = {} for _, o in S.racers do if o.finished then table.insert(c, o) end end return c end)()), "finish")
			else
				local maxLap = 0
				for _, o in S.racers do if o.lapCount > maxLap then maxLap = o.lapCount end end
				if r.lapCount == maxLap then knockoutCheck(r.lapCount) end
			end
		end
	elseif r.idx <= 8 and idx >= N - 8 then
		if r.lapCount > 0 then
			r.lapCount -= 1
			r.halfway = true
		end
	end
	if math.abs(idx - N / 2) <= 5 then r.halfway = true end
	r.idx, r.frac = idx, t
	r.pos = newPos
end

local function angleDiff(a: number, b: number): number
	local d = (b - a) % (math.pi * 2)
	if d > math.pi then d -= math.pi * 2 end
	return d
end

local function stepAI(r: any, dt: number)
	local look = Track.Wrap(r.idx + 3)
	local target = pts[look] + Track.Right(pts, look) * r.lane
	local to = Vector3.new(target.X - r.pos.X, 0, target.Z - r.pos.Z)
	if to.Magnitude < 0.1 then return end
	local desired = Track.Yaw(to.Unit)
	local diff = angleDiff(r.yaw, desired)
	local maxTurn = r.phys.turn * 1.3 * dt
	r.yaw += math.clamp(diff, -maxTurn, maxTurn)
	local t = now()
	if t > r.nextAct then
		r.nextAct = t + 3 + math.random() * 5
		r.lane = math.clamp(r.lane + math.random(-6, 6), -12, 12)
		if r.nitroLeft > 0 and math.random() < 0.35 then
			r.nitroLeft -= 1
			r.boostUntil = t + 2
		elseif math.random() < 0.4 then
			r.boostUntil = t + 0.8
		end
	end
	-- light rubber band toward the human field
	local band = 1
	for _, o in S.racers do
		if o.player and not o.finished and not o.out then
			local gap = progress(r) - progress(o)
			if gap > 8 then band = math.min(band, 0.86) elseif gap < -14 then band = math.max(band, 1.05) end
		end
	end
	local targetSpeed = r.phys.maxSpeed * r.skill * band * (1 - math.min(math.abs(diff), 0.6) * 0.45)
	if t < r.boostUntil then targetSpeed *= r.phys.boostMul end
	if r.speed < targetSpeed then
		r.speed = math.min(targetSpeed, r.speed + r.phys.accel * dt)
	else
		r.speed = math.max(targetSpeed, r.speed - 40 * dt)
	end
	local fwd = CFrame.Angles(0, r.yaw, 0).LookVector
	local newPos = r.pos + fwd * r.speed * dt
	local _, _, lateral, center = Track.Project(pts, newPos, r.idx, 4)
	local limit = Track.HalfWidth - 2.5
	if math.abs(lateral) > limit then
		local i = Track.Project(pts, newPos, r.idx, 4)
		newPos = center + Track.Right(pts, i) * math.sign(lateral) * limit
		r.speed *= 0.97
	end
	updateProgress(r, Vector3.new(newPos.X, Track.RoadY, newPos.Z))
end

local snapAcc, lobbyAcc = 0, 0
RunService.Heartbeat:Connect(function(dt)
	local t = now()
	local phase = S.phase
	if phase == "starting" and t >= S.endsAt then
		beginVoting()
	elseif phase == "voting" and t >= S.endsAt then
		reveal()
	elseif phase == "reveal" and t >= S.endsAt then
		startRace()
	elseif phase == "countdown" and t >= S.startAt then
		for _, r in S.racers do r.lastUpdate = t end
		setPhase("racing", 300, "")
	elseif phase == "racing" then
		for _, r in S.racers do
			if r.isAI and not r.finished and not r.out then stepAI(r, dt) end
		end
		local humansDone = true
		local allDone = true
		for _, r in S.racers do
			if not r.finished and not r.out then
				allDone = false
				if not r.isAI then humansDone = false end
			end
		end
		if humansDone and S.grace == 0 then S.grace = t + 5 end
		if allDone or (S.grace > 0 and t >= S.grace) or t >= S.endsAt then
			finishRace()
		end
	elseif phase == "results" and t >= S.endsAt then
		resetLobby()
	end
	if S.phase == "racing" or S.phase == "countdown" then
		snapAcc += dt
		if snapAcc >= 0.05 then
			snapAcc = 0
			local list = {}
			for _, r in S.racers do
				table.insert(list, { r.key, r.pos.X, r.pos.Z, r.yaw, r.speed, t < r.boostUntil })
			end
			for _, r in S.racers do
				if r.player and not S.returned[r.player] then
					RSnapshot:FireClient(r.player, t, list)
				end
			end
		end
	end
	lobbyAcc += dt
	if dirty or ((S.phase == "racing" or S.phase == "voting") and lobbyAcc > 0.25) then
		lobbyAcc = 0
		broadcast()
	end
end)

local function correct(player: Player, r: any)
	RNotice:FireClient(player, "correct", { x = r.pos.X, z = r.pos.Z, yaw = r.yaw, speed = r.speed })
end

RDrive.OnServerEvent:Connect(function(player, x: any, z: any, yaw: any, speed: any)
	if S.phase ~= "racing" then return end
	local r = racerOf(player)
	if not r or r.finished or r.out then return end
	if type(x) ~= "number" or type(z) ~= "number" or type(yaw) ~= "number" or type(speed) ~= "number" then return end
	if x ~= x or z ~= z or yaw ~= yaw then return end
	local t = now()
	local dt = math.max(t - r.lastUpdate, 1 / 60)
	local newPos = Vector3.new(x, Track.RoadY, z)
	local dist = (Vector3.new(newPos.X, 0, newPos.Z) - Vector3.new(r.pos.X, 0, r.pos.Z)).Magnitude
	local maxStep = r.phys.maxSpeed * r.phys.boostMul * 1.35 * dt + 4
	r.lastUpdate = t
	if dist > maxStep then
		correct(player, r)
		return
	end
	local _, _, lateral = Track.Project(pts, newPos, r.idx, 6)
	if math.abs(lateral) > Track.HalfWidth + 4 then
		correct(player, r)
		return
	end
	r.yaw = yaw
	r.speed = math.clamp(speed, -60, r.phys.maxSpeed * r.phys.boostMul * 1.1)
	updateProgress(r, newPos)
end)

RDriveEvent.OnServerEvent:Connect(function(player, kind: any)
	local r = racerOf(player)
	if not r or S.phase ~= "racing" or r.finished or r.out then return end
	local t = now()
	if kind == "reset" then
		local i = r.idx
		r.pos = pts[i]
		r.yaw = Track.Yaw(Track.Direction(pts, i))
		r.speed = 0
		r.frac = 0
		correct(player, r)
	elseif kind == "nitro" then
		if r.nitroLeft > 0 then
			r.nitroLeft -= 1
			r.boostUntil = t + 2
			RNotice:FireClient(player, "nitro", { left = r.nitroLeft, ok = true })
		else
			RNotice:FireClient(player, "nitro", { left = 0, ok = false })
		end
		markDirty()
	elseif kind == "drift" then
		if t - r.lastDrift > 1.2 then
			r.lastDrift = t
			r.boostUntil = math.max(r.boostUntil, t + 0.8)
			Profiles.addStat(player, "driftBoosts", 1)
		end
	end
end)

local function inQueue(player: Player): number?
	return table.find(S.queue, player)
end

local function leaveQueue(player: Player, why: string?)
	local i = inQueue(player)
	if not i then return end
	table.remove(S.queue, i)
	if S.phase == "starting" or S.phase == "voting" or S.phase == "reveal" then
		if #S.queue < S.required then
			S.votes = {}
			S.voters = {}
			if #S.queue == 0 then
				resetLobby()
				S.message = why or ""
				broadcast()
				return
			end
			S.phase = "queue"
			S.message = "Start cancelled: " .. player.DisplayName .. " left before the race began."
			broadcast()
			return
		end
	elseif S.phase == "queue" and #S.queue == 0 then
		resetLobby()
		return
	end
	broadcast()
end

local H = Race.handlers
local previewing: { [Player]: boolean } = {}
H.queue_join = function(player, a)
	local mode = if a and a.mode == "Duo" then "Duo" else "Solo"
	if inQueue(player) then return { ok = false, err = "You're already in the queue." } end
	if previewing[player] then return { ok = false, err = "Exit the test drive first." } end
	if S.phase == "countdown" or S.phase == "racing" or S.phase == "results" or S.phase == "voting" or S.phase == "reveal" then
		return { ok = false, err = "A race is in progress. The queue reopens when it finishes." }
	end
	if S.phase == "idle" then
		S.mode = mode
		S.required = if mode == "Duo" then 2 else 1
		S.phase = "queue"
		S.message = ""
	elseif S.mode ~= mode then
		return { ok = false, err = "A " .. S.mode .. " queue is forming. Join " .. S.mode .. " or wait for it to start." }
	end
	if #S.queue >= Config.RacerCount then return { ok = false, err = "The queue is full." } end
	table.insert(S.queue, player)
	if #S.queue >= S.required and S.phase == "queue" then
		setPhase("starting", 5, "Race starting")
	else
		broadcast()
	end
	return { ok = true }
end

H.queue_leave = function(player)
	if not inQueue(player) then return { ok = false, err = "You're not in the queue." } end
	if S.phase ~= "queue" and S.phase ~= "starting" then return { ok = false, err = "The race has already begun." } end
	leaveQueue(player, "")
	return { ok = true }
end

H.vote = function(player, a)
	if S.phase ~= "voting" then return { ok = false, err = "Voting has closed." } end
	if not inQueue(player) then return { ok = false, err = "Only racers in this race can vote." } end
	local tid = tostring(a and a.id)
	if not Config.FindById(Config.Tracks, tid) then return { ok = false, err = "Unknown track." } end
	S.votes["p" .. player.UserId] = tid
	broadcast()
	return { ok = true }
end

H.results_return = function(player)
	local r = racerOf(player)
	if not r or S.phase ~= "results" then return { ok = false, err = "No results to leave." } end
	if not S.returned[player] then
		S.returned[player] = true
		sendCharacter(player, false)
	end
	local all = true
	for _, o in S.racers do
		if o.player and o.player.Parent and not S.returned[o.player] then all = false end
	end
	if all then resetLobby() else broadcast() end
	Profiles.push(player)
	return { ok = true }
end

H.preview_start = function(player)
	if Race.isRacing(player) or inQueue(player) then return { ok = false, err = "Leave the race queue before a test drive." } end
	previewing[player] = true
	sendCharacter(player, true)
	return { ok = true }
end
H.preview_end = function(player)
	if previewing[player] then
		previewing[player] = nil
		sendCharacter(player, false)
	end
	return { ok = true }
end

H.lobby_get = function(_)
	return { ok = true, state = publicState() }
end

Players.PlayerRemoving:Connect(function(player)
	if inQueue(player) and (S.phase == "queue" or S.phase == "starting" or S.phase == "voting" or S.phase == "reveal") then
		leaveQueue(player, player.DisplayName .. " left")
	end
	local r = racerOf(player)
	if r and not r.finished and not r.out then
		r.out = true
		r.outAt = now()
		r.player = nil
		addFeed(r.name .. " disconnected", "out")
	end
end)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.2)
		if Race.isRacing(player) then sendCharacter(player, true) end
	end)
end)

return Race
]]></ProtectedString>
