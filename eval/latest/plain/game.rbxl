						<ProtectedString name="Source"><![CDATA[--!strict
-- Shared interface kit: theme, text scaling, buttons, panels, dialogs, toasts, sliders.
local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local UI = {}
UI.T = {
	bg = Color3.fromRGB(8, 9, 22), panel = Color3.fromRGB(14, 16, 36), card = Color3.fromRGB(24, 27, 56), cardHi = Color3.fromRGB(36, 40, 80),
	cyan = Color3.fromRGB(0, 235, 255), magenta = Color3.fromRGB(255, 50, 210), amber = Color3.fromRGB(255, 186, 30), green = Color3.fromRGB(40, 255, 140),
	red = Color3.fromRGB(255, 70, 100), violet = Color3.fromRGB(175, 90, 255), text = Color3.fromRGB(236, 240, 255), muted = Color3.fromRGB(160, 168, 205), dim = Color3.fromRGB(95, 100, 140),
}
UI.F = {
	title = Font.new("rbxasset://fonts/families/Michroma.json", Enum.FontWeight.Regular),
	body = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium),
	bold = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold),
}
UI.textMult = 1
UI.reducedMotion = false
local scaled: { [Instance]: number } = setmetatable({}, { __mode = "k" }) :: any

function UI.setTextMult(m: number)
	UI.textMult = m
	for obj, base in scaled do
		if obj.Parent then (obj :: any).TextSize = math.floor(base * m + 0.5) end
	end
end

function UI.new(class: string, props: { [string]: any }?, children: { Instance }?): any
	local o = Instance.new(class)
	if props then
		for k, v in props do
			if k ~= "Parent" then (o :: any)[k] = v end
		end
	end
	if children then for _, c in children do c.Parent = o end end
	if props and props.Parent then o.Parent = props.Parent end
	return o
end
local new = UI.new

function UI.corner(o: Instance, r: number?): UICorner
	return new("UICorner", { CornerRadius = UDim.new(0, r or 10), Parent = o })
end
function UI.stroke(o: Instance, color: Color3?, th: number?, tr: number?): UIStroke
	return new("UIStroke", { Color = color or UI.T.cyan, Thickness = th or 1.5, Transparency = tr or 0.35, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = o })
end
function UI.pad(o: Instance, p: number, pl: number?): UIPadding
	local h = UDim.new(0, pl or p)
	return new("UIPadding", { PaddingTop = UDim.new(0, p), PaddingBottom = UDim.new(0, p), PaddingLeft = h, PaddingRight = h, Parent = o })
end
function UI.list(o: Instance, dir: Enum.FillDirection?, gap: number?, align: Enum.HorizontalAlignment?): UIListLayout
	return new("UIListLayout", { FillDirection = dir or Enum.FillDirection.Vertical, Padding = UDim.new(0, gap or 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = align or Enum.HorizontalAlignment.Left, Parent = o })
end
function UI.scaleText(o: Instance, base: number)
	scaled[o] = base;
	(o :: any).TextSize = math.floor(base * UI.textMult + 0.5)
end

function UI.label(parent: Instance?, text: string, size: number?, props: { [string]: any }?): TextLabel
	local l = new("TextLabel", {
		BackgroundTransparency = 1, Text = text, TextColor3 = UI.T.text, FontFace = UI.F.body, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, RichText = true,
	})
	if props then for k, v in props do (l :: any)[k] = v end end
	UI.scaleText(l, size or 16)
	l.Parent = parent
	return l
end

function UI.fmt(n: number): string
	local s = tostring(math.floor(n))
	local neg = string.sub(s, 1, 1) == "-"
	if neg then s = string.sub(s, 2) end
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if string.sub(out, 1, 1) == "," then out = string.sub(out, 2) end
	return (if neg then "-" else "") .. out
end
function UI.short(n: number): string
	if n >= 1e6 then return string.format("%.1fM", n / 1e6) end
	if n >= 1e4 then return string.format("%.1fK", n / 1e3) end
	return UI.fmt(n)
end
function UI.clock(sec: number): string
	sec = math.max(0, math.floor(sec))
	local h = sec // 3600
	local mm = (sec % 3600) // 60
	local ss = sec % 60
	if h > 0 then return string.format("%d:%02d:%02d", h, mm, ss) end
	return string.format("%d:%02d", mm, ss)
end

export type BtnOpts = { color: Color3?, textColor: Color3?, size: UDim2?, textSize: number?, bold: boolean?, filled: boolean?, layoutOrder: number?, auto: boolean?, name: string? }
function UI.button(parent: Instance?, text: string, opts: BtnOpts?, onClick: (() -> ())?): TextButton
	local o = opts or {}
	local color = o.color or UI.T.cyan
	local filled = o.filled ~= false
	local b = new("TextButton", {
		Name = o.name or text, Text = text, AutoButtonColor = false, FontFace = if o.bold == false then UI.F.body else UI.F.bold,
		TextColor3 = o.textColor or (if filled then UI.T.bg else color), BackgroundColor3 = if filled then color else UI.T.card,
		Size = o.size or UDim2.new(0, 140, 0, 44), LayoutOrder = o.layoutOrder or 0, Selectable = true, TextWrapped = true,
		AutomaticSize = if o.auto then Enum.AutomaticSize.X else Enum.AutomaticSize.None,
	})
	UI.scaleText(b, o.textSize or 16)
	UI.corner(b, 10)
	local st = UI.stroke(b, color, 1.5, if filled then 1 else 0.2)
	if o.auto then UI.pad(b, 0, 16) end
	local sel = new("Frame", { Name = "Focus", BackgroundTransparency = 1, Size = UDim2.new(1, 8, 1, 8), Position = UDim2.fromOffset(-4, -4), Visible = false, ZIndex = 5, Parent = b })
	UI.corner(sel, 13)
	UI.stroke(sel, Color3.new(1, 1, 1), 3, 0)
	b.SelectionImageObject = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	b.SelectionGained:Connect(function() sel.Visible = true end)
	b.SelectionLost:Connect(function() sel.Visible = false end)
	b.MouseEnter:Connect(function() st.Transparency = 0; st.Thickness = 2.5 end)
	b.MouseLeave:Connect(function() st.Transparency = if filled then 1 else 0.2; st.Thickness = 1.5 end)
	if onClick then
		b.Activated:Connect(function()
			if b:GetAttribute("Disabled") then return end
			onClick()
		end)
	end
	b.Parent = parent
	return b
end
function UI.setEnabled(b: TextButton, on: boolean)
	b:SetAttribute("Disabled", not on)
	b.BackgroundTransparency = if on then 0 else 0.6
	b.TextTransparency = if on then 0 else 0.4
end

function UI.card(parent: Instance?, props: { [string]: any }?): Frame
	local f = new("Frame", { BackgroundColor3 = UI.T.card, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	if props then for k, v in props do (f :: any)[k] = v end end
	UI.corner(f, 12)
	f.Parent = parent
	return f
end

function UI.scroll(parent: Instance?, props: { [string]: any }?): ScrollingFrame
	local s = new("ScrollingFrame", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6, ScrollBarImageColor3 = UI.T.cyan, ScrollingDirection = Enum.ScrollingDirection.Y, BorderSizePixel = 0, Selectable = false,
	})
	if props then for k, v in props do (s :: any)[k] = v end end
	s.Parent = parent
	return s
end

function UI.headshot(parent: Instance?, userId: number, name: string, size: number, isBot: boolean?): Frame
	local f = new("Frame", { Name = "Portrait", Size = UDim2.fromOffset(size, size), BackgroundColor3 = UI.T.cardHi, ClipsDescendants = true })
	UI.corner(f, size // 2)
	if userId > 0 then
		new("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Image = "rbxthumb://type=AvatarHeadShot&id=" .. userId .. "&w=150&h=150", Parent = f })
		UI.stroke(f, UI.T.cyan, 2, 0.2)
	else
		-- Placeholder portrait for racers without an account.
		local hue = (string.byte(name, 1) or 65) % 6
		local cols = { UI.T.magenta, UI.T.amber, UI.T.green, UI.T.violet, UI.T.red, UI.T.cyan }
		local col = cols[hue + 1]
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		new("UIGradient", { Color = ColorSequence.new(col, UI.T.bg), Rotation = 45, Parent = f })
		local l = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = if isBot then "◈" else string.upper(string.sub(name, 1, 1)), TextColor3 = Color3.new(1, 1, 1), FontFace = UI.F.title, TextScaled = true, Parent = f })
		new("UIPadding", { PaddingTop = UDim.new(0.22, 0), PaddingBottom = UDim.new(0.22, 0), Parent = l })
		UI.stroke(f, col, 2, 0.1)
	end
	f.Parent = parent
	return f
end

function UI.bar(parent: Instance?, frac: number, color: Color3?, height: number?): Frame
	local bg = new("Frame", { Name = "Bar", Size = UDim2.new(1, 0, 0, height or 8), BackgroundColor3 = UI.T.bg, Parent = parent })
	UI.corner(bg, 4)
	local fill = new("Frame", { Name = "Fill", Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1), BackgroundColor3 = color or UI.T.cyan, Parent = bg })
	UI.corner(fill, 4)
	return bg
end

function UI.chip(parent: Instance?, text: string, color: Color3, props: { [string]: any }?): TextLabel
	local l = new("TextLabel", { BackgroundColor3 = color, BackgroundTransparency = 0.82, Text = text, TextColor3 = color, FontFace = UI.F.bold, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.new() })
	UI.scaleText(l, 13)
	UI.corner(l, 6)
	UI.pad(l, 3, 8)
	UI.stroke(l, color, 1, 0.4)
	if props then for k, v in props do (l :: any)[k] = v end end
	l.Parent = parent
	return l
end

function UI.usingGamepad(): boolean
	local t = UserInputService:GetLastInputType()
	return t == Enum.UserInputType.Gamepad1 or t == Enum.UserInputType.Gamepad2 or t == Enum.UserInputType.Gamepad3 or t == Enum.UserInputType.Gamepad4
end
function UI.focus(obj: GuiObject?)
	if obj and obj.Parent and UI.usingGamepad() then
		GuiService.SelectedObject = obj
	end
end

function UI.tween(o: Instance, t: number, props: { [string]: any })
	if UI.reducedMotion then
		for k, v in props do (o :: any)[k] = v end
		return
	end
	TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props):Play()
end

-- Slider with drag (mouse/touch) and step buttons (gamepad/touch).
function UI.slider(parent: Instance, labelText: string, value: number, step: number, onChange: (number) -> ()): any
	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 50), Parent = parent })
	UI.label(row, labelText, 15, { Size = UDim2.new(0.3, -8, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center, FontFace = UI.F.bold })
	local minus = UI.button(row, "–", { size = UDim2.fromOffset(44, 44), filled = false, textSize = 22, name = labelText .. "Minus" })
	minus.Position = UDim2.new(0.3, 0, 0.5, -22)
	local plus = UI.button(row, "+", { size = UDim2.fromOffset(44, 44), filled = false, textSize = 22, name = labelText .. "Plus" })
	plus.Position = UDim2.new(1, -108, 0.5, -22)
	local track = new("TextButton", { Name = "Track", Text = "", AutoButtonColor = false, BackgroundColor3 = UI.T.bg, Size = UDim2.new(0.7, -176, 0, 12), Position = UDim2.new(0.3, 56, 0.5, -6), Selectable = false, Parent = row })
	UI.corner(track, 6)
	local fill = new("Frame", { BackgroundColor3 = UI.T.cyan, Size = UDim2.fromScale(value / 100, 1), Parent = track })
	UI.corner(fill, 6)
	local knob = new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(value / 100, 0, 0.5, 0), Parent = track })
	UI.corner(knob, 12)
	local valL = UI.label(row, tostring(value) .. "%", 15, { Size = UDim2.new(0, 56, 1, 0), Position = UDim2.new(1, -56, 0, 0), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Center, FontFace = UI.F.bold })
	local api: any = { value = value, row = row, minus = minus, plus = plus }
	local function set(v: number, fire: boolean)
		v = math.clamp(math.floor(v / step + 0.5) * step, 0, 100)
		local changed = v ~= api.value
		api.value = v
		fill.Size = UDim2.fromScale(v / 100, 1)
		knob.Position = UDim2.new(v / 100, 0, 0.5, 0)
		valL.Text = tostring(v) .. "%"
		if fire and changed then onChange(v) end
	end
	api.set = set
	minus.Activated:Connect(function() set(api.value - step, true) end)
	plus.Activated:Connect(function() set(api.value + step, true) end)
	local dragging = false
	local function fromX(x: number)
		local rel = (x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X)
		set(rel * 100, true)
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	return api
end

-- Segmented choice; returns api with set(value).
function UI.segmented(parent: Instance, options: { string }, value: string, onPick: (string) -> (), color: Color3?): any
	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = parent })
	local lay = UI.list(row, Enum.FillDirection.Horizontal, 6)
	lay.Wraps = true
	local api: any = { value = value, buttons = {}, row = row }
	local function paint()
		for opt, b in api.buttons do
			local on = opt == api.value
			b.BackgroundColor3 = if on then (color or UI.T.cyan) else UI.T.card
			b.TextColor3 = if on then UI.T.bg else UI.T.text
		end
	end
	for i, opt in options do
		local b = UI.button(row, opt, { filled = false, auto = true, size = UDim2.fromOffset(0, 40), textSize = 14, layoutOrder = i, color = color })
		api.buttons[opt] = b
		b.Activated:Connect(function()
			api.value = opt
			paint()
			onPick(opt)
		end)
	end
	function api.set(v: string)
		api.value = v
		paint()
	end
	paint()
	return api
end

return UI
]]></ProtectedString>
