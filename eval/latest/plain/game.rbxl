	<Item class="ServerScriptService" referent="RBXE9A8686C11194A649E8FF0150B575F18">
		<Properties>
			<bool name="LoadStringEnabled">false</bool>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
			<string name="Name">ServerScriptService</string>
			<BinaryString name="SerializedOverrides"></BinaryString>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">726fb5359355888f0aeadd4e000003de</UniqueId>
		</Properties>
		<Item class="Script" referent="RBX65C65D06014340DE96963F984E346377">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local N=RS:WaitForChild("Neon")
local C=require(N:WaitForChild("Catalog"))
local A=N:WaitForChild("Action") :: RemoteEvent
local E=N:WaitForChild("State") :: RemoteEvent
local states={}
local inputs={}
local cars={}
local racers={}
local phase="Hub"
local deadline=0
local votes={}
local winning=1
local raceStart=0
local finishAt=0
local results={}
local feed={}
local serial=0
local function find(list,id)
 for _,v in ipairs(list) do if v.id==id then return v end end
 return nil
end
local function send(p,msg)
 local s=states[p];if not s then return end
 s.serverTime=os.time();s.phase=phase;s.deadline=deadline;s.votes=votes;s.track=winning;s.racers=racers;s.feed=feed
 s.message=msg or "";s.save="Saved for this session";E:FireClient(p,s)
end
local function all(msg) for p in pairs(states) do send(p,msg) end end
local function grant(s,c,g,x)
 s.coins+=c;s.gems+=g;s.xp+=x
 s.level=1+math.floor(s.xp/250)
end
local function cost(s,c,g)
 if s.coins<c or s.gems<(g or 0) then return false end
 s.coins-=c;s.gems-=(g or 0);return true
end
local function color(name,shade)
 local v=C.Colors[name] or C.Colors.Cyan;return Color3.fromRGB(v[1],v[2],v[3]):Lerp(Color3.new(0,0,0),1-(shade or 1))
end
local function makeKart(id,s)
 local model=Instance.new("Model");model.Name="Kart_"..id
 local k=find(C.Karts,s.kart) or C.Karts[1]
 local design=s.livery
 local function p(n,size,cf,col,mat)
  local t=Instance.new(n=="Nose" and "WedgePart" or "Part");t.Name=n;t.Size=size;t.CFrame=cf;t.Anchored=true;t.CanCollide=false;t.Material=mat or Enum.Material.SmoothPlastic;t.Color=col;if n=="Wheel" or n=="Hub light" then t.Shape=Enum.PartType.Cylinder elseif n=="Pilot" then t.Shape=Enum.PartType.Ball end;t.Parent=model;return t
 end
 local body=p("Body",Vector3.new(4.3,.75,6),CFrame.new(0,1.5,0),color(design.body,design.shade))
 model.PrimaryPart=body
 p("Nose",Vector3.new(3.6,.5,2),CFrame.new(0,1.2,-3.4),color(design.body,design.shade))
 p("Cockpit",Vector3.new(2,1.2,2),CFrame.new(0,2.2,.2),Color3.fromRGB(15,24,42))
 p("Pilot",Vector3.new(1.25,1.25,1.25),CFrame.new(0,3,0),color(s.driver=="nyx" and "Violet" or s.driver=="bolt" and "Amber" or "Cyan"))
 p("Visor",Vector3.new(1.3,.4,.2),CFrame.new(0,3.15,-.65),Color3.fromRGB(235,251,255),Enum.Material.Neon)
 p("Rear wing",Vector3.new(5,.3,1),CFrame.new(0,2.7,2.9),color(design.accent))
 p("Wing strut",Vector3.new(.3,1.2,.3),CFrame.new(0,2.2,2.9),color(design.accent))
 for _,x in ipairs({-2.3,2.3}) do for _,z in ipairs({-1.9,2}) do
  local w=p("Wheel",Vector3.new(1.1,1.7,1.7),CFrame.new(x,1,z),Color3.fromRGB(15,19,28));local c=Instance.new("UICorner")
  p("Hub light",Vector3.new(.12,.85,.85),CFrame.new(x+(x>0 and .6 or -.6),1,z),color(design.accent),Enum.Material.Neon)
 end end
 for _,x in ipairs({-1.2,1.2}) do
  p("Headlamp",Vector3.new(.8,.2,.15),CFrame.new(x,1.6,-4.42),Color3.fromRGB(180,246,255),Enum.Material.Neon)
  p("Thruster",Vector3.new(.6,.5,.3),CFrame.new(x,1.4,3.2),color(design.accent),Enum.Material.Neon)
 end
 if s.equipped and s.equipped.Cosmetic then p("Underglow",Vector3.new(4.5,.12,5.5),CFrame.new(0,.35,0),color("Violet"),Enum.Material.Neon) end
 local decal=table.find(C.Decals,design.decal) or 1
 for i=1,math.min(decal,4) do p("Livery",Vector3.new(.22,.05,5),CFrame.new((i-(math.min(decal,4)+1)/2)*.5,1.9,-.5)*CFrame.Angles(0,decal==2 and (i%2==0 and .6 or -.6) or decal==3 and .4 or decal==4 and .9 or decal==5 and math.pi/2 or decal==6 and -.4 or 0,0),color(design.accent),Enum.Material.Neon) end
 model.Parent=workspace;return model
end
local showroom=makeKart("Showcase",{kart="ion",livery={body="Cyan",accent="Violet",shade=1,decal="BOLT"},driver="ace"})
showroom:PivotTo(CFrame.new(0,3,167)*CFrame.Angles(0,-.7,0))
local function hide(p,on)
 local ch=p.Character;if not ch then return end
 local root=ch:FindFirstChild("HumanoidRootPart")
 if root then root.Anchored=on;if not on then root.CFrame=CFrame.new(0,5,178) end end
 for _,v in ipairs(ch:GetDescendants()) do if v:IsA("BasePart") then v.Transparency=on and 1 or (v.Name=="HumanoidRootPart" and 1 or 0) elseif v:IsA("Decal") then v.Transparency=on and 1 or 0 end end
end
local function clearCar(p)
 if cars[p] then cars[p]:Destroy();cars[p]=nil end;inputs[p]=nil;hide(p,false)
end
local function newRacer(name,id,bot,index,p)
 local angle=-(index-1)*.045
 local s=p and states[p] or {kart=C.Karts[(index-1)%#C.Karts+1].id,livery={body=index%2==0 and "Violet" or "Amber",accent="Cyan",shade=1,decal="STRIPE"},driver="ace"}
 local car=makeKart(tostring(id),s)
 if p then cars[p]=car;inputs[p]={gas=0,steer=0,brake=false,boost=false};hide(p,true) else cars[id]=car end
 local pos=Vector3.new(math.sin(angle)*160,0,math.cos(angle)*100)
 local r={name=name,id=id,bot=bot,player=p,kartId=s.kart,pos=pos,angle=angle,heading=math.pi/2,speed=0,energy=100,lap=1,checkpoint=0,total=0,finished=false,finishTime=0,rank=index,car=car,progress=0}
 car:PivotTo(CFrame.new(pos+Vector3.new(0,1.2,0))*CFrame.Angles(0,-math.pi/2,0))
 return r
end
local function publicRacers()
 local list={}
 for _,r in ipairs(racers) do
  table.insert(list,{name=r.name,id=r.id,lap=r.lap,progress=r.progress,finished=r.finished,finishTime=r.finishTime,rank=r.rank,speed=math.floor(r.speed),energy=math.floor(r.energy),out=false})
 end
 return list
end
local function snapshot(p,msg)
 local s=states[p];if not s then return end
 local data=table.clone(s);data.serverTime=os.time();data.phase=phase;data.deadline=deadline;data.votes=votes;data.track=winning;data.racers=publicRacers();data.feed=feed;data.message=msg or "";data.save="Saved for this session";data.raceTime=phase=="Race" and os.clock()-raceStart or 0
 E:FireClient(p,data)
end
send=snapshot
local function startRace()
 serial+=1;racers={};results={};feed={};local idx=0
 for p,s in pairs(states) do if s.queued then idx+=1;s.mode="Race";s.results=nil;table.insert(racers,newRacer(p.DisplayName,p.UserId,false,idx,p)) end end
 for i=idx+1,math.max(4,idx) do table.insert(racers,newRacer(({"NYX","BOLT","ECHO","VEX"})[(i-1)%4+1],-i,true,i,nil)) end
 for _,v in ipairs(workspace.NEON_WORLD:GetChildren()) do if v.Name=="Neon rail" or v.Name=="Light strip" then v.Color=color(C.Tracks[winning].color) end end
 phase="Countdown";deadline=workspace:GetServerTimeNow()+4;all("Grid ready. Find your line.")
end
local function beginVote()
 phase="Voting";deadline=workspace:GetServerTimeNow()+13;votes={};winning=1
 votes["NYX"]=1;votes["BOLT"]=2;votes["ECHO"]=3
 all("Track vote is open")
end
local function finishRace()
 phase="Results";deadline=workspace:GetServerTimeNow()+13
 table.sort(racers,function(a,b) return a.rank<b.rank end)
 for _,r in ipairs(racers) do
  if r.player and states[r.player] then
   local s=states[r.player]
   if s.rewardSerial~=serial then
    s.rewardSerial=serial;local reward=math.max(250,950-(r.rank-1)*170)
    grant(s,reward,math.max(5,25-r.rank*4),150);s.races+=1;s.quest.race+=1;s.quest.distance+=math.floor(r.total)
    s.results={rank=r.rank,coins=reward,gems=math.max(5,25-r.rank*4),xp=150,time=r.finishTime}
   end
  end
 end
 all("Race complete • rewards confirmed")
end
local function returnHub(p)
 local s=states[p];if not s then return end
 s.mode="Hub";s.queued=false;clearCar(p);send(p,"Welcome back to the pit")
end
Players.PlayerAdded:Connect(function(p)
 states[p]={coins=2400,gems=90,xp=0,level=1,races=0,kart="ion",ownedKarts={ion=true},favorites={},owned={motor1=true},equipped={Motor="motor1"},driver="ace",drivers={ace=true},rentals={},livery={body="Cyan",accent="Violet",shade=1,decal="STRIPE"},upgrades={},cards={},freeCrates=1,codes={},daily={day=1,last=0},quest={race=0,distance=0,claimed={}},job="new",settings={music=50,effects=70,damage=true,shake=true,quality=3,large=false,motion=false},tutorial=1,party={},invites={},mode="Hub",queued=false,queueMode="Solo",save="Session ready",offerEnd=os.time()+1200,offerBought=false,boostUntil=0}
 p.CharacterAdded:Connect(function() task.wait(.3);send(p) end)
 task.delay(2,function() send(p) end)
end)
Players.PlayerRemoving:Connect(function(p) clearCar(p);states[p]=nil;votes[tostring(p.UserId)]=nil end)
local lastRequest={};local codeAttempts={}
A.OnServerEvent:Connect(function(p,action,d)
 local s=states[p];if not s or type(action)~="string" then return end
 if action=="drive" then
  if type(d)=="table" and inputs[p] then
   inputs[p]={gas=math.clamp(tonumber(d.gas) or 0,-1,1),steer=math.clamp(tonumber(d.steer) or 0,-1,1),brake=d.brake==true,boost=d.boost==true}
  end;return
 end
 local now=os.clock();local requestKey=tostring(p.UserId)..action;if now-(lastRequest[requestKey] or 0)<.15 then return end;lastRequest[requestKey]=now
 local msg=""
 if action=="sync" then send(p);return
 elseif action=="queue" then
  if phase~="Hub" and phase~="Voting" then msg="A race is already in progress"
  elseif s.queued then msg="Already in the queue"
  else s.queued=true;s.queueMode=d=="Duo" and "Duo" or "Solo";msg="Queue joined • local rivals are ready";if phase=="Hub" then beginVote() end end
 elseif action=="leaveQueue" then
  if phase=="Voting" then s.queued=false;votes[tostring(p.UserId)]=nil;msg="Left queue";local count=0;for _,v in pairs(states) do if v.queued then count+=1 end end;if count==0 then phase="Hub";deadline=0;votes={};all("Queue cancelled • a racer left") end end
 elseif action=="vote" then
  if phase=="Voting" and s.queued and type(d)=="number" and C.Tracks[d] then votes[tostring(p.UserId)]=d;all();return end
 elseif action=="buyPart" then
  local v=find(C.Parts,d);if v then if s.owned[d] then msg="Already owned" elseif cost(s,v.price,0) then s.owned[d]=true;msg=v.name.." purchased" else msg="Insufficient credits" end end
 elseif action=="equip" then
  local v=find(C.Parts,d);if v and s.owned[d] then s.equipped[v.slot]=s.equipped[v.slot]==d and nil or d;msg="Equipment updated" else msg="Purchase this part first" end
 elseif action=="kart" then
  local k=find(C.Karts,d);if k then if s.ownedKarts[d] then s.kart=d;msg="Next race: "..k.name elseif cost(s,k.price,0) then s.ownedKarts[d]=true;s.kart=d;msg=k.name.." purchased and selected" else msg="Insufficient credits" end end
 elseif action=="favorite" then if find(C.Karts,d) then s.favorites[d]=not s.favorites[d];msg="Favorite updated" end
 elseif action=="try" then
  if s.mode=="Hub" and phase=="Hub" and find(C.Karts,d) then
   local chosen=s.kart;s.kart=d;local r=newRacer(p.DisplayName,p.UserId,false,1,p);s.kart=chosen
   s.mode="Test";racers={r};msg="Preview drive • Exit returns to hub. Race selection preserved."
  end
 elseif action=="exit" then
  if s.mode=="Test" then racers={};returnHub(p);return
  elseif s.mode=="Race" then msg="Race abandoned • no reward";for _,r in ipairs(racers) do if r.player==p then r.finished=true;r.finishTime=0;r.player=nil;r.bot=true end end;returnHub(p);return
  else returnHub(p);return end
 elseif action=="recover" then
  for _,r in ipairs(racers) do if r.player==p and not r.finished then local a=(r.checkpoint%24)/24*math.pi*2;r.pos=Vector3.new(math.sin(a)*160,0,math.cos(a)*100);r.heading=math.atan2(math.cos(a)*160,-math.sin(a)*100);r.speed=0;msg="Kart recovered to last checkpoint" end end
 elseif action=="driver" then
  local v=find(C.Drivers,d);if v and (s.drivers[d] or (s.rentals[d] or 0)>os.time()) then s.driver=d;msg=v.name.." equipped" else msg="Driver is unavailable" end
 elseif action=="buyDriver" or action=="rentDriver" then
  local v=type(d)=="string" and find(C.Drivers,d);if v then
   if s.drivers[d] then msg="Permanently owned"
   elseif action=="rentDriver" and (s.rentals[d] or 0)>os.time() then msg="Rental already active"
   elseif cost(s,action=="buyDriver" and v.price or v.rent,0) then
    if action=="buyDriver" then s.drivers[d]=true else s.rentals[d]=os.time()+600 end;msg=v.name..(action=="buyDriver" and " owned permanently" or " rented for 10 minutes")
   else msg="Insufficient credits" end
  end
 elseif action=="livery" then
  if type(d)=="table" and C.Colors[d.body] and C.Colors[d.accent] and table.find({.5,.75,1},d.shade) and table.find(C.Decals,d.decal) then s.livery={body=d.body,accent=d.accent,shade=d.shade,decal=d.decal};msg="Livery saved for this session" end
 elseif action=="upgrade" then
  if type(d)=="table" and s.ownedKarts[d.kart] and table.find({"speed","handling","boost"},d.stat) then
   local u=s.upgrades[d.kart] or {speed=0,handling=0,boost=0};s.upgrades[d.kart]=u;local lv=u[d.stat]
   if lv>=3 then msg="Maximum level reached" elseif cost(s,400*(lv+1),8*(lv+1)) then u[d.stat]+=1;msg=d.stat.." upgraded • +5 per level" else msg="Insufficient credits or shards" end
  end
 elseif action=="crate" then
  if s.freeCrates>0 or s.coins>=350 then
   if s.freeCrates>0 then s.freeCrates-=1 else cost(s,350,0) end
   local cards={};for i=1,3 do local roll=math.random();local ix=roll<.65 and math.random(1,4) or roll<.90 and math.random(5,8) or math.random(9,12);s.cards[tostring(ix)]=(s.cards[tostring(ix)] or 0)+1;table.insert(cards,ix) end
   s.reveal=cards;s.revealSerial=(s.revealSerial or 0)+1;msg="Crate opened • 3 cards added"
  else msg="Insufficient credits" end
 elseif action=="daily" then
  local day=math.floor(os.time()/86400);local last=s.daily.last
  if last==day then msg="Already claimed • next reward at UTC midnight"
  else
   if last>0 and day-last>1 then s.daily.day=1;msg="Missed a day • track restarted. " end
   local n=s.daily.day;grant(s,200+n*80,n==7 and 100 or 5,30);if n==7 then s.freeCrates+=2 end
   s.daily.last=day;s.daily.day=n%7+1;msg..="Day "..n.." reward claimed"
  end
 elseif action=="code" then
  local str=type(d)=="string" and string.upper(string.match(d,"^%s*(.-)%s*$")) or ""
  local attempts=codeAttempts[p] or {n=0,reset=0};codeAttempts[p]=attempts
  if os.time()<attempts.reset then s.codeState="RATE LIMITED • retry in "..(attempts.reset-os.time()).."s";s.codeRetry=attempts.reset
  elseif str=="" then s.codeState="EMPTY • enter a code"
  elseif s.codes[str] then s.codeState="ALREADY USED"
  elseif str=="NEON2025" then s.codeState="EXPIRED"
  elseif str=="APEX" or str=="NEON" then s.codes[str]=true;grant(s,750,20,50);s.codeState="SUCCESS • +750 credits +20 shards";attempts.n=0
  else attempts.n+=1;s.codeState="INVALID • try APEX";if attempts.n>=4 then attempts.reset=os.time()+15;attempts.n=0;s.codeRetry=attempts.reset;s.codeState="RATE LIMITED • retry in 15s" end end;msg=s.codeState
 elseif action=="quest" then
  if d=="race" and s.quest.race>=1 and not s.quest.claimed.race then s.quest.claimed.race=true;grant(s,500,15,100);msg="First finish reward claimed"
  elseif d=="distance" and s.quest.distance>=1000 and not s.quest.claimed.distance then s.quest.claimed.distance=true;grant(s,350,10,70);msg="Distance reward claimed"
  else msg="Quest is not ready" end
 elseif action=="job" then
  if d=="accept" and s.job=="new" then s.job="active";msg="Job accepted • find the glowing cell beside the garage"
  elseif d=="collect" and s.job=="active" then
   local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
   if root and (root.Position-Vector3.new(-48,3,185)).Magnitude<16 then s.job="ready";msg="Cell found • return to the mechanic" else msg="Walk to the cyan cell by the garage" end
  elseif d=="finish" and s.job=="ready" then
   local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
   if root and (root.Position-Vector3.new(45,4,168)).Magnitude<20 then s.job="done";grant(s,400,10,50);msg="Thanks, racer. +400 credits +10 shards" else msg="Return to the mechanic in the hub" end
  elseif d=="decline" then msg="No problem. Come back anytime." end
 elseif action=="boostBuy" then if s.boostUntil>os.time() then msg="Boost already active" elseif cost(s,150,0) then s.boostUntil=os.time()+600;msg="10 minute speed tune activated" else msg="Insufficient credits" end
 elseif action=="offer" then
  if s.offerBought then msg="Offer already claimed" elseif os.time()>s.offerEnd then msg="Offer expired" elseif cost(s,800,0) then s.offerBought=true;s.freeCrates+=3;grant(s,0,30,0);msg="Starter supply claimed • 3 crates +30 shards" else msg="Insufficient credits" end
 elseif action=="invite" then
  local demos={["MIRA"]="accept",["JAX"]="decline"}
  if d=="OFFLINE / SOL" then msg="SOL is offline"
  elseif s.party[d] or s.invites[d] then msg="Invitation already sent"
  elseif demos[d] then s.invites[d]="Pending";msg="Invitation sent"
   task.delay(3,function() if states[p] then if demos[d]=="accept" then s.party[d]=true;s.invites[d]="Accepted" else s.invites[d]="Declined" end;send(p,d.." "..string.lower(s.invites[d])) end end)
  end
 elseif action=="chat" then
  local msgs={"Good luck!","Nice driving!","Let's race!","Thanks!","Close one!","Boost time!","Well played!","See you in the pits!"}
  if type(d)=="number" and msgs[d] then
   if (s.chatUntil or 0)>workspace:GetServerTimeNow() then msg="Quick chat cooling down"
   else s.chatUntil=workspace:GetServerTimeNow()+5;for q in pairs(states) do states[q].chat={name=p.DisplayName,text=msgs[d],untilTime=workspace:GetServerTimeNow()+5};send(q) end end
  end
 elseif action=="settings" then
  if type(d)=="table" then
   for _,key in ipairs({"music","effects"}) do if type(d[key])=="number" then s.settings[key]=math.clamp(math.floor(d[key]/10+.5)*10,0,100) end end
   for _,key in ipairs({"damage","shake","large","motion"}) do if type(d[key])=="boolean" then s.settings[key]=d[key] end end
   if type(d.quality)=="number" then s.settings.quality=math.clamp(math.floor(d.quality),1,3) end
   msg="Settings saved for this session"
  end
 elseif action=="tutorial" then
  if type(d)=="number" then s.tutorial=math.clamp(d,0,4) end
 end
 send(p,msg)
end)
local cell=Instance.new("Part");cell.Name="Repair cell";cell.Shape=Enum.PartType.Ball;cell.Size=Vector3.new(2,2,2);cell.Position=Vector3.new(-48,3,185);cell.Anchored=true;cell.Material=Enum.Material.Neon;cell.Color=Color3.fromRGB(49,224,255);cell.Parent=workspace
local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Collect repair cell";prompt.ObjectText="Mechanic's job";prompt.HoldDuration=.3;prompt.Parent=cell
prompt.Triggered:Connect(function(p)
 local s=states[p];if s and s.job=="active" then s.job="ready";send(p,"Cell found • return to the mechanic") end
end)
local acc=0
Run.Heartbeat:Connect(function(dt)
 dt=math.min(dt,.1);acc+=dt
 local now=workspace:GetServerTimeNow()
 if phase=="Voting" and now>=deadline then
  local counts={0,0,0};for _,v in pairs(votes) do counts[v]+=1 end
  winning=1;for i=2,3 do if counts[i]>counts[winning] then winning=i end end
  startRace()
 elseif phase=="Countdown" and now>=deadline then phase="Race";raceStart=os.clock();finishAt=raceStart+125;deadline=0;all("GO! • "..C.Tracks[winning].name)
 elseif phase=="Results" and now>=deadline then
  for p,s in pairs(states) do if s.mode=="Race" then returnHub(p) end end
  for _,r in ipairs(racers) do if r.car then r.car:Destroy() end end
  racers={};phase="Hub";all()
 end
 local active=phase=="Race"
 local done=0
 for _,r in ipairs(racers) do
  if r.finished then done+=1 end
  local test=r.player and states[r.player] and states[r.player].mode=="Test"
  if (active or test) and not r.finished then
   local old=r.pos
   if r.bot then
    local vel=65+(-r.id%4)*2.5
    local a=r.angle;local tangent=Vector3.new(math.cos(a)*160,0,-math.sin(a)*100)
    r.angle+=vel/tangent.Magnitude*dt
    r.pos=Vector3.new(math.sin(r.angle)*160,0,math.cos(r.angle)*100)
    r.heading=math.atan2(math.cos(r.angle)*160,-math.sin(r.angle)*100);r.speed=vel
   else
    local s=states[r.player];local inp=inputs[r.player] or {gas=0,steer=0,brake=false,boost=false}
    local k=find(C.Karts,r.kartId) or C.Karts[1];local up=s.upgrades[r.kartId] or {speed=0,handling=0,boost=0}
    local dr=find(C.Drivers,s.driver) or C.Drivers[1]
    local motor=find(C.Parts,s.equipped.Motor);local wheel=find(C.Parts,s.equipped.Wheels);local booster=find(C.Parts,s.equipped.Boost)
    local top=(k.speed+up.speed*5+dr.speed+(motor and motor.effect or 0)+(s.boostUntil>os.time() and 5 or 0))*(winning==2 and 1.12 or 1)
    local boosting=inp.boost and r.energy>0 and r.speed>10
    if boosting then top+=28+up.boost*5+(booster and booster.effect or 0);r.energy=math.max(0,r.energy-28*dt) else r.energy=math.min(100,r.energy+13*dt) end
    local a=math.atan2(r.pos.X/160,r.pos.Z/100)
    local center=Vector3.new(math.sin(a)*160,0,math.cos(a)*100)
    local off=(r.pos-center).Magnitude>16
    if inp.gas>0 then r.speed=math.min(top*(off and .45 or 1),r.speed+48*dt)
    elseif inp.gas<0 then r.speed=math.max(-24,r.speed-65*dt)
    else r.speed*=math.max(0,1-dt*.7) end
    if inp.brake then r.speed*=math.max(0,1-dt*1.5);r.energy=math.min(100,r.energy+15*dt) end
    local handling=(k.handling+up.handling*5+dr.handling+(wheel and wheel.effect or 0))/80*(winning==3 and 1.2 or 1)
    local ahead=Vector3.new(math.sin(a+.18)*160,0,math.cos(a+.18)*100)-r.pos
    local tangent=math.atan2(ahead.X,ahead.Z)
    if math.abs(inp.steer)<.05 and not off and r.speed>0 then local delta=math.atan2(math.sin(tangent-r.heading),math.cos(tangent-r.heading));r.heading+=delta*math.min(dt*3,1) end
    r.heading-=inp.steer*math.min(math.abs(r.speed)/20,1)*1.7*handling*(inp.brake and 1.4 or 1)*dt*(r.speed<0 and -1 or 1)
    r.pos+=Vector3.new(math.sin(r.heading),0,math.cos(r.heading))*r.speed*dt
    if math.abs(r.pos.X)>240 or math.abs(r.pos.Z)>135 then r.pos=center;r.speed=0;r.heading=math.atan2(math.cos(a)*160,-math.sin(a)*100) end
   end
   r.total+=(r.pos-old).Magnitude
   local a=math.atan2(r.pos.X/160,r.pos.Z/100);if a<0 then a+=math.pi*2 end
   local cp=math.floor(a/(math.pi*2)*24)
   if cp==(r.checkpoint+1)%24 then
    r.checkpoint=cp
    if cp==0 then r.lap+=1 end
   end
   r.progress=(r.lap-1)*24+r.checkpoint
   if r.lap>2 and not test then r.finished=true;r.finishTime=os.clock()-raceStart;r.speed=0 end
   r.car:PivotTo(CFrame.new(r.pos+Vector3.new(0,.35,0))*CFrame.Angles(0,r.heading+math.pi,0))
  end
 end
 if active then
  local sorted=table.clone(racers)
  table.sort(sorted,function(a,b) if a.finished~=b.finished then return a.finished end;if a.finished then return a.finishTime<b.finishTime end;return a.progress>b.progress end)
  for i,r in ipairs(sorted) do r.rank=i end
  if done==#racers or os.clock()>finishAt then
   for _,r in ipairs(racers) do if not r.finished then r.finishTime=0 end end
   finishRace()
  end
 end
 if acc>.2 then
  acc=0
  for p,s in pairs(states) do
   if not s.drivers[s.driver] and (s.rentals[s.driver] or 0)<=os.time() then s.driver="ace";send(p,"Driver rental expired • ACE equipped") end
   send(p)
  end
 end
end)
