					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Shop, Garage and Inventory panels.
local U = require(script.Parent.Util)
local Config = U.Config
local T = U.T

local ShopState = { cat = "All", scroll = Vector2.zero, selected = nil :: string? }
local GarageState = { search = "", cat = "All", rarity = "All", sort = "name", selected = "volt", scroll = Vector2.zero }
local InvState = { selected = nil :: string? }

local function priceText(n: number, currency: string?): string
	return (currency == "Gems" and "💎 " or "💰 ") .. Config.FormatNumber(n)
end

local function chipRow(parent: Instance, options: { any }, current: string, onPick: (string) -> (), order: number): Frame
	local row = U.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 44), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 0, LayoutOrder = order, Selectable = false, Parent = parent })
	U.list(row, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	for i, o in ipairs(options) do
		local key = type(o) == "table" and o.key or o
		local label = type(o) == "table" and o.label or o
		local on = key == current
		local b = U.btn(row, label, { order = i, size = UDim2.fromOffset(0, 38), textSize = 14, color = on and T.Cyan or T.Panel2, textColor = on and T.Bg or T.Text })
		b.AutomaticSize = Enum.AutomaticSize.X
		U.pad(b, 14, 0)
		b:SetAttribute("Key", key)
		b.Activated:Connect(function() onPick(key) end)
	end
	return row
end

local function gridCols(width: number, minW: number): number
	return math.max(1, math.floor(width / minW))
end

return function(App: any)
	-- =============== SHOP ===============
	App.Register("Shop", "PARTS SHOP", T.Pink, function(body: Frame)
		local root = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = body })
		U.list(root, Enum.FillDirection.Vertical, 8)
		local topRow = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 1, Parent = root })
		local tabsHolder = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -110, 1, 0), Parent = topRow })
		U.list(tabsHolder)
		local codesBtn = U.btn(topRow, "🔑 Codes", { size = UDim2.fromOffset(104, 40), color = T.Panel2, stroke = T.Gold })
		codesBtn.AnchorPoint = Vector2.new(1, 0)
		codesBtn.Position = UDim2.new(1, 0, 0, 2)
		codesBtn.Activated:Connect(function()
			ShopState.scroll = (root:FindFirstChild("Grid") :: ScrollingFrame).CanvasPosition
			App.CodesReturn = "Shop"
			App.Open("Codes")
		end)
		local wallet = U.label(root, "", 14, T.Sub, { LayoutOrder = 2 })
		local grid = U.scroll(root, { Name = "Grid", Size = UDim2.new(1, 0, 1, -110), LayoutOrder = 3 })
		U.pad(grid, 4)
		local gl = U.new("UIGridLayout", { CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
		local busy: { [string]: boolean } = {}
		local tabs: Frame? = nil
		local refresh

		local function buy(part: any)
			local p = U.Store.profile
			local function send()
				busy[part.id] = true
				refresh()
				local res = U.Request("BuyPart", { id = part.id })
				busy[part.id] = nil
				if res.ok then U.Toast(res.msg, "good") else U.Toast(res.err, "bad") end
				refresh()
			end
			if p.coins < part.price then
				U.Toast("Not enough Coins: need " .. Config.FormatNumber(part.price - p.coins) .. " more", "bad")
				return
			end
			if part.price >= Config.ExpensivePrice then
				U.Confirm({ title = "Buy " .. part.name .. "?", body = part.slot .. " part · " .. part.desc .. "\nWallet after purchase: 💰 " .. Config.FormatNumber(p.coins - part.price), price = "Price: " .. priceText(part.price), confirmText = "Buy" }, send)
			else
				send()
			end
		end

		local function buildTabs()
			if tabs then tabs:Destroy() end
			tabs = chipRow(tabsHolder, Config.ShopCategories, ShopState.cat, function(k)
				ShopState.cat = k
				grid.CanvasPosition = Vector2.zero
				buildTabs()
				refresh()
			end, 1)
		end

		refresh = function()
			local p = U.Store.profile
			if not p then return end
			wallet.Text = string.format("Wallet: 💰 %s Coins · 💎 %s Gems", Config.FormatNumber(p.coins), Config.FormatNumber(p.gems))
			local cols = gridCols(grid.AbsoluteSize.X - 10, 220)
			gl.CellSize = UDim2.new(1 / cols, -10, 0, 168)
			local keep = grid.CanvasPosition
			U.clear(grid)
			for i, part in ipairs(Config.Parts) do
				if ShopState.cat == "All" or part.slot == ShopState.cat then
					local owned = p.owned[part.id]
					local afford = p.coins >= part.price
					local c = U.new("Frame", { BackgroundColor3 = T.Panel2, LayoutOrder = i, Parent = grid })
					U.corner(c, 12)
					U.stroke(c, owned and T.Green or Config.RarityColor[part.rarity], owned and 2 or 1, 0.1)
					U.pad(c, 10)
					U.list(c, Enum.FillDirection.Vertical, 4)
					U.label(c, part.name, 17, T.Text, { Font = Enum.Font.GothamBold, LayoutOrder = 1 })
					local chips = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 2, Parent = c })
					U.list(chips, Enum.FillDirection.Horizontal, 4)
					U.chip(chips, part.slot, T.Cyan, 1)
					U.chip(chips, part.rarity, Config.RarityColor[part.rarity], 2)
					U.label(c, part.desc, 13, T.Sub, { LayoutOrder = 3 })
					U.label(c, priceText(part.price), 18, afford and T.Gold or T.Red, { Font = Enum.Font.GothamBlack, LayoutOrder = 4 })
					local b
					if owned then
						b = U.btn(c, "✔ OWNED", { size = UDim2.new(1, 0, 0, 36), order = 5, color = T.Panel, textColor = T.Green })
						U.setEnabled(b, false)
						b.TextTransparency = 0
					elseif busy[part.id] then
						b = U.btn(c, "Purchasing…", { size = UDim2.new(1, 0, 0, 36), order = 5 })
						U.setEnabled(b, false)
					elseif not afford then
						b = U.btn(c, "Need 💰 " .. Config.FormatNumber(part.price - p.coins) .. " more", { size = UDim2.new(1, 0, 0, 36), order = 5, color = T.Panel, textColor = T.Red, textSize = 13 })
						b.Activated:Connect(function() buy(part) end)
					else
						b = U.btn(c, "Buy", { size = UDim2.new(1, 0, 0, 36), order = 5, primary = true, color = T.Pink })
						b.Activated:Connect(function() buy(part) end)
					end
					b.Name = "Buy_" .. part.id
				end
			end
			grid.CanvasPosition = keep
		end
		buildTabs()
		refresh()
		task.defer(function()
			refresh()
			grid.CanvasPosition = ShopState.scroll
		end)
		local conn = grid:GetPropertyChangedSignal("CanvasPosition"):Connect(function() ShopState.scroll = grid.CanvasPosition end)
		local lay = U.On(function(k) if k == "layout" then refresh() end end)
		return { refresh = function(k) if k == "profile" then refresh() end end, cleanup = function() conn:Disconnect(); lay() end }
	end)

	-- =============== GARAGE ===============
	App.Register("Garage", "GARAGE", T.Cyan, function(body: Frame)
		local compact = U.Layout.compact
		local left = U.new("Frame", { BackgroundTransparency = 1, Parent = body })
		local right = U.card(body, { AutomaticSize = Enum.AutomaticSize.None })
		if compact then
			left.Size = UDim2.new(1, 0, 0.58, -4)
			right.Size = UDim2.new(1, 0, 0.42, -4)
			right.Position = UDim2.new(0, 0, 0.58, 4)
		else
			left.Size = UDim2.new(0.56, -6, 1, 0)
			right.Size = UDim2.new(0.44, -6, 1, 0)
			right.Position = UDim2.new(0.56, 6, 0, 0)
		end
		U.list(left, Enum.FillDirection.Vertical, 6)
		local searchRow = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 1, Parent = left })
		local box = U.new("TextBox", { Name = "Search", PlaceholderText = "Search karts…", Text = GarageState.search, ClearTextOnFocus = false, TextSize = 15, Font = Enum.Font.GothamMedium, TextColor3 = T.Text, PlaceholderColor3 = T.Sub, BackgroundColor3 = T.Panel, Size = UDim2.new(1, -90, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Selectable = true, SelectionImageObject = U.SelectionImage, Parent = searchRow })
		U.corner(box, 10); U.stroke(box, T.Line); U.pad(box, 10, 0)
		local clear = U.btn(searchRow, "Clear", { size = UDim2.new(0, 82, 1, 0) })
		clear.Position = UDim2.new(1, -82, 0, 0)
		local filters = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = left })
		U.list(filters, Enum.FillDirection.Vertical, 2)
		local countLbl = U.label(left, "", 13, T.Sub, { LayoutOrder = 3 })
		local list = U.scroll(left, { Name = "KartList", Size = UDim2.new(1, 0, 1, -190), LayoutOrder = 4 })
		U.list(list, Enum.FillDirection.Vertical, 6)
		U.pad(list, 4)
		U.list(right, Enum.FillDirection.Vertical, 6)
		U.pad(right, 12)
		local detail = U.scroll(right, { Size = UDim2.fromScale(1, 1) })
		U.list(detail, Enum.FillDirection.Vertical, 6)
		local refreshList, refreshDetail, buildFilters

		buildFilters = function()
			U.clear(filters)
			chipRow(filters, Config.KartCategories, GarageState.cat, function(k) GarageState.cat = k; buildFilters(); refreshList() end, 1)
			chipRow(filters, Config.Rarities, GarageState.rarity, function(k) GarageState.rarity = k; buildFilters(); refreshList() end, 2)
			chipRow(filters, { { key = "name", label = "Sort: Name A–Z" }, { key = "speed", label = "Speed ↓" }, { key = "rarity", label = "Rarity ↓" } }, GarageState.sort, function(k) GarageState.sort = k; buildFilters(); refreshList() end, 3)
		end

		local function filtered(): { any }
			local q = string.lower(GarageState.search)
			local out = {}
			for _, k in ipairs(Config.Karts) do
				local okQ = q == "" or string.find(string.lower(k.name), q, 1, true) ~= nil
				local okC = GarageState.cat == "All" or k.category == GarageState.cat
				local okR = GarageState.rarity == "All" or k.rarity == GarageState.rarity
				if okQ and okC and okR then table.insert(out, k) end
			end
			table.sort(out, function(a, b)
				if GarageState.sort == "speed" and a.speed ~= b.speed then return a.speed > b.speed end
				if GarageState.sort == "rarity" and Config.RarityOrder[a.rarity] ~= Config.RarityOrder[b.rarity] then return Config.RarityOrder[a.rarity] > Config.RarityOrder[b.rarity] end
				return a.name < b.name
			end)
			return out
		end

		refreshList = function()
			local p = U.Store.profile
			if not p then return end
			local keep = list.CanvasPosition
			U.clear(list)
			local karts = filtered()
			countLbl.Text = string.format("%d of %d karts", #karts, #Config.Karts)
			if #karts == 0 then
				local e = U.card(list, { LayoutOrder = 1 })
				U.pad(e, 16)
				U.label(e, "No karts match", 18, T.Gold, { Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center })
				local why = {}
				if GarageState.search ~= "" then table.insert(why, "“" .. GarageState.search .. "”") end
				if GarageState.cat ~= "All" then table.insert(why, GarageState.cat) end
				if GarageState.rarity ~= "All" then table.insert(why, GarageState.rarity) end
				U.label(e, "Nothing for " .. table.concat(why, " · ") .. ". Press Clear to remove the search, or change a filter.", 14, T.Sub, { TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 26) })
				U.list(e, Enum.FillDirection.Vertical, 6)
			end
			for i, k in ipairs(karts) do
				local sel = GarageState.selected == k.id
				local isNext = p.selectedKart == k.id
				local row = U.btn(list, "", { name = "Kart_" .. k.id, order = i, size = UDim2.new(1, -4, 0, 58), color = sel and Color3.fromRGB(40, 36, 86) or T.Panel2, stroke = sel and T.Cyan or T.Line })
				local st = row:FindFirstChildOfClass("UIStroke")
				if st and sel then st.Thickness = 2 end
				U.new("Frame", { BackgroundColor3 = k.color, Size = UDim2.new(0, 6, 1, -16), Position = UDim2.fromOffset(8, 8), Parent = row }, { U.new("UICorner", { CornerRadius = UDim.new(0, 3) }) })
				U.label(row, (p.favorites[k.id] and "★ " or "") .. k.name, 16, T.Text, { Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(22, 8), Size = UDim2.new(1, -150, 0, 20), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
				U.label(row, k.category .. " · SPD " .. k.speed, 13, T.Sub, { Position = UDim2.fromOffset(22, 30), Size = UDim2.new(1, -150, 0, 18), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
				local chipHolder = U.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(120, 44), Parent = row })
				U.list(chipHolder, Enum.FillDirection.Vertical, 3, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
				U.chip(chipHolder, k.rarity, Config.RarityColor[k.rarity], 1)
				if isNext then U.chip(chipHolder, "NEXT RACE", T.Green, 2) end
				row.Activated:Connect(function()
					GarageState.selected = k.id
					refreshList()
					refreshDetail()
				end)
			end
			list.CanvasPosition = keep
		end

		local busy = false
		refreshDetail = function()
			local p = U.Store.profile
			if not p then return end
			U.clear(detail)
			local k = Config.GetKart(GarageState.selected) or Config.Karts[1]
			local fav = p.favorites[k.id] == true
			U.label(detail, k.name, 22, T.Text, { Font = Enum.Font.GothamBlack, LayoutOrder = 1 })
			local chips = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 2, Parent = detail })
			U.list(chips, Enum.FillDirection.Horizontal, 6)
			U.chip(chips, k.rarity, Config.RarityColor[k.rarity], 1)
			U.chip(chips, k.category, T.Cyan, 2)
			if p.selectedKart == k.id then U.chip(chips, "✔ NEXT RACE", T.Green, 3) end
			if fav then U.chip(chips, "★ FAVORITE", T.Gold, 4) end
			U.label(detail, k.desc, 14, T.Sub, { LayoutOrder = 3 })
			local up = p.upgrades[k.id] or {}
			local s = Config.ComputeStats(k.id, up, nil, nil)
			U.statBar(detail, "Speed", s.speed, 110, T.Pink, 4, s.speed - k.speed)
			U.statBar(detail, "Accel", s.accel, 110, T.Gold, 5)
			U.statBar(detail, "Handling", s.handling, 110, T.Green, 6, s.handling - k.handling)
			U.statBar(detail, "Boost", s.boost, 110, T.Cyan, 7, s.boost - k.boost)
			local phys = Config.Physics(s)
			U.label(detail, string.format("Top speed %d studs/s · boost ×%.2f", phys.topSpeed, phys.boostMult), 13, T.Sub, { LayoutOrder = 8 })
			local btns = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 9, Parent = detail })
			local gl2 = U.new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 44), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = btns })
			local _ = gl2
			local selB = U.btn(btns, p.selectedKart == k.id and "✔ Selected" or "Use next race", { name = "SelectKart", order = 1, primary = p.selectedKart ~= k.id, color = T.Green })
			if p.selectedKart == k.id then U.setEnabled(selB, false) end
			selB.Activated:Connect(function()
				if busy or p.selectedKart == k.id then return end
				busy = true
				local r = U.Request("SelectKart", { id = k.id })
				busy = false
				if r.ok then U.Toast(r.msg, "good") else U.Toast(r.err, "bad") end
			end)
			local favB = U.btn(btns, fav and "★ Unfavorite" or "☆ Favorite", { name = "Favorite", order = 2, stroke = T.Gold })
			favB.Activated:Connect(function()
				if busy then return end
				busy = true
				local r = U.Request("Favorite", { id = k.id, on = not fav })
				busy = false
				if not r.ok then U.Toast(r.err, "bad") end
			end)
			local tryB = U.btn(btns, "▶ Test drive", { name = "TestDrive", order = 3, stroke = T.Cyan })
			tryB.Activated:Connect(function()
				local r = U.Request("TestDrive", { kart = k.id })
				if not r.ok then U.Toast(r.err, "bad") end
			end)
			local upB = U.btn(btns, "⚙ Upgrades", { order = 4 })
			upB.Activated:Connect(function()
				App.UpgradeKart = k.id
				App.Open("Upgrades")
			end)
		end

		box:GetPropertyChangedSignal("Text"):Connect(function()
			GarageState.search = box.Text
			refreshList()
		end)
		clear.Activated:Connect(function()
			GarageState.search = ""
			box.Text = ""
			refreshList()
		end)
		buildFilters()
		refreshList()
		refreshDetail()
		task.defer(function() list.CanvasPosition = GarageState.scroll end)
		local conn = list:GetPropertyChangedSignal("CanvasPosition"):Connect(function() GarageState.scroll = list.CanvasPosition end)
		return {
			refresh = function(kind) if kind == "profile" then refreshList(); refreshDetail() end end,
			cleanup = function() conn:Disconnect() end,
			focus = list:FindFirstChild("Kart_" .. GarageState.selected) or box,
		}
	end)

	-- =============== INVENTORY ===============
	App.Register("Inventory", "INVENTORY", T.Green, function(body: Frame)
		local root = U.scroll(body)
		U.list(root, Enum.FillDirection.Vertical, 10)
		U.pad(root, 4)
		local refresh
		local busy = false
		local function act(action: string, args: any)
			if busy then return end
			busy = true
			local r = U.Request(action, args)
			busy = false
			if r.ok then U.Toast(r.msg or "Done", "good") else U.Toast(r.err, "bad") end
		end
		refresh = function()
			local p = U.Store.profile
			if not p then return end
			U.clear(root)
			local k = Config.GetKart(p.selectedKart)
			local d = Config.GetDriver(p.selectedDriver)
			local summary = U.card(root, { LayoutOrder = 1 })
			U.pad(summary, 12)
			U.list(summary, Enum.FillDirection.Vertical, 4)
			U.label(summary, "Next race loadout", 13, T.Sub, { LayoutOrder = 1 })
			U.label(summary, string.format("%s  ·  Driver: %s", k.name, d and d.name or "—"), 17, T.Text, { Font = Enum.Font.GothamBold, LayoutOrder = 2 })
			local s = Config.ComputeStats(p.selectedKart, p.upgrades[p.selectedKart], p.equipped, p.selectedDriver)
			U.label(summary, string.format("Speed %d · Accel %d · Handling %d · Boost %d", s.speed, s.accel, s.handling, s.boost), 14, T.Cyan, { LayoutOrder = 3 })
			local drvB = U.btn(summary, "Choose driver →", { order = 4, size = UDim2.fromOffset(170, 38) })
			drvB.Activated:Connect(function() App.Open("Drivers") end)
			-- slots
			local slots = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = root })
			local cols = U.Layout.compact and 2 or 4
			U.new("UIGridLayout", { CellSize = UDim2.new(1 / cols, -8, 0, 104), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = slots })
			for i, slot in ipairs(Config.Slots) do
				local eq = p.equipped[slot] and Config.GetPart(p.equipped[slot])
				local c = U.new("Frame", { BackgroundColor3 = eq and Color3.fromRGB(20, 50, 44) or T.Panel, LayoutOrder = i, Parent = slots })
				U.corner(c, 12)
				U.stroke(c, eq and T.Green or T.Line, eq and 2 or 1)
				U.pad(c, 8)
				U.list(c, Enum.FillDirection.Vertical, 2)
				U.label(c, string.upper(slot) .. " SLOT", 12, T.Sub, { LayoutOrder = 1, Font = Enum.Font.GothamBold })
				U.label(c, eq and eq.name or "— Empty —", 15, eq and T.Green or T.Sub, { LayoutOrder = 2, Font = Enum.Font.GothamBold })
				if eq then
					local ub = U.btn(c, "Unequip", { order = 3, size = UDim2.new(1, 0, 0, 34), textSize = 14 })
					ub.Activated:Connect(function() act("Unequip", { slot = slot }) end)
				end
			end
			U.label(root, "PARTS", 14, T.Sub, { LayoutOrder = 3, Font = Enum.Font.GothamBold })
			local order = 4
			for _, part in ipairs(Config.Parts) do
				order += 1
				local owned = p.owned[part.id] == true
				local equipped = p.equipped[part.slot] == part.id
				local selected = InvState.selected == part.id
				local row = U.btn(root, "", { name = "Part_" .. part.id, order = order, size = UDim2.new(1, -4, 0, selected and 92 or 56), color = equipped and Color3.fromRGB(20, 50, 44) or owned and T.Panel2 or T.Panel, stroke = selected and T.Cyan or (equipped and T.Green or T.Line) })
				if not owned then row.BackgroundTransparency = 0.4 end
				U.label(row, part.name, 15, owned and T.Text or T.Sub, { Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -240, 0, 20), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
				U.label(row, part.slot .. " · " .. part.desc, 13, T.Sub, { Position = UDim2.fromOffset(12, 30), Size = UDim2.new(1, -240, 0, 18), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
				local state = equipped and "EQUIPPED" or owned and "OWNED" or "NOT OWNED"
				local chip = U.chip(row, state, equipped and T.Green or owned and T.Cyan or Color3.fromRGB(90, 88, 120))
				chip.AnchorPoint = Vector2.new(1, 0)
				chip.Position = UDim2.new(1, -120, 0, 18)
				if owned then
					local b = U.btn(row, equipped and "Unequip" or "Equip", { size = UDim2.fromOffset(100, 38), primary = not equipped, color = T.Green, textSize = 14 })
					b.AnchorPoint = Vector2.new(1, 0)
					b.Position = UDim2.new(1, -10, 0, 9)
					b.Activated:Connect(function()
						if equipped then act("Unequip", { slot = part.slot }) else act("Equip", { id = part.id }) end
					end)
				else
					local b = U.btn(row, "Shop →", { size = UDim2.fromOffset(100, 38), textSize = 14 })
					b.AnchorPoint = Vector2.new(1, 0)
					b.Position = UDim2.new(1, -10, 0, 9)
					b.Activated:Connect(function() ShopState.cat = part.slot; App.Open("Shop") end)
				end
				if selected then
					local cur = p.equipped[part.slot] and Config.GetPart(p.equipped[part.slot])
					local effect = "Effect: " .. part.desc
					if cur and cur.id ~= part.id then effect ..= "  ·  replaces " .. cur.name elseif not cur then effect ..= "  ·  slot is empty" end
					U.label(row, effect, 13, T.Cyan, { Position = UDim2.fromOffset(12, 60), Size = UDim2.new(1, -24, 0, 24), AutomaticSize = Enum.AutomaticSize.None })
				end
				row.Activated:Connect(function()
					InvState.selected = (InvState.selected ~= part.id) and part.id or nil
					refresh()
				end)
			end
		end
		refresh()
		return { refresh = function(k) if k == "profile" then local keep = root.CanvasPosition; refresh(); root.CanvasPosition = keep end end }
	end)
end
]]></ProtectedString>
						<string name="ScriptGuid">{8F175837-5E18-422B-9795-36742D1B1AAC}</string>
