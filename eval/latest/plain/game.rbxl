	local nameL = UI.label(top, App.player.DisplayName, 15, { FontFace = UI.F.bold, Position = UDim2.fromOffset(48, 0), Size = UDim2.new(1, -110, 0, 20), AutomaticSize = Enum.AutomaticSize.None, TextTruncate = Enum.TextTruncate.AtEnd })
	local raceL = UI.label(top, "Races 0", 13, { TextColor3 = T.muted, Position = UDim2.fromOffset(48, 20), Size = UDim2.new(1, -110, 0, 18), AutomaticSize = Enum.AutomaticSize.None })
	local lvl = new("TextLabel", { BackgroundColor3 = T.magenta, Text = "LV 1", TextColor3 = T.bg, FontFace = UI.F.bold, Size = UDim2.fromOffset(56, 26), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 6), Parent = top })
	UI.scaleText(lvl, 14)
	UI.corner(lvl, 8)
	local xpRow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = card })
	UI.list(xpRow, Enum.FillDirection.Vertical, 2)
