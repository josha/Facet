local chatLine=label(root,"",16,palette.cyan);chatLine.BackgroundColor3=palette.bg;chatLine.BackgroundTransparency=.1;chatLine.Position=UDim2.new(.25,0,1,-150);chatLine.Size=UDim2.new(.5,0,0,42);chatLine.TextXAlignment=Enum.TextXAlignment.Center;corner(chatLine,8);chatLine.Visible=false
local context=Instance.new("InputContext");context.Name="NeonInput";context.Priority=2000;context.Parent=gui
local function bind(name,keys,key)
 local act=Instance.new("InputAction");act.Name=name;act.Type=Enum.InputActionType.Bool;act.Parent=context
 for _,code in ipairs(keys) do local b=Instance.new("InputBinding");b.KeyCode=code;b.Parent=act end
 act.Pressed:Connect(function() held[key]=true end);act.Released:Connect(function() held[key]=false end)
 return act
end
local gasAction=bind("Accelerate",{Enum.KeyCode.W,Enum.KeyCode.Up,Enum.KeyCode.ButtonR2},"gas")
bind("Reverse",{Enum.KeyCode.S,Enum.KeyCode.Down,Enum.KeyCode.ButtonL2},"reverse")
local leftAction=bind("SteerLeft",{Enum.KeyCode.A,Enum.KeyCode.Left},"left")
local rightAction=bind("SteerRight",{Enum.KeyCode.D,Enum.KeyCode.Right},"right")
local driftAction=bind("Drift",{Enum.KeyCode.Space,Enum.KeyCode.ButtonX},"brake")
local boostAction=bind("Boost",{Enum.KeyCode.LeftShift,Enum.KeyCode.ButtonA},"boost")
local touch=frame(raceHud,UDim2.new(1,0,0,170),UDim2.new(0,0,1,-190));touch.BackgroundTransparency=1;touch.Visible=UIS.TouchEnabled
local function touchButton(txt,pos,key,act)
 local b=button(touch,txt,nil,palette.panel);b.Size=UDim2.fromOffset(64,64);b.Position=pos;b.TextSize=18;stroke(b,palette.cyan)
 b.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then held[key]=true end end)
 b.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then held[key]=false end end)
 if act then local binding=Instance.new("InputBinding");binding.UIButton=b;binding.Parent=act end
 return b
end
