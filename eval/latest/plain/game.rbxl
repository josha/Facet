			<Properties>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Entry point: routes client requests to the economy and race services.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Net = RS:WaitForChild("Net")
local RCall = Net:WaitForChild("Call") :: RemoteFunction
local Profiles = require(script.Profiles)
local Race = require(script.Race)

local callLog: { [Player]: { number } } = {}

RCall.OnServerInvoke = function(player: Player, action: any, payload: any): any
	if type(action) ~= "string" then return { ok = false, err = "Bad request." } end
	if not Profiles.get(player) then return { ok = false, err = "Profile is still loading." } end
	local t = os.clock()
	local log = callLog[player] or {}
	while #log > 0 and t - log[1] > 1 do table.remove(log, 1) end
	if #log >= 20 then
		return { ok = false, err = "Too many requests. Try again in a moment." }
	end
	table.insert(log, t)
	callLog[player] = log
	local handler = Profiles.handlers[action] or Race.handlers[action]
	if not handler then return { ok = false, err = "Unknown action." } end
	local ok, result = pcall(handler, player, payload)
	if not ok then
		warn("[GameServer] " .. action .. " failed: " .. tostring(result))
		return { ok = false, err = "Server error. Nothing was spent." }
	end
	return result
end

-- Mechanic job cells: validated against the player's job state on the server.
for _, cell in workspace:WaitForChild("World"):WaitForChild("Hub"):WaitForChild("PowerCells"):GetChildren() do
	local prompt = cell:FindFirstChildOfClass("ProximityPrompt")
	if prompt then
		prompt.Triggered:Connect(function(player)
			local char = player.Character
			if char and (char:GetPivot().Position - (cell :: BasePart).Position).Magnitude < 16 then
				Profiles.collectCell(player, cell:GetAttribute("CellId") :: number)
			end
		end)
	end
end

Players.PlayerRemoving:Connect(function(player)
	callLog[player] = nil
end)
]]></ProtectedString>
