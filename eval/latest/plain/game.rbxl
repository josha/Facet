						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Race queue, track vote and results panels.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local UI = require(script.Parent.UI)
local Store = require(script.Parent.Store)
local RaceClient = require(script.Parent.RaceClient)
local T = UI.T

local RacePanels = {}
local me = Players.LocalPlayer
local chosenMode = "Solo"

local function inQueue(s: any): boolean
	if not s then return false end
	for _, q in s.queue do if q.userId == me.UserId then return true end end
	return false
end

-- Queue ---------------------------------------------------------------------
local qp = UI.panel("queue", "Race Queue", T.cyan)
local qBody = UI.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4, ZIndex = 22, Selectable = false }, qp.body)
UI.list(qBody, false, 12)
UI.pad(qBody, 6, 4)
UI.label(qBody, "Choose a mode. Solo fills the grid with local AI racers. Duo waits for a second player in this server.", 15, { TextColor3 = T.dim, LayoutOrder = 1, ZIndex = 23 })
local modeRow = UI.frame(qBody, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 2, ZIndex = 23 })
UI.list(modeRow, true, 10)
local soloBtn = UI.button(modeRow, "SOLO  ·  1 player", { Size = UDim2.new(0.5, -5, 0, 54), TextSize = 16, ZIndex = 24 })
local duoBtn = UI.button(modeRow, "DUO  ·  2 players", { Size = UDim2.new(0.5, -5, 0, 54), TextSize = 16, ZIndex = 24 })
local statusCard = UI.frame(qBody, { BackgroundColor3 = T.card, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, ZIndex = 23 })
UI.corner(statusCard, 12)
UI.pad(statusCard, 14, 16)
UI.list(statusCard, false, 8)
local statusTitle = UI.label(statusCard, "", 22, { Font = UI.Title, ZIndex = 24, LayoutOrder = 1 })
local statusLine = UI.label(statusCard, "", 16, { ZIndex = 24, LayoutOrder = 2 })
local statusMsg = UI.label(statusCard, "", 15, { ZIndex = 24, LayoutOrder = 3, TextColor3 = T.amber, Font = UI.Bold })
local joinedRow = UI.frame(statusCard, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), ZIndex = 24, LayoutOrder = 4 })
UI.list(joinedRow, true, 8, nil, Enum.VerticalAlignment.Center)
local actRow = UI.frame(qBody, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 4, ZIndex = 23 })
UI.list(actRow, true, 10)
local joinBtn = UI.button(actRow, "JOIN QUEUE", { Size = UDim2.new(0.5, -5, 0, 52), TextSize = 18, ZIndex = 24 })
local leaveBtn = UI.button(actRow, "LEAVE QUEUE", { Size = UDim2.new(0.5, -5, 0, 52), TextSize = 18, ZIndex = 24 })
RacePanels.joinButton = joinBtn

local function renderQueue()
	local s = Store.lobby
	if not s then return end
	local mine = inQueue(s)
	local mode = if s.phase ~= "idle" then s.mode else chosenMode
	if s.phase ~= "idle" then chosenMode = s.mode end
	UI.style(soloBtn, if mode == "Solo" then "selected" else "")
	UI.style(duoBtn, if mode == "Duo" then "selected" else "")
	local locked = s.phase ~= "idle"
	if locked and mode ~= "Solo" then UI.style(soloBtn, "disabled") soloBtn:SetAttribute("DisabledReason", "A Duo queue is already forming.") end
	if locked and mode ~= "Duo" then UI.style(duoBtn, "disabled") duoBtn:SetAttribute("DisabledReason", "A Solo queue is already forming.") end
	local left = math.max(0, math.ceil(s.endsAt - Store.now()))
	if s.phase == "idle" then
		statusTitle.Text = "READY TO RACE"
		statusLine.Text = "No one is queued. Join to start a " .. chosenMode .. " race."
	elseif s.phase == "queue" then
		statusTitle.Text = "WAITING  " .. #s.queue .. "/" .. s.required
		statusLine.Text = s.mode .. " queue · " .. #s.queue .. " joined, " .. s.required .. " required. " .. (if mine then "You're in." else "")
	elseif s.phase == "starting" then
		statusTitle.Text = "STARTING IN " .. left
		statusLine.Text = s.mode .. " · " .. #s.queue .. "/" .. s.required .. " joined. Leave now to cancel the start."
	elseif s.phase == "voting" or s.phase == "reveal" then
		statusTitle.Text = "TRACK VOTE"
		statusLine.Text = "Racers are choosing the track."
	else
		statusTitle.Text = "RACE IN PROGRESS"
		statusLine.Text = "The queue reopens when the current race ends."
	end
	statusMsg.Text = s.message or ""
	statusMsg.Visible = s.phase == "queue" and (s.message or "") ~= ""
	for _, c in joinedRow:GetChildren() do if c:IsA("GuiObject") then c:Destroy() end end
	for _, q in s.queue do
		local chip = UI.frame(joinedRow, { BackgroundColor3 = T.card2, Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 25 })
		UI.corner(chip, 20)
		UI.pad(chip, 4, 8)
		UI.list(chip, true, 6, nil, Enum.VerticalAlignment.Center)
		local pf = UI.portrait(chip, q.userId, q.name, 32)
		pf.ZIndex = 26
		UI.label(chip, q.name, 14, { Font = UI.Bold, Size = UDim2.fromOffset(0, 32), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 26 })
	end
	if s.required > #s.queue and (s.phase == "queue") then
		for _ = 1, s.required - #s.queue do
			local slot = UI.frame(joinedRow, { BackgroundColor3 = T.card, Size = UDim2.fromOffset(110, 40), ZIndex = 25 })
			UI.corner(slot, 20)
			UI.stroke(slot, T.line, 1)
			UI.label(slot, "open slot", 13, { Size = UDim2.fromScale(1, 1), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, TextColor3 = T.dim, ZIndex = 26 })
		end
	end
	local canJoin = not mine and (s.phase == "idle" or (s.phase == "queue" and s.mode == chosenMode))
	UI.style(joinBtn, if canJoin then "primary" else "disabled")
	joinBtn:SetAttribute("DisabledReason", if mine then "You're already queued." else "The queue isn't open for that mode right now.")
	local canLeave = mine and (s.phase == "queue" or s.phase == "starting")
	UI.style(leaveBtn, if canLeave then "danger" else "disabled")
	leaveBtn:SetAttribute("DisabledReason", "You're not in a queue you can leave.")
end

soloBtn.Activated:Connect(function() if not soloBtn:GetAttribute("Disabled") then chosenMode = "Solo" renderQueue() end end)
duoBtn.Activated:Connect(function() if not duoBtn:GetAttribute("Disabled") then chosenMode = "Duo" renderQueue() end end)
joinBtn.Activated:Connect(function()
	if joinBtn:GetAttribute("Disabled") then return end
	if RaceClient.preview then RaceClient.stopPreview() end
	local res = Store.call("queue_join", { mode = chosenMode })
	if not res.ok then UI.toast(res.err, "bad") else UI.toast("Joined the " .. chosenMode .. " queue", "good") end
end)
leaveBtn.Activated:Connect(function()
	if leaveBtn:GetAttribute("Disabled") then return end
	local res = Store.call("queue_leave")
	if not res.ok then UI.toast(res.err, "bad") else UI.toast("You left the queue") end
end)
qp.onOpen = renderQueue
qp.firstFocus = function() return joinBtn end

-- Vote ----------------------------------------------------------------------
local vp = UI.panel("vote", "Track Vote", T.magenta)
local vHead = UI.label(vp.body, "", 17, { Font = UI.Bold, Size = UDim2.new(1, 0, 0, 30), AutomaticSize = Enum.AutomaticSize.None, ZIndex = 23, TextYAlignment = Enum.TextYAlignment.Center })
local vScroll = UI.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 1, -40), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.XY, ScrollBarThickness = 4, ZIndex = 22, Selectable = false }, vp.body)
local vList = UI.list(vScroll, true, 12)
local voteCards: { [string]: any } = {}
for i, t in Config.Tracks do
	local card = UI.button(vScroll, "", { Size = UDim2.new(1 / 3, -8, 1, -8), LayoutOrder = i, ZIndex = 23, BackgroundColor3 = T.card })
	UI.pad(card, 12, 12)
	local stripe = UI.frame(card, { BackgroundColor3 = t.color, Size = UDim2.new(1, 0, 0, 6), ZIndex = 24 })
	UI.corner(stripe, 3)
	local name = UI.label(card, t.name, 18, { Font = UI.Title, Position = UDim2.fromOffset(0, 14), ZIndex = 24 })
	local meta = UI.label(card, t.mode .. " · " .. t.laps .. " laps", 14, { Font = UI.Bold, TextColor3 = t.color, Position = UDim2.fromOffset(0, 46), ZIndex = 24 })
	local desc = UI.label(card, t.desc, 14, { TextColor3 = T.dim, Position = UDim2.fromOffset(0, 70), ZIndex = 24 })
	local count = UI.label(card, "0 votes", 26, { Font = UI.Title, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -40), ZIndex = 24 })
	local voters = UI.label(card, "", 12, { TextColor3 = T.dim, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -22), ZIndex = 24, TextTruncate = Enum.TextTruncate.AtEnd })
	local mine = UI.label(card, "", 13, { Font = UI.Bold, TextColor3 = T.cyan, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), ZIndex = 24 })
	card.Activated:Connect(function()
		local res = Store.call("vote", { id = t.id })
		if not res.ok then UI.toast(res.err, "bad") else UI.sfx("click") end
	end)
	voteCards[t.id] = { card = card, count = count, mine = mine, voters = voters, name = name, meta = meta, desc = desc }
end

local function layoutVote()
	local compact = UI.compact() or UI.isPortrait()
	vList.FillDirection = if compact then Enum.FillDirection.Vertical else Enum.FillDirection.Horizontal
	for _, vc in voteCards do
		vc.card.Size = if compact then UDim2.new(1, -8, 0, 190) else UDim2.new(1 / 3, -8, 1, -8)
	end
	vScroll.ScrollingDirection = if compact then Enum.ScrollingDirection.Y else Enum.ScrollingDirection.X
end
UI.layoutChanged.Event:Connect(layoutVote)
layoutVote()

local function renderVote()
	local s = Store.lobby
	if not s then return end
	local myVote = s.votes[Store.myKey()]
	local left = math.max(0, math.ceil(s.endsAt - Store.now()))
	if s.phase == "voting" then
		vHead.Text = "Voting closes in " .. left .. "s · tap a track to vote or change your vote"
		vHead.TextColor3 = T.text
	elseif s.phase == "reveal" or s.phase == "countdown" then
		vHead.Text = "Voting closed · " .. (s.message or "")
		vHead.TextColor3 = T.amber
	end
	local names: { [string]: { string } } = {}
	for _, v in s.voters do
		local tid = s.votes[v.key]
		if tid then
			names[tid] = names[tid] or {}
			table.insert(names[tid], v.name)
		end
	end
	for id, vc in voteCards do
		local n = s.voteCounts[id] or 0
		vc.count.Text = n .. (if n == 1 then " vote" else " votes")
		vc.voters.Text = table.concat(names[id] or {}, ", ")
		vc.mine.Text = if myVote == id then "✓ YOUR VOTE" else (if s.phase == "voting" then "Vote" else "")
		local winner = (s.phase == "reveal" or s.phase == "countdown") and s.trackId == id
		local st = vc.card:FindFirstChildOfClass("UIStroke")
		if st then
			st.Color = if winner then T.green elseif myVote == id then T.cyan else T.line
			st.Thickness = if winner or myVote == id then 3 else 1
		end
		vc.card:SetAttribute("StrokeColor", if winner then T.green elseif myVote == id then T.cyan else T.line)
		if winner then vc.mine.Text = "★ WINNER" vc.mine.TextColor3 = T.green else vc.mine.TextColor3 = T.cyan end
	end
end
vp.firstFocus = function() return voteCards[Config.Tracks[1].id].card end

-- Results -------------------------------------------------------------------
local rp = UI.panel("results", "Race Results", T.green)
local rScroll = UI.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, -62), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4, ZIndex = 22, Selectable = false }, rp.body)
UI.list(rScroll, false, 6)
UI.pad(rScroll, 4, 4)
local returnBtn = UI.button(rp.body, "RETURN TO HUB", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.fromOffset(260, 50), TextSize = 18, ZIndex = 24 })
UI.style(returnBtn, "primary")
local returning = false
local shownResults = -1

local function doReturn()
	if returning then return end
	returning = true
	local res = Store.call("results_return")
	returning = false
	UI.close()
	if RaceClient.active and not RaceClient.preview then RaceClient.exit() end
	if not res.ok and res.err ~= "No results to leave." then UI.toast(res.err, "bad") end
end
returnBtn.Activated:Connect(doReturn)
rp.canClose = function(_)
	doReturn()
	return false
end
rp.firstFocus = function() return returnBtn end

local function renderResults(s: any)
	for _, c in rScroll:GetChildren() do if c:IsA("GuiObject") then c:Destroy() end end
	local res = s.results
	if not res then return end
	local track = Config.FindById(Config.Tracks, res.trackId)
	local rew = res.rewards[Store.myKey()]
	local banner = UI.frame(rScroll, { BackgroundColor3 = T.card, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 0, ZIndex = 23 })
	UI.corner(banner, 12)
	UI.stroke(banner, T.amber, 1.5)
	UI.pad(banner, 12, 14)
	UI.list(banner, false, 4)
	local myPlace = 0
	for _, o in res.order do if o.key == Store.myKey() then myPlace = o.place end end
	UI.label(banner, (if myPlace > 0 then "You placed " .. Config.Ordinal(myPlace) else "Race over") .. (if track then " · " .. track.name else ""), 20, { Font = UI.Title, ZIndex = 24 })
	if rew then
		local line = "+" .. Config.Comma(rew.credits) .. " Credits" .. (if rew.creditMult > 1 then " (×" .. rew.creditMult .. " boost)" else "")
			.. "   +" .. Config.Comma(rew.xp) .. " XP" .. (if rew.xpMult > 1 then " (×" .. rew.xpMult .. " boost)" else "")
		UI.label(banner, line, 17, { Font = UI.Bold, TextColor3 = T.amber, ZIndex = 24 })
		if rew.levelUp then UI.label(banner, "LEVEL UP! You reached level " .. rew.level, 16, { Font = UI.Bold, TextColor3 = T.green, ZIndex = 24 }) end
		UI.label(banner, "Rewards are added to your wallet. Your kart, parts and driver stay equipped.", 13, { TextColor3 = T.dim, ZIndex = 24 })
	end
	for _, o in res.order do
		local mine = o.key == Store.myKey()
		local row = UI.frame(rScroll, { BackgroundColor3 = if mine then Color3.fromRGB(16, 60, 80) else T.card, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = o.place, ZIndex = 23 })
		UI.corner(row, 10)
		if mine then UI.stroke(row, T.cyan, 2) end
		UI.label(row, Config.Ordinal(o.place), 18, { Font = UI.Title, Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(60, 48), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 24, TextColor3 = if o.place == 1 then T.amber else T.text })
		local pf = UI.portrait(row, o.userId, o.name, 36, if o.isAI then T.magenta else T.cyan)
		pf.Position = UDim2.fromOffset(70, 6)
		pf.ZIndex = 24
		local kart = Config.FindById(Config.Karts, o.kart)
		UI.label(row, o.name .. (if mine then "  (YOU)" else "") .. "  ·  " .. (if kart then kart.name else ""), 15, { Font = UI.Bold, Position = UDim2.fromOffset(116, 0), Size = UDim2.new(1, -240, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, ZIndex = 24 })
		local st = if o.status == "Finished" and o.time then Config.Clock(o.time) .. string.format(".%d", math.floor((o.time % 1) * 10)) else o.status
		UI.label(row, st, 15, { Font = UI.Bold, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 0), Size = UDim2.fromOffset(110, 48), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 24,
			TextColor3 = if o.status == "OUT" then T.red elseif o.status == "DNF" then T.amber else T.green })
	end
end

local function myRacer(s: any): any
	for _, r in s.racers do if r.key == Store.myKey() then return r end end
	return nil
end

local lastPhase = ""
Store.lobbyChanged.Event:Connect(function(s)
	local mine = inQueue(s)
	if UI.current == qp then renderQueue() end
	if (s.phase == "voting" or s.phase == "reveal") and mine then
		if s.phase ~= lastPhase and s.phase == "voting" and UI.current ~= vp and not UI.dialogOpen then UI.open("vote") end
		renderVote()
	end
	if s.phase == "countdown" and UI.current == vp then UI.close() end
	if s.phase == "countdown" and UI.current and UI.current.id ~= "results" then UI.close() end
	if s.phase == "results" and myRacer(s) and RaceClient.active and s.raceId ~= shownResults then
		shownResults = s.raceId
		renderResults(s)
		if UI.current ~= rp then UI.open("results") end
	end
	if s.phase ~= "results" and UI.current == rp then UI.close() end
	lastPhase = s.phase
end)

task.spawn(function()
	while true do
		task.wait(0.5)
		local s = Store.lobby
		if s then
			if UI.current == qp then renderQueue() end
			if UI.current == vp then renderVote() end
			if UI.current == rp and s.phase == "results" then
				returnBtn.Text = "RETURN TO HUB (" .. math.max(0, math.ceil(s.endsAt - Store.now())) .. ")"
			end
		end
	end
end)

return RacePanels
]]></ProtectedString>
