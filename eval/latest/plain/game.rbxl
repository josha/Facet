			<Item class="LocalScript" referent="RBX9CA8D4706BD24ED081C861DB3A2C167F">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Client entry: builds the interface and wires hub interactions.
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local UI = require(script.UI)
local Store = require(script.Store)
local Hud = require(script.Hud)
local RaceClient = require(script.RaceClient)
require(script.RacePanels)

local optional = { "Panels", "Rewards", "Livery", "Social", "Mechanic", "QuickChat", "Settings", "Tutorial" }
local loaded: { [string]: any } = {}
for _, name in optional do
	local mod = script:FindFirstChild(name)
	if mod then
		local ok, res = pcall(require, mod)
		if ok then loaded[name] = res else warn("[Client] " .. name .. ": " .. tostring(res)) end
	end
end

Hud.opener = function(id: string, from: GuiObject?)
	if Store.mode ~= "hub" then return end
	if UI.panels[id] then
		if UI.current and UI.current.id == id then
			UI.requestClose()
		else
			UI.open(id, from)
		end
	end
end

ProximityPromptService.PromptTriggered:Connect(function(prompt)
	local action = prompt:GetAttribute("Action")
	if action == "queue" then Hud.opener("queue", Hud.dock.queue)
	elseif action == "garage" then Hud.opener("garage", Hud.dock.garage)
	elseif action == "shop" then Hud.opener("shop", Hud.dock.shop)
	end
end)

-- Fetch the first snapshots in case they arrived before listeners existed.
task.spawn(function()
	local res = Store.call("profile_get")
	if res.ok and res.profile then
		Store.profile = res.profile
		Store.profileChanged:Fire(res.profile)
	end
	local lob = Store.call("lobby_get")
	if lob.ok then
		Store.lobby = lob.state
		Store.lobbyChanged:Fire(lob.state)
	end
end)
]]></ProtectedString>
