					<ProtectedString name="Source"><![CDATA[--!strict
-- Game data shared by server and client. The server is the authority on every value here.
local Config = {}

Config.Rarities = { "Common", "Rare", "Epic", "Legendary" }
Config.RarityRank = { Common = 1, Rare = 2, Epic = 3, Legendary = 4 } :: { [string]: number }
Config.RarityColor = {
	Common = Color3.fromRGB(170, 190, 215),
	Rare = Color3.fromRGB(60, 170, 255),
	Epic = Color3.fromRGB(195, 95, 255),
	Legendary = Color3.fromRGB(255, 190, 60),
} :: { [string]: Color3 }

Config.KartCategories = { "Speed", "Balanced", "Handling", "Heavy" }

export type Kart = {
	id: string, name: string, category: string, rarity: string, level: number,
	speed: number, accel: number, handling: number, boost: number, desc: string,
	shape: { len: number, wid: number, wing: boolean, fins: boolean, pods: boolean },
}

Config.Karts = {
	{ id = "volt", name = "Volt Runner", category = "Balanced", rarity = "Common", level = 1, speed = 60, accel = 62, handling = 62, boost = 55,
		desc = "A forgiving all-rounder. Every pilot's first spark.", shape = { len = 6.5, wid = 4.2, wing = false, fins = false, pods = false } },
	{ id = "ion", name = "Ion Dart", category = "Speed", rarity = "Common", level = 1, speed = 68, accel = 52, handling = 50, boost = 55,
		desc = "Narrow and twitchy, but it flies on straights.", shape = { len = 7.2, wid = 3.6, wing = true, fins = false, pods = false } },
	{ id = "pulse", name = "Pulse Hopper", category = "Handling", rarity = "Rare", level = 2, speed = 62, accel = 66, handling = 78, boost = 58,
		desc = "Short wheelbase that snaps through hairpins.", shape = { len = 5.8, wid = 4.4, wing = false, fins = true, pods = false } },
	{ id = "phantom", name = "Cyan Phantom", category = "Speed", rarity = "Rare", level = 3, speed = 76, accel = 58, handling = 56, boost = 62,
		desc = "Low-slung racer tuned for long boost chains.", shape = { len = 7.6, wid = 4.0, wing = true, fins = true, pods = false } },
	{ id = "bruiser", name = "Nova Bruiser", category = "Heavy", rarity = "Epic", level = 4, speed = 70, accel = 50, handling = 60, boost = 75,
		desc = "Armored brick with a massive boost reactor.", shape = { len = 7.0, wid = 5.0, wing = false, fins = false, pods = true } },
	{ id = "quasar", name = "Quasar Wing", category = "Speed", rarity = "Epic", level = 5, speed = 82, accel = 60, handling = 58, boost = 66,
		desc = "Aero blades keep it planted at blistering speed.", shape = { len = 7.8, wid = 4.4, wing = true, fins = true, pods = true } },
	{ id = "helix", name = "Helix Prime", category = "Handling", rarity = "Legendary", level = 6, speed = 78, accel = 72, handling = 86, boost = 70,
		desc = "Twin-helix steering for impossible lines.", shape = { len = 6.8, wid = 4.6, wing = true, fins = true, pods = false } },
	{ id = "singularity", name = "Singularity", category = "Heavy", rarity = "Legendary", level = 8, speed = 88, accel = 66, handling = 64, boost = 84,
		desc = "A black-hole core bends space around it.", shape = { len = 7.4, wid = 5.2, wing = true, fins = false, pods = true } },
} :: { Kart }

Config.ConfirmThreshold = 1000 -- purchases at or above this credit price ask first

Config.PartSlots = { "motor", "boost", "wheels", "cosmetic" }
Config.SlotNames = { motor = "Motor", boost = "Boost", wheels = "Wheels", cosmetic = "Cosmetic" } :: { [string]: string }

export type Part = { id: string, name: string, slot: string, price: number, effects: { [string]: number }, nitro: number?, desc: string, exclusive: boolean?, look: string? }

Config.Parts = {
	{ id = "spark_motor", name = "Spark Motor", slot = "motor", price = 300, effects = { speed = 4 }, desc = "Entry-level ion motor." },
	{ id = "fusion_core", name = "Fusion Core", slot = "motor", price = 1200, effects = { speed = 8, accel = 4 }, desc = "Contained fusion for real top speed." },
	{ id = "quantum_drive", name = "Quantum Drive", slot = "motor", price = 3200, effects = { speed = 13, accel = 6 }, desc = "Skips a few atoms per lap." },
	{ id = "nitro_cell", name = "Nitro Cell", slot = "boost", price = 250, effects = { boost = 5 }, nitro = 1, desc = "+1 nitro charge per race." },
	{ id = "plasma_tank", name = "Plasma Tank", slot = "boost", price = 950, effects = { boost = 10 }, nitro = 2, desc = "+2 nitro charges per race." },
	{ id = "warp_injector", name = "Warp Injector", slot = "boost", price = 2600, effects = { boost = 16 }, nitro = 3, desc = "+3 charges and a fierce kick." },
	{ id = "grip_rings", name = "Grip Rings", slot = "wheels", price = 200, effects = { handling = 5 }, desc = "Sticky neon tread." },
	{ id = "hover_pads", name = "Hover Pads", slot = "wheels", price = 850, effects = { handling = 9, accel = 3 }, desc = "Mag-lev pads, no friction." },
	{ id = "mag_discs", name = "Mag Discs", slot = "wheels", price = 2400, effects = { handling = 14, speed = 3 }, desc = "Gyro discs that bite every corner." },
	{ id = "cyan_trail", name = "Cyan Trail", slot = "cosmetic", price = 150, effects = {}, look = "trail", desc = "Leaves a glowing ribbon." },
	{ id = "violet_glow", name = "Violet Underglow", slot = "cosmetic", price = 450, effects = {}, look = "glow", desc = "Purple light beneath the chassis." },
	{ id = "halo_antenna", name = "Halo Antenna", slot = "cosmetic", price = 1500, effects = {}, look = "halo", desc = "A floating neon halo." },
	{ id = "aurora_wings", name = "Aurora Wings", slot = "cosmetic", price = 0, effects = {}, look = "wings", exclusive = true, desc = "Day 7 reward only. Shimmering light wings." },
} :: { Part }

Config.DriverGroups = { "Pilots", "Mechanics", "Legends" }
export type Driver = { id: string, name: string, group: string, stats: { speed: number, handling: number, boost: number }, buy: { [string]: number }?, rent: { [string]: number }?, desc: string, color: Color3 }
Config.DefaultDriver = "ray"
Config.Drivers = {
	{ id = "ray", name = "Rookie Ray", group = "Pilots", stats = { speed = 0, handling = 0, boost = 0 }, desc = "Eager, steady, always free.", color = Color3.fromRGB(80, 200, 255) },
	{ id = "nyx", name = "Nyx Vale", group = "Pilots", stats = { speed = 3, handling = 1, boost = 0 }, buy = { credits = 1500 }, rent = { credits = 200 }, desc = "Night-circuit specialist.", color = Color3.fromRGB(150, 90, 255) },
	{ id = "kade", name = "Kade Orion", group = "Pilots", stats = { speed = 5, handling = 0, boost = 2 }, buy = { credits = 2600 }, rent = { credits = 320 }, desc = "Straight-line maniac.", color = Color3.fromRGB(255, 120, 60) },
	{ id = "gears", name = "Gears Okoro", group = "Mechanics", stats = { speed = 0, handling = 4, boost = 2 }, buy = { credits = 1200 }, rent = { credits = 150 }, desc = "Tunes suspension mid-corner.", color = Color3.fromRGB(80, 230, 140) },
	{ id = "tess", name = "Tess Ampere", group = "Mechanics", stats = { speed = 1, handling = 3, boost = 4 }, buy = { credits = 2000 }, rent = { credits = 250 }, desc = "Overclocks every boost cell.", color = Color3.fromRGB(255, 210, 70) },
	{ id = "zero", name = "Zero Solace", group = "Legends", stats = { speed = 6, handling = 4, boost = 4 }, buy = { shards = 60 }, rent = { credits = 600 }, desc = "Undefeated in the Void League.", color = Color3.fromRGB(240, 240, 255) },
	{ id = "astra", name = "Astra Prime", group = "Legends", stats = { speed = 8, handling = 5, boost = 6 }, buy = { shards = 90 }, rent = { credits = 900 }, desc = "Pilots by starlight alone.", color = Color3.fromRGB(255, 80, 180) },
} :: { Driver }
Config.RentalSeconds = 600

Config.Hues = {
	{ name = "Red", color = Color3.fromRGB(255, 55, 85) },
	{ name = "Amber", color = Color3.fromRGB(255, 170, 40) },
	{ name = "Green", color = Color3.fromRGB(60, 235, 120) },
	{ name = "Cyan", color = Color3.fromRGB(30, 230, 255) },
	{ name = "Blue", color = Color3.fromRGB(60, 110, 255) },
	{ name = "Violet", color = Color3.fromRGB(175, 80, 255) },
}
Config.Shades = { 50, 75, 100 }
Config.Decals = { "None", "Stripe", "Twin", "Checker", "Ring", "Number", "Chevron" }
Config.DefaultLivery = { body = "Cyan", bodyShade = 100, accent = "Violet", accentShade = 100, decal = "Stripe" }

function Config.HueColor(name: string, shade: number): Color3
	for _, h in Config.Hues do
		if h.name == name then
			local f = shade / 100
			return Color3.new(h.color.R * f, h.color.G * f, h.color.B * f)
		end
	end
	return Color3.new(1, 1, 1)
end

Config.UpgradeStats = { "speed", "handling", "boost" }
Config.UpgradeMax = 5
Config.UpgradeGain = { speed = 3, handling = 3, boost = 4 } :: { [string]: number }
function Config.UpgradeCost(level: number): { credits: number, shards: number }
	return { credits = 250 * (level + 1), shards = 3 * (level + 1) }
end

export type Card = { id: string, name: string, rarity: string }
Config.Cards = {
	{ id = "c1", name = "Neon Bolt", rarity = "Common" }, { id = "c2", name = "Grid Runner", rarity = "Common" },
	{ id = "c3", name = "Pixel Drift", rarity = "Common" }, { id = "c4", name = "Static Spark", rarity = "Common" },
	{ id = "c5", name = "Laser Lane", rarity = "Common" }, { id = "c6", name = "Chrome Hub", rarity = "Common" },
	{ id = "r1", name = "Cyan Comet", rarity = "Rare" }, { id = "r2", name = "Ion Storm", rarity = "Rare" },
	{ id = "r3", name = "Pulse Wave", rarity = "Rare" }, { id = "r4", name = "Hyper Loop", rarity = "Rare" },
	{ id = "e1", name = "Void Walker", rarity = "Epic" }, { id = "e2", name = "Nova Burst", rarity = "Epic" },
	{ id = "e3", name = "Quantum Ghost", rarity = "Epic" },
	{ id = "l1", name = "Singularity", rarity = "Legendary" }, { id = "l2", name = "Astra Crown", rarity = "Legendary" },
	{ id = "l3", name = "Event Horizon", rarity = "Legendary" },
} :: { Card }

Config.Crates = {
	{ id = "basic", name = "Basic Crate", price = { credits = 400 }, cards = 3, odds = { Common = 70, Rare = 24, Epic = 5, Legendary = 1 }, free = true },
	{ id = "neon", name = "Neon Crate", price = { shards = 20 }, cards = 5, odds = { Common = 45, Rare = 35, Epic = 15, Legendary = 5 }, free = false },
}

Config.Daily = {
	{ credits = 100 }, { credits = 150 }, { freeCrate = 1 }, { credits = 250 }, { shards = 10 }, { credits = 400 },
	{ credits = 1000, shards = 50, part = "aurora_wings", special = true },
} :: { { [string]: any } }

Config.Codes = {
	NEONRUSH = { reward = { credits = 500, shards = 10 } },
	VOIDKART = { reward = { credits = 250, freeCrate = 1 } },
	LAUNCH2024 = { reward = { credits = 5000 }, expiresAt = 1704067200 },
} :: { [string]: { reward: { [string]: number }, expiresAt: number? } }
Config.SampleCode = "NEONRUSH"
Config.CodeRateMax = 4
Config.CodeRateWindow = 30

Config.Boosts = {
	{ id = "credits2x", name = "Double Credits", desc = "Earn 2x credits from races.", price = { shards = 15 }, duration = 900, kind = "credits", mult = 2 },
	{ id = "xp2x", name = "XP Surge", desc = "Earn 2x XP from races.", price = { shards = 10 }, duration = 900, kind = "xp", mult = 2 },
}

Config.Quests = {
	{ id = "race3", name = "Finish 3 races", stat = "races", goal = 3, reward = { credits = 300 } },
	{ id = "drift5", name = "Land 5 drift boosts", stat = "driftBoosts", goal = 5, reward = { shards = 5 } },
	{ id = "podium", name = "Finish on the podium", stat = "podiums", goal = 1, reward = { credits = 400 } },
	{ id = "upgrade1", name = "Buy a kart upgrade", stat = "upgrades", goal = 1, reward = { credits = 200 } },
}

Config.Offer = { id = "starter", name = "Neon Starter Bundle", price = { shards = 20 }, reward = { credits = 2500, freeCrate = 2 }, duration = 1800, maxLevel = 10 }

Config.MechanicReward = { credits = 400, shards = 5 }
Config.PowerCells = 3

Config.Tracks = {
	{ id = "neon_loop", name = "Neon Loop", desc = "Fast sweeping stadium with two long boost straights.", laps = 3, mode = "Classic", color = Color3.fromRGB(30, 230, 255) },
	{ id = "serpent", name = "Cyan Serpent", desc = "Rolling S-bends where drift chains pay off.", laps = 3, mode = "Classic", color = Color3.fromRGB(60, 235, 120) },
	{ id = "void_ko", name = "Void Knockout", desc = "Elimination: the last racer is OUT each time the leader starts a new lap.", laps = 3, mode = "Knockout", color = Color3.fromRGB(255, 60, 200) },
}
Config.RacerCount = 6
Config.TrackWidth = 38

Config.QuickChat = { "Good luck!", "Nice drift!", "On your left!", "GG!", "Wait up!", "Watch that turn!", "Rematch?", "Thanks!" }
Config.ChatCooldown = 5

Config.Rewards = { credits = { 500, 360, 260, 180, 140, 110 }, xp = { 120, 95, 80, 65, 55, 45 } }
function Config.XpForLevel(level: number): number
	return 200 + level * 100
end
Config.Leagues = { { name = "Bronze League", races = 0 }, { name = "Silver League", races = 5 }, { name = "Gold League", races = 15 }, { name = "Void League", races = 30 } }

Config.DefaultSettings = { music = 50, sfx = 70, damageNumbers = true, cameraShake = true, graphics = "High", textScale = 100, reducedMotion = false }
Config.GraphicsOptions = { "Low", "Medium", "High" }
Config.TextScales = { 100, 115, 130 }

function Config.FindById<T>(list: { T }, id: string): T?
	for _, v in list do
		if (v :: any).id == id then
			return v
		end
	end
	return nil
end

-- Final driving numbers for a kart with upgrades, parts and driver. Used by the client sim and the server validator.
function Config.KartPhysics(kartId: string, upgrades: { [string]: number }?, parts: { string }?, driverId: string?)
	local kart = Config.FindById(Config.Karts, kartId) or Config.Karts[1]
	local speed, accel, handling, boost, nitro = kart.speed, kart.accel, kart.handling, kart.boost, 1
	if upgrades then
		speed += (upgrades.speed or 0) * Config.UpgradeGain.speed
		handling += (upgrades.handling or 0) * Config.UpgradeGain.handling
		boost += (upgrades.boost or 0) * Config.UpgradeGain.boost
	end
	for _, pid in parts or {} do
		local p = Config.FindById(Config.Parts, pid)
		if p then
			speed += p.effects.speed or 0
			accel += p.effects.accel or 0
			handling += p.effects.handling or 0
			boost += p.effects.boost or 0
			nitro += p.nitro or 0
		end
	end
	local d = driverId and Config.FindById(Config.Drivers, driverId)
	if d then
		speed += d.stats.speed
		handling += d.stats.handling
		boost += d.stats.boost
	end
	return {
		stats = { speed = speed, accel = accel, handling = handling, boost = boost },
		maxSpeed = 46 + speed * 0.42,
		accel = 16 + accel * 0.26,
		turn = 1.25 + handling * 0.012,
		boostMul = 1.3 + boost * 0.004,
		nitro = nitro,
	}
end

function Config.Comma(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then out = out:sub(2) end
	return out
end

function Config.Short(n: number): string
	if n >= 1e6 then return string.format("%.1fM", n / 1e6) end
	if n >= 1e4 then return string.format("%.1fK", n / 1e3) end
	return Config.Comma(n)
end

function Config.PriceText(price: { [string]: number }): string
	local parts = {}
	if price.credits and price.credits > 0 then table.insert(parts, Config.Comma(price.credits) .. " Credits") end
	if price.shards and price.shards > 0 then table.insert(parts, Config.Comma(price.shards) .. " Shards") end
	if #parts == 0 then return "Free" end
	return table.concat(parts, " + ")
end

function Config.Clock(sec: number): string
	sec = math.max(0, math.floor(sec))
	local h = math.floor(sec / 3600)
	local m = math.floor(sec % 3600 / 60)
	local s = sec % 60
	if h > 0 then return string.format("%d:%02d:%02d", h, m, s) end
	return string.format("%d:%02d", m, s)
end

function Config.Ordinal(n: number): string
	local suf = "th"
	if n % 100 < 11 or n % 100 > 13 then
		if n % 10 == 1 then suf = "st" elseif n % 10 == 2 then suf = "nd" elseif n % 10 == 3 then suf = "rd" end
	end
	return tostring(n) .. suf
end

return Config
]]></ProtectedString>
