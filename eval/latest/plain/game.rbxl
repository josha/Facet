					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Race</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">2e354cd1eaccce3a0afdb16a00001d78</UniqueId>
				</Properties>
			</Item>
			<Item class="Script" referent="RBXD556F00C0B9B4029B54E3C5B786D7D72">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Request routing and validation. Clients only ask; the server decides.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local Profiles = require(script.Parent.Profiles)
local Race = require(script.Parent.Race)
local Remotes = RS:WaitForChild("Remotes")
local now = Profiles.now

type Result = { ok: boolean, err: string?, code: string?, data: any?, retryAt: number? }
local function ok(data: any?): Result return { ok = true, data = data } end
local function fail(err: string, code: string?): Result return { ok = false, err = err, code = code } end
local function fmt(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then out = out:sub(2) end
	return out
end
local function needText(p: any, soft: number, hard: number): string
	local parts = {}
	if p.soft < soft then table.insert(parts, fmt(soft - p.soft) .. " more Credits") end
	if p.hard < hard then table.insert(parts, fmt(hard - p.hard) .. " more Flux") end
	return "Not enough funds: you need " .. table.concat(parts, " and ") .. "."
end
local function str(v: any): string return if type(v) == "string" then v else "" end
local function today(): number return math.floor(now() / 86400) end

local H: { [string]: (Player, any, any) -> Result } = {}

-- Shop & inventory -------------------------------------------------------
H.buyPart = function(player, p, a)
	local part = Config.getPart(str(a.id))
	if not part then return fail("Unknown part.") end
	if p.ownedParts[part.id] then return fail("You already own " .. part.name .. ".", "owned") end
	if not Profiles.spend(p, part.price, 0) then return fail(needText(p, part.price, 0), "funds") end
	p.ownedParts[part.id] = true
	return ok({ text = "Bought " .. part.name .. " for " .. fmt(part.price) .. " Credits." })
end
H.equipPart = function(player, p, a)
	local part = Config.getPart(str(a.id))
	if not part then return fail("Unknown part.") end
	if not p.ownedParts[part.id] then return fail("You don't own " .. part.name .. " yet.", "locked") end
	local prev = p.equipped[part.slot]
	p.equipped[part.slot] = part.id
	local prevPart = prev and prev ~= part.id and Config.getPart(prev)
	return ok({ text = if prevPart then (part.name .. " replaced " .. prevPart.name .. ".") else (part.name .. " equipped.") })
end
H.unequipSlot = function(player, p, a)
	local slot = str(a.slot)
	if not Config.SlotLabel[slot] then return fail("Unknown slot.") end
	if not p.equipped[slot] then return fail("That slot is already empty.") end
	p.equipped[slot] = nil
	return ok({ text = Config.SlotLabel[slot] .. " slot is now empty." })
end

-- Garage --------------------------------------------------------------
H.selectKart = function(player, p, a)
	local k = Config.getKart(str(a.id))
	if not k then return fail("Unknown kart.") end
	p.selectedKart = k.id
	return ok({ text = k.name .. " is your kart for the next race." })
end
H.favoriteKart = function(player, p, a)
	local k = Config.getKart(str(a.id))
	if not k then return fail("Unknown kart.") end
	p.favorites[k.id] = if a.on == true then true else nil
	return ok()
end
H.upgrade = function(player, p, a)
	local k = Config.getKart(str(a.kart))
	local stat = str(a.stat)
	if not k or not table.find(Config.UpgradeStats, stat) then return fail("Unknown upgrade.") end
	local lv = p.upgrades[k.id][stat]
	if lv >= Config.UpgradeMax then return fail("Already at max level.", "max") end
	local soft, hard = Config.upgradeCost(lv)
	if not Profiles.spend(p, soft, hard) then return fail(needText(p, soft, hard), "funds") end
	p.upgrades[k.id][stat] = lv + 1
	return ok({ text = k.name .. " " .. stat .. " upgraded to level " .. (lv + 1) .. "." })
end
H.saveLivery = function(player, p, a)
	local l = type(a.livery) == "table" and a.livery or {}
	local function color(n: any): boolean
		for _, c in Config.Colors do if c.name == n then return true end end
		return false
	end
	local function decal(n: any): boolean
		for _, d in Config.Decals do if d.id == n then return true end end
		return false
	end
	if not (color(l.body) and color(l.accent) and table.find(Config.Shades, l.bodyShade) and table.find(Config.Shades, l.accentShade) and decal(l.decal)) then
		return fail("That design has invalid values.")
	end
	p.livery = { body = l.body, bodyShade = l.bodyShade, accent = l.accent, accentShade = l.accentShade, decal = l.decal }
	return ok({ text = "Livery saved." })
end

-- Drivers -------------------------------------------------------------
H.buyDriver = function(player, p, a)
	local d = Config.getDriver(str(a.id))
	if not d then return fail("Unknown driver.") end
	if p.ownedDrivers[d.id] then return fail("You already own " .. d.name .. ".", "owned") end
	if not Profiles.spend(p, d.price, 0) then return fail(needText(p, d.price, 0), "funds") end
	p.ownedDrivers[d.id] = true
	p.rentals[d.id] = nil
	return ok({ text = d.name .. " joined your team permanently." })
end
H.rentDriver = function(player, p, a)
	local d = Config.getDriver(str(a.id))
	if not d or d.rent <= 0 then return fail("This driver can't be rented.") end
	if p.ownedDrivers[d.id] then return fail("You already own " .. d.name .. ".", "owned") end
	if p.rentals[d.id] and now() < p.rentals[d.id] then return fail(d.name .. " is already rented.", "active") end
	if not Profiles.spend(p, d.rent, 0) then return fail(needText(p, d.rent, 0), "funds") end
	p.rentals[d.id] = now() + Config.RentalSeconds
	return ok({ text = d.name .. " rented for 10 minutes." })
end
H.selectDriver = function(player, p, a)
	local d = Config.getDriver(str(a.id))
	if not d then return fail("Unknown driver.") end
	if not Profiles.hasDriver(p, d.id) then return fail("Buy or rent " .. d.name .. " first.", "locked") end
	p.selectedDriver = d.id
	return ok({ text = d.name .. " will drive your next race." })
end

-- Crates --------------------------------------------------------------
H.openCrate = function(player, p, a)
	local crate = nil
	for _, c in Config.Crates do if c.id == str(a.id) then crate = c end end
	if not crate then return fail("Unknown crate.") end
	local usedFree = false
	if crate.id == "spark" and p.freeCrates > 0 then
		p.freeCrates -= 1
		usedFree = true
	else
		local soft = if crate.currency == "soft" then crate.price else 0
		local hard = if crate.currency == "hard" then crate.price else 0
		if not Profiles.spend(p, soft, hard) then return fail(needText(p, soft, hard), "funds") end
	end
	local cards = {}
	for i = 1, crate.cards do
		local roll = math.random() * 100
		local acc, rarity = 0, "Common"
		for _, r in Config.Rarities do
			acc += crate.odds[r]
			if roll <= acc then rarity = r break end
		end
		local pool = {}
		for _, c in Config.Cards do if c.rarity == rarity then table.insert(pool, c) end end
		local card = pool[math.random(1, #pool)]
		local isNew = (p.collection[card.id] or 0) == 0
		p.collection[card.id] = (p.collection[card.id] or 0) + 1
		table.insert(cards, { id = card.id, name = card.name, rarity = card.rarity, new = isNew, count = p.collection[card.id] })
	end
	p.cratesOpened += 1
	Profiles.questProgress(p, "crate", 1)
	return ok({ cards = cards, usedFree = usedFree })
end

-- Daily ---------------------------------------------------------------
H.claimDaily = function(player, p, a)
	local d = p.daily
	local t = today()
	if d.lastDay == t then return fail("Today's reward is already claimed. Come back after the reset.", "claimed") end
	local notice = ""
	if d.lastDay >= 0 and t - d.lastDay > 1 then
		d.streak = 0
		notice = "You missed a day, so your track restarted at Day 1."
	end
	if d.streak >= 7 then d.streak = 0 end
	local reward = Config.Daily[d.streak + 1]
	Profiles.grant(p, reward.soft, reward.hard)
	if reward.crate then p.freeCrates += reward.crate end
	if reward.part then p.ownedParts[reward.part] = true end
	d.streak += 1
	d.lastDay = t
	d.notice = notice
	return ok({ text = "Day " .. reward.day .. " claimed: " .. reward.label, notice = notice })
end

-- Codes ---------------------------------------------------------------
H.redeem = function(player, p, a)
	p.codeLimit = p.codeLimit or { fails = {}, lockedUntil = 0 }
	local lim = p.codeLimit
	local code = string.upper((str(a.code):gsub("^%s+", ""):gsub("%s+$", "")))
	if code == "" then return fail("Type a code first.", "empty") end
	if now() < lim.lockedUntil then
		local r = fail("Too many attempts. Try again soon.", "rate")
		r.retryAt = lim.lockedUntil
		return r
	end
	if p.codeBusy then return fail("Still checking your last code…", "busy") end
	p.codeBusy = true
	task.wait(0.8)
	p.codeBusy = false
	local def = Config.Codes[code]
	if not def then
		local t = now()
		local recent = {}
		for _, f in lim.fails do if t - f < 60 then table.insert(recent, f) end end
		table.insert(recent, t)
		lim.fails = recent
		if #recent >= 4 then
			lim.lockedUntil = t + 30
			lim.fails = {}
			local r = fail("That code isn't valid. Too many tries — wait before trying again.", "rate")
			r.retryAt = lim.lockedUntil
			return r
		end
		return fail("\"" .. code .. "\" isn't a valid code.", "invalid")
	end
	if def.expired then return fail("\"" .. code .. "\" has expired.", "expired") end
	if p.codesUsed[code] then return fail("You already used \"" .. code .. "\".", "used") end
	p.codesUsed[code] = true
	Profiles.grant(p, def.soft, def.hard)
	return ok({ text = "Code accepted: " .. def.label })
end

-- Boosts, quests, offer -------------------------------------------------
H.buyBoost = function(player, p, a)
	local b = nil
	for _, x in Config.Boosts do if x.id == str(a.id) then b = x end end
	if not b then return fail("Unknown boost.") end
	local soft = if b.currency == "soft" then b.price else 0
	local hard = if b.currency == "hard" then b.price else 0
	if not Profiles.spend(p, soft, hard) then return fail(needText(p, soft, hard), "funds") end
	p.boosts[b.id] = math.max(now(), p.boosts[b.id] or 0) + b.seconds
	return ok({ text = b.name .. " active for 15 minutes." })
end
H.claimQuest = function(player, p, a)
	local def = nil
	for _, q in Config.Quests do if q.id == str(a.id) then def = q end end
	if not def then return fail("Unknown quest.") end
	local q = p.quests[def.id]
	if q.claimed then return fail("Already claimed.", "claimed") end
	if q.progress < def.goal then return fail("Quest not complete yet.") end
	q.claimed = true
	Profiles.grant(p, def.soft, def.hard)
	return ok({ text = "Quest reward claimed." })
end
H.buyOffer = function(player, p, a)
	local o = Config.Offer
	if p.offer.bought then return fail("You already bought this bundle.", "owned") end
	if now() >= p.offer.expiresAt then return fail("This offer has expired.", "expired") end
	if p.level > o.maxLevel then return fail("This bundle is for drivers up to level " .. o.maxLevel .. ".") end
	if not Profiles.spend(p, 0, o.price) then return fail(needText(p, 0, o.price), "funds") end
	p.offer.bought = true
	Profiles.grant(p, o.soft, 0)
	p.ownedParts[o.part] = true
	return ok({ text = o.name .. " unlocked!" })
end

-- Mechanic -------------------------------------------------------------
local function nearPart(player: Player, part: BasePart?, range: number): boolean
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return hrp ~= nil and part ~= nil and (hrp.Position - part.Position).Magnitude <= range
end
H.mechanic = function(player, p, a)
	local op = str(a.op)
	local j = p.job
	local torso = workspace.Hub.Mechanic:FindFirstChild("Torso") :: BasePart
	if not nearPart(player, torso, 20) then return fail("Walk over to Gears first.") end
	if op == "accept" then
		if j.state ~= "none" then return fail("You already have this job.") end
		j.state = "active"
		j.bolts = {}
		return ok({ text = "Job accepted: find 3 spare bolts around the hub." })
	elseif op == "turnin" then
		if j.state ~= "ready" then return fail("You still need all three bolts.") end
		j.state = "done"
		Profiles.grant(p, Config.Mechanic.rewardSoft, Config.Mechanic.rewardHard)
		return ok({ text = "Gears paid you " .. Config.Mechanic.rewardSoft .. " Credits + " .. Config.Mechanic.rewardHard .. " Flux." })
	end
	return fail("Unknown option.")
end
H.pickBolt = function(player, p, a)
	local id = tonumber(a.id)
	local j = p.job
	if j.state ~= "active" then return fail("Gears hasn't asked you for bolts.") end
	if not id or id < 1 or id > Config.Mechanic.jobBolts or id ~= math.floor(id) then return fail("Unknown bolt.") end
	local bolt = workspace.Hub.Bolts:FindFirstChild("Bolt" .. id) :: BasePart?
	if not nearPart(player, bolt, 16) then return fail("Get closer to the bolt.") end
	if j.bolts[tostring(id)] then return fail("Already collected.") end
	j.bolts[tostring(id)] = true
	local c = 0
	for _ in j.bolts do c += 1 end
	if c >= Config.Mechanic.jobBolts then j.state = "ready" end
	return ok({ text = "Bolt " .. c .. "/" .. Config.Mechanic.jobBolts .. " collected." .. (if c >= Config.Mechanic.jobBolts then " Return to Gears!" else "") })
end

-- Settings & tutorial -----------------------------------------------------
H.saveSettings = function(player, p, a)
	local s = type(a.settings) == "table" and a.settings or {}
	local function vol(v: any): number?
		if type(v) ~= "number" or v ~= v then return nil end
		return math.clamp(math.floor(v + 0.5), 0, 100)
	end
	local music, sfx = vol(s.music), vol(s.sfx)
	if music == nil or sfx == nil then return fail("Volume values are invalid.") end
	if not table.find({ "Low", "Medium", "High" }, s.graphics) then return fail("Unknown graphics quality.") end
	if not table.find({ "Default", "Large", "Huge" }, s.textSize) then return fail("Unknown text size.") end
	p.settings = { music = music, sfx = sfx, damageNumbers = s.damageNumbers == true, cameraShake = s.cameraShake == true, graphics = s.graphics, textSize = s.textSize, reducedMotion = s.reducedMotion == true }
	return ok({ text = "Settings saved." })
end
H.resetSettings = function(player, p, a)
	p.settings = Profiles.defaultSettings()
	return ok({ text = "Settings reset to defaults." })
end
H.tutorial = function(player, p, a)
	local st = str(a.state)
	if st ~= "done" and st ~= "skipped" then return fail("Unknown state.") end
	p.tutorial = st
	return ok()
end

-- Party ---------------------------------------------------------------
local function friendDef(id: string): any
	for _, f in Config.Friends do if f.id == id then return f end end
	return nil
end
H.getFriends = function(player, p, a)
	local list = {}
	local okF, pages = pcall(function() return Players:GetFriendsAsync(player.UserId) end)
	if okF and pages then
		local okP, page = pcall(function() return (pages :: any):GetCurrentPage() end)
		if okP then
			for _, f in page do
				local here = Players:GetPlayerByUserId(f.Id)
				local status = if here then (if Race.sessionOf(here) then "Racing" else "Online") else "Offline"
				table.insert(list, { id = "u" .. f.Id, name = f.DisplayName or f.Username, userId = f.Id, status = status, demo = false })
			end
		end
	end
	for _, f in Config.Friends do
		table.insert(list, { id = f.id, name = f.name, userId = 0, status = f.status, demo = true })
	end
	return ok({ friends = list, realLookup = okF })
end
H.partyInvite = function(player, p, a)
	local id = str(a.id)
	local f = friendDef(id)
	if not f then return fail("Only demo participants can be invited in this session.") end
	if table.find(p.party.members, id) then return fail(f.name .. " is already in your party.", "dup") end
	if p.party.invites[id] == "pending" then return fail("Invite to " .. f.name .. " is already pending.", "dup") end
	if f.status == "Offline" then return fail(f.name .. " is offline.", "offline") end
	if f.status == "Racing" then return fail(f.name .. " is in a race right now.", "busy") end
	if #p.party.members >= 3 then return fail("Your party is full.") end
	p.party.invites[id] = "pending"
	task.delay(2 + math.random() * 1.5, function()
		local prof = Profiles.get(player)
		if not prof or prof.party.invites[id] ~= "pending" then return end
		if f.reply == "accept" then
			prof.party.invites[id] = "accepted"
			table.insert(prof.party.members, id)
			Remotes.Notify:FireClient(player, { kind = "toast", text = f.name .. " accepted your party invite!", tone = "good" })
		else
			prof.party.invites[id] = "declined"
			Remotes.Notify:FireClient(player, { kind = "toast", text = f.name .. " declined your invite.", tone = "warn" })
		end
		Profiles.snapshot(player)
		Race.partyChanged()
	end)
	return ok({ text = "Invite sent to " .. f.name .. "." })
end
H.partyRemove = function(player, p, a)
	local id = str(a.id)
	local i = table.find(p.party.members, id)
	if not i then return fail("Not in your party.") end
	table.remove(p.party.members, i)
	p.party.invites[id] = nil
	Race.partyChanged()
	return ok()
end

-- Racing ----------------------------------------------------------------
H.queueJoin = function(player, p, a)
	local s, e = Race.joinQueue(player, str(a.mode))
	return if s then ok() else fail(e or "Could not join.")
end
H.queueLeave = function(player, p, a)
	local s, e = Race.leaveQueue(player)
	return if s then ok() else fail(e or "Could not leave.")
end
H.vote = function(player, p, a)
	local s, e = Race.vote(player, str(a.track))
	return if s then ok() else fail(e or "Vote rejected.")
end
H.recover = function(player, p, a)
	local s, e = Race.recover(player)
	return if s then ok() else fail(e or "Can't recover now.")
end
H.leaveTrack = function(player, p, a)
	local s, e = Race.leave(player)
	return if s then ok() else fail(e or "Not on a track.")
end
H.testDrive = function(player, p, a)
	local s, e = Race.startTestDrive(player, str(a.kart))
	return if s then ok() else fail(e or "Can't start a test drive.")
end
H.quickChat = function(player, p, a)
	local i = tonumber(a.index)
	if not i or not Config.QuickChat[i] then return fail("Unknown message.") end
	local t = now()
	if p.chatAt and t - p.chatAt < Config.QuickChatCooldown then
		local r = fail("Quick chat is cooling down.", "cooldown")
		r.retryAt = p.chatAt + Config.QuickChatCooldown
		return r
	end
	p.chatAt = t
	local text = Config.QuickChat[i]
	Remotes.Notify:FireAllClients({ kind = "chat", name = player.DisplayName, userId = player.UserId, text = text })
	Race.chatTag(player, text)
	return ok({ retryAt = t + Config.QuickChatCooldown })
end

local SILENT = { getFriends = true, quickChat = true, queueJoin = true, queueLeave = true, vote = true, recover = true, leaveTrack = true, testDrive = true }

Remotes.Request.OnServerInvoke = function(player: Player, action: any, payload: any): any
	if type(action) ~= "string" then return fail("Bad request.") end
	local handler = H[action]
	if not handler then return fail("Unknown action.") end
	local p = Profiles.get(player)
	if not p then return fail("Your profile is still loading.", "busy") end
	Profiles.refreshTimed(player)
	local success, result = pcall(handler, player, p, if type(payload) == "table" then payload else {})
	if not success then
		warn("Request failed", action, result)
		return fail("Server error. Nothing was changed.")
	end
	local r = result :: any
	if r.ok and not SILENT[action] then
		Profiles.changed(player)
	end
	r.profile = p
	p.serverTime = now()
	return r
end

Remotes.Drive.OnServerEvent:Connect(function(player, t, s, drift, boostSeq)
	if type(t) ~= "number" or type(s) ~= "number" or t ~= t or s ~= s then return end
	Race.setInput(player, t, s, drift == true, if type(boostSeq) == "number" then boostSeq else 0)
end)

local function onPlayer(player: Player)
	Profiles.load(player)
	Race.sendLobby(player)
end
Players.PlayerAdded:Connect(onPlayer)
for _, pl in Players:GetPlayers() do task.spawn(onPlayer, pl) end
]]></ProtectedString>
