						<ProtectedString name="Source"><![CDATA[--!strict
-- Rotating kart preview inside a ViewportFrame.
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local KartBuilder = require(RS.Shared.KartBuilder)
local UI = require(script.Parent.UI)

local KartView = {}

function KartView.new(parent: Instance, props: { [string]: any }?)
	local vf = UI.new("ViewportFrame", { BackgroundColor3 = Color3.fromRGB(12, 12, 30), Size = UDim2.fromScale(1, 1), Ambient = Color3.fromRGB(150, 150, 200), LightColor = Color3.fromRGB(255, 255, 255), LightDirection = Vector3.new(-1, -2, -1) }, nil)
	if props then for k, v in props do (vf :: any)[k] = v end end
	UI.corner(vf, 12)
	vf.Parent = parent
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = vf
	vf.CurrentCamera = cam
	local floor = UI.new("Part", { Anchored = true, Size = Vector3.new(14, 0.2, 14), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(30, 230, 255), Material = Enum.Material.Neon, Transparency = 0.82 }, nil)
	floor.Shape = Enum.PartType.Cylinder
	floor.Size = Vector3.new(0.2, 12, 12)
	floor.CFrame = CFrame.new(0, -0.1, 0) * CFrame.Angles(0, 0, math.rad(90))
	floor.Parent = vf
	local model: Model? = nil
	local angle = 0.6
	local self = {}
	function self.set(kartId: string, look: any?, cosmetic: string?)
		if model then model:Destroy() end
		model = KartBuilder.Build(kartId, look, cosmetic)
		local m = model :: Model
		m.Parent = vf
	end
	local conn = RunService.RenderStepped:Connect(function(dt)
		if not vf.Visible or not vf.Parent then return end
		if not UI.reducedMotion() then angle += dt * 0.5 end
		local m = model
		if m and m.PrimaryPart then
			m.PrimaryPart.CFrame = CFrame.Angles(0, angle, 0)
		end
		cam.CFrame = CFrame.lookAt(Vector3.new(0, 4.6, 11.5), Vector3.new(0, 1.3, 0))
	end)
	vf.Destroying:Connect(function() conn:Disconnect() end)
	self.frame = vf
	return self
end

return KartView
]]></ProtectedString>
