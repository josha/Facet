					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Track centerlines and projection helpers shared by server validation and client driving.
local Track = {}

Track.N = 72
Track.RoadY = 1 -- top surface of every road
Track.HalfWidth = 19

local origins: { [string]: Vector3 } = {
	neon_loop = Vector3.new(0, 0, -470),
	serpent = Vector3.new(580, 0, 0),
	void_ko = Vector3.new(-560, 0, 0),
}

local cache: { [string]: { Vector3 } } = {}

local function shapeAt(id: string, t: number): (number, number)
	if id == "neon_loop" then
		local c, s = math.cos(t), math.sin(t)
		local n = 0.5 -- superellipse exponent 2/n, gives a rounded stadium
		return 240 * math.sign(c) * math.abs(c) ^ n, 120 * math.sign(s) * math.abs(s) ^ n
	elseif id == "serpent" then
		local r = 185 * (1 + 0.2 * math.sin(3 * t))
		return r * math.cos(t) * 1.1, r * math.sin(t)
	else
		local r = 165 * (1 + 0.16 * math.cos(2 * t) + 0.07 * math.sin(5 * t))
		return r * math.cos(t), r * math.sin(t)
	end
end

function Track.Points(id: string): { Vector3 }
	local hit = cache[id]
	if hit then return hit end
	local o = origins[id] or origins.neon_loop
	local pts = {}
	for i = 0, Track.N - 1 do
		local t = (i / Track.N) * math.pi * 2
		local x, z = shapeAt(id, t)
		table.insert(pts, Vector3.new(o.X + x, Track.RoadY, o.Z + z))
	end
	cache[id] = pts
	return pts
end

function Track.Origin(id: string): Vector3
	return origins[id] or origins.neon_loop
end

local function wrap(i: number): number
	return (i - 1) % Track.N + 1
end
Track.Wrap = wrap

-- Nearest centerline segment near a hint index. Returns index, fraction along segment, signed lateral offset, closest point.
function Track.Project(pts: { Vector3 }, pos: Vector3, hint: number?, window: number?): (number, number, number, Vector3)
	local bestI, bestT, bestD, bestP = 1, 0, math.huge, pts[1]
	local function test(i: number)
		local a = pts[i]
		local b = pts[wrap(i + 1)]
		local ab = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
		local ap = Vector3.new(pos.X - a.X, 0, pos.Z - a.Z)
		local len2 = ab:Dot(ab)
		local t = if len2 > 0 then math.clamp(ap:Dot(ab) / len2, 0, 1) else 0
		local p = a + ab * t
		local d = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(p.X, 0, p.Z)).Magnitude
		if d < bestD then
			bestI, bestT, bestD, bestP = i, t, d, Vector3.new(p.X, Track.RoadY, p.Z)
		end
	end
	if hint and window then
		for k = -window, window do
			test(wrap(hint + k))
		end
	else
		for i = 1, Track.N do
			test(i)
		end
	end
	local a = pts[bestI]
	local b = pts[wrap(bestI + 1)]
	local dir = Vector3.new(b.X - a.X, 0, b.Z - a.Z).Unit
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local lateral = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(bestP.X, 0, bestP.Z)):Dot(right)
	return bestI, bestT, lateral, bestP
end

function Track.Direction(pts: { Vector3 }, i: number): Vector3
	local a = pts[wrap(i)]
	local b = pts[wrap(i + 1)]
	return Vector3.new(b.X - a.X, 0, b.Z - a.Z).Unit
end

function Track.Right(pts: { Vector3 }, i: number): Vector3
	local d = Track.Direction(pts, i)
	return Vector3.new(-d.Z, 0, d.X)
end

-- Yaw so that CFrame.Angles(0, yaw, 0).LookVector points along dir.
function Track.Yaw(dir: Vector3): number
	return math.atan2(-dir.X, -dir.Z)
end

-- Grid slot behind the start line. slot is 1-based.
function Track.GridSlot(pts: { Vector3 }, slot: number): (Vector3, number)
	local row = math.floor((slot - 1) / 2)
	local col = (slot - 1) % 2
	local idx = wrap(Track.N - row)
	local dir = Track.Direction(pts, idx)
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local p = pts[idx] + right * (if col == 0 then -6 else 6) - dir * 4
	return Vector3.new(p.X, Track.RoadY, p.Z), Track.Yaw(dir)
end

return Track
]]></ProtectedString>
