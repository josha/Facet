							<ProtectedString name="Source"><![CDATA[--!strict
-- Race queue (Solo / Duo) and live track voting.
local GuiService = game:GetService("GuiService")
return function(App: any)
	local UI = App.UI
	local T = UI.T
	local Config = App.Config
	local new = UI.new
	local def: any = { title = "RACE QUEUE", color = T.magenta, maxW = 900 }
	local content: ScrollingFrame
	local busy = false

	local function rebuild()
		if not def.frame or not def.frame.Visible then return end
		local selName = GuiService.SelectedObject and GuiService.SelectedObject.Name
		for _, c in content:GetChildren() do if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end end
		local l = App.lobby
		if not l then UI.label(content, "Connecting to the race server…", 16) return end
		local uid = App.player.UserId
		local m = l.match
		if m and table.find(m.players, uid) then
			def.title.Text = "TRACK VOTE"
			local left = math.max(0, math.ceil(m.deadline - App.now()))
			local head = UI.label(content, if m.phase == "voting" then ("Vote for the next track · <b>" .. left .. "s</b> left. You can change your vote until the timer ends.") else "Voting closed.", 16, { LayoutOrder = 1, Name = "VoteHead" })
			head:SetAttribute("Deadline", m.deadline)
			local myVote = m.votes["u" .. uid]
			local grid = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = content })
			local gl = new("UIGridLayout", { CellSize = UDim2.new(if App.layout.narrow then 1 else 1 / 3, -8, 0, 210), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
			for i, t in m.tracks do
				local tr = Config.getTrack(t.id)
				local isWinner = m.winner == t.id
				local c = new("Frame", { BackgroundColor3 = if isWinner then Color3.fromRGB(50, 20, 70) else T.card, LayoutOrder = i, Parent = grid })
				UI.corner(c, 12)
				UI.stroke(c, if isWinner then T.amber elseif myVote == t.id then T.cyan else tr.color, if isWinner or myVote == t.id then 3 else 1.5, if myVote == t.id or isWinner then 0 else 0.4)
				UI.pad(c, 10, 12)
				UI.list(c, Enum.FillDirection.Vertical, 6)
				UI.label(c, t.name, 17, { FontFace = UI.F.title, TextColor3 = tr.color, LayoutOrder = 1 })
				UI.label(c, t.desc, 13, { TextColor3 = T.muted, LayoutOrder = 2 })
				UI.label(c, string.format("<b>%d</b> vote%s%s", t.votes, if t.votes == 1 then "" else "s", if myVote == t.id then "  ·  <font color=\"#00EBFF\">YOUR VOTE</font>" else ""), 15, { LayoutOrder = 3 })
				if m.phase == "voting" then
					local b = UI.button(c, if myVote == t.id then "Voted ✓" else "Vote", { size = UDim2.new(1, 0, 0, 42), color = tr.color, layoutOrder = 4, name = "Vote_" .. t.id }, function()
						if busy then return end
						busy = true
						App.request("vote", { track = t.id })
						busy = false
					end)
					if myVote == t.id then b.BackgroundColor3 = T.cyan end
				elseif isWinner then
					UI.label(c, "WINNER · race starting", 15, { FontFace = UI.F.bold, TextColor3 = T.amber, LayoutOrder = 4 })
				end
			end
			if App.layout.narrow then gl.CellSize = UDim2.new(1, 0, 0, 170) end
			UI.label(content, "Racers: " .. table.concat(m.participants, ", "), 14, { TextColor3 = T.muted, LayoutOrder = 3 })
			if m.phase == "winner" then
				local w = Config.getTrack(m.winner)
				UI.label(content, "Winning track: <b>" .. (if w then w.name else "?") .. "</b>. Votes are locked.", 18, { TextColor3 = T.amber, LayoutOrder = 0 })
			end
		else
			def.title.Text = "RACE QUEUE"
			UI.label(content, "Pick a queue. Local AI racers fill the grid up to 6 karts. Your selected kart, parts, driver and livery are used.", 15, { TextColor3 = T.muted, LayoutOrder = 1 })
			if l.busy then UI.label(content, "A race is on track right now. Your race starts as soon as it finishes.", 14, { TextColor3 = T.amber, LayoutOrder = 2 }) end
			local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = content })
			new("UIGridLayout", { CellSize = UDim2.new(if App.layout.narrow then 1 else 0.5, -8, 0, 200), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
			for i, mode in { "Solo", "Duo" } do
				local q = l.queues[mode]
				local mine = table.find(q.members, uid) ~= nil
				local c = new("Frame", { BackgroundColor3 = T.card, LayoutOrder = i, Parent = row })
				UI.corner(c, 12)
				UI.stroke(c, if mine then T.magenta else T.dim, if mine then 3 else 1.5, 0)
				UI.pad(c, 12, 14)
				UI.list(c, Enum.FillDirection.Vertical, 6)
				UI.label(c, string.upper(mode), 20, { FontFace = UI.F.title, TextColor3 = if mode == "Solo" then T.cyan else T.green, LayoutOrder = 1 })
				UI.label(c, string.format("<b>%d / %d</b> joined", q.joined, q.required), 18, { LayoutOrder = 2 })
				local status
				if q.endsAt then
					status = "Starting in " .. math.max(0, math.ceil(q.endsAt - App.now())) .. "s — leave now to cancel"
				elseif q.notice ~= "" then
					status = q.notice
				elseif mode == "Duo" then
					status = if q.partner then ("Party member " .. q.partner .. " rides as your duo partner.") else "Needs 2 racers: another player, or invite a demo friend from Party."
				else
					status = "Race against 5 AI opponents."
				end
				UI.label(c, status, 13, { TextColor3 = if q.endsAt then T.amber elseif q.notice ~= "" then T.red else T.muted, LayoutOrder = 3, Name = "Status" })
				if mine then
					UI.button(c, "Leave Queue", { filled = false, color = T.red, size = UDim2.new(1, 0, 0, 44), layoutOrder = 4, name = "Leave_" .. mode }, function()
						App.request("queueLeave", {})
					end)
				else
					UI.button(c, "Join " .. mode, { color = if mode == "Solo" then T.cyan else T.green, size = UDim2.new(1, 0, 0, 44), layoutOrder = 4, name = "Join_" .. mode }, function()
						local r = App.request("queueJoin", { mode = mode })
						if r.ok then App.lastQueueMode = mode end
					end)
				end
			end
			local p = App.profile
			if p then
				local k = Config.getKart(p.selectedKart)
				local d = Config.getDriver(p.selectedDriver)
				UI.label(content, "Next race loadout: <b>" .. (if k then k.name else "?") .. "</b> with driver <b>" .. (if d then d.name else "Kai") .. "</b>", 14, { LayoutOrder = 4 })
			end
		end
		if selName then
			local again = content:FindFirstChild(selName, true)
			if again and again:IsA("GuiObject") then UI.focus(again) end
		elseif UI.usingGamepad() and not GuiService.SelectedObject then
			for _, d in content:GetDescendants() do
				if d:IsA("TextButton") then UI.focus(d) break end
			end
		end
	end

	def.build = function(self: any, body: Frame)
		content = UI.scroll(body)
		UI.list(content, Enum.FillDirection.Vertical, 10)
		UI.pad(content, 4, 4)
		App.lobbyChanged:Connect(rebuild)
		App.layoutChanged:Connect(rebuild)
		task.spawn(function()
			while true do
				task.wait(0.5)
				if self.frame.Visible then
					local l = App.lobby
					local head = content:FindFirstChild("VoteHead")
					if head and l and l.match and l.match.phase == "voting" then
						head.Text = "Vote for the next track · <b>" .. math.max(0, math.ceil(l.match.deadline - App.now())) .. "s</b> left. You can change your vote until the timer ends."
					end
					for _, c in content:GetDescendants() do
						if c.Name == "Status" and l then
							for mode, q in l.queues do
								if q.endsAt and table.find(q.members, App.player.UserId) then
									(c :: TextLabel).Text = "Starting in " .. math.max(0, math.ceil(q.endsAt - App.now())) .. "s — leave now to cancel"
								end
							end
						end
					end
				end
			end
		end)
	end
	def.onOpen = function(self: any)
		rebuild()
	end
	App.register("queue", def)
end
]]></ProtectedString>
