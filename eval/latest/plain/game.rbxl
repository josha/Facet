					<ProtectedString name="Source"><![CDATA[--!strict
-- Server-owned profiles, economy and progression. Every mutation is validated here.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local Remotes = RS:WaitForChild("Remotes")

local DataService = {}
DataService.Profiles = {} :: { [Player]: any }
DataService.Actions = {} :: { [string]: (Player, any) -> any }

local store: any = nil
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore("NeonDriftCircuit_v1")
end)

local function today(): number
	return math.floor(os.time() / 86400)
end

local function newProfile(): any
	return {
		coins = 1500, gems = 40, xp = 0, level = 1, races = 0, wins = 0,
		stats = { races = 0, podiums = 0, driftBoosts = 0, purchases = 0 },
		owned = {}, equipped = {},
		selectedKart = "volt", favorites = {},
		drivers = { d_pip = true }, rentals = {}, selectedDriver = "d_pip",
		livery = table.clone(Config.DefaultLivery), designs = {},
		upgrades = {},
		freeCrates = 1, collection = {},
		daily = { streak = 0, lastDay = -1, missed = false },
		codesUsed = {},
		perks = {},
		offer = { expires = os.time() + Config.Offer.seconds, bought = false },
		quests = {},
		mech = { state = "none", scrap = {} },
		party = { invites = {}, members = {} },
		settings = table.clone(Config.DefaultSettings),
		tutorial = "new",
		lastIncome = 0,
	}
end

local saveState: { [Player]: any } = {}
local dirty: { [Player]: boolean } = {}

function DataService.Snapshot(player: Player): any
	local p = DataService.Profiles[player]
	if not p then return nil end
	local snap = table.clone(p)
	snap.serverTime = os.time()
	snap.save = saveState[player]
	snap.dailyStatus = DataService.DailyStatus(p)
	return snap
end

function DataService.Push(player: Player)
	local snap = DataService.Snapshot(player)
	if snap then Remotes.State:FireClient(player, snap) end
end

function DataService.MarkDirty(player: Player)
	dirty[player] = true
	saveState[player] = { state = "pending", text = "Saving…" }
	DataService.Push(player)
end

function DataService.Notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, { text = text, kind = kind or "info" })
end

local function trySave(player: Player)
	local p = DataService.Profiles[player]
	if not p then return end
	dirty[player] = false
	local ok, err = false, "DataStore unavailable"
	if storeOk and store then
		ok, err = pcall(function()
			store:SetAsync("u_" .. player.UserId, p)
		end)
	end
	if ok then
		saveState[player] = { state = "saved", text = "Saved", at = os.time() }
	else
		-- honest: the server accepted the change, but it is only kept for this session
		saveState[player] = { state = "failed", text = "Kept this session · cloud save unavailable", detail = tostring(err) }
	end
	DataService.Push(player)
end

task.spawn(function()
	while true do
		task.wait(1.5)
		for player, isDirty in pairs(dirty) do
			if isDirty and player.Parent then task.spawn(trySave, player) end
		end
	end
end)

-- XP / level
function DataService.AddXp(p: any, amount: number)
	p.xp += amount
	while p.xp >= Config.XpForLevel(p.level) do
		p.xp -= Config.XpForLevel(p.level)
		p.level += 1
	end
end

function DataService.Grant(p: any, r: any)
	if r.coins then p.coins += r.coins end
	if r.gems then p.gems += r.gems end
	if r.freeCrate then p.freeCrates += r.freeCrate end
	if r.xp then DataService.AddXp(p, r.xp) end
end

function DataService.DailyStatus(p: any): any
	local d = p.daily
	local t = today()
	local nextAt = (t + 1) * 86400
	if d.lastDay == t then
		return { ready = false, day = d.streak, nextDay = (d.streak % 7) + 1, nextAt = nextAt, missed = false }
	end
	local missed = d.lastDay >= 0 and d.lastDay < t - 1
	local streak = missed and 0 or d.streak
	if streak >= 7 then streak = 0 end
	return { ready = true, day = streak, nextDay = streak + 1, nextAt = nextAt, missed = missed }
end

local function ownsDriver(p: any, id: string): boolean
	if p.drivers[id] then return true end
	local r = p.rentals[id]
	return r ~= nil and r > os.time()
end
DataService.OwnsDriver = ownsDriver

function DataService.RaceLoadout(player: Player): any
	local p = DataService.Profiles[player]
	if not ownsDriver(p, p.selectedDriver) then p.selectedDriver = "d_pip" end
	local stats = Config.ComputeStats(p.selectedKart, p.upgrades[p.selectedKart], p.equipped, p.selectedDriver)
	return { kart = p.selectedKart, livery = table.clone(p.livery), cosmetic = p.equipped.Cosmetic, stats = stats, driver = p.selectedDriver }
end

local function err(msg: string): any
	return { ok = false, err = msg }
end
local function okp(player: Player, extra: any?): any
	DataService.MarkDirty(player)
	local r = extra or {}
	r.ok = true
	return r
end

local A = DataService.Actions

A.GetProfile = function(player)
	return { ok = true, profile = DataService.Snapshot(player) }
end

A.BuyPart = function(player, args)
	local p = DataService.Profiles[player]
	local part = Config.GetPart(args.id)
	if not part then return err("Unknown part") end
	if p.owned[part.id] then return err("You already own " .. part.name) end
	if p.coins < part.price then return err("Not enough Coins: need " .. Config.FormatNumber(part.price - p.coins) .. " more") end
	p.coins -= part.price
	p.owned[part.id] = true
	p.stats.purchases += 1
	return okp(player, { msg = "Purchased " .. part.name })
end

A.Equip = function(player, args)
	local p = DataService.Profiles[player]
	local part = Config.GetPart(args.id)
	if not part or not p.owned[part.id] then return err("You don't own that part") end
	p.equipped[part.slot] = part.id
	return okp(player, { msg = part.name .. " equipped" })
end

A.Unequip = function(player, args)
	local p = DataService.Profiles[player]
	if not table.find(Config.Slots, args.slot) then return err("Bad slot") end
	p.equipped[args.slot] = nil
	return okp(player, { msg = args.slot .. " slot emptied" })
end

A.SelectKart = function(player, args)
	local p = DataService.Profiles[player]
	if not Config.GetKart(args.id) then return err("Unknown kart") end
	p.selectedKart = args.id
	return okp(player, { msg = Config.GetKart(args.id).name .. " set for next race" })
end

A.Favorite = function(player, args)
	local p = DataService.Profiles[player]
	if not Config.GetKart(args.id) then return err("Unknown kart") end
	p.favorites[args.id] = (args.on == true) or nil
	return okp(player)
end

A.BuyDriver = function(player, args)
	local p = DataService.Profiles[player]
	local d = Config.GetDriver(args.id)
	if not d then return err("Unknown driver") end
	if p.drivers[d.id] then return err("Already owned") end
	if p.coins < d.price then return err("Not enough Coins: need " .. Config.FormatNumber(d.price - p.coins) .. " more") end
	p.coins -= d.price
	p.drivers[d.id] = true
	p.rentals[d.id] = nil
	return okp(player, { msg = d.name .. " joined your team permanently" })
end

A.RentDriver = function(player, args)
	local p = DataService.Profiles[player]
	local d = Config.GetDriver(args.id)
	if not d then return err("Unknown driver") end
	if p.drivers[d.id] then return err("Already owned permanently") end
	if (p.rentals[d.id] or 0) > os.time() then return err("Rental already active") end
	if p.coins < d.rent then return err("Not enough Coins: need " .. Config.FormatNumber(d.rent - p.coins) .. " more") end
	p.coins -= d.rent
	p.rentals[d.id] = os.time() + Config.RentalSeconds
	return okp(player, { msg = d.name .. " rented for 10 minutes" })
end

A.SelectDriver = function(player, args)
	local p = DataService.Profiles[player]
	local d = Config.GetDriver(args.id)
	if not d then return err("Unknown driver") end
	if not ownsDriver(p, d.id) then return err("Buy or rent " .. d.name .. " first") end
	p.selectedDriver = d.id
	return okp(player, { msg = d.name .. " is your driver" })
end

local function validLivery(l: any): any?
	if type(l) ~= "table" then return nil end
	local function isSwatch(n: any) for _, s in ipairs(Config.Swatches) do if s.name == n then return true end end return false end
	local function isDecal(n: any) for _, s in ipairs(Config.Decals) do if s.id == n then return true end end return false end
	if not isSwatch(l.body) or not isSwatch(l.accent) or not table.find(Config.Shades, l.shade) or not isDecal(l.decal) then return nil end
	return { body = l.body, accent = l.accent, shade = l.shade, decal = l.decal }
end

A.SaveLivery = function(player, args)
	local p = DataService.Profiles[player]
	local l = validLivery(args.livery)
	if not l then return err("Invalid design") end
	p.livery = l
	local saved = table.clone(l)
	saved.name = "Design " .. tostring(#p.designs + 1)
	table.insert(p.designs, 1, saved)
	while #p.designs > 6 do table.remove(p.designs) end
	return okp(player, { msg = "Design saved" })
end

A.Upgrade = function(player, args)
	local p = DataService.Profiles[player]
	if not Config.GetKart(args.kart) then return err("Unknown kart") end
	if not table.find(Config.UpgradeStats, args.stat) then return err("Unknown stat") end
	p.upgrades[args.kart] = p.upgrades[args.kart] or { speed = 0, handling = 0, boost = 0 }
	local u = p.upgrades[args.kart]
	local lvl = u[args.stat] or 0
	if lvl >= Config.UpgradeMax then return err("Already at maximum level") end
	local c, g = Config.UpgradeCost(lvl)
	if p.coins < c or p.gems < g then
		return err(string.format("Not enough funds: need %s Coins and %d Gems", Config.FormatNumber(c), g))
	end
	p.coins -= c
	p.gems -= g
	u[args.stat] = lvl + 1
	return okp(player, { msg = string.format("%s upgraded to level %d", args.stat, lvl + 1) })
end

local function rollRarity(odds: any): string
	local total = 0
	for _, r in ipairs({ "Common", "Rare", "Epic", "Legendary" }) do total += odds[r] end
	local x = math.random() * total
	for _, r in ipairs({ "Common", "Rare", "Epic", "Legendary" }) do
		x -= odds[r]
		if x <= 0 then return r end
	end
	return "Common"
end

A.OpenCrate = function(player, args)
	local p = DataService.Profiles[player]
	local crate
	for _, c in ipairs(Config.Crates) do if c.id == args.id then crate = c end end
	if not crate then return err("Unknown crate") end
	local usedFree = false
	if crate.id == "basic" and p.freeCrates > 0 then
		p.freeCrates -= 1
		usedFree = true
	else
		local bal = crate.currency == "Gems" and p.gems or p.coins
		if bal < crate.price then return err("Not enough " .. crate.currency) end
		if crate.currency == "Gems" then p.gems -= crate.price else p.coins -= crate.price end
	end
	local cards = {}
	for _ = 1, crate.cards do
		local rarity = rollRarity(crate.odds)
		local pool = {}
		for _, c in ipairs(Config.Cards) do if c.rarity == rarity then table.insert(pool, c) end end
		local card = pool[math.random(1, #pool)]
		local isNew = (p.collection[card.id] or 0) == 0
		p.collection[card.id] = (p.collection[card.id] or 0) + 1
		table.insert(cards, { id = card.id, isNew = isNew })
	end
	return okp(player, { cards = cards, usedFree = usedFree })
end

A.ClaimDaily = function(player)
	local p = DataService.Profiles[player]
	local st = DataService.DailyStatus(p)
	if not st.ready then return err("Already claimed today") end
	local reward = Config.Daily[st.nextDay]
	p.daily.streak = st.nextDay
	p.daily.lastDay = today()
	p.daily.missed = st.missed
	DataService.Grant(p, reward)
	return okp(player, { msg = "Day " .. st.nextDay .. " reward claimed", day = st.nextDay })
end

local codeLimits: { [Player]: any } = {}
A.Redeem = function(player, args)
	local p = DataService.Profiles[player]
	local lim = codeLimits[player] or { fails = {}, lockedUntil = 0, busy = false }
	codeLimits[player] = lim
	local now = os.clock()
	if lim.lockedUntil > now then return { ok = false, code = "limited", retry = math.ceil(lim.lockedUntil - now), err = "Too many attempts" } end
	if lim.busy then return { ok = false, code = "busy", err = "Still checking your last code" } end
	local raw = type(args.code) == "string" and args.code or ""
	local code = string.upper((raw:gsub("^%s+", ""):gsub("%s+$", "")))
	if code == "" then return { ok = false, code = "empty", err = "Enter a code first" } end
	lim.busy = true
	task.wait(0.6) -- server verification time
	lim.busy = false
	local function fail(kind: string, msg: string): any
		table.insert(lim.fails, now)
		local recent = 0
		for _, t in ipairs(lim.fails) do if now - t < 30 then recent += 1 end end
		if recent >= 3 then
			lim.lockedUntil = os.clock() + 20
			lim.fails = {}
			return { ok = false, code = "limited", retry = 20, err = msg .. " · too many attempts" }
		end
		return { ok = false, code = kind, err = msg }
	end
	local def = Config.Codes[code]
	if not def then return fail("invalid", "That code doesn't exist") end
	if def.expires < os.time() then return fail("expired", "That code has expired") end
	if p.codesUsed[code] then return fail("used", "You already redeemed " .. code) end
	p.codesUsed[code] = true
	DataService.Grant(p, def)
	local parts = {}
	if def.coins then table.insert(parts, Config.FormatNumber(def.coins) .. " Coins") end
	if def.gems then table.insert(parts, def.gems .. " Gems") end
	return okp(player, { code = "success", msg = code .. " redeemed: " .. table.concat(parts, " + ") })
end

A.BuyPerk = function(player, args)
	local p = DataService.Profiles[player]
	local perk
	for _, k in ipairs(Config.Perks) do if k.id == args.id then perk = k end end
	if not perk then return err("Unknown boost") end
	if (p.perks[perk.id] or 0) > os.time() then return err(perk.name .. " is already active") end
	if p.gems < perk.price then return err("Not enough Gems: need " .. (perk.price - p.gems) .. " more") end
	p.gems -= perk.price
	p.perks[perk.id] = os.time() + perk.seconds
	return okp(player, { msg = perk.name .. " active for 15 minutes" })
end

A.BuyOffer = function(player)
	local p = DataService.Profiles[player]
	local o = Config.Offer
	if p.offer.bought then return err("Offer already purchased") end
	if os.time() >= p.offer.expires then return err("Offer has expired") end
	if p.gems < o.price then return err("Not enough Gems: need " .. (o.price - p.gems) .. " more") end
	p.gems -= o.price
	p.offer.bought = true
	DataService.Grant(p, { coins = o.coins, gems = o.gems })
	p.owned[o.part] = true
	return okp(player, { msg = o.name .. " claimed" })
end

A.ClaimQuest = function(player, args)
	local p = DataService.Profiles[player]
	local q
	for _, x in ipairs(Config.Quests) do if x.id == args.id then q = x end end
	if not q then return err("Unknown quest") end
	if p.quests[q.id] then return err("Already claimed") end
	if (p.stats[q.stat] or 0) < q.goal then return err("Quest not complete yet") end
	p.quests[q.id] = true
	DataService.Grant(p, { coins = q.coins, gems = q.gems })
	return okp(player, { msg = q.name .. " reward claimed" })
end

-- Mechanic job
A.MechAccept = function(player)
	local p = DataService.Profiles[player]
	if p.mech.state ~= "none" then return err("Job already taken") end
	p.mech.state = "active"
	p.mech.scrap = {}
	return okp(player, { msg = "Job accepted: find 3 glowing scrap cells" })
end
A.MechDecline = function(player)
	return { ok = true }
end
A.CollectScrap = function(player, args)
	local p = DataService.Profiles[player]
	if p.mech.state ~= "active" then return err("No active job") end
	local idx = tonumber(args.index)
	local scrap = idx and workspace.World.Hub.Scrap:FindFirstChild("Scrap" .. idx)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not scrap or not root then return err("Nothing here") end
	if (root.Position - (scrap :: BasePart).Position).Magnitude > 14 then return err("Too far away") end
	if p.mech.scrap[tostring(idx)] then return err("Already collected") end
	p.mech.scrap[tostring(idx)] = true
	local n = 0
	for _ in pairs(p.mech.scrap) do n += 1 end
	if n >= Config.Mechanic.scrapCount then p.mech.state = "ready" end
	return okp(player, { msg = string.format("Scrap cell %d/%d", n, Config.Mechanic.scrapCount) })
end
A.MechTurnIn = function(player)
	local p = DataService.Profiles[player]
	if p.mech.state ~= "ready" then return err("Job not finished") end
	p.mech.state = "done"
	DataService.Grant(p, { coins = Config.Mechanic.rewardCoins, gems = Config.Mechanic.rewardGems })
	return okp(player, { msg = string.format("Gizmo paid you %d Coins + %d Gems", Config.Mechanic.rewardCoins, Config.Mechanic.rewardGems) })
end

-- Party (demo friends simulate replies)
A.Invite = function(player, args)
	local p = DataService.Profiles[player]
	local f
	for _, x in ipairs(Config.DemoFriends) do if x.id == args.id then f = x end end
	if not f then return err("Unknown friend") end
	if f.status == "Offline" then return err(f.name .. " is offline") end
	local cur = p.party.invites[f.id]
	if cur == "pending" then return err("Invite already pending") end
	if cur == "accepted" then return err(f.name .. " is already in your party") end
	p.party.invites[f.id] = "pending"
	task.delay(f.status == "Racing" and 6 or 3, function()
		if DataService.Profiles[player] ~= p or p.party.invites[f.id] ~= "pending" then return end
		if f.reply == "accept" then
			p.party.invites[f.id] = "accepted"
			p.party.members[f.id] = true
			DataService.Notify(player, f.name .. " accepted your invite", "good")
		else
			p.party.invites[f.id] = "declined"
			DataService.Notify(player, f.name .. " declined your invite", "warn")
		end
		DataService.MarkDirty(player)
	end)
	return okp(player, { msg = "Invite sent to " .. f.name })
end
A.Kick = function(player, args)
	local p = DataService.Profiles[player]
	if not p.party.members[args.id] then return err("Not in party") end
	p.party.members[args.id] = nil
	p.party.invites[args.id] = nil
	return okp(player, { msg = "Removed from party" })
end

A.SaveSettings = function(player, args)
	local p = DataService.Profiles[player]
	local s = args.settings
	if type(s) ~= "table" then return err("Invalid settings") end
	local clean = table.clone(p.settings)
	if type(s.music) == "number" then clean.music = math.clamp(math.floor(s.music * 10 + 0.5) / 10, 0, 1) end
	if type(s.sfx) == "number" then clean.sfx = math.clamp(math.floor(s.sfx * 10 + 0.5) / 10, 0, 1) end
	if type(s.damageNumbers) == "boolean" then clean.damageNumbers = s.damageNumbers end
	if type(s.cameraShake) == "boolean" then clean.cameraShake = s.cameraShake end
	if s.graphics == "Low" or s.graphics == "Medium" or s.graphics == "High" then clean.graphics = s.graphics end
	if s.textScale == 1 or s.textScale == 1.15 or s.textScale == 1.3 then clean.textScale = s.textScale end
	if type(s.reducedMotion) == "boolean" then clean.reducedMotion = s.reducedMotion end
	p.settings = clean
	return okp(player, { settings = clean })
end
A.ResetSettings = function(player)
	local p = DataService.Profiles[player]
	p.settings = table.clone(Config.DefaultSettings)
	return okp(player, { settings = p.settings })
end
A.Tutorial = function(player, args)
	local p = DataService.Profiles[player]
	if args.state ~= "done" and args.state ~= "skipped" then return err("bad state") end
	p.tutorial = args.state
	return okp(player)
end
A.DriftBoost = function(player)
	-- counted by RaceService while racing; harmless no-op otherwise
	return { ok = true }
end

-- periodic: rental expiry
task.spawn(function()
	while true do
		task.wait(1)
		local now = os.time()
		for player, p in pairs(DataService.Profiles) do
			for id, exp in pairs(p.rentals) do
				if exp <= now then
					p.rentals[id] = nil
					local d = Config.GetDriver(id)
					if p.selectedDriver == id then p.selectedDriver = "d_pip" end
					DataService.Notify(player, (d and d.name or "Driver") .. " rental expired", "warn")
					DataService.MarkDirty(player)
				end
			end
		end
	end
end)

function DataService.Load(player: Player)
	local p = newProfile()
	local loaded = false
	if storeOk and store then
		local ok, data = pcall(function() return store:GetAsync("u_" .. player.UserId) end)
		if ok and type(data) == "table" then
			for k, v in pairs(data) do if p[k] ~= nil then p[k] = v end end
			loaded = true
			saveState[player] = { state = "saved", text = "Loaded saved progress" }
		elseif not ok then
			saveState[player] = { state = "failed", text = "Session only · cloud save unavailable" }
		end
	else
		saveState[player] = { state = "failed", text = "Session only · cloud save unavailable" }
	end
	if not saveState[player] then saveState[player] = { state = "saved", text = loaded and "Loaded" or "New profile" } end
	DataService.Profiles[player] = p
	DataService.Push(player)
end

Players.PlayerRemoving:Connect(function(player)
	if dirty[player] then trySave(player) end
	DataService.Profiles[player] = nil
	saveState[player] = nil
	dirty[player] = nil
	codeLimits[player] = nil
end)

return DataService
