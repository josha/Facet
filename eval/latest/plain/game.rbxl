					<ProtectedString name="Source"><![CDATA[--!strict
-- Server-owned player data. Every balance, ownership and progression change goes through here.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local Remotes = RS:WaitForChild("Remotes")

local Profiles = {}
local data: { [Player]: any } = {}
local store: DataStore? = nil
local storeOk = false
do
	local ok, res = pcall(function()
		return DataStoreService:GetDataStore("NeonDriftLeague_v1")
	end)
	if ok then store = res end
end

local function now(): number
	return workspace:GetServerTimeNow()
end
Profiles.now = now

local function defaultSettings()
	return { music = 60, sfx = 80, damageNumbers = true, cameraShake = true, graphics = "High", textSize = "Default", reducedMotion = false }
end
Profiles.defaultSettings = defaultSettings

local function newProfile(): any
	local quests = {}
	for _, q in Config.Quests do quests[q.id] = { progress = 0, claimed = false } end
	local upgrades = {}
	for _, k in Config.Karts do upgrades[k.id] = { speed = 0, handling = 0, boost = 0 } end
	return {
		soft = 1500, hard = 20, xp = 0, totalXp = 0, level = 1, races = 0, wins = 0, lastIncome = 0,
		ownedParts = {}, equipped = {},
		selectedKart = "volt", favorites = {},
		upgrades = upgrades,
		ownedDrivers = { kai = true }, rentals = {}, selectedDriver = "kai",
		livery = table.clone(Config.DefaultLivery),
		freeCrates = 1, collection = {}, cratesOpened = 0,
		daily = { streak = 0, lastDay = -1, notice = "" },
		codesUsed = {},
		boosts = {},
		quests = quests,
		offer = { expiresAt = now() + Config.Offer.seconds, bought = false },
		job = { state = "none", bolts = {} },
		settings = defaultSettings(),
		tutorial = "new",
		party = { members = {}, invites = {} },
		save = { cloud = false, state = "session", message = "Progress is kept for this server session only (cloud save unavailable)." },
	}
end

local function merge(base: any, saved: any): any
	for k, v in saved do
		if type(v) == "table" and type(base[k]) == "table" then
			merge(base[k], v)
		else
			base[k] = v
		end
	end
	return base
end

function Profiles.get(player: Player): any
	return data[player]
end

function Profiles.snapshot(player: Player)
	local p = data[player]
	if not p then return end
	p.serverTime = now()
	Remotes.Profile:FireClient(player, p)
end

local saveQueued: { [Player]: boolean } = {}
local function persist(player: Player)
	local p = data[player]
	if not p then return end
	if not (store and storeOk) then
		p.save.state = "session"
		p.save.message = "Saved for this session. Cloud save is unavailable here, so progress resets when the server closes."
		return
	end
	p.save.state = "saving"
	local copy = table.clone(p)
	copy.party = nil
	copy.serverTime = nil
	local ok, err = pcall(function()
		(store :: DataStore):SetAsync("u" .. player.UserId, copy)
	end)
	if not data[player] then return end
	if ok then
		p.save.state = "saved"
		p.save.message = "Saved to the cloud."
	else
		p.save.state = "failed"
		p.save.message = "Cloud save failed: " .. tostring(err)
	end
	Profiles.snapshot(player)
end

-- Mark the profile changed: snapshot now, persist soon.
function Profiles.changed(player: Player)
	Profiles.snapshot(player)
	if saveQueued[player] then return end
	saveQueued[player] = true
	task.delay(3, function()
		saveQueued[player] = nil
		persist(player)
	end)
end

function Profiles.load(player: Player)
	local p = newProfile()
	if store then
		local ok, saved = pcall(function()
			return (store :: DataStore):GetAsync("u" .. player.UserId)
		end)
		if ok then
			storeOk = true
			p.save.cloud = true
			p.save.state = "saved"
			p.save.message = "Cloud save connected."
			if type(saved) == "table" then
				merge(p, saved)
				p.party = { members = {}, invites = {} }
				p.save.cloud = true
				p.save.state = "saved"
				p.save.message = "Loaded your saved progress."
			end
		end
	end
	data[player] = p
	Profiles.refreshTimed(player)
	Profiles.snapshot(player)
end

function Profiles.unload(player: Player)
	persist(player)
	data[player] = nil
end

-- Wallet ---------------------------------------------------------------
function Profiles.canAfford(p: any, soft: number, hard: number): boolean
	return p.soft >= soft and p.hard >= hard
end
function Profiles.spend(p: any, soft: number, hard: number): boolean
	if soft < 0 or hard < 0 then return false end
	if not Profiles.canAfford(p, soft, hard) then return false end
	p.soft -= soft
	p.hard -= hard
	return true
end
function Profiles.grant(p: any, soft: number?, hard: number?)
	p.soft += math.max(0, soft or 0)
	p.hard += math.max(0, hard or 0)
end
function Profiles.addXp(p: any, amount: number)
	p.xp += amount
	p.totalXp += amount
	while p.xp >= Config.xpForLevel(p.level) do
		p.xp -= Config.xpForLevel(p.level)
		p.level += 1
	end
end
function Profiles.questProgress(p: any, id: string, amount: number)
	local q = p.quests[id]
	if not q or q.claimed then return end
	for _, def in Config.Quests do
		if def.id == id then
			q.progress = math.min(def.goal, q.progress + amount)
		end
	end
end

-- Timed state: rentals, boosts.
function Profiles.refreshTimed(player: Player): boolean
	local p = data[player]
	if not p then return false end
	local t = now()
	local changed = false
	for id, exp in p.rentals do
		if t >= exp then
			p.rentals[id] = nil
			changed = true
			if p.selectedDriver == id and not p.ownedDrivers[id] then
				p.selectedDriver = "kai"
				Remotes.Notify:FireClient(player, { kind = "toast", text = "Your " .. ((Config.getDriver(id) :: any).name) .. " rental expired. Kai is back in the seat.", tone = "warn" })
			end
		end
	end
	for id, exp in p.boosts do
		if t >= exp then
			p.boosts[id] = nil
			changed = true
		end
	end
	return changed
end

function Profiles.hasDriver(p: any, id: string): boolean
	if p.ownedDrivers[id] then return true end
	local exp = p.rentals[id]
	return exp ~= nil and now() < exp
end

-- Loadout stats for the race simulation.
function Profiles.loadout(p: any, kartId: string?): any
	local kart = Config.getKart(kartId or p.selectedKart) or Config.Karts[1]
	local up = p.upgrades[kart.id] or { speed = 0, handling = 0, boost = 0 }
	local sp, ha, bo = up.speed * Config.UpgradeStep, up.handling * Config.UpgradeStep, up.boost * Config.UpgradeStep
	local cosmetics = {}
	for _, slot in Config.Slots do
		local partId = p.equipped[slot]
		local part = partId and Config.getPart(partId)
		if part then
			sp += part.speed or 0
			ha += part.handling or 0
			bo += part.boost or 0
			if part.glow then cosmetics[part.glow] = true end
		end
	end
	local driver = Config.getDriver(p.selectedDriver)
	if driver and Profiles.hasDriver(p, driver.id) then
		sp += driver.speed; ha += driver.handling; bo += driver.boost
	end
	return { kart = kart, speedMul = 1 + sp, handlingMul = 1 + ha, boostMul = 1 + bo, livery = p.livery, cosmetics = cosmetics, driver = if driver then driver.name else "Kai" }
end

Players.PlayerRemoving:Connect(function(player)
	Profiles.unload(player)
end)
game:BindToClose(function()
	for _, player in Players:GetPlayers() do
		persist(player)
	end
end)

task.spawn(function()
	while true do
		task.wait(1)
		for player in data do
			if Profiles.refreshTimed(player) then
				Profiles.changed(player)
			end
		end
	end
end)

return Profiles
]]></ProtectedString>
					<string name="ScriptGuid">{AF0A58FD-B808-45AC-ADA9-CB2E6EB5D255}</string>
