local resultsBox=frame(root,UDim2.new(.84,0,.63,0),UDim2.fromScale(.5,.5),palette.bg);resultsBox.AnchorPoint=Vector2.new(.5,.5);corner(resultsBox,16);stroke(resultsBox,palette.cyan);resultsBox.Visible=false;resultsBox.ZIndex=25
local resultList=frame(resultsBox,UDim2.new(1,-36,1,-32),UDim2.fromOffset(18,16));resultList.BackgroundTransparency=1;list(resultList,8)
