				</Item>
				<Item class="ModuleScript" referent="RBX2AA34DED525E453FA201447F74938877">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Mechanic conversation, scrap job pickups, tutorial and settings application.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CAS = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local U = require(script.Parent.Util)
local Config = U.Config
local T = U.T
local player = Players.LocalPlayer

return function(App: any)
	-- ================= Settings application =================
	local musicGroup = SoundService:FindFirstChild("Music") :: SoundGroup?
	local sfxGroup = SoundService:FindFirstChild("Effects") :: SoundGroup?
	App.ApplySettings = function(s: any)
		if musicGroup then musicGroup.Volume = s.music end
		if sfxGroup then sfxGroup.Volume = s.sfx end
		local bloom = Lighting:FindFirstChild("Bloom") :: BloomEffect?
		if bloom then bloom.Enabled = s.graphics ~= "Low"; bloom.Intensity = s.graphics == "High" and 0.9 or 0.5 end
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm then atm.Density = s.graphics == "Low" and 0.15 or 0.32 end
		Lighting.GlobalShadows = s.graphics == "High"
		U.ReducedMotion = s.reducedMotion or GuiService.ReducedMotionEnabled
		if U.TextScale ~= s.textScale then
			U.ApplyTextScale(s.textScale)
			App.Layout()
		end
	end

	-- ================= Mechanic =================
	local mech = workspace:WaitForChild("World"):WaitForChild("Hub"):WaitForChild("Mechanic")
	local torso = mech:WaitForChild("Torso") :: BasePart
	local dlg = U.new("Frame", { Name = "MechanicDialog", BackgroundColor3 = T.Bg, BackgroundTransparency = 0.05, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -150), Size = UDim2.new(0.9, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, Parent = App.Gui })
	U.new("UISizeConstraint", { MaxSize = Vector2.new(560, 500), Parent = dlg })
	U.corner(dlg, 14); U.stroke(dlg, T.Green, 2); U.pad(dlg, 14)
	U.list(dlg, Enum.FillDirection.Vertical, 8)
	local talking = false
	local asked = false
	local function endTalk(msg: string?)
		if not talking then return end
		talking = false
		dlg.Visible = false
		CAS:UnbindAction("NeonMechBack")
		GuiService.SelectedObject = nil
		if msg then U.Toast(msg, "info") end
	end
	local renderDlg
	renderDlg = function(line: string?)
		U.clear(dlg)
		local p = U.Store.profile
		local st = p.mech.state
		U.label(dlg, "🔧 GIZMO · Mechanic", 15, T.Green, { Font = Enum.Font.GothamBlack, LayoutOrder = 1 })
		local n = 0
		for _ in pairs(p.mech.scrap) do n += 1 end
		local text = line
		if not text then
			if st == "none" then
				text = "Hey racer! Three of my scrap cells rolled off the bench and they're glowing around the hub. Bring them back?"
			elseif st == "active" then
				text = string.format("Found %d of %d cells so far. They glow green near the hub's edges.", n, Config.Mechanic.scrapCount)
			elseif st == "ready" then
				text = "You found them all! Hand them over and I'll pay up."
			else
				text = "Thanks again, racer. Your kart's purring like a plasma kitten."
			end
		end
		U.label(dlg, text, 16, T.Text, { LayoutOrder = 2 })
		local opts = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = dlg })
		U.new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 44), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = opts })
		local first: GuiObject? = nil
		local function opt(label: string, order: number, fn: () -> (), primary: boolean?)
			local b = U.btn(opts, label, { name = "Opt" .. order, order = order, primary = primary, color = T.Green, textSize = 14 })
			b.Activated:Connect(fn)
			if not first then first = b end
		end
		if st == "none" then
			if not asked then
				opt("What's in it for me?", 1, function() asked = true; renderDlg(string.format("I'll pay 💰 %d Coins + 💎 %d Gems. One-time job, honest pay.", Config.Mechanic.rewardCoins, Config.Mechanic.rewardGems)) end)
			end
			opt("Accept job", 2, function()
				local r = U.Request("MechAccept")
				if r.ok then U.Toast(r.msg, "good") else U.Toast(r.err, "bad") end
				task.wait()
				renderDlg()
			end, true)
			opt("Decline", 3, function()
				U.Request("MechDecline")
				renderDlg("No worries. Come back if you change your mind.")
			end)
		elseif st == "ready" then
			opt("Hand over cells", 1, function()
				local r = U.Request("MechTurnIn")
				if r.ok then U.Toast(r.msg, "good") else U.Toast(r.err, "bad") end
				task.wait()
				renderDlg()
			end, true)
		end
		opt("Leave", 9, function() endTalk() end)
		task.defer(function() U.Focus(first) end)
	end
	local prompt = torso:WaitForChild("Talk") :: ProximityPrompt
	prompt.Triggered:Connect(function()
		if U.Store.driving or not U.Store.profile then return end
		App.RequestClose()
		talking = true
		asked = false
		dlg.Visible = true
		renderDlg()
		CAS:BindActionAtPriority("NeonMechBack", function(_, s)
			if s == Enum.UserInputState.Begin then endTalk() end
			return Enum.ContextActionResult.Sink
		end, false, 2900, Enum.KeyCode.ButtonB)
	end)
	U.On(function(kind)
		if kind == "profile" and talking then renderDlg() end
		if kind == "layout" then
			dlg.Position = UDim2.new(0.5, 0, 1, U.Layout.topNav and -170 or -24)
		end
	end)

	-- scrap pickups (visible locally while the job is active)
	local scrapFolder = workspace.World.Hub:WaitForChild("Scrap")
	local requesting: { [number]: boolean } = {}
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.25 then return end
		acc = 0
		local p = U.Store.profile
		if not p then return end
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if talking and root and (root.Position - torso.Position).Magnitude > 18 then
			endTalk("Gizmo: \"Come back anytime!\" · conversation ended")
		end
		for _, s in ipairs(scrapFolder:GetChildren()) do
			if s:IsA("BasePart") then
				local i = s:GetAttribute("ScrapIndex") :: number
				local active = p.mech.state == "active" and not p.mech.scrap[tostring(i)]
				s.Transparency = active and 0 or 1
				local l = s:FindFirstChildOfClass("PointLight")
				if l then l.Enabled = active end
				if active then
					s.CFrame *= CFrame.Angles(0, 0.3, 0)
					if root and (root.Position - s.Position).Magnitude < 9 and not requesting[i] then
						requesting[i] = true
						task.spawn(function()
							local r = U.Request("CollectScrap", { index = i })
							if r.ok then U.Toast("🔧 " .. r.msg, "good") end
							requesting[i] = nil
						end)
					end
				end
			end
		end
	end)

	-- ================= Tutorial =================
	local steps = {
		{ title = "Welcome, racer!", text = "Race the neon circuits, earn Coins and Gems, then improve your kart and race again.", target = nil },
		{ title = "Pick your kart", text = "Open the Garage to compare karts, test drive one and choose it for your next race.", target = "Garage" },
		{ title = "Gear up", text = "The Shop sells motors, boosts, wheels and cosmetics. Equip them from Inventory.", target = "Shop" },
		{ title = "Hit the grid", text = "Open Race to join the queue, vote for a track and race AI opponents.", target = "Race" },
	}
	local tut = { active = false, step = 1, opener = nil :: GuiObject? }
	local card = U.new("Frame", { Name = "Tutorial", BackgroundColor3 = T.Panel, Size = UDim2.fromOffset(320, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 10, Parent = App.ModalGui })
	U.corner(card, 14); U.stroke(card, T.Gold, 2); U.pad(card, 14)
	U.list(card, Enum.FillDirection.Vertical, 8)
	local tutHead = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 1, ZIndex = 11, Parent = card })
	local stepLbl = U.label(tutHead, "", 12, T.Gold, { Font = Enum.Font.GothamBold, Size = UDim2.new(1, -44, 1, 0), AutomaticSize = Enum.AutomaticSize.None, ZIndex = 11 })
	local titleLbl = U.label(card, "", 19, T.Text, { Font = Enum.Font.GothamBlack, LayoutOrder = 2, ZIndex = 11 })
	local textLbl = U.label(card, "", 14, T.Sub, { LayoutOrder = 3, ZIndex = 11 })
	local hintLbl = U.label(card, "", 12, T.Cyan, { LayoutOrder = 4, ZIndex = 11 })
	local row = U.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), LayoutOrder = 5, ZIndex = 11, Parent = card })
	U.list(row, Enum.FillDirection.Horizontal, 6)
	local skipB = U.btn(row, "Skip", { name = "TutSkip", order = 1, size = UDim2.new(0.28, -4, 1, 0), textSize = 14 })
	local backB = U.btn(row, "Back", { name = "TutBack", order = 2, size = UDim2.new(0.32, -4, 1, 0), textSize = 14 })
	local nextB = U.btn(row, "Next", { name = "TutNext", order = 3, size = UDim2.new(0.4, -4, 1, 0), primary = true, color = T.Gold, textSize = 14 })
	local closeT = U.btn(tutHead, "✖", { name = "TutClose", size = UDim2.fromOffset(36, 36), textSize = 14 })
	closeT.Position = UDim2.new(1, -36, 0, -4)
	for _, b in ipairs({ skipB, backB, nextB, closeT }) do b.ZIndex = 12 end
	-- highlight ring around the real button; it never blocks input
	local ringF = U.new("Frame", { Name = "TutorialRing", BackgroundTransparency = 1, Active = false, Interactable = false, Visible = false, ZIndex = 9, Parent = App.ModalGui })
	local ringStroke = U.stroke(ringF, T.Gold, 3)
	U.corner(ringF, 12)
	local arrow = U.label(App.ModalGui, "◀", 30, T.Gold, { Name = "TutorialArrow", Size = UDim2.fromOffset(34, 34), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, Visible = false, ZIndex = 9, Interactable = false })

	local function finish(state: string)
		tut.active = false
		card.Visible = false
		ringF.Visible = false
		arrow.Visible = false
		CAS:UnbindAction("NeonTutBack")
		task.spawn(U.Request, "Tutorial", { state = state })
		local o = tut.opener
		tut.opener = nil
		if o and o.Parent then U.Focus(o) else GuiService.SelectedObject = nil end
	end
	local function render()
		local s = steps[tut.step]
		stepLbl.Text = string.format("STEP %d OF %d", tut.step, #steps)
		titleLbl.Text = s.title
		textLbl.Text = s.text
		hintLbl.Text = s.target and ("Try it: press the highlighted " .. s.target .. " button. You'll come back to this step.") or ""
		U.setEnabled(backB, tut.step > 1)
		nextB.Text = tut.step == #steps and "Finish" or "Next"
	end
	local function back()
		if tut.step > 1 then tut.step -= 1; render() else finish("skipped") end
	end
	nextB.Activated:Connect(function()
		if tut.step >= #steps then finish("done") else tut.step += 1; render() end
	end)
	backB.Activated:Connect(function() if tut.step > 1 then tut.step -= 1; render() end end)
	skipB.Activated:Connect(function() finish("skipped") end)
	closeT.Activated:Connect(back)

	App.StartTutorial = function(from: GuiObject?)
		if U.Store.driving then return end
		App.RequestClose()
		tut.active = true
		tut.step = 1
		tut.opener = from
		render()
		CAS:BindActionAtPriority("NeonTutBack", function(_, st)
			if st ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
			if App.CurrentPanel() or App.IsConfirmOpen() or not card.Visible then return Enum.ContextActionResult.Pass end
			back()
			return Enum.ContextActionResult.Sink
		end, false, 2500, Enum.KeyCode.ButtonB)
		task.defer(function() U.Focus(nextB) end)
	end

	RunService.RenderStepped:Connect(function()
		if not tut.active then return end
		local hidden = App.CurrentPanel() ~= nil or U.Store.driving
		card.Visible = not hidden
		local s = steps[tut.step]
		local target = s.target and App.NavButtons[s.target]
		local vp = U.Layout
		local inset = App.ModalGui.AbsolutePosition
		if hidden or not target or not target.Visible or not App.Nav.Visible then
			ringF.Visible = false
			arrow.Visible = false
			card.AnchorPoint = Vector2.new(0.5, 0.5)
			card.Position = UDim2.fromScale(0.5, 0.5)
			return
		end
		-- keep the highlighted button scrolled into view
		local nav = App.Nav :: ScrollingFrame
		local tp = target.AbsolutePosition - nav.AbsolutePosition
		if U.Layout.topNav then
			if tp.X < 0 or tp.X + target.AbsoluteSize.X > nav.AbsoluteSize.X then
				nav.CanvasPosition = Vector2.new(math.max(0, nav.CanvasPosition.X + tp.X - 20), 0)
			end
		elseif tp.Y < 0 or tp.Y + target.AbsoluteSize.Y > nav.AbsoluteSize.Y then
			nav.CanvasPosition = Vector2.new(0, math.max(0, nav.CanvasPosition.Y + tp.Y - 20))
		end
		local pos = target.AbsolutePosition - inset
		local size = target.AbsoluteSize
		ringF.Visible = true
		ringF.Position = UDim2.fromOffset(pos.X - 4, pos.Y - 4)
		ringF.Size = UDim2.fromOffset(size.X + 8, size.Y + 8)
		ringStroke.Transparency = U.ReducedMotion and 0 or (0.3 + 0.3 * math.sin(os.clock() * 5))
		arrow.Visible = true
		local cw = math.min(320, vp.w - 24)
		card.Size = UDim2.fromOffset(cw, 0)
		if U.Layout.topNav then
			arrow.Text = "▲"
			arrow.Position = UDim2.fromOffset(pos.X + size.X / 2 - 17, pos.Y + size.Y + 6)
			card.AnchorPoint = Vector2.new(0, 0)
			local x = math.clamp(pos.X + size.X / 2 - cw / 2, 8, vp.w - cw - 8)
			card.Position = UDim2.fromOffset(x, pos.Y + size.Y + 42)
		else
			arrow.Text = "◀"
			arrow.Position = UDim2.fromOffset(pos.X + size.X + 6, pos.Y + size.Y / 2 - 17)
			card.AnchorPoint = Vector2.new(0, 0.5)
			local minY = App.Top.AbsoluteSize.Y + 14 + card.AbsoluteSize.Y / 2
			local y = math.clamp(pos.Y + size.Y / 2, minY, math.max(minY, vp.h - card.AbsoluteSize.Y / 2 - 8))
			card.Position = UDim2.fromOffset(pos.X + size.X + 44, y)
		end
	end)
	U.On(function(kind)
		if kind == "panelClosed" and tut.active then
			task.defer(function() U.Focus(nextB) end)
		end
	end)
	App.TutorialStep = function() return tut.active and tut.step or 0 end
end
]]></ProtectedString>
						<string name="ScriptGuid">{A67A3D67-1F37-4C4D-9B2A-23E19432B062}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Hub</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">516e08a84660d37b0af5982a00001723</UniqueId>
					</Properties>
