						<ProtectedString name="Source"><![CDATA[--!strict
-- Driving input, chase camera, race HUD, scoreboard, results, quick chat and impact feedback.
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local StarterPlayer = game:GetService("StarterPlayer")
local Remotes = RS:WaitForChild("Remotes")

return function(App: any)
	local UI = App.UI
	local T = UI.T
	local Config = App.Config
	local new = UI.new
	local gui = App.raceGui
	local root = new("Frame", { Name = "RaceRoot", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = gui })

	-- Native move action (keyboard WASD/arrows, left stick, touch thumbstick).
	local moveAction: any = nil
	task.spawn(function()
		local pm = StarterPlayer:WaitForChild("PlayerModule", 30)
		local ctx = pm and pm:WaitForChild("InputContexts", 30)
		local cc = ctx and ctx:WaitForChild("CharacterContext", 30)
		moveAction = cc and cc:WaitForChild("MoveAction", 30)
	end)

	-- Top-centre: position / lap / time
	local topBox = new("Frame", { Name = "RaceTop", BackgroundColor3 = T.panel, BackgroundTransparency = 0.15, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(0, 58), AutomaticSize = Enum.AutomaticSize.X, Parent = root })
	UI.corner(topBox, 14)
	UI.stroke(topBox, T.cyan, 2, 0.2)
	UI.pad(topBox, 4, 16)
	UI.list(topBox, Enum.FillDirection.Horizontal, 18).VerticalAlignment = Enum.VerticalAlignment.Center
	local function stat(caption: string, order: number): TextLabel
		local f = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 50), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = order, Parent = topBox })
		UI.label(f, caption, 11, { TextColor3 = T.muted, Size = UDim2.fromOffset(0, 14), AutomaticSize = Enum.AutomaticSize.X, FontFace = UI.F.bold, TextWrapped = false })
		local v = UI.label(f, "-", 24, { Position = UDim2.fromOffset(0, 14), Size = UDim2.fromOffset(0, 34), AutomaticSize = Enum.AutomaticSize.X, FontFace = UI.F.title, TextWrapped = false })
		return v
	end
	local posL = stat("POSITION", 1)
	local lapL = stat("LAP", 2)
	local timeL = stat("TIME", 3)
	posL.TextColor3 = T.magenta

	-- Top-left: track + feed
	local info = new("Frame", { Name = "RaceInfo", BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 6), Size = UDim2.fromOffset(250, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = root })
	UI.list(info, Enum.FillDirection.Vertical, 4)
	local trackL = UI.label(info, "", 14, { FontFace = UI.F.bold, LayoutOrder = 1 })
	local modeChip = UI.chip(info, "RACE", T.cyan, { LayoutOrder = 2 })
	local feedBox = new("Frame", { Name = "Feed", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = info })
	UI.list(feedBox, Enum.FillDirection.Vertical, 3)

	-- Right-top controls
	local ctrl = new("Frame", { Name = "RaceControls", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 6), Size = UDim2.fromOffset(0, 46), AutomaticSize = Enum.AutomaticSize.X, Parent = root })
	UI.list(ctrl, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right)
	local boardBtn = UI.button(ctrl, "Board [L]", { filled = false, size = UDim2.fromOffset(104, 44), textSize = 14, layoutOrder = 1, name = "BoardButton" })
	local chatBtn = UI.button(ctrl, "Chat [Q]", { filled = false, size = UDim2.fromOffset(98, 44), textSize = 14, layoutOrder = 2, color = T.magenta, name = "ChatButton" })
	local exitBtn = UI.button(ctrl, "Exit Test Drive", { size = UDim2.fromOffset(150, 44), textSize = 14, layoutOrder = 3, color = T.amber, name = "ExitButton" })

	-- Centre messages
	local bigL = UI.label(root, "", 96, { Name = "Countdown", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.fromOffset(500, 120), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, FontFace = UI.F.title, TextColor3 = T.cyan, Visible = false })
	UI.stroke(bigL, T.bg, 3, 0).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	local warnL = UI.label(root, "", 22, { Name = "Warn", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 74), Size = UDim2.fromOffset(420, 30), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, FontFace = UI.F.bold, TextColor3 = T.red, Visible = false })
	UI.stroke(warnL, T.bg, 2, 0).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	-- Bottom-centre: speed and boost
	local dash = new("Frame", { Name = "Dash", BackgroundColor3 = T.panel, BackgroundTransparency = 0.2, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.fromOffset(280, 64), Parent = root })
	UI.corner(dash, 12)
	UI.stroke(dash, T.violet, 1.5, 0.3)
	UI.pad(dash, 6, 12)
	local spdL = UI.label(dash, "0", 28, { FontFace = UI.F.title, Size = UDim2.fromOffset(90, 32), AutomaticSize = Enum.AutomaticSize.None })
	UI.label(dash, "SPEED", 10, { TextColor3 = T.muted, Position = UDim2.fromOffset(0, 34), Size = UDim2.fromOffset(90, 14), AutomaticSize = Enum.AutomaticSize.None, FontFace = UI.F.bold })
	local boostWrap = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(96, 0), Size = UDim2.new(1, -96, 1, 0), Parent = dash })
	local boostTitle = UI.label(boostWrap, "BOOST [E]", 11, { TextColor3 = T.amber, FontFace = UI.F.bold, Size = UDim2.new(1, 0, 0, 14), AutomaticSize = Enum.AutomaticSize.None })
	local boostBar = UI.bar(boostWrap, 0.6, T.amber, 10)
	boostBar.Position = UDim2.fromOffset(0, 16)
	local driftTitle = UI.label(boostWrap, "DRIFT [Space] to charge a turbo", 11, { TextColor3 = T.cyan, FontFace = UI.F.bold, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 14), AutomaticSize = Enum.AutomaticSize.None })
	local driftBar = UI.bar(boostWrap, 0, T.cyan, 6)
	driftBar.Position = UDim2.fromOffset(0, 46)

	-- Touch controls
	local touchBox = new("Frame", { Name = "TouchControls", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -150), Size = UDim2.fromOffset(190, 200), Visible = false, Parent = root })
	local function touchBtn(text: string, pos: UDim2, size: number, color: Color3): TextButton
		local b = new("TextButton", { Name = text, Text = text, AutoButtonColor = false, BackgroundColor3 = color, BackgroundTransparency = 0.25, TextColor3 = T.bg, FontFace = UI.F.bold, Size = UDim2.fromOffset(size, size), Position = pos, AnchorPoint = Vector2.new(0.5, 0.5), Parent = touchBox })
		UI.scaleText(b, 15)
		UI.corner(b, size // 2)
		UI.stroke(b, Color3.new(1, 1, 1), 2, 0.4)
		return b
	end
	local tDrift = touchBtn("DRIFT", UDim2.fromOffset(130, 140), 84, T.cyan)
	local tBoost = touchBtn("BOOST", UDim2.fromOffset(50, 80), 72, T.amber)
	local tGas = touchBtn("GAS", UDim2.fromOffset(140, 50), 64, T.green)
	local tRecover = touchBtn("RESET", UDim2.fromOffset(40, 170), 56, T.muted)

	-- Scoreboard
	local board = new("Frame", { Name = "Scoreboard", Visible = false, BackgroundColor3 = T.panel, BackgroundTransparency = 0.08, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 60), Size = UDim2.fromOffset(340, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = root })
	UI.corner(board, 12)
	UI.stroke(board, T.cyan, 2, 0.1)
	UI.pad(board, 10, 10)
	UI.list(board, Enum.FillDirection.Vertical, 6)
	local bh = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 0, Parent = board })
	UI.label(bh, "LIVE STANDINGS", 15, { FontFace = UI.F.title, TextColor3 = T.cyan, Size = UDim2.new(1, -90, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center })
	local boardClose = UI.button(bh, "Close", { filled = false, size = UDim2.fromOffset(80, 30), textSize = 13, color = T.muted, textColor = T.text })
	boardClose.Position = UDim2.new(1, -80, 0, 0)
	local boardRows = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = board })
	UI.list(boardRows, Enum.FillDirection.Vertical, 4)

	-- Results
	local results = new("Frame", { Name = "Results", Visible = false, BackgroundColor3 = T.panel, BackgroundTransparency = 0.03, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -24, 1, -24), Parent = root })
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(720, 620), Parent = results })
	UI.corner(results, 16)
	UI.stroke(results, T.magenta, 2, 0)
	UI.pad(results, 14, 16)
	local resTitle = UI.label(results, "RACE COMPLETE", 24, { FontFace = UI.F.title, TextColor3 = T.magenta, Size = UDim2.new(1, 0, 0, 34), AutomaticSize = Enum.AutomaticSize.None })
	local resSub = UI.label(results, "", 14, { TextColor3 = T.muted, Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.None })
	local resScroll = UI.scroll(results, { Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 1, -62 - 60) })
	UI.list(resScroll, Enum.FillDirection.Vertical, 6)
	local resBtns = new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 50), Parent = results })
	UI.list(resBtns, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right)
	local againBtn = UI.button(resBtns, "Race Again", { filled = false, size = UDim2.fromOffset(150, 48), color = T.magenta, layoutOrder = 1, name = "RaceAgain" })
	local hubBtn = UI.button(resBtns, "Return to Hub", { size = UDim2.fromOffset(180, 48), color = T.cyan, layoutOrder = 2, name = "ReturnHub" })

	-- Damage numbers
	local dmgLayer = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = root })

	-- Quick chat wheel --------------------------------------------------------
	local wheel = new("Frame", { Name = "QuickChat", Visible = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(400, 400), Parent = App.modalGui })
	local wheelScale = new("UIScale", { Parent = wheel })
	local ring = new("Frame", { BackgroundColor3 = T.panel, BackgroundTransparency = 0.25, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(250, 250), Parent = wheel })
	UI.corner(ring, 125)
	UI.stroke(ring, T.magenta, 2, 0.2)
	local wheelBtns = {}
	for i, msg in Config.QuickChat do
		local a = (i - 1) / #Config.QuickChat * math.pi * 2 - math.pi / 2
		local b = UI.button(wheel, msg, { size = UDim2.fromOffset(128, 50), color = T.magenta, filled = false, textColor = T.text, textSize = 14, name = "Chat" .. i })
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Position = UDim2.new(0.5, math.cos(a) * 140, 0.5, math.sin(a) * 140)
		b.BackgroundColor3 = T.panel
		wheelBtns[i] = b
	end
	local wheelCenter = UI.button(wheel, "Cancel", { size = UDim2.fromOffset(110, 44), filled = false, color = T.muted, textColor = T.text, name = "ChatCancel" })
	wheelCenter.AnchorPoint = Vector2.new(0.5, 0.5)
	wheelCenter.Position = UDim2.fromScale(0.5, 0.42)
	local cdL = UI.label(wheel, "", 13, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.fromOffset(170, 40), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = T.amber, FontFace = UI.F.bold })
	App.chatReadyAt = 0
	local wheelOpener: GuiObject? = nil
	local function wheelOpen(): boolean return wheel.Visible end
	local function closeWheel()
		if not wheel.Visible then return end
		wheel.Visible = false
		App.popLayer("chatwheel")
		if wheelOpener and wheelOpener.Parent then UI.focus(wheelOpener) else GuiService.SelectedObject = nil end
	end
	local function paintWheel()
		local left = App.chatReadyAt - App.now()
		for _, b in wheelBtns do UI.setEnabled(b, left <= 0) end
		cdL.Text = if left > 0 then string.format("Cooldown %ds", math.ceil(left)) else "Pick a message"
	end
	local function openWheel(opener: GuiObject?)
		if wheel.Visible then closeWheel() return end
		wheelOpener = opener or GuiService.SelectedObject
		wheel.Visible = true
		wheelScale.Scale = math.clamp(math.min(App.layout.w, App.layout.h) / 440, 0.7, 1.1)
		paintWheel()
		App.pushLayer("chatwheel", closeWheel)
		UI.focus(if App.chatReadyAt - App.now() > 0 then wheelCenter else wheelBtns[1])
	end
	App.openQuickChat = openWheel
	wheelCenter.Activated:Connect(closeWheel)
	for i, b in wheelBtns do
		b.Activated:Connect(function()
			if b:GetAttribute("Disabled") then return end
			closeWheel()
			local r = App.request("quickChat", { index = i }, { quiet = true })
			if r.ok then
				App.chatReadyAt = r.data.retryAt
			elseif r.retryAt then
				App.chatReadyAt = r.retryAt
				App.toast("Quick chat cooling down.", "warn")
			end
		end)
	end
	chatBtn.Activated:Connect(function() openWheel(chatBtn) end)

	-- Chat log (works in hub and race)
	local chatLog = new("Frame", { Name = "ChatLog", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 10, 1, -90), Size = UDim2.fromOffset(300, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = App.toastGui })
	UI.list(chatLog, Enum.FillDirection.Vertical, 4).VerticalAlignment = Enum.VerticalAlignment.Bottom
	App.notify:Connect(function(n)
		if n.kind == "chat" then
			local f = new("Frame", { BackgroundColor3 = T.panel, BackgroundTransparency = 0.15, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = chatLog })
			UI.corner(f, 8)
			UI.stroke(f, T.magenta, 1, 0.4)
			UI.pad(f, 6, 10)
			UI.label(f, "<b>" .. n.name .. ":</b> " .. n.text, 14)
			task.delay(6, function() f:Destroy() end)
			local kids = {}
			for _, c in chatLog:GetChildren() do if c:IsA("Frame") then table.insert(kids, c) end end
			if #kids > 4 then kids[1]:Destroy() end
		elseif n.kind == "impact" then
			local s = App.settings
			if s and s.damageNumbers then
				local l = UI.label(dmgLayer, "-" .. n.amount, 30, { FontFace = UI.F.title, TextColor3 = T.red, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, math.random(-60, 60), 0.62, 0), Size = UDim2.fromOffset(120, 40), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center })
				UI.stroke(l, T.bg, 2, 0).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
				UI.tween(l, 0.8, { Position = l.Position - UDim2.fromOffset(0, 60), TextTransparency = 1 })
				task.delay(0.85, function() l:Destroy() end)
			end
			if s and s.cameraShake and not s.reducedMotion then App.shake = math.min(1, (App.shake or 0) + n.amount / 25) end
		end
	end)

	-- State -------------------------------------------------------------------
	App.inRace = false
	local boardOpen = false
	local camMode = 1
	local camModes = { { dist = 17, height = 6.5 }, { dist = 26, height = 10 }, { dist = 9, height = 4 } }
	local driftHeld, boostSeq, gasHeld = false, 0, false
	local lastMode = "Solo"
	App.lastQueueMode = lastMode
	local lastSend = 0
	local lastSent = ""

	local function setBoard(on: boolean)
		boardOpen = on
		board.Visible = on and App.inRace and not results.Visible
		if board.Visible then
			App.pushLayer("board", function() setBoard(false) end)
		else
			App.popLayer("board")
		end
	end
	App.toggleBoard = function() setBoard(not boardOpen) end
	boardBtn.Activated:Connect(function() setBoard(not boardOpen) end)
	boardClose.Activated:Connect(function() setBoard(false) end)

	local function rowFrame(parent: Instance, r: any, isMe: boolean, order: number, big: boolean?)
		local f = new("Frame", { Name = "Row_" .. r.key, BackgroundColor3 = if isMe then Color3.fromRGB(0, 70, 90) else T.card, Size = UDim2.new(1, 0, 0, if big then 50 else 40), LayoutOrder = order, Parent = parent })
		UI.corner(f, 8)
		if isMe then UI.stroke(f, T.cyan, 2, 0) end
		local pl = UI.label(f, "P" .. r.place, if big then 18 else 15, { FontFace = UI.F.title, TextColor3 = if r.place == 1 then T.amber else T.text, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(0, 40, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center })
		local ps = if big then 38 else 30
		local portrait = UI.headshot(f, r.userId or 0, r.name, ps, r.bot)
		portrait.Position = UDim2.new(0, 50, 0.5, -ps / 2)
		local tagText = if isMe then "  <font color=\"#00EBFF\">YOU</font>" elseif r.party then "  <font color=\"#28FF8C\">PARTY</font>" elseif r.bot then "  <font color=\"#A0A8CD\">AI</font>" else ""
		UI.label(f, r.name .. tagText, if big then 16 else 14, { FontFace = UI.F.bold, Position = UDim2.fromOffset(56 + ps, 0), Size = UDim2.new(1, -(56 + ps + 110), 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false })
		local state = r.state or (if r.out then "OUT" elseif r.finished then ("✓ " .. (r.time or "Finished")) else ("Lap " .. r.lap))
		UI.label(f, state, 13, { TextColor3 = if r.out then T.red elseif r.finished then T.green else T.muted, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0), Size = UDim2.new(0, 104, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Center, FontFace = UI.F.bold })
		return f
	end

	local boardSig = ""
	local function renderBoard(s: any)
		local sig = ""
		for _, r in s.rows do sig ..= r.key .. r.place .. r.lap .. tostring(r.finished) .. tostring(r.out) end
		if sig == boardSig then return end
		boardSig = sig
		for _, c in boardRows:GetChildren() do if c:IsA("Frame") then c:Destroy() end end
		for i, r in s.rows do rowFrame(boardRows, r, r.key == s.me.key, i) end
	end

	local feedSig = ""
	local function renderFeed(s: any)
		local sig = ""
		for _, f in s.feed or {} do sig ..= f.text end
		if sig == feedSig then return end
		feedSig = sig
		for _, c in feedBox:GetChildren() do if c:IsA("TextLabel") then c:Destroy() end end
		for i, f in s.feed or {} do
			local l = UI.label(feedBox, f.text, 13, { LayoutOrder = i, BackgroundColor3 = T.panel, BackgroundTransparency = 0.25, TextColor3 = if string.find(f.text, "OUT") then T.red else T.green, FontFace = UI.F.bold })
			UI.pad(l, 3, 6)
			UI.corner(l, 6)
		end
	end

	local function ordinal(n: number): string
		local s = if n % 10 == 1 and n % 100 ~= 11 then "st" elseif n % 10 == 2 and n % 100 ~= 12 then "nd" elseif n % 10 == 3 and n % 100 ~= 13 then "rd" else "th"
		return n .. s
	end

	local function showResults(s: any)
		results.Visible = true
		setBoard(false)
		resTitle.Text = (if s.place == 1 then "VICTORY! " else "RACE COMPLETE · ") .. ordinal(s.place)
		resSub.Text = s.track .. " · " .. s.mode
		for _, c in resScroll:GetChildren() do if c:IsA("Frame") then c:Destroy() end end
		local rw = s.reward
		local rb = UI.card(resScroll, { LayoutOrder = 0, BackgroundColor3 = Color3.fromRGB(40, 20, 70) })
		UI.pad(rb, 10, 12)
		UI.list(rb, Enum.FillDirection.Vertical, 4)
		UI.label(rb, "REWARDS EARNED", 13, { TextColor3 = T.magenta, FontFace = UI.F.bold, LayoutOrder = 1 })
		UI.label(rb, string.format("<font color=\"#FFBA1E\">◆ +%s Credits</font>    <font color=\"#AF5AFF\">✦ +%s Flux</font>    <font color=\"#FF32D2\">+%s XP</font>", UI.fmt(rw.soft), UI.fmt(rw.hard), UI.fmt(rw.xp)), 18, { FontFace = UI.F.bold, LayoutOrder = 2 })
		if rw.levelUp then UI.label(rb, "LEVEL UP! You reached level " .. tostring(rw.level), 15, { TextColor3 = T.green, FontFace = UI.F.bold, LayoutOrder = 3 }) end
		for i, r in s.rows do rowFrame(resScroll, r, r.key == s.myKey, i, true) end
		App.raceResultsShownAt = App.now()
		task.defer(function() UI.focus(hubBtn) end)
	end

	local function leaveTrack(again: boolean)
		results.Visible = false
		App.popLayer("results")
		App.request("leaveTrack", {}, { quiet = true })
		if again then
			task.wait(0.4)
			local r = App.request("queueJoin", { mode = App.lastQueueMode or "Solo" })
			if r.ok then App.open("queue") end
		end
	end
	hubBtn.Activated:Connect(function() leaveTrack(false) end)
	againBtn.Activated:Connect(function() leaveTrack(true) end)
	exitBtn.Activated:Connect(function()
		App.request("leaveTrack", {}, { quiet = true })
	end)

	-- Camera
	local cam = workspace.CurrentCamera
	local camCF: CFrame? = nil
	local function myKart(): BasePart?
		local s = App.race
		if not s or not s.me then return nil end
		for _, f in workspace:GetChildren() do
			if string.sub(f.Name, 1, 7) == "Session" then
				local k = f:FindFirstChild("Kart_" .. s.me.key)
				if k then return (k :: Model).PrimaryPart end
			end
		end
		return nil
	end

	local function enterRace()
		if App.inRace then return end
		App.inRace = true
		App.closeAll()
		closeWheel()
		App.setHubVisible(false)
		root.Visible = true
		camCF = nil
		cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Scriptable
		ContextActionService:BindAction("NDL_Drift", function(_, state)
			driftHeld = state == Enum.UserInputState.Begin
			return Enum.ContextActionResult.Sink
		end, false, Enum.KeyCode.Space, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonR1)
		ContextActionService:BindAction("NDL_Boost", function(_, state)
			if state == Enum.UserInputState.Begin then boostSeq += 1 end
			return Enum.ContextActionResult.Sink
		end, false, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
		ContextActionService:BindAction("NDL_Recover", function(_, state)
			if state == Enum.UserInputState.Begin then task.spawn(App.request, "recover", {}, { quiet = false }) end
			return Enum.ContextActionResult.Sink
		end, false, Enum.KeyCode.R, Enum.KeyCode.DPadDown)
		ContextActionService:BindAction("NDL_Board", function(_, state)
			if state == Enum.UserInputState.Begin then setBoard(not boardOpen) end
			return Enum.ContextActionResult.Sink
		end, false, Enum.KeyCode.L, Enum.KeyCode.DPadUp)
		ContextActionService:BindAction("NDL_Cam", function(_, state)
			if state == Enum.UserInputState.Begin then camMode = camMode % #camModes + 1 end
			return Enum.ContextActionResult.Sink
		end, false, Enum.KeyCode.C, Enum.KeyCode.DPadLeft)
	end
	local function exitRace()
		if not App.inRace then return end
		App.inRace = false
		results.Visible = false
		App.popLayer("results")
		setBoard(false)
		closeWheel()
		root.Visible = false
		App.setHubVisible(true)
		for _, a in { "NDL_Drift", "NDL_Boost", "NDL_Recover", "NDL_Board", "NDL_Cam" } do ContextActionService:UnbindAction(a) end
		driftHeld = false
		local c = workspace.CurrentCamera
		c.CameraType = Enum.CameraType.Custom
		local char = App.player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then c.CameraSubject = hum end
		c.FieldOfView = 70
		Remotes.Drive:FireServer(0, 0, false, boostSeq)
	end

	-- Touch hold buttons
	tDrift.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then driftHeld = true end end)
	tDrift.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then driftHeld = false end end)
	tGas.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then gasHeld = true end end)
	tGas.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then gasHeld = false end end)
	tBoost.Activated:Connect(function() boostSeq += 1 end)
	tRecover.Activated:Connect(function() App.request("recover", {}) end)

	local function relayout(L: any)
		touchBox.Visible = L.touch
		local narrow = L.narrow
		boardBtn.Text = if narrow then "Board" else "Board [L]"
		chatBtn.Text = if narrow then "Chat" else "Chat [Q]"
		boardBtn.Size = UDim2.fromOffset(if narrow then 72 else 104, 44)
		chatBtn.Size = UDim2.fromOffset(if narrow then 66 else 98, 44)
		if narrow then
			topBox.Position = UDim2.new(0.5, 0, 0, 56)
			info.Position = UDim2.fromOffset(10, 122)
			board.Position = UDim2.new(1, -10, 0, 122)
			board.Size = UDim2.new(1, -20, 0, 0)
		else
			topBox.Position = UDim2.new(0.5, 0, 0, 6)
			info.Position = UDim2.fromOffset(10, 6)
			board.Position = UDim2.new(1, -10, 0, 60)
			board.Size = UDim2.fromOffset(340, 0)
		end
		dash.Size = UDim2.fromOffset(if narrow then 240 else 280, 64)
		dash.Position = if L.touch then UDim2.new(0.5, 0, 1, -8) else UDim2.new(0.5, 0, 1, -12)
		if L.touch and L.portrait then
			touchBox.Position = UDim2.new(1, -8, 1, -84)
		elseif L.touch then
			touchBox.Position = UDim2.new(1, -150, 1, -10)
		end
		driftTitle.Text = if L.touch then "DRIFT: hold to charge a turbo" elseif UI.usingGamepad() then "DRIFT [RB] · BOOST [X]" else "DRIFT [Space] to charge a turbo"
		boostTitle.Text = if L.touch then "BOOST" elseif UI.usingGamepad() then "BOOST [X]" else "BOOST [E]"
	end
	App.layoutChanged:Connect(relayout)
	relayout(App.layout)
	UserInputService.LastInputTypeChanged:Connect(function() relayout(App.layout) end)

	App.raceChanged:Connect(function(s)
		if s.phase == "none" then
			exitRace()
			return
		end
		enterRace()
		if s.phase == "results" then
			showResults(s)
			App.pushLayer("results", function() leaveTrack(false) end)
			return
		end
		local test = s.mode == "test"
		exitBtn.Visible = test
		boardBtn.Visible = not test
		topBox.Visible = true
		trackL.Text = if test then ("TEST DRIVE · " .. s.me.kartName) else (s.track .. " · " .. s.total .. " racers")
		modeChip.Text = if test then "PREVIEW · your next-race kart is unchanged" elseif s.raceMode == "Knockout" then "KNOCKOUT · last place OUT each lap" else "RACE · " .. s.laps .. " laps"
		modeChip.TextColor3 = if s.raceMode == "Knockout" then T.amber else T.cyan
		if test then
			posL.Text = "—"
			lapL.Text = "∞"
		else
			posL.Text = s.me.place .. "/" .. s.total
			lapL.Text = s.me.lap .. "/" .. s.laps
		end
		renderFeed(s)
		if boardOpen then renderBoard(s) end
		local me = s.me
		spdL.Text = tostring(me.speed)
		boostBar.Fill.Size = UDim2.fromScale(me.energy / 100, 1)
		boostBar.Fill.BackgroundColor3 = if me.energy >= 30 then T.amber else T.dim
		driftBar.Fill.Size = UDim2.fromScale(if me.drifting then math.clamp(me.driftTime / 1.6, 0, 1) else 0, 1)
		driftBar.Fill.BackgroundColor3 = if me.drifting and me.driftTime > 1.6 then T.magenta elseif me.drifting and me.driftTime > 0.7 then T.cyan else T.dim
		if me.out then
			warnL.Text = "YOU ARE OUT · spectating until the finish"
			warnL.Visible = true
		elseif me.finished then
			warnL.Text = "FINISHED! Waiting for other racers…"
			warnL.TextColor3 = T.green
			warnL.Visible = true
		elseif me.wrongWay then
			warnL.Text = "WRONG WAY · press R to recover"
			warnL.TextColor3 = T.red
			warnL.Visible = true
		else
			warnL.Visible = false
			warnL.TextColor3 = T.red
		end
	end)

	App.lobbyChanged:Connect(function(l)
		if l and l.queues then
			for mode, q in l.queues do
				if table.find(q.members, App.player.UserId) then App.lastQueueMode = mode end
			end
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.ButtonY then
			openWheel(if App.inRace then chatBtn else App.hubChatBtn)
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		local s = App.race
		if wheel.Visible then paintWheel() end
		if not App.inRace or not s then return end
		-- countdown / time
		if s.phase == "countdown" then
			local left = s.goAt - App.now()
			bigL.Visible = true
			bigL.Text = if left > 3 then "READY" else tostring(math.max(1, math.ceil(left)))
			timeL.Text = "0:00.0"
		elseif s.phase == "racing" then
			local since = App.now() - s.goAt
			if since < 1.2 and s.mode == "race" then bigL.Visible = true bigL.Text = "GO!" else bigL.Visible = false end
			if s.me and s.me.finished then
				-- frozen at finish time from the row
				for _, r in s.rows do if r.key == s.me.key and r.time then timeL.Text = r.time end end
			else
				timeL.Text = string.format("%d:%04.1f", since // 60, since % 60)
			end
		else
			bigL.Visible = false
		end
		-- input
		local move = Vector2.zero
		if moveAction then
			local ok, v = pcall(function() return moveAction:GetState() end)
			if ok and typeof(v) == "Vector2" then move = v end
		end
		local throttle = move.Y
		local steer = move.X
		for _, gp in { Enum.UserInputType.Gamepad1 } do
			if UserInputService:GetGamepadConnected(gp) then
				for _, st in UserInputService:GetGamepadState(gp) do
					if st.KeyCode == Enum.KeyCode.ButtonR2 and st.Position.Z > 0.1 then throttle = math.max(throttle, st.Position.Z) end
					if st.KeyCode == Enum.KeyCode.ButtonL2 and st.Position.Z > 0.1 then throttle = math.min(throttle, -st.Position.Z) end
				end
			end
		end
		if gasHeld then throttle = math.max(throttle, 1) end
		if UserInputService:GetFocusedTextBox() then throttle, steer = 0, 0 end
		local t = os.clock()
		local sig = string.format("%.2f|%.2f|%s|%d", throttle, steer, tostring(driftHeld), boostSeq)
		if sig ~= lastSent or t - lastSend > 0.25 then
			lastSent = sig
			lastSend = t
			Remotes.Drive:FireServer(throttle, steer, driftHeld, boostSeq)
		end
		-- camera
		local body = myKart()
		if body then
			local cm = camModes[camMode]
			local look = body.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z).Unit
			local base = body.Position
			local desiredPos = base - flat * cm.dist + Vector3.new(0, cm.height, 0)
			local desired = CFrame.lookAt(desiredPos, base + flat * 10 + Vector3.new(0, 2, 0))
			if not camCF then camCF = desired end
			local a = 1 - math.exp(-dt * (if UI.reducedMotion then 14 else 7))
			camCF = (camCF :: CFrame):Lerp(desired, a)
			local shake = App.shake or 0
			local cf = camCF :: CFrame
			if shake > 0.01 then
				cf = cf * CFrame.new((math.random() - 0.5) * shake, (math.random() - 0.5) * shake, 0)
				App.shake = shake * math.exp(-dt * 8)
			end
			cam.CameraType = Enum.CameraType.Scriptable
			cam.CFrame = cf
			local boosting = s.me and s.me.boosting
			local fov = if boosting and not UI.reducedMotion then 82 else 70
			cam.FieldOfView += (fov - cam.FieldOfView) * math.min(1, dt * 5)
		end
	end)
end
]]></ProtectedString>
