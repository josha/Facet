						<string name="Name">Panels</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">0b2ac657583187020afced100000234b</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX183FE6D58DFE455099D0F071BD10B9BB">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Rewards: crates and collection, seven-day track, codes, and missions (boosts, quests, timed offer).
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local UI = require(script.Parent.UI)
local Store = require(script.Parent.Store)
local W = require(script.Parent.Widgets)
local T = UI.T

local Rewards = {}

-- CRATES ---------------------------------------------------------------------
do
	local P = UI.panel("crates", "Crates & Collection", T.amber)
	local view = "shop" -- shop | reveal
	local reveal = { cards = {} :: { any }, shown = 0, crate = "" }
	local root = W.scroll(P.body, nil, 10)
	local first: TextButton? = nil
	local render: () -> ()

	local function cardFace(parent: Instance, c: any, shown: boolean, order: number)
		local def = Config.FindById(Config.Cards, c.id) :: any
		local f = UI.frame(parent, { BackgroundColor3 = if shown then T.card2 else Color3.fromRGB(30, 20, 50), LayoutOrder = order })
		UI.corner(f, 10)
		UI.stroke(f, if shown then Config.RarityColor[def.rarity] else T.line, if shown then 2 else 1)
		UI.pad(f, 8, 8)
		if shown then
			UI.label(f, def.rarity, 12, { Font = UI.Bold, TextColor3 = Config.RarityColor[def.rarity], TextXAlignment = Enum.TextXAlignment.Center })
			UI.label(f, def.name, 15, { Font = UI.Bold, Position = UDim2.new(0, 0, 0.3, 0), TextXAlignment = Enum.TextXAlignment.Center })
			UI.label(f, if c.isNew then "NEW!" else "Duplicate · ×" .. c.count, 12, { Font = UI.Bold, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = if c.isNew then T.green else T.dim })
		else
			UI.label(f, "?", 34, { Font = UI.Title, Size = UDim2.fromScale(1, 1), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, TextColor3 = T.violet })
		end
	end

	local function open(crate: any, btn: TextButton)
		local p = Store.profile
		local free = crate.free and p.freeCrates > 0
		UI.confirm({
			title = "Open " .. crate.name,
			body = "",
			confirm = if free then "Open free crate" else "Open · " .. Config.PriceText(crate.price),
			live = function()
				local q = Store.profile
				local isFree = crate.free and q.freeCrates > 0
				if isFree then
					return "Use 1 free crate (" .. q.freeCrates .. " available) to open " .. crate.name .. " · " .. crate.cards .. " cards. No currency is spent.", true, nil
				end
				local ok = Store.affordable(crate.price)
				return "Open " .. crate.name .. " for " .. Config.PriceText(crate.price) .. " · " .. crate.cards .. " cards.\n" .. Store.walletLine(), ok, if ok then nil else "Not enough funds."
			end,
		}, function(yes)
			if not yes then UI.toast("Cancelled. Nothing was spent.") return end
			local res = W.act(btn, "crate_open", { id = crate.id }, "Opening…")
			if res.ok then
				reveal.cards = res.cards
				reveal.shown = 0
				reveal.crate = crate.name .. (if res.usedFree then " (free)" else "")
				view = "reveal"
				render()
			end
		end)
	end

	render = function()
		local p = Store.profile
		if not p then return end
		W.clear(root)
		first = nil
		if view == "reveal" then
			UI.label(root, reveal.crate .. " · revealed " .. reveal.shown .. "/" .. #reveal.cards, 18, { Font = UI.Title, LayoutOrder = 1 })
			local row = UI.frame(root, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 })
			UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(150, 170), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }, row)
			for i, c in reveal.cards do cardFace(row, c, i <= reveal.shown, i) end
			local br = UI.frame(root, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 3 })
			UI.list(br, true, 10, Enum.HorizontalAlignment.Center)
			if reveal.shown < #reveal.cards then
				local nb = UI.button(br, "Reveal next", { Size = UDim2.fromOffset(170, 46), TextSize = 15 }, function()
					reveal.shown += 1
					UI.sfx("click", 1 + reveal.shown * 0.1)
					render()
				end)
				UI.style(nb, "primary")
				first = nb
				UI.button(br, "Reveal all", { Size = UDim2.fromOffset(150, 46), TextSize = 15 }, function()
					reveal.shown = #reveal.cards
					render()
				end)
			else
				first = UI.button(br, "Done", { Size = UDim2.fromOffset(150, 46), TextSize = 15 }, function()
					view = "shop"
					render()
				end)
				UI.style(first :: TextButton, "primary")
			end
			return
		end
		W.wallet(root, 0)
		UI.label(root, if p.freeCrates > 0 then "You have " .. p.freeCrates .. " free crate" .. (if p.freeCrates > 1 then "s" else "") .. ". Free crates are used before any currency on Basic Crates." else "No free crates. Earn them from Day 3 of the daily track and codes.", 14, { Font = UI.Bold, TextColor3 = if p.freeCrates > 0 then T.green else T.dim, LayoutOrder = 1 })
		local cratesRow = UI.frame(root, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 })
		UI.new("UIGridLayout", { CellSize = UDim2.new(if UI.size().X > 700 then 0.5 else 1, -8, 0, 200), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, cratesRow)
		for i, crate in Config.Crates do
			local c = UI.frame(cratesRow, { BackgroundColor3 = T.card, LayoutOrder = i })
			UI.corner(c, 12)
			UI.stroke(c, if i == 1 then T.cyan else T.magenta, 1.5)
			UI.pad(c, 12, 14)
			UI.list(c, false, 4)
			UI.label(c, crate.name, 18, { Font = UI.Title, LayoutOrder = 1 })
			UI.label(c, crate.cards .. " cards · " .. (if crate.free and p.freeCrates > 0 then "FREE (" .. p.freeCrates .. " left), then " else "") .. Config.PriceText(crate.price), 15, { Font = UI.Bold, TextColor3 = T.amber, LayoutOrder = 2 })
			local odds = {}
			for _, r in Config.Rarities do table.insert(odds, r .. " " .. crate.odds[r] .. "%") end
			UI.label(c, "Odds per card: " .. table.concat(odds, " · "), 13, { TextColor3 = T.dim, LayoutOrder = 3 })
			local b = UI.button(c, "Open…", { Size = UDim2.new(1, 0, 0, 44), TextSize = 15, LayoutOrder = 4 })
			local canOpen = (crate.free and p.freeCrates > 0) or Store.affordable(crate.price)
			UI.style(b, if canOpen then "primary" else "disabled")
			b:SetAttribute("DisabledReason", "Not enough funds for " .. crate.name .. ".")
			if not first then first = b end
			b.Activated:Connect(function() if not b:GetAttribute("Disabled") then open(crate, b) end end)
		end
		local found = 0
		for _, c in Config.Cards do if (p.collection[c.id] or 0) > 0 then found += 1 end end
		UI.label(root, "COLLECTION · " .. found .. "/" .. #Config.Cards .. " discovered", 16, { Font = UI.Title, TextColor3 = T.cyan, LayoutOrder = 3 })
		local barBg = UI.frame(root, { BackgroundColor3 = T.card2, Size = UDim2.new(1, 0, 0, 8), LayoutOrder = 4 })
		UI.corner(barBg, 4)
		UI.frame(barBg, { BackgroundColor3 = T.cyan, Size = UDim2.fromScale(found / #Config.Cards, 1) })
		local grid = UI.frame(root, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5 })
		UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(128, 64), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
		for i, c in Config.Cards do
			local n = p.collection[c.id] or 0
			local f = UI.frame(grid, { BackgroundColor3 = if n > 0 then T.card2 else Color3.fromRGB(18, 18, 30), LayoutOrder = i })
			UI.corner(f, 8)
			UI.stroke(f, if n > 0 then Config.RarityColor[c.rarity] else T.line, 1)
			UI.pad(f, 6, 8)
			UI.label(f, if n > 0 then c.name else "???", 13, { Font = UI.Bold, TextColor3 = if n > 0 then T.text else T.dim })
			UI.label(f, if n > 0 then c.rarity .. " · ×" .. n else c.rarity .. " · unknown", 12, { Position = UDim2.fromOffset(0, 30), TextColor3 = if n > 0 then Config.RarityColor[c.rarity] else Color3.fromRGB(100, 100, 130) })
		end
	end
	P.onOpen = render
	P.firstFocus = function() return first end
	Store.profileChanged.Event:Connect(function() if UI.current == P and view == "shop" then render() end UI.refreshDialog() end)
end

-- DAILY ------------------------------------------------------------------------
do
	local P = UI.panel("daily", "Daily Rewards", T.magenta)
	local root = W.scroll(P.body, nil, 10)
	local claimBtn: TextButton? = nil
	local countdown: TextLabel? = nil
	local function render()
		local p = Store.profile
		if not p then return end
		W.clear(root)
		local st = p.dailyState
		UI.label(root, "Claim once per day. Seven days in a row unlocks the Day 7 special reward.", 14, { TextColor3 = T.dim, LayoutOrder = 1 })
		if st.missed then
			UI.label(root, "You missed a day, so the track restarted at Day 1.", 15, { Font = UI.Bold, TextColor3 = T.amber, LayoutOrder = 2 })
		elseif st.complete then
			UI.label(root, "You finished the last track! A new seven-day track begins today.", 15, { Font = UI.Bold, TextColor3 = T.green, LayoutOrder = 2 })
		end
		local grid = UI.frame(root, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3 })
		local cols = if UI.size().X > 800 then 7 elseif UI.size().X > 500 then 4 else 3
		UI.new("UIGridLayout", { CellSize = UDim2.new(1 / cols, -8, 0, 120), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
		for i, r in Config.Daily do
			local claimed = i <= st.streak
			local ready = st.ready and i == st.nextIndex
			local state = if claimed then "CLAIMED" elseif ready then "READY" else "LOCKED"
			local f = UI.frame(grid, { BackgroundColor3 = if ready then Color3.fromRGB(70, 20, 70) elseif claimed then Color3.fromRGB(15, 50, 40) else T.card, LayoutOrder = i })
			UI.corner(f, 10)
			UI.stroke(f, if ready then T.magenta elseif claimed then T.green elseif r.special then T.amber else T.line, if ready or r.special then 2 else 1)
			UI.pad(f, 8, 8)
			UI.label(f, "DAY " .. i .. (if r.special then " ★" else ""), 14, { Font = UI.Title, TextColor3 = if r.special then T.amber else T.text })
			UI.label(f, W.rewardText(r), 13, { Position = UDim2.fromOffset(0, 24), TextColor3 = T.text })
			UI.label(f, state, 12, { Font = UI.Bold, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), TextColor3 = if ready then T.magenta elseif claimed then T.green else T.dim })
		end
		claimBtn = UI.button(root, if st.ready then "CLAIM DAY " .. st.nextIndex else "CLAIMED TODAY", { Size = UDim2.new(1, 0, 0, 50), TextSize = 17, LayoutOrder = 4 })
		local cb = claimBtn :: TextButton
		UI.style(cb, if st.ready then "magenta" else "disabled")
		cb:SetAttribute("DisabledReason", "Already claimed today. Come back when the countdown ends.")
		cb.Activated:Connect(function()
			if cb:GetAttribute("Disabled") then return end
			local res = W.act(cb, "daily_claim", nil, "Claiming…")
			if res.ok then UI.toast("Day " .. res.day .. " claimed: " .. W.rewardText(res.reward), "good") end
		end)
		countdown = UI.label(root, "", 15, { Font = UI.Bold, LayoutOrder = 5, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = T.cyan })
	end
	P.onOpen = render
	P.firstFocus = function() return claimBtn end
	Store.profileChanged.Event:Connect(function() if UI.current == P then render() end end)
	task.spawn(function()
		while true do
			task.wait(1)
			local p = Store.profile
			if p and countdown and UI.current == P then
				local left = p.dailyState.nextAt - Store.now()
				countdown.Text = if p.dailyState.ready then "Reward ready now! Next day unlocks in " .. Config.Clock(left) else "Next reward in " .. Config.Clock(left)
				if left <= 0 then Store.call("profile_get") end
			end
		end
	end)
end

-- CODES --------------------------------------------------------------------------
do
	local P = UI.panel("codes", "Redeem Code", T.cyan)
	local root = W.scroll(P.body, nil, 10)
	UI.label(root, "Enter a code for free rewards. Codes ignore spaces and letter case.", 14, { TextColor3 = T.dim, LayoutOrder = 1 })
	UI.label(root, "Try the launch code: " .. Config.SampleCode, 15, { Font = UI.Bold, TextColor3 = T.amber, LayoutOrder = 2 })
	local row = UI.frame(root, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 3 })
	local box = UI.new("TextBox", { BackgroundColor3 = T.card2, Size = UDim2.new(1, -150, 1, 0), PlaceholderText = "Enter code", Text = "", ClearTextOnFocus = false, TextColor3 = T.text, PlaceholderColor3 = T.dim, Font = UI.Bold, TextXAlignment = Enum.TextXAlignment.Left }, row)
	UI.scaleText(box, 17)
	UI.corner(box, 10)
	UI.pad(box, 0, 12)
	UI.stroke(box, T.line, 1)
	local go = UI.button(row, "Redeem", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 140, 1, 0), TextSize = 16 })
	UI.style(go, "primary")
	local status = UI.label(root, "", 16, { Font = UI.Bold, LayoutOrder = 4 })
	local back = UI.button(root, "Back to Shop", { Size = UDim2.fromOffset(180, 44), TextSize = 15, LayoutOrder = 5, Visible = false })
	back.Activated:Connect(function() UI.close() end)
	local busy = false
	local retryAt = 0
	local function setStatus(text: string, color: Color3)
		status.Text = text
		status.TextColor3 = color
	end
	go.Activated:Connect(function()
		if Store.now() < retryAt then return end
		if busy then
			setStatus("Still checking your last code… please wait.", T.amber)
			return
		end
		busy = true
		go.Text = "Checking…"
		setStatus("Checking code…", T.dim)
		local res = Store.call("code_redeem", { code = box.Text })
		busy = false
		go.Text = "Redeem"
		if res.ok then
			setStatus("Success! " .. res.code .. " gave you " .. W.rewardText(res.reward) .. ".", T.green)
			box.Text = ""
			UI.sfx("click", 1.5)
		else
			local k = res.kind
			if k == "empty" then setStatus("Type a code first.", T.amber)
			elseif k == "invalid" then setStatus("That code isn't valid. Check the spelling.", T.red)
			elseif k == "expired" then setStatus("That code has expired.", T.red)
			elseif k == "used" then setStatus("You've already redeemed this code.", T.amber)
			elseif k == "busy" then setStatus("Still checking your last code… please wait.", T.amber)
			elseif k == "rate" then
				retryAt = res.retryAt
				setStatus("Too many attempts. Try again in " .. res.retryIn .. "s.", T.red)
			else setStatus(res.err or "Something went wrong.", T.red) end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			if UI.current == P then
				local left = math.ceil(retryAt - Store.now())
				if left > 0 then
					go.Text = "Wait " .. left .. "s"
					UI.style(go, "disabled")
					go:SetAttribute("DisabledReason", "Too many attempts. Try again in " .. left .. "s.")
					status.Text = "Too many attempts. Try again in " .. left .. "s."
					status.TextColor3 = T.red
				elseif go.Text:find("Wait") then
					go.Text = "Redeem"
					UI.style(go, "primary")
					setStatus("You can try again now.", T.dim)
				end
			end
		end
	end)
	P.onOpen = function()
		back.Visible = P.returnTo == "shop"
		P.title.Text = if P.returnTo == "shop" then "SHOP  ›  REDEEM CODE" else "REDEEM CODE"
	end
	P.firstFocus = function() return box end
end

-- MISSIONS: boosts, quests, timed offer ---------------------------------------------
do
	local P = UI.panel("missions", "Missions & Boosts", T.green)
	local root = W.scroll(P.body, nil, 10)
	local first: TextButton? = nil
	local offerTimer: TextLabel? = nil
	local boostTimers: { [string]: TextLabel } = {}
	local function render()
		local p = Store.profile
		if not p then return end
		W.clear(root)
		first = nil
		boostTimers = {}
		W.wallet(root, 0)
		-- Offer
		local o = Config.Offer
		local os_ = p.offerState
		local oc = UI.frame(root, { BackgroundColor3 = Color3.fromRGB(50, 20, 60), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 })
		UI.corner(oc, 12)
		UI.stroke(oc, T.magenta, 2)
		UI.pad(oc, 12, 14)
		UI.list(oc, false, 4)
		UI.label(oc, "LIMITED OFFER · " .. o.name, 17, { Font = UI.Title, TextColor3 = T.magenta, LayoutOrder = 1 })
		UI.label(oc, "Contains " .. W.rewardText(o.reward) .. " for " .. Config.PriceText(o.price) .. ". For pilots level " .. o.maxLevel .. " or lower, once per account.", 14, { LayoutOrder = 2 })
		offerTimer = UI.label(oc, "", 14, { Font = UI.Bold, TextColor3 = T.amber, LayoutOrder = 3 })
		local ob = UI.button(oc, if os_.eligible then "Buy · " .. Config.PriceText(o.price) else os_.reason, { Size = UDim2.new(0, 260, 0, 42), TextSize = 14, LayoutOrder = 4 })
		UI.style(ob, if os_.eligible and Store.affordable(o.price) then "magenta" else "disabled")
		ob:SetAttribute("DisabledReason", if os_.eligible then "Not enough Shards." else os_.reason)
		first = ob
		ob.Activated:Connect(function()
			if ob:GetAttribute("Disabled") then return end
			UI.confirm({ title = "Buy offer", body = "", confirm = "Buy · " .. Config.PriceText(o.price), live = function()
				local q = Store.profile
				local ok = q.offerState.eligible and Store.affordable(o.price)
				return "Buy " .. o.name .. " for " .. Config.PriceText(o.price) .. "?\n" .. Store.walletLine(), ok, if ok then nil elseif not q.offerState.eligible then q.offerState.reason else "Not enough Shards."
			end }, function(yes)
				if yes then W.act(ob, "offer_buy", nil, "Buying…") else UI.toast("Cancelled. Nothing was spent.") end
			end)
		end)
		-- Quests
		UI.label(root, "QUESTS", 16, { Font = UI.Title, TextColor3 = T.green, LayoutOrder = 2 })
		for i, q in Config.Quests do
			local prog = math.min(p.stats[q.stat] or 0, q.goal)
			local claimed = p.questsClaimed[q.id]
			local done = prog >= q.goal
			local c = UI.frame(root, { BackgroundColor3 = T.card, Size = UDim2.new(1, 0, 0, 64), LayoutOrder = 2 + i })
			UI.corner(c, 10)
			UI.stroke(c, if claimed then T.line elseif done then T.green else T.line, if done and not claimed then 2 else 1)
			UI.pad(c, 8, 12)
			UI.label(c, q.name .. "  ·  " .. W.rewardText(q.reward), 15, { Font = UI.Bold, Size = UDim2.new(1, -140, 0, 22), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
			local bg = UI.frame(c, { BackgroundColor3 = T.card2, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, -200, 0, 8) })
			UI.corner(bg, 4)
			UI.frame(bg, { BackgroundColor3 = T.green, Size = UDim2.fromScale(prog / q.goal, 1) })
			UI.label(c, prog .. "/" .. q.goal, 13, { Font = UI.Bold, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -140, 0, 24), Size = UDim2.fromOffset(52, 20), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right })
			local b = UI.button(c, if claimed then "Claimed" elseif done then "Claim" else "In progress", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(128, 42), TextSize = 14 })
			UI.style(b, if claimed then "disabled" elseif done then "good" else "disabled")
			b:SetAttribute("DisabledReason", if claimed then "Already claimed." else "Finish the quest first.")
			b.Activated:Connect(function() if not b:GetAttribute("Disabled") then W.act(b, "quest_claim", { id = q.id }, "…") end end)
		end
		-- Boosts
		UI.label(root, "BOOSTS", 16, { Font = UI.Title, TextColor3 = T.cyan, LayoutOrder = 20 })
		for i, b in Config.Boosts do
			local left = (p.boosts[b.id] or 0) - Store.now()
			local c = UI.frame(root, { BackgroundColor3 = T.card, Size = UDim2.new(1, 0, 0, 64), LayoutOrder = 20 + i })
			UI.corner(c, 10)
			UI.stroke(c, if left > 0 then T.cyan else T.line, if left > 0 then 2 else 1)
			UI.pad(c, 8, 12)
			UI.label(c, b.name .. "  ·  " .. b.desc, 15, { Font = UI.Bold, Size = UDim2.new(1, -170, 0, 22), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
			boostTimers[b.id] = UI.label(c, "", 13, { TextColor3 = if left > 0 then T.cyan else T.dim, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, -170, 0, 18), AutomaticSize = Enum.AutomaticSize.None })
			local btn = UI.button(c, (if left > 0 then "Extend · " else "Buy · ") .. Config.PriceText(b.price), { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(160, 42), TextSize = 13 })
			UI.style(btn, if Store.affordable(b.price) then "primary" else "disabled")
			btn:SetAttribute("DisabledReason", "Not enough Shards.")
			btn.Activated:Connect(function()
				if btn:GetAttribute("Disabled") then return end
				UI.confirm({ title = "Activate boost", body = "", confirm = "Buy · " .. Config.PriceText(b.price), live = function()
					local ok = Store.affordable(b.price)
					return "Activate " .. b.name .. " for 15 minutes for " .. Config.PriceText(b.price) .. "?\n" .. Store.walletLine(), ok, if ok then nil else "Not enough Shards."
				end }, function(yes)
					if yes then W.act(btn, "boost_buy", { id = b.id }, "…") else UI.toast("Cancelled. Nothing was spent.") end
				end)
			end)
		end
	end
	local function tick()
		local p = Store.profile
		if not p or UI.current ~= P then return end
		if offerTimer then
			local os_ = p.offerState
			local left = os_.endsAt - Store.now()
			offerTimer.Text = if os_.eligible and left > 0 then "Expires in " .. Config.Clock(left) else (if os_.reason ~= "" then os_.reason else "Offer expired")
			if os_.eligible and left <= 0 then Store.call("profile_get") end
		end
		for id, l in boostTimers do
			local left = (p.boosts[id] or 0) - Store.now()
			l.Text = if left > 0 then "Active · " .. Config.Clock(left) .. " left" else "Inactive"
		end
	end
	P.onOpen = function() render() tick() end
	P.firstFocus = function() return first end
	Store.profileChanged.Event:Connect(function() if UI.current == P then render() tick() end UI.refreshDialog() end)
	task.spawn(function() while true do task.wait(1) tick() end end)
end

return Rewards
]]></ProtectedString>
						<string name="ScriptGuid">{ABC29CBA-976B-4FA6-A3A0-EBBF9AAE279D}</string>
