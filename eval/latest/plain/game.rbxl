					<Properties>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Client entry point.
local App = require(script.Parent.App)
require(script.Parent.Hud)(App)
require(script.Parent.RaceClient)(App)
for _, mod in script.Parent.Panels:GetChildren() do
	if mod:IsA("ModuleScript") then
		local ok, err = pcall(function() (require(mod) :: any)(App) end)
		if not ok then warn("Panel failed to load", mod.Name, err) end
	end
end
for _, name in { "Tutorial", "Dialogue" } do
	local mod = script.Parent:FindFirstChild(name)
	if mod then
		local ok, err = pcall(function() (require(mod) :: any)(App) end)
		if not ok then warn("Module failed to load", name, err) end
	end
end
App.startTutorial = App.startTutorial or function() end
App.startDialogue = App.startDialogue or function() end
if App.profile then App.profileChanged:Fire(App.profile) end
]]></ProtectedString>
