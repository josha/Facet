				<Item class="ModuleScript" referent="RBX30193C4A54AB465BA599C7EEB7027A13">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Kart preparation: Shop, Garage, Upgrades, Inventory and Drivers.
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local UI = require(script.Parent.UI)
local Store = require(script.Parent.Store)
local W = require(script.Parent.Widgets)
local KartView = require(script.Parent.KartView)
local RaceClient = require(script.Parent.RaceClient)
local T = UI.T

local Panels = {}

local function partEffects(p: any): string
	local e = {}
	for _, k in { "speed", "accel", "handling", "boost" } do
		if p.effects[k] then table.insert(e, "+" .. p.effects[k] .. " " .. k) end
	end
	if p.nitro then table.insert(e, "+" .. p.nitro .. " nitro") end
	if #e == 0 then return "Cosmetic" end
	return table.concat(e, ", ")
end
Panels.partEffects = partEffects

-- SHOP ------------------------------------------------------------------------
do
	local P = UI.panel("shop", "Parts Shop", T.magenta)
	local tab = "all"
	local top = UI.frame(P.body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 92) })
	UI.list(top, false, 4)
	local headRow = UI.frame(top, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 1 })
	local wallet = W.wallet(headRow)
	wallet.Size = UDim2.new(1, -150, 1, 0)
	wallet.AutomaticSize = Enum.AutomaticSize.None
	wallet.TextYAlignment = Enum.TextYAlignment.Center
	local codesBtn = UI.button(headRow, "Redeem Code", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(140, 40), TextSize = 14 })
	codesBtn.Activated:Connect(function() UI.open("codes", codesBtn, "shop") end)
	local grid = W.scroll(P.body, { Position = UDim2.fromOffset(0, 96), Size = UDim2.new(1, 0, 1, -96) })
	grid:FindFirstChildOfClass("UIListLayout"):Destroy()
	local gl = UI.new("UIGridLayout", { CellSize = UDim2.new(0.5, -6, 0, 132), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
	local render: () -> ()
	local _, refreshTabs = W.chips(top, {
		{ id = "all", label = "All Items" }, { id = "motor", label = "Motors" }, { id = "boost", label = "Boosts" },
		{ id = "wheels", label = "Wheels" }, { id = "cosmetic", label = "Cosmetics" },
	}, function() return tab end, function(id) tab = id render() end, 2)

	local function buy(part: any, btn: TextButton)
		local function go()
			W.act(btn, "shop_buy", { id = part.id }, "Buying…")
		end
		if part.price >= Config.ConfirmThreshold then
			UI.confirm({
				title = "Confirm purchase",
				body = "Buy " .. part.name .. " for " .. Config.Comma(part.price) .. " Credits?",
				confirm = "Buy · " .. Config.Comma(part.price),
				live = function()
					local p = Store.profile
					local okFunds = p.credits >= part.price
					return "Buy " .. part.name .. " for " .. Config.Comma(part.price) .. " Credits?\n" .. Store.walletLine(), okFunds and not p.parts[part.id],
						if p.parts[part.id] then "You already own this part." elseif not okFunds then "Not enough Credits (need " .. Config.Comma(part.price - p.credits) .. " more)." else nil
				end,
			}, function(yes)
				if yes then go() else UI.toast("Purchase cancelled. Nothing was spent.") end
			end)
		else
			go()
		end
	end

	render = function()
		local p = Store.profile
		if not p then return end
		W.clear(grid)
		local wide = UI.size().X > 700
		gl.CellSize = if wide then UDim2.new(0.5, -6, 0, 132) else UDim2.new(1, -4, 0, 132)
		for i, part in Config.Parts do
			if tab == "all" or part.slot == tab then
				local owned = p.parts[part.id] == true
				local afford = p.credits >= part.price
				local card = UI.frame(grid, { BackgroundColor3 = T.card, LayoutOrder = i })
				UI.corner(card, 12)
				UI.stroke(card, if owned then T.green else T.line, 1)
				UI.pad(card, 10, 12)
				UI.label(card, part.name, 17, { Font = UI.Bold, Size = UDim2.new(1, -110, 0, 22), AutomaticSize = Enum.AutomaticSize.None, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false })
				UI.label(card, (Config.SlotNames[part.slot] or part.slot) .. " · " .. partEffects(part), 13, { TextColor3 = T.cyan, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, -110, 0, 18), AutomaticSize = Enum.AutomaticSize.None, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Font = UI.Bold })
				UI.label(card, part.desc, 13, { TextColor3 = T.dim, Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, -110, 0, 50), AutomaticSize = Enum.AutomaticSize.None })
				local priceText = if part.exclusive then "Day 7 reward" else Config.Comma(part.price) .. " Credits"
				UI.label(card, priceText, 15, { Font = UI.Bold, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(110, 20), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = if owned then T.dim elseif afford and not part.exclusive then T.amber else T.red })
				local btn = UI.button(card, "", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0), Size = UDim2.fromOffset(110, 40), TextSize = 14 })
				if owned then
					btn.Text = "OWNED"
					UI.style(btn, "good")
					btn:SetAttribute("Disabled", true)
					btn:SetAttribute("DisabledReason", "You own this. Equip it in Inventory.")
				elseif part.exclusive then
					btn.Text = "LOCKED"
					UI.style(btn, "disabled")
					btn:SetAttribute("DisabledReason", "Claim Day 7 of the daily track to unlock this.")
				elseif not afford then
					btn.Text = "NEED " .. Config.Short(part.price - p.credits)
					UI.style(btn, "disabled")
					btn:SetAttribute("DisabledReason", "Not enough Credits: you need " .. Config.Comma(part.price - p.credits) .. " more.")
				else
					btn.Text = if part.price >= Config.ConfirmThreshold then "BUY…" else "BUY"
					UI.style(btn, "primary")
				end
				btn.Activated:Connect(function()
					if btn:GetAttribute("Disabled") then
						local why = btn:GetAttribute("DisabledReason")
						if why then UI.toast(why, "warn") end
						return
					end
					buy(part, btn)
				end)
			end
		end
	end
	P.onOpen = function() refreshTabs() render() end
	P.firstFocus = function() return codesBtn end
	Store.profileChanged.Event:Connect(function() if UI.current == P then render() end UI.refreshDialog() end)
	UI.layoutChanged.Event:Connect(function() if UI.current == P then render() end end)
end

-- GARAGE -----------------------------------------------------------------------
local garage = { selected = "volt", search = "", category = "All", rarity = "All", sort = "name" }
Panels.garageState = garage
do
	local P = UI.panel("garage", "Garage", T.cyan)
	local left, right = W.split(P.body, 0.55)
	local controls = UI.frame(left, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	UI.list(controls, false, 4)
	local searchRow = UI.frame(controls, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), LayoutOrder = 1 })
	local box = UI.new("TextBox", {
		BackgroundColor3 = T.card2, Size = UDim2.new(1, -96, 1, 0), PlaceholderText = "Search karts…", Text = "", ClearTextOnFocus = false,
		TextColor3 = T.text, PlaceholderColor3 = T.dim, Font = UI.Body, TextXAlignment = Enum.TextXAlignment.Left,
	}, searchRow)
	UI.scaleText(box, 15)
	UI.corner(box, 10)
	UI.pad(box, 0, 12)
	UI.stroke(box, T.line, 1)
	local clearBtn = UI.button(searchRow, "Clear", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 88, 1, 0), TextSize = 14 })
	local render: () -> ()
	local catOpts = { { id = "All", label = "All types" } }
	for _, c in Config.KartCategories do table.insert(catOpts, { id = c, label = c }) end
	local rarOpts = { { id = "All", label = "All rarities" } }
	for _, r in Config.Rarities do table.insert(rarOpts, { id = r, label = r }) end
	local _, rc1 = W.chips(controls, catOpts, function() return garage.category end, function(id) garage.category = id render() end, 2)
	local _, rc2 = W.chips(controls, rarOpts, function() return garage.rarity end, function(id) garage.rarity = id render() end, 3)
	local _, rc3 = W.chips(controls, { { id = "name", label = "Sort: Name A–Z" }, { id = "speed", label = "Sort: Speed" }, { id = "rarity", label = "Sort: Rarity" } }, function() return garage.sort end, function(id) garage.sort = id render() end, 4)
	local list = W.scroll(left, { Position = UDim2.fromOffset(0, 190), Size = UDim2.new(1, 0, 1, -190) }, 6)
	controls:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		list.Position = UDim2.fromOffset(0, controls.AbsoluteSize.Y + 6)
		list.Size = UDim2.new(1, 0, 1, -(controls.AbsoluteSize.Y + 6))
	end)

	-- detail pane
	local detail = W.scroll(right, nil, 6)
	UI.pad(detail, 10, 12)
	local viewHolder = UI.frame(detail, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 170), LayoutOrder = 1 })
	local view = KartView.new(viewHolder)
	local dName = UI.label(detail, "", 20, { Font = UI.Title, LayoutOrder = 2 })
	local tagRow = UI.frame(detail, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 3 })
	UI.list(tagRow, true, 6)
	local dDesc = UI.label(detail, "", 14, { TextColor3 = T.dim, LayoutOrder = 4 })
	local stats = UI.frame(detail, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5 })
	UI.list(stats, false, 2)
	local btnRow = UI.frame(detail, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 6 })
	local brl = UI.list(btnRow, true, 6)
	brl.Wraps = true
	local favBtn = UI.button(btnRow, "☆ Favorite", { Size = UDim2.fromOffset(120, 42), TextSize = 14, LayoutOrder = 1 })
	local tryBtn = UI.button(btnRow, "Test Drive", { Size = UDim2.fromOffset(120, 42), TextSize = 14, LayoutOrder = 2 })
	local chooseBtn = UI.button(btnRow, "Use Next Race", { Size = UDim2.fromOffset(150, 42), TextSize = 14, LayoutOrder = 3 })
	local rowButtons: { [string]: TextButton } = {}

	local function filtered(): { any }
		local q = string.lower(garage.search)
		local out = {}
		for _, k in Config.Karts do
			local okSearch = q == "" or string.find(string.lower(k.name), q, 1, true) ~= nil
			local okCat = garage.category == "All" or k.category == garage.category
			local okRar = garage.rarity == "All" or k.rarity == garage.rarity
			if okSearch and okCat and okRar then table.insert(out, k) end
		end
		table.sort(out, function(a, b)
			if garage.sort == "speed" and a.speed ~= b.speed then return a.speed > b.speed end
			if garage.sort == "rarity" and a.rarity ~= b.rarity then return Config.RarityRank[a.rarity] > Config.RarityRank[b.rarity] end
			return a.name < b.name
		end)
		return out
	end

	local function renderDetail()
		local p = Store.profile
		local k = Config.FindById(Config.Karts, garage.selected) or Config.Karts[1]
		if not p then return end
		view.set(k.id, p.livery, nil)
		dName.Text = k.name
		W.clear(tagRow)
		W.tag(tagRow, k.rarity, Config.RarityColor[k.rarity], 1)
		W.tag(tagRow, k.category, T.cyan, 2)
		if p.kart == k.id then W.tag(tagRow, "NEXT RACE", T.green, 3) end
		if p.level < k.level then W.tag(tagRow, "Unlocks at Lv " .. k.level, T.red, 4) end
		if p.favorites[k.id] then W.tag(tagRow, "★ Favorite", T.amber, 5) end
		dDesc.Text = k.desc
		W.clear(stats)
		local up = p.upgrades[k.id] or {}
		local phys = Config.KartPhysics(k.id, up, nil, nil)
		W.statBar(stats, "Speed", phys.stats.speed, 100, T.cyan, 1, (up.speed or 0) * Config.UpgradeGain.speed)
		W.statBar(stats, "Accel", phys.stats.accel, 100, T.magenta, 2)
		W.statBar(stats, "Handling", phys.stats.handling, 100, T.green, 3, (up.handling or 0) * Config.UpgradeGain.handling)
		W.statBar(stats, "Boost", phys.stats.boost, 100, T.amber, 4, (up.boost or 0) * Config.UpgradeGain.boost)
		UI.label(stats, string.format("Top speed %d km/h · upgrades included", math.floor(phys.maxSpeed * 1.6)), 12, { TextColor3 = T.dim, LayoutOrder = 5 })
		favBtn.Text = if p.favorites[k.id] then "★ Favorited" else "☆ Favorite"
		UI.style(favBtn, if p.favorites[k.id] then "selected" else "")
		if p.kart == k.id then
			chooseBtn.Text = "✓ Next Race Kart"
			UI.style(chooseBtn, "good")
		elseif p.level < k.level then
			chooseBtn.Text = "Locked · Lv " .. k.level
			UI.style(chooseBtn, "disabled")
			chooseBtn:SetAttribute("DisabledReason", k.name .. " unlocks at level " .. k.level .. ". Race to earn XP.")
		else
			chooseBtn.Text = "Use Next Race"
			UI.style(chooseBtn, "primary")
		end
	end

	render = function()
		local p = Store.profile
		if not p then return end
		rc1() rc2() rc3()
		W.clear(list)
		rowButtons = {}
		local items = filtered()
		if #items == 0 then
			local empty = UI.frame(list, { BackgroundColor3 = T.card, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
			UI.corner(empty, 10)
			UI.pad(empty, 16, 14)
			UI.label(empty, "No karts match" .. (if garage.search ~= "" then " \"" .. garage.search .. "\"" else "") .. " with these filters.\nTry Clear, or pick All types / All rarities.", 15, { TextColor3 = T.amber, Font = UI.Bold })
		end
		for i, k in items do
			local sel = k.id == garage.selected
			local b = UI.button(list, "", { Size = UDim2.new(1, -4, 0, 56), LayoutOrder = i, BackgroundColor3 = if sel then Color3.fromRGB(16, 60, 80) else T.card })
			if sel then b:SetAttribute("StrokeColor", T.cyan) local st = b:FindFirstChildOfClass("UIStroke") if st then st.Color = T.cyan st.Thickness = 2 end end
			UI.frame(b, { BackgroundColor3 = Config.RarityColor[k.rarity], Size = UDim2.new(0, 5, 1, -16), Position = UDim2.fromOffset(8, 8) })
			UI.label(b, (if p.favorites[k.id] then "★ " else "") .. k.name, 16, { Font = UI.Bold, Position = UDim2.fromOffset(22, 6), Size = UDim2.new(1, -130, 0, 22), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
			UI.label(b, k.rarity .. " · " .. k.category .. (if p.level < k.level then " · Lv " .. k.level else ""), 13, { TextColor3 = Config.RarityColor[k.rarity], Position = UDim2.fromOffset(22, 29), Size = UDim2.new(1, -130, 0, 18), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
			UI.label(b, "SPD " .. k.speed, 14, { Font = UI.Bold, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 6), Size = UDim2.fromOffset(90, 22), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right })
			if p.kart == k.id then
				UI.label(b, "NEXT RACE", 12, { Font = UI.Bold, TextColor3 = T.green, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 29), Size = UDim2.fromOffset(90, 18), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right })
			end
			b.Activated:Connect(function()
				garage.selected = k.id
				render()
				UI.focus(rowButtons[k.id])
			end)
			rowButtons[k.id] = b
		end
		renderDetail()
	end

	box:GetPropertyChangedSignal("Text"):Connect(function()
		garage.search = box.Text
		render()
	end)
	clearBtn.Activated:Connect(function()
		box.Text = ""
		garage.search = ""
		render()
	end)
	favBtn.Activated:Connect(function()
		local p = Store.profile
		W.act(nil, "kart_favorite", { id = garage.selected, on = not p.favorites[garage.selected] })
	end)
	chooseBtn.Activated:Connect(function()
		if chooseBtn:GetAttribute("Disabled") then return end
		W.act(chooseBtn, "kart_select", { id = garage.selected }, "Saving…")
	end)
	tryBtn.Activated:Connect(function()
		local kartId = garage.selected
		UI.close()
		local ok, err = RaceClient.startPreview(kartId)
		if not ok then UI.toast(err or "Can't start a test drive now.", "bad") else UI.toast("Test drive: " .. (Config.FindById(Config.Karts, kartId) :: any).name .. ". Your next-race kart is unchanged.") end
	end)
	P.onOpen = function()
		box.Text = garage.search
		render()
	end
	P.firstFocus = function() return rowButtons[garage.selected] or box end
	Store.profileChanged.Event:Connect(function() if UI.current == P then render() end end)
end

-- UPGRADES ------------------------------------------------------------------------
do
	local P = UI.panel("upgrades", "Upgrades", T.cyan)
	local kartId: string? = nil
	local top = UI.frame(P.body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 74) })
	UI.list(top, false, 4)
	W.wallet(top, 1)
	local opts = {}
	for _, k in Config.Karts do table.insert(opts, { id = k.id, label = k.name }) end
	local render: () -> ()
	local _, refreshChips = W.chips(top, opts, function() return kartId or "" end, function(id) kartId = id render() end, 2)
	local list = W.scroll(P.body, { Position = UDim2.fromOffset(0, 80), Size = UDim2.new(1, 0, 1, -80) }, 10)
	local firstBtn: TextButton? = nil
	local labels = { speed = "Speed", handling = "Handling", boost = "Boost" }
	local colors = { speed = T.cyan, handling = T.green, boost = T.amber }

	render = function()
		local p = Store.profile
		if not p then return end
		kartId = kartId or p.kart
		refreshChips()
		W.clear(list)
		local k = Config.FindById(Config.Karts, kartId :: string) or Config.Karts[1]
		local up = p.upgrades[k.id] or {}
		UI.label(list, k.name .. " — upgrades apply only to this kart" .. (if p.kart == k.id then " (your next-race kart)" else ""), 15, { Font = UI.Bold, LayoutOrder = 0 })
		firstBtn = nil
		for i, stat in Config.UpgradeStats do
			local lvl = up[stat] or 0
			local card = UI.frame(list, { BackgroundColor3 = T.card, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = i })
			UI.corner(card, 12)
			UI.pad(card, 12, 14)
			UI.list(card, false, 6)
			UI.label(card, string.upper(labels[stat]) .. "   Level " .. lvl .. "/" .. Config.UpgradeMax, 17, { Font = UI.Title, LayoutOrder = 1, TextColor3 = colors[stat] })
			local pips = UI.frame(card, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 10), LayoutOrder = 2 })
			UI.list(pips, true, 4)
			for j = 1, Config.UpgradeMax do
				local pip = UI.frame(pips, { BackgroundColor3 = if j <= lvl then colors[stat] else T.card2, Size = UDim2.new(1 / Config.UpgradeMax, -4, 1, 0), LayoutOrder = j })
				UI.corner(pip, 3)
			end
			local base = (k :: any)[stat]
			local gain = Config.UpgradeGain[stat]
			local row = UI.frame(card, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 3 })
			local info = UI.label(row, "", 14, { Size = UDim2.new(1, -170, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center })
			local btn = UI.button(row, "", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(160, 44), TextSize = 14 })
			if not firstBtn then firstBtn = btn end
			if lvl >= Config.UpgradeMax then
				info.Text = labels[stat] .. " " .. (base + lvl * gain) .. " · Maximum level reached."
				btn.Text = "MAX LEVEL"
				UI.style(btn, "disabled")
				btn:SetAttribute("DisabledReason", "This stat is fully upgraded.")
			else
				local cost = Config.UpgradeCost(lvl)
				local afford = p.credits >= cost.credits and p.shards >= cost.shards
				info.Text = "Next: " .. labels[stat] .. " " .. (base + lvl * gain) .. " → " .. (base + (lvl + 1) * gain) .. "\nCost: " .. Config.Comma(cost.credits) .. " Credits + " .. Config.Comma(cost.shards) .. " Shards"
				if afford then
					btn.Text = "UPGRADE…"
					UI.style(btn, "primary")
				else
					local miss = {}
					if p.credits < cost.credits then table.insert(miss, Config.Comma(cost.credits - p.credits) .. " Credits") end
					if p.shards < cost.shards then table.insert(miss, Config.Comma(cost.shards - p.shards) .. " Shards") end
					btn.Text = "NEED MORE"
					UI.style(btn, "disabled")
					btn:SetAttribute("DisabledReason", "Insufficient funds: you need " .. table.concat(miss, " and ") .. " more.")
					info.Text ..= "\nInsufficient funds: need " .. table.concat(miss, " and ") .. " more."
				end
				btn.Activated:Connect(function()
					if btn:GetAttribute("Disabled") then return end
					UI.confirm({
						title = "Confirm upgrade",
						body = "",
						confirm = "Upgrade",
						live = function()
							local q = Store.profile
							local ok = q.credits >= cost.credits and q.shards >= cost.shards
							return "Upgrade " .. k.name .. " " .. labels[stat] .. " to level " .. (lvl + 1) .. " for " .. Config.Comma(cost.credits) .. " Credits + " .. Config.Comma(cost.shards) .. " Shards?\n" .. Store.walletLine(), ok, if ok then nil else "Insufficient funds for this upgrade."
						end,
					}, function(yes)
						if yes then W.act(btn, "upgrade", { kart = k.id, stat = stat }, "Upgrading…") else UI.toast("Upgrade cancelled. Nothing was spent.") end
					end)
				end)
			end
		end
	end
	P.onOpen = function()
		local p = Store.profile
		if p and not kartId then kartId = p.kart end
		render()
	end
	P.firstFocus = function() return firstBtn end
	Store.profileChanged.Event:Connect(function() if UI.current == P then render() end UI.refreshDialog() end)
end

-- INVENTORY -------------------------------------------------------------------------
do
	local P = UI.panel("inventory", "Inventory", T.green)
	local tab = "parts"
	local render: () -> ()
	local top = UI.frame(P.body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46) })
	local _, refreshTabs = W.chips(top, { { id = "parts", label = "Parts" }, { id = "drivers", label = "Drivers" } }, function() return tab end, function(id) tab = id render() end)
	local list = W.scroll(P.body, { Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 1, -50) }, 8)
	local first: TextButton? = nil

	local function section(text: string, order: number)
		UI.label(list, text, 15, { Font = UI.Title, TextColor3 = T.cyan, LayoutOrder = order })
	end

	local function renderParts(p: any)
		section("EQUIPPED SLOTS · one item per slot", 1)
		local slots = UI.frame(list, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 })
		local gl = UI.new("UIGridLayout", { CellSize = UDim2.new(if UI.size().X > 700 then 0.25 else 0.5, -8, 0, 96), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, slots)
		for i, slot in Config.PartSlots do
			local id = p.equipped[slot]
			local def = id ~= "" and Config.FindById(Config.Parts, id)
			local c = UI.frame(slots, { BackgroundColor3 = if def then Color3.fromRGB(15, 55, 45) else T.card, LayoutOrder = i })
			UI.corner(c, 10)
			UI.stroke(c, if def then T.green else T.line, if def then 2 else 1)
			UI.pad(c, 8, 10)
			UI.label(c, string.upper(Config.SlotNames[slot]), 12, { Font = UI.Bold, TextColor3 = T.dim })
			UI.label(c, if def then def.name else "Empty slot", 15, { Font = UI.Bold, Position = UDim2.fromOffset(0, 18), TextColor3 = if def then T.green else T.dim })
			if def then
				local ub = UI.button(c, "Unequip", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 34), TextSize = 13 })
				ub.Activated:Connect(function() W.act(ub, "unequip", { slot = slot }, "…") end)
			end
		end
		section("OWNED PARTS", 3)
		local any = false
		for i, part in Config.Parts do
			if p.parts[part.id] then
				any = true
				local equipped = p.equipped[part.slot] == part.id
				local row = UI.frame(list, { BackgroundColor3 = if equipped then Color3.fromRGB(15, 55, 45) else T.card, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = 10 + i })
				UI.corner(row, 10)
				if equipped then UI.stroke(row, T.green, 2) end
				UI.pad(row, 8, 12)
				UI.label(row, part.name .. (if equipped then "  · EQUIPPED" else "  · Owned"), 16, { Font = UI.Bold, Size = UDim2.new(1, -140, 0, 22), AutomaticSize = Enum.AutomaticSize.None, TextColor3 = if equipped then T.green else T.text, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false })
				UI.label(row, Config.SlotNames[part.slot] .. " · " .. partEffects(part), 13, { TextColor3 = T.cyan, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, -140, 0, 18), AutomaticSize = Enum.AutomaticSize.None, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false })
				local b = UI.button(row, if equipped then "Unequip" else "Equip", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(120, 40), TextSize = 14 })
				UI.style(b, if equipped then "" else "primary")
				if not first then first = b end
				b.Activated:Connect(function()
					if equipped then W.act(b, "unequip", { slot = part.slot }, "…") else W.act(b, "equip", { id = part.id }, "…") end
				end)
			end
		end
		if not any then UI.label(list, "You don't own any parts yet. Buy motors, boosts, wheels and cosmetics in the Shop.", 14, { TextColor3 = T.dim, LayoutOrder = 9 }) end
		section("NOT OWNED", 50)
		for i, part in Config.Parts do
			if not p.parts[part.id] then
				local row = UI.frame(list, { BackgroundColor3 = Color3.fromRGB(20, 20, 34), Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 60 + i })
				UI.corner(row, 10)
				UI.pad(row, 6, 12)
				UI.label(row, part.name .. " · " .. Config.SlotNames[part.slot] .. " · " .. partEffects(part) .. "  —  " .. (if part.exclusive then "Day 7 reward" else "Unavailable: buy in Shop"), 13, { TextColor3 = Color3.fromRGB(110, 110, 140), Size = UDim2.fromScale(1, 1), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false })
			end
		end
	end

	local function renderDrivers(p: any)
		section("CHOOSE YOUR DRIVER", 1)
		for i, d in Config.Drivers do
			local owned = p.drivers[d.id] == true
			local rentLeft = (p.rentals[d.id] or 0) - Store.now()
			local available = owned or rentLeft > 0
			local selected = p.driver == d.id
			local row = UI.frame(list, { BackgroundColor3 = if selected then Color3.fromRGB(16, 60, 80) elseif available then T.card else Color3.fromRGB(20, 20, 34), Size = UDim2.new(1, 0, 0, 64), LayoutOrder = 1 + i })
			UI.corner(row, 10)
			if selected then UI.stroke(row, T.cyan, 2) end
			UI.pad(row, 8, 10)
			local pf = UI.portrait(row, 0, d.name, 44, d.color)
			local tagLabel = pf:FindFirstChild("TextLabel", true)
			for _, c in pf:GetChildren() do if c:IsA("TextLabel") and c.Text == "BOT" then c:Destroy() end end
			local _ = tagLabel
			local status = if selected then "SELECTED" elseif owned then "Owned" elseif rentLeft > 0 then "Rented · " .. Config.Clock(rentLeft) .. " left" else "Unavailable · buy or rent in Drivers"
			UI.label(row, d.name .. "  ·  " .. status, 15, { Font = UI.Bold, Position = UDim2.fromOffset(54, 2), Size = UDim2.new(1, -190, 0, 22), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = if available then T.text else Color3.fromRGB(110, 110, 140) })
			UI.label(row, string.format("+%d speed · +%d handling · +%d boost", d.stats.speed, d.stats.handling, d.stats.boost), 13, { TextColor3 = T.dim, Position = UDim2.fromOffset(54, 26), Size = UDim2.new(1, -190, 0, 18), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false })
			local b = UI.button(row, if selected then "Selected" elseif available then "Select" else "Unavailable", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(120, 42), TextSize = 14 })
			UI.style(b, if selected then "good" elseif available then "primary" else "disabled")
			if not available then b:SetAttribute("DisabledReason", "Buy or rent " .. d.name .. " in the Drivers panel.") end
			if not first then first = b end
			b.Activated:Connect(function()
				if b:GetAttribute("Disabled") or selected then return end
				W.act(b, "driver_select", { id = d.id }, "…")
			end)
		end
	end

	render = function()
		local p = Store.profile
		if not p then return end
		refreshTabs()
		local sel = game:GetService("GuiService").SelectedObject
		local selName = sel and sel:IsDescendantOf(list) and sel.Parent and (sel.Parent :: any).LayoutOrder
		W.clear(list)
		first = nil
		if tab == "parts" then renderParts(p) else renderDrivers(p) end
		if selName and UI.gamepad() then
			for _, c in list:GetChildren() do
				if c:IsA("Frame") and c.LayoutOrder == selName then
					local b = c:FindFirstChildOfClass("TextButton")
					if b then UI.focus(b) end
				end
			end
		end
	end
	P.onOpen = render
	P.firstFocus = function() return first end
	Store.profileChanged.Event:Connect(function() if UI.current == P then render() end end)
end

-- DRIVERS (ownership & rental) ------------------------------------------------------
do
	local P = UI.panel("drivers", "Drivers", T.amber)
	local group = "All"
	local compare: string? = nil
	local render: () -> ()
	local top = UI.frame(P.body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 74) })
	UI.list(top, false, 4)
	W.wallet(top, 1)
	local gopts = { { id = "All", label = "All groups" } }
	for _, g in Config.DriverGroups do table.insert(gopts, { id = g, label = g }) end
	local _, refreshChips = W.chips(top, gopts, function() return group end, function(id) group = id render() end, 2)
	local list = W.scroll(P.body, { Position = UDim2.fromOffset(0, 80), Size = UDim2.new(1, 0, 1, -80) }, 8)
	local first: TextButton? = nil

	local function confirmSpend(d: any, kind: string, btn: TextButton)
		local price = if kind == "buy" then d.buy else d.rent
		local text = (if kind == "buy" then "Buy " .. d.name .. " permanently" else "Rent " .. d.name .. " for 10 minutes") .. " for " .. Config.PriceText(price) .. "?"
		UI.confirm({
			title = if kind == "buy" then "Buy driver" else "Rent driver",
			body = text,
			confirm = (if kind == "buy" then "Buy · " else "Rent · ") .. Config.PriceText(price),
			live = function()
				local ok = Store.affordable(price)
				return text .. "\n" .. Store.walletLine(), ok, if ok then nil else "Not enough funds for this."
			end,
		}, function(yes)
			if yes then W.act(btn, if kind == "buy" then "driver_buy" else "driver_rent", { id = d.id }, "…") else UI.toast("Cancelled. Nothing was spent.") end
		end)
	end

	render = function()
		local p = Store.profile
		if not p then return end
		refreshChips()
		W.clear(list)
		first = nil
		local cur = Config.FindById(Config.Drivers, p.driver) or Config.Drivers[1]
		UI.label(list, "Current driver: " .. cur.name .. ". Tap Compare to see the difference.", 14, { TextColor3 = T.dim, LayoutOrder = 0 })
		local order = 0
		for _, g in Config.DriverGroups do
			if group == "All" or group == g then
				order += 1
				UI.label(list, string.upper(g), 15, { Font = UI.Title, TextColor3 = T.amber, LayoutOrder = order * 100 })
				for i, d in Config.Drivers do
					if d.group == g then
						local owned = p.drivers[d.id] == true
						local rentLeft = (p.rentals[d.id] or 0) - Store.now()
						local card = UI.frame(list, { BackgroundColor3 = T.card, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order * 100 + i })
						UI.corner(card, 12)
						UI.stroke(card, if p.driver == d.id then T.cyan elseif owned then T.green elseif rentLeft > 0 then T.amber else T.line, if p.driver == d.id then 2 else 1)
						UI.pad(card, 10, 12)
						local pf = UI.portrait(card, 0, d.name, 48, d.color)
						for _, c in pf:GetChildren() do if c:IsA("TextLabel") and c.Text == "BOT" then c:Destroy() end end
						local info = UI.frame(card, { BackgroundTransparency = 1, Position = UDim2.fromOffset(60, 0), Size = UDim2.new(1, -60, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
						UI.list(info, false, 4)
						local status = if owned then "OWNED" elseif rentLeft > 0 then "RENTED · " .. Config.Clock(rentLeft) .. " left" else "Not owned"
						UI.label(info, d.name .. "   " .. status, 16, { Font = UI.Bold, LayoutOrder = 1, TextColor3 = if owned then T.green elseif rentLeft > 0 then T.amber else T.text })
						UI.label(info, d.desc .. string.format("  ·  +%d speed, +%d handling, +%d boost", d.stats.speed, d.stats.handling, d.stats.boost), 13, { TextColor3 = T.dim, LayoutOrder = 2 })
						if compare == d.id then
							local function diff(a: number, b: number): string
								local v = a - b
								return (if v >= 0 then "+" else "") .. v
							end
							UI.label(info, "vs " .. cur.name .. ":  speed " .. diff(d.stats.speed, cur.stats.speed) .. ", handling " .. diff(d.stats.handling, cur.stats.handling) .. ", boost " .. diff(d.stats.boost, cur.stats.boost), 13, { Font = UI.Bold, TextColor3 = T.cyan, LayoutOrder = 3 })
						end
						local row = UI.frame(info, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4 })
						local rl = UI.list(row, true, 6)
						rl.Wraps = true
						local cmp = UI.button(row, if compare == d.id then "Hide compare" else "Compare", { Size = UDim2.fromOffset(120, 40), TextSize = 13, LayoutOrder = 1 })
						if not first then first = cmp end
						cmp.Activated:Connect(function() compare = if compare == d.id then nil else d.id render() end)
						if not owned and d.buy then
							local bb = UI.button(row, "Buy · " .. Config.PriceText(d.buy), { Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X, TextSize = 13, LayoutOrder = 2 })
							UI.pad(bb, 0, 12)
							UI.style(bb, if Store.affordable(d.buy) then "primary" else "disabled")
							bb:SetAttribute("DisabledReason", "Not enough funds to buy " .. d.name .. ".")
							bb.Activated:Connect(function() if not bb:GetAttribute("Disabled") then confirmSpend(d, "buy", bb) end end)
						end
						if not owned and d.rent and rentLeft <= 0 then
							local rb = UI.button(row, "Rent 10 min · " .. Config.PriceText(d.rent), { Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X, TextSize = 13, LayoutOrder = 3 })
							UI.pad(rb, 0, 12)
							UI.style(rb, if Store.affordable(d.rent) then "" else "disabled")
							rb:SetAttribute("DisabledReason", "Not enough funds to rent " .. d.name .. ".")
							rb.Activated:Connect(function() if not rb:GetAttribute("Disabled") then confirmSpend(d, "rent", rb) end end)
						end
						if (owned or rentLeft > 0) and p.driver ~= d.id then
							local sb = UI.button(row, "Equip driver", { Size = UDim2.fromOffset(130, 40), TextSize = 13, LayoutOrder = 4 })
							UI.style(sb, "good")
							sb.Activated:Connect(function() W.act(sb, "driver_select", { id = d.id }, "…") end)
						elseif p.driver == d.id then
							W.tag(row, "EQUIPPED", T.cyan, 5)
						end
					end
				end
			end
		end
	end
	P.onOpen = render
	P.firstFocus = function() return first end
	Store.profileChanged.Event:Connect(function() if UI.current == P then render() end UI.refreshDialog() end)
	task.spawn(function()
		while true do
			task.wait(1)
			local p = Store.profile
			if UI.current == P and p and next(p.rentals) ~= nil and not UI.dialogOpen then
				local sel = game:GetService("GuiService").SelectedObject
				if not sel then render() end
			end
		end
	end)
end

return Panels
]]></ProtectedString>
						<string name="ScriptGuid">{9F5F9BEE-356C-4C72-8EF5-6DDDBB2FF3C9}</string>
