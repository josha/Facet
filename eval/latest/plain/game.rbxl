						<ProtectedString name="Source"><![CDATA[--!strict
-- Hub HUD: wallet, level, races, income, league progress, save status, dock and race entry.
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local UI = require(script.Parent.UI)
local Store = require(script.Parent.Store)
local Net = RS:WaitForChild("Net")
local RNotice = Net:WaitForChild("Notice") :: RemoteEvent
local T = UI.T

local Hud = {}
Hud.dock = {} :: { [string]: TextButton }

local root = UI.frame(UI.gui, { Name = "Hud", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2 })
Hud.root = root

-- Status bar ------------------------------------------------------------
local bar = UI.frame(root, {
	Name = "Status", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 6),
	Size = UDim2.new(0.62, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
})
Hud.status = bar
local barList = UI.list(bar, true, 6, Enum.HorizontalAlignment.Right)
barList.Wraps = true

local function chip(order: number, accent: Color3): (Frame, TextLabel)
	local c = UI.frame(bar, { BackgroundColor3 = T.panel, BackgroundTransparency = 0.12, Size = UDim2.fromOffset(0, 34), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = order })
	UI.corner(c, 17)
	UI.stroke(c, accent, 1.5, 0.3)
	UI.pad(c, 0, 12)
	UI.list(c, true, 6, nil, Enum.VerticalAlignment.Center)
	local dot = UI.frame(c, { BackgroundColor3 = accent, Size = UDim2.fromOffset(10, 10), LayoutOrder = 0 })
	UI.corner(dot, 5)
	local l = UI.label(c, "", 15, { Font = UI.Bold, Size = UDim2.fromOffset(0, 34), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, TextYAlignment = Enum.TextYAlignment.Center, LayoutOrder = 1 })
	return c, l
end
local _, creditsL = chip(1, T.amber)
local _, shardsL = chip(2, T.violet)
local lvlChip, lvlL = chip(3, T.cyan)
local xpBg = UI.frame(lvlChip, { BackgroundColor3 = T.card2, Size = UDim2.fromOffset(70, 6), LayoutOrder = 2 })
UI.corner(xpBg, 3)
local xpFill = UI.frame(xpBg, { BackgroundColor3 = T.cyan, Size = UDim2.fromScale(0, 1) })
UI.corner(xpFill, 3)
local _, racesL = chip(4, T.green)
local leagueChip, leagueL = chip(5, T.magenta)
local lgBg = UI.frame(leagueChip, { BackgroundColor3 = T.card2, Size = UDim2.fromOffset(60, 6), LayoutOrder = 2 })
UI.corner(lgBg, 3)
local lgFill = UI.frame(lgBg, { BackgroundColor3 = T.magenta, Size = UDim2.fromScale(0, 1) })
UI.corner(lgFill, 3)
local _, saveL = chip(6, T.dim)

local dailyPill = UI.button(bar, "★ Daily ready", { Size = UDim2.fromOffset(150, 34), LayoutOrder = 0, TextSize = 14, Visible = false })
UI.style(dailyPill, "magenta")
Hud.dailyPill = dailyPill

-- Dock ------------------------------------------------------------------
local dock = UI.new("ScrollingFrame", {
	Name = "Dock", BackgroundColor3 = T.panel, BackgroundTransparency = 0.15, BorderSizePixel = 0, ScrollBarThickness = 4,
	ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(),
	ScrollBarImageColor3 = T.cyan, Selectable = false,
}, root)
UI.corner(dock, 14)
UI.stroke(dock, T.line, 1, 0.3)
UI.pad(dock, 6, 8)
UI.list(dock, true, 6, nil, Enum.VerticalAlignment.Center)
Hud.dockFrame = dock

local entries = {
	{ "garage", "Garage", T.cyan }, { "shop", "Shop", T.magenta }, { "inventory", "Inventory", T.green }, { "drivers", "Drivers", T.amber },
	{ "livery", "Livery", T.violet }, { "upgrades", "Upgrades", T.cyan }, { "crates", "Crates", T.amber }, { "daily", "Daily", T.magenta },
	{ "missions", "Missions", T.green }, { "party", "Party", T.violet }, { "settings", "Settings", T.dim }, { "help", "Help", T.cyan },
}
Hud.opener = function(_: string, _: GuiObject?) end
for i, e in entries do
	local b = UI.button(dock, e[2], { Name = e[1], Size = UDim2.fromOffset(98, 52), LayoutOrder = i, TextSize = 14 })
	UI.new("Frame", { BackgroundColor3 = e[3], BorderSizePixel = 0, Size = UDim2.new(0.5, 0, 0, 3), Position = UDim2.new(0.25, 0, 1, -7) }, b)
	local badge = UI.frame(b, { Name = "Badge", BackgroundColor3 = T.red, Size = UDim2.fromOffset(14, 14), Position = UDim2.new(1, -16, 0, 3), Visible = false, ZIndex = 3 })
	UI.corner(badge, 7)
	UI.stroke(badge, T.text, 1.5)
	b.Activated:Connect(function()
		Hud.opener(e[1], b)
	end)
	Hud.dock[e[1]] = b
end

local raceBtn = UI.button(root, "RACE", { Name = "RaceButton", Size = UDim2.fromOffset(200, 64), TextSize = 22, Font = UI.Title })
UI.style(raceBtn, "primary")
raceBtn.Activated:Connect(function() Hud.opener("queue", raceBtn) end)
Hud.dock.queue = raceBtn
local raceSub = UI.label(raceBtn, "", 11, { Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -16), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = T.dark, Font = UI.Bold })
dailyPill.Activated:Connect(function() Hud.opener("daily", dailyPill) end)

-- Chat feed (quick chat messages) ---------------------------------------
local feed = UI.frame(UI.overlay, { Name = "ChatFeed", BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0.32, 0), Size = UDim2.new(0, 280, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
UI.list(feed, false, 4)
Hud.chatFeed = feed
function Hud.chatMessage(from: string, text: string, userId: number)
	local row = UI.frame(feed, { BackgroundColor3 = T.panel, BackgroundTransparency = 0.15, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	UI.corner(row, 8)
	UI.pad(row, 6, 8)
	UI.stroke(row, T.cyan, 1, 0.5)
	UI.label(row, from .. ": " .. text, 15, { Font = UI.Bold, RichText = false })
	task.delay(7, function() if row.Parent then row:Destroy() end end)
	while #feed:GetChildren() > 5 do
		for _, c in feed:GetChildren() do if c:IsA("Frame") then c:Destroy() break end end
	end
end

-- Layout ------------------------------------------------------------------
local function layout()
	local size = UI.size()
	local touch = UI.touch()
	local portrait = size.Y > size.X
	bar.Size = UDim2.new(if portrait or size.X < 900 then 1 else 0.62, -16, 0, 0)
	if touch then
		-- touch controls own the bottom corners; keep the dock high and the race button mid-right
		dock.AnchorPoint = Vector2.new(0.5, 0)
		dock.Position = UDim2.new(0.5, 0, 0, bar.AbsoluteSize.Y + 12)
		dock.Size = UDim2.new(1, -16, 0, 68)
		raceBtn.AnchorPoint = Vector2.new(1, 0.5)
		raceBtn.Position = UDim2.new(1, -12, if portrait then 0.58 else 0.5, 0)
		raceBtn.Size = UDim2.fromOffset(if portrait then 150 else 170, 60)
	else
		dock.AnchorPoint = Vector2.new(0.5, 1)
		dock.Position = UDim2.new(0.5, if size.X > 1100 then -110 else 0, 1, -10)
		dock.Size = UDim2.new(if size.X > 1100 then 1 else 1, if size.X > 1100 then -250 else -16, 0, 68)
		raceBtn.AnchorPoint = Vector2.new(1, 1)
		raceBtn.Position = if size.X > 1100 then UDim2.new(1, -12, 1, -12) else UDim2.new(1, -12, 1, -88)
		raceBtn.Size = UDim2.fromOffset(210, 64)
	end
	feed.Position = if touch then UDim2.new(0, 10, 0.36, 0) else UDim2.new(0, 10, 0.4, 0)
end
UI.layoutChanged.Event:Connect(layout)
bar:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
task.defer(layout)

-- Data --------------------------------------------------------------------
local function leagueInfo(races: number): (string, number)
	local cur, nxt = Config.Leagues[1], nil
	for i, lg in Config.Leagues do
		if races >= lg.races then cur, nxt = lg, Config.Leagues[i + 1] end
	end
	if not nxt then return cur.name .. " (max)", 1 end
	return string.format("%s %d/%d", cur.name, races - cur.races, nxt.races - cur.races), (races - cur.races) / (nxt.races - cur.races)
end
Hud.leagueInfo = leagueInfo

local function questsClaimable(p: any): boolean
	for _, q in Config.Quests do
		if not p.questsClaimed[q.id] and (p.stats[q.stat] or 0) >= q.goal then return true end
	end
	return false
end

function Hud.refresh()
	local p = Store.profile
	if not p then return end
	creditsL.Text = Config.Short(p.credits) .. " Credits"
	shardsL.Text = Config.Short(p.shards) .. " Shards"
	lvlL.Text = "Lv " .. p.level
	xpFill.Size = UDim2.fromScale(math.clamp(p.xp / p.xpNeeded, 0, 1), 1)
	racesL.Text = p.races .. " races" .. (if p.lastIncome > 0 then "  ·  last +" .. Config.Short(p.lastIncome) else "")
	local lname, lfrac = leagueInfo(p.races)
	leagueL.Text = lname
	lgFill.Size = UDim2.fromScale(math.clamp(lfrac, 0, 1), 1)
	local st = p.save.state
	saveL.Text = if st == "saving" then "Saving…" elseif st == "failed" then "Save failed" elseif st == "session" then "Saved (session)" else "Saved"
	saveL.TextColor3 = if st == "failed" then T.red elseif st == "saving" then T.amber else T.dim
	local ready = p.dailyState.ready
	dailyPill.Visible = ready and Store.mode == "hub"
	Hud.dock.daily.Badge.Visible = ready
	Hud.dock.missions.Badge.Visible = questsClaimable(p)
end
Store.profileChanged.Event:Connect(Hud.refresh)

function Hud.refreshLobby()
	local s = Store.lobby
	if not s then return end
	local inQ = false
	for _, q in s.queue do if q.userId == game.Players.LocalPlayer.UserId then inQ = true end end
	if inQ and (s.phase == "queue" or s.phase == "starting") then
		raceBtn.Text = "IN QUEUE"
		raceSub.Text = #s.queue .. "/" .. s.required .. " · " .. s.mode
	elseif s.phase == "racing" or s.phase == "countdown" or s.phase == "results" then
		raceBtn.Text = "RACE"
		raceSub.Text = "race in progress"
	else
		raceBtn.Text = "RACE"
		raceSub.Text = "Solo · Duo"
	end
end
Store.lobbyChanged.Event:Connect(Hud.refreshLobby)

local function applyMode()
	local hub = Store.mode == "hub"
	dock.Visible = hub
	raceBtn.Visible = hub
	bar.Visible = Store.mode ~= "race"
	Hud.refresh()
end
Store.modeChanged.Event:Connect(applyMode)

RNotice.OnClientEvent:Connect(function(kind, data)
	if kind == "toast" then
		UI.toast(data.text, data.kind)
	elseif kind == "chat" then
		Hud.chatMessage(data.from, data.text, data.userId)
	end
end)

task.spawn(function()
	while true do
		task.wait(1)
		Hud.refresh()
	end
end)

return Hud
]]></ProtectedString>
