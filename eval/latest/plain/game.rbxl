local cwTitle=label(chatWheel,"QUICK CHAT / 8 SIGNALS",18);cwTitle.Font=Enum.Font.GothamBold;cwTitle.Position=UDim2.fromOffset(16,10);cwTitle.Size=UDim2.new(1,-32,0,30);cwTitle.ZIndex=36
