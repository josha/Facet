				<ProtectedString name="Source"><![CDATA[--!strict
-- Entry point: wires remotes to validated server actions.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Server = script.Parent:WaitForChild("Server")
local DataService = require(Server.DataService)
local RaceService = require(Server.RaceService)
local Remotes = RS:WaitForChild("Remotes")

local inFlight: { [Player]: number } = {}

Remotes.Request.OnServerInvoke = function(player: Player, action: any, args: any): any
	if type(action) ~= "string" then return { ok = false, err = "Bad request" } end
	local handler = DataService.Actions[action]
	if not handler then return { ok = false, err = "Unknown action" } end
	if not DataService.Profiles[player] then return { ok = false, err = "Profile loading" } end
	if type(args) ~= "table" then args = {} end
	inFlight[player] = (inFlight[player] or 0) + 1
	if inFlight[player] > 6 then
		inFlight[player] -= 1
		return { ok = false, err = "Slow down" }
	end
	local ok, result = pcall(handler, player, args)
	inFlight[player] -= 1
	if not ok then
		warn("Action failed", action, result)
		return { ok = false, err = "Server error" }
	end
	return result
end

local function onPlayer(player: Player)
	DataService.Load(player)
	RaceService.Broadcast()
	player.CharacterAdded:Connect(function()
		RaceService.OnCharacter(player)
	end)
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onPlayer, p) end
Players.PlayerRemoving:Connect(function(p) inFlight[p] = nil end)
]]></ProtectedString>
