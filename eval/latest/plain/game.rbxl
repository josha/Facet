			</Item>
			<Item class="ModuleScript" referent="RBX21F5ADAD2D414575B4B6067330C08C6D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Lobby queues, track voting and the server-authoritative kart simulation (players and AI opponents).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Shared.Config)
local Profiles = require(script.Parent.Profiles)
local Remotes = RS:WaitForChild("Remotes")
local Assets = RS:WaitForChild("Assets")

local Race = {}
local now = Profiles.now

local HUB_CF = CFrame.new(0, 4, 30)
local QUEUE_COUNTDOWN = 5
local VOTE_SECONDS = 15
local WINNER_SECONDS = 3
local COUNTDOWN_SECONDS = 4
local RESULTS_SECONDS = 25

-- Track geometry --------------------------------------------------------
type TrackGeo = { id: string, def: any, path: { Vector3 }, rights: { Vector3 }, dirs: { Vector3 }, seg: { number }, n: number, hw: number, pads: { [number]: boolean } }
local geoCache: { [string]: TrackGeo } = {}
local function geo(trackId: string): TrackGeo
	local g = geoCache[trackId]
	if g then return g end
	local def = Config.getTrack(trackId) :: any
	local path = Config.getPath(trackId)
	local n = #path
	local rights, dirs, seg = {}, {}, {}
	for i = 1, n do
		local d = path[i % n + 1] - path[i]
		seg[i] = d.Magnitude
		local u = d.Unit
		dirs[i] = u
		rights[i] = Vector3.new(-u.Z, 0, u.X)
	end
	local pads = {}
	for _, idx in def.pads do
		for o = 0, 4 do pads[idx + o] = true end
	end
	local result: TrackGeo = { id = trackId, def = def, path = path, rights = rights, dirs = dirs, seg = seg, n = n, hw = def.width / 2, pads = pads }
	geoCache[trackId] = result
	return result
end

local function locate(g: TrackGeo, pos: Vector3, guess: number): number
	local best, bestD = guess, math.huge
	for o = -8, 14 do
		local i = (guess - 1 + o) % g.n + 1
		local d = (g.path[i] - pos) * Vector3.new(1, 0, 1)
		local m2 = d:Dot(d)
		if m2 < bestD then best, bestD = i, m2 end
	end
	if bestD > (g.hw * 3) ^ 2 then
		for i = 1, g.n do
			local d = (g.path[i] - pos) * Vector3.new(1, 0, 1)
			local m2 = d:Dot(d)
			if m2 < bestD then best, bestD = i, m2 end
		end
	end
	-- prefer the segment the kart is actually on
	local rel = pos - g.path[best]
	if rel:Dot(g.dirs[best]) < 0 then
		best = (best - 2) % g.n + 1
	end
	return best
end

-- Sessions --------------------------------------------------------------
local sessions: { any } = {}
local playerSession: { [Player]: any } = {}
local sessionCounter = 0

local function rarityColor(name: string): Color3
	return Config.colorOf(name, 100)
end

local function setLivery(model: Model, livery: any, cosmetics: { [string]: boolean })
	local bodyC = Config.colorOf(livery.body, livery.bodyShade)
	local accC = Config.colorOf(livery.accent, livery.accentShade)
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			if p.Name == "Body" or p.Name == "Nose" then
				p.Color = bodyC
			elseif string.sub(p.Name, 1, 6) == "Accent" then
				p.Color = accC
			end
		end
	end
	local glow = model:FindFirstChild("Glow") :: BasePart
	local glowColor = if cosmetics.Magenta then Color3.fromRGB(255, 40, 200) else accC
	glow.Color = glowColor;
	(glow:FindFirstChild("GlowLight") :: PointLight).Color = glowColor
	local spoilerOn = cosmetics.Spoiler == true;
	(model:FindFirstChild("Spoiler") :: BasePart).Transparency = if spoilerOn then 0.35 else 1;
	(model:FindFirstChild("SpoilerStrut") :: BasePart).Transparency = if spoilerOn then 0 else 1
	local body = model:FindFirstChild("Body") :: BasePart;
	(body:FindFirstChild("Trail") :: Trail).Enabled = cosmetics.Trail == true
	local glyph = (model:FindFirstChild("Hood") :: any).Decal.Glyph :: TextLabel
	glyph.Text = Config.decalGlyph(livery.decal)
end
Race.setLivery = setLivery

local function makeKartModel(name: string, livery: any, cosmetics: any, tagColor: Color3): Model
	local model = (Assets:FindFirstChild("Kart") :: Model):Clone()
	local body = model.PrimaryPart :: BasePart
	body.Anchored = true
	setLivery(model, livery, cosmetics or {})
	local tag = (body:FindFirstChild("Tag") :: BillboardGui)
	local label = tag:FindFirstChild("Name") :: TextLabel
	label.Text = name
	label.TextColor3 = tagColor
	return model
end

local function gridSpot(g: TrackGeo, slot: number): (Vector3, number)
	local row = slot // 2
	local col = slot % 2
	local back = 16 + row * 14
	local idx = g.n
	local acc = 0
	while acc < back do
		acc += g.seg[idx]
		idx -= 1
		if idx < 1 then idx = g.n end
	end
	local p = g.path[idx] + g.rights[idx] * (if col == 0 then -9 else 9)
	local d = g.dirs[idx]
	local yaw = math.atan2(-d.X, -d.Z)
	return p, yaw
end

local function statsFor(loadout: any): any
	local k = loadout.kart
	return {
		maxSpeed = (68 + k.speed * 5) * loadout.speedMul,
		accel = (26 + k.accel * 4),
		turn = (1.35 + k.handling * 0.12) * loadout.handlingMul,
		boostMul = (1.22 + k.boost * 0.03) * loadout.boostMul,
	}
end

local function newKart(session: any, info: any, slot: number): any
	local g = session.geo
	local pos, yaw = gridSpot(g, slot)
	local model = makeKartModel(info.name, info.livery, info.cosmetics, info.tagColor)
	model.Name = "Kart_" .. info.key
	model:PivotTo(CFrame.new(pos + Vector3.new(0, 1.4, 0)) * CFrame.Angles(0, yaw, 0))
	model.Parent = session.folder
	local k = {
		key = info.key, name = info.name, userId = info.userId or 0, isBot = info.isBot == true, isParty = info.isParty == true,
		player = info.player, model = model, body = model.PrimaryPart,
		pos = pos, yaw = yaw, speed = 0, idx = locate(g, pos, g.n - 3), lap = 0, half = true,
		finished = false, finishTime = 0, out = false, outLap = 0, outOrder = 0,
		input = { t = 0, s = 0, drift = false, boostSeq = 0 }, lastBoostSeq = 0,
		drifting = false, driftDir = 0, driftTime = 0, boostTimer = 0, energy = 60, padCd = 0, recoverCd = 0, wallCd = 0,
		stats = statsFor(info.loadout), skill = info.skill or 1, lane = info.lane or 0, aiBoostCd = 3,
		progress = 0, turbos = 0, visualDrift = 0, fxBoost = false, fxDrift = false, kartName = info.loadout.kart.name, driver = info.loadout.driver,
	}
	k.progress = k.lap * g.n + k.idx
	return k
end

local function attachCharacter(k: any)
	local player = k.player :: Player?
	if not player then return end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (hrp and hum) then return end
	local old = hrp:FindFirstChild("KartWeld")
	if old then old:Destroy() end
	hum.Sit = true
	hum.JumpHeight = 0
	hum.JumpPower = 0
	local seat = (k.body :: BasePart):FindFirstChild("SeatPoint") :: Attachment
	hrp.CFrame = (k.body :: BasePart).CFrame * seat.CFrame
	local w = Instance.new("WeldConstraint")
	w.Name = "KartWeld"
	w.Part0 = k.body
	w.Part1 = hrp
	w.Parent = hrp
end

local function returnToHub(player: Player)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hrp then
		local w = hrp:FindFirstChild("KartWeld")
		if w then w:Destroy() end
		hrp.Anchored = false
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = HUB_CF * CFrame.new(math.random(-6, 6), 0, math.random(-4, 4))
	end
	if hum then
		hum.Sit = false
		hum.JumpHeight = 7.2
		hum.JumpPower = 50
	end
end

local function removeSessionPlayer(session: any, player: Player)
	warn("[DBG] removeSessionPlayer", debug.traceback())
	playerSession[player] = nil
	session.humans[player] = nil
	returnToHub(player)
	Remotes.Race:FireClient(player, { phase = "none" })
end

local function feed(session: any, text: string)
	table.insert(session.feed, 1, { text = text, t = now() })
	while #session.feed > 4 do table.remove(session.feed) end
end

local function standings(session: any): { any }
	local list = table.clone(session.karts)
	table.sort(list, function(a, b)
		if a.finished ~= b.finished then return a.finished end
		if a.finished then return a.finishTime < b.finishTime end
		if a.out ~= b.out then return not a.out end
		if a.out then return a.outOrder > b.outOrder end
		if a.progress ~= b.progress then return a.progress > b.progress end
		return a.key < b.key
	end)
	return list
end

local function fmtTime(t: number): string
	return string.format("%d:%05.2f", t // 60, t % 60)
end

local function finishRace(session: any)
	warn("[DBG] finishRace", debug.traceback())
	if session.phase == "results" then return end
	session.phase = "results"
	session.resultsAt = now()
	local order = standings(session)
	local rows = {}
	for i, k in order do
		k.place = i
		local state = if k.finished then fmtTime(k.finishTime) elseif k.out then ("OUT · Lap " .. k.outLap) else "DNF"
		table.insert(rows, { place = i, name = k.name, key = k.key, userId = k.userId, bot = k.isBot, party = k.isParty, state = state, kart = k.kartName })
		k.speed = 0
	end
	for player, k in session.humans do
		local reward = { soft = 0, hard = 0, xp = 0, levelUp = false }
		local p = Profiles.get(player)
		if p and not session.rewarded[player.UserId] then
			session.rewarded[player.UserId] = true
			local place = math.clamp(k.place, 1, 6)
			local soft = Config.RaceRewards.soft[place]
			local xp = Config.RaceRewards.xp[place]
			local hard = Config.RaceRewards.hard[place]
			if p.boosts.cr50 and now() < p.boosts.cr50 then soft = math.floor(soft * 1.5) end
			if p.boosts.xp2 and now() < p.boosts.xp2 then xp *= 2 end
			local beforeLevel = p.level
			Profiles.grant(p, soft, hard)
			Profiles.addXp(p, xp)
			p.races += 1
			if place == 1 then p.wins += 1 end
			p.lastIncome = soft
			Profiles.questProgress(p, "race3", 1)
			if place <= 3 then Profiles.questProgress(p, "podium", 1) end
			if k.turbos > 0 then Profiles.questProgress(p, "drift", k.turbos) end
			reward = { soft = soft, hard = hard, xp = xp, levelUp = p.level > beforeLevel, level = p.level }
			Profiles.changed(player)
		end
		Remotes.Race:FireClient(player, { phase = "results", rows = rows, myKey = k.key, place = k.place, reward = reward, track = session.geo.def.name, mode = session.geo.def.mode, closesAt = now() + RESULTS_SECONDS })
	end
end

local function eliminate(session: any, lapDone: number)
	local order = standings(session)
	for i = #order, 1, -1 do
		local k = order[i]
		if not k.finished and not k.out then
			local active = 0
			for _, o in session.karts do if not o.out and not o.finished then active += 1 end end
			if active <= 1 then return end
			k.out = true
			k.outLap = lapDone
			session.outCount += 1
			k.outOrder = session.outCount
			k.speed = 0
			for _, p in k.model:GetDescendants() do
				if p:IsA("BasePart") and p.Transparency < 1 then p.Transparency = math.max(p.Transparency, 0.75) end
			end
			feed(session, k.name .. " is OUT (last after lap " .. lapDone .. ")")
			return
		end
	end
end

local function aiInput(session: any, k: any, dt: number)
	local g = session.geo
	local look = 5 + math.floor(math.max(k.speed, 0) / 25)
	local ti = (k.idx - 1 + look) % g.n + 1
	local target = g.path[ti] + g.rights[ti] * k.lane
	local cf = CFrame.new(k.pos) * CFrame.Angles(0, k.yaw, 0)
	local rel = cf:PointToObjectSpace(target)
	local steer = math.clamp(rel.X / math.max(6, -rel.Z) * 2.4, -1, 1)
	local throttle = 1
	if math.abs(steer) > 0.75 and k.speed > k.stats.maxSpeed * 0.7 then throttle = 0.2 end
	k.input.t = throttle
	k.input.s = steer
	k.input.drift = false
	k.aiBoostCd -= dt
	if k.aiBoostCd <= 0 and math.abs(steer) < 0.15 and k.energy >= 30 then
		k.aiBoostCd = 4 + math.random() * 5
		k.input.boostSeq += 1
	end
end

local function stepKart(session: any, k: any, dt: number)
	local g = session.geo
	if k.out or session.phase ~= "racing" then
		k.speed = 0
	else
		if k.isBot then aiInput(session, k, dt) end
		local inp = k.input
		if k.finished then inp = { t = 0.3, s = 0, drift = false, boostSeq = k.lastBoostSeq } end
		local maxS = k.stats.maxSpeed * k.skill
		if k.isBot and session.leaderHuman then
			local gap = k.progress - session.leaderHuman
			if gap > 12 then maxS *= 0.93 elseif gap < -25 then maxS *= 1.05 end
		end
		if inp.boostSeq ~= k.lastBoostSeq then
			k.lastBoostSeq = inp.boostSeq
			if k.energy >= 30 then
				k.energy -= 30
				k.boostTimer = math.max(k.boostTimer, 1.6)
			end
		end
		if k.boostTimer > 0 then
			k.boostTimer -= dt
			maxS *= k.stats.boostMul
			k.speed += k.stats.accel * 1.5 * dt
		end
		local t = inp.t
		if t > 0.05 then
			if k.speed < maxS then k.speed = math.min(maxS, k.speed + k.stats.accel * t * dt * (if k.speed < 0 then 3 else 1)) end
		elseif t < -0.05 then
			if k.speed > 2 then k.speed = math.max(0, k.speed - 90 * -t * dt) else k.speed = math.max(-28, k.speed - 30 * -t * dt) end
		else
			local f = 14 * dt
			if math.abs(k.speed) < f then k.speed = 0 else k.speed -= f * math.sign(k.speed) end
		end
		if k.speed > maxS then k.speed = math.max(maxS, k.speed - 40 * dt) end
		local steer = inp.s
		local yawRate
		if inp.drift and k.speed > 35 and (k.drifting or math.abs(steer) > 0.25) then
			if not k.drifting then
				k.drifting = true
				k.driftDir = if steer > 0 then 1 else -1
				k.driftTime = 0
			end
			k.driftTime += dt
			yawRate = -k.stats.turn * (k.driftDir * 0.72 + steer * 0.5) * 1.2
			k.speed -= k.speed * 0.1 * dt
			k.energy = math.min(100, k.energy + 9 * dt)
		else
			if k.drifting then
				k.drifting = false
				if k.driftTime > 0.7 then
					k.boostTimer = math.max(k.boostTimer, if k.driftTime > 1.6 then 1.5 else 0.9)
					k.turbos += 1
				end
			end
			local sf = math.clamp(math.abs(k.speed) / 22, 0, 1)
			yawRate = -k.stats.turn * steer * sf * (if k.speed >= 0 then 1 else -1)
		end
		k.yaw += yawRate * dt
		local fwd = Vector3.new(-math.sin(k.yaw), 0, -math.cos(k.yaw))
		k.pos += fwd * k.speed * dt
	end
	-- stay on the road
	local prevIdx = k.idx
	local idx = locate(g, k.pos, k.idx)
	local base = g.path[idx]
	local rel = (k.pos - base) * Vector3.new(1, 0, 1)
	local lat = rel:Dot(g.rights[idx])
	local limit = g.hw - 3.2
	if math.abs(lat) > limit then
		local over = math.abs(lat) - limit
		k.pos -= g.rights[idx] * math.sign(lat) * over
		if k.speed > 30 and k.wallCd <= 0 and k.player then
			Remotes.Notify:FireClient(k.player, { kind = "impact", amount = math.floor(k.speed * 0.25) })
			k.wallCd = 0.6
		end
		k.speed *= (1 - math.min(0.5, over * 0.08))
		-- ease heading along the wall
		local d = g.dirs[idx]
		local tYaw = math.atan2(-d.X, -d.Z)
		local diff = (tYaw - k.yaw + math.pi) % (2 * math.pi) - math.pi
		if math.abs(diff) < math.pi / 2 then k.yaw += diff * math.min(1, 4 * dt) end
	end
	k.wallCd -= dt
	k.recoverCd -= dt
	k.padCd -= dt
	if g.pads[idx] and math.abs(lat) < 7 and k.padCd <= 0 and session.phase == "racing" and not k.out then
		k.boostTimer = math.max(k.boostTimer, 1.2)
		k.energy = math.min(100, k.energy + 10)
		k.padCd = 1.2
	end
	k.pos = Vector3.new(k.pos.X, base.Y, k.pos.Z)
	-- laps
	local n = g.n
	if prevIdx > n - 20 and idx < 20 then
		if k.half then
			k.lap += 1
			k.half = false
			if session.mode == "race" and k.lap > session.laps and not k.finished and not k.out then
				k.finished = true
				k.finishTime = now() - session.startTime
				session.finishCount += 1
				if not k.isBot then session.firstHumanFinish = session.firstHumanFinish or now() end
				feed(session, k.name .. " finished P" .. session.finishCount)
			end
		end
	elseif prevIdx < 20 and idx > n - 20 then
		k.lap -= 1
		k.half = true
	end
	if idx > n * 0.4 and idx < n * 0.6 then k.half = true end
	k.idx = idx
	local along = math.clamp(rel:Dot(g.dirs[idx]) / g.seg[idx], 0, 1)
	k.progress = k.lap * n + idx + along
	k.wrongWay = false
	if k.speed > 10 then
		local fwd = Vector3.new(-math.sin(k.yaw), 0, -math.cos(k.yaw))
		k.wrongWay = fwd:Dot(g.dirs[idx]) < -0.4
	end
	-- visuals
	local targetVis = if k.drifting then k.driftDir * -0.4 else 0
	k.visualDrift += (targetVis - k.visualDrift) * math.min(1, 8 * dt)
	k.body.CFrame = CFrame.new(k.pos + Vector3.new(0, 1.4, 0)) * CFrame.Angles(0, k.yaw + k.visualDrift, 0)
	local boosting = k.boostTimer > 0
	if boosting ~= k.fxBoost then
		k.fxBoost = boosting
		for _, e in k.model:GetDescendants() do
			if e:IsA("ParticleEmitter") and e.Name == "BoostFire" then e.Enabled = boosting end
		end
	end
	if k.drifting ~= k.fxDrift then
		k.fxDrift = k.drifting
		local sp = k.model:FindFirstChild("AccentRear")
		local em = sp and sp:FindFirstChild("DriftSparks") :: ParticleEmitter?
		if em then em.Enabled = k.drifting end
	end
end

local function separate(session: any)
	local ks = session.karts
	for i = 1, #ks do
		for j = i + 1, #ks do
			local a, b = ks[i], ks[j]
			if not a.out and not b.out then
				local d = (b.pos - a.pos) * Vector3.new(1, 0, 1)
				local dist = d.Magnitude
				if dist < 6 and dist > 0.01 then
					local push = d.Unit * (6 - dist) / 2
					a.pos -= push
					b.pos += push
					a.speed *= 0.995
					b.speed *= 0.995
				end
			end
		end
	end
end

local function racerRows(session: any): { any }
	local rows = {}
	for i, k in standings(session) do
		table.insert(rows, { place = i, key = k.key, name = k.name, userId = k.userId, bot = k.isBot, party = k.isParty, lap = math.clamp(k.lap, 1, session.laps), finished = k.finished, out = k.out, time = if k.finished then fmtTime(k.finishTime) else nil })
	end
	return rows
end

local function broadcast(session: any)
	local rows = racerRows(session)
	local placeOf = {}
	for _, r in rows do placeOf[r.key] = r.place end
	for player, k in session.humans do
		Remotes.Race:FireClient(player, {
			phase = session.phase, mode = session.mode, track = session.geo.def.name, trackId = session.geo.id, laps = session.laps,
			raceMode = session.geo.def.mode, goAt = session.goAt, startTime = session.startTime, rows = rows, feed = session.feed,
			me = { key = k.key, place = placeOf[k.key], lap = math.clamp(k.lap, 1, session.laps), speed = math.floor(math.abs(k.speed)), energy = math.floor(k.energy),
				boosting = k.boostTimer > 0, drifting = k.drifting, driftTime = k.driftTime, finished = k.finished, out = k.out, wrongWay = k.wrongWay == true, kartName = k.kartName,
				progress = math.clamp((k.progress - session.geo.n) / (session.laps * session.geo.n), 0, 1) },
			total = #session.karts,
		})
	end
end

local function endSession(session: any)
	for player in session.humans do
		removeSessionPlayer(session, player)
	end
	session.folder:Destroy()
	local i = table.find(sessions, session)
	if i then table.remove(sessions, i) end
	if session.mode == "race" then
		Race.matchBusy = false
		Race.lobbyChanged()
	end
end

-- Create a race session for the given players. extras: party/demo racers.
local function startSession(mode: string, trackId: string, humans: { Player }, extras: { any }): any
	sessionCounter += 1
	local g = geo(trackId)
	local folder = Instance.new("Folder")
	folder.Name = "Session" .. sessionCounter
	folder.Parent = workspace
	local session = {
		id = sessionCounter, mode = mode, geo = g, laps = g.def.laps, karts = {}, humans = {}, folder = folder,
		phase = if mode == "test" then "racing" else "countdown", goAt = now() + COUNTDOWN_SECONDS, startTime = now() + COUNTDOWN_SECONDS,
		feed = {}, rewarded = {}, finishCount = 0, outCount = 0, lapsAnnounced = 1, lastBroadcast = 0, firstHumanFinish = nil, leaderHuman = nil,
	}
	local slot = 0
	for _, player in humans do
		local p = Profiles.get(player)
		if p then
			local lo = Profiles.loadout(p, if mode == "test" then extras.testKart else nil)
			local k = newKart(session, { key = "u" .. player.UserId, name = player.DisplayName, userId = player.UserId, player = player, livery = p.livery, cosmetics = lo.cosmetics, loadout = lo, tagColor = Color3.fromRGB(0, 235, 255) }, slot)
			slot += 1
			table.insert(session.karts, k)
			session.humans[player] = k
			playerSession[player] = session
			attachCharacter(k)
		end
	end
	if mode == "race" then
		local botNames = table.clone(Config.Bots)
		for _, ex in extras do
			local kartDef = Config.Karts[math.random(1, #Config.Karts)]
			local lo = { kart = kartDef, speedMul = 1, handlingMul = 1, boostMul = 1, driver = "Demo" }
			local k = newKart(session, { key = ex.key, name = ex.name, isBot = true, isParty = true, livery = { body = "Green", bodyShade = 100, accent = "Amber", accentShade = 100, decal = "star" }, cosmetics = {}, loadout = lo, tagColor = Color3.fromRGB(40, 255, 130), skill = 0.93, lane = (slot % 3 - 1) * 8 }, slot)
			slot += 1
			table.insert(session.karts, k)
		end
		local bi = 1
		while slot < Config.MaxRacers do
			local nameIdx = math.random(1, #botNames)
			local name = table.remove(botNames, nameIdx) :: string
			local kartDef = Config.Karts[math.random(1, #Config.Karts)]
			local lo = { kart = kartDef, speedMul = 1, handlingMul = 1, boostMul = 1, driver = "AI" }
			local color = Config.BotColors[(bi - 1) % #Config.BotColors + 1]
			local k = newKart(session, { key = "b" .. bi, name = name, isBot = true, livery = { body = color, bodyShade = 75, accent = "Cyan", accentShade = 50, decal = Config.Decals[bi % #Config.Decals + 1].id }, cosmetics = {}, loadout = lo, tagColor = Color3.fromRGB(255, 200, 120), skill = 0.86 + math.random() * 0.1, lane = (math.random() - 0.5) * 16 }, slot)
			slot += 1
			bi += 1
			table.insert(session.karts, k)
		end
	else
		session.laps = 99
	end
	table.insert(sessions, session)
	broadcast(session)
	return session
end

function Race.startTestDrive(player: Player, kartId: string): (boolean, string?)
	if playerSession[player] then return false, "You are already on a track." end
	if Race.inQueue(player) then return false, "Leave the race queue before a test drive." end
	if not Config.getKart(kartId) then return false, "Unknown kart." end
	startSession("test", Config.TestTrack, { player }, { testKart = kartId } :: any)
	return true
end

function Race.leave(player: Player): (boolean, string?)
	local s = playerSession[player]
	if not s then return false, "Not on a track." end
	if s.mode == "race" and s.phase ~= "results" then
		local k = s.humans[player]
		if k then
			k.out = true
			k.model:Destroy()
			local i = table.find(s.karts, k)
			if i then table.remove(s.karts, i) end
		end
	end
	removeSessionPlayer(s, player)
	local any = false
	for _ in s.humans do any = true end
	if not any then endSession(s) end
	return true
end

function Race.recover(player: Player): (boolean, string?)
	local s = playerSession[player]
	local k = s and s.humans[player]
	if not k then return false, "Not driving." end
	if k.recoverCd > 0 then return false, "Recover is cooling down." end
	if k.out then return false, "You are OUT." end
	local g = s.geo
	local idx = k.idx
	k.pos = g.path[idx] + g.rights[idx] * math.clamp((k.pos - g.path[idx]):Dot(g.rights[idx]), -6, 6)
	local d = g.dirs[idx]
	k.yaw = math.atan2(-d.X, -d.Z)
	k.speed = 0
	k.drifting = false
	k.recoverCd = 2
	return true
end

function Race.setInput(player: Player, t: number, s: number, drift: boolean, boostSeq: number)
	local session = playerSession[player]
	local k = session and session.humans[player]
	if not k then return end
	k.input.t = math.clamp(t, -1, 1)
	k.input.s = math.clamp(s, -1, 1)
	k.input.drift = drift
	k.input.boostSeq = boostSeq
end

function Race.kartFor(player: Player): any
	local s = playerSession[player]
	return s and s.humans[player]
end
function Race.sessionOf(player: Player): any
	return playerSession[player]
end

-- Main loop ---------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 1 / 20)
	local t = now()
	for _, s in table.clone(sessions) do
		if s.phase == "countdown" and t >= s.goAt then
			s.phase = "racing"
		end
		if s.mode == "race" then
			local best = nil
			for _, k in s.humans do
				if not k.out and not k.finished and (best == nil or k.progress > best) then best = k.progress end
			end
			s.leaderHuman = best
		end
		for _, k in s.karts do stepKart(s, k, dt) end
		separate(s)
		if s.mode == "race" and s.phase == "racing" then
			-- knockout: when the leader starts a new lap, the last racer is OUT
			if s.geo.def.mode == "Knockout" then
				local leaderLap = 0
				for _, k in s.karts do if not k.out then leaderLap = math.max(leaderLap, k.lap) end end
				if leaderLap > s.lapsAnnounced and leaderLap <= s.laps then
					for lapDone = s.lapsAnnounced, leaderLap - 1 do eliminate(s, lapDone) end
					s.lapsAnnounced = leaderLap
				end
			end
			local humansLeft, botsLeft = 0, 0
			for _, k in s.karts do
				if not k.finished and not k.out then
					if k.isBot then botsLeft += 1 else humansLeft += 1 end
				end
			end
			local elapsed = t - s.startTime
			if (humansLeft == 0 and (botsLeft == 0 or s.allDoneAt and t > s.allDoneAt))
				or (s.firstHumanFinish and t - s.firstHumanFinish > 30)
				or elapsed > 300 then
				finishRace(s)
			elseif humansLeft == 0 and not s.allDoneAt then
				s.allDoneAt = t + 4
			end
		end
		if s.phase == "results" and t - s.resultsAt > RESULTS_SECONDS then
			endSession(s)
		elseif t - s.lastBroadcast > 0.1 and s.phase ~= "results" then
			s.lastBroadcast = t
			broadcast(s)
		end
	end
end)

-- Lobby: queues and voting -------------------------------------------------
type Queue = { mode: string, required: number, members: { Player }, endsAt: number?, notice: string }
local queues: { [string]: Queue } = {
	Solo = { mode = "Solo", required = 1, members = {}, endsAt = nil, notice = "" },
	Duo = { mode = "Duo", required = 2, members = {}, endsAt = nil, notice = "" },
}
Race.matchBusy = false
local match: any = nil

local function partyExtras(player: Player): { any }
	local p = Profiles.get(player)
	local out = {}
	if not p then return out end
	for _, id in p.party.members do
		for _, f in Config.Friends do
			if f.id == id then table.insert(out, { key = "p_" .. id, name = f.name, demo = true }) end
		end
	end
	return out
end

local function joinedCount(q: Queue): number
	local n = #q.members
	if q.mode == "Duo" and n == 1 and #partyExtras(q.members[1]) > 0 then n = 2 end
	return n
end

function Race.inQueue(player: Player): string?
	for mode, q in queues do
		if table.find(q.members, player) then return mode end
	end
	return nil
end

local function lobbyPayload(): any
	local qs = {}
	for mode, q in queues do
		local ids = {}
		for _, pl in q.members do table.insert(ids, pl.UserId) end
		local partner = nil
		if mode == "Duo" and #q.members == 1 then
			local ex = partyExtras(q.members[1])
			if ex[1] then partner = ex[1].name end
		end
		qs[mode] = { members = ids, joined = joinedCount(q), required = q.required, endsAt = q.endsAt, notice = q.notice, partner = partner }
	end
	local m = nil
	if match then
		local tracks = {}
		for _, t in Config.Tracks do
			local c = 0
			for _, v in match.votes do if v == t.id then c += 1 end end
			table.insert(tracks, { id = t.id, name = t.name, desc = t.desc, laps = t.laps, mode = t.mode, votes = c })
		end
		local ids = {}
		for _, pl in match.players do table.insert(ids, pl.UserId) end
		m = { phase = match.phase, tracks = tracks, votes = match.votes, deadline = match.deadline, winner = match.winner, players = ids, participants = match.participantNames, startsAt = match.startsAt }
	end
	return { queues = qs, match = m, busy = Race.matchBusy, serverTime = now() }
end

function Race.lobbyChanged()
	Remotes.Lobby:FireAllClients(lobbyPayload())
end
function Race.sendLobby(player: Player)
	Remotes.Lobby:FireClient(player, lobbyPayload())
end

local function beginMatch(q: Queue)
	local players = table.clone(q.members)
	table.clear(q.members)
	q.endsAt = nil
	q.notice = ""
	Race.matchBusy = true
	local extras = {}
	if q.mode == "Duo" and #players == 1 then
		local ex = partyExtras(players[1])
		if ex[1] then extras = { ex[1] } end
	end
	local names = {}
	for _, pl in players do table.insert(names, pl.DisplayName) end
	for _, ex in extras do table.insert(names, ex.name) end
	local botCount = Config.MaxRacers - #players - #extras
	local bots = {}
	for i = 1, botCount do table.insert(bots, "b" .. i) end
	for i = 1, botCount do table.insert(names, Config.Bots[i] .. " (AI)") end
	match = { phase = "voting", players = players, extras = extras, votes = {}, deadline = now() + VOTE_SECONDS, winner = nil, participantNames = names, mode = q.mode }
	Race.lobbyChanged()
	-- AI and demo participants vote at random moments
	local voters = table.clone(bots)
	for _, ex in extras do table.insert(voters, ex.key) end
	for _, key in voters do
		task.delay(1 + math.random() * (VOTE_SECONDS - 3), function()
			if match and match.phase == "voting" then
				match.votes[key] = Config.Tracks[math.random(1, #Config.Tracks)].id
				Race.lobbyChanged()
			end
		end)
	end
	task.delay(VOTE_SECONDS, function()
		if not match then return end
		local counts = {}
		for _, v in match.votes do counts[v] = (counts[v] or 0) + 1 end
		local best, bestC = {}, -1
		for _, t in Config.Tracks do
			local c = counts[t.id] or 0
			if c > bestC then best, bestC = { t.id }, c elseif c == bestC then table.insert(best, t.id) end
		end
		match.winner = best[math.random(1, #best)]
		match.phase = "winner"
		match.startsAt = now() + WINNER_SECONDS
		Race.lobbyChanged()
		task.wait(WINNER_SECONDS)
		local present = {}
		for _, pl in match.players do
			if pl.Parent == Players and pl.Character then table.insert(present, pl) end
		end
		local trackId = match.winner
		local ex = match.extras
		match = nil
		if #present == 0 then
			Race.matchBusy = false
			Race.lobbyChanged()
			return
		end
		startSession("race", trackId, present, ex)
		Race.lobbyChanged()
	end)
end

local function checkQueues()
	for _, q in queues do
		local ready = joinedCount(q) >= q.required
		if ready and not q.endsAt and not Race.matchBusy then
			q.endsAt = now() + QUEUE_COUNTDOWN
			q.notice = ""
			local token = q.endsAt
			task.delay(QUEUE_COUNTDOWN, function()
				if q.endsAt == token and joinedCount(q) >= q.required and not Race.matchBusy then
					beginMatch(q)
				end
			end)
		elseif not ready and q.endsAt then
			q.endsAt = nil
			q.notice = "Countdown cancelled: a racer left before the start."
		end
	end
	Race.lobbyChanged()
end

function Race.joinQueue(player: Player, mode: string): (boolean, string?)
	local q = queues[mode]
	if not q then return false, "Unknown queue." end
	if playerSession[player] then return false, "Finish your current drive first." end
	if match and table.find(match.players, player) then return false, "You are already in track voting." end
	local cur = Race.inQueue(player)
	if cur then
		local i = table.find(queues[cur].members, player)
		if i then table.remove(queues[cur].members, i) end
	end
	table.insert(q.members, player)
	q.notice = ""
	checkQueues()
	return true
end

function Race.leaveQueue(player: Player): (boolean, string?)
	local cur = Race.inQueue(player)
	if not cur then return false, "You are not in a queue." end
	local q = queues[cur]
	local i = table.find(q.members, player)
	if i then table.remove(q.members, i) end
	checkQueues()
	if q.endsAt == nil and #q.members == 0 then q.notice = "" end
	Race.lobbyChanged()
	return true
end

function Race.vote(player: Player, trackId: string): (boolean, string?)
	if not match or match.phase ~= "voting" then return false, "Voting is closed." end
	if not table.find(match.players, player) then return false, "You are not in this vote." end
	if not Config.getTrack(trackId) then return false, "Unknown track." end
	if now() > match.deadline then return false, "Voting is closed." end
	match.votes["u" .. player.UserId] = trackId
	Race.lobbyChanged()
	return true
end

function Race.partyChanged()
	checkQueues()
end

function Race.chatTag(player: Player, text: string)
	local k = Race.kartFor(player)
	if not k then return end
	local tag = (k.body :: BasePart):FindFirstChild("Tag") :: BillboardGui
	local chat = tag:FindFirstChild("Chat") :: TextLabel
	chat.Text = text
	chat.Visible = true
	local token = now()
	chat:SetAttribute("Token", token)
	task.delay(3.5, function()
		if chat.Parent and chat:GetAttribute("Token") == token then chat.Visible = false end
	end)
end

Players.PlayerRemoving:Connect(function(player)
	local cur = Race.inQueue(player)
	if cur then Race.leaveQueue(player) end
	if match then
		local i = table.find(match.players, player)
		if i then table.remove(match.players, i) end
	end
	if playerSession[player] then Race.leave(player) end
end)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.3)
		local k = Race.kartFor(player)
		if k then attachCharacter(k) end
	end)
end)

return Race
]]></ProtectedString>
					<string name="ScriptGuid">{EAB1BB25-5CAE-4775-B17C-E5EB15A08BD5}</string>
