			<Item class="LocalScript" referent="RBX5A7F9815AF3E453481FB9D27C7176204">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local UIS=game:GetService("UserInputService")
local CAS=game:GetService("ContextActionService")
local GS=game:GetService("GuiService")
local Run=game:GetService("RunService")
local Sound=game:GetService("SoundService")
local p=Players.LocalPlayer
local N=RS:WaitForChild("Neon")
local C=require(N:WaitForChild("Catalog"))
local A=N:WaitForChild("Action") :: RemoteEvent
local E=N:WaitForChild("State") :: RemoteEvent
local gui=Instance.new("ScreenGui");gui.Name="NEON_APEX";gui.ResetOnSpawn=false;gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling;gui.ScreenInsets=Enum.ScreenInsets.DeviceSafeInsets;gui.Parent=p:WaitForChild("PlayerGui")
local root=Instance.new("Frame");root.Name="ResponsiveRoot";root.Size=UDim2.fromScale(1,1);root.BackgroundTransparency=1;root.Parent=gui
local palette={bg=Color3.fromRGB(12,18,33),panel=Color3.fromRGB(20,29,48),card=Color3.fromRGB(29,41,63),line=Color3.fromRGB(49,65,89),text=Color3.fromRGB(236,246,255),muted=Color3.fromRGB(148,170,195),cyan=Color3.fromRGB(63,228,248),purple=Color3.fromRGB(178,128,255),amber=Color3.fromRGB(255,199,91),red=Color3.fromRGB(255,102,122)}
local state=nil
local homePreview=nil
local controls=nil
local controlsDriving=false
task.spawn(function() local module=p:WaitForChild("PlayerScripts"):FindFirstChild("PlayerModule");if module and module:IsA("ModuleScript") then controls=require(module):GetControls() end end)
local current=""
local walk=false
local selected="ion"
local search=""
local category="All"
local rarity=0
local sortMode=1
local shopFilter="All"
local driverGroup="All"
local partySearch=""
local draft=nil
local dirty=false
local busy=false
local confirmFn=nil
local confirmation=nil
local opener=nil
local render
local openPanel
local closePanel
local lastReveal=0
local revealCount=0
local tutorialVisible=false
local tutorialStep=1
local chatOpen=false
local scoreboardOpen=false
local music=Instance.new("Sound");music.Name="Midnight radio";music.SoundId="rbxassetid://1845918434";music.Looped=true;music.Volume=.15;music.Parent=Sound;music:Play()
local engine=Instance.new("Sound");engine.Name="Mag drive";engine.SoundId="rbxasset://sounds/action_swim.mp3";engine.Looped=true;engine.Volume=0;engine.Parent=Sound;engine:Play()
local click=Instance.new("Sound");click.SoundId="rbxasset://sounds/electronicpingshort.wav";click.Volume=.2;click.Parent=Sound
local held={gas=false,reverse=false,left=false,right=false,brake=false,boost=false}
local analog=0
local function send(action,data) A:FireServer(action,data) end
local function corner(x,r) local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,r or 12);c.Parent=x end
local function stroke(x,col,t) local s=Instance.new("UIStroke");s.Color=col or palette.line;s.Thickness=t or 1;s.Parent=x end
local function pad(x,n) local a=Instance.new("UIPadding");a.PaddingLeft=UDim.new(0,n);a.PaddingRight=UDim.new(0,n);a.PaddingTop=UDim.new(0,n);a.PaddingBottom=UDim.new(0,n);a.Parent=x end
local function frame(parent,size,pos,col)
 local f=Instance.new("Frame");f.Size=size or UDim2.fromScale(1,1);f.Position=pos or UDim2.new();f.BackgroundColor3=col or palette.panel;f.BorderSizePixel=0;f.Parent=parent;return f
end
local function label(parent,text,size,col)
 local l=Instance.new("TextLabel");l.BackgroundTransparency=1;l.Text=text;l.Font=Enum.Font.Gotham;l.TextSize=size or 16;l.TextColor3=col or palette.text;l.TextXAlignment=Enum.TextXAlignment.Left;l.TextYAlignment=Enum.TextYAlignment.Center;l.TextWrapped=true;l.Size=UDim2.new(1,0,0,30);l.Parent=parent;return l
end
local function button(parent,text,fn,col)
 local b=Instance.new("TextButton");b.Text=text;b.Font=Enum.Font.GothamBold;b.TextSize=14;b.TextColor3=col==palette.cyan and palette.bg or palette.text;b.BackgroundColor3=col or palette.card;b.BorderSizePixel=0;b.Size=UDim2.new(0,140,0,42);b.AutoButtonColor=true;b.Selectable=true;corner(b,8);b.Parent=parent
 b.Activated:Connect(function() click:Play();if fn then fn(b) end end)
 b.SelectionGained:Connect(function() local st=b:FindFirstChildOfClass("UIStroke");if not st then stroke(b,palette.cyan,2) else st.Color=palette.cyan end end)
 b.SelectionLost:Connect(function() local st=b:FindFirstChildOfClass("UIStroke");if st then st:Destroy() end end)
 return b
end
local function list(parent,gap)
 local l=Instance.new("UIListLayout");l.Padding=UDim.new(0,gap or 10);l.SortOrder=Enum.SortOrder.LayoutOrder;l.Parent=parent;return l
end
local function row(parent,height)
 local f=frame(parent,UDim2.new(1,0,0,height or 52),nil,palette.card);corner(f,10);return f
end
local function textRow(parent,title,desc,right,fn,col)
 local f=row(parent,76)
 local a=label(f,title,16);a.Position=UDim2.fromOffset(14,8);a.Size=UDim2.new(.64,-18,0,27);a.Font=Enum.Font.GothamBold
 local d=label(f,desc,12,palette.muted);d.Position=UDim2.fromOffset(14,34);d.Size=UDim2.new(.64,-18,0,32)
 if right then local b=button(f,right,fn,col);b.AnchorPoint=Vector2.new(1,.5);b.Position=UDim2.new(1,-12,.5,0);b.Size=UDim2.new(.33,-8,0,44) end
 return f
end
local function note(parent,text,col)
 local f=label(parent,text,14,col or palette.muted);f.Size=UDim2.new(1,-4,0,44);return f
end
local function heading(parent,text)
 local l=label(parent,text,12,palette.cyan);l.Font=Enum.Font.GothamBold;l.Size=UDim2.new(1,0,0,28);return l
end
local function money(n) return tostring(math.floor(n)) end
local function find(t,id) for _,v in ipairs(t) do if v.id==id then return v end end;return t[1] end
local function rgb(n,shade) local c=C.Colors[n] or C.Colors.Cyan;return Color3.fromRGB(c[1],c[2],c[3]):Lerp(Color3.new(0,0,0),1-(shade or 1)) end
local toast=frame(root,UDim2.new(.6,0,0,48),UDim2.new(.2,0,0,90),palette.panel);corner(toast,10);stroke(toast,palette.cyan);toast.ZIndex=20;toast.Visible=false
local toastText=label(toast,"",14);toastText.Size=UDim2.new(1,-24,1,0);toastText.Position=UDim2.fromOffset(12,0);toastText.ZIndex=21
local toastId=0
local function notify(text)
 if text=="" then return end
 toastId+=1;local id=toastId;toastText.Text=text;toast.Visible=true
 task.delay(4,function() if id==toastId then toast.Visible=false end end)
end
