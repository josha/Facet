						<Item class="StringValue" referent="516">
							<Properties>
								<string name="Value"><![CDATA[# Menu.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
align: ("start" | "center" | "end")? = omitted
backLabel: ValueString? = omitted
closeButton: boolean? = omitted
controls: { diagnostics: (() -> { string })? }? = omitted
disclosure: boolean? = omitted
edge: ("top" | "bottom" | "leading" | "trailing")? = omitted
enabled: ValueBoolean? = omitted
isPresented: Cell<boolean>? = omitted
items: Value<{ MenuItem<V> }> = required
label: ValueString? = omitted
maxHeight: number? = omitted
onClose: (() -> ())? = omitted
onOpen: (() -> ())? = omitted
presentation: Value<"automatic" | "menu" | "sheet">? = omitted
query: Cell<string>? = omitted
ref: ((Frame) -> ())? = omitted
trigger: (GuiObject | (GuiButton | TextButton | ImageButton) | GuiLabel | TextLabel | ImageLabel | Frame | ScrollingFrame | CanvasGroup | TextBox | ViewportFrame | VideoFrame) | (() -> GuiObject)? = omitted
triggers: { ("activate" | "secondary" | "longPress" | "keyboard" | "gamepad") }? = omitted
width: Value<(number | UDim | UDim2 | MenuDim)>? = omitted]]></string>
