	Visible: typeof(scrollingFrame.Visible),
	ZIndex: typeof(scrollingFrame.ZIndex),
	AutomaticCanvasSize: typeof(scrollingFrame.AutomaticCanvasSize),
	BottomImage: typeof(scrollingFrame.BottomImage),
	BottomImageContent: typeof(scrollingFrame.BottomImageContent),
	CanvasPosition: typeof(scrollingFrame.CanvasPosition),
