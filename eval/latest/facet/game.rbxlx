enabled: ValueBoolean? = omitted
haptic: Value<boolean | ("selection" | "impact" | "success" | "warning" | "error")>? = omitted
help: (ValueString | HelpSpec)? = omitted
hint: ValueString? = omitted
icon: ValueString? = omitted
image: ValueString? = omitted
imageAspectRatio: number? = omitted
imageFraming: ("fit" | "crop")? = omitted
label: ValueString? = omitted
leading: Child? = omitted
name: ValueString? = omitted
onPointerCancel: (() -> ())? = omitted
onPointerDown: ((InputObject) -> ())? = omitted
onPointerUp: ((InputObject) -> ())? = omitted
onRemove: OnRemoveField = required
onToggle: OnToggleField = required
pop: boolean? = omitted
ref: ((TextButton | Frame) -> ())? = omitted
removeFocusFallback: Value<GuiObject?>? = omitted
removeLabel: ValueString? = omitted
repeatDelay: number? = omitted
repeatInterval: number? = omitted
role: Value<("default" | "cancel" | "destructive" | "onIndicator")>? = omitted
row: Row? = omitted
selected: SelectedField = required
shape: ("rect" | "circle")? = omitted
shortcut: Shortcut? = omitted
subtitle: ValueString? = omitted
target: ("hit" | "thumb" | "inline")? = omitted
textSize: Value<string | number>? = omitted
trailing: Child? = omitted
trailingIcon: ValueString? = omitted
underline: ("always" | "hover")? = omitted
HelpSpec = { title: ValueString?, body: ValueString, shortcut: { { string } }?, edge: ("top" | "bottom" | "leading" | "trailing")?, align: ("start" | "center" | "end")?, }
Row = { title: ValueString?, description: ValueString?, value: string?, icon: string? }
Shortcut = { keyCode: string, modifiers: { shift: boolean? }? }]]></string>
