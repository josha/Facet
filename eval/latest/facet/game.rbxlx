					<Item class="ModuleScript" referent="150">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local Inputs = require("./input_types")
local ComposeTypes = require("../vendor/compose/core")
local NavigationProps = require("./navigation_props")
local MenuPanel = require("./nav_menu_panel")

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces)
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2 = ctx.types.Enum, ctx.types.UDim2
	local menuPanel = MenuPanel(ctx, UI, surfaces)
	local function writable(cell: { set: unknown }, name: string)
		assert(type(cell) == "table" and type(cell.set) == "function", name .. " requires a writable Compose cell")
	end
	UI.ComboBox = ctx.construct("ComboBox", function(spec: NavigationProps.ComboBoxSpec): Frame
		writable(spec.value, "ComboBox.value")
		writable(spec.text, "ComboBox.text")
		assert(type(spec.value:peek()) == "string", "ComboBox.value must be a string")
		assert(type(read(spec.options)) == "table", "ComboBox requires options")
		assert(type(spec.acceptCustom) == "function", "ComboBox requires acceptCustom")
		local errorText = Compose.cell("")
		local alive = true
		Compose.cleanup(function()
			alive = false
		end)
		local opened, editing = Compose.cell(false), Compose.cell(false)
		local navigating = false
		local popup: Frame?
		local gui = surfaces.service("GuiService")
		local function close()
			opened:set(false)
		end
		local function label(value: string): string
			for _, option in read(spec.options) do
				if (option.value or option.id) == value then
					return read(option.label)
				end
			end
			return value
		end
		local function update(value: string)
			close()
			errorText:set("")
			spec.text:set(label(value))
			if value ~= spec.value:peek() then
				spec.value:set(value)
				if spec.onChange then
					spec.onChange(value)
				end
			end
		end
		local function commit(text: string, reason: Inputs.CommitReason)
			if
				navigating
				or read(spec.enabled) == false
				or (reason == "focusLost" and spec.commitOnFocusLost ~= true)
			then
				return
			end
			for _, option in read(spec.options) do
				if read(option.label) == text then
					if read(option.enabled) == false then
						errorText:set("This option is unavailable.")
					else
						update(option.value or option.id)
					end
					return
				end
			end
			local ok, accepted, message = pcall(spec.acceptCustom, text)
			if not alive or read(spec.enabled) == false then
				return
			end
			if ok and accepted == true then
				update(text)
			else
				errorText:set(message or "This value is not accepted.")
			end
		end
		local function cancel()
			close()
			spec.text:set(label(spec.value:peek()))
			errorText:set("")
		end
		local created = UI.TextInput "Editor" {
			value = spec.text,
			placeholder = spec.placeholder,
			enabled = spec.enabled,
			Size = D2.new(1, -60, 1, 0),
			AutomaticSize = E.AutomaticSize.None,
			onCommit = function(value, reason)
				commit(value, reason)
				if reason == "submit" then
					close()
				end
			end,
			onCancel = cancel,
			onChange = function(value)
				spec.text:set(value)
				opened:set(true)
			end,
			Focused = function()
				editing:set(true)
			end,
			FocusLost = function()
				editing:set(false)
			end,
		}
		assert(created:IsA("TextBox"), "Facet ComboBox: the editor is a TextBox")
		local editor = created

		local function open()
			if read(spec.enabled) ~= false then
				opened:set(true)
			end
		end
		local triggerAttributes: Types.Attributes = { FacetLabel = "Suggestions" }
		local suggestions = Host.Frame "Suggestions" {
			BackgroundTransparency = 1,
			Position = D2.new(1, -56, 0, 0),
			Size = D2.new(0, 56, 1, 0),
			UI.Button "Trigger" {
				label = "",
				icon = "chevron.down",
				enabled = spec.enabled,
				Size = D2.fromScale(1, 1),
				AutomaticSize = E.AutomaticSize.None,
				Attributes = triggerAttributes,
				onActivate = function()
					if opened:peek() then
						close()
					else
						open()
					end
				end,
			},
		}
		local row = Host.Frame "Row" {
			BackgroundTransparency = 1,
			Size = D2.new(1, 0, 0, 44),
			editor :: Instance,
			suggestions,
		}
		local root = ctx.column(
			{
				row,
				Compose.show(function(use: ComposeTypes.Use)
					return use(errorText) ~= ""
				end, function()
					return ctx.text({ Name = "Validation", Text = errorText, TextWrapped = true, LayoutOrder = 2 })
				end),
			},
			ctx.props(spec, {
				"value",
				"text",
				"options",
				"enabled",
				"acceptCustom",
				"onChange",
				"commitOnFocusLost",
				"placeholder",
			}, {
				Name = "ComboBox",
				Size = D2.new(1, 0, 0, 44),
				AutomaticSize = E.AutomaticSize.Y,
			})
		)
		local available = surfaces.available(root)
		Compose.watch(function(use: ComposeTypes.Use)
			if not use(available) or read(spec.enabled, use) == false then
				close()
			end
		end)
		local choices = function(use: ComposeTypes.Use): { Nav.MenuItem<string> }
			local result: { Nav.MenuItem<string> } = {}
			local query = string.lower(use(spec.text))
			for _, option in read(spec.options, use) do
				if string.find(string.lower(read(option.label, use)), query, 1, true) then
					table.insert(result, {
						id = option.id or tostring(option.value),
						label = option.label,
						enabled = option.enabled,
						onSelect = function()
							update(option.value or option.id)
						end,
					})
				end
			end
			return result
		end
		surfaces.attach(root, {
			surfaces.overlay(row, function(use: ComposeTypes.Use)
				return use(opened) and #choices(use) > 0
			end, function()
				local panel = menuPanel({ items = choices, presentation = "menu" :: "menu" }, close, row, true)
				popup = panel
				Compose.cleanup(function()
					if gui and surfaces.within(gui.SelectedObject, panel) then
						gui.SelectedObject = if ctx.available(root) then editor else nil
					end
					popup = nil
				end)
				local input = surfaces.service("UserInputService")
				if input then
					runtime.connect(input, "InputBegan", function(event: InputObject)
						if
							event.UserInputType ~= E.UserInputType.MouseButton1
							and event.UserInputType ~= E.UserInputType.Touch
						then
							return
						end
						local function hit(node: GuiObject): boolean
							local at, size, point = node.AbsolutePosition, node.AbsoluteSize, event.Position
							return point.X >= at.X
								and point.Y >= at.Y
								and point.X <= at.X + size.X
								and point.Y <= at.Y + size.Y
						end
						local menu = panel:FindFirstChild("MenuPanel")
						if not hit(row) and menu and menu:IsA("GuiObject") and not hit(menu) then
							close()
						end
					end)
				end
				return panel
			end),
			Compose.show(function(use: ComposeTypes.Use)
				return use(editing) or use(opened)
			end, function()
				ctx.action(root, "ComboSuggestions", { E.KeyCode.Down, E.KeyCode.DPadDown }, editing, function()
					open()
					local panel = popup
					local target: GuiObject?
					if panel then
						for _, item in Compose.sample(choices) do
							if item.divider ~= true and read(item.enabled) ~= false then
								target = surfaces.firstSelectable(panel, item.id)
								if target then
									break
								end
							end
						end
					end
					if target and gui then
						navigating = true
						editor:ReleaseFocus(false)
						navigating = false
						gui.SelectedObject = target
					end
				end, { priority = 11000 })
				ctx.action(root, "ComboCancel", { E.KeyCode.Escape, E.KeyCode.ButtonB }, opened, function()
					cancel()
					if ctx.available(root) then
						editor:CaptureFocus()
					end
				end, { priority = 11000 })
				return Host.Folder({})
			end),
		})
		return root
	end)
end
]]></ProtectedString>
							<string name="ScriptGuid">{E49CC43F-FC45-4DDB-BB62-4CC1D2F12022}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">nav_combo_box</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc38900000473</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="151">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local Overlay = require("./overlay_types")
local materialize = require("./materialize")
local ComposeTypes = require("../vendor/compose/core")
local parts = require("./overlay_parts")
local freeze = require("./freeze")
local OverlayProps = require("./overlay_props")
local keyboardInset = require("./keyboard_inset")

local KEYS = {
	"isPresented",
	"onPresentedChange",
	"onDismiss",
	"title",
	"content",
	"hero",
	"actionLabel",
	"actions",
	"actionLayout",
	"closeButton",
	"width",
	"contentSelectable",
}

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces): ()
	local Compose, Host, runtime, read = ctx.Compose, ctx.Host, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2

	local function blank(value: unknown): boolean
		return type(value) ~= "string" or string.match(value, "%S") == nil
	end

	UI.Dialog = ctx.construct("Dialog", function(spec: OverlayProps.DialogSpec): Frame
		local where = "UI.Dialog"
		if spec.isPresented == nil then
			error(`Facet {where}: isPresented is required; it is the caller's boolean fact`, 0)
		end
		for _, key in { "onPresentedChange", "onDismiss" } do
			local value = (spec :: { [unknown]: unknown })[key]
			if value ~= nil and type(value) ~= "function" then
				error(`Facet {where}: {key} must be a function`, 0)
			end
		end
		if spec.closeButton ~= nil and type(spec.closeButton) ~= "boolean" then
			error(`Facet {where}: closeButton must be true or false`, 0)
		end
		local closeButton = if spec.closeButton ~= nil
			then spec.closeButton
			else spec.actions == nil or #spec.actions == 0
		if closeButton and spec.onPresentedChange == nil then
			error(
				`Facet {where}: the close button proposes a close and needs onPresentedChange. `
					.. "Without it, set closeButton = false. The backdrop and Cancel then do nothing.",
				0
			)
		end
		parts.checkPreset(ctx, where, "width", spec.width, parts.WIDTH_PRESETS)
		parts.checkPreset(ctx, where, "actionLayout", spec.actionLayout, parts.ACTION_LAYOUTS)
		if spec.contentSelectable ~= nil and type(spec.contentSelectable) ~= "boolean" then
			error(`Facet {where}: contentSelectable must be true or false`, 0)
		end
		if spec.content ~= nil and type(spec.content) ~= "function" then
			error(`Facet {where}: content must be a factory that returns the body`, 0)
		end
		for _, key in { "title", "actionLabel" } do
			local value = (spec :: { [unknown]: unknown })[key]
			if value ~= nil and not parts.bound(ctx, value, "string") then
				error(`Facet {where}: {key} must be a string or a bound string`, 0)
			end
		end
		parts.checkMedia(where, spec.hero)
		local actions = ((spec.actions or {}) :: unknown) :: { Overlay.Action }
		parts.checkActions(ctx, where, spec.actions, math.huge, nil, true)
		local cancelAction: Overlay.Action? = nil
		for _, action in actions do
			if action.role == "cancel" then
				cancelAction = action
			end
		end
		local function draws(value: unknown): boolean
			return value ~= nil and not (type(value) == "string" and blank(value))
		end
		if
			not draws(spec.title)
			and not draws(spec.actionLabel)
			and spec.hero == nil
			and spec.content == nil
			and #actions == 0
		then
			error(`Facet {where}: nothing to show. Supply a title, content, hero, actionLabel or actions`, 0)
		end

		local owner = assert(Compose.currentOwner())
		local root = Host.Frame(
			ctx.props(spec, KEYS, { Name = "Dialog", BackgroundTransparency = 1, Size = D2.fromOffset(0, 0) })
		)
		local function wanted(): boolean
			return read(spec.isPresented) == true
		end
		local condition = function(use: ComposeTypes.Use): boolean
			return read(spec.isPresented, use) == true
		end
		local closing: Overlay.DialogDismissReason? = nil
		local disposed = false
		local function report(reason: Overlay.DialogDismissReason)
			if spec.onDismiss then
				spec.onDismiss(reason)
			end
		end
		local function propose(nextValue: boolean, reason: Overlay.DialogDismissReason): boolean
			local change = spec.onPresentedChange
			if change == nil then
				return false
			end
			if not nextValue then
				closing = reason
			end
			local accepted = false
			parts.call(change, function()
				accepted = wanted() == nextValue
				if not accepted then
					closing = nil
				end
			end, nextValue)
			return accepted
		end
		local function press(action: Overlay.Action)
			if not parts.usable(ctx, action) then
				return
			end
			closing = "action"
			parts.call(action.onActivate, function()
				if wanted() then
					closing = nil
				end
			end)
			if wanted() and not ((action :: unknown) :: Overlay.DialogAction).keepOpen then
				propose(false, "action")
			end
		end
		local function cancel()
			if cancelAction and parts.usable(ctx, cancelAction) then
				press(cancelAction)
			else
				propose(false, "cancel")
			end
		end
		local input = surfaces.service("UserInputService")
		surfaces.attach(root, {
			surfaces.overlay(root, condition, function(phase: Nav.PresencePhase?)
				local layer = assert(surfaces.parent(root))
				local unit = ctx.layoutUnit(layer)
				local extent = ctx.layoutSize(layer, unit)
				local keyboardPixels = keyboardInset.reader(ctx, input)
				local function keyboard(use: ComposeTypes.Use): number
					return keyboardPixels(use) / use(unit)
				end
				local function margin(use: ComposeTypes.Use?): number
					return ctx.metric("space.m", use)
				end
				local function widthPx(use: ComposeTypes.Use): number
					return math.max(0, math.min(parts.width(ctx, spec.width, use), use(extent).X - 2 * margin(use)))
				end
				local function roomPx(use: ComposeTypes.Use): number
					local available = math.max(0, use(extent).Y - keyboard(use))
					local minimum = math.min(ctx.metric("targetSizes.minimum", use), math.max(0, available - 32))
					return math.max(minimum, available - 4 * margin(use))
				end
				local regions: { GuiObject } = {}
				if spec.hero then
					table.insert(regions, parts.media(ctx, spec.hero, "Hero"))
				end
				local header: { Types.Child } = {}
				local plaqued = Compose.cell(false)
				if spec.title ~= nil then
					local title = spec.title
					local heading = ctx.text({
						Name = "Title",
						Text = function(use: ComposeTypes.Use)
							return read(title, use) or ""
						end,
						TextWrapped = true,
						Size = D2.new(1, 0, 0, 0),
						AutomaticSize = E.AutomaticSize.Y,
						Visible = function(use: ComposeTypes.Use)
							return not blank(read(title, use)) and not use(plaqued)
						end,
						Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }),
					})
					heading:AddTag("facet-type-heading")
					table.insert(header, heading)
				end
				if closeButton then
					table.insert(
						header,
						UI.Button "Close" {
							name = "Close",
							icon = "close",
							Size = D2.fromOffset(44, 44),
							AutomaticSize = E.AutomaticSize.None,
							onActivate = function()
								propose(false, "close")
							end,
						}
					)
				end
				if #header > 0 then
					local row = ctx.row(
						header,
						{ Name = "Header", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y }
					)
					local layout = row:FindFirstChildWhichIsA("UIListLayout") :: UIListLayout?
					if layout then
						layout.VerticalAlignment = E.VerticalAlignment.Center
					end
					table.insert(regions, row)
				end
				local body: ScrollingFrame? = nil
				local bodyContent: Frame? = nil
				if spec.content then
					local scroller, flow = parts.scroller(
						ctx,
						{
							Name = "Body",
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							ScrollBarThickness = 4,
							ScrollingDirection = E.ScrollingDirection.Y,
							Selectable = false,
						},
						{ Host.UIListLayout({ SortOrder = E.SortOrder.LayoutOrder }), spec.content() },
						{ name = "Content" }
					)
					bodyContent = flow
					body = scroller
					table.insert(regions, assert(body))
				end
				if spec.actionLabel ~= nil then
					local label = spec.actionLabel
					table.insert(
						regions,
						ctx.styled(
							ctx.text({
								Name = "ActionLabel",
								Text = function(use: ComposeTypes.Use)
									return read(label, use) or ""
								end,
								TextWrapped = true,
								Size = D2.new(1, 0, 0, 0),
								AutomaticSize = E.AutomaticSize.Y,
								Visible = function(use: ComposeTypes.Use)
									return not blank(read(label, use))
								end,
							}),
							"secondary"
						)
					)
				end
				local group: parts.ActionGroup? = nil
				if #actions > 0 then
					group = parts.actions(ctx, UI, actions, spec.actionLayout, function(use: ComposeTypes.Use)
						return widthPx(use) - 2 * margin(use)
					end, press)
					table.insert(regions, assert(group).frame)
				end
				local naturalSize: ComposeTypes.Readable<Vector2> = if bodyContent
					then ctx.layoutSize(bodyContent, unit)
					else Compose.cell(V2.zero)
				local room = parts.room(ctx, regions, body, function(use: ComposeTypes.Use): number
					return use(naturalSize).Y
				end, function(use: ComposeTypes.Use)
					return roomPx(use)
				end, false, unit)
				if body and spec.contentSelectable ~= false then
					local scroller = body
					runtime.decorate(scroller, { Selectable = room.overflowing })
					scroller:SetAttribute("FacetSelectionOwner", true)
					local gui = surfaces.service("GuiService")
					local selected: ComposeTypes.Readable<GuiObject?> = if gui
						then ctx.observe.SelectedObject(gui)
						else Compose.cell(nil :: GuiObject?)
					local canvas = ctx.observe.CanvasPosition(scroller)
					local window = ctx.observe.AbsoluteWindowSize(scroller)
					local content = ctx.observe.AbsoluteSize(assert(bodyContent))
					local function step(direction: number)
						local box = scroller.AbsoluteWindowSize.Y
						local limit = math.max(0, scroller.AbsoluteCanvasSize.Y - box)
						local at = scroller.CanvasPosition
						local target = math.clamp(at.Y + direction * math.max(1, box * 0.8), 0, limit)
						scroller.CanvasPosition = V2.new(at.X, target)
					end
					local function bind(name: string, direction: number, keys: { Enum.KeyCode })
						ctx.action(scroller, name, keys, function(use: ComposeTypes.Use)
							if use(selected) ~= (scroller :: GuiObject) or not use(room.overflowing) then
								return false
							end
							local y = use(canvas).Y
							local limit = math.max(0, use(content).Y - use(window).Y)
							return if direction > 0 then y < limit - 0.5 else y > 0.5
						end, function()
							step(direction)
						end, { priority = 3000, capture = true })
					end
					surfaces.attach(scroller, {
						Compose.show(room.overflowing, function()
							bind("DialogBodyDown", 1, { E.KeyCode.Down, E.KeyCode.DPadDown })
							bind("DialogBodyUp", -1, { E.KeyCode.Up, E.KeyCode.DPadUp })
							return Compose.fragment(function()
								return {}
							end)
						end),
					})
				end
				local settled = Compose.cell(false)
				local held: ComposeTypes.Cell<Vector2?> = Compose.cell(nil :: Vector2?)
				local shown = surfaces.appearance(phase, ctx.motionTiming("dialog"), settled)
				local panelProps: Types.CanvasGroupNativeProps = {
					Name = "Panel",
					AnchorPoint = V2.new(0.5, 0.5),
					Position = function(use: ComposeTypes.Use)
						return D2.new(0.5, 0, 0.5, -keyboard(use) / 2)
					end,
					Size = function(use: ComposeTypes.Use)
						local box = use(held)
						return D2.fromOffset(widthPx(use), if box then math.ceil(box.Y) else 0)
					end,
					AutomaticSize = function(use: ComposeTypes.Use)
						return if use(held) then E.AutomaticSize.None else E.AutomaticSize.Y
					end,
					BackgroundTransparency = 0,
					BorderSizePixel = 0,
					GroupTransparency = function(use: ComposeTypes.Use)
						return 1 - shown.opacity(use)
					end,
					room.frame :: Instance,
					ctx.padding(16, 16),
					ctx.corner(),
				}
				local panel = ctx.styled(ctx.fade(panelProps, true), "dialog")
				ctx.styled(panel, "panel")
				materialize(ctx, panel, panelProps, function(use: ComposeTypes.Use)
					local rest = ctx.metric("motion.materialize.modal", use)
					return if use(settled) then rest + (1 - rest) * shown.travel(use) else 1
				end, nil, true)
				local sizes, rested = surfaces.atRest(shown.travel, settled, { panel })
				Compose.watch(function(use: ComposeTypes.Use)
					held:set(if use(rested) and shown.travel(use) < 1 then use(sizes[1]) / use(unit) else nil)
				end)
				surfaces.skin(panel, "panel", {
					title = spec.title,
					onCaption = function(on: boolean)
						plaqued:set(on)
					end,
				})
				local initial: string? = if cancelAction and parts.usable(ctx, cancelAction)
					then cancelAction.id
					else nil
				if initial == nil then
					for _, action in actions do
						if action.role ~= "destructive" and parts.usable(ctx, action) then
							initial = action.id
							break
						end
					end
				end
				Compose.cleanup(function()
					if disposed or owner.isDisposed() then
						closing = nil
						report("cancel")
						return
					end
					local reason: Overlay.DialogDismissReason = closing or "cancel"
					closing = nil
					if wanted() then
						propose(false, "cancel")
						closing = nil
						report("cancel")
					else
						report(reason)
					end
				end)
				return surfaces.modal(function()
					return panel
				end, function()
					cancel()
				end, {
					Name = "DialogModal",
					initialFocus = initial,
					onOutside = function()
						propose(false, "outside")
					end,
					exiting = if phase then phase.exiting else nil,
					appearance = shown.opacity,
				})
			end, { motion = ctx.motionTiming("dialog") }),
		})
		Compose.cleanup(function()
			disposed = true
		end)
		return root
	end)
end
]]></ProtectedString>
							<string name="ScriptGuid">{838F45E6-DCBF-4AC4-8313-2FDA07A07089}</string>
