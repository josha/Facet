					<Item class="ModuleScript" referent="182">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local fontReadiness = require("./font_readiness")
local NavigationProps = require("./navigation_props")
local sheetDetents = require("./nav_sheet_detents")
local sheetGesture = require("./nav_sheet_gesture")
local sheetContent = require("./nav_sheet_content")
local transitions = require("./transition")
local arrival = require("./overlay_arrival")

type Prepared = sheetDetents.Prepared

local KEYS = {
	"title",
	"content",
	"detent",
	"detents",
	"isPresented",
	"onPresentedChange",
	"interactiveDismissDisabled",
	"dragIndicator",
	"placement",
	"edge",
	"width",
	"closeButton",
	"header",
	"hero",
	"actions",
	"actionLayout",
	"contentInset",
	"scrollPolicy",
	"transition",
	"initialFocus",
	"guide",
	"guideAlignment",
}
return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Nav.Surfaces): ()
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local readSource = ctx.readSource
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local frames = runtime.host.frames
	local detents = sheetDetents(ctx)
	local prepare, writableDetent = detents.prepare, detents.writableDetent
	local gestureFor = sheetGesture(ctx, UI, surfaces, detents.word)
	local contentFor = sheetContent(ctx, UI, surfaces)

	local function modalFor(
		spec: NavigationProps.SheetSpec,
		detent: ComposeTypes.Cell<string>,
		prepared: Prepared,
		request: Nav.SheetRequest?,
		phase: Nav.PresencePhase?,
		anchor: GuiObject?
	): Frame
		transitions.check(spec.transition)
		assert(
			spec.initialFocus == nil or type(spec.initialFocus) == "string" or type(spec.initialFocus) == "function",
			"Facet.Sheet: initialFocus must be a name or a function that returns one"
		)
		local gesture = gestureFor(spec, detent, prepared, request, phase, anchor)
		local placed, edge, ready, toward = gesture.placed, gesture.edge, gesture.ready, gesture.toward
		local pulled, painted, keyboard, standing = gesture.pulled, gesture.painted, gesture.keyboard, gesture.standing
		local level, handle, detector, pad = gesture.level, gesture.handle, gesture.detector, gesture.pad
		local canDismiss, interactive, lowest = gesture.canDismiss, gesture.interactive, gesture.lowest
		local unit, extent = gesture.unit, gesture.extent
		local sheetBody = contentFor(spec, gesture)
		local room, plaqued, usable, press = sheetBody.room, sheetBody.plaqued, sheetBody.usable, sheetBody.press
		local panelWidth, contentSize = sheetBody.panelWidth, sheetBody.contentSize
		local function anchors(use: ComposeTypes.Use): (number, number)
			local placement = use(placed)
			return if placement == "side" then (if edge == "left" then 0 else 1) else 0.5,
				if placement == "center" then 0.5 else 1
		end
		local shown: Nav.Presence
		local moving: transitions.Motion? = nil
		if spec.transition ~= nil then
			local arrived = arrival.ready(phase)
			moving = transitions.create(
				ctx,
				if spec.transition == false then {} else spec.transition,
				Compose.formula(function(use: Types.Use): boolean
					return phase == nil or not use(phase.exiting)
				end),
				false,
				Compose.formula(function(use: Types.Use): boolean
					return use(ready) and (arrived == nil or use(arrived))
				end),
				spec.transition == false
			)
			local custom = assert(moving)
			if phase then
				transitions.completions[phase] = custom.completed
				Compose.cleanup(function()
					transitions.completions[phase] = nil
				end)
			end
			shown = {
				travel = function(): number
					return 1
				end,
				opacity = function(use: Types.Use?): number
					return ctx.read(custom.opacity, use)
				end,
			}
		else
			shown = surfaces.appearance(phase, ctx.motionTiming("sheet"), ready)
		end
		local function travel(use: ComposeTypes.Use): (number, number)
			local rest = 1 - shown.travel(use)
			if rest <= 0 then
				return if use(placed) == "side" then toward() * pulled(use) else 0, 0
			end
			local placement = use(placed)
			if placement == "side" then
				local shift = pulled(use)
				return toward() * (shift + (use(panelWidth) - shift) * rest), 0
			end
			if placement == "center" then
				return 0, 0
			end
			return 0, math.ceil(painted(use) * rest)
		end
		runtime.decorate(room.frame, {
			[Compose.group({ "Position", "Size" })] = function(use: ComposeTypes.Use): (UDim2, UDim2)
				local left, top, right, bottom =
					pad("left", use), pad("top", use), pad("right", use), pad("bottom", use)
				local height = standing(use) - top - bottom - sheetBody.guideReserve(use)
				return D2.fromOffset(left, top), D2.new(1, -left - right, 0, math.max(0, height))
			end,
		})
		local panelProps: Types.CanvasGroupNativeProps = {
			Name = "SheetPanel",
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			AnchorPoint = function(use: ComposeTypes.Use)
				local anchorX, anchorY = anchors(use)
				return V2.new(anchorX, anchorY)
			end,
			Position = function(use: ComposeTypes.Use)
				local anchorX, anchorY = anchors(use)
				local y = (if anchorY == 1 then -keyboard(use) else -keyboard(use) / 2) + standing(use) - painted(use)
				local dx, dy = travel(use)
				return D2.new(anchorX, dx, anchorY, y + dy)
			end,
			AutomaticSize = E.AutomaticSize.None,
			Size = function(use: ComposeTypes.Use)
				return D2.fromOffset(use(panelWidth), standing(use))
			end,
			GroupTransparency = function(use: ComposeTypes.Use)
				return if moving
					then 0
					elseif not use(ready) then 1
					elseif level(use) == "limited" then 1 - shown.opacity(use)
					else 0
			end,
		}
		for _, child in { handle, room.frame, ctx.corner(), detector("PanelDrag", "panel") } :: { Instance } do
			panelProps[#panelProps + 1] = child
		end
		if sheetBody.guide then
			panelProps[#panelProps + 1] = sheetBody.guide
		end
		local panel = ctx.fade(panelProps, true)
		local presentation: GuiObject = panel
		if moving then
			local custom = moving
			presentation = ctx.fade({
				Name = "SheetTransition",
				BackgroundTransparency = 1,
				AnchorPoint = panelProps.AnchorPoint,
				Position = panelProps.Position,
				Size = panelProps.Size,
				GroupTransparency = function(use: Types.Use): number
					return use(custom.transparency)
				end,
				Interactable = function(use: Types.Use): boolean
					return not use(custom.interacting)
						and use(custom.opacity) == 1
						and (phase == nil or not use(phase.exiting))
				end,
				panel,
			}, nil, false)
			runtime.decorate(panel, {
				AnchorPoint = V2.zero,
				Position = D2.fromScale(0, 0),
				Size = D2.fromScale(1, 1),
			})
			custom.apply(panel)
		end
		ctx.styled(panel, "sheet")
		runtime.decorate(panel, {
			Attributes = {
				FacetPlacement = function(use: ComposeTypes.Use): string
					return use(placed)
				end,
			},
		})
		surfaces.skin(panel, nil, {
			padding = false,
			title = if spec.header == nil then spec.title else nil,
			onCaption = function(on: boolean)
				plaqued:set(on)
			end,
		})
		local overlay = surfaces.modal(function()
			return presentation
		end, function()
			if not canDismiss() then
				return
			end
			if prepared.cancel and usable(prepared.cancel) then
				press(prepared.cancel)
			else
				interactive("cancel")
			end
		end, {
			entry = sheetBody.entry,
			canDismiss = function(use: ComposeTypes.Use)
				return canDismiss(use)
			end,
			onOutside = function()
				interactive("outside")
			end,
			exiting = if phase then phase.exiting else nil,
			appearance = function(use: ComposeTypes.Use?): number
				local base = shown.opacity(use)
				if not canDismiss(use) then
					return base
				end
				if readSource(placed, use) == "side" then
					local width = readSource(panelWidth, use)
					return if width > 0 then base * math.clamp(1 - pulled(use) / width, 0, 1) else base
				end
				local rest = lowest(use)
				return if rest > 0 then base * math.clamp(painted(use) / rest, 0, 1) else base
			end,
		})
		local scale = ctx.layoutUnit(overlay)
		Compose.watch(function(use: ComposeTypes.Use)
			unit:set(use(scale))
		end)
		local size = ctx.layoutSize(overlay, unit)
		local measured = Compose.cell(false)
		Compose.watch(function(use: ComposeTypes.Use)
			local value = use(size)
			if value.Y > 0 then
				extent:set(value)
				measured:set(true)
			end
		end)
		if frames and not ready:peek() then
			local function contentGeometry(): string
				local origin = panel.AbsolutePosition
				local signature: { string } = {}
				for _, node in panel:GetDescendants() do
					if node:IsA("GuiObject") then
						local entry = `{node.AbsolutePosition - origin}:{node.AbsoluteSize}:{node.Visible}`
						if node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox") then
							entry ..= `:{node.TextBounds}`
						end
						table.insert(signature, entry)
					end
				end
				return table.concat(signature, ";")
			end
			local fontsReady = fontReadiness(ctx, { panel })
			local settled = runtime.settled {
				ready = fontsReady,
				sample = function(): string
					return string.format(
						"%d %d %d %d %d %s",
						extent:peek().X,
						extent:peek().Y,
						panel.AbsoluteSize.X,
						contentSize:peek().Y,
						room.pinned:peek(),
						contentGeometry()
					)
				end,
				equals = function(left: string, right: string): boolean
					return measured:peek() and left == right
				end,
				timeout = ctx.metric("motion.restLimit"),
			}
			Compose.watch(function(use: ComposeTypes.Use)
				if use(settled) then
					ready:set(true)
				end
			end)
		end
		surfaces.keep(spec.content, spec.header, spec.hero and spec.hero.content)
		return overlay
	end

	UI.Sheet = ctx.construct("Sheet", function(spec: NavigationProps.SheetSpec): Frame
		assert(
			spec.onPresentedChange == nil or type(spec.onPresentedChange) == "function",
			"Sheet.onPresentedChange must be a function"
		)
		local prepared = prepare(spec)
		local detent = writableDetent(spec, prepared)
		assert(
			type(spec.isPresented) == "table" and spec.isPresented.set,
			"Sheet.isPresented requires a writable Compose cell"
		)
		local root = Host.Frame(
			ctx.props(spec, KEYS, { Name = "Sheet", BackgroundTransparency = 1, Size = D2.fromOffset(0, 0) })
		)
		surfaces.attach(root, {
			surfaces.overlay(root, spec.isPresented, function(phase)
				return modalFor(spec, detent, prepared, nil, phase, root)
			end, {
				motion = ctx.motionTiming("sheet"),
				failure = function(failure)
					root:SetAttribute("FacetError", tostring(failure))
					spec.isPresented:set(false)
					if ctx.config.onError then
						ctx.config.onError(failure)
					end
					return Host.Folder "FailedSheet" {}
				end,
			}),
		})
		return root
	end)

	surfaces.sheetModal = function(
		spec: NavigationProps.SheetSpec,
		request: Nav.SheetRequest,
		phase: Nav.PresencePhase?
	): Frame
		local prepared = prepare(spec)
		return modalFor(spec, writableDetent(spec, prepared), prepared, request, phase, nil)
	end
end
]]></ProtectedString>
							<string name="ScriptGuid">{02EEBE87-6DFE-460A-AA74-AE8753227DB4}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">nav_sheet</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc38900000493</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="183">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local Overlay = require("./overlay_types")
local ComposeTypes = require("../vendor/compose/core")
local parts = require("./overlay_parts")
local NavigationProps = require("./navigation_props")
local InputProps = require("./input_props")
local sheetGesture = require("./nav_sheet_gesture")

export type SheetContent = {
	plaqued: ComposeTypes.Cell<boolean>,
	usable: (Overlay.Action?) -> boolean,
	press: (Overlay.Action) -> (),
	panelWidth: ComposeTypes.Formula<number>,
	contentSize: ComposeTypes.Cell<Vector2>,
	room: parts.Room,
	entry: () -> GuiObject?,
	guide: Frame?,
	guideReserve: (ComposeTypes.Use) -> number,
}

return function(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	surfaces: Nav.Surfaces
): (NavigationProps.SheetSpec, sheetGesture.Gesture) -> SheetContent
	local Compose, Host, runtime, read = ctx.Compose, ctx.Host, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	return function(spec: NavigationProps.SheetSpec, gesture: sheetGesture.Gesture): SheetContent
		local grabber, canDismiss, close, unit, extent =
			gesture.grabber, gesture.canDismiss, gesture.close, gesture.unit, gesture.extent
		local pad, standing, hugHeight, tallest = gesture.pad, gesture.standing, gesture.hugHeight, gesture.tallest
		local regions: { GuiObject } = {}
		local plaqued = Compose.cell(false)
		local actionRegion: Frame? = nil
		local hero = spec.hero
		local sticky = hero ~= nil and hero.sticky == true
		local overHero = spec.header == false and hero ~= nil
		local closeCommand: TextButton? = nil
		local function showClose(use: ComposeTypes.Use?): boolean
			return spec.closeButton ~= false
				and (spec.closeButton ~= nil or (not gesture.showGrabber(use) and canDismiss(use)))
		end
		local function linkClose(button: TextButton): TextButton
			closeCommand = button
			button.SelectionOrder = -1
			return button
		end
		local function closeControl(): TextButton?
			local explicit = spec.closeButton
			local function activate()
				close("close")
			end
			if explicit == false then
				return nil
			end
			if explicit ~= nil and explicit ~= true then
				return linkClose(UI.Button "Close" {
					label = explicit :: Types.Value<string>,
					icon = "close",
					appearance = if overHero then "inverse" else "utility",
					LayoutOrder = 2,
					onActivate = activate,
				})
			end
			return linkClose(UI.Button "Close" {
				name = "Close",
				Visible = showClose,
				icon = "close",
				appearance = if overHero then "inverse" else nil,
				LayoutOrder = 2,
				Size = D2.fromOffset(44, 44),
				AutomaticSize = E.AutomaticSize.None,
				onActivate = activate,
			})
		end
		local function heroFrame(): Frame
			local current = assert(hero)
			local frame = parts.media(ctx, current, "Hero")
			if current.content then
				local children: { Types.Child } = {
					Host.UIListLayout({ SortOrder = E.SortOrder.LayoutOrder }),
					Host.UIPadding({
						PaddingLeft = ctx.types.UDim.new(0, 16),
						PaddingRight = ctx.types.UDim.new(0, 16),
						PaddingBottom = ctx.types.UDim.new(0, 12),
					}),
				}
				if overHero then
					table.insert(
						children,
						Host.Frame "Strip" {
							BackgroundTransparency = 1,
							LayoutOrder = 0,
							Size = function(use: ComposeTypes.Use)
								return D2.new(1, 0, 0, math.max(44, ctx.metric("targetSizes.minimum", use)) + 8)
							end,
						}
					)
				end
				local content = current.content
				local node: Instance = if type(content) == "function" then content() else content :: Instance
				if node:IsA("GuiObject") then
					runtime.decorate(node, { LayoutOrder = 1 })
				end
				table.insert(children, node)
				surfaces.attach(frame, {
					Host.Frame "Art" {
						BackgroundTransparency = 1,
						Size = D2.fromScale(1, 1),
						table.unpack(children),
					},
				})
			end
			if overHero then
				local close = closeControl()
				if close then
					surfaces.attach(frame, {
						Host.Frame "Utilities" {
							BackgroundTransparency = 1,
							AnchorPoint = V2.new(1, 0),
							Position = D2.new(1, -8, 0, 8),
							Size = D2.fromOffset(0, 0),
							AutomaticSize = E.AutomaticSize.XY,
							ZIndex = 3,
							close,
						},
					})
				end
			end
			return frame
		end
		if sticky then
			table.insert(regions, heroFrame())
		end
		if not overHero then
			local header: { Types.Child } = {}
			if spec.header == nil then
				table.insert(
					header,
					ctx.styled(
						ctx.text({
							Name = "Title",
							LayoutOrder = 1,
							Visible = function(use: ComposeTypes.Use)
								return not use(plaqued)
							end,
							Text = function(use: ComposeTypes.Use)
								return read(spec.title, use) or ""
							end,
							TextWrapped = true,
							Size = D2.new(1, 0, 0, 0),
							AutomaticSize = E.AutomaticSize.Y,
							Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }),
						}),
						"type-heading"
					)
				)
			elseif spec.header ~= false then
				local custom = spec.header
				local node: Instance = if type(custom) == "function" then custom() else custom :: Instance
				if node:IsA("GuiObject") then
					surfaces.attach(node, { Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }) })
				end
				table.insert(header, node)
			end
			local close = closeControl()
			if close then
				table.insert(header, close)
			end
			if #header > 0 then
				local row: Types.FrameNativeProps = {
					Name = "Header",
					BackgroundTransparency = 1,
					Size = D2.new(1, 0, 0, 0),
					AutomaticSize = E.AutomaticSize.Y,
				}
				row[#row + 1] = Host.UIListLayout({
					FillDirection = E.FillDirection.Horizontal,
					HorizontalAlignment = E.HorizontalAlignment.Right,
					VerticalAlignment = E.VerticalAlignment.Center,
					SortOrder = E.SortOrder.LayoutOrder,
					Padding = ctx.types.UDim.new(0, 8),
				})
				for _, child in header do
					row[#row + 1] = child
				end
				table.insert(regions, Host.Frame(row))
			end
		end
		local inset = if spec.contentInset == "none" then 0 else 8
		local panelWidth = Compose.formula(function(use: ComposeTypes.Use): number
			return math.max(0, math.min(parts.width(ctx, spec.width, use), use(extent).X))
		end)
		local function contentPadding(): UIPadding
			local function horizontal(use: ComposeTypes.Use): UDim
				local growth = math.max(0, ctx.metric("motion.materialize.lift", use) - 1)
				local width = math.max(0, use(panelWidth) - pad("left", use) - pad("right", use))
				return if width * growth > inset then ctx.types.UDim.new(growth, 0) else ctx.types.UDim.new(0, inset)
			end
			return Host.UIPadding {
				PaddingLeft = if inset == 0 then ctx.types.UDim.new(0, 0) else horizontal,
				PaddingRight = if inset == 0 then ctx.types.UDim.new(0, 0) else horizontal,
				PaddingTop = ctx.types.UDim.new(0, inset),
				PaddingBottom = ctx.types.UDim.new(0, inset),
			}
		end
		local bodyLayout = Host.UIListLayout({ SortOrder = E.SortOrder.LayoutOrder })
		local bodyPadding = contentPadding()
		local bodyChildren: { Types.Child } = { bodyLayout }
		local content: Instance = if type(spec.content) == "function"
			then (spec.content :: () -> Instance)()
			else spec.content :: Instance
		local scrollViewport: Frame? = nil
		local bodyContent = content
		if content:IsA("GuiObject") and content.Size.Y.Scale > 0 then
			scrollViewport = Host.Frame "SheetScrollViewport" {
				BackgroundTransparency = 1,
				Size = D2.new(1, 0, 0, 0),
				content,
			}
			bodyContent = assert(scrollViewport)
		end
		if hero and not sticky then
			table.insert(bodyChildren, heroFrame())
			local inner: Types.FrameNativeProps = {
				Name = "Inset",
				BackgroundTransparency = 1,
				LayoutOrder = 2,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
			}
			inner[#inner + 1] = Host.UIListLayout({ SortOrder = E.SortOrder.LayoutOrder })
			inner[#inner + 1] = contentPadding()
			inner[#inner + 1] = bodyContent
			table.insert(bodyChildren, Host.Frame(inner))
		else
			table.insert(bodyChildren, bodyPadding)
			table.insert(bodyChildren, bodyContent)
		end
		local flex = Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill })
		local bodyProps: Types.ScrollingFrameNativeProps = {
			Name = "SheetContent",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollingDirection = E.ScrollingDirection.Y,
			ScrollBarThickness = 6,
			ClipsDescendants = true,
			Selectable = false,
			SelectionGroup = false,
			flex :: Instance,
		}
		local body = parts.scroller(ctx, bodyProps, bodyChildren, { name = "SheetFlow" })
		if scrollViewport then
			local window = ctx.observe.AbsoluteWindowSize(body)
			runtime.decorate(scrollViewport, {
				Size = function(use: ComposeTypes.Use): UDim2
					return D2.new(1, 0, 0, math.max(0, use(window).Y / use(unit) - inset * 2))
				end,
			})
		end
		local function linkDismissal()
			local entry: GuiObject? = nil
			local command: GuiObject? = nil
			local previousUp: GuiObject? = nil
			local function linkContent(use: ComposeTypes.Use?)
				local nextCommand = if gesture.showGrabber(use)
					then grabber
					elseif showClose(use) then closeCommand
					else nil
				local nextEntry = surfaces.firstSelectable(body)
					or (if actionRegion then surfaces.firstSelectable(actionRegion) else nil)
				if nextEntry == nextCommand then
					nextEntry = surfaces.firstSelectable(content)
				end
				if nextEntry == entry and nextCommand == command then
					return
				end
				if command and entry and entry.NextSelectionUp == command then
					local links = (entry :: unknown) :: { NextSelectionUp: GuiObject? }
					links.NextSelectionUp = previousUp
				end
				if command then
					local links = (
						command :: unknown
					) :: { NextSelectionDown: GuiObject?, NextSelectionRight: GuiObject? }
					links.NextSelectionDown, links.NextSelectionRight = nil, nil
				end
				entry = nextEntry
				command = nextCommand
				if command then
					local outgoing = (
						command :: unknown
					) :: { NextSelectionDown: GuiObject?, NextSelectionRight: GuiObject? }
					outgoing.NextSelectionDown, outgoing.NextSelectionRight = nextEntry, nextEntry
				end
				if nextEntry and command then
					previousUp = nextEntry.NextSelectionUp
					nextEntry.NextSelectionUp = command
				end
			end
			Compose.watch(linkContent)
			runtime.connect(body, "DescendantAdded", function()
				linkContent(nil)
			end)
			Compose.cleanup(function()
				if command and entry and entry.NextSelectionUp == command then
					local links = (entry :: unknown) :: { NextSelectionUp: GuiObject? }
					links.NextSelectionUp = previousUp
				end
			end)
		end
		table.insert(regions, body)
		local function usable(action: Overlay.Action?): boolean
			return parts.usable(ctx, action)
		end
		local function press(action: Overlay.Action)
			if usable(action) then
				action.onActivate()
			end
		end
		local actions = spec.actions or {}
		if #actions > 0 then
			local region = parts.actions(ctx, UI, actions, spec.actionLayout, function(use: ComposeTypes.Use)
				return math.max(0, use(panelWidth) - pad("left", use) - pad("right", use))
			end, press).frame
			actionRegion = region
			table.insert(regions, region)
		end
		local guideRegion: Frame? = nil
		local guideSize: ComposeTypes.Readable<Vector2>? = nil
		local guidePresent: ComposeTypes.Readable<boolean>? = nil
		if spec.guide ~= nil then
			assert(type(spec.guide) == "table", "Facet.Sheet: guide takes ButtonGuide options")
			assert(
				spec.guideAlignment == nil or spec.guideAlignment == "start" or spec.guideAlignment == "end",
				"Facet.Sheet: guideAlignment must be start or end"
			)
			local options = (table.clone(spec.guide) :: unknown) :: { [unknown]: unknown }
			for key in options do
				assert(
					type(key) ~= "string" or string.match(key, "^%u") == nil,
					"Facet.Sheet: guide takes ButtonGuide options; the Sheet places the guide"
				)
			end
			options.Name = "ButtonGuide"
			local guide = UI.ButtonGuide((options :: unknown) :: InputProps.ButtonGuideProps)
			local visible = (ctx.observe.Visible(guide) :: unknown) :: ComposeTypes.Readable<unknown>
			local present = Compose.formula(function(use: ComposeTypes.Use): boolean
				return use(visible) == true
			end)
			local region = Host.Frame "Guide" {
				BackgroundTransparency = 1,
				Selectable = false,
				AnchorPoint = V2.new(0, 1),
				Position = function(use: ComposeTypes.Use): UDim2
					return D2.fromOffset(pad("left", use), standing(use) - pad("bottom", use))
				end,
				Size = function(use: ComposeTypes.Use): UDim2
					return D2.new(1, -pad("left", use) - pad("right", use), 0, 0)
				end,
				AutomaticSize = E.AutomaticSize.Y,
				Visible = present,
				Host.UIListLayout({
					FillDirection = E.FillDirection.Horizontal,
					HorizontalAlignment = if spec.guideAlignment == "start"
						then E.HorizontalAlignment.Left
						else E.HorizontalAlignment.Right,
					SortOrder = E.SortOrder.LayoutOrder,
				}),
				guide,
			}
			guideRegion, guidePresent, guideSize = region, present, ctx.layoutSize(region, unit)
		end
		local function guideReserve(use: ComposeTypes.Use): number
			if guidePresent == nil or guideSize == nil or not use(guidePresent) then
				return 0
			end
			return use(guideSize).Y + 8
		end
		linkDismissal()
		local contentSize = ctx.observe.AbsoluteContentSize(bodyLayout)
		local extra = if hero == nil or sticky then inset * 2 else 0
		local function natural(use: ComposeTypes.Use): number
			return use(contentSize).Y / use(unit) + extra
		end
		local chrome = function(use: ComposeTypes.Use): number
			return pad("top", use) + pad("bottom", use)
		end
		local room = parts.room(ctx, regions, body, natural, function(use: ComposeTypes.Use): number
			return math.max(0, standing(use) - chrome(use) - guideReserve(use))
		end, true, unit)
		runtime.decorate(flex, {
			FlexMode = function(use: ComposeTypes.Use)
				return if use(room.tight) then E.UIFlexMode.None else E.UIFlexMode.Fill
			end,
		})
		Compose.watch(function(use: ComposeTypes.Use)
			local want = natural(use) + use(room.pinned) + chrome(use) + guideReserve(use) + 8
			local previous = hugHeight:peek()
			if want > 0 and (previous == nil or math.abs(previous - want) > 0.5) then
				hugHeight:set(want)
			end
		end)
		if spec.scrollPolicy == "atLargestDetent" then
			runtime.decorate(body, {
				ScrollingEnabled = function(use: ComposeTypes.Use)
					return use(tallest) and not use(room.tight)
				end,
				Active = tallest,
			})
		end
		local function usableWithin(node: GuiObject, region: Instance): boolean
			local at: Instance? = node
			while at and at ~= region do
				if at:IsA("GuiObject") and (not at.Visible or not at.Interactable) then
					return false
				end
				at = at.Parent
			end
			return at == region
		end
		local function firstIn(region: Instance?): GuiObject?
			if region == nil then
				return nil
			end
			local found = surfaces.firstSelectable(region)
			if found and found == closeCommand then
				found = surfaces.firstSelectable(content)
			end
			return if found and found ~= closeCommand and usableWithin(found, region) then found else nil
		end
		local resolved: string | false | nil = nil
		local function wantedName(): string?
			if resolved == nil then
				local wanted = spec.initialFocus
				local name = if type(wanted) == "function" then wanted() else wanted
				assert(
					name == nil or type(name) == "string",
					"Facet.Sheet: initialFocus must return a control's name or nil"
				)
				resolved = if name then name else false
			end
			return if resolved then resolved else nil
		end
		local function named(region: Instance?, name: string): GuiObject?
			if region == nil then
				return nil
			end
			for _, node in region:GetDescendants() do
				if node.Name == name then
					local found = surfaces.firstSelectable(node)
					if found and found ~= closeCommand and usableWithin(found, region) then
						return found
					end
				end
			end
			return nil
		end
		local function entry(): GuiObject?
			local name = wantedName()
			if name then
				local found = named(body, name) or named(actionRegion, name)
				if found then
					return found
				end
			end
			return firstIn(body) or firstIn(actionRegion)
		end
		return {
			entry = entry,
			plaqued = plaqued,
			usable = usable,
			press = press,
			panelWidth = panelWidth,
			contentSize = contentSize,
			room = room,
			guide = guideRegion,
			guideReserve = guideReserve,
		}
	end
end
]]></ProtectedString>
							<string name="ScriptGuid">{64D59AD2-B272-4CFC-B306-C04F8CF0EDD0}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">nav_sheet_content</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc38900000494</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="184">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local Overlay = require("./overlay_types")
local ComposeTypes = require("../vendor/compose/core")
local parts = require("./overlay_parts")
local freeze = require("./freeze")
local NavigationProps = require("./navigation_props")

export type Detent = { id: string, fraction: number?, height: number?, hug: boolean, index: number }
export type Prepared = { detents: { Detent }, byId: { [string]: Detent }, cancel: Overlay.Action? }
export type Detents = {
	prepare: (NavigationProps.SheetSpec) -> Prepared,
	word: (string) -> string,
	writableDetent: (NavigationProps.SheetSpec, Prepared) -> ComposeTypes.Cell<string>,
}

local PLACEMENTS: { [string]: boolean } =
	freeze({ automatic = true, adaptive = true, bottom = true, side = true, center = true })

return function(ctx: Types.Context): Detents
	local function prepare(spec: NavigationProps.SheetSpec): Prepared
		assert(
			spec.detent == nil or type(spec.detent) == "string" or (type(spec.detent) == "table" and spec.detent.set),
			"Sheet.detent requires a detent id or a writable Compose cell"
		)
		local placement = spec.placement or "automatic"
		assert(PLACEMENTS[placement], "Sheet.placement must be automatic, adaptive, bottom, side or center")
		assert(
			spec.edge == nil
				or ((placement == "side" or placement == "adaptive") and (spec.edge == "left" or spec.edge == "right")),
			"Sheet.edge is left or right, and only with placement side or adaptive"
		)
		parts.checkPreset(ctx, "Sheet", "width", spec.width, parts.WIDTH_PRESETS)
		assert(
			spec.closeButton == nil
				or type(spec.closeButton) == "boolean"
				or parts.bound(ctx, spec.closeButton, "string"),
			"Sheet.closeButton must be a boolean or a label"
		)
		local header = spec.header
		assert(
			header == nil or header == false or parts.instance(header) or type(header) == "function",
			"Sheet.header must be an Instance, a content factory or false"
		)
		assert(
			spec.contentInset == nil or spec.contentInset == "standard" or spec.contentInset == "none",
			"Sheet.contentInset must be standard or none"
		)
		assert(
			spec.actionLayout == nil
				or spec.actionLayout == "automatic"
				or spec.actionLayout == "row"
				or spec.actionLayout == "stacked",
			"Sheet.actionLayout must be automatic, row or stacked"
		)
		assert(
			spec.scrollPolicy == nil or spec.scrollPolicy == "always" or spec.scrollPolicy == "atLargestDetent",
			"Sheet.scrollPolicy must be always or atLargestDetent"
		)
		assert(
			spec.dragIndicator == nil
				or spec.dragIndicator == "automatic"
				or spec.dragIndicator == "visible"
				or spec.dragIndicator == "hidden",
			"Sheet.dragIndicator must be automatic, visible or hidden"
		)
		parts.checkHero("UI.Sheet", spec.hero)
		parts.checkActions(ctx, "UI.Sheet", spec.actions, math.huge)
		local cancel: Overlay.Action? = nil
		local listed: { Overlay.Action } = spec.actions or {}
		for _, action in listed do
			if action.role == "cancel" then
				cancel = action
			end
		end
		local detents: { Detent } = {}
		local byId: { [string]: Detent } = {}
		local entries: { Nav.SheetDetent } = spec.detents or { "medium", "large" }
		assert(#entries > 0, "Invalid Sheet detent")
		for index, entry in entries do
			local d: Detent
			if entry == "medium" then
				d = { id = "medium", fraction = 0.5, hug = false, index = index }
			elseif entry == "large" then
				d = { id = "large", fraction = 0.95, hug = false, index = index }
			elseif entry == "hug" then
				d = { id = "hug", hug = true, index = index }
			else
				assert(type(entry) == "table", "Invalid Sheet detent")
				local custom = (entry :: unknown) :: { [string]: unknown }
				for key in custom do
					assert(key == "id" or key == "fraction" or key == "height", "Invalid Sheet detent")
				end
				assert(type(custom.id) == "string" and custom.id ~= "", "Invalid Sheet detent")
				assert(
					(custom.fraction == nil) ~= (custom.height == nil),
					"Sheet detent requires exactly one of fraction or height"
				)
				local fraction, height = custom.fraction, custom.height
				assert(
					if fraction ~= nil
						then type(fraction) == "number" and fraction > 0 and fraction <= 1
						else type(height) == "number" and height > 0 and height < math.huge,
					"Invalid Sheet detent extent"
				)
				d = {
					id = custom.id :: string,
					fraction = fraction :: number?,
					height = height :: number?,
					hug = false,
					index = index,
				}
			end
			assert(not byId[d.id], "Sheet detents require unique ids")
			byId[d.id] = d
			table.insert(detents, d)
		end
		return { detents = detents, byId = byId, cancel = cancel }
	end

	local function word(id: string): string
		if id == "hug" then
			return "Fit"
		end
		return string.upper(string.sub(id, 1, 1)) .. string.sub(id, 2)
	end

	local function writableDetent(spec: NavigationProps.SheetSpec, prepared: Prepared): ComposeTypes.Cell<string>
		local authored = spec.detent
		if type(authored) == "table" then
			return authored
		end
		local initial = if type(authored) == "string" and prepared.byId[authored]
			then authored
			else prepared.detents[1].id
		return ctx.Compose.cell(initial)
	end
	return { prepare = prepare, word = word, writableDetent = writableDetent }
end
]]></ProtectedString>
							<string name="ScriptGuid">{15936D07-CD8C-4CC3-9792-4527BB877793}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
