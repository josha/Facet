						<Item class="StringValue" referent="471">
							<Properties>
								<string name="Value"><![CDATA[# ErrorBoundary.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
fallback: (failure: unknown, retry: () -> ()) -> Child = required
height: Value<(number | "fill" | "hug")>? = omitted
maxWidth: ValueNumber? = omitted
onError: ((failure: unknown) -> ())? = omitted
ref: ((Frame) -> ())? = omitted
view: () -> Child = required
width: Value<(number | "fill" | "hug")>? = omitted]]></string>
