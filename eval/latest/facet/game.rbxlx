	return {
		spec = spec,
		session = session,
		preferred = preferred,
		painted = painted,
		appearance = appearance,
		glyphOnly = glyphOnly,
		follow = follow,
		gestureSelection = gestureSelection,
		contentFit = contentFit,
		scrim = scrim,
		corner = corner,
		ringWidth = ringWidth,
		reduced = reduced,
		opened = opened,
		path = path,
		candidate = candidate,
		interacting = interacting,
		naming = naming,
		touchPoint = touchPoint,
		holding = holding,
		jump = jump,
		cancel = cancel,
		close = close,
		open = open,
		back = back,
		nativeActivate = nativeActivate,
		pointing = pointing,
		isPointer = isPointer,
		beginPointer = beginPointer,
		skin = skin,
	}
