	reveal: boolean?,
	leading: boolean?,
	trailing: boolean?,
}
export type CompositionRows = "match" | "fit"
export type CompositionOptions = {
	gap: Space?,
	padding: Padding?,
	topbar: Engine.ValueBoolean?,
	rows: Engine.Value<CompositionRows>?,
	passive: boolean?,
}
return {}
]]></ProtectedString>
							<string name="ScriptGuid">{CC717E6B-9764-4C52-B203-F73338C2F543}</string>
