padding: number? = omitted
presenting: Value<P>? = omitted
ref: ((Frame) -> ())? = omitted
severity: "information" | "warning" | "critical"? = omitted
suppression: { isSuppressed: Cell<boolean>, label: ValueString? }? = omitted
