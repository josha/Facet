								<string name="Value"><![CDATA[# LevelPicker.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
allowZero: boolean? = omitted
count: number? = omitted
enabled: ValueBoolean? = omitted
glyphs: Glyphs? = omitted
