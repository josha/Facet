					<Item class="ModuleScript" referent="96">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Types = require("./types")
local ComposeTypes = require("../vendor/compose/core")
local decoration = require("./native_decoration")

return function(
	ctx: Types.Context,
	node: GuiObject,
	scale: UIScale,
	geometry: { Size: Types.Value<UDim2>?, AutomaticSize: Types.Value<Enum.AutomaticSize>?, reflow: boolean? }
)
	local Compose, runtime, Host = ctx.Compose, ctx.runtime, ctx.Host
	local D2, V2, E = ctx.types.UDim2, ctx.types.Vector2, ctx.types.Enum
	local size, automatic = node.Size, node.AutomaticSize
	local measured = ctx.layoutSize(node, ctx.layoutUnit(node, "FeedbackUnit"))
	local measurement = node:FindFirstChild("FeedbackUnit")
	local factor = ctx.observe.Scale(scale)
	local natural = Compose.cell(V2.zero)
	local painted: ComposeTypes.Readable<Vector2>? = nil
	local dressed = Compose.cell(false)
	local function axes(use: ComposeTypes.Use): (boolean, boolean)
		local value = ctx.read(geometry.AutomaticSize, use) or automatic
		return value == E.AutomaticSize.X or value == E.AutomaticSize.XY,
			value == E.AutomaticSize.Y or value == E.AutomaticSize.XY
	end
	local function moving(use: ComposeTypes.Use): boolean
		return use(factor) ~= 1 and use(natural).X > 0 and use(natural).Y > 0
	end
	Compose.watch(function(use: ComposeTypes.Use)
		local extent = use(measured)
		if use(factor) == 1 then
			natural:set(extent)
		end
	end)
	runtime.decorate(node, {
		Size = function(use: ComposeTypes.Use): UDim2
			local base = ctx.read(geometry.Size, use) or size
			if not moving(use) then
				return base
			end
			local rest = use(natural)
			if not geometry.reflow then
				return D2.fromOffset(math.ceil(rest.X), math.ceil(rest.Y))
			end
			local observed = if painted and use(dressed) then use(painted) else rest
			local extent = V2.new(math.max(observed.X, rest.X), math.max(observed.Y, rest.Y))
			local x, y = axes(use)
			return D2.new(
				if x then 0 else base.X.Scale,
				if x then math.ceil(math.max(base.X.Offset, extent.X)) else base.X.Offset,
				if y then 0 else base.Y.Scale,
				if y then math.ceil(math.max(base.Y.Offset, extent.Y)) else base.Y.Offset
			)
		end,
		AutomaticSize = function(use: ComposeTypes.Use): Enum.AutomaticSize
			return if moving(use) then E.AutomaticSize.None else ctx.read(geometry.AutomaticSize, use) or automatic
		end,
	})
	Compose.cleanup(function()
		node.Size = ctx.read(geometry.Size) or size
		node.AutomaticSize = ctx.read(geometry.AutomaticSize) or automatic
	end)
	local paintProps: Types.TextLabelNativeProps = {
		Name = "FeedbackPaint",
		Size = if geometry.reflow
			then function(use: ComposeTypes.Use): UDim2
				local x, y = axes(use)
				return D2.fromScale(if x then 0 else 1, if y then 0 else 1)
			end
			else D2.fromScale(1, 1),
		AnchorPoint = V2.new(0.5, 0.5),
		Position = D2.fromScale(0.5, 0.5),
		AutomaticSize = if geometry.reflow then geometry.AutomaticSize or automatic else E.AutomaticSize.None,
		Visible = false,
		Text = "",
		scale,
	}
	for _, property in { "BackgroundColor3", "BackgroundTransparency", "BorderColor3", "BorderSizePixel", "ZIndex" } do
		((paintProps :: unknown) :: { [string]: unknown })[property] = (
			(ctx.observeStyled :: unknown) :: { [string]: (Instance) -> unknown }
		)[property](node)
	end
	if node:IsA("TextButton") or node:IsA("TextBox") then
		for _, property in
			{
				"Text",
				"TextColor3",
				"TextTransparency",
				"TextStrokeColor3",
				"TextStrokeTransparency",
				"FontFace",
				"TextSize",
				"TextXAlignment",
				"TextYAlignment",
				"TextWrapped",
				"RichText",
				"TextScaled",
				"TextTruncate",
				"LineHeight",
			}
		do
			((paintProps :: unknown) :: { [string]: unknown })[property] = (
				(ctx.observeStyled :: unknown) :: { [string]: (Instance) -> unknown }
			)[property](node)
		end
	end
	local paint = Host.TextLabel(paintProps)
	if geometry.reflow then
		painted = ctx.layoutSize(paint)
	end
	local boundary = decoration(Compose, runtime, ctx.types, node, paint, { immediate = true })
	runtime.mount(function()
		return if geometry.reflow then Host.Folder "FeedbackLayer" { boundary } else boundary
	end, node)
	runtime.mountFragment(function()
		return {
			Compose.show(moving, function()
				local worn: { [string]: boolean } = {}
				Compose.watch(function(use: ComposeTypes.Use)
					use(factor)
					local current: { [string]: boolean } = {}
					for _, tag in node:GetTags() do
						current[tag] = true
						if not worn[tag] then
							paint:AddTag(tag)
						end
					end
					for tag in worn do
						if not current[tag] then
							paint:RemoveTag(tag)
						end
					end
					worn = current
				end)
				Compose.cleanup(function()
					for tag in worn do
						paint:RemoveTag(tag)
					end
				end)
				local unmount: (() -> ())? = nil
				local function dress()
					paint.Visible = true
					dressed:set(true)
					unmount = runtime.mountFragment(function()
						local children = node:GetChildren()
						local selected = if ctx.config.guiService then ctx.config.guiService.SelectedObject else nil
						for _, child in children do
							if
								child ~= boundary
								and child ~= measurement
								and (
									child:IsA("GuiObject")
									or child:IsA("UIGridStyleLayout")
									or child:IsA("UICorner")
									or child:IsA("UIStroke")
									or child:IsA("UIGradient")
									or child:IsA("UIShadow")
								)
							then
								(child :: Instance).Parent = paint
							end
						end
						if selected and ctx.config.guiService then
							ctx.config.guiService.SelectedObject = selected
						end
						local padding = node:FindFirstChildWhichIsA("UIPadding")
						local observePadding = (
							ctx.observeStyled :: unknown
						) :: { [string]: (Instance) -> ComposeTypes.Cell<UDim> }
						if padding then
							runtime.mount(function()
								return Host.UIPadding({
									PaddingLeft = observePadding["PaddingLeft"](padding),
									PaddingRight = observePadding["PaddingRight"](padding),
									PaddingTop = observePadding["PaddingTop"](padding),
									PaddingBottom = observePadding["PaddingBottom"](padding),
								})
							end, paint)
						end
						Compose.cleanup(function()
							local currentSelection = if ctx.config.guiService
								then ctx.config.guiService.SelectedObject
								else nil
							for _, child in children do
								if child.Parent == paint then
									child.Parent = node
								end
							end
							if currentSelection and ctx.config.guiService then
								ctx.config.guiService.SelectedObject = currentSelection
							end
						end)
						return { Host.UIGradient "FeedbackMask" { Transparency = ctx.types.NumberSequence.new(1) } }
					end, node)
				end
				local frames = ctx.config.services.RunService
				local connection: RBXScriptConnection? = nil
				if frames then
					connection = frames.Heartbeat:Connect(function()
						if connection then
							connection:Disconnect()
							connection = nil
						end
						dress()
					end)
				else
					dress()
				end
				Compose.cleanup(function()
					if connection then
						connection:Disconnect()
					end
					if unmount then
						unmount()
					end
					paint.Visible = false
					dressed:set(false)
				end)
				return Compose.fragment(function()
					return {}
				end)
			end),
		}
	end, node)
end
]]></ProtectedString>
							<string name="ScriptGuid">{BB51F6F6-3E15-47E1-A73B-99B4EF1767DA}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">feedback_paint</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc3890000043d</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="97">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Shared = require("./types")

export type Mark = "required" | "optional"
export type Appearance = "standard" | "contrast" | "utility"
export type Corners = "pill" | "square"
export type Options = {
	label: Shared.Value<string>?,
	requiredMark: Mark?,
	hint: Shared.Value<string>?,
	errorText: Shared.Value<string>?,
	controlSize: Shared.Value<Shared.ControlSize?>?,
	appearance: Shared.Value<string>?,
	corners: Corners?,
}
export type Wrap = {
	control: string,
	spec: Options,
	plate: GuiObject,
	focus: () -> (),
	enabled: (ComposeTypes.Use?) -> boolean,
	message: ComposeTypes.Readable<string>?,
	native: Shared.FrameNativeProps,
}
export type Chrome = {
	KEYS: { string },
	present: (Options) -> boolean,
	check: (string, Options) -> (),
	labelText: (Options, ComposeTypes.Use?) -> string,
	errorOf: (Options, ComposeTypes.Readable<string>?) -> (ComposeTypes.Use?) -> string,
	paint: (string, GuiObject, Options, ((ComposeTypes.Use?) -> boolean)?) -> (),
	wrap: (Wrap) -> Frame,
}

local KEYS = table.freeze({ "label", "requiredMark", "hint", "errorText", "controlSize", "appearance", "corners" })
local APPEARANCE: { [string]: string } = {
	standard = "facet-field",
	contrast = "facet-control",
	utility = "facet-appearance-utility",
}

return function(ctx: Shared.Context): Chrome
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D, D2, V2 = ctx.types.Enum, ctx.types.UDim, ctx.types.UDim2, ctx.types.Vector2
	local chrome = {} :: Chrome
	chrome.KEYS = KEYS
	local function dynamic(source: unknown): boolean
		return Compose.isReadable(source) or type(source) == "function"
	end
	function chrome.present(spec: Options): boolean
		for _, key in KEYS do
			if ((spec :: unknown) :: { [string]: unknown })[key] ~= nil then
				return true
			end
		end
		return false
	end
	local function appearanceWord(control: string, word: unknown): Appearance
		if word == nil then
			return "standard"
		end
		if type(word) ~= "string" or APPEARANCE[word] == nil then
			error(`Facet UI.{control}: appearance must be standard | contrast | utility (got {tostring(word)})`, 0)
		end
		return word :: Appearance
	end
	function chrome.check(control: string, spec: Options)
		local mark: unknown = spec.requiredMark
		if mark ~= nil and mark ~= "required" and mark ~= "optional" then
			error(`Facet UI.{control}: requiredMark must be required | optional (got {tostring(mark)})`, 0)
		end
		for _, key in { "label", "hint", "errorText" } do
			local value = read(((spec :: unknown) :: { [string]: Shared.Value<unknown> })[key])
			if value ~= nil and type(value) ~= "string" then
				error(`Facet UI.{control}: {key} must be a string or a readable string (got {typeof(value)})`, 0)
			end
		end
		local corners: unknown = spec.corners
		if corners ~= nil and corners ~= "pill" and corners ~= "square" then
			error(`Facet UI.{control}: corners must be pill | square (got {tostring(corners)})`, 0)
		end
		appearanceWord(control, read(spec.appearance))
		if spec.controlSize ~= nil then
			ctx.controlSize(spec.controlSize, "height")
		end
	end
	function chrome.labelText(spec: Options, use: ComposeTypes.Use?): string
		local words = read(spec.label, use) or ""
		return if spec.requiredMark == "required" then words .. " *" else words
	end
	function chrome.errorOf(spec: Options, internal: ComposeTypes.Readable<string>?): (ComposeTypes.Use?) -> string
		return function(use: ComposeTypes.Use?): string
			local authored = read(spec.errorText, use)
			if type(authored) == "string" and authored ~= "" then
				return authored
			end
			local own = if internal then read(internal, use) else nil
			return if type(own) == "string" then own else ""
		end
	end
	local function tagWhile(node: Instance, tag: string, on: boolean)
		if on then
			node:AddTag(tag)
		elseif node:HasTag(tag) then
			node:RemoveTag(tag)
		end
	end
	function chrome.paint(control: string, plate: GuiObject, spec: Options, failing: ((ComposeTypes.Use?) -> boolean)?)
		local applied: string? = nil
		local function apply(use: ComposeTypes.Use?)
			local tag = APPEARANCE[appearanceWord(control, read(spec.appearance, use))]
			if applied ~= tag then
				if applied then
					plate:RemoveTag(applied)
				end
				plate:AddTag(tag)
				applied = tag
			end
		end
		if dynamic(spec.appearance) then
			Compose.watch(apply)
		else
			apply()
		end
		if spec.corners then
			runtime.mountFragment(function()
				return { Host.UICorner "Corners" { CornerRadius = D.new(if spec.corners == "pill" then 1 else 0, 0) } }
			end, plate)
		end
		if failing then
			Compose.watch(function(use: ComposeTypes.Use)
				tagWhile(plate, "facet-invalid", failing(use))
			end)
		end
	end
	function chrome.wrap(options: Wrap): Frame
		local spec, plate = options.spec, options.plate
		local failure = chrome.errorOf(spec, options.message)
		local function line(use: ComposeTypes.Use?): string
			local text = failure(use)
			return if text ~= "" then text else read(spec.hint, use) or ""
		end
		local parts: { ComposeTypes.Child } = {}
		if spec.label ~= nil then
			local label = Host.TextButton "Label" {
				Text = "",
				AutoButtonColor = false,
				Selectable = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
				Interactable = function(use: ComposeTypes.Use)
					return options.enabled(use)
				end,
				Activated = function()
					if options.enabled() then
						options.focus()
					end
				end,
				ctx.styled(
					ctx.text({
						Name = "Title",
						Text = function(use: ComposeTypes.Use)
							return chrome.labelText(spec, use)
						end,
						Size = D2.new(1, 0, 0, 0),
						AutomaticSize = E.AutomaticSize.Y,
						TextWrapped = true,
					}),
					"type-label"
				),
			}
			table.insert(parts, label)
		end
		local inputKind = ctx.effectiveInput()
		local function targetFloor(use: ComposeTypes.Use?): number
			return if read(spec.appearance, use) == "utility" and inputKind(use) == "KeyboardAndMouse"
				then 0
				else math.max(44, ctx.metric("targetSizes.minimum", use))
		end
		local body: GuiObject = plate
		if spec.controlSize ~= nil then
			local function plateHeight(use: ComposeTypes.Use): number
				local package = read(ctx.config.theme, use)
				local skin = package and package.chrome and package.chrome.field
				local carve: { top: number?, bottom: number? } = if skin
						and read(spec.appearance, use) ~= "utility"
						and skin.kind ~= "native"
						and skin.kind ~= "none"
					then skin.contentInsets or {}
					else {}
				local line = ctx.controlSize(spec.controlSize, "iconSize", use)
				return math.max(
					ctx.controlSize(spec.controlSize, "height", use),
					(carve.top or 0) + (carve.bottom or 0) + line
				)
			end
			runtime.decorate(plate, {
				AnchorPoint = V2.new(0, 0.5),
				Position = D2.fromScale(0, 0.5),
				Size = function(use: ComposeTypes.Use)
					return D2.new(1, 0, 0, plateHeight(use))
				end,
				AutomaticSize = E.AutomaticSize.None,
			})
			body = Host.Frame(plate.Name .. "+target")({
				BackgroundTransparency = 1,
				Size = function(use: ComposeTypes.Use)
					return D2.new(1, 0, 0, math.max(targetFloor(use), plateHeight(use)))
				end,
				plate :: ComposeTypes.Child,
			})
		end
		table.insert(parts, body)
		local words = ctx.styled(
			ctx.text({
				Name = "Validation",
				Text = line,
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
				TextWrapped = true,
				Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }) :: ComposeTypes.Child,
			}),
			"type-caption"
		)
		Compose.watch(function(use: ComposeTypes.Use)
			tagWhile(words, "facet-validation", failure(use) ~= "")
		end)
		local lineSize = ctx.observeStyled.TextSize(words)
		local mark = ctx.icon("status.error", {
			Name = "MessageMark",
			Visible = function(use: ComposeTypes.Use)
				return failure(use) ~= ""
			end,
			ScaleType = E.ScaleType.Fit,
			Size = function(use: ComposeTypes.Use)
				local size = ctx.metric("iconSizes.small", use)
				local line = use(lineSize)
				return D2.fromOffset(size, if line > 0 then line else size)
			end,
		})
		mark:AddTag("facet-icon-error")
		local message = ctx.row({ mark, words }, {
			Name = "Message",
			Size = D2.new(1, 0, 0, 0),
			AutomaticSize = E.AutomaticSize.Y,
			Visible = function(use: ComposeTypes.Use)
				return line(use) ~= ""
			end,
		})
		assert(message:FindFirstChildWhichIsA("UIListLayout")).Padding = D.new(0, 4)
		table.insert(parts, message)
		local native = options.native
		native.BackgroundTransparency = 1
		native.Size = native.Size or D2.new(1, 0, 0, 0)
		native.AutomaticSize = native.AutomaticSize or E.AutomaticSize.Y
		local root = ctx.column(parts, native)
		assert(root:FindFirstChildWhichIsA("UIListLayout")).Padding = D.new(0, 4)
		return root
	end
	return chrome
end
]]></ProtectedString>
