	ZIndex: typeof(frame.ZIndex),
	Style: typeof(frame.Style),
	ref: typeof(frame.ref),
	value: typeof(colorPicker.value),
	onChange: typeof(colorPicker.onChange),
	onCommit: typeof(colorPicker.onCommit),
	alpha: typeof(colorPicker.alpha),
	onAlphaChange: typeof(colorPicker.onAlphaChange),
	allowEmpty: typeof(colorPicker.allowEmpty),
	placeholder: typeof(colorPicker.placeholder),
	modes: typeof(colorPicker.modes),
	swatches: typeof(colorPicker.swatches),
	onSaveSwatch: typeof(colorPicker.onSaveSwatch),
	onRemoveSwatch: typeof(colorPicker.onRemoveSwatch),
	style: typeof(colorPicker.style),
	draft: typeof(colorPicker.draft),
	isPresented: typeof(colorPicker.isPresented),
	onPresentedChange: typeof(colorPicker.onPresentedChange),
	onDismiss: typeof(colorPicker.onDismiss),
	enabled: typeof(colorPicker.enabled),
	readOnly: typeof(colorPicker.readOnly),
	label: typeof(colorPicker.label),
	requiredMark: typeof(colorPicker.requiredMark),
	hint: typeof(colorPicker.hint),
	errorText: typeof(colorPicker.errorText),
	controlSize: typeof(colorPicker.controlSize),
	appearance: typeof(colorPicker.appearance),
	corners: typeof(colorPicker.corners),
	[number | Engine.EventKey]: Compose.Child,
}

return {}
]]></ProtectedString>
