			if stack then
				stack.users -= 1
				if stack.users == 0 then
					if stack.owner then
						stack.owner.dispose()
					end
					local lanes = stacks[stack.layer]
					if lanes then
						lanes[stack.lane] = nil
					end
				end
			end
		end)
		surfaces.attach(root, {
			Compose.show(ready, function()
				return surfaces.overlay(root, function(use: ComposeTypes.Use): boolean
