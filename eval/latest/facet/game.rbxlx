							<ProtectedString name="Source"><![CDATA[--!strict
local Compose = require("../vendor/compose/core")
local Engine = require("./engine_types")
local Effects = require("./effect_types")

local frame = (nil :: unknown) :: Engine.FrameProps
local flash = (nil :: unknown) :: Effects.FlashOptions

export type FlashProps = {
	Changed: typeof(frame.Changed),
	Attributes: typeof(frame.Attributes),
	AncestryChanged: typeof(frame.AncestryChanged),
	Archivable: typeof(frame.Archivable),
	AttributeChanged: typeof(frame.AttributeChanged),
	Capabilities: typeof(frame.Capabilities),
	ChildAdded: typeof(frame.ChildAdded),
	ChildRemoved: typeof(frame.ChildRemoved),
	DescendantAdded: typeof(frame.DescendantAdded),
	DescendantRemoving: typeof(frame.DescendantRemoving),
	Destroying: typeof(frame.Destroying),
	Name: typeof(frame.Name),
	Parent: typeof(frame.Parent),
	Sandboxed: typeof(frame.Sandboxed),
	StyledPropertiesChanged: typeof(frame.StyledPropertiesChanged),
	AutoLocalize: typeof(frame.AutoLocalize),
	RootLocalizationTable: typeof(frame.RootLocalizationTable),
	SelectionBehaviorDown: typeof(frame.SelectionBehaviorDown),
	SelectionBehaviorLeft: typeof(frame.SelectionBehaviorLeft),
	SelectionBehaviorRight: typeof(frame.SelectionBehaviorRight),
	SelectionBehaviorUp: typeof(frame.SelectionBehaviorUp),
	SelectionChanged: typeof(frame.SelectionChanged),
	SelectionGroup: typeof(frame.SelectionGroup),
	Active: typeof(frame.Active),
	AnchorPoint: typeof(frame.AnchorPoint),
	AutomaticSize: typeof(frame.AutomaticSize),
	BackgroundColor3: typeof(frame.BackgroundColor3),
	BackgroundTransparency: typeof(frame.BackgroundTransparency),
	BorderColor3: typeof(frame.BorderColor3),
	BorderMode: typeof(frame.BorderMode),
	BorderSizePixel: typeof(frame.BorderSizePixel),
	ClipsDescendants: typeof(frame.ClipsDescendants),
	InputBegan: typeof(frame.InputBegan),
	InputChanged: typeof(frame.InputChanged),
	InputEnded: typeof(frame.InputEnded),
	InputSink: typeof(frame.InputSink),
	Interactable: typeof(frame.Interactable),
	LayoutOrder: typeof(frame.LayoutOrder),
	MouseEnter: typeof(frame.MouseEnter),
	MouseLeave: typeof(frame.MouseLeave),
	MouseMoved: typeof(frame.MouseMoved),
	MouseWheelBackward: typeof(frame.MouseWheelBackward),
	MouseWheelForward: typeof(frame.MouseWheelForward),
	NextSelectionDown: typeof(frame.NextSelectionDown),
	NextSelectionLeft: typeof(frame.NextSelectionLeft),
	NextSelectionRight: typeof(frame.NextSelectionRight),
	NextSelectionUp: typeof(frame.NextSelectionUp),
	Position: typeof(frame.Position),
	Rotation: typeof(frame.Rotation),
	Selectable: typeof(frame.Selectable),
	SelectionGained: typeof(frame.SelectionGained),
	SelectionImageObject: typeof(frame.SelectionImageObject),
	SelectionLost: typeof(frame.SelectionLost),
	SelectionOrder: typeof(frame.SelectionOrder),
	Size: typeof(frame.Size),
	SizeConstraint: typeof(frame.SizeConstraint),
	TouchLongPress: typeof(frame.TouchLongPress),
	TouchPan: typeof(frame.TouchPan),
	TouchPinch: typeof(frame.TouchPinch),
	TouchRotate: typeof(frame.TouchRotate),
	TouchSwipe: typeof(frame.TouchSwipe),
	TouchTap: typeof(frame.TouchTap),
	Visible: typeof(frame.Visible),
	ZIndex: typeof(frame.ZIndex),
	Style: typeof(frame.Style),
	ref: typeof(frame.ref),
	target: typeof(flash.target),
	progress: typeof(flash.progress),
	color: typeof(flash.color),
	mode: typeof(flash.mode),
	[number | Engine.EventKey]: Compose.Child,
}

return {}
]]></ProtectedString>
