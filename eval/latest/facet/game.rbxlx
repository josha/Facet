								<string name="Value"><![CDATA[# Alert.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
actions: { AlertAction<P> } | ((P) -> { AlertAction<P> })? = omitted
content: ((P) -> Instance)? = omitted
error: Cell<string?>? = omitted
icon: ValueString? = omitted
isPresented: Cell<boolean>? = omitted
