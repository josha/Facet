							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Shared = require("./types")
local Civil = require("./civil_date_types")

export type CivilDate = Civil.CivilDate
export type Range = Civil.Range
export type Locale = Civil.Locale
export type Preset = { id: string, label: string, range: (today: CivilDate) -> Range }
export type DismissReason = "activate" | "outside" | "cancel" | "anchorLost" | "apply"
export type Selection = "single" | "range"
export type Style = "automatic" | "inline"
export type DateValue = Shared.Value<CivilDate?>
export type RangeValue = Shared.Value<Range>
export type FlagValue = Shared.ValueBoolean
export type WordsValue = Shared.ValueString
export type SizeValue = Shared.Value<Shared.ControlSize?>
export type DateCallback = (value: CivilDate?) -> ()
export type RangeCallback = (range: Range) -> ()
export type DateTimePickerOptions = {
	selection: Selection?,
	value: DateValue?,
	onChange: DateCallback?,
	onCommit: DateCallback?,
	range: RangeValue?,
	onRangeChange: RangeCallback?,
	onRangeCommit: RangeCallback?,
	time: boolean?,
	minuteStep: number?,
	hourCycle: number?,
	min: DateValue?,
	max: DateValue?,
	isDateDisabled: ((date: CivilDate) -> boolean)?,
	weekStart: number?,
	locale: Locale?,
	clock: (() -> CivilDate)?,
	referenceDate: DateValue?,
	presets: { Preset }?,
	draft: boolean?,
	style: Style?,
	format: ((value: CivilDate) -> string)?,
	placeholder: string?,
	isPresented: FlagValue?,
	onPresentedChange: ((next: boolean) -> ())?,
	onDismiss: ((reason: DismissReason) -> ())?,
	enabled: FlagValue?,
	readOnly: FlagValue?,
	label: WordsValue?,
	requiredMark: ("required" | "optional")?,
	hint: WordsValue?,
	errorText: WordsValue?,
	controlSize: SizeValue?,
	appearance: WordsValue?,
	corners: ("pill" | "square")?,
}

return {}
]]></ProtectedString>
							<string name="ScriptGuid">{84C36823-1509-44C6-BDFC-3918FFCC2051}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">date_time_picker_types</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc3890000042a</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="78">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local civil = require("./civil_date")
local Shared = require("./types")
local DTP = require("./date_time_picker_types")
local InputProps = require("./input_props")
local ComposeTypes = require("../vendor/compose/core")
local Parts = require("./date_time_parts")
local Options = require("./date_time_options")

type CivilDate = DTP.CivilDate
type Range = DTP.Range
type Spec = InputProps.DateTimePickerProps
type Use = ComposeTypes.Use
type Readable<T> = ComposeTypes.Readable<T>
type Cell<T> = ComposeTypes.Cell<T>
type Formula<T> = ComposeTypes.Formula<T>
type Held = { v: CivilDate? | Range }
export type State = {
	diagnostics: Cell<{ string }>,
	value: Readable<CivilDate?>,
	range: Readable<Range>,
	minDate: Readable<CivilDate?>,
	maxDate: Readable<CivilDate?>,
	enabled: (Use?) -> boolean,
	interactive: (Use?) -> boolean,
	today: Cell<CivilDate>,
	mayEdit: () -> boolean,
	isDisabled: (CivilDate, Use?) -> boolean,
	anchorDate: () -> CivilDate,
	viewMonth: Cell<CivilDate>,
	peekMonth: () -> CivilDate,
	paneMonth: (number, Use?) -> CivilDate,
	paneGrid: (number, Use?) -> { CivilDate },
	room: Cell<number>,
	dual: Formula<boolean>,
	panes: (Use?) -> number,
	monthClosed: (CivilDate, Use?) -> boolean,
	canPage: (number, Use?) -> boolean,
	page: (number) -> boolean,
	takeSnapshot: () -> (),
	propose: (CivilDate? | Range) -> boolean,
	commit: () -> (),
	restore: () -> (),
	presented: Formula<boolean>,
	requestPresented: (boolean) -> (),
	close: (DTP.DismissReason) -> (),
	choose: (CivilDate) -> (),
	typedError: Cell<string>,
	valueText: Formula<string>,
	longName: (CivilDate) -> string,
	preferred: Cell<Enum.PreferredInput> | Cell<unknown>,
	prefers: (Enum.PreferredInput, Use) -> boolean,
	typedEntry: Formula<boolean>,
	selected: Readable<GuiObject?>,
}

local CELL, GAP = Parts.CELL, Parts.GAP
local span, monthOf, sameRange = Parts.span, Parts.monthOf, Parts.sameRange

return function(ctx: Shared.Context, parts: Parts.Parts, spec: Spec, options: Options.Options): State
	local Compose, read = ctx.Compose, ctx.read
	local E = ctx.types.Enum
	local gui, input = parts.gui, parts.input
	local isRange, withTime, draft, overlay = options.isRange, options.withTime, options.draft, options.overlay
	local months, clock = options.months, options.clock

	local diagnostics = Compose.cell({} :: { string })
	local function note(message: string)
		local list = table.clone(diagnostics:peek())
		table.insert(list, message)
		diagnostics:set(list)
		if ctx.config.onError then
			ctx.config.onError(message)
		end
	end
	local function legal<T>(key: string, source: Shared.Value<T>?, ok: (unknown) -> boolean): Readable<T>
		local held: Cell<T> = Compose.cell(read(source))
		local refused = false
		Compose.watch(function(use: Use)
			local v: T = read(source, use)
			if ok(v) then
				refused = false
				held:set(v)
			elseif not refused then
				refused = true
				note(`Facet UI.DateTimePicker: {key} is not a legal value; the picker keeps the last one.`)
			end
		end)
		return held
	end
	local function optionalDate(v: unknown): boolean
		return v == nil or civil.problem(v) == nil
	end
	local value = legal("value", spec.value, function(v: unknown): boolean
		return v == nil or civil.problem(v, withTime) == nil
	end)
	local range = legal("range", if isRange then spec.range else {}, function(v: unknown): boolean
		if type(v) ~= "table" then
			return false
		end
		local r = v :: Range
		return optionalDate(r.start)
			and optionalDate(r.finish)
			and not (r.start ~= nil and r.finish ~= nil and civil.compare(r.start, r.finish) > 0)
	end)
	local minDate = legal("min", spec.min, optionalDate)
	local maxDate = legal("max", spec.max, optionalDate)
	local referenceDate = legal("referenceDate", spec.referenceDate, optionalDate)
	local function enabled(use: Use?): boolean
		return read(spec.enabled, use) ~= false
	end
	local function interactive(use: Use?): boolean
		return enabled(use) and read(spec.readOnly, use) ~= true and options.hasProposer
	end
	local today = Compose.cell(civil.dateOf(clock()))
	local disposed = false
	Compose.cleanup(function()
		disposed = true
	end)
	local function mayEdit(): boolean
		return not disposed and interactive()
	end
	local function isDisabled(d: CivilDate, use: Use?): boolean
		local lo = if use then use(minDate) else minDate:peek()
		local hi = if use then use(maxDate) else maxDate:peek()
		if not civil.within(d, lo, hi) then
			return true
		end
		local rule = spec.isDateDisabled
		return rule ~= nil and rule(civil.dateOf(d)) == true
	end
	local function anchorDate(): CivilDate
		local held = if isRange then range:peek().start else value:peek()
		return held or referenceDate:peek() or today:peek()
	end
	local viewMonth = Compose.cell(monthOf(anchorDate()))
	local function peekMonth(): CivilDate
		return viewMonth:peek()
	end
	local function paneMonth(k: number, use: Use?): CivilDate
		local m = if use then use(viewMonth) else viewMonth:peek()
		return civil.addMonths(m, k - 1)
	end
	local monthGrids: { Readable<{ CivilDate }> } = {}
	for k = 1, if isRange then 2 else 1 do
		monthGrids[k] = Compose.formula(function(use: Use): { CivilDate }
			local m = paneMonth(k, use)
			return civil.monthGrid(m.year, m.month, options.weekStart)
		end)
	end
	local function paneGrid(k: number, use: Use?): { CivilDate }
		local grid = monthGrids[k]
		return if use then use(grid) else grid:peek()
	end
	local room = Compose.cell(0)
	local dual = Compose.formula(function(use: Use): boolean
		return isRange and use(room) >= 2 * 7 * CELL + GAP
	end)
	local function panes(use: Use?): number
		return if if use then use(dual) else dual:peek() then 2 else 1
	end
	local function monthClosed(m: CivilDate, use: Use?): boolean
		local lo = if use then use(minDate) else minDate:peek()
		local hi = if use then use(maxDate) else maxDate:peek()
		local last: CivilDate = { year = m.year, month = m.month, day = civil.daysIn(m.year, m.month) }
		return (lo ~= nil and civil.compare(last, lo) < 0) or (hi ~= nil and civil.compare(monthOf(m), hi) > 0)
	end
	local function canPage(delta: number, use: Use?): boolean
		local shown = paneMonth(1 + (if delta > 0 then delta + panes(use) - 1 else delta), use)
		return not monthClosed(shown, use)
	end
	local function page(delta: number): boolean
		if not canPage(delta) then
			return false
		end
		viewMonth:set(civil.addMonths(peekMonth(), delta))
		return true
	end

	local proposing = false
	local snapshot: Held = { v = nil }
	local function current(): CivilDate? | Range
		return if isRange then range:peek() else value:peek()
	end
	local function same(a: CivilDate? | Range, b: CivilDate? | Range): boolean
		if isRange then
			return sameRange(a :: Range, b :: Range)
		end
		return civil.same(a :: CivilDate?, b :: CivilDate?)
	end
	local function takeSnapshot()
		snapshot = { v = current() }
	end
	takeSnapshot()
	Compose.watch(function(use: Use)
		if isRange then
			use(range)
		else
			use(value)
		end
		if not proposing then
			takeSnapshot()
		end
	end)
	local function send(next: CivilDate? | Range)
		proposing = true
		local ok, err = pcall(function()
			if isRange then
				assert(options.proposeRange)(next :: Range)
			else
				assert(options.proposeSingle)(next :: CivilDate?)
			end
		end)
		proposing = false
		if not ok then
			error(err, 0)
		end
	end
	local function propose(next: CivilDate? | Range): boolean
		if not mayEdit() then
			return false
		end
		send(next)
		return same(current(), next)
	end
	local function commit()
		if disposed then
			return
		end
		if isRange then
			local r = range:peek()
			if spec.onRangeCommit ~= nil and r.start ~= nil and r.finish ~= nil then
				spec.onRangeCommit(r)
			end
		elseif spec.onCommit ~= nil then
			spec.onCommit(value:peek())
		end
	end
	local function restore()
		if disposed or not mayEdit() then
			return
		end
		if not same(current(), snapshot.v) then
			send(snapshot.v)
		end
	end

	local openCell = Compose.cell(false)
	local presented = Compose.formula(function(use: Use): boolean
		if not overlay then
			return true
		end
		if spec.isPresented ~= nil then
			return read(spec.isPresented, use) == true
		end
		return use(openCell)
	end)
	local closeWhy: DTP.DismissReason? = nil
	local function requestPresented(next: boolean)
		if next and (disposed or not interactive()) then
			return
		end
		if spec.onPresentedChange ~= nil then
			spec.onPresentedChange(next)
		elseif spec.isPresented == nil then
			openCell:set(next)
		else
			local bound = (spec.isPresented :: unknown) :: { set: unknown }
			if type(bound) == "table" and type(bound.set) == "function" then
				(spec.isPresented :: Cell<boolean>):set(next)
			end
		end
	end
	local function close(why: DTP.DismissReason)
		if not overlay or not presented:peek() then
			return
		end
		if draft and why ~= "apply" then
			restore()
		end
		closeWhy = why
		requestPresented(false)
	end
	local wasPresented = presented:peek()
	Compose.watch(function(use: Use)
		local on = use(presented)
		if on and not wasPresented then
			takeSnapshot()
			today:set(civil.dateOf(clock()))
			viewMonth:set(monthOf(anchorDate()))
		elseif not on and wasPresented and overlay then
			local why: DTP.DismissReason = closeWhy or "cancel"
			closeWhy = nil
			if spec.onDismiss then
				spec.onDismiss(why)
			end
		end
		wasPresented = on
	end)

	local function choose(d: CivilDate)
		if not mayEdit() or isDisabled(d) then
			return
		end
		local day = civil.dateOf(d)
		if not isRange then
			local held = value:peek()
			if withTime then
				day.hour = if held ~= nil and held.hour ~= nil then held.hour else 0
				day.minute = if held ~= nil and held.minute ~= nil then held.minute else 0
			end
			if not propose(day) then
				return
			end
			local shown = peekMonth()
			if day.month ~= shown.month or day.year ~= shown.year then
				if not (civil.same(monthOf(day), civil.addMonths(shown, 1)) and dual:peek()) then
					viewMonth:set(monthOf(day))
				end
			end
			if not draft then
				commit()
				if not withTime then
					close("activate")
				end
			end
			return
		end
		local r = range:peek()
		local next: Range
		if r.start == nil or r.finish ~= nil then
			next = span(day, nil)
		elseif civil.compare(day, r.start) < 0 then
			next = span(day, r.start)
		else
			next = span(r.start, day)
		end
		if propose(next) and next.finish ~= nil and not draft then
			commit()
			close("activate")
		end
	end

	local typedError = Compose.cell("")
	local function words(v: CivilDate?): string
		if v == nil then
			return ""
		end
		return if spec.format ~= nil then spec.format(v) else civil.format(v, options.locale)
	end
	local valueText = Compose.formula(function(use: Use): string
		if isRange then
			local r = use(range)
			if r.start == nil then
				return ""
			end
			return `{words(r.start)} – {if r.finish ~= nil then words(r.finish) else "…"}`
		end
		return words(use(value))
	end)
	local function longName(d: CivilDate): string
		return `{months[d.month]} {d.day}, {d.year}`
	end
	local preferred = if input and input.GetPropertyChangedSignal
		then ctx.observe.PreferredInput(input)
		else Compose.cell(nil :: unknown)
	local function prefers(kind: Enum.PreferredInput, use: Use): boolean
		return use(preferred) == kind
	end
	local typedEntry = Compose.formula(function(use: Use): boolean
		if spec.format ~= nil then
			return false
		end
		local kind = use(preferred)
		return kind == nil or kind == E.PreferredInput.KeyboardAndMouse
	end)
	local selected: Readable<GuiObject?> = if gui and gui.GetPropertyChangedSignal
		then ctx.observe.SelectedObject(gui)
		else Compose.cell(nil :: GuiObject?)

	return {
		diagnostics = diagnostics,
		value = value,
		range = range,
		minDate = minDate,
		maxDate = maxDate,
		enabled = enabled,
		interactive = interactive,
		today = today,
		mayEdit = mayEdit,
		isDisabled = isDisabled,
		anchorDate = anchorDate,
		viewMonth = viewMonth,
		peekMonth = peekMonth,
		paneMonth = paneMonth,
		paneGrid = paneGrid,
		room = room,
		dual = dual,
		panes = panes,
		monthClosed = monthClosed,
		canPage = canPage,
		page = page,
		takeSnapshot = takeSnapshot,
		propose = propose,
		commit = commit,
		restore = restore,
		presented = presented,
		requestPresented = requestPresented,
		close = close,
		choose = choose,
		typedError = typedError,
		valueText = valueText,
		longName = longName,
		preferred = preferred,
		prefers = prefers,
		typedEntry = typedEntry,
		selected = selected,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{DBE7547C-4858-4076-BDBD-6B37DA538F26}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">date_time_state</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc3890000042b</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="79">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local civil = require("./civil_date")
local Shared = require("./types")
local DTP = require("./date_time_picker_types")
local CollectionProps = require("./collection_props")
local NavigationProps = require("./navigation_props")
local ComposeTypes = require("../vendor/compose/core")
local Parts = require("./date_time_parts")
local Options = require("./date_time_options")
local PickerState = require("./date_time_state")
local Calendar = require("./date_time_calendar")

type CivilDate = DTP.CivilDate
type Use = ComposeTypes.Use
type Readable<T> = ComposeTypes.Readable<T>
type TimeRow = { id: string, hour: number, minute: number }

local ROW = Parts.ROW

return function(
	ctx: Shared.Context,
	UI: Parts.Deps,
	options: Options.Options,
	state: PickerState.State,
	calendar: Calendar.Calendar
): () -> Frame
	local Host, Compose = ctx.Host, ctx.Compose
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local draft, minuteStep, hourCycle, clock = options.draft, options.minuteStep, options.hourCycle, options.clock
	local value, anchorDate = state.value, state.anchorDate
	local interactive, propose, commit = state.interactive, state.propose, state.commit
	local downTarget = calendar.downTarget

	local function timeSection(): Frame
		local function base(): CivilDate
			local v = value:peek()
			if v ~= nil and v.hour ~= nil then
				return v
			end
			local d = civil.dateOf(v or anchorDate())
			d.hour, d.minute = 0, 0
			return d
		end
		local function field(
			name: string,
			lo: number,
			hi: number,
			step: number,
			get: (CivilDate) -> number,
			with: (CivilDate, number) -> CivilDate
		): TextBox | Frame
			local text = Compose.cell("")
			local number = Compose.cell(lo)
			Compose.watch(function(use: Use)
				local v = use(value)
				local n = if v ~= nil and v.hour ~= nil then get(v) else lo
				number:set(n)
				text:set(if v ~= nil then string.format("%02d", n) else "")
			end)
			return UI.NumberInput(name)({
				label = name,
				Size = D2.new(0, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
				Host.UIFlexItem({ FlexMode = E.UIFlexMode.Fill }) :: Shared.Child,
				value = text,
				numericValue = number,
				min = lo,
				max = hi,
				step = step,
				precision = 0,
				stepButtons = true,
				enabled = function(use: Use)
					return interactive(use)
				end,
				format = function(n: number): string
					return string.format("%02d", n)
				end,
				onCommit = function(n: number)
					local v = value:peek()
					if not propose(with(base(), n)) then
						local held = if v ~= nil and v.hour ~= nil then get(v) else lo
						number:set(held)
						text:set(if v ~= nil then string.format("%02d", held) else "")
					elseif not draft then
						commit()
					end
				end,
			})
		end
		local function withHour(d: CivilDate, h: number): CivilDate
			local out = table.clone(d)
			local pm = (d.hour or 0) >= 12
			out.hour = if hourCycle == 12 then (h % 12) + (if pm then 12 else 0) else h
			return out
		end
		local function withMinute(d: CivilDate, m: number): CivilDate
			local out = table.clone(d)
			out.minute = m
			return out
		end
		local hour = field("Hour", if hourCycle == 12 then 1 else 0, if hourCycle == 12 then 12 else 23, 1, function(v)
			local h = v.hour or 0
			return if hourCycle == 12 then (if h % 12 == 0 then 12 else h % 12) else h
		end, withHour)
		local minute = field("Minute", 0, 60 - minuteStep, minuteStep, function(v)
			return v.minute or 0
		end, withMinute)
		downTarget:set(hour:FindFirstChild("Field", true) :: GuiObject?)
		local parts: { Shared.Child } = {}
		if hourCycle == 12 then
			local half = Compose.cell("AM")
			Compose.watch(function(use: Use)
				local v = use(value)
				half:set(if v ~= nil and v.hour ~= nil and v.hour >= 12 then "PM" else "AM")
			end)
			local halfSpec: NavigationProps.SinglePickerSpec<string> = {
				Name = "Half",
				options = { { value = "AM", label = "AM" }, { value = "PM", label = "PM" } },
				selected = half,
				style = "segmented" :: "segmented",
				sizing = "hug" :: "hug",
				Size = D2.fromOffset(0, 0),
				AutomaticSize = E.AutomaticSize.XY,
				enabled = function(use: Use)
					return interactive(use)
				end,
				onChanging = function(word: string): boolean?
					local v = value:peek()
					if v == nil or v.hour == nil then
						return false
					end
					local next = table.clone(v)
					next.hour = (v.hour :: number) % 12 + (if word == "PM" then 12 else 0)
					if not propose(next) then
						return false
					end
					if not draft then
						commit()
					end
					return true
				end,
			}
			table.insert(parts, UI.Picker(halfSpec))
		end
		local fields = ctx.row(
			{ hour, minute },
			{ Name = "Fields", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y }
		)
		assert(fields:FindFirstChildWhichIsA("UIListLayout")).VerticalAlignment = E.VerticalAlignment.Bottom
		local times: { TimeRow } = {}
		for minutes = 0, 24 * 60 - 1, minuteStep do
			table.insert(times, { id = `{minutes // 60}:{minutes % 60}`, hour = minutes // 60, minute = minutes % 60 })
		end
		local list = Compose.show(function(use: Use)
			return state.prefers(E.PreferredInput.Touch, use)
		end, function()
			local at: CivilDate = value:peek() or clock()
			if at.hour == nil then
				at = clock()
			end
			local first = if at.hour ~= nil then (at.hour * 60 + (at.minute or 0)) // minuteStep else 0
			local timesSpec: CollectionProps.KeyedCollectionSpec<TimeRow, string> = {
				Name = "Times",
				LayoutOrder = 2,
				from = times,
				key = "id",
				itemSize = ROW,
				Size = D2.new(1, 0, 0, 4 * ROW),
				CanvasPosition = V2.new(0, first * ROW),
				render = function(row: Readable<TimeRow>): GuiObject
					local t = row:peek()
					return UI.Button({
						Name = "Time",
						label = civil.formatTime(
							{ year = 2000, month = 1, day = 1, hour = t.hour, minute = t.minute },
							hourCycle
						),
						Size = D2.new(1, 0, 0, ROW),
						AutomaticSize = E.AutomaticSize.None,
						enabled = function(use: Use)
							return interactive(use)
						end,
						selected = function(use: Use)
							local v = use(value)
							return v ~= nil and v.hour == t.hour and v.minute == t.minute
						end,
						onActivate = function()
							local next = civil.dateOf(value:peek() or anchorDate())
							next.hour, next.minute = t.hour, t.minute
							if propose(next) and not draft then
								commit()
							end
						end,
					})
				end,
			}
			return UI.VirtualList(timesSpec)
		end)
		table.insert(parts, 1, fields)
		table.insert(parts, list)
		return ctx.column(parts, { Name = "Time", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
	end

	return timeSection
end
]]></ProtectedString>
							<string name="ScriptGuid">{361B2EB8-A17A-4341-B758-BA4110F451F8}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">date_time_time</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc3890000042c</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="80">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Geometry = {}
function Geometry.fit(bounds: Vector2, canvas: Vector2): Vector2
	assert(bounds.X > 0 and bounds.Y > 0 and canvas.X > 0 and canvas.Y > 0)
	local width = math.min(bounds.X, bounds.Y * canvas.X / canvas.Y)
	return canvas * (width / canvas.X)
end
function Geometry.match(surface: CFrame, extent: Vector2, fieldOfView: number, frames: typeof(CFrame)): CFrame
	assert(fieldOfView > 0 and fieldOfView < 180)
	local distance = extent.Y / (2 * math.tan(math.rad(fieldOfView / 2)))
	return surface * frames.new(0, 0, -distance) * frames.Angles(0, math.pi, 0)
end
return Geometry
]]></ProtectedString>
							<string name="ScriptGuid">{15940286-7DB9-4525-B1BD-D8F2A9F39A4A}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">diegetic_geometry</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc3890000042d</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="81">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Types = require("./types")
local Core = require("../vendor/compose/core")
local Controls = require("./control_types")
local Props = require("./diegetic_types")
local Geometry = require("./diegetic_geometry")
local Motion = require("./motion")
type Layer = { source: ScreenGui, slot: Frame, children: { Instance } }
return function(ctx: Types.Context, UI: Controls.Controls)
	local Compose, Host, runtime = ctx.Compose, ctx.Host, ctx.runtime
	local D2, V2, V3, E = ctx.types.UDim2, ctx.types.Vector2, ctx.types.Vector3, ctx.types.Enum
	UI.DiegeticScreen = ctx.construct("DiegeticScreen", function(spec: Props.DiegeticScreenProps): Folder
		assert(#spec.layers > 0, "DiegeticScreen.layers must contain the application ScreenGui")
		local workspace = assert(ctx.config.services.Workspace, "DiegeticScreen requires Workspace")
		local gui = assert(ctx.config.services.GuiService, "DiegeticScreen requires GuiService")
		local reduce = Motion.reduced(ctx)
		local live, attached = Compose.cell(false), Compose.cell(false)
		local goal = Compose.cell(0)
		local schedule = runtime.scheduler()
		local spring = ctx.motionSpring(spec.motion or "move")
		local progress = runtime.spring(function(use: Types.Use): number
			return use(goal)
		end, { period = spring.period, damping = spring.damping, reducedMotion = reduce })
		local camera = Compose.cell<<Camera?>>(nil)
		local surface = Compose.cell<<SurfaceGui?>>(nil)
		local ready = Compose.cell<<Types.Readable<boolean>?>>(nil)
		local moved, ownsCamera = false, false
		local previous: Camera? = nil
		local parked: { Camera } = {}
		local cameraStorage: Folder? = nil
		local layerOwner: Core.Owner? = nil
		local layers: { Layer } = {}
		local known: { [ScreenGui]: Layer } = {}
		local canvas = V2.new(1, 1)
		local full = ctx.types.Rect.new(0, 0, 1, 1)
		local root: Folder
		local fieldOfView = spec.fieldOfView or 48
		assert(fieldOfView > 0 and fieldOfView < 180, "DiegeticScreen.fieldOfView must be between zero and 180")
		local function ownedLayer(candidate: Instance): boolean
			if not candidate:IsA("ScreenGui") then
				return false
			end
			if table.find(spec.layers, candidate) then
				return true
			end
			local source = ctx.overlayHosts[candidate]
			return source and source:IsA("ScreenGui") and table.find(spec.layers, source) ~= nil or false
		end
		local function restore()
			if not moved then
				return
			end
			moved = false
			local screen = surface:peek()
			if screen then
				screen.Enabled = false
			end
			for _, layer in layers do
				for _, child in layer.children do
					if child.Parent == layer.slot then
						child.Parent = layer.source
					end
				end
			end
		end
		local function restoreCameras()
			ownsCamera = false
			if previous and workspace.CurrentCamera == camera:peek() then
				workspace.CurrentCamera = previous
			end
			for _, parkedCamera in parked do
				if parkedCamera.Parent == cameraStorage then
					parkedCamera.Parent = workspace
				end
			end
			table.clear(parked)
		end
		local function release()
			schedule.cancel("readiness")
			schedule.cancel("departure")
			restore()
			restoreCameras()
			previous = nil
			attached:set(false)
			live:set(false)
			table.clear(layers)
			table.clear(known)
		end
		local function refuse(reason: string)
			release()
			spec.isPresented:set(false)
			if spec.onUnavailable then
				spec.onUnavailable(reason)
			end
		end
		local function addLayer(source: ScreenGui)
			if known[source] then
				return
			end
			local screen = assert(surface:peek())
			Compose.withOwner(assert(layerOwner), function()
				local area = gui:GetInsetArea(source.ScreenInsets)
				local slot = Host.Frame "LogicalCanvas" {
					Parent = Compose.static(screen),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Position = D2.fromOffset(area.Min.X - full.Min.X, area.Min.Y - full.Min.Y),
					Size = D2.fromOffset(area.Width, area.Height),
					Visible = ctx.observe.Enabled(source),
				}
				local layer: Layer = { source = source, slot = slot, children = {} }
				known[source] = layer
				table.insert(layers, layer)
				local function transfer(child: Instance)
					if moved and child.Parent == source then
						if not table.find(layer.children, child) then
							table.insert(layer.children, child)
						end
						child.Parent = slot
					end
				end
				local transfers = runtime.scheduler()
				runtime.connect(source, "ChildAdded", function(child: Instance)
					transfers.replace(child, 0, function()
						transfer(child)
					end)
				end)
				if moved then
					for _, child in source:GetChildren() do
						transfer(child)
					end
				end
			end)
			local ordered = table.clone(layers)
			table.sort(ordered, function(a: Layer, b: Layer): boolean
				if a.source.DisplayOrder ~= b.source.DisplayOrder then
					return a.source.DisplayOrder < b.source.DisplayOrder
				end
				return assert(table.find(layers, a)) < assert(table.find(layers, b))
			end)
			for index, layer in ordered do
				layer.slot.ZIndex = index
			end
		end
		local function transfer()
			schedule.cancel("readiness")
			moved = true
			for _, layer in layers do
				for _, child in layer.source:GetChildren() do
					table.insert(layer.children, child)
					child.Parent = layer.slot
				end
			end
			assert(surface:peek()).Enabled = true
			attached:set(true)
			schedule.replace("departure", 0, function()
				if attached:peek() and spec.isPresented:peek() then
					goal:set(1)
				end
			end)
		end
		local function SceneNodes(): { Core.Node }
			layerOwner = assert(Compose.currentOwner())
			local scene = spec.scene()
			local extent = Geometry.fit(ctx.read(spec.bounds), canvas)
			local plate = Host.Part "Display" {
				Anchored = true,
				CanCollide = false,
				CanTouch = false,
				CanQuery = true,
				Transparency = 1,
				Size = V3.new(extent.X, extent.Y, 0.01),
				CFrame = function(use: Types.Use): CFrame
					local pose: CFrame = ctx.read(spec.surface, use)
					return pose * ctx.types.CFrame.new(0, 0, 0.005)
				end,
			}
			local worldCamera = Host.Camera "DiegeticCamera" {
				CameraType = E.CameraType.Scriptable,
				FieldOfViewMode = E.FieldOfViewMode.Vertical,
				FieldOfView = fieldOfView,
				CFrame = function(use: Types.Use): CFrame
					local p = if reduce(use) then use(goal) else math.clamp(use(progress), 0, 1)
					local matched = Geometry.match(ctx.read(spec.surface, use), extent, fieldOfView, ctx.types.CFrame)
					return matched:Lerp(ctx.read(spec.camera, use), p)
				end,
			}
			local storage = Host.Folder "Cameras" { worldCamera }
			cameraStorage = storage
			local screen = Host.SurfaceGui "DiegeticCanvas" {
				Parent = Compose.static(root),
				Adornee = Compose.static(plate),
				Face = E.NormalId.Front,
				SizingMode = E.SurfaceGuiSizingMode.FixedSize,
				CanvasSize = canvas,
				LightInfluence = 0,
				Enabled = false,
				ZIndexBehavior = E.ZIndexBehavior.Sibling,
				UI.Button "ReturnToScreen" {
					label = "",
					name = "Return to screen",
					Size = D2.fromScale(1, 1),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					ZIndex = 1000,
					onActivate = function()
						spec.isPresented:set(false)
					end,
				},
			}
			ctx.overlayHosts[screen] = spec.layers[1]
			surface:set(screen)
			camera:set(worldCamera)
			local settled = runtime.settled {
				ready = function(): boolean
					return workspace.CurrentCamera == worldCamera
						and worldCamera.ViewportSize.X > 1
						and worldCamera.ViewportSize.Y > 1
				end,
				sample = function(): string
					return tostring(worldCamera.ViewportSize)
				end,
			}
			local viewport = runtime.observe(worldCamera, "ViewportSize")
			local dimensions: Vector2? = nil
			Compose.watch(function(use: Types.Use)
				use(viewport)
				local current = worldCamera.ViewportSize
				if not attached:peek() then
					dimensions = current
				elseif dimensions and current ~= dimensions then
					refuse("The viewport changed; enter the room again")
				end
			end)
			ready:set(settled)
			Compose.cleanup(function()
				ctx.overlayHosts[screen] = nil
				restoreCameras()
				ready:set(nil)
				surface:set(nil)
				camera:set(nil)
				layerOwner = nil
				cameraStorage = nil
			end)
			return { scene, storage, plate }
		end
		local function Scene(): Folder
			return Host.Folder "OwnedWorld" { Compose.portal(workspace, SceneNodes) }
		end
		root = Host.Folder "DiegeticScreen" { Compose.show(live, Scene) }
		Compose.watch(function(use: Types.Use)
			if not use(spec.isPresented) then
				goal:set(0)
				if live:peek() and not attached:peek() then
					release()
				end
				return
			end
			if live:peek() then
				if attached:peek() then
					goal:set(1)
				end
				return
			end
			local input = ctx.config.services.UserInputService
			if input and input.VREnabled then
				refuse("The spatial transition is not available in VR yet")
				return
			end
			previous = workspace.CurrentCamera
			if not previous then
				refuse("The current camera is unavailable")
				return
			end
			full = gui:GetInsetArea(E.ScreenInsets.None)
			canvas = V2.new(full.Width, full.Height)
			if canvas.X <= 1 or canvas.Y <= 1 then
				refuse("The viewport is not ready")
				return
			end
			live:set(true)
			schedule.replace("readiness", ctx.metric("motion.restLimit"), function()
				if live:peek() and not attached:peek() then
					refuse("The spatial viewport did not become ready")
				end
			end)
		end)
		Compose.watch(function(use: Types.Use)
			local worldCamera = use(camera)
			local settled = use(ready)
			if not use(live) or not worldCamera or not settled or attached:peek() then
				return
			end
			if not ownsCamera then
				local storage = assert(cameraStorage)
				for _, child in workspace:GetChildren() do
					if child:IsA("Camera") then
						table.insert(parked, child)
						child.Parent = storage
					end
				end
				ownsCamera = true
			end
			workspace.CurrentCamera = worldCamera
			if not use(settled) then
				return
			end
			for _, layer in spec.layers do
				addLayer(layer)
			end
			local related: { ScreenGui } = {}
			for candidate in ctx.overlayHosts do
				if ownedLayer(candidate) and candidate:IsA("ScreenGui") then
					table.insert(related, candidate)
				end
			end
			for _, layer in related do
				addLayer(layer)
			end
			local parents: { [Instance]: boolean } = {}
			for _, layer in spec.layers do
				local parent = layer.Parent
				if parent and not parents[parent] then
					parents[parent] = true
					Compose.withOwner(assert(layerOwner), function()
						runtime.connect(parent, "ChildAdded", function(candidate: Instance)
							if candidate:IsA("ScreenGui") then
								schedule.after(0, function()
									if moved and ownedLayer(candidate) then
										addLayer(candidate)
									end
								end)
							end
						end)
					end)
				end
			end
			transfer()
		end)
		Compose.watch(function(use: Types.Use)
			local p = if reduce(use) then use(goal) else use(progress)
			root:SetAttribute("FacetDiegeticProgress", p)
			if not use(spec.isPresented) and use(attached) and p == 0 then
				release()
			end
		end)
		local currentCamera = runtime.observe(workspace, "CurrentCamera")
		Compose.watch(function(use: Types.Use)
			local current = use(currentCamera)
			if ownsCamera and current ~= camera:peek() then
				refuse("The camera owner changed")
			end
		end)
		Compose.cleanup(release)
		return root
	end)
end
]]></ProtectedString>
