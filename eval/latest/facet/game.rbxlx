						<Item class="StringValue" referent="882">
							<Properties>
								<string name="Value"><![CDATA[# VStack.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
align: Value<("start" | "center" | "end" | "stretch")>? = native
distribute: Value<("start" | "center" | "end" | "spaceBetween" | "spaceAround" | "spaceEvenly")>? = native
gap: Value<(number | ("xs" | "s" | "m" | "l" | "xl") | string)>? = 0
height: Value<(number | "fill" | "hug")>? = "hug"
maxWidth: ValueNumber? = nil
padding: Value<((number | ("xs" | "s" | "m" | "l" | "xl") | string) | Sides)>? = 0
ref: ((Frame) -> ())? = omitted
status: Value<("neutral" | "info" | "success" | "warning" | "error" | "accent" | "voice" | "contrast")?>? = omitted
surface: ("surface" | "panel" | "pane")? = omitted
width: Value<(number | "fill" | "hug")>? = "hug"
wrap: ValueBoolean? = false
Sides = { top: (number | SpaceStep | string)?, right: (number | SpaceStep | string)?, bottom: (number | SpaceStep | string)?, left: (number | SpaceStep | string)?, [string]: nil }]]></string>
