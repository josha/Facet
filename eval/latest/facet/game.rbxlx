					<Item class="ModuleScript" referent="114">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Shared = require("./types")
local ComposeTypes = require("../vendor/compose/core")

export type Parts = {
	key: Shared.Value<Enum.KeyCode?>,
	name: Shared.Value<string?>?,
	primary: Shared.Value<Enum.KeyCode?>?,
	secondary: Shared.Value<Enum.KeyCode?>?,
	image: Shared.Value<Content?>?,
}
export type Glyph = (name: string, controlSize: Shared.Value<Shared.ControlSize?>?, parts: Parts) -> Frame

local KEY_NAMES: { [string]: string } = {
	Return = "Enter",
	KeypadEnter = "Enter",
	Escape = "Esc",
	Space = "Space",
	Backspace = "Delete",
	Tab = "Tab",
	LeftShift = "Shift",
	RightShift = "Shift",
	LeftControl = "Ctrl",
	RightControl = "Ctrl",
	LeftAlt = "Alt",
	RightAlt = "Alt",
}

return function(ctx: Shared.Context, noKey: Enum.KeyCode): Glyph
	local Host, Compose, read = ctx.Host, ctx.Compose, ctx.read
	local D2, E = ctx.types.UDim2, ctx.types.Enum
	return function(frameName: string, controlSize: Shared.Value<Shared.ControlSize?>?, parts: Parts): Frame
		local input = ctx.config.services.UserInputService
		local nativeImage = Compose.formula(function(use: ComposeTypes.Use): Content | string | nil
			local content = read(parts.image, use)
			if content and content.SourceType and content.SourceType.Name ~= "None" then
				return content
			end
			local code: Enum.KeyCode? = read(parts.key, use)
			if code and input and input.GetImageForKeyCode then
				local ok, asset = pcall(input.GetImageForKeyCode, input, code)
				if ok and type(asset) == "string" and asset ~= "" then
					return asset
				end
			end
			return nil
		end)
		return Host.Frame(frameName) {
			Size = D2.fromOffset(0, 0),
			AutomaticSize = E.AutomaticSize.XY,
			BackgroundTransparency = 1,
			Compose.keyed({
				from = function(use: ComposeTypes.Use)
					local asset = use(nativeImage)
					return {
						if asset == nil then "text" elseif type(asset) == "string" then "Image" else "ImageContent",
					}
				end,
				render = function(_, _, kind: string): GuiObject
					if kind ~= "text" then
						local native: Shared.ImageLabelNativeProps = {
							Name = "Glyph",
							BackgroundTransparency = 1,
							Size = function(use: ComposeTypes.Use)
								local size = ctx.controlSize(controlSize, "iconSize", use)
								return D2.fromOffset(size, size)
							end,
						}
						if kind ~= "Image" then
							native.ImageContent = function(use: ComposeTypes.Use): Content
								return use(nativeImage) :: Content
							end
							return Host.ImageLabel(native)
						end
						native.Image = function(use: ComposeTypes.Use): string
							return use(nativeImage) :: string
						end
						return ctx.styled(Host.ImageLabel(native), "shortcut-glyph")
					end
					return ctx.text({
						Name = "Key",
						Text = function(use: ComposeTypes.Use): string
							local custom = read(parts.name, use)
							if custom and custom ~= "" then
								return custom
							end
							local keys: { string } = {}
							local service = input
							for _, code in
								{ read(parts.primary, use), read(parts.secondary, use), read(parts.key, use) }
							do
								if code and code ~= noKey then
									local ok, found = true, KEY_NAMES[code.Name] or ""
									if found == "" and service and service.GetStringForKeyCode then
										ok, found = pcall(function(): string
											return service:GetStringForKeyCode(code)
										end)
									end
									local text = if ok and type(found) == "string" then found else ""
									if string.match(text, "^%s*$") then
										text = KEY_NAMES[code.Name] or code.Name
									end
									table.insert(keys, text)
								end
							end
							return table.concat(keys, "+")
						end,
					})
				end,
			}),
		}
	end
end
]]></ProtectedString>
							<string name="ScriptGuid">{7D56C4B3-C2D9-402B-AE20-5EC3EE468DDC}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">input_key_glyph</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc3890000044f</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="115">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local layoutKit = require("./layout_kit")
local valueModel = require("./input_value")
local inputAdjustment = require("./input_adjustment")
local InputTypes = require("./input_types")
local Shared = require("./types")
local ComposeTypes = require("../vendor/compose/core")

export type ValueState<T> = {
	value: Shared.Value<T>,
	onChange: ((T) -> ())?,
	readOnly: boolean?,
}
export type NumberSpec = { value: Shared.Value<number>, onChange: ((number) -> ())? }
type Unskinned = typeof(setmetatable({} :: { [unknown]: boolean }, { __mode = "k" }))
export type Kit = {
	lists: layoutKit.Kit,
	noKey: Enum.KeyCode,
	unskinned: Unskinned,
	typeRoles: { [string]: boolean },
	repeatDelay: number,
	repeatInterval: number,
	repeatHeld: inputAdjustment.RepeatHeld,
	dynamic: (unknown) -> boolean,
	hasText: (Shared.Value<string>?, ComposeTypes.Use?) -> boolean,
	enabled: (inputAdjustment.EnabledSource, ComposeTypes.Use?) -> boolean,
	stopEnabled: (inputAdjustment.EnabledSource, ComposeTypes.Use?) -> boolean,
	writable: (unknown) -> boolean,
	requireValue: (NumberSpec, "boolean" | "number" | "string", string) -> (),
	changed: (NumberSpec, number) -> boolean,
	attributes: (Instance, Shared.Attributes) -> Instance,
	valueAttributes: (GuiObject, NumberSpec, valueModel.Model) -> (),
	adjustment: inputAdjustment.Adjustment,
	paintedPart: (Shared.FrameProps, Shared.Value<string>?, string, string) -> Frame,
}

local REPEAT_DELAY, REPEAT_INTERVAL = 0.4, 0.1

local function repeatHeld(
	frames: { onFrame: ((number) -> ()) -> () -> () },
	delay: number,
	interval: number,
	keep: () -> boolean,
	fire: () -> ()
): () -> ()
	local elapsed, deadline = 0, delay
	return frames.onFrame(function(delta: number)
		if not keep() then
			return
		end
		elapsed += delta
		local steps = 0
		while elapsed >= deadline and steps < 5 do
			fire()
			deadline += interval
			steps += 1
		end
		if steps == 5 then
			deadline = elapsed + interval
		end
	end)
end

return function(ctx: Shared.Context): Kit
	local lists = layoutKit.of(ctx)
	local runtime, Host, Compose = ctx.runtime, ctx.Host, ctx.Compose
	local read = ctx.read
	local D2, E = ctx.types.UDim2, ctx.types.Enum
	local noKey: Enum.KeyCode = assert(E.KeyCode:FromValue(0))
	local unskinned = setmetatable({} :: { [unknown]: boolean }, { __mode = "k" })
	local typeRoles: { [string]: boolean } = {
		caption = true,
		label = true,
		body = true,
		heading = true,
		title = true,
		control = true,
		strong = true,
		numeral = true,
	}
	local function dynamic(source: unknown): boolean
		return Compose.isReadable(source) or type(source) == "function"
	end
	local function hasText(source: Shared.Value<string>?, use: ComposeTypes.Use?): boolean
		local value = read(source, use)
		return value ~= nil and value ~= ""
	end
	local function enabled(spec: inputAdjustment.EnabledSource, use: ComposeTypes.Use?): boolean
		local state = spec :: InputTypes.EnabledOptions
		return read(state.enabled, use) ~= false and read(state.disabled, use) ~= true and read(state.busy, use) ~= true
	end
	local function stopEnabled(spec: inputAdjustment.EnabledSource, use: ComposeTypes.Use?): boolean
		local state = spec :: InputTypes.EnabledOptions
		return read(state.enabled, use) ~= false and read(state.disabled, use) ~= true
	end
	local function writable(source: unknown): boolean
		return type(source) == "table"
			and Compose.isReadable(source)
			and type((source :: { [string]: unknown }).set) == "function"
	end
	local function requireValue(spec: NumberSpec, kind: "boolean" | "number" | "string", name: string): ()
		assert(type(read(spec.value)) == kind, `Facet.{name}: value must resolve to a {kind}`)
		assert(
			writable(spec.value) or type(spec.onChange) == "function" or (spec :: ValueState<number>).readOnly == true,
			`Facet.{name}: editing a read-only value requires onChange`
		)
	end

	local function changed(spec: NumberSpec, nextValue: number): boolean
		if read(spec.value) == nextValue then
			return false
		end
		if spec.onChange then
			spec.onChange(nextValue)
		else
			(spec.value :: ComposeTypes.Cell<number>):set(nextValue)
		end
		return read(spec.value) == nextValue
	end
	local function attributes(node: Instance, values: Shared.Attributes): Instance
		runtime.decorate(node, { Attributes = values })
		return node
	end
	local function valueAttributes(node: GuiObject, spec: NumberSpec, model: valueModel.Model): ()
		attributes(node, {
			value = function(use: ComposeTypes.Use)
				return model.quantize(read(spec.value, use))
			end,
			minimum = model.min,
			maximum = model.max,
			semanticValue = function(use: ComposeTypes.Use)
				return `{model.format(read(spec.value, use))} of {model.min} to {model.max}`
			end,
		})
	end
	local adjustment = inputAdjustment(ctx, {
		attributes = attributes,
		enabled = enabled,
		stopEnabled = stopEnabled,
		repeatHeld = repeatHeld,
		repeatDelay = REPEAT_DELAY,
		repeatInterval = REPEAT_INTERVAL,
	})
	local function paintedPart(
		native: Shared.FrameProps,
		image: Shared.Value<string>?,
		role: string,
		slot: string
	): Frame
		if image then
			native[#native + 1] = Host.ImageLabel "Artwork" {
				Image = image,
				BackgroundTransparency = 1,
				Size = D2.fromScale(1, 1),
				ScaleType = E.ScaleType.Stretch,
			}
		end
		local node = ctx.styled(Host.Frame(native), role)
		if not image then
			ctx.skin(node, slot)
		end
		return node
	end
	return {
		lists = lists,
		noKey = noKey,
		unskinned = unskinned,
		typeRoles = typeRoles,
		repeatDelay = REPEAT_DELAY,
		repeatInterval = REPEAT_INTERVAL,
		repeatHeld = repeatHeld,
		dynamic = dynamic,
		hasText = hasText,
		enabled = enabled,
		stopEnabled = stopEnabled,
		writable = writable,
		requireValue = requireValue,
		changed = changed,
		attributes = attributes,
		valueAttributes = valueAttributes,
		adjustment = adjustment,
		paintedPart = paintedPart,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{CBA71BD7-061D-4217-BF77-081AF3F4E6B8}</string>
