chrome: ("device" | "band" | "edge")? = "device"
distribute: Value<("start" | "center" | "end" | "spaceBetween" | "spaceAround" | "spaceEvenly")>? = omitted
gap: Value<(number | ("xs" | "s" | "m" | "l" | "xl") | string)>? = omitted
height: Value<(number | "fill" | "hug")>? = "fill"
maxWidth: ValueNumber? = omitted
padding: Value<((number | ("xs" | "s" | "m" | "l" | "xl") | string) | Sides)>? = "m"
ref: ((Frame) -> ())? = omitted
width: Value<(number | "fill" | "hug")>? = "fill"
Sides = { top: (number | SpaceStep | string)?, right: (number | SpaceStep | string)?, bottom: (number | SpaceStep | string)?, left: (number | SpaceStep | string)?, [string]: nil }]]></string>
