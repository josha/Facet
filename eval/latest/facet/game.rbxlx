						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local layoutKit = require("./layout_kit")
local Types = require("./types")
local Navigation = require("./navigation_types")
local ControlTypes = require("./control_types")
local RadialProps = require("./radial_props")
local ComposeTypes = require("../vendor/compose/core")
local createMenu = require("./nav_radial_menu")
local arrangeRing = require("./nav_radial_layout")
local ArrangementTypes = require("./nav_radial_layout")
local MenuTypes = require("./nav_radial_menu")
local paintSectors = require("./nav_radial_sectors")
local buildCenter = require("./nav_radial_center")
local attachGestures = require("./nav_radial_gestures")
local createPresence = require("./nav_overlay_presence")

return function(ctx: Types.Context, UI: ControlTypes.BuilderControls, surfaces: Navigation.Surfaces)
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local typeOf: (unknown) -> string = runtime.host.typeNameOf or typeof
	local lists = layoutKit.of(ctx)
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local build = function<V>(spec: RadialProps.RadialMenuSpec<V>): Frame
		assert(spec.items, "RadialMenu requires items")
		local menu = createMenu(ctx, surfaces, spec)
		local session = menu.session
		local opened, scrim, skin = menu.opened, menu.scrim, menu.skin
		local cancel, close, open = menu.cancel, menu.close, menu.open
		local back: () -> () = menu.back
		local isPointer = menu.isPointer
		local anchored = read(spec.anchor)
		local anchorGui = if anchored
				and (typeof(anchored) == "Instance" or (type(anchored) == "table" and anchored.IsA))
			then anchored :: GuiObject
			else nil
		local root = Host.Frame(ctx.props(spec, {
			"items",
			"label",
			"launcher",
			"icon",
			"preset",
			"appearance",
			"buttonSurface",
			"distribution",
			"navigation",
			"expansion",
			"center",
			"centerLabel",
			"centerContent",
			"centerPassThrough",
			"completion",
			"anchor",
			"follow",
			"clearance",
			"ringWidth",
			"contentFit",
			"gestureSelection",
			"enabled",
			"holdAction",
			"skin",
			"onOpen",
			"onClose",
			"isPresented",
			"transition",
			"scrim",
		}, {
			Name = "RadialMenu",
			BackgroundTransparency = 1,
			Size = D2.fromOffset(0, 0),
			AutomaticSize = if anchorGui then E.AutomaticSize.None else E.AutomaticSize.XY,
		}))
		local layoutUnit = ctx.layoutUnit(root)
		local timing = ctx.motionTiming("radial")
		local departure = createPresence(ctx).departure(timing, root, function(): boolean
			return not menu.reduced() and spec.transition ~= false
		end)
		local beginDeparture = assert(departure.exit)
		departure.exit = function(nodes): ComposeTypes.Exiting
			timing.exit = ctx.metric("motion.radial.exit")
			return beginDeparture(nodes)
		end
		if spec.launcher ~= false then
			local overAnchor: ((ComposeTypes.Use) -> UDim2)? = nil
			if anchorGui then
				local at, size = ctx.observe.AbsolutePosition(anchorGui), ctx.observe.AbsoluteSize(anchorGui)
				local own = ctx.observe.AbsolutePosition(root)
				overAnchor = function(use: ComposeTypes.Use): UDim2
					local middle = use(at) + use(size) / 2 - use(own)
					return D2.fromOffset(middle.X, middle.Y)
				end
			end
			surfaces.attach(root, {
				UI.Button "Launcher" {
					AnchorPoint = if overAnchor then V2.new(0.5, 0.5) else nil,
					Position = overAnchor,
					label = spec.label or "Quick actions",
					name = spec.label or "Quick actions",
					icon = spec.icon or (if spec.label == nil then "more" else nil),
					shape = if spec.label == nil then "circle" :: "circle" else nil,
					enabled = spec.enabled,
					InputBegan = function(input: InputObject)
						if not opened:peek() and isPointer(input) then
							open()
							session.openedByLauncher = opened:peek()
							menu.beginPointer(input, false, true)
						end
					end,
					onActivate = function(input: InputObject?)
						local echo = session.openedByLauncher and input ~= nil and isPointer(input)
						session.openedByLauncher = false
						if echo then
							return
						end
						if opened:peek() then
							close()
						else
							open()
						end
					end,
				},
			})
		end
		surfaces.attach(root, {
			surfaces.overlay(root, opened, function(phase: Navigation.PresencePhase?)
				local arrange: (Types.Context, MenuTypes.Menu<V>, Frame) -> ArrangementTypes.Arrangement<V> =
					arrangeRing
				local arrangement = arrange(ctx, menu, root)
				local paint = paintSectors(ctx, UI, surfaces, lists, menu, arrangement, phase)
				local hub = buildCenter(ctx, UI, surfaces, menu, arrangement, paint, root, layoutUnit, phase)
				attachGestures(ctx, surfaces, menu, arrangement, paint, hub)
				local viewport, origin, center, layout, fallback =
					arrangement.viewport,
					arrangement.origin,
					arrangement.center,
					arrangement.layout,
					arrangement.fallback
				local hideLauncher = hub.hideLauncher
				local modal = surfaces.modal(
					function()
						return paint.panel
					end,
					back,
					{
						appearance = function(use: ComposeTypes.Use?): number
							return 1 - if use then paint.transparency(use) else 0
						end,
					}
				)
				modal:SetAttribute("FacetArrivalGroup", true)
				surfaces.attach(modal, { hub.centerHit, hub.centerNode, hub.previewPlate, hub.preview })
				if hideLauncher then
					hideLauncher()
				end
				local catcher = modal:FindFirstChild("Scrim")
				if catcher then
					if scrim == "dark" then
						catcher:AddTag("facet-radial-scrim")
					elseif scrim == "none" then
						local clear = catcher :: GuiObject
						clear:RemoveTag("facet-scrim")
						clear.BackgroundTransparency = 1
					end
					runtime.decorate(catcher, {
						Position = function(use: ComposeTypes.Use)
							local size = use(viewport)
							return D2.fromOffset(-size.X, -size.Y)
						end,
						Size = function(use: ComposeTypes.Use)
							local size = use(viewport)
							return D2.new(1, 2 * size.X, 1, 2 * size.Y)
						end,
					})
				end
				if spec.skin and spec.skin.background then
					skin(modal, spec.skin.background)
				end
				local bounds = ctx.observe.AbsoluteSize(modal)
				local position = ctx.observe.AbsolutePosition(modal)
				Compose.watch(function(use: ComposeTypes.Use)
					local at, size = use(position), use(bounds)
					if size.X > 0 and size.Y > 0 then
						origin:set(at)
					end
				end)
				if spec.centerPassThrough and (spec.center == "empty" or spec.center == "content") then
					runtime.decorate(modal, { Active = fallback })
					if anchorGui then
						surfaces.attach(modal, {
							Compose.show(function(use: ComposeTypes.Use): boolean
								return not use(fallback)
							end, function()
								ctx.modalPortal(anchorGui, modal)
								return Compose.fragment(function()
									return {}
								end)
							end),
						})
					end
					local outside = modal:FindFirstChild("DismissTarget")
					if outside then
						runtime.decorate(outside, { Visible = fallback })
					end
					for _, edge in { "Top", "Bottom", "Left", "Right" } do
						local rectangle = Compose.formula(function(use: ComposeTypes.Use)
							local size, at, radius = use(viewport), use(center), use(layout).inner
							local left, right =
								math.clamp(at.X - radius, 0, size.X), math.clamp(at.X + radius, 0, size.X)
							local top, bottom =
								math.clamp(at.Y - radius, 0, size.Y), math.clamp(at.Y + radius, 0, size.Y)
							if edge == "Top" then
								return { 0, 0, size.X, top }
							end
							if edge == "Bottom" then
								return { 0, bottom, size.X, size.Y - bottom }
							end
							if edge == "Left" then
								return { 0, top, left, bottom - top }
							end
							return { right, top, size.X - right, bottom - top }
						end)
						surfaces.attach(modal, {
							Host.TextButton({
								Name = "Dismiss" .. edge,
								Text = "",
								BackgroundTransparency = 1,
								Selectable = false,
								ZIndex = 100,
								Visible = function(use: ComposeTypes.Use)
									return not use(fallback) and use(opened)
								end,
								Position = function(use: ComposeTypes.Use)
									local r = use(rectangle)
									return D2.fromOffset(r[1], r[2])
								end,
								Size = function(use: ComposeTypes.Use)
									local r = use(rectangle)
									return D2.fromOffset(r[3], r[4])
								end,
								Activated = back,
							}),
						})
					end
				end
				Compose.watch(function(use: ComposeTypes.Use)
					local size = use(bounds)
					if size.X > 0 and size.Y > 0 then
						if viewport:peek() ~= size then
							cancel()
						end
						viewport:set(size)
					end
				end)
				return modal
			end, {
				presence = departure,
			}),
		})
		Compose.watch(function(use: ComposeTypes.Use)
			local anchor = read(spec.anchor, use)
			if not use(opened) then
				cancel()
			end
			if
				read(spec.enabled, use) == false
				or (typeOf(anchor) ~= "Instance" and type(anchor) == "table" and anchor.visible == false)
			then
				close()
			end
		end)
		if spec.holdAction then
			runtime.connect(spec.holdAction, "Pressed", function()
				session.held = true
				open()
			end)
			runtime.connect(spec.holdAction, "Released", function()
				if not session.held then
					return
				end
				session.held = false
				local selected = if session.analog and session.candidateSector
					then assert(session.candidateSector)()
					else nil
				if selected then
					menu.nativeActivate(selected, nil, "hold")
				else
					cancel()
				end
			end)
		end
		local launcher = root:FindFirstChild("Launcher")
		if launcher and launcher:IsA("GuiObject") then
			skin(launcher, spec.skin and spec.skin.launcher)
		end
		return root
	end
	UI.RadialMenu = ctx.construct("RadialMenu", build) :: ControlTypes.RadialMenuConstructor
end
]]></ProtectedString>
							<string name="ScriptGuid">{FCB4A1D7-715C-4AC3-A8D3-D43C653A0547}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">nav_radial</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc3890000048c</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="176">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local geometry = require("./nav_radial_geometry")
local placement = require("./overlay_placement")
local Types = require("./types")
local Radial = require("./radial_types")
local Navigation = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local MenuTypes = require("./nav_radial_menu")
local ArrangementTypes = require("./nav_radial_layout")
local PaintTypes = require("./nav_radial_sectors")

export type Hub<V> = {
	showCenter: (use: ComposeTypes.Use) -> boolean,
	centerNode: TextButton,
	centerHit: TextButton,
	hideLauncher: (() -> ())?,
	reachOf: (ring: Radial.Layout<V>) -> number,
	preview: TextLabel,
	previewPlate: Frame,
}

return function<V>(
	ctx: Types.Context,
	UI: MenuTypes.Controls,
	surfaces: Navigation.Surfaces,
	menu: MenuTypes.Menu<V>,
	arrangement: ArrangementTypes.Arrangement<V>,
	paint: PaintTypes.Paint<V>,
	root: Frame,
	layoutUnit: ComposeTypes.Readable<number>,
	phase: Navigation.PresencePhase?
): Hub<V>
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local spec, corner, painted = menu.spec, menu.corner, menu.painted
	local path, candidate, naming, touchPoint = menu.path, menu.candidate, menu.naming, menu.touchPoint
	local preferred = menu.preferred
	local viewport, origin, launcher, anchorSize =
		arrangement.viewport, arrangement.origin, arrangement.launcher, arrangement.anchorSize
	local center, layout, sectors, fallback =
		arrangement.center, arrangement.layout, arrangement.sectors, arrangement.fallback
	local transparency, panel = paint.transparency, paint.panel
	local ringNavigation = spec.center == "empty" or spec.center == "content"
	local function showCenter(use: ComposeTypes.Use): boolean
		if corner and spec.center == "empty" and spec.centerPassThrough and not use(fallback) then
			return false
		end
		if corner or use(fallback) or not ringNavigation then
			return true
		end
		for _, sector in use(sectors) do
			if sector.id == "$navigation" then
				return false
			end
		end
		return true
	end
	local function navigating(use: ComposeTypes.Use?): boolean
		return corner or ringNavigation or (if use then use(fallback) else fallback:peek())
	end
	local function centerAction()
		if navigating() or spec.center == nil or spec.center == "back" then
			menu.back()
		elseif spec.center == "root" then
			menu.jump({})
		else
			menu.close()
		end
	end
	local function hub(use: ComposeTypes.Use): number
		return if showCenter(use) then math.min(painted(use), 2 * use(layout).inner - 4) else 0
	end
	local function centerName(use: ComposeTypes.Use): string
		local depth = #use(path)
		if navigating(use) or spec.center == nil or spec.center == "back" then
			return (if navigating(use) then nil else read(spec.centerLabel, use))
				or if depth == 0 then "Close" else "Back"
		end
		return read(spec.centerLabel, use) or if spec.center == "root" then "Home" else "Close"
	end
	local function morph(use: ComposeTypes.Use): number
		return 1 - transparency(use)
	end
	local function diameter(use: ComposeTypes.Use): number
		if use(fallback) then
			return painted(use)
		end
		if corner and launcher and anchorSize then
			local extent = use(anchorSize)
			local from = math.max(painted(use), math.min(extent.X, extent.Y))
			return math.floor(painted(use) + (from - painted(use)) * (1 - morph(use)) + 0.5)
		end
		return hub(use)
	end
	local function centerAt(use: ComposeTypes.Use): UDim2
		if use(fallback) then
			return D2.new(1, -16 - painted(use) / 2, 0, 2 + painted(use) / 2)
		end
		local at = use(center)
		return D2.fromOffset(at.X, at.Y)
	end
	local hideLauncher: (() -> ())? = nil
	local centerNode = UI.Button "Center" {
		corners = "pill" :: "pill",
		appearance = "utility",
		name = centerName,
		icon = function(use: ComposeTypes.Use): string
			return if spec.center == "root" and not navigating(use)
				then "chevron.up"
				elseif centerName(use) == "Back" then "chevron.leading"
				else "close"
		end,
		Visible = showCenter,
		Position = centerAt,
		AnchorPoint = V2.new(0.5, 0.5),
		Size = function(use: ComposeTypes.Use)
			local size = diameter(use)
			return D2.fromOffset(size, size)
		end,
		AutomaticSize = E.AutomaticSize.None,
		ZIndex = 105,
		onActivate = centerAction,
	}
	local centerHit = Host.TextButton "CenterHit" {
		Text = "",
		BackgroundTransparency = 1,
		Selectable = false,
		Visible = showCenter,
		Position = centerAt,
		AnchorPoint = V2.new(0.5, 0.5),
		Size = function(use: ComposeTypes.Use)
			local size = math.max(diameter(use), (ctx.metric("targetSizes.minimum", use)))
			return D2.fromOffset(size, size)
		end,
		ZIndex = 104,
		Activated = centerAction,
	}
	if launcher and launcher:IsA("GuiObject") then
		local hidden = launcher :: GuiObject

		hideLauncher = function()
			local automatic, size = root.AutomaticSize, root.Size
			local held = automatic ~= E.AutomaticSize.None
			local extent = root.AbsoluteSize / layoutUnit:peek()
			local function show()
				hidden.Visible = true
				if held then
					root.AutomaticSize, root.Size = automatic, size
				end
			end
			if held then
				root.AutomaticSize, root.Size = E.AutomaticSize.None, D2.fromOffset(extent.X, extent.Y)
			end
			hidden.Visible = false
			if phase and corner then
				Compose.watch(function(use: ComposeTypes.Use)
					if use(phase.exiting) then
						show()
					end
				end)
			end
			Compose.cleanup(show)
		end
	end
	if corner and launcher and launcher:IsA("GuiObject") then
		local glyph = centerNode:FindFirstChild("LeadingIcon", true)
		if glyph then
			runtime.decorate(glyph, {
				ImageTransparency = function(use: ComposeTypes.Use): number
					return 1 - morph(use)
				end,
			})
		end
		surfaces.attach(centerNode, {
			ctx.icon(spec.icon or "more", {
				Name = "LauncherIcon",
				AnchorPoint = V2.new(0.5, 0.5),
				Position = D2.fromScale(0.5, 0.5),
				ImageTransparency = morph,
			}),
		})
	end
	if not corner then
		local glyph = centerNode:FindFirstChild("LeadingIcon", true)
		if glyph then
			runtime.decorate(glyph, { ImageTransparency = transparency })
		end
	end
	if spec.center == "content" and spec.centerContent and not corner then
		local node = if type(spec.centerContent) == "function" then spec.centerContent() else spec.centerContent
		runtime.decorate(node, {
			Position = function(use: ComposeTypes.Use)
				local at = use(center)
				return D2.fromOffset(at.X, at.Y)
			end,
			AnchorPoint = V2.new(0.5, 0.5),
			ZIndex = 105,
		})
		surfaces.attach(panel, { node })
	end
	menu.skin(centerNode, spec.skin and spec.skin.center)
	local panelSize = ctx.observe.AbsoluteSize(panel)
	local function reachOf(ring: Radial.Layout<V>): number
		local reach = ring.inner
		for _, sector in ring.sectors do
			reach = math.max(reach, sector.outer)
		end
		return reach
	end
	local previewBounds = Compose.cell(V2.zero)
	local function previewSize(use: ComposeTypes.Use): Vector2
		local bounds = use(previewBounds)
		return V2.new(
			math.min(240, math.max(0, use(viewport).X - 16), if bounds.X > 0 then math.ceil(bounds.X) else 240),
			math.max(ctx.metric("typography.caption.size", use) + 12, math.ceil(bounds.Y))
		)
	end
	local function previewPlace(use: ComposeTypes.Use): (UDim2, Vector2)
		local ring = use(layout)
		if ring.list then
			return D2.fromOffset(16, 40), V2.new(0, 1)
		end
		local at = use(center)
		do
			local key = use(candidate)
			local near: Radial.Sector<V>? = nil
			for _, sector in ring.sectors do
				if sector.key == key then
					near = sector
				end
			end
			local point = use(touchPoint)
			if near and (point or (preferred and use(preferred) == E.PreferredInput.Touch)) then
				local room = use(viewport)
				local contact = if point then V2.new(point.X, point.Y) - use(origin) else at + V2.new(near.x, near.y)
				local size = previewSize(use)
				local box = placement.touch(
					{ x = contact.X, y = contact.Y },
					{ w = size.X, h = size.Y },
					{ x = 8, y = 8, w = math.max(0, room.X - 16), h = math.max(0, room.Y - 16) },
					ctx.metric("targetSizes.minimum", use) + ctx.metric("space.s", use)
				)
				return D2.fromOffset(box.x + box.w / 2, box.y + box.h), V2.new(0.5, 1)
			end
			local angle = math.rad(if near then near.angle else geometry.arc(spec.preset or "donut") + 45)
			local dx, dy = math.sin(angle), -math.cos(angle)
			local reach = if near
				then math.sqrt(near.x * near.x + near.y * near.y) + math.max(44, near.size) / 2 + ctx.metric(
					"space.xs",
					use
				)
				else reachOf(ring) + ctx.metric("space.s", use)
			local function side(value: number): number
				return if value > 0.3 then 0 elseif value < -0.3 then 1 else 0.5
			end
			return D2.fromOffset(at.X + dx * reach, at.Y + dy * reach), V2.new(side(dx), side(dy))
		end
	end
	local function previewWidth(use: ComposeTypes.Use): number
		if use(touchPoint) or preferred and use(preferred) == E.PreferredInput.Touch then
			return math.min(240, math.max(0, use(viewport).X - 16))
		end
		local place, anchor = previewPlace(use)
		local x, room = place.X.Offset, use(viewport).X
		local fits = if anchor.X == 0
			then room - 8 - x
			elseif anchor.X == 1 then x - 8
			else 2 * math.min(x - 8, room - 8 - x)
		return math.max(0, math.min(240, fits))
	end
	local preview = ctx.text({
		Name = "SelectionPreview",
		Size = function(use: ComposeTypes.Use): UDim2
			if use(layout).list then
				return D2.new(1, -32 - 1.5 * painted(use), 0, 0)
			end
			return D2.fromOffset(0, 0)
		end,
		AutomaticSize = function(use: ComposeTypes.Use)
			return if use(layout).list then E.AutomaticSize.Y else E.AutomaticSize.XY
		end,
		Position = function(use: ComposeTypes.Use): UDim2
			return (previewPlace(use))
		end,
		AnchorPoint = function(use: ComposeTypes.Use): Vector2
			local _, anchor = previewPlace(use)
			return anchor
		end,
		TextXAlignment = function(use: ComposeTypes.Use)
			local _, anchor = previewPlace(use)
			return if anchor.X == 0.5
				then E.TextXAlignment.Center
				elseif anchor.X == 0 then E.TextXAlignment.Left
				else E.TextXAlignment.Right
		end,
		TextWrapped = true,
		Text = function(use: ComposeTypes.Use)
			if not use(layout).list then
				local key = if use(naming) then use(candidate) else nil
				local entries = use(sectors)
				for sectorIndex = 1, #entries do
					local sector = entries[sectorIndex]
					if sector.key == key and paint.iconic(use, sector) then
						local label = read(sector.item.label, use) or ""
						local detail = read(sector.item.description, use)
						return label .. (if detail then " · " .. detail else "")
					end
				end
				return ""
			end

			local labels: { string } = {}
			local items: { Radial.RadialItem<V> }? = read(spec.items, use)
			for _, id in use(path) do
				local found: Radial.RadialItem<V>? = nil
				local level: { Radial.RadialItem<V> } = items or {}
				for itemIndex = 1, #level do
					local item = level[itemIndex]
					if item.id == id then
						found = item
					end
				end
				if found == nil then
					break
				end
				table.insert(labels, tostring(read(found.label, use) or id))
				items = read(found.children, use)
			end
			return if #labels > 0 then table.concat(labels, " › ") else read(spec.label, use) or "Quick actions"
		end,
		ZIndex = 106,
		ctx.padding(8, 6),
	})
	preview:AddTag("facet-type-caption")
	surfaces.attach(preview, {
		Host.UISizeConstraint {
			MaxSize = function(use: ComposeTypes.Use): Vector2
				return V2.new(if use(layout).list then math.huge else previewWidth(use), math.huge)
			end,
		},
	})
	local textBounds = ctx.layoutSize(preview, layoutUnit)
	Compose.watch(function(use: ComposeTypes.Use)
		previewBounds:set(use(textBounds))
	end)
	local previewText = ctx.observe.Text(preview)
	local function previewShown(use: ComposeTypes.Use): boolean
		return use(layout).list or use(naming) and use(candidate) ~= nil and use(previewText) ~= ""
	end
	runtime.decorate(preview, { Visible = previewShown })
	local previewPlate = ctx.styled(
		Host.Frame "SelectionPlate" {
			Position = function(use: ComposeTypes.Use): UDim2
				return (previewPlace(use))
			end,
			AnchorPoint = function(use: ComposeTypes.Use): Vector2
				return select(2, previewPlace(use))
			end,
			Size = function(use: ComposeTypes.Use): UDim2
				return D2.fromOffset(previewSize(use).X, previewSize(use).Y)
			end,
			Visible = function(use: ComposeTypes.Use): boolean
				return not use(layout).list and previewShown(use)
			end,
			ZIndex = 105,
		},
		"tooltip"
	)
	return {
		showCenter = showCenter,
		centerNode = centerNode,
		centerHit = centerHit,
		hideLauncher = hideLauncher,
		reachOf = reachOf,
		preview = preview,
		previewPlate = previewPlate,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{4D595813-448E-4739-A75D-2C670346C3F1}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">nav_radial_center</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc3890000048d</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="177">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict

local Radial = require("./radial_types")

local geometry = {}
local pathShapes = require("./nav_path_shapes")
local slots: { [string]: number } = { N = 0, NE = 45, E = 90, SE = 135, S = 180, SW = 225, W = 270, NW = 315 }
function geometry.arc(preset: string): (number, number)
	local corners: { [string]: number } =
		{ ["top-left"] = 90, ["top-right"] = 180, ["bottom-right"] = 270, ["bottom-left"] = 0 }
	return corners[preset] or 0, if corners[preset] then 90 else 360
end
function geometry.delta(a: number, b: number): number
	return (a - b + 180) % 360 - 180
end
function geometry.sectors<V>(
	items: { Radial.RadialItem<V> },
	start: number,
	sweep: number,
	distribution: string,
	inner: number,
	outer: number
): { Radial.Sector<V> }
	local result: { Radial.Sector<V> } = {}
	local used: { [number]: boolean } = {}
	for i = 1, #items do
		local item = items[i]
		local angle: number
		local span: number
		if distribution == "compass" then
			local slot = if item.slot then slots[item.slot] else nil
			assert(slot ~= nil, "RadialMenu: compass items require slot N, NE, E, SE, S, SW, W, or NW")
			angle = slot
			assert(not used[angle], "RadialMenu: conflicting compass slot " .. tostring(item.slot))
			used[angle] = true
			span = 45
			if sweep < 360 then
				local distance = (angle - start) % 360
				span = math.min(span, 2 * distance, 2 * (sweep - distance))
				assert(span > 0, "RadialMenu: corner compass slots must be inside the arc, not on its edge")
			end
		else
			span = sweep / #items
			angle = if sweep == 360 then start + (i - 1) * span else start + (i - 0.5) * span
		end
		assert(sweep == 360 or ((angle - start) % 360 <= sweep), "RadialMenu: compass slot is outside the corner arc")
		local radius = (inner + outer) / 2
		local sector: Radial.Sector<V> = {
			id = item.id,
			item = item,
			path = {},
			key = item.id,
			index = i,
			list = false,
			angle = angle,
			span = span,
			inner = inner,
			outer = outer,
			x = math.sin(math.rad(angle)) * radius,
			y = -math.cos(math.rad(angle)) * radius,
			size = math.min(outer - inner, 2 * radius * math.sin(math.rad(math.min(span, 180) / 2)) * 0.86),
		}
		result[i] = sector
	end
	return result
end

type LabelBounds = { w: number, h: number }
type LabelFit = {
	x: number,
	y: number,
	inner: number,
	outer: number,
	angle: number,
	span: number,
	height: number,
	bounds: LabelBounds,
}
local labelFits = setmetatable({} :: { [Radial.SectorShape]: LabelFit }, { __mode = "k" })

function geometry.labelBounds(s: Radial.SectorShape, height: number): LabelBounds
	local cached = labelFits[s]
	if
		cached
		and cached.x == s.x
		and cached.y == s.y
		and cached.inner == s.inner
		and cached.outer == s.outer
		and cached.angle == s.angle
		and cached.span == s.span
		and cached.height == height
	then
		return cached.bounds
	end
	local requestedHeight = height
	local innerSquared, outerSquared = s.inner * s.inner, s.outer * s.outer
	local sine, cosine = math.sin(math.rad(s.angle)), math.cos(math.rad(s.angle))
	local halfAngle = s.span / 2 - 2
	local threshold = math.cos(math.rad(halfAngle))
	local thresholdSquared = threshold * threshold
	local function cornerFits(x: number, y: number): boolean
		local radiusSquared = x * x + y * y
		if radiusSquared > outerSquared or halfAngle < 0 then
			return false
		end
		local projection = x * sine - y * cosine
		if threshold >= 0 then
			return projection >= 0 and projection * projection >= radiusSquared * thresholdSquared
		end
		return projection >= 0 or projection * projection <= radiusSquared * thresholdSquared
	end
	local function fits(width: number, h: number): boolean
		local hx, hy = width / 2 + 3, h / 2 + 3
		local nearX, nearY = math.max(0, math.abs(s.x) - hx), math.max(0, math.abs(s.y) - hy)
		if nearX * nearX + nearY * nearY < innerSquared then
			return false
		end
		return cornerFits(s.x - hx, s.y - hy)
			and cornerFits(s.x - hx, s.y + hy)
			and cornerFits(s.x + hx, s.y - hy)
			and cornerFits(s.x + hx, s.y + hy)
	end

	if not fits(height, height) then
		local low, high = 0, height
		for _ = 1, 14 do
			local mid = (low + high) / 2
			if fits(mid, mid) then
				low = mid
			else
				high = mid
			end
		end
		height = low
	end
	local lo, hi = 0, math.min(160, s.outer * 2)
	for _ = 1, 14 do
		local mid = (lo + hi) / 2
		if fits(mid, height) then
			lo = mid
		else
			hi = mid
		end
	end
	local bounds: LabelBounds = { w = lo, h = height }
	table.freeze(bounds)
	labelFits[s] = {
		x = s.x,
		y = s.y,
		inner = s.inner,
		outer = s.outer,
		angle = s.angle,
		span = s.span,
		height = requestedHeight,
		bounds = bounds,
	}
	return (bounds :: unknown) :: LabelBounds
end

function geometry.fitContent(
	s: Radial.SectorShape,
	width: number,
	height: number,
	padding: number,
	mode: Radial.ContentFit
): Radial.SectorShape
	local fitted = table.clone(s)
	if mode == "none" then
		return fitted
	end
	local hx, hy = width / 2 + padding, height / 2 + padding
	local nx, ny = math.max(0, math.abs(s.x) - hx), math.max(0, math.abs(s.y) - hy)
	local near, far, halfAngle = math.sqrt(nx * nx + ny * ny), 0, 0
	for _, dx in { -hx, hx } do
		for _, dy in { -hy, hy } do
			local x, y = s.x + dx, s.y + dy
			far = math.max(far, math.sqrt(x * x + y * y))
			halfAngle = math.max(halfAngle, math.abs(geometry.delta(math.deg(math.atan2(x, -y)), s.angle)))
		end
	end
	if mode ~= "angular" then
		fitted.inner, fitted.outer = math.max(s.inner, near), math.min(s.outer, far)
	end
	if mode ~= "radial" then
		fitted.span = math.min(s.span, halfAngle * 2 + math.deg((s.gap or 2) / math.max(1, fitted.inner)))
	end
	return fitted
end
function geometry.hit<V>(
	sectors: { Radial.Sector<V> },
	x: number,
	y: number,
	appearance: string,
	overshoot: number?,
	previous: Radial.Sector<V>?
): Radial.Sector<V>?
	local radius = math.sqrt(x * x + y * y)
	local angle = math.deg(math.atan2(x, -y)) % 360
	local function contains(s: Radial.Sector<V>, hysteresis: number): boolean
		if radius < s.inner or radius > s.outer + (overshoot or 0) then
			return false
		end
		if appearance == "buttons" and overshoot == nil then
			return (x - s.x) ^ 2 + (y - s.y) ^ 2 <= (s.size / 2) ^ 2
		end
		return math.abs(geometry.delta(angle, s.angle)) < s.span / 2 + hysteresis
	end

	local candidate: Radial.Sector<V>?
	for i = #sectors, 1, -1 do
		local s = sectors[i]
		if contains(s, 0) then
			candidate = s
			break
		end
	end
	if candidate and previous and contains(previous, 3) then
		return previous
	end
	return candidate
end

function geometry.paint(s: Radial.SectorShape): Radial.Paint
	local halfGap = math.min((s.gap or 2) / 2, (s.inner + s.outer) / 2 * math.sin(math.rad(s.span / 4)))
	local trim = math.deg(math.asin(halfGap / ((s.inner + s.outer) / 2)))
	local start, span = s.angle - s.span / 2 + trim, s.span - 2 * trim
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	local angles = { start, start + span }
	for angle = 0, 720, 90 do
		if (angle - start) % 360 <= span then
			table.insert(angles, angle)
		end
	end
	for _, angle in angles do
		for _, radius in { s.inner, s.outer } do
			local x, y = math.sin(math.rad(angle)) * radius, -math.cos(math.rad(angle)) * radius
			minX = math.min(minX, x)
			maxX = math.max(maxX, x)
			minY = math.min(minY, y)
			maxY = math.max(maxY, y)
		end
	end

	for _, edge in { -1, 1 } do
		local a = math.rad(s.angle + edge * s.span / 2)
		for _, r in { s.inner, s.outer } do
			local x = math.sin(a) * r - edge * halfGap * math.cos(a)
			local y = -math.cos(a) * r - edge * halfGap * math.sin(a)
			minX = math.min(minX, x)
			maxX = math.max(maxX, x)
			minY = math.min(minY, y)
			maxY = math.max(maxY, y)
		end
	end
	local w, h = math.max(1, maxX - minX), math.max(1, maxY - minY)
	local points = pathShapes.arc(start, span, { radius = (s.inner + s.outer) / (s.outer * 2) })
	for _, endpoint in { { 1, -1 }, { #points, 1 } } do
		local p, edge = points[endpoint[1]], endpoint[2]
		local a = math.rad(s.angle + edge * s.span / 2)
		local r = (s.inner + s.outer) / 2
		p.x = 0.5 + (math.sin(a) * r - edge * halfGap * math.cos(a)) / (2 * s.outer)
		p.y = 0.5 + (-math.cos(a) * r - edge * halfGap * math.sin(a)) / (2 * s.outer)
		local length = math.sqrt(p.outX ^ 2 + p.outY ^ 2)
		p.outX, p.outY = math.cos(a) * length, math.sin(a) * length
		p.inX, p.inY = -p.outX, -p.outY
	end

	local outline: { pathShapes.PathPoint } = {}
	for _, radius in { s.outer, s.inner } do
		local arc = pathShapes.arc(start, span, { radius = radius / s.outer })
		for _, endpoint in { { 1, -1 }, { #arc, 1 } } do
			local p, edge = arc[endpoint[1]], endpoint[2]
			local a = math.rad(s.angle + edge * s.span / 2)
			p.x = 0.5 + (math.sin(a) * radius - edge * halfGap * math.cos(a)) / (2 * s.outer)
			p.y = 0.5 + (-math.cos(a) * radius - edge * halfGap * math.sin(a)) / (2 * s.outer)
		end
		if radius == s.inner then
			local reversed: { pathShapes.PathPoint } = {}
			for i = #arc, 1, -1 do
				local p = arc[i]
				p.inX, p.outX = p.outX, p.inX
				p.inY, p.outY = p.outY, p.inY
				table.insert(reversed, p)
			end
			arc = reversed
		end
		arc[1].inX, arc[1].inY = 0, 0
		arc[#arc].outX, arc[#arc].outY = 0, 0
		for _, p in arc do
			table.insert(outline, p)
		end
	end
	for _, curve in { points, outline } do
		for _, p in curve do
			p.x = (p.x * 2 * s.outer - s.outer - minX) / w
			p.y = (p.y * 2 * s.outer - s.outer - minY) / h
			p.inX *= 2 * s.outer / w
			p.outX *= 2 * s.outer / w
			p.inY *= 2 * s.outer / h
			p.outY *= 2 * s.outer / h
		end
	end
	return { x = minX, y = minY, w = w, h = h, points = points, outline = outline }
end
return geometry
]]></ProtectedString>
							<string name="ScriptGuid">{868B8147-4257-4891-9E67-263EDF54B021}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">nav_radial_geometry</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc3890000048e</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="178">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local geometry = require("./nav_radial_geometry")
local Types = require("./types")
local Radial = require("./radial_types")
local Navigation = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local MenuTypes = require("./nav_radial_menu")
local ArrangementTypes = require("./nav_radial_layout")
local PaintTypes = require("./nav_radial_sectors")
local HubTypes = require("./nav_radial_center")

type NavigationHold = { count: number, saved: boolean, changed: boolean, watch: RBXScriptConnection? }
local navigationHolds = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [Instance]: NavigationHold }
local function holdNavigation(gui: GuiService): () -> ()
	local hold = navigationHolds[gui]
	if hold == nil then
		local created: NavigationHold = { count = 0, saved = gui.GuiNavigationEnabled, changed = false }
		gui.GuiNavigationEnabled = false
		created.watch = gui:GetPropertyChangedSignal("GuiNavigationEnabled"):Connect(function()
			if gui.GuiNavigationEnabled then
				created.changed = true
			end
		end)
		navigationHolds[gui] = created
		hold = created
	end
	local held = hold :: NavigationHold
	held.count += 1
	local released = false
	return function()
		if released then
			return
		end
		released = true
		held.count -= 1
		if held.count == 0 then
			navigationHolds[gui] = nil
			if held.watch then
				held.watch:Disconnect()
			end
			if not held.changed and gui.GuiNavigationEnabled == false then
				gui.GuiNavigationEnabled = held.saved
			end
		end
	end
end

return function<V>(
	ctx: Types.Context,
	surfaces: Navigation.Surfaces,
	menu: MenuTypes.Menu<V>,
	arrangement: ArrangementTypes.Arrangement<V>,
	paint: PaintTypes.Paint<V>,
	hub: HubTypes.Hub<V>
)
	local Compose, runtime, read = ctx.Compose, ctx.runtime, ctx.read
	local E, V2 = ctx.types.Enum, ctx.types.Vector2
	local spec, session, appearance, gestureSelection = menu.spec, menu.session, menu.appearance, menu.gestureSelection
	local opened, path, candidate, interacting = menu.opened, menu.path, menu.candidate, menu.interacting
	local naming, touchPoint, holding = menu.naming, menu.touchPoint, menu.holding
	local cancel, nativeActivate = menu.cancel, menu.nativeActivate
	local origin, center, layout, sectors, fallback =
		arrangement.origin, arrangement.center, arrangement.layout, arrangement.sectors, arrangement.fallback
	local buttons, focus, gui, panel = paint.buttons, paint.focus, paint.gui, paint.panel
	local function choose(sector: Radial.Sector<V>?): Radial.Sector<V>?
		if sector and read(sector.item.enabled) == false then
			sector = nil
		end
		candidate:set(if sector then sector.key else nil)
		return sector
	end
	local function beyond(position: Vector3): boolean
		local ring = layout:peek()
		local at = center:peek() + origin:peek()
		return not ring.list and V2.new(position.X - at.X, position.Y - at.Y).Magnitude > hub.reachOf(ring)
	end
	session.aimPointer = function(
		position: Vector3,
		dragging: boolean?,
		beginning: boolean?
	): (Radial.Sector<V> | false)?
		if fallback:peek() then
			return false
		end
		local at = center:peek() + origin:peek()
		local x, y = position.X - at.X, position.Y - at.Y
		local magnitude = math.sqrt(x * x + y * y)
		if
			beginning
			and spec.centerPassThrough
			and (spec.center == "empty" or spec.center == "content")
			and magnitude < layout:peek().inner
		then
			return false
		end
		if dragging and gestureSelection == "direction" then
			if magnitude < 26 then
				return choose(nil)
			end
			local entries = sectors:peek()
			local last = entries[#entries]
			if not last then
				return choose(nil)
			end
			local radius = (last.inner + last.outer) / 2
			x, y = x / magnitude * radius, y / magnitude * radius
		end
		return choose(
			geometry.hit(
				sectors:peek(),
				x,
				y,
				appearance,
				if dragging then 44 else nil,
				assert(session.candidateSector)()
			)
		)
	end
	session.aimAnalog = function(value: Vector2)
		if session.capture or not opened:peek() or not ctx.available(panel) then
			return
		end
		local magnitude = value.Magnitude
		if magnitude < 0.25 then
			session.analog = false
			interacting:set(false)
			candidate:set(nil)
			return
		end
		if magnitude < 0.35 and not session.analog then
			return
		end
		local entering = not session.analog
		if entering and session.freezeCenter then
			session.freezeCenter()
		end
		session.analog = true
		interacting:set(true)
		naming:set(true)
		if fallback:peek() then
			if entering then
				candidate:set(focus.move(if value.Y > 0 then "up" else "down"))
			end
		else
			local entries = sectors:peek()
			local last = entries[#entries]
			if not last then
				return
			end
			local radius = (last.inner + last.outer) / 2
			choose(
				geometry.hit(
					entries,
					value.X / magnitude * radius,
					-value.Y / magnitude * radius,
					"wedges",
					0,
					assert(session.candidateSector)()
				)
			)
		end
		local key = candidate:peek()
		if gui and key and buttons[key] then
			gui.SelectedObject = buttons[key]
		end
	end
	runtime.connect(panel, "InputBegan", function(input: InputObject)
		menu.beginPointer(input, true)
	end)
	local inputService = surfaces.service("UserInputService")
	runtime.connect(inputService or panel, "InputChanged", function(input: InputObject)
		if
			session.capture
			and (
				input == session.capture
				or (
					session.capture.UserInputType == E.UserInputType.MouseButton1
					and input.UserInputType == E.UserInputType.MouseMovement
				)
			)
		then
			if input.UserInputState == E.UserInputState.Cancel then
				cancel()
			else
				if
					session.launcherGesture
					and not naming:peek()
					and session.heldAt
					and (input.Position - session.heldAt).Magnitude < 14
				then
					return
				end
				if session.capture.UserInputType == E.UserInputType.Touch then
					touchPoint:set(input.Position)
				end
				if session.heldAt and (input.Position - session.heldAt).Magnitude > 14 then
					holding:pause()
					if session.inspectedUntil == math.huge then
						session.inspectedUntil = nil
					end
				end
				naming:set(true)
				assert(session.aimPointer)(input.Position, true)
			end
		end
	end)
	runtime.connect(inputService or panel, "InputEnded", function(input: InputObject)
		if
			session.capture
			and (
				input == session.capture
				or (
					session.capture.UserInputType == E.UserInputType.MouseButton1
					and input.UserInputType == E.UserInputType.MouseButton1
				)
			)
		then
			if input.UserInputState == E.UserInputState.Cancel then
				cancel()
				return
			end
			local still = session.pressedAt and (input.Position - session.pressedAt).Magnitude < 8
			local outside = still and beyond(session.pressedAt :: Vector3) and beyond(input.Position)
			local launcherTap = session.launcherGesture
				and session.heldAt
				and (input.Position - session.heldAt).Magnitude < 14
			local sector = if outside or launcherTap then nil else assert(session.aimPointer)(input.Position, true)
			cancel()
			if outside then
				menu.close()
			elseif type(sector) == "table" then
				nativeActivate(sector, input, "gesture")
			end
		end
	end)
	session.returnSelection = function(change: () -> (), key: string?)
		local held = gui ~= nil and surfaces.within(gui.SelectedObject, panel)
		change()
		local button = buttons[key or (if held then focus.first() else nil) or ""]
		if held and gui and button and button.Parent then
			gui.SelectedObject = button
		end
	end
	Compose.cleanup(function()
		cancel()
		session.aimPointer, session.aimAnalog, session.candidateSector, session.freezeCenter, session.returnSelection =
			nil, nil, nil, nil, nil
	end)

	if gui then
		local release: (() -> ())? = nil
		local function let()
			if release then
				release()
				release = nil
			end
		end
		Compose.watch(function(use: ComposeTypes.Use)
			if use(opened) and release == nil then
				release = holdNavigation(gui)
			elseif not use(opened) then
				let()
			end
		end)
		Compose.cleanup(let)
	end
	Compose.watch(function(use: ComposeTypes.Use)
		local entries = use(sectors)
		local validPath = use(layout).path
		if #validPath < #path:peek() then
			menu.jump(validPath)
		end
		local wanted, found = candidate:peek(), false
		for _, sector in entries do
			if sector.key == wanted and read(sector.item.enabled, use) ~= false then
				found = true
			end
		end
		if wanted and not found then
			candidate:set(nil)
		end
	end)
	if ctx.action then
		ctx.action(
			panel,
			"RadialAim",
			{ "Thumbstick1" },
			opened,
			function() end,
			{ priority = 2200, group = "Radial", direction2D = session.aimAnalog }
		)
		ctx.action(panel, "RadialCommit", { "ButtonA", "Return" }, function(use: ComposeTypes.Use)
			return use(opened) and use(candidate) ~= nil
		end, function()
			local selected = assert(session.candidateSector)()
			nativeActivate(selected, nil, "action")
		end, { priority = 2200, group = "Radial" })
		local directionalKeys: { [ComposeTypes.FocusDirection]: { Types.ActionBinding } } = {
			left = { "Left", "DPadLeft" },
			right = { "Right", "DPadRight" },
			up = { "Up", "DPadUp" },
			down = { "Down", "DPadDown" },
		}
		local toward: { [string]: Vector2 } = {
			left = V2.new(-1, 0),
			right = V2.new(1, 0),
			up = V2.new(0, -1),
			down = V2.new(0, 1),
		}
		local function ringStep(direction: string): (string?, boolean)
			local d = toward[direction]
			local entries = {}
			for _, sector in sectors:peek() do
				if read(sector.item.enabled) ~= false then
					table.insert(entries, sector)
				end
			end
			local function aligned(v: Vector2): number
				return if v.Magnitude > 0 then v.Unit:Dot(d) else -1
			end
			local current: Radial.Sector<V>? = nil
			for _, sector in entries do
				if sector.key == candidate:peek() then
					current = sector
				end
			end
			if current == nil then
				local best, bestKey = 0, nil
				for _, sector in entries do
					local score = aligned(V2.new(sector.x, sector.y))
					if score > best then
						best, bestKey = score, sector.key
					end
				end
				return bestKey, false
			end
			local here = V2.new(current.x, current.y)
			if read(hub.showCenter) and aligned(-here) >= math.cos(math.rad(45)) then
				return nil, true
			end
			table.sort(entries, function(a, b)
				return math.atan2(a.x, -a.y) < math.atan2(b.x, -b.y)
			end)
			local at = table.find(entries, current) :: number
			local best, bestKey = 0, nil
			for _, step in { -1, 1 } do
				local neighbour = entries[(at - 1 + step) % #entries + 1]
				if neighbour ~= current then
					local score = aligned(V2.new(neighbour.x, neighbour.y) - here)
					if score > best then
						best, bestKey = score, neighbour.key
					end
				end
			end
			return bestKey, false
		end
		for direction, keys in directionalKeys do
			ctx.action(panel, "Radial-" .. direction, keys, opened, function()
				session.analog = false
				interacting:set(false)
				if fallback:peek() then
					local key = focus.move(direction :: ComposeTypes.FocusDirection)
					candidate:set(key)
					naming:set(true)
					if gui and key and buttons[key] then
						gui.SelectedObject = buttons[key]
					end
					return
				end
				local key, centre = ringStep(direction)
				if centre then
					candidate:set(nil)
					if gui then
						gui.SelectedObject = hub.centerNode
					end
					return
				end
				if key == nil then
					return
				end
				candidate:set(key)
				naming:set(true)
				if gui and buttons[key] then
					gui.SelectedObject = buttons[key]
				end
			end, { priority = 2200, capture = true, group = "Radial" })
		end
	end
end
]]></ProtectedString>
							<string name="ScriptGuid">{F7FAEE3A-4AE6-439A-BCD7-0127E92B8375}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">nav_radial_gestures</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc3890000048f</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="179">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local geometry = require("./nav_radial_geometry")
local Types = require("./types")
local Radial = require("./radial_types")
local RadialProps = require("./radial_props")
local ComposeTypes = require("../vendor/compose/core")
local MenuTypes = require("./nav_radial_menu")

export type Arrangement<V> = {
	viewport: ComposeTypes.Cell<Vector2>,
	origin: ComposeTypes.Cell<Vector2>,
	launcher: Instance?,
	anchorSize: ComposeTypes.Cell<Vector2>?,
	centerTarget: ComposeTypes.Cell<Vector2>,
	following: ComposeTypes.Cell<boolean>,
	center: ComposeTypes.Formula<Vector2>,
	captionPadding: (use: ComposeTypes.Use) -> number,
	wordWidths: ComposeTypes.Cell<{ [string]: number }>,
	layout: ComposeTypes.Formula<Radial.Layout<V>>,
	sectors: ComposeTypes.Formula<{ Radial.Sector<V> }>,
	fallback: ComposeTypes.Formula<boolean>,
}

return function<V>(ctx: Types.Context, menu: MenuTypes.Menu<V>, root: Frame): Arrangement<V>
	local Compose, runtime, read = ctx.Compose, ctx.runtime, ctx.read
	local typeOf: (unknown) -> string = runtime.host.typeNameOf or typeof
	local V2 = ctx.types.Vector2
	local spec: RadialProps.RadialMenuSpec<V> = menu.spec
	local session = menu.session
	local corner: boolean = menu.corner
	local ringWidth: (use: ComposeTypes.Use?) -> number? = menu.ringWidth
	local follow: string = menu.follow
	local reduced: (use: ComposeTypes.Use?) -> boolean = menu.reduced
	local glyphOnly: (item: Radial.RadialItemBase<V>) -> boolean = menu.glyphOnly
	local appearance: string = menu.appearance
	local contentFit: Radial.ContentFit = menu.contentFit
	local gestureSelection: string = menu.gestureSelection
	local interacting: ComposeTypes.Cell<boolean> = menu.interacting
	local path: ComposeTypes.Cell<{ string }> = menu.path
	local candidate: ComposeTypes.Cell<string?> = menu.candidate
	local layer = ctx.config.overlayParent :: GuiBase2d?
		or root:FindFirstAncestorWhichIsA("LayerCollector") :: GuiBase2d?
	local measured = layer ~= nil and layer.AbsoluteSize.X > 0 and layer.AbsoluteSize.Y > 0
	local viewport = Compose.cell(if measured then (layer :: GuiBase2d).AbsoluteSize else V2.new(640, 480))
	local origin = Compose.cell(if measured then (layer :: GuiBase2d).AbsolutePosition else V2.zero)
	local anchor = read(spec.anchor)
	local launcher = if anchor == nil then root:FindFirstChild("Launcher") else nil
	local focal = anchor or launcher
	local nativeAnchor = focal and (typeof(focal) == "Instance" or (type(focal) == "table" and focal.IsA))
	local anchorPosition = if nativeAnchor then ctx.observe.AbsolutePosition(focal :: GuiObject) else nil
	local anchorSize = if nativeAnchor then ctx.observe.AbsoluteSize(focal :: GuiObject) else nil
	if nativeAnchor and anchorPosition and anchorSize then
		anchorPosition:set((focal :: GuiObject).AbsolutePosition)
		anchorSize:set((focal :: GuiObject).AbsoluteSize)
	end
	local shelves: { { position: ComposeTypes.Readable<Vector2>, size: ComposeTypes.Readable<Vector2> } } = {}
	local shelf = if nativeAnchor and not corner then (focal :: Instance).Parent else nil
	while shelf and shelf ~= layer and shelf:IsA("GuiObject") do
		table.insert(shelves, {
			position = ctx.observe.AbsolutePosition(shelf :: GuiObject),
			size = ctx.observe.AbsoluteSize(shelf :: GuiObject),
		})
		shelf = shelf.Parent
	end
	local rawInner = Compose.formula(function(use: ComposeTypes.Use): number
		local inner =
			math.max(24, if type(read(spec.clearance, use)) == "number" then read(spec.clearance, use) else 40)
		local focal = read(spec.anchor, use)
		if typeOf(focal) ~= "Instance" and type(focal) == "table" and type(focal.clearance) == "number" then
			inner = math.max(inner, focal.clearance)
		end
		if anchorSize then
			local extent = use(anchorSize)
			inner = math.max(inner, math.max(extent.X, extent.Y) / 2)
		end
		return inner
	end)
	local rawCenter = Compose.formula(function(use: ComposeTypes.Use)
		local size = use(viewport)
		local live = read(spec.anchor, use)
		local preset = spec.preset or "donut"
		local at = V2.new(
			if string.find(preset, "left") then 16 elseif string.find(preset, "right") then size.X - 16 else size.X / 2,
			if string.find(preset, "top") then 16 elseif string.find(preset, "bottom") then size.Y - 16 else size.Y / 2
		)
		if anchorPosition and anchorSize and (launcher == nil or use(anchorSize).X > 0) then
			at = use(anchorPosition) + use(anchorSize) / 2 - use(origin)
		elseif live and live.x and live.y then
			at = V2.new(live.x, live.y) - use(origin)
		end
		local _, sweep = geometry.arc(preset)
		if sweep < 360 then
			return at
		end
		local reach = use(rawInner) + (ringWidth(use) or 44)
		return V2.new(
			math.clamp(at.X, reach + 12, math.max(reach + 12, size.X - reach - 12)),
			math.clamp(at.Y, reach + 20, math.max(reach + 20, size.Y - reach - 20))
		)
	end)
	local centerTarget = Compose.cell(rawCenter:peek())
	local innerTarget = Compose.cell(rawInner:peek())
	Compose.watch(function(use: ComposeTypes.Use)
		local at, inner = use(rawCenter), use(rawInner)
		if follow ~= "fixed" and (follow == "always" or not use(interacting)) then
			centerTarget:set(at)
			innerTarget:set(inner)
		end
	end)
	local frozenCenter = Compose.cell(centerTarget:peek())
	local centerSpring = ctx.motionSpring("quick")
	local movingCenter = runtime.spring(function(use: ComposeTypes.Use)
		return use(centerTarget)
	end, { period = centerSpring.period, damping = centerSpring.damping })
	local following = Compose.cell(false)
	local center = Compose.formula(function(use: ComposeTypes.Use)
		if use(interacting) and follow ~= "always" then
			return use(frozenCenter)
		end
		return if reduced(use) or not use(following) then use(centerTarget) else use(movingCenter)
	end)
	session.freezeCenter = function()
		frozenCenter:set(center:peek())
	end
	local function captionPadding(use: ComposeTypes.Use): number
		local package = read(ctx.config.theme, use)
		local skin = package and package.chrome and package.chrome.control
		local insets = skin and skin.contentInsets
		return 2 * ctx.controlSize(nil, "paddingX", use)
			+ (if insets then insets.left or 0 else 0)
			+ (if insets then insets.right or 0 else 0)
	end

	local wordWidths: ComposeTypes.Cell<{ [string]: number }> = Compose.cell({})
	local function solve(use: ComposeTypes.Use, flatten: boolean): Radial.Layout<V>
		local size, at, inner = use(viewport), use(centerTarget), use(innerTarget)
		local start, sweep = geometry.arc(spec.preset or "donut")
		local room = if sweep == 360
			then math.min(at.X - 12, size.X - at.X - 12, at.Y - 20, size.Y - at.Y - 20)
			else math.min(size.X - 28, size.Y - 28)
		local minimum = ctx.metric("targetSizes.minimum", use)
		for _, space in shelves do
			local position, extent = use(space.position) - use(origin), use(space.size)
			local fit = math.min(
				at.X - position.X,
				position.X + extent.X - at.X,
				at.Y - position.Y,
				position.Y + extent.Y - at.Y
			)
			if fit >= inner + minimum then
				room = math.min(room, fit)
				break
			end
		end
		local radius = math.max(inner + 1, math.min(240, room))
		local band = math.max(minimum, radius - inner)
		local floor = math.min(band, math.max(minimum, ringWidth(use) or 0))
		local items = read(spec.items, use)
		local prefix: { string } = {}
		local levels: { { Radial.Sector<V> } } = {}
		local ring = inner
		local padding = ctx.metric("space.s", use)
		local textSize = ctx.metric("typography.control.size", use)
		local iconSize = ctx.controlSize(nil, "iconSize", use)
		local function estimate(item: Radial.RadialItemBase<V>): (number, number)
			if glyphOnly(item) then
				return iconSize, iconSize
			end
			local label = read(item.label, use) or ""
			return (utf8.len(label) or #label) * textSize * 0.6 + captionPadding(use), textSize
		end
		local navigation, expansion = spec.navigation or "replace", spec.expansion or "fan"
		local currentStart, currentSweep = start, sweep
		local replaced = 0
		local function append(): { Radial.Sector<V> }
			local shown: { Radial.RadialItem<V> } = {}
			local seen: { [string]: boolean } = {}
			for _, item in items do
				assert(type(item.id) == "string" and not seen[item.id], "RadialMenu items require unique ids per level")
				seen[item.id] = true
				assert(not (item.checked and item.selected), "RadialMenu state items require checked or selected")
				assert(
					not ((item.checked or item.selected) and (item.children or item.onSelect)),
					"RadialMenu state items use onChange"
				)
				if read(item.hidden, use) ~= true then
					table.insert(shown, item)
				end
			end
			if spec.center and spec.center ~= "back" and not corner and #prefix == #use(path) then
				local navigationItem: Radial.RadialItemBase<V> & { checked: nil?, selected: nil?, value: nil?, onChange: nil? } =
					{
						id = "$navigation",
						label = if #prefix > 0 then "Back" else "Close",
						icon = if #prefix > 0 then "chevron.leading" else "close",
						labelStyle = "icon" :: "icon",
					}
				if #prefix == 0 and spec.distribution == "compass" then
					local slots: { [string]: boolean } = {}
					for _, item in shown do
						if item.slot then
							slots[item.slot] = true
						end
					end
					local compassSlots: { Radial.CompassSlot } = { "SW", "S", "SE", "NW", "W", "E", "NE", "N" }
					for _, slot in compassSlots do
						if not slots[slot] then
							navigationItem.slot = slot :: Radial.CompassSlot
							break
						end
					end
					if navigationItem.slot then
						table.insert(shown, navigationItem)
					end
				else
					table.insert(shown, navigationItem)
				end
			end
			local ri = ring
			local distribution = if #prefix == 0 then spec.distribution or "even" else "even"
			local levelStart = currentStart
			local last = shown[#shown]
			if last and last.id == "$navigation" and distribution == "even" and currentSweep == 360 then
				levelStart = 225 - (#shown - 1) * 360 / #shown
			end
			local levelBand = band
			do
				local extent, target = 0, 0
				for _, probe in geometry.sectors(shown, levelStart, currentSweep, distribution, ri, ri + 1) do
					local width, height = estimate((probe.item :: unknown) :: Radial.RadialItemBase<V>)
					local ux, uy = math.sin(math.rad(probe.angle)), -math.cos(math.rad(probe.angle))
					local hw, hh = width / 2 + padding, height / 2 + padding
					local middle = ri + math.abs(hw * ux) + math.abs(hh * uy)
					for _, dx in { -hw, hw } do
						for _, dy in { -hh, hh } do
							local x, y = middle * ux + dx, middle * uy + dy
							extent = math.max(extent, math.sqrt(x * x + y * y) - ri)
						end
					end
					local chord = 2 * math.sin(math.rad(math.min(probe.span, 180) / 2)) * 0.86
					target = math.max(target, 2 * (math.max(minimum, width, height) / chord - ri))
				end
				local wanted = 2 * math.ceil(math.max(extent, target) / 2)
				levelBand = math.clamp(math.max(wanted, replaced), floor, band)
			end
			ring = ri + levelBand + 4
			local sectors = geometry.sectors(shown, levelStart, currentSweep, distribution, ri, ri + levelBand)
			for _, sector in sectors do
				sector.path = table.clone(prefix)
				sector.key = table.concat(prefix, "/") .. "/" .. sector.id
			end
			table.insert(levels, sectors)
			return sectors
		end
		local current = append()
		for _, id in use(path) do
			local parent: Radial.Sector<V>?
			for sectorIndex = 1, #current do
				local sector = current[sectorIndex]
				if sector.id == id and read(sector.item.enabled, use) ~= false then
					parent = sector
					break
				end
			end
			if not parent or not parent.item.children then
				break
			end
			navigation = if flatten then "replace" else parent.item.navigation or navigation
			expansion = parent.item.expansion or expansion
			table.insert(prefix, id)
			items = read(parent.item.children, use)
			replaced = if navigation == "replace" then parent.outer - parent.inner else 0
			if navigation == "replace" then
				levels, ring = {}, inner
				currentStart, currentSweep = start, sweep
			elseif expansion == "fan" then
				currentSweep = math.min(sweep, math.max(parent.span, #items * 32))
				currentStart = parent.angle - currentSweep / 2
				if sweep < 360 then
					currentStart = math.clamp(currentStart, start, start + sweep - currentSweep)
				end
			else
				currentStart, currentSweep = start, sweep
			end
			current = append()
		end
		local result: { Radial.Sector<V> } = {}
		local list = room < inner + band or band < minimum
		for levelIndex = 1, #levels do
			local level = levels[levelIndex]
			for sectorIndex = 1, #level do
				local sector = level[sectorIndex]
				list = list or sector.size < 44 or sector.outer > room
				if
					appearance == "wedges"
					and not sector.item.icon
					and not glyphOnly(sector.item)
					and contentFit ~= "none"
				then
					local width, height = estimate(sector.item)
					local bounds = geometry.labelBounds(sector, height)
					local captionReady = (use(wordWidths)[sector.key] or 0) > 0
					list = list or room - inner < width or (captionReady and (bounds.w < width or bounds.h < height))
				end
				table.insert(result, sector)
			end
		end
		list = list and gestureSelection ~= "direction"
		if list then
			result = {}
			for _, sector in current do
				if sector.id ~= "$navigation" then
					table.insert(result, sector)
				end
			end
		end
		for index, sector in result do
			sector.index, sector.list = index, list
		end
		return { sectors = result, list = list, inner = inner, path = prefix }
	end
	local layout = Compose.formula(function(use: ComposeTypes.Use): Radial.Layout<V>
		local stacked = solve(use, false)
		if not stacked.list or #use(path) == 0 then
			return stacked
		end
		local flat = solve(use, true)
		return if flat.list then stacked else flat
	end)
	local sectors = Compose.formula(function(use: ComposeTypes.Use)
		return use(layout).sectors
	end)
	local fallback = Compose.formula(function(use: ComposeTypes.Use)
		return use(layout).list
	end)
	session.candidateSector = function()
		local entries = sectors:peek()
		for sectorIndex = 1, #entries do
			local sector = entries[sectorIndex]
			if sector.key == candidate:peek() then
				return sector
			end
		end
		return nil
	end
	return {
		viewport = viewport,
		origin = origin,
		launcher = launcher,
		anchorSize = anchorSize,
		centerTarget = centerTarget,
		following = following,
		center = center,
		captionPadding = captionPadding,
		wordWidths = wordWidths,
		layout = layout,
		sectors = sectors,
		fallback = fallback,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{A48332A1-2C98-4BCE-89A8-A0A1215FF4BC}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">nav_radial_layout</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc38900000490</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="180">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local reducedMotion = require("./motion").reduced
local geometry = require("./nav_radial_geometry")
local adaptive = require("./adaptive")
local Types = require("./types")
local Radial = require("./radial_types")
local Navigation = require("./navigation_types")
local ControlTypes = require("./control_types")
local RadialProps = require("./radial_props")
local ComposeTypes = require("../vendor/compose/core")

local HOLD = 0.4

export type Controls = ControlTypes.BuilderControls
export type Session<V> = {
	branchOrigin: { path: string, shape: Radial.SectorShape }?,
	capture: InputObject?,
	pressedAt: Vector3?,
	heldAt: Vector3?,
	inspectedUntil: number?,
	analog: boolean,
	held: boolean,
	suppressedInput: InputObject?,
	suppressedUntil: number?,
	suppressedKey: string?,
	suppressedSource: string?,
	openedByLauncher: boolean,
	launcherGesture: boolean,
	aimPointer: ((Vector3, boolean?, boolean?) -> Radial.Sector<V>? | false)?,
	aimAnalog: ((Vector2) -> ())?,
	candidateSector: (() -> Radial.Sector<V>?)?,
	freezeCenter: (() -> ())?,
	returnSelection: ((() -> (), string?) -> ())?,
}
export type Menu<V> = {
	spec: RadialProps.RadialMenuSpec<V>,
	session: Session<V>,
	preferred: ComposeTypes.Cell<Enum.PreferredInput>?,
	painted: (use: ComposeTypes.Use?) -> number,
	appearance: string,
	glyphOnly: (item: Radial.RadialItemBase<V>) -> boolean,
	follow: string,
	gestureSelection: string,
	contentFit: Radial.ContentFit,
	scrim: string,
	corner: boolean,
	ringWidth: (use: ComposeTypes.Use?) -> number?,
	reduced: (use: ComposeTypes.Use?) -> boolean,
	opened: ComposeTypes.Cell<boolean>,
	path: ComposeTypes.Cell<{ string }>,
	candidate: ComposeTypes.Cell<string?>,
	interacting: ComposeTypes.Cell<boolean>,
	naming: ComposeTypes.Cell<boolean>,
	touchPoint: ComposeTypes.Cell<Vector3?>,
	holding: Types.Playback,
	jump: (entries: { string }) -> (),
	cancel: () -> (),
	close: () -> (),
	open: () -> (),
	back: () -> (),
	nativeActivate: (sector: Radial.Sector<V>?, input: InputObject?, source: string?) -> (),
	pointing: () -> boolean,
	isPointer: (input: InputObject) -> boolean,
	beginPointer: (input: InputObject, onPanel: boolean?, fromLauncher: boolean?) -> (),
	skin: (node: GuiObject, definition: Radial.SkinImages?, selected: Types.Value<boolean>?) -> (),
}

return function<V>(ctx: Types.Context, surfaces: Navigation.Surfaces, spec: RadialProps.RadialMenuSpec<V>): Menu<V>
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local typeOf: (unknown) -> string = runtime.host.typeNameOf or typeof
	local E, D2 = ctx.types.Enum, ctx.types.UDim2
	local input = surfaces.service("UserInputService")
	local preferred = if input and input.GetPropertyChangedSignal then ctx.observe.PreferredInput(input) else nil
	local distant = ctx.tenFoot()
	local function painted(use: ComposeTypes.Use?): number
		return if distant(use) then 32 * adaptive.TEN_FOOT_SCALE else 32
	end
	local function choice<T>(value: T?, fallback: T, choices: { T }, name: string): T
		local selected = if value == nil then fallback else value
		assert(table.find(choices, selected), "RadialMenu invalid " .. name)
		return selected
	end
	local appearance = choice(spec.appearance, "wedges", { "wedges", "buttons" }, "appearance")
	local function glyphOnly(item: Radial.RadialItemBase<V>): boolean
		local icon = item.icon ~= nil or (item.compactLabel ~= nil and item.compactLabel.icon ~= nil)
		return icon
			and (
				item.labelStyle == "icon"
				or (item.compactLabel ~= nil and item.compactLabel.prefer == true)
				or appearance == "buttons"
			)
	end
	local follow = choice(spec.follow, "idle", { "idle", "always", "fixed" }, "follow")
	local gestureSelection = choice(spec.gestureSelection, "bounded", { "bounded", "direction" }, "gestureSelection")
	local contentFit: Radial.ContentFit = spec.contentFit or "radial"
	choice(contentFit, "radial", { "both", "radial", "angular", "none" }, "contentFit")
	choice(spec.navigation, "replace", { "replace", "expand" }, "navigation")
	choice(spec.expansion, "fan", { "fan", "ring" }, "expansion")
	choice(spec.center, "back", { "back", "root", "close", "content", "empty" }, "center")
	choice(spec.completion, "close", { "close", "back", "root", "stay" }, "completion")
	choice(spec.buttonSurface, "native", { "native", "none" }, "buttonSurface")
	local scrim = choice(spec.scrim, "none", { "dark", "light", "none" }, "scrim")
	local _, presetSweep = geometry.arc(spec.preset or "donut")
	local corner = presetSweep < 360
	local function ringWidth(use: ComposeTypes.Use?): number?
		local width = read(spec.ringWidth, use)
		if width == nil or type(width) == "number" then
			return width
		end
		assert(
			width == "narrow" or width == "regular" or width == "wide",
			"RadialMenu ringWidth must be a number of pixels or narrow, regular or wide"
		)
		return ctx.metric("controls.radial." .. width, use)
	end
	local motionReduced = reducedMotion(ctx)
	local function reduced(use: ComposeTypes.Use?): boolean
		return spec.transition == false or motionReduced(use)
	end
	local function validate(
		items: { Radial.RadialItem<V> },
		use: ComposeTypes.Use,
		ancestors: { [{ Radial.RadialItem<V> }]: boolean }
	)
		assert(type(items) == "table" and not ancestors[items], "RadialMenu requires an acyclic item tree")
		ancestors[items] = true
		local ids: { [string]: boolean } = {}
		for _, item in items do
			assert(
				type(item.id) == "string" and item.id ~= "$navigation" and not ids[item.id],
				"RadialMenu requires unique nonreserved item ids"
			)
			ids[item.id] = true
			choice(item.completion, "close", { "stay", "back", "root", "close" }, "item completion")
			choice(item.navigation, "replace", { "replace", "expand" }, "item navigation")
			choice(item.expansion, "fan", { "fan", "ring" }, "item expansion")
			assert(not (item.children and item.onSelect), "RadialMenu items use children or onSelect")
			if item.children then
				validate(read(item.children, use), use, ancestors)
			end
		end
		ancestors[items] = nil
	end
	Compose.watch(function(use: ComposeTypes.Use)
		validate(read(spec.items, use), use, {})
	end)
	local opened: ComposeTypes.Cell<boolean> = spec.isPresented or Compose.cell(spec.launcher == false)
	local path: ComposeTypes.Cell<{ string }> = Compose.cell({})
	local candidate: ComposeTypes.Cell<string?> = Compose.cell(nil :: string?)
	local session: Session<V> = { analog = false, held = false, openedByLauncher = false, launcherGesture = false }
	local origins: { [string]: Radial.SectorShape } = {}
	local function jump(entries: { string })
		session.branchOrigin = nil
		path:set(entries)
	end
	Compose.watch(function(use: ComposeTypes.Use)
		if not use(opened) then
			session.branchOrigin = nil
		end
	end)
	local interacting = Compose.cell(false)
	local naming = Compose.cell(false)
	local touchPoint: ComposeTypes.Cell<Vector3?> = Compose.cell(nil :: Vector3?)
	local holding = runtime.timeline({ duration = HOLD, autoplay = false })
	local function cancel()
		if session.inspectedUntil == math.huge then
			session.inspectedUntil = os.clock() + 0.3
		end
		session.capture, session.analog, session.launcherGesture = nil, false, false
		interacting:set(false)
		naming:set(false)
		touchPoint:set(nil)
		holding:pause()
		candidate:set(nil)
	end
	Compose.watch(function(use: ComposeTypes.Use)
		if
			use(holding.completed)
			and session.capture
			and not session.launcherGesture
			and session.capture.UserInputType == E.UserInputType.Touch
