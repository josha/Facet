					<Item class="ModuleScript" referent="248">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local geometry = {}

function geometry.point(from: number, to: number, progress: number): number
	return from + (to - from) * progress
end

function geometry.arc(progress: number, height: number): number
	return -4 * height * progress * (1 - progress)
end

return geometry
]]></ProtectedString>
							<string name="ScriptGuid">{1188960D-38A0-421B-9266-9CFADD402DAF}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
