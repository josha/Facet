						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local createState = require("./collection_reorder_state")
local createPointer = require("./collection_reorder_pointer")
local createRow = require("./collection_reorder_row")
local registerDrop = require("./collection_reorder_drop")
local createFeedback = require("./collection_reorder_feedback")
local bindKeys = require("./collection_reorder_keys")
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local CollectionTypes = require("./collection_types")
export type Editor<V, K> = {
	placement: (K, ComposeTypes.Placement, ComposeTypes.Use) -> ComposeTypes.Placement,
	wrap: (GuiObject, ComposeTypes.Readable<V>, K, boolean?) -> Frame,
	overlay: (boolean?) -> Frame,
	leading: ComposeTypes.Readable<number>,
	trailing: ComposeTypes.Readable<number>,
	header: ComposeTypes.Readable<number>,
	press: (K, InputObject) -> (),
	mouseDown: (Vector2) -> (),
	finish: (InputObject) -> (),
	busy: () -> boolean,
	pickUp: (K, InputObject?) -> boolean,
	deleteSelected: (...unknown) -> (),
	canDeleteSelected: (ComposeTypes.Use?) -> boolean,
}
return function<V, K>(
	ctx: Types.Context,
	UI: ControlTypes.BuilderControls,
	spec: CollectionTypes.ReorderShape<V, K>,
	source: Types.Value<{ V }>,
	keyOf: (V, number) -> K,
	controls: ComposeTypes.OrderedCollectionControls<K>,
	bodyOf: () -> ScrollingFrame,
	selection: ComposeTypes.Cell<CollectionTypes.Selection<K>>,
	sort: ComposeTypes.Cell<CollectionTypes.Sort?>,
	editing: Types.ValueBoolean?,
	grid: boolean?,
	location: (({ K }, number) -> (boolean, number, K?))?,
	instantLayout: boolean?,
	reservedSlots: Types.Value<{ K }>?
): Editor<V, K>
	local read = ctx.read
	local E = ctx.types.Enum
	local shared = createState(
		ctx,
		UI,
		spec,
		source,
		keyOf,
		controls,
		bodyOf,
		selection,
		sort,
		editing,
		grid,
		location,
		instantLayout,
		reservedSlots
	)
	local moving = shared.moving
	local pointer = createPointer(shared)
	local wrap = createRow(shared, pointer)
	local function overlay(insideBody: boolean?): Frame
		local body = bodyOf()
		registerDrop(shared, body)
		local canvasAt, bodyAt = ctx.observe.CanvasPosition(body), ctx.observe.Position(body)
		pointer.listen(body)
		local root = createFeedback(shared, body, insideBody, canvasAt, bodyAt)
		bindKeys(shared, root, body)
		return root
	end
	return {
		placement = function(key: K, at: ComposeTypes.Placement, use: ComposeTypes.Use): ComposeTypes.Placement
			local move, proposal = use(moving), use(shared.incoming)
			local session = use(shared.drag.state)
			if session == nil or session.target ~= bodyOf() or session.accepted ~= true then
				return at
			end
			if move then
				local ordered = table.clone(move.remaining)
				for index, carried in move.keys do
					table.insert(ordered, move.slot + index, carried)
				end
				local index = table.find(ordered, key)
				if index and reservedSlots then
					local live: { [K]: boolean } = {}
					for row, item in read(source, use) do
						live[keyOf(item, row)] = true
					end
					local occupied = 0
					for slot, candidate in read(reservedSlots, use) do
						if live[candidate] then
							occupied += 1
							if occupied == index then
								return assert(controls.placementOf)(slot)
							end
						end
					end
				end
				return if index then assert(controls.placementOf)(index) else at
			end
			if proposal then
				local data = if type(session.payload) == "table" then session.payload :: { keys: { K }? } else nil
				local keys = if data then data.keys else nil
				if reservedSlots and keys and table.find(read(reservedSlots, use), keys[1]) then
					return at
				end
				local index = assert(controls.indexOfKey)(key)
				local before = proposal.beforeKey
				local start = if before ~= nil then assert(controls.indexOfKey)(before :: K) else nil
				if index and start and index >= start then
					return assert(controls.placementOf)(index + (if keys then math.max(1, #keys) else 1))
				end
			end
			return at
		end,
		pickUp = function(key: K, input: InputObject?): boolean
			if not spec.drag or input == nil or input.UserInputType == E.UserInputType.MouseButton1 then
				return false
			end
			if moving:peek() == nil then
				shared.begin(key, nil, nil, input.UserInputType == E.UserInputType.Touch)
			end
			return moving:peek() ~= nil
		end,
		wrap = wrap,
		overlay = overlay,
		leading = shared.leading,
		trailing = shared.trailing,
		header = shared.header,
		press = pointer.press,
		mouseDown = pointer.mouseDown,
		finish = pointer.finish,
		busy = function(): boolean
			return moving:peek() ~= nil
		end,
		deleteSelected = function()
			shared.remove(true)
		end,
		canDeleteSelected = shared.canDeleteSelected,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{9F301317-4EC0-4BBE-958A-1C7573279B3F}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">collection_reorder</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc389000003f0</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="20">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local DragTypes = require("./drag_types")
local Env = require("./environment_types")
local State = require("./collection_reorder_state")
return function<V, K>(shared: State.Reorder<V, K>, body: ScrollingFrame): ()
	local ctx, spec = shared.ctx, shared.spec
	local read = ctx.read
	local moving, incoming, drag = shared.moving, shared.incoming, shared.drag
	local source, controls, reservedSlots = shared.source, shared.controls, shared.reservedSlots
	local collectionId, sourceIndex, location = shared.collectionId, shared.sourceIndex, shared.location
	local horizontal, scaleOf, alongBody = shared.horizontal, shared.scaleOf, shared.alongBody
	local axis, crossAxis = shared.axis, shared.crossAxis
	local focus = shared.focus
	local destination = (if spec.drop then table.clone(spec.drop) else {}) :: DragTypes.TargetSpec
	local accept, drop, update = destination.accepts, destination.onDrop, destination.onUpdate
	if reservedSlots and destination.landing == nil then
		destination.landing = function(info: Env.DropInfo): Env.ScrollRect
			local session = drag.state:peek()
			local payload = if session then session.payload else nil
			local data = if type(payload) == "table" then payload :: { keys: { K }? } else nil
			local key = if data and data.keys then data.keys[1] else nil
			local index = if key ~= nil and table.find(read(reservedSlots), key)
				then assert(controls.indexOfKey)(key :: K)
				else nil
			if index == nil and info.insertion then
				local before = info.insertion.beforeKey
				index = if before ~= nil then assert(controls.indexOfKey)(before :: K) else nil
			end
			local at = assert(controls.placementOf)(index or (#read(reservedSlots) + 1))
			local scale = scaleOf(body)
			local items = body:FindFirstChild("Items") :: GuiObject?
			local origin = if items then items.AbsolutePosition else body.AbsolutePosition - body.CanvasPosition * scale
			return {
				x = origin.X + (if horizontal then at.offset else at.crossOffset) * scale,
				y = origin.Y + (if horizontal then at.crossOffset else at.offset) * scale,
				w = (if horizontal then at.size else at.crossSize) * scale,
				h = (if horizontal then at.crossSize else at.size) * scale,
			}
		end
	end
	local noCarried: { K } = {}
	local cachedRows: { V }? = nil
	local cachedCarried: { K }? = nil
	local remaining: { K } = {}
	local rowIndices: { number } = {}
	local remainingIndex: { [K]: number } = {}
	local function insertion(payload: unknown, info: DragTypes.Proposal)
		local rows: { V } = read(source)
		local data = payload :: { collection: unknown, keys: { K }? }
		local same = type(payload) == "table" and data.collection == collectionId and info.operation == "move"
		local carried = if same then data.keys or noCarried else noCarried
		if rows ~= cachedRows or carried ~= cachedCarried then
			cachedRows, cachedCarried = rows, carried
			remaining, rowIndices, remainingIndex = {}, {}, {}
			local included: { [K]: boolean } = {}
			for _, key in carried :: { K } do
				included[key] = true
			end
			for index, item in rows do
				local key = shared.keyOf(item, index)
				if not included[key] then
					table.insert(remaining, key)
					table.insert(rowIndices, assert(controls.indexOfKey)(key) or index)
					remainingIndex[key] = #remaining
				end
			end
		end
		local slot = 0
		local offset, across = math.huge, math.huge
		if info.position then
			offset = alongBody(body, info.position) + axis(body.CanvasPosition)
			across = crossAxis(info.position - body.AbsolutePosition) / scaleOf(body) + crossAxis(body.CanvasPosition)
		end
		local low, high = 1, #remaining
		while low <= high do
			local middle = math.floor((low + high) / 2)
			local at = assert(controls.placementOf)(rowIndices[middle])
			local crossed = if shared.grid
				then offset >= at.offset + at.size
					or (
						offset >= at.offset
						and offset < at.offset + at.size
						and across >= at.crossOffset + at.crossSize / 2
					)
				else offset >= at.offset + at.size / 2
			if crossed then
				slot, low = middle, middle + 1
			else
				high = middle - 1
			end
		end
		local move = moving:peek()
		if move and move.keyboard and same then
			slot = move.slot
		end
		if info.insertion then
			local before, after = info.insertion.beforeKey, info.insertion.afterKey
			local beforeIndex = if before ~= nil then remainingIndex[before :: K] else nil
			local afterIndex = if after ~= nil then remainingIndex[after :: K] else nil
			if (before ~= nil or after ~= nil) and beforeIndex == nil and afterIndex == nil then
				info.invalid = "The insertion neighbors were removed"
				return
			end
			slot = if beforeIndex then beforeIndex - 1 elseif afterIndex then afterIndex else 0
		end
		info.insertion =
			{ collection = collectionId, beforeKey = remaining[slot + 1], afterKey = remaining[slot], slot = slot }
	end
	local function localMove(payload: unknown, info: DragTypes.Proposal): boolean
		local data = payload :: { collection: unknown, keys: { K }? }
		if
			type(payload) ~= "table"
			or data.collection ~= collectionId
			or not spec.onReorder
			or info.operation ~= "move"
		then
			return false
		end
		if type(data.keys) ~= "table" or #(data.keys :: { K }) == 0 then
			return false
		end
		local live = sourceIndex:peek()
		for _, key in data.keys :: { K } do
			if live[key] == nil then
				return false
			end
		end
		return true
	end
	destination.propose = insertion
	destination.accepts = function(payload: unknown, info: DragTypes.Proposal): (boolean, string?)
		if info.invalid then
			return false, info.invalid
		end
		if read(shared.sort) ~= nil then
			return false, "Clear sorting before inserting items"
		end
		if localMove(payload, info) then
			if location then
				local accepted = location((payload :: { keys: { K } }).keys, (info.insertion :: Env.DropInsertion).slot)
				return accepted, if accepted then nil else "Move items within the same folder"
			end
			return true, nil
		end
		if accept then
			return accept(payload, info)
		end
		return drop ~= nil, "This collection does not accept these items"
	end
	destination.onDrop = function(payload: unknown, info: DragTypes.Proposal): (boolean | "pending")?
		if localMove(payload, info) then
			shared.commitLocal((payload :: { keys: { K } }).keys, (info.insertion :: Env.DropInsertion).slot)
			return true
		end
		return if drop
			then ((drop :: unknown) :: (unknown, Env.DropInfo) -> (boolean | "pending")?)(payload, info)
			else false
	end
	local leave = destination.onLeave
	destination.onLeave = function(payload)
		incoming:set(nil)
		if leave then
			leave(payload)
		end
	end
	destination.onUpdate = function(payload, info, accepted, reason)
		local session = drag.state:peek()
		incoming:set(if accepted and session and session.source ~= body then info.insertion else nil)
		local move = moving:peek()
		if move and not move.keyboard and accepted and move.slot ~= (info.insertion :: Env.DropInsertion).slot then
			local next = table.clone(move)
			next.slot = (info.insertion :: Env.DropInsertion).slot
			moving:set(next)
		end
		if update then
			update(payload, info, accepted, reason)
		end
	end
	destination.autoscroll = spec.autoscroll
	destination.scroll = function(position: Vector2, delta: number): boolean
		local scale = scaleOf(body)
		local size = axis(body.AbsoluteWindowSize) / scale
		local edge = math.min(40, size / 4)
		local at = alongBody(body, position)
		local speed = if edge <= 0
				or at < 0
				or at > size
			then 0
			elseif at < edge then -(edge - at) / edge
			elseif at > size - edge then (at - size + edge) / edge
			else 0
		local rows = read(source)
		local last = if #rows > 0 then assert(controls.placementOf)(#rows) else nil
		local limit = if last then math.max(0, last.offset + last.size - size) else 0
		local now = axis(body.CanvasPosition)
		local next = math.clamp(now + speed * 600 * delta, 0, limit)
		if next == now then
			return false
		end
		shared.canvasOffset(body, next)
		if moving:peek() then
			shared.movePointer(position)
		end
		return true
	end
	if spec.drop or spec.onReorder then
		destination.feedback = false
		drag.register(body, destination)
	end
	drag.own(body)
	ctx.Compose.watch(function(use)
		local node = use(focus)
		local session = drag.state:peek()
		if session and session.source == body and session.mode == "armed" then
			drag.hover(drag.targetOf(node), nil)
		end
	end)
end
]]></ProtectedString>
							<string name="ScriptGuid">{D18967D1-D136-4A0F-AC1C-6A75EC76A7CA}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">collection_reorder_drop</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">1f5f3983a820f33d0aedc389000003f1</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="21">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local ComposeTypes = require("../vendor/compose/core")
local Types = require("./types")
local EngineTypes = require("./engine_types")
local InputProps = require("./input_props")
local State = require("./collection_reorder_state")
local STACK = 6
local FEEDBACK_Z = 1000
return function<V, K>(
	shared: State.Reorder<V, K>,
	body: ScrollingFrame,
	insideBody: boolean?,
	canvasAt: ComposeTypes.Cell<Vector2>,
	bodyAt: ComposeTypes.Cell<UDim2>
): Frame
	local ctx, spec, gesture = shared.ctx, shared.spec, shared.gesture
	local Compose, Host = ctx.Compose, ctx.Host
	local read = ctx.read
	local D2, V2 = ctx.types.UDim2, ctx.types.Vector2
	local moving, incoming, choosingDestination, drag =
		shared.moving, shared.incoming, shared.choosingDestination, shared.drag
	local source, controls, rowNodes = shared.source, shared.controls, shared.rowNodes
	local grid, horizontal, scaleOf = shared.grid, shared.horizontal, shared.scaleOf
	local axis, crossAxis = shared.axis, shared.crossAxis
	local function dragImage(dropY: (ComposeTypes.Use) -> number): (Frame, number, UDim2)
		local move = assert(moving:peek())
		local source = rowNodes[move.key]
		local index = assert(controls.indexOfKey)(move.key)
		local placement = if index then assert(controls.placementOf)(index) else nil
		local extent = if placement then placement.size else 0
		local nativeSize = if source then source.AbsoluteSize / scaleOf(body) else V2.zero
		local crossSize = if crossAxis(nativeSize) > 0
			then crossAxis(nativeSize)
			elseif placement then placement.crossSize
			else 0
		local previewKeys = { move.key }
		for _, key in move.keys do
			if key ~= move.key then
				table.insert(previewKeys, key)
			end
		end
		local layers = math.min(3, #move.keys)
		local stack = STACK * (layers - 1)
		local function sized(inset: number): UDim2
			return if grid
				then (if horizontal then D2.fromOffset(extent, crossSize) else D2.fromOffset(crossSize, extent))
				elseif horizontal then D2.new(0, extent, 1, -inset)
				else D2.new(1, -inset, 0, extent)
		end
		local imageProps: Types.FrameProps = {
			Name = "DragImage",
			ZIndex = FEEDBACK_Z + 1,
			BackgroundTransparency = 1,
			Interactable = false,
			Size = if grid
				then (if horizontal
					then D2.fromOffset(extent + stack, crossSize + stack)
					else D2.fromOffset(crossSize + stack, extent + stack))
				elseif horizontal then D2.new(0, extent + stack, 1, 0)
				else D2.new(1, 0, 0, extent + stack),
			Position = function(use: ComposeTypes.Use)
				local live = use(moving)
				local base = if horizontal then use(bodyAt).X.Offset else use(bodyAt).Y.Offset
				local window = axis(body.AbsoluteWindowSize) / scaleOf(body)
				local along = if live and live.pointer
					then math.clamp(
						shared.alongBody(body, live.pointer) + base - extent / 2,
						base,
						math.max(base, base + window - extent - stack)
					)
					else dropY(use)
				local across = 0
				if grid then
					local pointer = if live and live.pointer
						then crossAxis(live.pointer - body.AbsolutePosition) / scaleOf(body) - crossSize / 2
						else (if placement then placement.crossOffset else 0)
					if live and live.keyboard then
						local candidate = live.remaining[live.slot + 1]
						local index = if candidate then assert(controls.indexOfKey)(candidate) else #live.rows
						local at = assert(controls.placementOf)(index or 1)
						pointer = at.crossOffset + (if candidate then 0 else at.crossSize) - crossAxis(use(canvasAt))
					end
					across = math.clamp(
						pointer,
						0,
						math.max(0, crossAxis(body.AbsoluteWindowSize) / scaleOf(body) - crossSize - stack)
					)
				end
				return if horizontal then D2.fromOffset(along, across) else D2.fromOffset(across, along)
			end,
			ctx.styled(
				ctx.text({
					Name = "DragLabel",
					ZIndex = FEEDBACK_Z + 2,
					BackgroundTransparency = 0,
					AnchorPoint = V2.new(1, 0),
					Position = D2.fromScale(1, 0),
					Visible = #move.keys > 1,
					Text = function(use: ComposeTypes.Use)
						local live = use(moving)
						if live == nil then
							return ""
						end
						if #live.keys > 1 then
							return tostring(#live.keys) .. " selected"
						end
						local index = assert(controls.indexOfKey)(live.key)
						return if spec.dragLabel and index then spec.dragLabel(live.rows[index]) else tostring(live.key)
					end,
				}),
				"badge"
			),
		}
		local image = Host.Frame(imageProps)
		local top = FEEDBACK_Z + 1
		for layer = layers, 1, -1 do
			local original = rowNodes[previewKeys[layer]] or source
			local parent = if original then original.Parent else nil
			local painted: GuiObject? = if layer == 1 and move.preview
				then move.preview
				elseif parent and parent:IsA("Frame") and parent:HasTag("facet-tablerow") then parent
				else original
			local copy = if painted then painted:Clone() else nil
			if copy then
				local cells = copy:FindFirstChild("Cells", true)
				if cells and cells:IsA("GuiObject") then
					cells.Visible = true
				end
				local row = if copy.Name == "Reorderable" then copy else copy:FindFirstChild("Reorderable", true)
				if row then
					for _, name in { "Move", "SelectMark", "Minus", "Confirm" } do
						local control = row:FindFirstChild(name)
						if control and control:IsA("GuiObject") then
							control.Visible = false
						end
					end
				end
				for _, node in copy:GetDescendants() do
					if node:GetAttribute("FacetDragExclude") == true then
						node:Destroy()
					end
				end
				local nodes = copy:GetDescendants()
				table.insert(nodes, copy)
				local base = top
				for _, node in nodes do
					local rest = node:GetAttribute("FacetDragRestX")
					if type(rest) == "number" and node:IsA("GuiObject") then
						node.Position =
							D2.new(node.Position.X.Scale, rest, node.Position.Y.Scale, node.Position.Y.Offset)
					end
					if node:IsA("GuiObject") then
						node.Interactable, node.Active, node.Selectable = false, false, false
						node.ZIndex += base
						top = math.max(top, node.ZIndex)
					elseif node:IsA("Path2D") then
						node.ZIndex += base
						top = math.max(top, node.ZIndex)
					elseif node:IsA("UIDragDetector") or node:IsA("InputContext") then
						((node :: unknown) :: { Enabled: boolean }).Enabled = false
					end
				end
				copy.Name = "Reorderable"
				copy.AnchorPoint = V2.zero
				copy.Position = D2.fromOffset(STACK * (layer - 1), STACK * (layer - 1))
				copy.Size = sized(stack)
				copy.ZIndex = base + 1
				copy.Parent = image
			end
		end
		(image:FindFirstChild("DragLabel") :: GuiObject).ZIndex = top + 1
		return image, top + 2, sized(stack)
	end
	local rootProps: Types.FrameProps = {
		Name = "ReorderFeedback",
		ZIndex = FEEDBACK_Z,
		Position = function(use: ComposeTypes.Use)
			return if insideBody then D2.fromOffset(use(canvasAt).X, use(canvasAt).Y) else D2.fromOffset(0, 0)
		end,
		Size = D2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Attributes = { FacetDragFeedback = true } :: EngineTypes.Attributes,
		Compose.show(function(use)
			return use(incoming) ~= nil
		end, function()
			local function placement(use: ComposeTypes.Use)
				local proposal = use(incoming)
				local rows = read(source, use)
				if #rows == 0 then
					return { offset = 0, size = 44, crossOffset = 0, crossSize = 44 }, true
				end
				local key = proposal and proposal.beforeKey
				local index = if key ~= nil then assert(controls.indexOfKey)(key :: K) else #rows
				return assert(controls.placementOf)(index or #rows), key ~= nil
			end
			return ctx.styled(
				Host.Frame {
					Name = "InsertionLine",
					BorderSizePixel = 0,
					ZIndex = FEEDBACK_Z,
					Size = function(use: ComposeTypes.Use)
						local at = placement(use)
						return if grid
							then (if horizontal then D2.fromOffset(at.size, 2) else D2.fromOffset(2, at.size))
							elseif horizontal then D2.new(0, 2, 1, 0)
							else D2.new(1, 0, 0, 2)
					end,
					Position = function(use: ComposeTypes.Use)
						local at, before = placement(use)
						local offset = if insideBody
							then V2.zero
							else V2.new(use(bodyAt).X.Offset, use(bodyAt).Y.Offset)
						local along = at.offset + (if not grid and not before then at.size else 0) - axis(use(canvasAt))
						local across = if grid
							then at.crossOffset + (if before then 0 else at.crossSize) - crossAxis(use(canvasAt))
							else 0
						return D2.fromOffset(
							offset.X + (if horizontal then along else across),
							offset.Y + (if horizontal then across else along)
						)
					end,
				},
				"drop-line"
			)
		end),
		Compose.show(function(use: ComposeTypes.Use)
			return use(moving) ~= nil
		end, function()
			local function dropY(use: ComposeTypes.Use): number
				local move = use(moving)
				if move == nil then
					return 0
				end
				local candidate = move.remaining[move.slot + 1]
				local index = if candidate then assert(controls.indexOfKey)(candidate) else #move.rows
				local at = assert(controls.placementOf)(index or 1)
				return (if insideBody then 0 elseif horizontal then use(bodyAt).X.Offset else use(bodyAt).Y.Offset)
					+ at.offset
					+ (if candidate then 0 else at.size)
					- axis(use(canvasAt))
			end
			local image, targetZ, frontSize = dragImage(dropY)
			drag.preview(image, body, frontSize)
			image.Visible = false
			local keyboardTargetProps: InputProps.ButtonProps = {
				Name = "Drop",
				label = "Drop",
				Position = D2.new(1, -100, 0, 0),
				Size = D2.fromOffset(100, 40),
				ZIndex = targetZ,
				Visible = function(use: ComposeTypes.Use)
					local move = use(moving)
					return move ~= nil
						and move.keyboard
						and not use(choosingDestination)
						and (spec.onReorder ~= nil or spec.drop ~= nil)
				end,
				onActivate = shared.commit,
			}
			gesture.keyboardTarget = shared.UI.Button(keyboardTargetProps)
			local nativeProps: Types.FrameProps = {
				Name = "DropFeedback",
				ZIndex = FEEDBACK_Z,
				gesture.keyboardTarget :: ComposeTypes.Child,
				Size = D2.fromScale(1, 1),
				BackgroundTransparency = 1,
				ctx.styled(
					Host.Frame "DropLine" {
						Visible = function(use)
							local session = use(drag.state)
							local move = use(moving)
							return (spec.onReorder ~= nil or spec.drop ~= nil)
								and session ~= nil
								and (
									(move and move.keyboard and not use(choosingDestination))
									or (session.target == body and body:GetAttribute("FacetDropState") == "accepted")
								)
						end,
						Size = function(use: ComposeTypes.Use): UDim2
							local move = use(moving)
							if grid and move then
								local candidate = move.remaining[move.slot + 1]
								local index = if candidate then assert(controls.indexOfKey)(candidate) else #move.rows
								local at = assert(controls.placementOf)(index or 1)
								return if horizontal then D2.fromOffset(at.size, 2) else D2.fromOffset(2, at.size)
							end
							return if horizontal then D2.new(0, 2, 1, 0) else D2.new(1, 0, 0, 2)
						end,
						BorderSizePixel = 0,
						ZIndex = FEEDBACK_Z,
						Position = function(use: ComposeTypes.Use)
							local move = use(moving)
							if grid and move then
								local candidate = move.remaining[move.slot + 1]
								local index = if candidate then assert(controls.indexOfKey)(candidate) else #move.rows
								local at = assert(controls.placementOf)(index or 1)
								local along = at.offset - axis(use(canvasAt))
								local across = at.crossOffset
									+ (if candidate then 0 else at.crossSize)
									- crossAxis(use(canvasAt))
								return if horizontal then D2.fromOffset(along, across) else D2.fromOffset(across, along)
							end
							return if horizontal then D2.fromOffset(dropY(use), 0) else D2.fromOffset(0, dropY(use))
						end,
					},
					"divider"
				),
				image,
			}
			return Host.Frame(nativeProps)
		end),
	}
	local root = Host.Frame(rootProps)
	return root
end
]]></ProtectedString>
