						<Item class="StringValue" referent="432">
							<Properties>
								<string name="Value"><![CDATA[# Composition.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
gap: (number | ("xs" | "s" | "m" | "l" | "xl") | string)? = omitted
padding: ((number | ("xs" | "s" | "m" | "l" | "xl") | string) | Sides)? = omitted
passive: boolean? = omitted
ref: ((Frame) -> ())? = omitted
rows: Value<("match" | "fit")>? = omitted
topbar: ValueBoolean? = omitted
Sides = { top: (number | SpaceStep | string)?, right: (number | SpaceStep | string)?, bottom: (number | SpaceStep | string)?, left: (number | SpaceStep | string)?, [string]: nil }]]></string>
