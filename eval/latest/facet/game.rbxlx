	ScrollingDirection: typeof(scrollingFrame.ScrollingDirection),
	ScrollingEnabled: typeof(scrollingFrame.ScrollingEnabled),
	TopImage: typeof(scrollingFrame.TopImage),
	TopImageContent: typeof(scrollingFrame.TopImageContent),
	VerticalScrollBarInset: typeof(scrollingFrame.VerticalScrollBarInset),
	VerticalScrollBarPosition: typeof(scrollingFrame.VerticalScrollBarPosition),
	ref: typeof(scrollingFrame.ref),
	contentSize: typeof(zoomView.contentSize),
	content: typeof(zoomView.content),
	zoom: typeof(zoomView.zoom),
	focus: typeof(zoomView.focus),
	minZoom: typeof(zoomView.minZoom),
	maxZoom: typeof(zoomView.maxZoom),
	doubleTapZoom: typeof(zoomView.doubleTapZoom),
	enabled: typeof(zoomView.enabled),
	controls: typeof(zoomView.controls),
	[number | Engine.EventKey]: Compose.Child,
}
export type TravelProps = {
	Changed: typeof(frame.Changed),
	Attributes: typeof(frame.Attributes),
	AncestryChanged: typeof(frame.AncestryChanged),
	Archivable: typeof(frame.Archivable),
