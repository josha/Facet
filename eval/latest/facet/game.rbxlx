								<string name="Value"><![CDATA[# TextInput.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
appearance: ValueString? = omitted
clearButton: boolean? = omitted
clearButtonMode: ("never" | "always" | "whileEditing" | "unlessEditing")? = omitted
controlSize: SizeValue? = omitted
corners: ("pill" | "square")? = omitted
disabled: ValueBoolean? = omitted
enabled: ValueBoolean? = omitted
errorText: ValueString? = omitted
format: ((number) -> string)? = omitted
hint: ValueString? = omitted
invalid: Readable<boolean>? = omitted
label: ValueString? = omitted
leading: Child? = omitted
max: number? = omitted
maxLength: number? = omitted
min: number? = omitted
multiline: boolean? = omitted
numericValue: NumericValueField = required
onCancel: (() -> ())? = omitted
onChange: OnChangeField = required
onCommit: OnCommitField = required
