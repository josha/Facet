						<Item class="StringValue" referent="607">
							<Properties>
								<string name="Value"><![CDATA[# ScrollView.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
align: Value<("start" | "center" | "end" | "stretch")>? = omitted
axis: ("x" | "y" | "xy")? = "y"
distribute: Value<("start" | "center" | "end" | "spaceBetween" | "spaceAround" | "spaceEvenly")>? = omitted
gap: Value<(number | ("xs" | "s" | "m" | "l" | "xl") | string)>? = omitted
height: Value<(number | "fill" | "hug")>? = by axis and children
maxWidth: ValueNumber? = omitted
padding: Value<((number | ("xs" | "s" | "m" | "l" | "xl") | string) | Sides)>? = omitted
ref: ((ScrollingFrame) -> ())? = omitted
width: Value<(number | "fill" | "hug")>? = "fill"
Sides = { top: (number | SpaceStep | string)?, right: (number | SpaceStep | string)?, bottom: (number | SpaceStep | string)?, left: (number | SpaceStep | string)?, [string]: nil }]]></string>
