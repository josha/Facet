								<int64 name="SourceAssetId">-1</int64>
								<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
								<UniqueId name="UniqueId">1f5f3983a820f33d0aedc389000005ea</UniqueId>
							</Properties>
						</Item>
						<Item class="StringValue" referent="527">
