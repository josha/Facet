minZoom: number? = omitted
ref: ((ScrollingFrame) -> ())? = omitted
zoom: Cell<number>? = omitted
ZoomControls = { fit: (() -> boolean)?, zoomTo: ((Rect) -> boolean)?, zoomAt: ((number, Vector2?) -> boolean)?, }]]></string>
