		local level = motion.level(ctx)
		if interactive then
			trackReturn()
		end
		local properties =
			ctx.props(spec, KEYS, { Name = "Toast", BackgroundTransparency = 1, Size = D2.fromOffset(0, 0) })
		local visible = properties.Visible
		properties.Visible = false
		local root = Host.Frame(properties)
		root:SetAttribute("FacetOverlayPlaceholder", true)
		local record: Record = {
			spec = spec,
			state = Compose.cell("idle"),
			stack = nil,
			id = nil,
			pending = nil,
			torn = false,
			hovered = false,
			row = nil,
		}
		local armed = wanted(record)
		local ready = Compose.cell(false)
		local function sync()
			if armed and record.stack and record.id == nil then
