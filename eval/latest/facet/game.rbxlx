						<Item class="StringValue" referent="854">
							<Properties>
								<string name="Value"><![CDATA[# Timer.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
controls: TimerControls? = omitted
deadline: ValueNumber? = omitted
hours: boolean? = omitted
now: (() -> number)? = omitted
onComplete: (() -> ())? = omitted
ref: ((TextLabel) -> ())? = omitted
start: ValueNumber? = omitted
textRole: Value<("caption" | "label" | "body" | "heading" | "title" | "control" | "strong" | "numeral")>? = omitted
TimerControls = { completed: Readable<boolean>? }]]></string>
								<BinaryString name="AttributesSerialize"></BinaryString>
