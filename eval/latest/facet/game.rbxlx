							<Properties>
								<string name="Value"><![CDATA[# Chip.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
appearance: (ValueString | Value<string?>)? = omitted
busy: ValueBoolean? = omitted
compactLabel: ValueString? = omitted
