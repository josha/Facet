				</Item>
				<Item class="ModuleScript" referent="RBX4A73B2D8043F4E83A1799ACCBA3009EE">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Mounts the single Facet app: HUD compositions for hub and race plus every task sheet.
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local C = Facet.Compose
local Store = require(script.Parent.Store)
local Theme = require(script.Parent.Theme)
local Remotes = game.ReplicatedStorage:WaitForChild("Remotes")

local UIModule = {}

function UIModule.start(kart: any, input: any)
	local app = Facet.app({ name = "NeonKart", theme = Theme, suspendGameplay = true })
	local UI = app.UI
	local Host = Facet.host(app.runtime)
	local ctx: any = { app = app, UI = UI, C = C, Host = Host, Store = Store, kart = kart, input = input, anchors = {} }
	ctx.open = {}
	for _, name in { "race", "results", "garage", "livery", "inventory", "shop", "crates", "rewards", "party", "settings", "menu", "mechanic" } do
		ctx.open[name] = C.cell(false)
	end
	ctx.standings = C.cell(false)
	ctx.chatOpen = C.cell(false)
	ctx.tutorialHidden = C.cell(false)

	function ctx.toast(kind: string, text: string)
		local glyph = if kind == "success" then "✓ " elseif kind == "danger" or kind == "error" then "✕ " elseif kind == "warning" then "! " else ""
		app.presentToast(function(T: Facet.Controls): Instance
			return T.Text "Toast" { text = glyph .. text, textRole = "strong" }
		end, { key = "result", position = "top", width = "hug" })
	end
	Store.notify = ctx.toast
	Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(n: any)
		ctx.toast(n.kind or "info", n.text or "")
	end)
	-- Request helper: shows the server's answer, never assumes success.
	function ctx.req(action: string, args: any?, quiet: boolean?): any
		local r = Store.request(action, args)
		if not quiet or not r.ok then
			if r.message and r.message ~= "" then ctx.toast(if r.ok then "success" else "warning", r.message) end
		end
		return r
	end
	function ctx.openOnly(name: string)
		for key, cell in ctx.open do
			if key ~= name and key ~= "results" then cell:set(false) end
		end
		ctx.open[name]:set(true)
	end

	-- Chat bubbles and feed
	Remotes:WaitForChild("Chat").OnClientEvent:Connect(function(msg: any)
		local pl = Players:GetPlayerByUserId(msg.userId)
		local head = pl and pl.Character and pl.Character:FindFirstChild("Head")
		if head then
			pcall(function() TextChatService:DisplayBubble(head :: BasePart, msg.text) end)
		end
	end)

	local function load(name: string): any
		local ok, result = pcall(require, script.Parent.Screens:FindFirstChild(name))
		if not ok then
			warn("Screen " .. name .. " failed to load: " .. tostring(result))
			return nil
		end
		return result
	end
	local modules = {}
	for _, name in { "Hud", "RaceHud", "Lobby", "Garage", "Livery", "Inventory", "Shop", "Crates", "Rewards", "Party", "Settings", "Mechanic", "QuickChat", "Tutorial", "Menu", "Confirm", "World" } do
		if script.Parent.Screens:FindFirstChild(name) then
			modules[name] = load(name)
		end
	end
	ctx.modules = modules

	app.mount(function()
		local env = UI.environment()
		ctx.env = env
		local function suspended(): boolean
			local ok, v = pcall(function() return (env.gameplaySuspended :: any):peek() end)
			return ok and v == true
		end
		input.suspended = suspended
		kart.suspended = suspended
		local children: { any } = {}
		for _, name in { "Hud", "RaceHud", "Lobby", "Garage", "Livery", "Inventory", "Shop", "Crates", "Rewards", "Party", "Settings", "Mechanic", "QuickChat", "Menu", "Tutorial", "Confirm", "World" } do
			local m = modules[name]
			if m then
				local ok, node = pcall(m, ctx)
				if ok and node then
					if type(node) == "table" and not (typeof(node) == "Instance") then
						for _, n in node do table.insert(children, n) end
					else
						table.insert(children, node)
					end
				elseif not ok then
					warn("Screen " .. name .. " failed to build: " .. tostring(node))
				end
			end
		end
		return UI.Screen "Root" (children)
	end)
	script.Destroying:Connect(app.dispose)
	return ctx
end

return UIModule
]]></ProtectedString>
