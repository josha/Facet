	TouchPan: (({ Vector2 }, Vector2, Vector2, Enum.UserInputState) -> ())?,
	TouchPinch: (({ Vector2 }, number, number, Enum.UserInputState) -> ())?,
	TouchRotate: (({ Vector2 }, number, number, Enum.UserInputState) -> ())?,
	TouchSwipe: ((Enum.SwipeDirection, number) -> ())?,
	TouchTap: (({ Vector2 }) -> ())?,
	Visible: Engine.ValueBoolean?,
	ZIndex: Engine.ValueNumber?,
	Style: Engine.ValueEnumFrameStyle?,
	ref: ((Frame) -> ())?,
	target: Shared.GuiInstance | Shared.Input<GuiObject>,
	progress: Shared.Input<number>,
	color: Shared.Input<Color3>?,
	mode: ("pulse" | "sweep")?,
	[number]: Compose.Child?,
}
export type FlashPropsInput = {
	read Changed: ((string) -> ())?,
	read Attributes: Engine.Attributes?,
