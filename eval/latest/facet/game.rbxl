Action = { read id: string, read label: ValueString, read role: ("default" | "cancel" | "destructive")?, read enabled: ValueBoolean?, read busy: ValueBoolean?, read onActivate: () -> (), }
Media = { image: string, aspectRatio: number?, height: (number | string)?, scaleMode: ("fit" | "crop" | "stretch")?, background: Input<Color3>?, }]]></string>
