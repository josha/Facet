				direction = "ltr",
				fallback = "native",
			},
			toggleTrack = {
				kind = "nineSlice",
				asset = { default = "compact_toggle_track_off", selected = "compact_toggle_track_on" },
				fallback = "native",
			},
			toggleKnob = {
