					<Item class="ModuleScript" referent="199">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local reducedMotion = require("./motion").reduced
local geometry = require("./nav_radial_geometry")
local adaptive = require("./adaptive")
local Types = require("./types")
local Radial = require("./radial_types")
local Navigation = require("./navigation_types")
local ControlTypes = require("./control_types")
local RadialProps = require("./radial_props")
local ComposeTypes = require("../vendor/compose/core")

local HOLD = 0.4

export type Controls = ControlTypes.Controls
export type Session<V> = {
	branchOrigin: { path: string, shape: Radial.SectorShape }?,
	capture: InputObject?,
	pressedAt: Vector3?,
	heldAt: Vector3?,
	inspectedUntil: number?,
	analog: boolean,
	held: boolean,
	suppressedInput: InputObject?,
	suppressedUntil: number?,
	suppressedKey: string?,
	suppressedSource: string?,
	openedByLauncher: boolean,
	launcherGesture: boolean,
	aimPointer: ((Vector3, boolean?, boolean?) -> Radial.Sector<V>? | false)?,
	aimAnalog: ((Vector2) -> ())?,
	candidateSector: (() -> Radial.Sector<V>?)?,
	freezeCenter: (() -> ())?,
	returnSelection: ((() -> (), string?) -> ())?,
}
export type Menu<V> = {
	spec: RadialProps.RadialMenuSpec<V>,
	session: Session<V>,
	preferred: ComposeTypes.ReadOnlyValue<Enum.PreferredInput>?,
	painted: (use: ComposeTypes.Use?) -> number,
	appearance: string,
	glyphOnly: (item: Radial.RadialItemBase<V>) -> boolean,
	follow: string,
	gestureSelection: string,
	contentFit: Radial.ContentFit,
	scrim: string,
	corner: boolean,
	ringWidth: (use: ComposeTypes.Use?) -> number?,
	reduced: (use: ComposeTypes.Use?) -> boolean,
	opened: ComposeTypes.Value<boolean>,
	path: ComposeTypes.Value<{ string }>,
	candidate: ComposeTypes.Value<string?>,
	interacting: ComposeTypes.Value<boolean>,
	naming: ComposeTypes.Value<boolean>,
	touchPoint: ComposeTypes.Value<Vector3?>,
	holding: Types.Playback,
	jump: (entries: { string }) -> (),
	cancel: () -> (),
	close: () -> (),
	open: () -> (),
	back: () -> (),
	nativeActivate: (sector: Radial.Sector<V>?, input: InputObject?, source: string?) -> (),
	pointing: () -> boolean,
	isPointer: (input: InputObject) -> boolean,
	beginPointer: (input: InputObject, onPanel: boolean?, fromLauncher: boolean?) -> (),
	skin: (node: GuiObject, definition: Radial.SkinImages?, selected: Types.Input<boolean>?) -> (),
}

return function<V>(ctx: Types.Context, surfaces: Navigation.Surfaces, spec: RadialProps.RadialMenuSpec<V>): Menu<V>
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local typeOf: (unknown) -> string = runtime.host.typeNameOf or typeof
	local E, D2 = ctx.types.Enum, ctx.types.UDim2
	local input = surfaces.service("UserInputService")
	local preferred = if input and input.GetPropertyChangedSignal then ctx.observe.PreferredInput(input) else nil
	local distant = ctx.tenFoot()
	local function painted(use: ComposeTypes.Use?): number
		return if distant(use) then 32 * adaptive.TEN_FOOT_SCALE else 32
	end
	local function choice<T>(value: T?, fallback: T, choices: { T }, name: string): T
		local selected: T = fallback
		if value ~= nil then
			selected = value :: T
		end
		assert(table.find(choices, selected), "RadialMenu invalid " .. name)
		return selected
	end
	local appearance = choice(spec.appearance, "wedges", { "wedges", "buttons" }, "appearance")
	local function glyphOnly(item: Radial.RadialItemBase<V>): boolean
		local icon = item.icon ~= nil or (item.compactLabel ~= nil and item.compactLabel.icon ~= nil)
		return icon
			and (
				item.labelStyle == "icon"
				or (item.compactLabel ~= nil and item.compactLabel.prefer == true)
				or appearance == "buttons"
			)
	end
	local follow = choice(spec.follow, "idle", { "idle", "always", "fixed" }, "follow")
	local gestureSelection = choice(spec.gestureSelection, "bounded", { "bounded", "direction" }, "gestureSelection")
	local contentFit: Radial.ContentFit = spec.contentFit or "radial"
	choice(contentFit, "radial", { "both", "radial", "angular", "none" }, "contentFit")
	choice(spec.navigation, "replace", { "replace", "expand" }, "navigation")
	choice(spec.expansion, "fan", { "fan", "ring" }, "expansion")
	choice(spec.center, "back", { "back", "root", "close", "content", "empty" }, "center")
	choice(spec.completion, "close", { "close", "back", "root", "stay" }, "completion")
	choice(spec.buttonSurface, "native", { "native", "none" }, "buttonSurface")
	local scrim = choice(spec.scrim, "none", { "dark", "light", "none" }, "scrim")
	local _, presetSweep = geometry.arc(spec.preset or "donut")
	local corner = presetSweep < 360
	local function ringWidth(use: ComposeTypes.Use?): number?
		local width = read(spec.ringWidth, use)
		if width == nil or type(width) == "number" then
			return width
		end
		assert(
			width == "narrow" or width == "regular" or width == "wide",
			"RadialMenu ringWidth must be a number of pixels or narrow, regular or wide"
		)
		return ctx.metric("controls.radial." .. width, use)
	end
	local motionReduced = reducedMotion(ctx)
	local function reduced(use: ComposeTypes.Use?): boolean
		return spec.transition == false or motionReduced(use)
	end
	local function validate(
		items: { Radial.RadialItem<V> },
		use: ComposeTypes.Use,
		ancestors: { [{ Radial.RadialItem<V> }]: boolean }
	)
		assert(type(items) == "table" and not ancestors[items], "RadialMenu requires an acyclic item tree")
		ancestors[items] = true
		local ids: { [string]: boolean } = {}
		for _, item in items do
			assert(
				type(item.id) == "string" and item.id ~= "$navigation" and not ids[item.id],
				"RadialMenu requires unique nonreserved item ids"
			)
			ids[item.id] = true
			choice(item.completion, "close", { "stay", "back", "root", "close" }, "item completion")
			choice(item.navigation, "replace", { "replace", "expand" }, "item navigation")
			choice(item.expansion, "fan", { "fan", "ring" }, "item expansion")
			assert(not (item.children and item.onSelect), "RadialMenu items use children or onSelect")
			if item.children then
				validate(read<<{ Radial.RadialItem<V> }>>(item.children, use), use, ancestors)
			end
		end
		ancestors[items] = nil
	end
	Compose.watch(function(use: ComposeTypes.Use)
		validate(read<<{ Radial.RadialItem<V> }>>(spec.items, use), use, {})
	end)
	local opened: ComposeTypes.Value<boolean> = spec.isPresented or Compose.cell(spec.launcher == false)
	local path: ComposeTypes.Value<{ string }> = Compose.cell({})
	local candidate: ComposeTypes.Value<string?> = Compose.cell(nil :: string?)
	local session: Session<V> = { analog = false, held = false, openedByLauncher = false, launcherGesture = false }
	local origins: { [string]: Radial.SectorShape } = {}
	local function jump(entries: { string })
		session.branchOrigin = nil
		local previous = path:peek()
		if #previous == #entries then
			local same = true
			for index, id in entries do
				same = same and previous[index] == id
			end
			if same then
				return
			end
		end
		path:set(entries)
	end
	local interacting = Compose.cell(false)
	local naming = Compose.cell(false)
	local touchPoint: ComposeTypes.Value<Vector3?> = Compose.cell(nil :: Vector3?)
	local holding = runtime.timeline({ duration = HOLD, autoplay = false })
	local function cancel()
		if session.inspectedUntil == math.huge then
			session.inspectedUntil = os.clock() + 0.3
		end
		session.capture, session.analog, session.launcherGesture = nil, false, false
		interacting:set(false)
		naming:set(false)
		touchPoint:set(nil)
		holding:pause()
		candidate:set(nil)
	end
	Compose.watch(function(use: ComposeTypes.Use)
		if
			use(holding.completed)
			and session.capture
			and not session.launcherGesture
			and session.capture.UserInputType == E.UserInputType.Touch
		then
			naming:set(true)
			session.inspectedUntil = math.huge
		end
	end)
	local function close()
		if not opened:peek() then
			return
		end
		opened:set(false)
		jump({})
		cancel()
		if spec.onClose then
			spec.onClose()
		end
	end
	local function open()
		if read(spec.enabled) == false or opened:peek() then
			return
		end
		local anchor = read<<Radial.Anchor?>>(spec.anchor)
		if typeOf(anchor) ~= "Instance" and type(anchor) == "table" and anchor.visible == false then
			return
		end
		opened:set(true)
		if spec.onOpen then
			spec.onOpen()
		end
	end
	local function back()
		cancel()
		local entries = table.clone(path:peek())
		if #entries == 0 then
			close()
		else
			local leaving = table.concat(path:peek(), "/")
			local popped = table.remove(entries)
			local shape = origins[leaving]
			session.branchOrigin = if shape then { path = table.concat(entries, "/"), shape = shape } else nil
			local function change()
				path:set(entries)
				candidate:set(nil)
			end
			if session.returnSelection then
				session.returnSelection(change, table.concat(entries, "/") .. "/" .. tostring(popped))
			else
				change()
			end
		end
	end
	local function activate(sector: Radial.Sector<V>?)
		if not sector or not opened:peek() then
			return
		end
		local item = sector.item
		if read(spec.enabled) == false or read(item.enabled) == false or read(item.hidden) == true then
			return
		end
		cancel()
		if item.id == "$navigation" then
			back()
			return
		end
		if item.children then
			local entries = table.clone(sector.path)
			table.insert(entries, item.id)
			local key = table.concat(entries, "/")
			session.branchOrigin = { path = key, shape = sector :: Radial.SectorShape }
			origins[key] = sector :: Radial.SectorShape
			local function change()
				path:set(entries)
				candidate:set(nil)
			end
			if session.returnSelection then
				session.returnSelection(change)
			else
				change()
			end
			return
		end
		local state = item.checked or item.selected
		local completion = item.completion
			or (if item.dismiss == false then "stay" elseif item.dismiss == true then "close" else spec.completion)
			or (if state then "stay" else "close")
		if completion == "close" then
			close()
		elseif completion == "root" then
			jump({})
		elseif completion == "back" then
			back()
		end
		if item.checked then
			local value = not item.checked:peek()
			item.checked:set(value)
			if item.onChange then
				item.onChange(value)
			end
		elseif item.selected then
			if item.selected:peek() ~= item.value then
				item.selected:set(item.value)
				if item.onChange then
					item.onChange(item.value)
				end
			end
		else
			local select: (() -> ())? = item.onSelect
			if select then
				select()
			end
		end
	end
	local function nativeActivate(sector: Radial.Sector<V>?, input: InputObject?, source: string?)
		if not sector then
			return
		end
		source = source or "native"
		if
			session.inspectedUntil
			and os.clock() < session.inspectedUntil
			and input
			and input.UserInputType == E.UserInputType.Touch
		then
			return
		end
		if
			session.suppressedUntil
			and os.clock() < session.suppressedUntil
			and session.suppressedKey == sector.key
			and session.suppressedSource ~= source
			and (input == nil or session.suppressedInput == nil or input == session.suppressedInput)
		then
			return
		end
		session.suppressedInput, session.suppressedUntil, session.suppressedKey, session.suppressedSource =
			input, os.clock() + 0.3, sector.key, source
		activate(sector)
	end
	local function pointing(): boolean
		local input = surfaces.service("UserInputService") :: UserInputService?
		return touchPoint:peek() == nil
			and (preferred == nil or preferred:peek() ~= E.PreferredInput.Touch)
			and input ~= nil
			and type(input.GetLastInputType) == "function"
			and input:GetLastInputType() == E.UserInputType.MouseMovement
	end
	local function isPointer(input: InputObject): boolean
		return input.UserInputType == E.UserInputType.MouseButton1 or input.UserInputType == E.UserInputType.Touch
	end
	local function beginPointer(input: InputObject, onPanel: boolean?, fromLauncher: boolean?)
		if not session.capture and opened:peek() and isPointer(input) and session.aimPointer then
			session.suppressedInput, session.suppressedUntil, session.inspectedUntil = nil, nil, nil
			if not fromLauncher and session.aimPointer(input.Position, false, true) == false then
				return
			end
			session.capture, session.pressedAt, session.heldAt =
				input, if onPanel then input.Position else nil, input.Position
			session.launcherGesture = fromLauncher == true
			if input.UserInputType == E.UserInputType.Touch then
				touchPoint:set(input.Position)
				holding:restart()
			end
			if session.freezeCenter then
				session.freezeCenter()
			end
			interacting:set(true)
		end
	end
	local function skin(node: GuiObject, definition: Radial.SkinImages?, selected: Types.Input<boolean>?)
		if not definition then
			return
		end
		local guiState = ctx.observe.GuiState(node)
		surfaces.attach(node, {
			Host.ImageLabel "RadialSkin" {
				Size = D2.fromScale(1, 1),
				BackgroundTransparency = 1,
				ZIndex = node.ZIndex - 1,
				Image = function(use: ComposeTypes.Use)
					local state = use(guiState)
					return (
						if state == E.GuiState.Press
							then definition.pressed
							elseif state == E.GuiState.Hover then definition.hover
							elseif selected and read(selected, use) then definition.selected
							else nil
					)
						or definition.default
						or ""
				end,
			},
		})
	end
	return {
		spec = spec,
		session = session,
		preferred = preferred,
		painted = painted,
		appearance = appearance,
		glyphOnly = glyphOnly,
		follow = follow,
		gestureSelection = gestureSelection,
		contentFit = contentFit,
		scrim = scrim,
		corner = corner,
		ringWidth = ringWidth,
		reduced = reduced,
		opened = opened,
		path = path,
		candidate = candidate,
		interacting = interacting,
		naming = naming,
		touchPoint = touchPoint,
		holding = holding,
		jump = jump,
		cancel = cancel,
		close = close,
		open = open,
		back = back,
		nativeActivate = nativeActivate,
		pointing = pointing,
		isPointer = isPointer,
		beginPointer = beginPointer,
		skin = skin,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{E461DD04-B255-49D6-AE01-83CECCB70A55}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">nav_radial_menu</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">73c8afe78d24b4d30afced11000004a5</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="200">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local geometry = require("./nav_radial_geometry")
local layoutKit = require("./layout_kit")
local Types = require("./types")
local Radial = require("./radial_types")
local Navigation = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local MenuTypes = require("./nav_radial_menu")
local ArrangementTypes = require("./nav_radial_layout")

export type Paint<V> = {
	enter: () -> (),
	transparency: (use: ComposeTypes.Use) -> number,
	buttons: { [string]: TextButton },
	iconic: (use: ComposeTypes.Use, live: Radial.Sector<V>) -> boolean,
	focus: ComposeTypes.FocusScope<string>,
	gui: GuiService?,
	panel: ScrollingFrame,
	listWidth: ComposeTypes.ReadOnlyValue<number>,
	listHeaderHeight: ComposeTypes.Value<number>,
	listHeader: Frame,
	headerHeight: (ComposeTypes.Use) -> number,
}

local PATH_THICKNESS_LIMIT = 100

return function<V>(
	ctx: Types.Context,
	UI: MenuTypes.Controls,
	surfaces: Navigation.Surfaces,
	lists: layoutKit.Kit,
	menu: MenuTypes.Menu<V>,
	arrangement: ArrangementTypes.Arrangement<V>,
	layoutUnit: ComposeTypes.ReadOnlyValue<number>,
	phase: Navigation.PresencePhase?
): Paint<V>
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local spec, session = menu.spec, menu.session
	local reduced, appearance = menu.reduced, menu.appearance
	local contentFit: Radial.ContentFit = menu.contentFit
	local placements: { [Radial.CaptionPlacement]: { anchor: Vector2, at: Vector2, gap: Vector2 } } = {
		below = { anchor = V2.new(0.5, 0), at = V2.new(0.5, 1), gap = V2.new(0, 1) },
		above = { anchor = V2.new(0.5, 1), at = V2.new(0.5, 0), gap = V2.new(0, -1) },
		leading = { anchor = V2.new(1, 0.5), at = V2.new(0, 0.5), gap = V2.new(-1, 0) },
		trailing = { anchor = V2.new(0, 0.5), at = V2.new(1, 0.5), gap = V2.new(1, 0) },
		topLeading = { anchor = V2.new(1, 1), at = V2.new(0, 0), gap = V2.new(1, 1) },
		topTrailing = { anchor = V2.new(0, 1), at = V2.new(1, 0), gap = V2.new(-1, 1) },
	}
	local chosen: Radial.CaptionPlacement = spec.captionPlacement or "below"
	local placement = placements[chosen]
	assert(
		placement,
		"Facet.RadialMenu: captionPlacement must be below, above, leading, trailing, topLeading or topTrailing"
	)
	local captionAnchor, captionAt, captionGap = placement.anchor, placement.at, placement.gap
	local preferred, candidate, naming = menu.preferred, menu.candidate, menu.naming
	local following, center = arrangement.following, arrangement.center
	local captionPadding, wordWidths, sectors, fallback =
		arrangement.captionPadding, arrangement.wordWidths, arrangement.sectors, arrangement.fallback
	local captionWidths = arrangement.captionWidths
	local entry = runtime.timeline({ duration = ctx.metric("motion.radial.enter") })
	Compose.watch(function(use: ComposeTypes.Use)
		use(arrangement.centerTarget)
		if entry.completed:peek() then
			following:set(true)
		end
	end)
	local spreadFrom = ctx.metric("motion.materialize.radialSpread")
	local fading = runtime.tween(function(use: ComposeTypes.Use)
		return if phase and use(phase.exiting) then 1 else 0
	end, { seconds = ctx.metric("motion.radial.exit") })
	local function spread(use: ComposeTypes.Use): number
		if reduced(use) then
			return 1
		end
		local present = ctx.motionEase("present", use)
		local shown = present(use(entry.progress)) * (1 - present(use(fading)))
		return spreadFrom + (1 - spreadFrom) * shown
	end
	local function transparency(use: ComposeTypes.Use): number
		if reduced(use) then
			return 0
		end
		return math.max(1 - use(entry.progress), use(fading))
	end
	local buttons: { [string]: TextButton } = {}
	local ringFits: ComposeTypes.Value<{ [string]: { ring: number, inner: number, outer: number } }> = Compose.cell({})
	local fittedWidths: ComposeTypes.Value<{ [string]: number }> = Compose.cell({})
	local function iconSide(use: ComposeTypes.Use): number
		return if spec.iconSize ~= nil
			then read<<number>>(spec.iconSize, use)
			else ctx.controlSize(nil, "iconSize", use)
	end
	local function iconic(use: ComposeTypes.Use, live: Radial.Sector<V>): boolean
		if live.list then
			return false
		end
		if menu.glyphOnly(live.item) then
			return true
		end
		local item = live.item
		local icon = item.icon ~= nil or (item.compactLabel ~= nil and item.compactLabel.icon ~= nil)
		if not icon or live.sharedIcon == true then
			return false
		end
		local padding = captionPadding(use)
		local button = buttons[live.key]
		local inset = button and button:FindFirstChildWhichIsA("UIPadding")
		if inset then
			local left: UDim = inset:GetStyled("PaddingLeft")
			local right: UDim = inset:GetStyled("PaddingRight")
			padding = left.Offset + right.Offset
		end
		local width = math.min(geometry.labelBounds(live, 40).w, use(fittedWidths)[live.key] or math.huge)
		return (use(wordWidths)[live.key] or 0) + padding > width
	end
	local focus = Compose.createFocusScope({
		from = sectors,
		key = function(sector: Radial.Sector<V>)
			return sector.key
		end,
		disabled = function(sector: Radial.Sector<V>)
			return read(sector.item.enabled) == false
		end,
		position = function(sector: Radial.Sector<V>)
			return if sector.list then 0 else sector.x, if sector.list then sector.index * 48 else sector.y
		end,
		autoFocus = false,
	})
	local selectingInput = surfaces.selecting()
	Compose.watch(function(use: ComposeTypes.Use)
		if selectingInput(use) and use(focus.current) == nil and #use(sectors) > 0 then
			focus.first()
		end
	end)
	local gui = surfaces.service("GuiService")
	local listHeaderHeight = Compose.cell(0)
	local function headerHeight(use: ComposeTypes.Use): number
		return math.max(
			ctx.metric("targetSizes.minimum", use),
			menu.painted(use),
			math.ceil(use(listHeaderHeight)) + ctx.metric("space.s", use)
		)
	end
	local listHeader = Host.Frame "ListHeader" {
		BackgroundTransparency = 1,
		LayoutOrder = -1,
		Size = function(use: ComposeTypes.Use): UDim2
			return if use(fallback) then D2.new(1, 0, 0, headerHeight(use)) else D2.fromScale(1, 1)
		end,
	}
	local listWidth = Compose.formula(function(use: ComposeTypes.Use): number
		local width = ctx.metric("controls.popup.panelWidth", use)
		local words = use(wordWidths)
		for _, sector in use(sectors) do
			local item = sector.item
			local icon = item.icon or (item.compactLabel and item.compactLabel.icon)
			local content = (words[sector.key] or 0)
				+ captionPadding(use)
				+ (if icon then ctx.controlSize(nil, "iconSize", use) + ctx.metric("space.s", use) else 0)
			width = math.max(width, content + 2 * ctx.metric("space.m", use) + 8)
		end
		return math.min(width, math.max(0, use(arrangement.viewport).X - 32))
	end)
	local attributes: Types.Attributes = {
		Presentation = function(use: ComposeTypes.Use)
			return if use(fallback) then "list" else "radial"
		end,
	}
	local panelProps: Types.ScrollingFrameNativeProps = {
		Name = "RadialPanel",
		BackgroundTransparency = function(use: ComposeTypes.Use)
			return if use(fallback) then 0 else 1
		end,
		Size = function(use: ComposeTypes.Use)
			if not use(fallback) then
				return D2.fromScale(1, 1)
			end
			local height = headerHeight(use) + #use(sectors) * 48 + 16
			return D2.fromOffset(use(listWidth), math.min(height, math.max(0, use(arrangement.viewport).Y - 32)))
		end,
		Position = function(use: ComposeTypes.Use)
			return if use(fallback) then D2.new(0.5, -use(listWidth) / 2, 0, 16) else D2.fromOffset(0, 0)
		end,
		Active = function(use: ComposeTypes.Use)
			return use(fallback) or not spec.centerPassThrough
		end,
		Interactable = menu.opened,
		Selectable = false,
		CanvasSize = D2.fromOffset(0, 0),
		AutomaticCanvasSize = function(use: ComposeTypes.Use)
			return if use(fallback) then E.AutomaticSize.Y else E.AutomaticSize.None
		end,
		ScrollingEnabled = fallback,
		ClipsDescendants = fallback,
		ScrollBarThickness = function(use: ComposeTypes.Use)
			return if use(fallback) then 6 else 0
		end,
		Attributes = attributes,
		listHeader,
		Compose.show(fallback, function()
			return Compose.fragment(function()
				return { lists.list({ gap = 4 }, true), ctx.padding(8, 8) }
			end)
		end),
		Compose.keyed({
			from = function(use: ComposeTypes.Use)
				local entries: { string } = {}
				local function visit(items: { Radial.RadialItem<V> }, prefix: string)
					for _, item in items do
						local key = prefix .. "/" .. item.id
						table.insert(entries, key)
						if item.children then
							visit(
								read<<{ Radial.RadialItem<V> }>>(item.children, use),
								if prefix == "" then item.id else key
							)
						end
					end
					if spec.center and spec.center ~= "back" and not menu.corner then
						table.insert(entries, prefix .. "/$navigation")
					end
				end
				visit(read<<{ Radial.RadialItem<V> }>>(spec.items, use), "")
				return entries
			end,
			render = function(key: ComposeTypes.ReadOnlyValue<string>)
				local current = Compose.cell<<Radial.Sector<V>?>>(nil)
				local fittedShape = Compose.cell<<Radial.SectorShape?>>(nil)
				local painted = Compose.cell(false)
				local present = Compose.formula(function(use: ComposeTypes.Use): Radial.Sector<V>?
					local entries = use(sectors)
					for sectorIndex = 1, #entries do
						local sector = entries[sectorIndex]
						if sector.key == use(key) then
							return sector
						end
					end
					return nil
				end)
				Compose.watch(function(use: ComposeTypes.Use)
					local sector = use(present)
					if sector then
						current:set(sector)
					end
				end)
				return Host.Frame("SectorSlot" .. key:peek())({
					BackgroundTransparency = 1,
					Visible = painted,
					Interactable = function(use: ComposeTypes.Use)
						return use(present) ~= nil
					end,
					LayoutOrder = function(use: ComposeTypes.Use)
						local sector = use(current)
						return if sector then sector.index else 0
					end,
					Size = function(use: ComposeTypes.Use)
						local sector = use(current)
						return if sector and sector.list then D2.new(1, 0, 0, 44) else D2.fromScale(1, 1)
					end,
					Compose.presence(function(use: ComposeTypes.Use)
						return use(present)
					end, function(branchPhase: Navigation.PresencePhase)
						local function currentSector(use: ComposeTypes.Use?): Radial.Sector<V>
							return assert(if use then use(current) else current:peek())
						end
						painted:set(true)
						Compose.cleanup(function()
							painted:set(false)
						end)
						local entered = Compose.cell(false)
						local opacity = runtime.tween(function(use: ComposeTypes.Use)
							return if use(entered) and not use(branchPhase.exiting) then 1 else 0
						end, { seconds = ctx.metric("motion.radial.exit") })
						local arrival = runtime.tween(function(use: ComposeTypes.Use)
							return if use(entered) then 1 else 0
						end, { seconds = ctx.metric("motion.radial.slot") })
						local sector = assert(currentSector())
						local from = session.branchOrigin
						local branch = if from and from.path == table.concat(sector.path, "/") then from.shape else nil
						local centred = branch == nil and entry.completed:peek()
						local function unfold(use: ComposeTypes.Use, shape: Radial.SectorShape): Radial.SectorShape
							local parent = assert(branch)
							local present = ctx.motionEase("present", use)
							local p = if use(branchPhase.exiting)
								then 1 - present(1 - use(opacity))
								else present(use(arrival))
							local start = ctx.metric("motion.unfoldStart", use)
							local factor = start + (1 - start) * p
							local middle = (parent.inner + parent.outer) / 2
							local radius = middle + (math.sqrt(shape.x * shape.x + shape.y * shape.y) - middle) * p
							local angle = parent.angle + geometry.delta(shape.angle, parent.angle) * factor
							local result = table.clone(shape)
							result.angle, result.span = angle, shape.span * factor
							result.inner = parent.inner + (shape.inner - parent.inner) * p
							result.outer = parent.outer + (shape.outer - parent.outer) * p
							result.x = math.sin(math.rad(angle)) * radius
							result.y = -math.cos(math.rad(angle)) * radius
							return result
						end
						local function moving(use: ComposeTypes.Use, live: Radial.Sector<V>): boolean
							return (branch ~= nil or centred) and not live.list and not reduced(use)
						end
						local function travel(use: ComposeTypes.Use, live: Radial.Sector<V>): (number, number)
							if not moving(use, live) then
								return 0, 0
							end
							if branch then
								local shown = unfold(use, live)
								return shown.x - live.x, shown.y - live.y
							end
							local amount = ctx.metric("motion.materialize.branch", use) * (1 - use(arrival))
							return -live.x * amount, -live.y * amount
						end
						local function chosen(use: ComposeTypes.Use): boolean
							local live = currentSector(use)
							return use(candidate) == live.key
								or use(focus.current) == live.key
								or read(live.item.checked, use) == true
								or (live.item.selected ~= nil and read(live.item.selected, use) == live.item.value)
						end
						local function box(use: ComposeTypes.Use, live: Radial.Sector<V>): (number, number)
							if appearance == "buttons" then
								local diameter = math.max(
									44,
									live.size,
									if iconic(use, live)
										then 0
										else (use(wordWidths)[live.key] or 0) + captionPadding(use)
								)
								return diameter, diameter
							end
							local iconOnly = iconic(use, live)
							local bounds = geometry.labelBounds(use(fittedShape) or live, if iconOnly then 160 else 40)
							return if iconOnly then bounds.h else bounds.w, bounds.h
						end
						local button = UI.Button {
							Name = sector.id,
							corners = if appearance == "buttons" then "pill" else nil,
							appearance = if appearance == "wedges" then "utility" else nil,
							ClipsDescendants = appearance == "wedges",
							label = function(use: ComposeTypes.Use)
								local live = currentSector(use)
								return if iconic(use, live) then "" else read<<string?>>(live.item.label, use) or ""
							end,
							name = function(use: ComposeTypes.Use): string
								return read<<string?>>(currentSector(use).item.label, use) or ""
							end,
							icon = sector.item.icon or (sector.item.compactLabel and sector.item.compactLabel.icon),
							AnchorPoint = function(use: ComposeTypes.Use)
								return if currentSector(use).list then V2.zero else V2.new(0.5, 0.5)
							end,
							BackgroundTransparency = if appearance == "wedges"
									or spec.buttonSurface == "none"
								then function(use: ComposeTypes.Use): number
									return if use(fallback) then 0 else 1
								end
								else nil,
							LayoutOrder = function(use: ComposeTypes.Use)
								return currentSector(use).index
							end,
							InputBegan = function(input: InputObject)
								menu.beginPointer(input)
							end,
							MouseEnter = function()
								if
									not session.capture
									and not session.analog
									and (preferred == nil or preferred:peek() ~= E.PreferredInput.Touch)
								then
									candidate:set(currentSector().key)
									naming:set(menu.pointing())
								end
							end,
							MouseLeave = function()
								if not session.capture and not session.analog then
									candidate:set(nil)
									naming:set(false)
								end
							end,
							AutomaticSize = E.AutomaticSize.None,
							Position = function(use: ComposeTypes.Use)
								local at, live = use(center), currentSector(use)
								if live.list then
									return D2.fromOffset(0, 0)
								end
								local scale = spread(use)
								local dx, dy = travel(use, live)
								return D2.fromOffset(at.X + live.x * scale + dx, at.Y + live.y * scale + dy)
							end,
							Size = function(use: ComposeTypes.Use)
								local live = currentSector(use)
								if live.list then
									return D2.new(1, -8, 0, 44)
								end
								local width, height = box(use, live)
								return D2.fromOffset(width, height)
							end,
							TextWrapped = false,
							enabled = function(use: ComposeTypes.Use)
								return read(currentSector(use).item.enabled, use) ~= false
							end,
							selected = chosen,
							onActivate = function(input: InputObject?)
								menu.nativeActivate(currentSector(), input)
							end,
							SelectionGained = function()
								focus.focus(currentSector().key)
								candidate:set(currentSector().key)
							end,
							ZIndex = 105,
						}
						button:AddTag("facet-radial-label")
						Compose.watch(function(use: ComposeTypes.Use)
							if use(fallback) then
								button:AddTag("facet-radial-row")
							elseif button:HasTag("facet-radial-row") then
								button:RemoveTag("facet-radial-row")
							end
						end)
						buttons[sector.key] = button
						if spec.captions and appearance == "buttons" then
							local words = ctx.text({
								Name = "Text",
								Text = function(use: ComposeTypes.Use): string
									return read<<string?>>(currentSector(use).item.label, use) or ""
								end,
								Size = D2.fromOffset(0, 0),
								AutomaticSize = E.AutomaticSize.XY,
								TextWrapped = false,
								Interactable = false,
								ZIndex = 107,
							})
							words:AddTag("facet-type-caption")
							local plate = ctx.styled(
								Host.Frame {
									Name = "ItemCaption",
									AnchorPoint = captionAnchor,
									Position = function(use: ComposeTypes.Use): UDim2
										local gap = ctx.metric("space.xs", use)
										return D2.new(captionAt.X, captionGap.X * gap, captionAt.Y, captionGap.Y * gap)
									end,
									Size = D2.fromOffset(0, 0),
									AutomaticSize = E.AutomaticSize.XY,
									Interactable = false,
									Visible = function(use: ComposeTypes.Use): boolean
										local live = currentSector(use)
										return not live.list and iconic(use, live)
									end,
									ZIndex = 106,
									ctx.padding(8, 4),
								},
								"tooltip"
							)
							surfaces.attach(plate, { words })
							surfaces.attach(button, { plate })
						end
						local floor = button:FindFirstChildWhichIsA("UISizeConstraint")
						if floor then
							floor:Destroy()
						end
						local glyph = button:FindFirstChild("LeadingIcon", true)
						if glyph then
							runtime.decorate(glyph, {
								Visible = function(use: ComposeTypes.Use)
									local live = currentSector(use)
									return live.list or iconic(use, live)
								end,
								Size = function(use: ComposeTypes.Use): UDim2
									local live = currentSector(use)
									local theme = ctx.controlSize(nil, "iconSize", use)
									if live.list or not iconic(use, live) then
										return D2.fromOffset(theme, theme)
									end
									local width, height = box(use, live)
									local room = math.min(width, height)
									local side = math.min(iconSide(use), math.max(room - 4, theme))
									return D2.fromOffset(side, side)
								end,
							})
						end
						Compose.watch(function(use: ComposeTypes.Use)
							local live = currentSector(use)
							if not live.list and iconic(use, live) then
								button:AddTag("facet-button-glyph")
							else
								button:RemoveTag("facet-button-glyph")
							end
						end)
						if appearance == "wedges" then
							ctx.styled(button, "radial-item")
						end
						Compose.cleanup(function()
							buttons[sector.key] = nil
						end)
						menu.skin(button, spec.skin and spec.skin.item, function(use: ComposeTypes.Use)
							return use(candidate) == currentSector(use).key
						end)
						Compose.watch(function(use: ComposeTypes.Use)
							if use(candidate) == currentSector(use).key then
								button:AddTag("facet-radial-candidate")
							else
								button:RemoveTag("facet-radial-candidate")
							end
						end)
						local caption = button:FindFirstChild("Title", true)
						local textNode = if caption and caption:IsA("TextLabel") then caption else button
						local natural = ctx.styled(
							Host.TextLabel {
								Name = "CaptionMeasure",
								BackgroundTransparency = 1,
								BorderSizePixel = 0,
								TextXAlignment = E.TextXAlignment.Left,
								Text = function(use: ComposeTypes.Use): string
									return read<<string?>>(currentSector(use).item.label, use) or ""
								end,
								FontFace = ctx.observeStyled.FontFace(textNode),
								TextSize = ctx.observeStyled.TextSize(textNode),
								TextWrapped = false,
								TextTruncate = E.TextTruncate.None,
								TextTransparency = 1,
								Interactable = false,
								Size = D2.fromOffset(0, 0),
								AutomaticSize = E.AutomaticSize.XY,
							},
							"Text"
						)
						surfaces.attach(button, { natural })
						local fullBounds, paintedBounds =
							ctx.layoutBounds(natural, layoutUnit), ctx.layoutBounds(textNode, layoutUnit)
						local measured = Compose.formula(function(use: ComposeTypes.Use): Vector2
							local full, painted = use(fullBounds), use(paintedBounds)
							return V2.new(math.max(full.X, painted.X), math.max(full.Y, painted.Y))
						end)
						Compose.watch(function(use: ComposeTypes.Use)
							local natural = use(fullBounds).X
							local width = use(measured).X
							if natural > 0 and captionWidths:peek()[sector.key] ~= natural then
								local widths = table.clone(captionWidths:peek())
								widths[sector.key] = natural
								captionWidths:set(widths)
							end
							if width > 0 and wordWidths:peek()[sector.key] ~= width then
								local widths = table.clone(wordWidths:peek())
								widths[sector.key] = width
								wordWidths:set(widths)
							end
						end)
						local paint = Host.Path2D "Sector" {
							Thickness = sector.outer - sector.inner,
							Closed = false,
							ZIndex = 102,
						}
						ctx.styled(paint, "radial-sector")

						local strokeOwner = Compose.currentOwner()
						local extraStrokes: { Path2D } = {}
						local candidate = Compose.cell(false)
						local function extraStroke(index: number): Path2D
							local existing = extraStrokes[index]
							if existing then
								return existing
							end
							local stroke = Compose.withOwner(assert(strokeOwner), function(): Path2D
								local made = Host.Path2D("SectorBand" .. tostring(index + 1))({
									Thickness = paint.Thickness,
									Closed = false,
									ZIndex = 102,
								})
								ctx.styled(made, "radial-sector")
								if candidate:peek() then
									made:AddTag("facet-radial-candidate")
								end
								return made
							end)
							extraStrokes[index] = stroke
							return stroke
						end
						Compose.watch(function(use: ComposeTypes.Use)
							local on = chosen(use)
							candidate:set(on)
							for _, stroke in { paint, table.unpack(extraStrokes) } do
								if on then
									stroke:AddTag("facet-radial-candidate")
								else
									stroke:RemoveTag("facet-radial-candidate")
								end
							end
						end)
						local wrapper = ctx.fade({
							Name = "Sector-" .. sector.id,
							BackgroundTransparency = 1,
							GroupTransparency = function(use: ComposeTypes.Use)
								return if reduced(use)
									then transparency(use)
									else 1 - (1 - transparency(use)) * use(opacity)
							end,
							ClipsDescendants = false,
							LayoutOrder = function(use: ComposeTypes.Use)
								return currentSector(use).index
							end,
							Size = function(use: ComposeTypes.Use)
								return if currentSector(use).list then D2.new(1, 0, 0, 44) else D2.fromScale(1, 1)
							end,
							button,
						}, nil, false)
						local shaped = Compose.cell(false)
						local shape = Host.Frame "Paint" {
							BackgroundTransparency = 1,
							Visible = function(use: ComposeTypes.Use)
								return appearance == "wedges" and not currentSector(use).list and use(shaped)
							end,
							paint,
						}
						surfaces.attach(wrapper, { shape })
						local placed = Compose.cell<<{ x: number, y: number }?>>(nil)
						Compose.watch(function(use: ComposeTypes.Use)
							if use(present) == nil then
								return
							end
							local live = currentSector(use)
							local text = use(measured)
							local label = geometry.labelBounds(live, 40)
							local iconOnly = iconic(use, live)
							local iconSize = iconSide(use) + 8
							local fitted = geometry.fitContent(
								live,
								if iconOnly
									then iconSize
									elseif text.X > 0 then text.X + captionPadding(use)
									else label.w,
								if iconOnly
									then iconSize
									elseif text.Y > 0 then math.max(text.Y, ctx.controlSize(nil, "height", use))
									else label.h,
								6,
								contentFit
							)
							local ready = iconOnly or text.X > 0 or (read(live.item.label, use) or "") == ""
							local complete = ready
							if contentFit == "radial" then
								local own = ringFits:peek()[live.key]
								if
									ready
									and (
										not own
										or own.ring ~= live.inner
										or own.inner ~= fitted.inner
										or own.outer ~= fitted.outer
									)
								then
									local nextFits = table.clone(ringFits:peek())
									nextFits[live.key] =
										{ ring = live.inner, inner = fitted.inner, outer = fitted.outer }
									ringFits:set(nextFits)
								end
								local fits = use(ringFits)
								for _, entry in use(sectors) do
									local fit = fits[entry.key]
									if entry.inner == live.inner and (fit == nil or fit.ring ~= live.inner) then
										complete = false
									end
									if fit and fit.ring == live.inner then
										fitted.inner = math.min(fitted.inner, fit.inner)
										fitted.outer = math.max(fitted.outer, fit.outer)
									end
								end
							end
							if complete and not shaped:peek() then
								shaped:set(true)
							end
							fittedShape:set(fitted)
							local width = geometry.labelBounds(fitted, 40).w
							if fittedWidths:peek()[live.key] ~= width then
								local widths = table.clone(fittedWidths:peek())
								widths[live.key] = width
								fittedWidths:set(widths)
							end
							local painted = if branch and moving(use, live) then unfold(use, fitted) else fitted
							local bounds = geometry.paint(painted)
							placed:set({ x = bounds.x, y = bounds.y })
							shape.Size = D2.fromOffset(bounds.w, bounds.h)
							local band = math.max(1, fitted.outer - fitted.inner)
							local strokes = math.max(1, math.ceil(band / PATH_THICKNESS_LIMIT - 1e-6))
							local function strokePoints(part: Radial.Paint): { Path2DControlPoint }
								local points: { Path2DControlPoint } = {}
								for _, point in part.points do
									local sx, sy = part.w / bounds.w, part.h / bounds.h
									table.insert(
										points,
										ctx.types.Path2DControlPoint.new(
											D2.fromScale(
												(point.x * part.w + part.x - bounds.x) / bounds.w,
												(point.y * part.h + part.y - bounds.y) / bounds.h
											),
											D2.fromScale(point.inX * sx, point.inY * sy),
											D2.fromScale(point.outX * sx, point.outY * sy)
										)
									)
								end
								return points
							end
							if strokes == 1 then
								paint.Thickness = band
								paint:SetControlPoints(strokePoints(bounds))
							end
							local step = (painted.outer - painted.inner) / strokes
							for index = 1, math.max(strokes, #extraStrokes + 1) do
								local stroke = if index == 1 then paint else extraStroke(index - 1)
								if index > strokes then
									stroke.Visible = false
								elseif strokes > 1 then
									local part = table.clone(painted)
									part.inner = painted.inner + (index - 1) * step
									part.outer = painted.inner + index * step
									stroke.Visible = true
									stroke.Thickness = band / strokes
									stroke:SetControlPoints(strokePoints(geometry.paint(part)))
									if index > 1 and stroke.Parent ~= shape then
										stroke.Parent = shape
									end
								end
							end
						end)
						Compose.watch(function(use: ComposeTypes.Use)
							local bounds = use(placed)
							if bounds == nil then
								return
							end
							local live, at = currentSector(use), use(center)
							local dx, dy = 0, 0
							if not branch then
								dx, dy = travel(use, live)
							end
							local lag = spread(use) - 1
							shape.Position =
								D2.fromOffset(at.X + bounds.x + dx + lag * live.x, at.Y + bounds.y + dy + lag * live.y)
						end)
						entered:set(true)
						return wrapper
					end, {
						exit = function(): ComposeTypes.Exiting
							return if reduced()
								then { completed = Compose.cell(true) }
								else runtime.timeline({ duration = ctx.metric("motion.radial.exit") })
						end,
					}),
				})
			end,
		}),
	}
	local panel = Host.ScrollingFrame(panelProps)
	Compose.watch(function(use: ComposeTypes.Use)
		if use(fallback) then
			panel:AddTag("facet-panel")
		else
			panel:RemoveTag("facet-panel")
		end
	end)
	return {
		enter = function()
			entry:restart()
			if read(selectingInput) then
				focus.first()
			end
		end,
		transparency = transparency,
		buttons = buttons,
		iconic = iconic,
		focus = focus,
		gui = gui,
		panel = panel,
		listWidth = listWidth,
		listHeaderHeight = listHeaderHeight,
		listHeader = listHeader,
		headerHeight = headerHeight,
	}
end
