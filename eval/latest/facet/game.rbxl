						<Item class="StringValue" referent="941">
							<Properties>
								<string name="Value"><![CDATA[# Toast.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
action: ToastAction? = omitted
closeButton: boolean? = omitted
content: (() -> Instance)? = omitted
duration: number? = omitted
fade: boolean? = omitted
icon: string? = omitted
isPresented: ValueBoolean? = omitted
key: string? = omitted
message: ValueString? = omitted
onDismiss: ((("timeout" | "supersede" | "preempt" | "capacity" | "manual" | "action" | "close" | "cancel")) -> ())? = omitted
onPresentedChange: ((boolean) -> ())? = omitted
position: ("top" | "bottom")? = omitted
priority: number? = omitted
readFloor: number? = omitted
ref: ((Frame) -> ())? = omitted
width: ("fill" | "hug")? = omitted
closeButton: Requires action; a toast without an action is display-only.
ToastAction = { read label: ValueString, read onActivate: () -> () }]]></string>
