		local settle: (() -> ())? = nil
		local ready = Compose.withOwner(contentOwner, function()
			local prepared, close = preparePaint(
				ctx,
				if measureRow then measuredNode else content,
				measureRow,
				tree == nil and (spec.measure == true or measureRow ~= nil)
