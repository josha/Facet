					</Item>
					<Item class="ModuleScript" referent="RBX5386737EAFC54154988FD566D70901F8">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Driving HUD: position, lap, timer, countdown, boost, live standings, knockout and chat feed.
local Players = game:GetService("Players")
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local Common = require(script.Parent.Common)

return function(ctx: any): any
	local UI, C, Store, input, kart = ctx.UI, ctx.C, ctx.Store, ctx.input, ctx.kart
	local env = ctx.env
	local race = Store.race
	local driving = C.formula(function(use: Facet.Use): boolean
		local m = use(Store.mode)
		return m == "race" or m == "test"
	end)
	local function isTest(use: Facet.Use): boolean return use(Store.mode) == "test" end
	local function me(use: Facet.Use): any? return Common.me(use(race).racers) end

	input.standings.Pressed:Connect(function()
		if Store.mode:peek() == "race" or Store.race:peek().phase == "results" then
			ctx.standings:set(not ctx.standings:peek())
		end
	end)

	local function standingRow(i: number): Instance
		local function racer(use: Facet.Use): any?
			return Common.sorted(use(race).racers)[i]
		end
		return UI.HStack("Row" .. i) { gap = "s", width = env.scaled(250),
			Visible = function(use: Facet.Use): boolean return racer(use) ~= nil end,
			UI.Text { text = tostring(i), textRole = "strong", Size = UDim2.fromOffset(env.scaled(22), 0) },
			Common.portrait(ctx, env.scaled(30), racer),
			UI.Text { text = function(use: Facet.Use): string
				local r = racer(use)
				if not r then return "" end
				return if r.userId == Players.LocalPlayer.UserId then "▶ " .. r.name .. " (You)" else r.name
			end, textRole = function(use: Facet.Use): string
				local r = racer(use)
				return if r and r.userId == Players.LocalPlayer.UserId then "strong" else "body"
			end, UI.fill() },
			UI.Text { text = function(use: Facet.Use): string
				local r = racer(use)
				local rc = use(race)
				if not r then return "" end
				if r.out then return "OUT" end
				if r.finished then return "FINISHED" end
				return string.format("Lap %d/%d", math.clamp(r.lap + 1, 1, rc.laps or 3), rc.laps or 3)
			end, textRole = "caption" },
		}
	end

	local countdownText = C.formula(function(use: Facet.Use): string
		local rc = use(race)
		local t = use(Store.time)
		if rc.phase == "countdown" and rc.countdownEnd then
			local left = math.ceil(rc.countdownEnd - t)
			return if left > 3 then "READY" else tostring(math.max(1, left))
		elseif rc.phase == "racing" and rc.startTime and t - rc.startTime < 1.2 then
			return "GO!"
		end
		return ""
	end)

	return C.show(driving, function()
		local rows = {}
		for i = 1, 6 do table.insert(rows, standingRow(i)) end
		local feedRows = {}
		for i = 1, 4 do
			table.insert(feedRows, UI.Text("Feed" .. i) { textRole = "caption", text = function(use: Facet.Use): string
				local f = (use(race).feed or {})[i]
				return if f then "✕ " .. f.text .. " · lap " .. f.lap else ""
			end, Visible = function(use: Facet.Use): boolean return (use(race).feed or {})[i] ~= nil and use(race).raceMode == "Knockout" end })
		end
		local chatRows = {}
		for i = 1, 3 do
			table.insert(chatRows, UI.Text("Chat" .. i) { textRole = "caption", text = function(use: Facet.Use): string
				local m = use(Store.chat)[i]
				return if m then m.name .. ": " .. m.text else ""
			end, Visible = function(use: Facet.Use): boolean
				local m = use(Store.chat)[i]
				return m ~= nil and use(Store.time) - m.at < 10
			end })
		end
		return UI.Composition "RaceHUD" {
			UI.Region "Standing" { zone = "topLeft", rank = 1,
				UI.VStack "Full" { surface = "panel", padding = "m", gap = "xs",
					UI.Text { textRole = "numeral", text = function(use: Facet.Use): string
						if isTest(use) then return "TEST" end
						local r = me(use)
						if not r then return "--" end
						if r.out then return "OUT" end
						return Store.ordinal(r.position or 1) .. " / " .. #(use(race).racers or {})
					end },
					UI.Text { textRole = "heading", text = function(use: Facet.Use): string
						if isTest(use) then return "Practice ring" end
						local r, rc = me(use), use(race)
						if not r then return "" end
						if r.finished then return "FINISHED" end
						if r.out then return "Knocked out on lap " .. tostring(r.outLap) end
						return string.format("LAP %d / %d", math.clamp(r.lap + 1, 1, rc.laps or 3), rc.laps or 3)
					end },
					UI.Text { textRole = "caption", text = function(use: Facet.Use): string
						if isTest(use) then return "Drive freely · Exit returns to the hub" end
						local rc, t = use(race), use(Store.time)
						local track = rc.track and GameData.find(GameData.Tracks, rc.track)
						local r = me(use)
						local elapsed = if r and r.finished and r.finishTime and rc.startTime then r.finishTime - rc.startTime
							elseif rc.startTime and rc.phase == "racing" then t - rc.startTime else 0
						return string.format("%s · %s · %d:%04.1f", track and (track :: any).name or "", rc.raceMode or "", math.floor(elapsed / 60), elapsed % 60)
					end },
				},
				UI.VStack "Short" { surface = "panel", padding = "s",
					UI.Text { textRole = "strong", text = function(use: Facet.Use): string
						if isTest(use) then return "TEST" end
						local r, rc = me(use), use(race)
						if not r then return "--" end
						if r.out then return "OUT" end
						return string.format("%s · L%d/%d", Store.ordinal(r.position or 1), math.clamp(r.lap + 1, 1, rc.laps or 3), rc.laps or 3)
					end } },
			},
			UI.Region "Commands" { zone = "topRight", rank = 2,
				UI.HStack "Full" { gap = "s",
					UI.Button "Standings" { label = "Standings", icon = "trophy", appearance = "utility", shortcutHint = input.standings,
						Visible = function(use: Facet.Use): boolean return not isTest(use) end,
						onActivate = function() ctx.standings:set(not ctx.standings:peek()) end },
					UI.Button "Chat" { label = "Chat", icon = "chat", appearance = "utility", shortcutHint = input.chat,
						onActivate = function() ctx.chatOpen:set(true) end },
					UI.Button "ExitTest" { label = "Exit test drive", icon = "close", appearance = "emphasis",
						Visible = isTest,
						onActivate = function() ctx.req("endTest", nil, true) end },
				},
			},
			UI.Region "Countdown" { zone = "center", rank = 1,
				UI.VStack "Full" { align = "center",
					UI.Text { text = countdownText, textRole = "title",
						Visible = function(use: Facet.Use): boolean return use(countdownText) ~= "" end },
				},
			},
			UI.Region "Board" { zone = "right", rank = 3,
				UI.VStack "Full" { gap = "xs",
					Visible = function(use: Facet.Use): boolean return use(ctx.standings) and not isTest(use) end,
					surface = "panel", padding = "s",
					UI.Text { text = "STANDINGS", textRole = "label" },
					table.unpack(rows),
				},
			},
			UI.Region "Feed" { zone = "left", rank = 4, mayDrop = true,
				UI.VStack "Full" { gap = "xs", Size = UDim2.fromOffset(env.scaled(230), 0),
					UI.Text { text = "KNOCKOUTS", textRole = "label",
						Visible = function(use: Facet.Use): boolean return use(race).raceMode == "Knockout" and #(use(race).feed or {}) > 0 end },
					feedRows[1], feedRows[2], feedRows[3], feedRows[4],
					chatRows[1], chatRows[2], chatRows[3],
				},
			},
			UI.Region "Meter" { zone = "bottom", rank = 5,
				UI.VStack "Full" { surface = "panel", padding = "s", gap = "xs", align = "center",
					UI.Text { textRole = "numeral", text = function(use: Facet.Use): string
						return string.format("%d", math.floor(use(Store.kart).speed * 1.6)) .. " km/h"
					end },
					UI.ProgressView "Boost" { Size = UDim2.fromOffset(env.scaled(200), 0), label = "Boost",
						value = function(use: Facet.Use): number return use(Store.kart).meter end,
						endLabel = function(use: Facet.Use): string
							local k = use(Store.kart)
							if k.boosting then return "BOOSTING" end
							if k.drifting then return string.format("Drift %.1f", k.charge) end
							return if k.onRoad then string.format("%d%%", math.floor(k.meter * 100)) else "Off track"
						end },
				},
			},
			UI.Region "Drive" { zone = "action", rank = 2,
				UI.VStack "Full" { gap = "s", align = "stretch",
					UI.Button "Boost" { label = "Boost", icon = "bolt", appearance = "emphasis", shortcutHint = input.boost, onActivate = function() kart.boost() end },
					UI.HStack "Row" { gap = "s",
						UI.Button "Drift" { label = "Drift", shortcutHint = input.drift, onActivate = function() kart.driftTap() end },
						UI.Button "Recover" { label = "Recover", shortcutHint = input.recover, onActivate = function() kart.recover() end },
						UI.Button "Camera" { label = "View", icon = "view.grid", shortcutHint = input.camera, appearance = "utility",
							onActivate = function() Store.camera:set(if Store.camera:peek() == "far" then "near" else "far") end },
					},
				},
			},
		}
	end)
end
