						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Client mirror of server-accepted state. Only the server changes profile values.
local Players = game:GetService("Players")
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local C = Facet.Compose
local Remotes = game.ReplicatedStorage:WaitForChild("Remotes")

local Store = {}
Store.profile = C.cell(nil :: any)
Store.race = C.cell({ phase = "idle", queued = {}, racers = {} } :: any)
Store.mode = C.cell("hub")
Store.kart = C.cell({ speed = 0, max = 1, meter = 0, drifting = false, charge = 0, boosting = false, onRoad = true } :: any)
Store.chat = C.cell({} :: { any })
Store.clock = C.cell(os.time())
Store.serverOffset = 0
Store.notify = nil :: ((kind: string, text: string) -> ())?
Store.camera = C.cell("far")

function Store.now(): number
	return os.time() + Store.serverOffset
end

function Store.request(action: string, args: any?): any
	local ok, result = pcall(function()
		return (Remotes:WaitForChild("Request") :: RemoteFunction):InvokeServer(action, args)
	end)
	if not ok or type(result) ~= "table" then
		return { ok = false, message = "Connection problem. Try again." }
	end
	return result
end

local player = Players.LocalPlayer
Remotes:WaitForChild("Profile").OnClientEvent:Connect(function(snap: any)
	Store.serverOffset = snap.serverTime - os.time()
	Store.profile:set(snap)
end)
Remotes:WaitForChild("Race").OnClientEvent:Connect(function(payload: any)
	Store.race:set(payload)
end)
Remotes:WaitForChild("Chat").OnClientEvent:Connect(function(msg: any)
	local list = table.clone(Store.chat:peek())
	table.insert(list, 1, msg)
	while #list > 4 do table.remove(list) end
	Store.chat:set(list)
end)
Store.mode:set(player:GetAttribute("Mode") or "hub")
player:GetAttributeChangedSignal("Mode"):Connect(function()
	Store.mode:set(player:GetAttribute("Mode") or "hub")
end)
task.spawn(function()
	while true do
		task.wait(0.5)
		Store.clock:set(os.time())
	end
end)

function Store.fmt(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end
function Store.short(n: number): string
	if n >= 1e6 then return string.format("%.1fM", n / 1e6) end
	if n >= 1e4 then return string.format("%.1fK", n / 1e3) end
	return Store.fmt(n)
end
function Store.clockText(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor(seconds % 3600 / 60)
	local s = seconds % 60
	if h > 0 then return string.format("%dh %02dm", h, m) end
	return string.format("%d:%02d", m, s)
end

Store.time = C.cell(workspace:GetServerTimeNow())
task.spawn(function()
	while true do
		task.wait(0.1)
		Store.time:set(workspace:GetServerTimeNow())
	end
end)
task.spawn(function()
	local snap = Store.request("snapshot")
	if snap.ok and snap.profile then
		Store.serverOffset = snap.profile.serverTime - os.time()
		Store.profile:set(snap.profile)
	end
	local race = Store.request("raceState")
	if race.ok and race.race then Store.race:set(race.race) end
end)

function Store.ordinal(n: number): string
	local suffix = "th"
	if n % 100 < 11 or n % 100 > 13 then
		suffix = ({ "st", "nd", "rd" } :: { string })[n % 10] or "th"
	end
	return tostring(n) .. suffix
end
function Store.isMe(userId: number?): boolean
	return userId == Players.LocalPlayer.UserId
end
function Store.inRace(race: any): boolean
	for _, p in race.participants or {} do
		if p.userId == Players.LocalPlayer.UserId then return true end
	end
	return false
end
function Store.queued(race: any): any?
	for _, q in race.queued or {} do
		if q.userId == Players.LocalPlayer.UserId then return q end
	end
	return nil
end

return Store
]]></ProtectedString>
						<string name="ScriptGuid">{B41F5BA8-7ADB-485E-A1C1-E669DD70C370}</string>
