			<Item class="ModuleScript" referent="RBX505BC80466824A8E9D61B9A30BA6A729">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Queue, track vote, race simulation, local opponents, results and rewards.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local KartBuilder = require(game.ReplicatedStorage.Shared.KartBuilder)
local Profiles = require(script.Parent.Profiles)
local Remotes = game.ReplicatedStorage.Remotes

local Race = {}
local VOTE_SECONDS = 12
local REVEAL_SECONDS = 3
local COUNTDOWN_SECONDS = 4
local RACERS = 6
local REQUIRED = { Solo = 1, Duo = 2 }
local BOT_NAMES = { "Nyx", "Ravex", "Juno-7", "Static", "Halcyon", "Kestrel" }
local BOT_COLORS = { Color3.fromRGB(255, 70, 100), Color3.fromRGB(255, 190, 50), Color3.fromRGB(70, 240, 150), Color3.fromRGB(140, 60, 255), Color3.fromRGB(255, 140, 0), Color3.fromRGB(0, 120, 255) }

local karts = workspace:FindFirstChild("Karts") or Instance.new("Folder")
karts.Name = "Karts"
karts.Parent = workspace

local queue: { { player: Player, mode: string } } = {}
local state: any = { phase = "idle", raceId = 0 }
local testKarts: { [Player]: Model } = {}

local function now(): number return workspace:GetServerTimeNow() end

local function inQueue(player: Player): number?
	for i, e in queue do if e.player == player then return i end end
	return nil
end

local function trackLength(points: { Vector3 }): ({ number }, number)
	local cum, total = { 0 }, 0
	for i = 1, #points do
		total += (points[i % #points + 1] - points[i]).Magnitude
		cum[i + 1] = total
	end
	return cum, total
end

local function pointAt(points: { Vector3 }, cum: { number }, total: number, s: number): (Vector3, Vector3)
	s = s % total
	local n = #points
	local lo = 1
	for i = 1, n do
		if cum[i + 1] >= s then lo = i break end
	end
	local a, b = points[lo], points[lo % n + 1]
	local t = (s - cum[lo]) / math.max(cum[lo + 1] - cum[lo], 0.001)
	return a:Lerp(b, t), (b - a).Unit
end

-- Progress along the closed centerline near the last known index.
local function project(points: { Vector3 }, pos: Vector3, lastIdx: number): (number, number)
	local n = #points
	local bestIdx, bestT, bestD = lastIdx, 0, math.huge
	for off = -3, 4 do
		local i = (lastIdx - 1 + off) % n + 1
		local a, b = points[i], points[i % n + 1]
		local ab = b - a
		local flat = Vector3.new(pos.X, 0, pos.Z)
		local t = math.clamp((flat - a):Dot(ab) / ab:Dot(ab), 0, 1)
		local d = (a + ab * t - flat).Magnitude
		if d < bestD then bestD, bestIdx, bestT = d, i, t end
	end
	return bestIdx, bestT
end

local function payload(): any
	local s = state
	local racers = {}
	if s.racers then
		for _, r in s.racers do
			table.insert(racers, { key = r.key, name = r.name, userId = r.userId, bot = r.bot, color = r.color, lap = math.min(r.lap, s.laps), progress = r.progress, position = r.position, finished = r.finished, finishTime = r.finishTime, out = r.out, outLap = r.outLap })
		end
	end
	local queued = {}
	for _, e in queue do table.insert(queued, { userId = e.player.UserId, name = e.player.DisplayName, mode = e.mode }) end
	return {
		phase = s.phase, raceId = s.raceId, mode = s.mode, required = s.mode and REQUIRED[s.mode] or nil, queued = queued,
		participants = s.participants, voteEnds = s.voteEnds, votes = s.votes, voters = s.voters, winner = s.winner,
		countdownEnd = s.countdownEnd, startTime = s.startTime, laps = s.laps, track = s.track and s.track.id,
		raceMode = s.track and s.track.mode, racers = racers, feed = s.feed, results = s.results, serverNow = now(),
		message = s.message,
	}
end
local function broadcast()
	Remotes.Race:FireAllClients(payload())
end
Race.broadcast = broadcast

local function setMode(player: Player, mode: string)
	player:SetAttribute("Mode", mode)
end

local function freeCharacter(player: Player, spawnAtHub: boolean)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Sit = false
		hum.JumpHeight = 7.2
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	end
	if char and spawnAtHub then
		task.defer(function()
			if char.Parent then
				char:PivotTo(CFrame.new(GameData.HubSpawn + Vector3.new(math.random(-6, 6), 2, math.random(-4, 4))))
			end
		end)
	end
end

local function physicsRig(root: BasePart)
	local att = Instance.new("Attachment")
	att.Name = "Drive"
	att.Parent = root
	local lv = Instance.new("LinearVelocity")
	lv.Name = "Velocity"
	lv.Attachment0 = att
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	lv.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	lv.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.MaxForce = 4e5
	lv.PlaneVelocity = Vector2.zero
	lv.Parent = root
	local ao = Instance.new("AlignOrientation")
	ao.Name = "Align"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = 1e7
	ao.Responsiveness = 40
	ao.CFrame = root.CFrame.Rotation
	ao.Parent = root
end

-- Build and seat a player's kart using their accepted loadout.
local function playerKart(player: Player, kartId: string, cf: CFrame, name: string): Model?
	local p = Profiles.get(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not p or not char or not hum or hum.Health <= 0 then return nil end
	local model = KartBuilder.build(kartId, p.livery, Profiles.glow(p), true)
	model.Name = name
	model:PivotTo(cf)
	local root = model.PrimaryPart :: BasePart
	root.Anchored = true
	local stats = Profiles.kartStats(p, kartId)
	for k, v in stats do model:SetAttribute(k, v) end
	model:SetAttribute("Owner", player.UserId)
	model:SetAttribute("KartId", kartId)
	physicsRig(root)
	model.Parent = karts
	hum.JumpHeight = 0
	hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	for _, part in char:GetDescendants() do
		if part:IsA("BasePart") then part.Massless = true end
	end
	local seat = model:FindFirstChild("Seat") :: Seat
	char:PivotTo(seat.CFrame * CFrame.new(0, 2, 0))
	task.wait()
	seat:Sit(hum)
	player:SetAttribute("Kart", name)
	return model
end

local function release(model: Model, player: Player?)
	local root = model.PrimaryPart :: BasePart
	root.Anchored = false
	if player then
		pcall(function() root:SetNetworkOwner(player) end)
	end
end

local function destroyKart(player: Player)
	local name = player:GetAttribute("Kart")
	if name then
		local m = karts:FindFirstChild(name)
		if m then m:Destroy() end
	end
	player:SetAttribute("Kart", nil)
end

local function cancel(reason: string)
	if state.racers then
		for _, r in state.racers do
			if r.player then
				destroyKart(r.player)
				setMode(r.player, "hub")
				freeCharacter(r.player, true)
			end
		end
	end
	for _, m in karts:GetChildren() do
		if m:GetAttribute("RaceId") == state.raceId then m:Destroy() end
	end
	state = { phase = "idle", raceId = state.raceId, message = reason }
	broadcast()
	for _, pl in Players:GetPlayers() do
		Remotes.Notify:FireClient(pl, { kind = "warning", text = reason })
	end
end

-- Rewards are granted once per race id and player.
local function grant(r: any)
	if r.rewarded or not r.player then return end
	r.rewarded = true
	local p = Profiles.get(r.player)
	if not p then return end
	local base = GameData.RaceRewards[r.position] or GameData.RaceRewards[#GameData.RaceRewards]
	local credits, gems, xp = base.credits, base.gems, base.xp
	if not r.finished then
		credits, gems, xp = math.floor(credits / 3), 0, math.floor(xp / 3)
	end
	local t = os.time()
	local xpBoost = (p.boosts.xp2 or 0) > t
	local crBoost = (p.boosts.cr2 or 0) > t
	if xpBoost then xp *= 2 end
	if crBoost then credits = math.floor(credits * 1.5) end
	local levelBefore = p.level
	p.credits += credits
	p.gems += gems
	Profiles.addXp(p, xp)
	p.races += 1
	if r.position <= 3 and r.finished then p.podiums += 1 end
	if r.position == 1 and r.finished then p.wins += 1 end
	r.reward = { credits = credits, gems = gems, xp = xp, xpBoost = xpBoost, creditBoost = crBoost, levelUp = p.level > levelBefore, level = p.level }
	p.lastRace = { raceId = state.raceId, position = r.position, reward = r.reward }
	Profiles.changed(r.player)
end

local function rank()
	local list = table.clone(state.racers)
	table.sort(list, function(a, b)
		if a.finished ~= b.finished then return a.finished end
		if a.finished then return a.finishTime < b.finishTime end
		if a.out ~= b.out then return not a.out end
		if a.out then return a.outOrder > b.outOrder end
		if a.progress ~= b.progress then return a.progress > b.progress end
		return a.key < b.key
	end)
	for i, r in list do r.position = i end
end

local function finishRace()
	rank()
	state.phase = "results"
	state.resultsEnd = now() + 25
	local results = {}
	local ordered = table.clone(state.racers)
	table.sort(ordered, function(a, b) return a.position < b.position end)
	for _, r in ordered do
		grant(r)
		if r.model and r.bot then
			(r.model.PrimaryPart :: BasePart).Anchored = true
		end
		table.insert(results, { key = r.key, name = r.name, userId = r.userId, bot = r.bot, position = r.position, finished = r.finished, finishTime = r.finishTime and (r.finishTime - state.startTime) or nil, out = r.out, reward = r.reward })
	end
	state.results = results
	for _, r in state.racers do
		if r.player then
			local root = r.model and r.model.PrimaryPart
			if root then root.Anchored = true end
		end
	end
	broadcast()
	local id = state.raceId
	task.delay(25, function()
		if state.raceId == id and state.phase == "results" then
			Race.endRace()
		end
	end)
end

function Race.endRace()
	if state.racers then
		for _, r in state.racers do
			if r.player then
				destroyKart(r.player)
				setMode(r.player, "hub")
				freeCharacter(r.player, true)
				Profiles.push(r.player)
			end
		end
	end
	for _, m in karts:GetChildren() do
		if m:GetAttribute("RaceId") ~= nil then m:Destroy() end
	end
	state = { phase = "idle", raceId = state.raceId }
	broadcast()
	Race.tryStart()
end

local function startRace()
	local track = state.track
	local points = track.points
	local cum, total = trackLength(points)
	state.cum, state.total = cum, total
	state.laps = track.laps
	state.feed = {}
	state.racers = {}
	state.lapDone = {}
	local slot = 0
	local function gridCF(i: number): CFrame
		local back = 14 + math.floor((i - 1) / 2) * 16
		local side = if i % 2 == 1 then -9 else 9
		local pos, dir = pointAt(points, cum, total, total - back)
		local right = dir:Cross(Vector3.yAxis).Unit
		local p = pos + right * side + Vector3.new(0, 1.3, 0)
		return CFrame.lookAt(p, p + dir)
	end
	for _, pl in state.participants do
		local player = Players:GetPlayerByUserId(pl.userId)
		if player then
			slot += 1
			local name = "Race_" .. player.UserId
			local model = playerKart(player, (Profiles.get(player) :: any).selectedKart, gridCF(slot), name)
			if model then
				model:SetAttribute("RaceId", state.raceId)
				setMode(player, "race")
				table.insert(state.racers, { key = "p" .. player.UserId, name = player.DisplayName, userId = player.UserId, bot = false, player = player, model = model, color = nil, lap = 0, idx = 1, progress = -0.5, finished = false, out = false })
			end
		end
	end
	if #state.racers == 0 then
		cancel("Race cancelled: no racers could start")
		return
	end
	local rng = Random.new(state.raceId)
	local b = 0
	while #state.racers < RACERS do
		b += 1
		slot += 1
		local color = BOT_COLORS[b]
		local kart = GameData.Karts[(b % 7) + 1]
		local livery = { body = GameData.Swatches[(b % 6) + 1].id, bodyShade = 100, accent = GameData.Swatches[((b + 2) % 6) + 1].id, accentShade = 100, decal = GameData.Decals[(b % 6) + 1] }
		local model = KartBuilder.build(kart.id, livery, color, false)
		KartBuilder.addPilot(model, color)
		model.Name = "Bot_" .. b
		local cf = gridCF(slot)
		model:PivotTo(cf)
		;(model.PrimaryPart :: BasePart).Anchored = true
		for _, d in model:GetDescendants() do if d:IsA("BasePart") then d.CanCollide = false end end
		model:SetAttribute("RaceId", state.raceId)
		model.Parent = karts
		local _, back = 0, 0
		local s0 = total - (14 + math.floor((slot - 1) / 2) * 16)
		table.insert(state.racers, { key = "b" .. b, name = BOT_NAMES[b] .. " (CPU)", userId = 0, bot = true, model = model, color = { color.R, color.G, color.B }, lap = 0, idx = 1, progress = -0.5, finished = false, out = false,
			s = s0, lane = if slot % 2 == 1 then -9 else 9, speed = 57 + rng:NextNumber(0, 11) + (if track.mode == "Knockout" then 2 else 0), wobble = rng:NextNumber(0, 6) })
	end
	state.phase = "countdown"
	state.countdownEnd = now() + COUNTDOWN_SECONDS
	broadcast()
	local id = state.raceId
	task.delay(COUNTDOWN_SECONDS, function()
		if state.raceId ~= id or state.phase ~= "countdown" then return end
		state.phase = "racing"
		state.startTime = now()
		for _, r in state.racers do
			if r.player then release(r.model, r.player) end
		end
		broadcast()
	end)
end

local function knockout(r: any, lap: number)
	r.out = true
	r.outLap = lap
	state.outCount = (state.outCount or 0) + 1
	r.outOrder = state.outCount
	table.insert(state.feed, 1, { text = r.name .. " is OUT", lap = lap, t = now() })
	while #state.feed > 4 do table.remove(state.feed) end
	if r.model then
		local root = r.model.PrimaryPart :: BasePart
		root.Anchored = true
		for _, d in r.model:GetDescendants() do
			if d:IsA("BasePart") and d.Material == Enum.Material.Neon then d.Color = Color3.fromRGB(90, 90, 110) end
		end
	end
	if r.player then
		Remotes.Notify:FireClient(r.player, { kind = "danger", text = "You are OUT · last after lap " .. lap })
	end
end

local function lapCompleted(r: any, lap: number)
	if state.track.mode ~= "Knockout" or lap >= state.laps then return end
	state.lapDone[lap] = state.lapDone[lap] or {}
	table.insert(state.lapDone[lap], r.key)
	local active = {}
	for _, x in state.racers do if not x.out then table.insert(active, x) end end
	if #active <= 2 then return end
	if #state.lapDone[lap] == #active - 1 then
		for _, x in active do
			if not table.find(state.lapDone[lap], x.key) then
				knockout(x, lap)
			end
		end
	end
end

local function updateRacer(r: any, dt: number)
	if r.finished or r.out then return end
	local points = state.track.points
	local n = #points
	local pos: Vector3
	if r.bot then
		local leaderPlayer = -math.huge
		for _, x in state.racers do if x.player and not x.out then leaderPlayer = math.max(leaderPlayer, x.progress) end end
		local speed = r.speed
		if leaderPlayer > -math.huge then
			local gap = (r.progress - leaderPlayer)
			if gap > 0.12 then speed *= 0.88 elseif gap < -0.2 then speed *= 1.14 elseif gap < -0.08 then speed *= 1.05 end
		end
		r.s += speed * dt
		local p, dir = pointAt(points, state.cum, state.total, r.s)
		local right = dir:Cross(Vector3.yAxis).Unit
		local lane = r.lane + math.sin(now() * 0.4 + r.wobble) * 4
		pos = p + right * lane
		local root = r.model.PrimaryPart :: BasePart
		local look = root.CFrame.LookVector:Lerp(dir, math.min(1, dt * 6))
		r.model:PivotTo(CFrame.lookAt(pos + Vector3.new(0, 1.2, 0), pos + Vector3.new(0, 1.2, 0) + Vector3.new(look.X, 0, look.Z)))
	else
		local root = r.model and r.model.PrimaryPart
		if not root or not r.model.Parent then return end
		pos = root.Position
	end
	if state.phase ~= "racing" then return end
	local idx, t = project(points, pos, r.idx)
	if r.idx == n and idx == 1 then
		r.lap += 1
		if r.lap >= 1 then lapCompleted(r, r.lap) end
	elseif r.idx == 1 and idx == n then
		r.lap -= 1
	end
	r.idx = idx
	r.progress = r.lap + ((idx - 1) + t) / n
	if r.lap >= state.laps and not r.out then
		r.finished = true
		r.finishTime = now()
		if r.player then
			local root = r.model.PrimaryPart :: BasePart
			if root then root.Anchored = true end
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	if state.phase ~= "racing" and state.phase ~= "countdown" then return end
	if state.phase == "racing" then
		for _, r in state.racers do updateRacer(r, dt) end
		rank()
		local playersLeft, anyLeft = false, false
		for _, r in state.racers do
			if not r.finished and not r.out then
				anyLeft = true
				if r.player then playersLeft = true end
			end
		end
		if not anyLeft then
			finishRace()
		elseif not playersLeft then
			state.graceEnd = state.graceEnd or (now() + 12)
			if now() > state.graceEnd then finishRace() end
		elseif now() - state.startTime > 420 then
			finishRace()
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.2)
		if state.phase == "racing" or state.phase == "countdown" then broadcast() end
	end
end)

local function tally()
	local votes = {}
	for _, t in GameData.Tracks do votes[t.id] = 0 end
	for _, v in state.voters do votes[v] = (votes[v] or 0) + 1 end
	state.votes = votes
end

local function beginVote(entries: { any }, mode: string)
	state = { phase = "voting", raceId = state.raceId + 1, mode = mode, participants = {}, voters = {}, voteEnds = now() + VOTE_SECONDS }
	for _, e in entries do
		table.insert(state.participants, { userId = e.player.UserId, name = e.player.DisplayName })
		local i = inQueue(e.player)
		if i then table.remove(queue, i) end
	end
	tally()
	broadcast()
	local id = state.raceId
	-- Local opponents vote at staggered times.
	local rng = Random.new(id * 13)
	for b = 1, RACERS - #entries do
		task.delay(rng:NextNumber(1.5, VOTE_SECONDS - 2), function()
			if state.raceId ~= id or state.phase ~= "voting" then return end
			state.voters["b" .. b] = GameData.Tracks[rng:NextInteger(1, #GameData.Tracks)].id
			tally()
			broadcast()
		end)
	end
	task.delay(VOTE_SECONDS, function()
		if state.raceId ~= id or state.phase ~= "voting" then return end
		tally()
		local best, bestCount = {}, -1
		for _, t in GameData.Tracks do
			local c = state.votes[t.id]
			if c > bestCount then best, bestCount = { t }, c elseif c == bestCount then table.insert(best, t) end
		end
		state.track = best[rng:NextInteger(1, #best)]
		state.winner = state.track.id
		state.phase = "reveal"
		state.revealEnd = now() + REVEAL_SECONDS
		broadcast()
		task.delay(REVEAL_SECONDS, function()
			if state.raceId ~= id or state.phase ~= "reveal" then return end
			startRace()
		end)
	end)
end

function Race.tryStart()
	if state.phase ~= "idle" then return end
	for _, e in queue do
		if e.mode == "Solo" then
			beginVote({ e }, "Solo")
			return
		end
	end
	local duo = {}
	for _, e in queue do if e.mode == "Duo" then table.insert(duo, e) end end
	if #duo >= 2 then
		beginVote({ duo[1], duo[2] }, "Duo")
	end
end

local function isParticipant(player: Player): boolean
	if not state.participants then return false end
	for _, p in state.participants do if p.userId == player.UserId then return true end end
	return false
end

function Race.request(player: Player, action: string, args: any): any
	if action == "queue" then
		if args ~= "Solo" and args ~= "Duo" then return { ok = false, message = "Choose Solo or Duo" } end
		if player:GetAttribute("Mode") == "test" then Race.endTest(player) end
		if isParticipant(player) then return { ok = false, message = "You are already in this race" } end
		local i = inQueue(player)
		if i then queue[i].mode = args else table.insert(queue, { player = player, mode = args }) end
		broadcast()
		Race.tryStart()
		return { ok = true, message = "Queued for " .. args }
	elseif action == "leaveQueue" then
		local i = inQueue(player)
		if i then
			table.remove(queue, i)
			broadcast()
			return { ok = true, message = "Left the queue" }
		end
		if isParticipant(player) and (state.phase == "voting" or state.phase == "reveal") then
			cancel("Race cancelled: " .. player.DisplayName .. " left before the start")
			return { ok = true, message = "Left the race lobby" }
		end
		return { ok = false, message = "You are not in a queue" }
	elseif action == "vote" then
		if state.phase ~= "voting" then return { ok = false, message = "Voting is closed" } end
		if not isParticipant(player) then return { ok = false, message = "Only racers can vote" } end
		if not GameData.find(GameData.Tracks, args) then return { ok = false, message = "Unknown track" } end
		state.voters["p" .. player.UserId] = args
		tally()
		broadcast()
		return { ok = true, message = "Vote counted" }
	elseif action == "returnToHub" then
		if state.phase == "results" and isParticipant(player) then
			for _, r in state.racers do
				if r.player == player then
					destroyKart(player)
					setMode(player, "hub")
					freeCharacter(player, true)
				end
			end
			return { ok = true, message = "Back in the hub" }
		end
		return { ok = false, message = "No finished race" }
	elseif action == "testDrive" then
		local p = Profiles.get(player)
		if not p or not GameData.find(GameData.Karts, args) then return { ok = false, message = "Unknown kart" } end
		if player:GetAttribute("Mode") == "race" or inQueue(player) or isParticipant(player) then return { ok = false, message = "Leave the race queue first" } end
		Race.endTest(player, true)
		local pts = GameData.PracticePoints
		local cf = CFrame.lookAt(pts[1] + Vector3.new(0, 1.3, 0), pts[2] + Vector3.new(0, 1.3, 0))
		local model = playerKart(player, args, cf, "Test_" .. player.UserId)
		if not model then return { ok = false, message = "Respawn first" } end
		testKarts[player] = model
		setMode(player, "test")
		release(model, player)
		return { ok = true, message = "Test drive started" }
	elseif action == "endTest" then
		Race.endTest(player)
		return { ok = true, message = "Back in the hub" }
	end
	return { ok = false, message = "Unknown request" }
end

function Race.endTest(player: Player, keepMode: boolean?)
	local m = testKarts[player]
	if m then
		m:Destroy()
		testKarts[player] = nil
		player:SetAttribute("Kart", nil)
		if not keepMode then
			setMode(player, "hub")
			freeCharacter(player, true)
		end
	end
end

function Race.playerLeft(player: Player)
	local i = inQueue(player)
	if i then table.remove(queue, i) end
	Race.endTest(player, true)
	if isParticipant(player) then
		if state.phase == "voting" or state.phase == "reveal" or state.phase == "countdown" then
			cancel("Race cancelled: " .. player.DisplayName .. " left before the start")
		elseif state.racers then
			for _, r in state.racers do
				if r.player == player and not r.finished then
					r.out = true
					r.outOrder = 0
					r.player = nil
				end
			end
		end
	end
	broadcast()
end

function Race.characterReset(player: Player)
	-- A respawn during a race leaves the kart; the race keeps the racer's progress but the kart is gone.
	if player:GetAttribute("Mode") == "test" then Race.endTest(player) end
end

Race.payload = payload
return Race
]]></ProtectedString>
