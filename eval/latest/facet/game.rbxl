-- Static game data shared by server and client. The server owns all balances and validation.
local GameData = {}

export type Kart = { id: string, name: string, category: string, rarity: string, speed: number, handling: number, boost: number, price: number, body: Color3, accent: Color3, blurb: string }
export type Part = { id: string, name: string, slot: string, price: number, currency: string, speed: number, handling: number, boost: number, blurb: string, glow: Color3? }
export type Driver = { id: string, name: string, group: string, price: number, rent: number, accel: number, drift: number, boost: number, blurb: string, color: Color3 }

GameData.RarityOrder = { Common = 1, Rare = 2, Epic = 3, Legendary = 4 } :: { [string]: number }
GameData.RarityColor = {
	Common = Color3.fromRGB(150, 190, 225), Rare = Color3.fromRGB(0, 229, 255),
	Epic = Color3.fromRGB(255, 46, 196), Legendary = Color3.fromRGB(255, 190, 50),
} :: { [string]: Color3 }

GameData.Karts = {
	{ id = "volt", name = "Volt Runner", category = "Balanced", rarity = "Common", speed = 62, handling = 60, boost = 55, price = 0, body = Color3.fromRGB(0, 170, 255), accent = Color3.fromRGB(0, 255, 230), blurb = "A forgiving all-rounder tuned for first circuits." },
	{ id = "pulse", name = "Pulse Dart", category = "Speed", rarity = "Common", speed = 70, handling = 48, boost = 52, price = 1200, body = Color3.fromRGB(255, 70, 100), accent = Color3.fromRGB(255, 190, 50), blurb = "Light frame, long straights, nervous in corners." },
	{ id = "drift", name = "Drift Specter", category = "Grip", rarity = "Rare", speed = 60, handling = 78, boost = 58, price = 2400, body = Color3.fromRGB(140, 60, 255), accent = Color3.fromRGB(0, 229, 255), blurb = "Holds a slide forever and banks charge fast." },
	{ id = "comet", name = "Comet GT", category = "Speed", rarity = "Rare", speed = 76, handling = 52, boost = 60, price = 3200, body = Color3.fromRGB(255, 140, 0), accent = Color3.fromRGB(255, 255, 255), blurb = "Raw top speed with a heavy boost tank." },
	{ id = "bastion", name = "Bastion Hauler", category = "Balanced", rarity = "Common", speed = 58, handling = 64, boost = 70, price = 900, body = Color3.fromRGB(60, 200, 120), accent = Color3.fromRGB(200, 255, 80), blurb = "Huge boost reserve, steady and planted." },
	{ id = "wraith", name = "Neon Wraith", category = "Grip", rarity = "Epic", speed = 72, handling = 80, boost = 62, price = 5200, body = Color3.fromRGB(20, 20, 40), accent = Color3.fromRGB(255, 46, 196), blurb = "Razor handling for drivers who never lift." },
	{ id = "quasar", name = "Quasar X", category = "Speed", rarity = "Epic", speed = 84, handling = 58, boost = 66, price = 6800, body = Color3.fromRGB(0, 90, 255), accent = Color3.fromRGB(255, 46, 196), blurb = "Experimental ion core. Brutal on the straights." },
	{ id = "aurora", name = "Aurora Prime", category = "Balanced", rarity = "Legendary", speed = 82, handling = 76, boost = 78, price = 0, body = Color3.fromRGB(255, 255, 255), accent = Color3.fromRGB(0, 255, 200), blurb = "Day-7 streak reward. Cannot be bought." },
} :: { Kart }

GameData.PartSlots = { "motor", "boost", "wheels", "cosmetic" }
GameData.SlotLabel = { motor = "Motor", boost = "Boost", wheels = "Wheels", cosmetic = "Cosmetic" } :: { [string]: string }
GameData.Parts = {
	{ id = "m_ion", name = "Ion Motor", slot = "motor", price = 600, currency = "credits", speed = 4, handling = 0, boost = 0, blurb = "+4 speed" },
	{ id = "m_fusion", name = "Fusion Motor", slot = "motor", price = 1800, currency = "credits", speed = 8, handling = -2, boost = 0, blurb = "+8 speed, -2 handling" },
	{ id = "m_singularity", name = "Singularity Core", slot = "motor", price = 4500, currency = "credits", speed = 12, handling = 0, boost = 2, blurb = "+12 speed, +2 boost" },
	{ id = "b_spark", name = "Spark Injector", slot = "boost", price = 500, currency = "credits", speed = 0, handling = 0, boost = 5, blurb = "+5 boost" },
	{ id = "b_nova", name = "Nova Tank", slot = "boost", price = 1500, currency = "credits", speed = 0, handling = 0, boost = 10, blurb = "+10 boost" },
	{ id = "b_hyper", name = "Hyperburst", slot = "boost", price = 40, currency = "gems", speed = 2, handling = 0, boost = 14, blurb = "+14 boost, +2 speed" },
	{ id = "w_grip", name = "Grip Rings", slot = "wheels", price = 450, currency = "credits", speed = 0, handling = 5, boost = 0, blurb = "+5 handling" },
	{ id = "w_mag", name = "Mag Hover Pads", slot = "wheels", price = 1400, currency = "credits", speed = 1, handling = 9, boost = 0, blurb = "+9 handling, +1 speed" },
	{ id = "w_phase", name = "Phase Rims", slot = "wheels", price = 3800, currency = "credits", speed = 3, handling = 12, boost = 0, blurb = "+12 handling, +3 speed" },
	{ id = "c_cyan", name = "Cyan Underglow", slot = "cosmetic", price = 300, currency = "credits", speed = 0, handling = 0, boost = 0, blurb = "Cyan glow under the kart", glow = Color3.fromRGB(0, 229, 255) },
	{ id = "c_magenta", name = "Magenta Trail", slot = "cosmetic", price = 800, currency = "credits", speed = 0, handling = 0, boost = 0, blurb = "Magenta glow and trail", glow = Color3.fromRGB(255, 46, 196) },
	{ id = "c_gold", name = "Gold Halo", slot = "cosmetic", price = 25, currency = "gems", speed = 0, handling = 0, boost = 0, blurb = "Prestige gold glow", glow = Color3.fromRGB(255, 190, 50) },
} :: { Part }

GameData.DriverGroups = { "Pilots", "Mechanics", "Legends" }
GameData.Drivers = {
	{ id = "kit", name = "Kit", group = "Pilots", price = 0, rent = 0, accel = 2, drift = 2, boost = 2, blurb = "Rookie pilot. Steady everywhere.", color = Color3.fromRGB(0, 229, 255) },
	{ id = "juno", name = "Juno", group = "Pilots", price = 1500, rent = 200, accel = 6, drift = 3, boost = 2, blurb = "Explosive launches off every corner.", color = Color3.fromRGB(255, 70, 100) },
	{ id = "bolt", name = "Bolt", group = "Mechanics", price = 1800, rent = 250, accel = 2, drift = 3, boost = 7, blurb = "Squeezes extra charge from every tank.", color = Color3.fromRGB(255, 190, 50) },
	{ id = "rivet", name = "Rivet", group = "Mechanics", price = 1200, rent = 150, accel = 3, drift = 6, boost = 1, blurb = "Builds drift charge fast.", color = Color3.fromRGB(70, 240, 150) },
	{ id = "zephyr", name = "Zephyr", group = "Legends", price = 60, rent = 10, accel = 6, drift = 6, boost = 5, blurb = "Champion of the first neon cup.", color = Color3.fromRGB(255, 46, 196) },
	{ id = "orion", name = "Orion", group = "Legends", price = 80, rent = 12, accel = 5, drift = 5, boost = 8, blurb = "Never seen without a full boost bar.", color = Color3.fromRGB(140, 60, 255) },
} :: { Driver }
-- Legends are priced in gems; others in credits.
function GameData.driverCurrency(d: Driver): string
	return if d.group == "Legends" then "gems" else "credits"
end
GameData.RentalSeconds = 600

GameData.Swatches = {
	{ id = "Red", color = Color3.fromRGB(255, 50, 80) }, { id = "Amber", color = Color3.fromRGB(255, 176, 0) },
	{ id = "Green", color = Color3.fromRGB(40, 230, 120) }, { id = "Cyan", color = Color3.fromRGB(0, 229, 255) },
	{ id = "Blue", color = Color3.fromRGB(40, 100, 255) }, { id = "Violet", color = Color3.fromRGB(160, 70, 255) },
} :: { { id: string, color: Color3 } }
GameData.Shades = { 50, 75, 100 }
GameData.Decals = { "None", "Stripe", "Twin", "Chevron", "Checker", "Bolt" }
function GameData.swatchColor(id: string, shade: number): Color3
	for _, s in GameData.Swatches do
		if s.id == id then
			return Color3.new(0, 0, 0):Lerp(s.color, shade / 100)
		end
	end
	return Color3.new(1, 1, 1)
end
GameData.DefaultLivery = { body = "Cyan", bodyShade = 100, accent = "Violet", accentShade = 100, decal = "Stripe" }

GameData.UpgradeStats = { "speed", "handling", "boost" }
GameData.MaxUpgrade = 5
function GameData.upgradeCost(level: number): (number, number)
	return 250 * (level + 1), 2 * (level + 1)
end
GameData.UpgradeStep = 3

GameData.Rarities = { "Common", "Rare", "Epic", "Legendary" }
GameData.Cards = {
	{ id = "c1", name = "Grid Ghost", rarity = "Common" }, { id = "c2", name = "Volt Sprite", rarity = "Common" },
	{ id = "c3", name = "Chrome Fox", rarity = "Common" }, { id = "c4", name = "Ion Moth", rarity = "Common" },
	{ id = "c5", name = "Laser Lynx", rarity = "Common" }, { id = "c6", name = "Data Drake", rarity = "Common" },
	{ id = "c7", name = "Pulse Wolf", rarity = "Rare" }, { id = "c8", name = "Neon Koi", rarity = "Rare" },
	{ id = "c9", name = "Prism Owl", rarity = "Rare" }, { id = "c10", name = "Arc Viper", rarity = "Rare" },
	{ id = "c11", name = "Nova Hawk", rarity = "Epic" }, { id = "c12", name = "Void Ray", rarity = "Epic" },
	{ id = "c13", name = "Quasar Cat", rarity = "Epic" }, { id = "c14", name = "Helix Titan", rarity = "Legendary" },
	{ id = "c15", name = "Aurora Phoenix", rarity = "Legendary" }, { id = "c16", name = "Circuit Dragon", rarity = "Legendary" },
}
GameData.Crates = {
	{ id = "spark", name = "Spark Crate", price = 300, currency = "credits", cards = 3, odds = { Common = 64, Rare = 26, Epic = 8, Legendary = 2 } },
	{ id = "nova", name = "Nova Crate", price = 25, currency = "gems", cards = 5, odds = { Common = 40, Rare = 35, Epic = 18, Legendary = 7 } },
}

GameData.Daily = {
	{ day = 1, label = "200 Credits", credits = 200 }, { day = 2, label = "3 Gems", gems = 3 },
	{ day = 3, label = "Free Spark Crate", crate = 1 }, { day = 4, label = "400 Credits", credits = 400 },
	{ day = 5, label = "8 Gems", gems = 8 }, { day = 6, label = "700 Credits", credits = 700 },
	{ day = 7, label = "Aurora Prime kart + 30 Gems", gems = 30, kart = "aurora", special = true },
}

GameData.Quests = {
	{ id = "q_races", label = "Finish 3 races", stat = "races", goal = 3, credits = 400, gems = 0 },
	{ id = "q_podium", label = "Finish on the podium 2 times", stat = "podiums", goal = 2, credits = 300, gems = 3 },
	{ id = "q_crate", label = "Open a crate", stat = "crates", goal = 1, credits = 150, gems = 1 },
	{ id = "q_buy", label = "Buy a shop part", stat = "parts", goal = 1, credits = 200, gems = 0 },
}
GameData.Boosts = {
	{ id = "xp2", name = "Double XP", minutes = 15, gems = 15, blurb = "Doubles race XP for 15 minutes." },
	{ id = "cr2", name = "Credit Surge", minutes = 15, gems = 20, blurb = "+50% race credits for 15 minutes." },
}
GameData.Offer = { id = "starter", name = "Neon Starter Pack", gems = 30, minutes = 20, maxLevel = 10,
	credits = 2000, part = "c_cyan", blurb = "2,000 Credits and Cyan Underglow. New racers below level 10." }

GameData.Codes = {
	NEON2026 = { credits = 1000, gems = 10, label = "1,000 Credits and 10 Gems" },
	GRIDSTART = { credits = 500, gems = 0, label = "500 Credits" },
	LAUNCH2025 = { expired = true },
} :: { [string]: any }
GameData.SampleCode = "NEON2026"

GameData.RaceRewards = {
	{ credits = 600, gems = 5, xp = 150 }, { credits = 420, gems = 3, xp = 120 }, { credits = 300, gems = 2, xp = 100 },
	{ credits = 200, gems = 1, xp = 80 }, { credits = 150, gems = 1, xp = 70 }, { credits = 100, gems = 0, xp = 60 },
}
function GameData.xpForLevel(level: number): number
	return 200 + (level - 1) * 100
end

GameData.QuickChat = { "Good luck!", "Nice drift!", "On your left!", "GG!", "Rematch?", "Wait for me!", "Wow!", "Thanks!" }

GameData.Mechanic = { name = "Sprocket", job = "Collect 3 power cells around the hub", goal = 3, credits = 500, gems = 5 }

-- Tracks: centerline points in driving order. Index 1 is the start/finish line.
local function build(cx: number, cz: number, n: number, fn: (number) -> (number, number)): { Vector3 }
	local pts = {}
	for i = 0, n - 1 do
		local x, z = fn(i / n * math.pi * 2)
		table.insert(pts, Vector3.new(cx + x, 0, cz + z))
	end
	return pts
end
GameData.Tracks = {
	{ id = "loop", name = "Neon Loop", mode = "Classic", laps = 3, blurb = "Wide sweepers and long straights. Classic 3-lap race.",
		color = Color3.fromRGB(0, 229, 255),
		points = build(0, 900, 40, function(t)
			local c, s = math.cos(t), math.sin(t)
			local function se(v: number): number return math.sign(v) * math.abs(v) ^ 0.5 end
			return 320 * se(c), 170 * se(s)
		end) },
	{ id = "helix", name = "Helix Circuit", mode = "Classic", laps = 3, blurb = "Three tight hairpins. Drift-boost heaven.",
		color = Color3.fromRGB(255, 46, 196),
		points = build(950, 0, 48, function(t)
			local r = 235 + 55 * math.sin(3 * t)
			return r * math.cos(t), r * math.sin(t)
		end) },
	{ id = "ring", name = "Eliminator Ring", mode = "Knockout", laps = 4, blurb = "Knockout: last place is OUT at the end of laps 1 to 3.",
		color = Color3.fromRGB(255, 190, 50),
		points = build(-950, 0, 36, function(t)
			local r = 220 + 22 * math.sin(2 * t)
			return r * 1.15 * math.cos(t), r * math.sin(t)
		end) },
}
GameData.PracticePoints = build(0, -260, 24, function(t) return 110 * math.cos(t), 70 * math.sin(t) end)
GameData.RoadWidth = 44
GameData.HubSpawn = Vector3.new(0, 3, 30)

function GameData.find<T>(list: { T }, id: string): T?
	for _, item in list do
		if (item :: any).id == id then
			return item
		end
	end
	return nil
end

return GameData
]]></ProtectedString>
