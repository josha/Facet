					</Item>
					<Item class="ModuleScript" referent="RBXE98BD931A25C4C1DBE15D9E771FC5274">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Shared view helpers.
local Players = game:GetService("Players")
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local Common = {}

-- Headshot for an account, or a distinct initial-on-color portrait for a local opponent.
function Common.portrait(ctx: any, size: number, getter: (Facet.Use) -> any): Instance
	local Host = ctx.Host
	return Host.Frame "Portrait" {
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = function(use: Facet.Use): Color3
			local r = getter(use)
			if r and r.bot and r.color then return Color3.new(r.color[1], r.color[2], r.color[3]) end
			return Color3.fromRGB(30, 46, 92)
		end,
		Host.UICorner "Round" { CornerRadius = UDim.new(0.5, 0) },
		Host.UISizeConstraint "Min" { MinSize = Vector2.new(size, size), MaxSize = Vector2.new(size, size) },
		Host.UIStroke "Ring" { Thickness = 2, Color = function(use: Facet.Use): Color3
			local r = getter(use)
			if r and r.userId == Players.LocalPlayer.UserId then return Color3.fromRGB(255, 46, 196) end
			return Color3.fromRGB(0, 229, 255)
		end },
		Host.ImageLabel "Headshot" {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			Image = function(use: Facet.Use): string
				local r = getter(use)
				if r and not r.bot and (r.userId or 0) > 0 then
					return "rbxthumb://type=AvatarHeadShot&id=" .. r.userId .. "&w=150&h=150"
				end
				return ""
			end,
			Host.UICorner "Round" { CornerRadius = UDim.new(0.5, 0) },
		},
		Host.TextLabel "Initial" {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			Visible = function(use: Facet.Use): boolean
				local r = getter(use)
				return r ~= nil and (r.bot == true or (r.userId or 0) <= 0)
			end,
			Text = function(use: Facet.Use): string
				local r = getter(use)
				return if r then "⚙" .. string.sub(r.name or "?", 1, 1) else ""
			end,
			TextColor3 = Color3.fromRGB(2, 10, 20),
			TextScaled = true,
			FontFace = Font.new("rbxasset://fonts/families/Michroma.json", Enum.FontWeight.Bold),
			Host.UIPadding "Pad" { PaddingLeft = UDim.new(0.18, 0), PaddingRight = UDim.new(0.18, 0), PaddingTop = UDim.new(0.22, 0), PaddingBottom = UDim.new(0.22, 0) },
		},
	}
end

function Common.sorted(racers: { any }): { any }
	local list = table.clone(racers or {})
	table.sort(list, function(a, b) return (a.position or 99) < (b.position or 99) end)
	return list
end

function Common.me(racers: { any }): any?
	for _, r in racers or {} do
		if r.userId == Players.LocalPlayer.UserId then return r end
	end
	return nil
end

function Common.price(amount: number, currency: string, fmt: (number) -> string): string
	return fmt(amount) .. (if currency == "gems" then " Gems" else " Credits")
end

local KartBuilder = require(game.ReplicatedStorage.Shared.KartBuilder)
-- A Stage that rebuilds the kart whenever its kart id or livery readable changes.
function Common.preview(ctx: any, height: number, kartFn: (Facet.Use) -> string, liveryFn: (Facet.Use) -> any, glowFn: ((Facet.Use) -> Color3?)?): Instance
	local UI, C, Host = ctx.UI, ctx.C, ctx.Host
	return Host.Frame "PreviewBox" {
		Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1,
		UI.Stage "Preview" {
			Size = UDim2.fromScale(1, 1),
			camera = CFrame.lookAt(Vector3.new(11, 6.5, -12), Vector3.new(0, 1.4, 0)),
			fieldOfView = 40,
			content = function(runtime: any, world: Instance)
				local H = runtime.constructors
				local current: Model? = nil
				H.Folder "Holder" {
					Parent = C.static(world),
					Name = function(use: Facet.Use): string
						local id, livery = kartFn(use), liveryFn(use)
						local glow = if glowFn then glowFn(use) else nil
						if current then current:Destroy() end
						local m = KartBuilder.build(id, livery, glow, false)
						for _, d in m:GetDescendants() do if d:IsA("BasePart") then d.Anchored = true end end
						m:PivotTo(CFrame.new(0, 1.2, 0) * CFrame.Angles(0, math.rad(20), 0))
						m.Parent = world
						current = m
						return "Holder"
					end,
				}
				C.cleanup(function() if current then current:Destroy() end end)
				return nil
			end,
		},
	}
end

return Common
]]></ProtectedString>
