					<Item class="ModuleScript" referent="98">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Types = require("./types")
local travelEngine = require("./travel_engine")
local reducedMotion = require("./motion").reduced

return function(ctx: Types.Context, parent: Instance, sample: (number) -> (), complete: () -> ()): () -> ()
	local stop = ctx.runtime.mountFragment(function()
		local reduced = reducedMotion(ctx)
		travelEngine(ctx, {
			initial = { 0 },
			target = function()
				return { 1 }
			end,
			sample = function(values)
				sample(values[1])
			end,
			complete = complete,
			reduced = function(): boolean
				return reduced()
			end,
			motion = "ease",
			duration = ctx.metric("motion.durations.travel"),
			ease = ctx.motionEase("travel"),
			spring = ctx.motionSpring("travel"),
		})
		return {}
	end, parent)
	return stop
end
]]></ProtectedString>
							<string name="ScriptGuid">{723027C9-EBE0-4FAA-ADFD-FA081312EDA3}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
