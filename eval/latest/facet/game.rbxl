}
export type ToggleImplementationProps =
	Shared.TextButtonProps
	& EnabledOptions
	& ButtonVisualOptions
	& ButtonInputOptions
	& ToggleOptions
	& {
		read value: Shared.ValueBoolean,
		read onChange: ((boolean) -> ())?,
