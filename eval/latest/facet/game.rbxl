					state: ComposeTypes.ReadOnlyValue<ComposeTypes.LayerStackState>,
					id: string
				): Instance
					local function onTop(use: ComposeTypes.Use): boolean
						return if spec.transition == false then use(isCurrent(id)) else use(state).top
					end
					local step = if spec.placement == "none" then 0 else 1
					tabDepth += step
					local ok, built = pcall(function(): Instance
						local content = byId[current:peek()].content
						return if type(content) == "function" then content() else content
					end)
					tabDepth -= step
					if not ok then
						error(built, 0)
					end
					local panel = layer(
						{
							Name = id,
							BackgroundTransparency = 1,
							Size = D2.fromScale(1, 1),
							Visible = onTop,
							SelectionGroup = true,
							Attributes = { FacetTabPage = spec.placement ~= "none" },
							built,
						},
						state,
						if spec.transition == nil
							then {
								seconds = function(): number
