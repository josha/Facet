										<ProtectedString name="Source"><![CDATA[--!strict

local CoreTypes = require "../types"
local Owners = require "../ownership/owner"
local Active = require "../ownership/active"
local Children = require "../runtime/children"
local Block = Children.block
local Diagnostics = require "../diagnostics"
local Dynamic = require "../dynamic"
local Host = require "../host"
local Support = require "./support"
local Types = require "../reactive/types"
local cellModule = require "../reactive/cell"

export type Phase = CoreTypes.PresencePhase

export type Builder = CoreTypes.PresenceBuilder

export type Exiting = CoreTypes.Exiting

export type Options = CoreTypes.PresenceOptions

local KNOWN_FIELDS: { [string]: true } = { exit = true }

local function presence<T>(condition: Types.Source<T>, builder: Builder, options: Options?): Children.Directive
	local exit: ((nodes: { Host.Node }) -> Exiting)? = nil
	if options ~= nil then
		local settings = Support.optionsOf(options, "presence", "exit = ...")
		Support.noUnknownFields(settings, "presence", KNOWN_FIELDS)
		if settings.exit ~= nil then
			exit = Support.builderOf(settings.exit, "presence", "exit")
		end
	end
	local when: Types.Body<T> = Support.sourceOf(condition, "presence", "condition")
	local build: Builder = Support.builderOf(builder, "presence", "builder")

	return function(mountPoint: Children.MountPoint)
		local owner = Support.ownerFor "presence"
		Support.mountPointOf(mountPoint, "presence")
		local exiting = cellModule.cell(false)
		local phase: Phase = { exiting = exiting }
		local current: Children.Block? = nil
		local shown: boolean? = nil
		local leaving: Children.Block? = nil
		local stopWatchingExit: (() -> ())? = nil

		local function forgetExit()
			local stop = stopWatchingExit
			if stop ~= nil then
				stopWatchingExit = nil
				stop()
			end
		end

		Owners.own(owner, function()
			forgetExit()
			local departing = leaving
			leaving = nil
			if departing ~= nil then
				Owners.dispose(departing.owner)
			end
		end)

		Owners.watch(owner, function(use)
			local truthy = not not when(use)
			if truthy == shown then
				return
			end
			shown = truthy

			if truthy then
				forgetExit()
				exiting:set(false)
				local reclaimed = leaving
				if reclaimed ~= nil then
					leaving = nil
					current = reclaimed
					return
				end
				current = Block.mountBlock(mountPoint, owner, function(): { Host.Node }
					local produced = build(phase)
					if type(produced) == "table" and Dynamic.raw(produced, 1) ~= nil then
						return Block.requireNodes(produced, "presence")
					end
					return { produced }
				end, Block.nameOf(build), 1)
				return
			end

			local departing = current
			current = nil
			if departing == nil then
				return
			end
			local start = exit
			if start == nil then
				Owners.dispose(departing.owner)
				return
			end

			leaving = departing
			exiting:set(true)
			local ok, running = pcall(Active.withOwner, owner, function(): Exiting
				return start(departing.nodes)
			end)
			if not ok then
				leaving = nil
				Owners.dispose(departing.owner)
				error(
					Diagnostics.format("structure/exit-failed", "a presence exit raised instead of returning", {
						detail = tostring(running),
						contract = "exit starts the departure and returns something with a completed readable",
						fix = "return a timeline, or omit exit to dispose immediately",
					}),
					0
				)
				return
			end
			if type(running) ~= "table" or running.completed == nil then
				leaving = nil
				Owners.dispose(departing.owner)
				error(
					Diagnostics.format(
						"structure/exit-not-completable",
						"a presence exit returned nothing that completes",
						{
							actual = Diagnostics.describe(running),
							expected = "a table with a `completed` readable, such as a timeline",
						}
					),
					0
				)
				return
			end

			local exited = false
			local stop = Owners.watch(owner, function(watchUse)
				if not watchUse(running.completed) then
					return
				end
				local finished = leaving
				if finished == nil then
					return
				end
				leaving = nil
				exited = true
				forgetExit()
				Owners.dispose(finished.owner)
			end)
			if exited then
				stop()
			else
				stopWatchingExit = stop
			end
		end)
	end
end

return presence
]]></ProtectedString>
