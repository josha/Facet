				</Item>
				<Item class="ModuleScript" referent="RBX4E5F2CEBE6D749E2AF716048C55C1359">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Drives the player's kart (race or test drive), owns the chase camera and recovery.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local Store = require(script.Parent.Store)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local Controller = {}

local state = { speed = 0, yaw = 0, meter = 0.5, boostTime = 0, drifting = false, driftDir = 0, charge = 0, slip = 0, lastRecover = 0, flipTime = 0, shake = 0 }
local inputs: any = { drift = false, latch = false, latchAt = 0 }
local moveAction: InputAction? = nil
Controller.suspended = function(): boolean return false end
Controller.onImpact = nil :: ((number) -> ())?
Controller.onBoost = nil :: ((string) -> ())?

local function findMove()
	local ok, action = pcall(function()
		local pm = game:GetService("StarterPlayer"):FindFirstChild("PlayerModule") or player:WaitForChild("PlayerScripts"):FindFirstChild("PlayerModule")
		return (pm :: Instance):FindFirstChild("InputContexts"):FindFirstChild("CharacterContext"):FindFirstChild("MoveAction")
	end)
	if ok and action then moveAction = action :: InputAction end
end
findMove()

local function kartModel(): Model?
	local name = player:GetAttribute("Kart")
	if not name then return nil end
	local folder = workspace:FindFirstChild("Karts")
	return folder and folder:FindFirstChild(name :: string) :: Model?
end

local function trackPoints(): { Vector3 }
	if Store.mode:peek() == "test" then return GameData.PracticePoints end
	local race = Store.race:peek()
	local tr = race.track and GameData.find(GameData.Tracks, race.track)
	return if tr then (tr :: any).points else GameData.PracticePoints
end

function Controller.recover()
	local model = kartModel()
	if not model or not model.PrimaryPart then return end
	local root = model.PrimaryPart :: BasePart
	if root.Anchored or os.clock() - state.lastRecover < 1.5 then return end
	state.lastRecover = os.clock()
	local pts = trackPoints()
	local best, bestD = 1, math.huge
	for i, p in pts do
		local d = (Vector3.new(root.Position.X, 0, root.Position.Z) - p).Magnitude
		if d < bestD then best, bestD = i, d end
	end
	local a, b = pts[best], pts[best % #pts + 1]
	local pos = a + Vector3.new(0, 2.5, 0)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	model:PivotTo(CFrame.lookAt(pos, Vector3.new(b.X, pos.Y, b.Z)))
	local look = (b - a).Unit
	state.yaw = math.atan2(-look.X, -look.Z)
	state.speed = 0
	state.drifting = false
end

function Controller.boost()
	if state.meter >= 0.33 and state.boostTime <= 0 then
		local model = kartModel()
		local b = model and (model:GetAttribute("boost") :: number) or 55
		state.meter -= 0.33
		state.boostTime = 1.1 + b / 120
		state.shake = 0.4
		if Controller.onBoost then Controller.onBoost("BOOST") end
	end
end

function Controller.driftTap()
	inputs.latch = true
	inputs.latchAt = os.clock()
end

function Controller.setDrift(on: boolean)
	inputs.drift = on
end

local wasDriving = false
local frame = 0
RunService:BindToRenderStep("KartDrive", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
	local model = kartModel()
	local root = model and model.PrimaryPart
	if not model or not root then
		if wasDriving then
			wasDriving = false
			camera.CameraType = Enum.CameraType.Custom
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then camera.CameraSubject = hum end
			camera.FieldOfView = 70
		end
		return
	end
	local lv = root:FindFirstChild("Velocity") :: LinearVelocity?
	local ao = root:FindFirstChild("Align") :: AlignOrientation?
	if not lv or not ao then return end
	if not wasDriving then
		wasDriving = true
		local look = root.CFrame.LookVector
		state.yaw = math.atan2(-look.X, -look.Z)
		state.speed, state.meter, state.boostTime, state.charge = 0, 0.5, 0, 0
		camera.CameraType = Enum.CameraType.Scriptable
	end
	if not moveAction then findMove() end
	local move = if moveAction then (moveAction:GetState() :: any) :: Vector2 else Vector2.zero
	if Controller.suspended() then move = Vector2.zero end
	local throttle, steer = move.Y, move.X
	local maxSpeed = (model:GetAttribute("speed") :: number? or 60) * 1.05
	local handling = model:GetAttribute("handling") :: number? or 60
	local accelBonus = model:GetAttribute("accel") :: number? or 0
	local driftBonus = model:GetAttribute("drift") :: number? or 0
	local frozen = root.Anchored
	-- Surface check
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { workspace:FindFirstChild("Karts") :: Instance, player.Character :: Instance }
	local hit = workspace:Raycast(root.Position, Vector3.new(0, -6, 0), params)
	local onRoad = hit ~= nil and hit.Instance:GetAttribute("Road") == true
	local limit = if onRoad then maxSpeed else maxSpeed * 0.55
	if state.boostTime > 0 then
		state.boostTime -= dt
		limit = maxSpeed * 1.4
	end
	local accel = 34 + accelBonus * 3
	if frozen then
		state.speed = 0
	elseif throttle > 0.1 then
		if state.speed < limit then
			state.speed = math.min(limit, state.speed + accel * throttle * dt * (if state.boostTime > 0 then 2.5 else 1))
		else
			state.speed = math.max(limit, state.speed - 50 * dt)
		end
	elseif throttle < -0.1 then
		if state.speed > 0 then
			state.speed = math.max(0, state.speed - 90 * dt)
		else
			state.speed = math.max(-22, state.speed - 25 * dt)
		end
	else
		state.speed -= math.sign(state.speed) * math.min(math.abs(state.speed), 18 * dt)
		if state.speed > limit then state.speed = math.max(limit, state.speed - 50 * dt) end
	end
	-- Drift: hold while steering to build charge, release for a boost.
	if inputs.latch and math.abs(steer) < 0.3 and os.clock() - (inputs.latchAt or 0) > 0.6 then inputs.latch = false end
	if (inputs.drift or inputs.latch) and math.abs(steer) > 0.3 and state.speed > 25 and not frozen then
		if not state.drifting then
			state.drifting = true
			state.driftDir = math.sign(steer)
			state.charge = 0
		end
		state.charge = math.min(2.5, state.charge + dt * (1 + driftBonus / 8))
		state.meter = math.min(1, state.meter + dt * 0.05)
	elseif state.drifting then
		state.drifting = false
		if state.charge > 0.8 then
			state.boostTime = math.max(state.boostTime, 0.4 + state.charge * 0.35)
			if Controller.onBoost then Controller.onBoost(if state.charge > 1.8 then "MAX DRIFT BOOST" else "DRIFT BOOST") end
		end
		state.charge = 0
	end
	state.meter = math.min(1, state.meter + dt * 0.035)
	local speedFactor = math.clamp(math.abs(state.speed) / 25, 0, 1)
	local turn = (1.35 + handling / 70) * speedFactor
	if state.drifting then
		turn *= 1.25
		steer = math.clamp(steer + state.driftDir * 0.35, -1, 1)
	end
	if not frozen then
		state.yaw -= steer * turn * dt * (if state.speed >= 0 then 1 else -1)
	end
	local targetSlip = if state.drifting then -state.driftDir * 0.32 else 0
	state.slip += (targetSlip - state.slip) * math.min(1, dt * 5)
	local dir = CFrame.Angles(0, state.yaw + state.slip, 0).LookVector
	local actual = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude
	if not frozen and math.abs(state.speed) > actual + 25 and math.abs(state.speed) > 30 then
		local lost = math.abs(state.speed) - actual
		if lost > 30 and Controller.onImpact then Controller.onImpact(math.floor(lost)) end
		state.speed = math.sign(state.speed) * (actual + 10)
	end
	if not frozen then
		lv.PlaneVelocity = Vector2.new(dir.X * state.speed, dir.Z * state.speed)
		ao.CFrame = CFrame.Angles(0, state.yaw, 0) * CFrame.Angles(0, 0, -steer * 0.06 * speedFactor)
	end
	-- Automatic recovery when fallen or flipped.
	if root.Position.Y < -15 then Controller.recover() end
	if root.CFrame.UpVector.Y < 0.4 then
		state.flipTime += dt
		if state.flipTime > 1.2 then state.flipTime = 0; Controller.recover() end
	else
		state.flipTime = 0
	end
	-- Chase camera
	local settings = (Store.profile:peek() or {}).settings or {}
	local far = Store.camera:peek() == "far"
	local dist, height = if far then 24 else 15, if far then 9 else 6
	local heading = CFrame.Angles(0, state.yaw, 0)
	local target = root.Position + Vector3.new(0, 3, 0)
	local desired = target - heading.LookVector * dist + Vector3.new(0, height, 0)
	local cur = camera.CFrame.Position
	local alpha = math.min(1, dt * 8)
	local pos = if (cur - desired).Magnitude > 80 then desired else cur:Lerp(desired, alpha)
	local cf = CFrame.lookAt(pos, target + heading.LookVector * 12)
	state.shake = math.max(0, state.shake - dt)
	if state.boostTime > 0 and settings.cameraShake ~= false and not settings.reducedMotion then
		local m = 0.12 + state.shake * 0.3
		cf *= CFrame.new(math.random() * m - m / 2, math.random() * m - m / 2, 0)
	end
	camera.CFrame = cf
	local fovGain = if settings.reducedMotion then 6 else 18
	camera.FieldOfView = 70 + fovGain * math.clamp(math.abs(state.speed) / (maxSpeed * 1.4), 0, 1)
	frame += 1
	if frame % 4 ~= 0 then return end
	Store.kart:set({ speed = math.abs(state.speed), max = maxSpeed, meter = state.meter, drifting = state.drifting, charge = state.charge, boosting = state.boostTime > 0, onRoad = onRoad, frozen = frozen })
end)

return Controller
]]></ProtectedString>
						<string name="ScriptGuid">{BC53B070-B4C9-4CC5-B758-2F22578529BC}</string>
