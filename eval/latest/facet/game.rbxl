		<Item class="Script" referent="RBX755D9C952C0B47088B6707A9A0D33C56">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local Profiles = require(script.Parent.Server.Profiles)
local Actions = require(script.Parent.Server.Actions)
local Race = require(script.Parent.Server.Race)
local Remotes = game.ReplicatedStorage.Remotes

local RACE_ACTIONS = { queue = true, leaveQueue = true, vote = true, returnToHub = true, testDrive = true, endTest = true }

Remotes.Request.OnServerInvoke = function(player: Player, action: any, args: any)
	if type(action) ~= "string" then return { ok = false, message = "Bad request" } end
	if action == "snapshot" then
		return { ok = true, message = "", profile = Profiles.snapshot(player) }
	elseif action == "raceState" then
		return { ok = true, message = "", race = Race.payload() }
	end
	if RACE_ACTIONS[action] then
		local ok, result = pcall(Race.request, player, action, args)
		if not ok then warn(result) return { ok = false, message = "Server error" } end
		return result
	end
	return Actions.dispatch(player, action, args)
end

-- Quick chat with a server-enforced cooldown.
local lastChat: { [Player]: number } = {}
Remotes.Chat.OnServerEvent:Connect(function(player: Player, index: any)
	if type(index) ~= "number" or not GameData.QuickChat[index] then return end
	local t = os.clock()
	if lastChat[player] and t - lastChat[player] < 5 then
		Remotes.Notify:FireClient(player, { kind = "warning", text = "Quick chat cooling down" })
		return
	end
	lastChat[player] = t
	Remotes.Chat:FireAllClients({ userId = player.UserId, name = player.DisplayName, text = GameData.QuickChat[index], at = workspace:GetServerTimeNow() })
end)

-- Mechanic job power cells
for _, cell in workspace.World.Hub.PowerCells:GetChildren() do
	if cell:IsA("BasePart") then
		cell.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if player then Actions.collectCell(player, cell:GetAttribute("CellIndex") :: number) end
		end)
	end
end

local function onPlayer(player: Player)
	player:SetAttribute("Mode", "hub")
	task.spawn(Profiles.load, player)
	player.CharacterAdded:Connect(function(char)
		Race.characterReset(player)
		task.defer(function()
			char:PivotTo(CFrame.new(GameData.HubSpawn + Vector3.new(0, 2, 0)))
		end)
	end)
	task.defer(function()
		Remotes.Race:FireClient(player, Race.payload())
	end)
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do onPlayer(p) end
Players.PlayerRemoving:Connect(function(player)
	Race.playerLeft(player)
	Profiles.unload(player)
	lastChat[player] = nil
end)
]]></ProtectedString>
