	read page: Types.ValueNumber,
	read onChange: (number) -> (),
	read pageCount: Content.Input<number?>?,
	read hasNext: Types.ValueBoolean?,
	read hasPrevious: Types.ValueBoolean?,
	read siblingCount: number?,
	read boundaryCount: number?,
	read showFirstLast: boolean?,
	read form: Content.PaginationForm?,
	read direction: ("ltr" | "rtl")?,
	read controlSize: Content.Input<Types.ControlSize?>?,
	read enabled: Types.ValueBoolean?,
	read controls: Content.Diagnostics?,
	read [number]: Compose.Child?,
}
export type StepIndicatorSpec = {
	Changed: ((string) -> ())?,
	Attributes: Engine.Attributes?,
	AncestryChanged: ((Instance, Instance?) -> ())?,
	Archivable: Engine.ValueBoolean?,
	AttributeChanged: ((string) -> ())?,
	Capabilities: Engine.ValueSecurityCapabilities?,
	ChildAdded: ((Instance) -> ())?,
	ChildRemoved: ((Instance) -> ())?,
