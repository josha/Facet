					<ProtectedString name="Source"><![CDATA[--!strict
-- Server-owned player profiles. Snapshots are pushed to the owning client after every accepted change.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local Remotes = game.ReplicatedStorage.Remotes

local Profiles = {}
local profiles: { [Player]: any } = {}
local store: DataStore? = nil
do
	local ok, result = pcall(function() return DataStoreService:GetDataStore("NeonKartProfiles_v1") end)
	if ok then store = result end
end

local DEFAULT_SETTINGS = { music = 0.6, sfx = 0.8, damageNumbers = true, cameraShake = true, graphics = "High", reducedMotion = false }
Profiles.DefaultSettings = DEFAULT_SETTINGS

local function fresh(): any
	return {
		credits = 1500, gems = 20, xp = 0, level = 1, races = 0, wins = 0, podiums = 0, crates = 0, parts = 0,
		karts = { volt = true }, selectedKart = "volt", favorites = {}, upgrades = {},
		ownedParts = {}, equipped = {},
		drivers = { kit = true }, rentals = {}, selectedDriver = "kit",
		livery = table.clone(GameData.DefaultLivery),
		freeCrates = 1, cards = {},
		daily = { streak = 0, lastDay = -1 },
		codesUsed = {}, codeAttempts = {},
		questsClaimed = {}, boosts = {},
		offer = { expires = os.time() + GameData.Offer.minutes * 60, bought = false },
		mechanic = { state = "none", cells = {} },
		settings = table.clone(DEFAULT_SETTINGS),
		tutorial = { done = false },
		party = { members = {}, pending = {}, results = {} },
		lastRace = nil,
	}
end

function Profiles.get(player: Player): any
	return profiles[player]
end

local saveStatus: { [Player]: { status: string, message: string } } = {}
local saveQueued: { [Player]: boolean } = {}

local function persistable(p: any): any
	local copy = table.clone(p)
	copy.party = nil
	copy.codeAttempts = nil
	copy.lastRace = nil
	return copy
end

function Profiles.snapshot(player: Player): any
	local p = profiles[player]
	if not p then return nil end
	local s = table.clone(p)
	s.serverTime = os.time()
	s.save = saveStatus[player] or { status = "pending", message = "New profile · saves after your first change" }
	return s
end

function Profiles.push(player: Player)
	local snap = Profiles.snapshot(player)
	if snap then
		Remotes.Profile:FireClient(player, snap)
	end
end

local function attemptSave(player: Player)
	saveQueued[player] = nil
	local p = profiles[player]
	if not p then return end
	if not store then
		saveStatus[player] = { status = "failed", message = "Cloud save unavailable · kept for this session" }
		Profiles.push(player)
		return
	end
	local ok, err = pcall(function()
		(store :: DataStore):SetAsync("u" .. player.UserId, persistable(p))
	end)
	if ok then
		saveStatus[player] = { status = "saved", message = "Saved" }
	else
		saveStatus[player] = { status = "failed", message = "Cloud save failed · kept for this session" }
		warn("Save failed", err)
	end
	Profiles.push(player)
end

-- Call after every accepted change.
function Profiles.changed(player: Player)
	saveStatus[player] = { status = "saving", message = "Saving…" }
	Profiles.push(player)
	if not saveQueued[player] then
		saveQueued[player] = true
		task.delay(1.5, attemptSave, player)
	end
end

function Profiles.addXp(p: any, amount: number)
	p.xp += amount
	while p.xp >= GameData.xpForLevel(p.level) do
		p.xp -= GameData.xpForLevel(p.level)
		p.level += 1
	end
end

function Profiles.load(player: Player)
	local data = fresh()
	if store then
		local ok, saved = pcall(function() return (store :: DataStore):GetAsync("u" .. player.UserId) end)
		if ok and type(saved) == "table" then
			for k, v in saved do data[k] = v end
			data.party = { members = {}, pending = {}, results = {} }
			data.codeAttempts = {}
			saveStatus[player] = { status = "saved", message = "Loaded saved profile" }
		elseif not ok then
			saveStatus[player] = { status = "failed", message = "Cloud save unavailable · kept for this session" }
			store = nil
		end
	end
	for k, v in DEFAULT_SETTINGS do
		if data.settings[k] == nil then data.settings[k] = v end
	end
	profiles[player] = data
	Profiles.push(player)
end

function Profiles.unload(player: Player)
	if profiles[player] and store then
		attemptSave(player)
	end
	profiles[player] = nil
	saveStatus[player] = nil
end

-- Effective kart stats with parts, driver and per-kart upgrades.
function Profiles.kartStats(p: any, kartId: string): any
	local kart = GameData.find(GameData.Karts, kartId) or GameData.Karts[1]
	local up = p.upgrades[kart.id] or { speed = 0, handling = 0, boost = 0 }
	local s = { speed = kart.speed + up.speed * GameData.UpgradeStep, handling = kart.handling + up.handling * GameData.UpgradeStep, boost = kart.boost + up.boost * GameData.UpgradeStep, accel = 0, drift = 0 }
	for _, slot in GameData.PartSlots do
		local id = p.equipped[slot]
		local part = id and GameData.find(GameData.Parts, id)
		if part then
			s.speed += part.speed; s.handling += part.handling; s.boost += part.boost
		end
	end
	local driver = GameData.find(GameData.Drivers, Profiles.activeDriver(p))
	if driver then
		s.accel += driver.accel; s.drift += driver.drift; s.boost += driver.boost
	end
	return s
end

function Profiles.driverUsable(p: any, id: string): boolean
	if p.drivers[id] then return true end
	local expiry = p.rentals[id]
	return expiry ~= nil and expiry > os.time()
end

function Profiles.activeDriver(p: any): string
	if Profiles.driverUsable(p, p.selectedDriver) then return p.selectedDriver end
	return "kit"
end

function Profiles.glow(p: any): Color3?
	local id = p.equipped.cosmetic
	local part = id and GameData.find(GameData.Parts, id)
	return part and part.glow or nil
end

-- Expire rentals: fall back to Kit when the selected rental runs out.
task.spawn(function()
	while true do
		task.wait(1)
		local now = os.time()
		for player, p in profiles do
			for id, expiry in p.rentals do
				if expiry <= now then
					p.rentals[id] = nil
					if p.selectedDriver == id and not p.drivers[id] then
						p.selectedDriver = "kit"
					end
					Remotes.Notify:FireClient(player, { kind = "warning", text = "Rental ended: " .. ((GameData.find(GameData.Drivers, id) :: any).name) .. ". Kit is driving." })
					Profiles.changed(player)
				end
			end
		end
	end
end)

return Profiles
]]></ProtectedString>
					<string name="ScriptGuid">{E07EFC93-FD50-4B13-AF71-28D2A92E0EEA}</string>
