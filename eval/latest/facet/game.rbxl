									<Content name="LinkedSource"><null></null></Content>
									<ProtectedString name="Source"><![CDATA[--!strict

local CoreTypes = require "./types"
local Owners = require "./ownership/owner"
local Diagnostics = require "./diagnostics"
local cacheOptions = require "./ownership/cache-options"

export type Lease<T> = CoreTypes.Lease<T>

export type Pool<T> = CoreTypes.Pool<T>

export type Options<T> = CoreTypes.PoolOptions<T>

local function createPool<T>(options: Options<T>): Pool<T>
	local owner, maximum = cacheOptions.validate(options, "pool")
	local idle: { T } = {}
	local active: { [Lease<T>]: T } = {}
	local disposed = false

	local function destroyAll()
		disposed = true
		cacheOptions.destroyAll("pool", options.destroy, function(destroy)
			for _, value in idle do
				destroy(value)
			end
			for _, value in active do
				destroy(value)
			end
			table.clear(idle)
			table.clear(active)
		end)
	end
	Owners.own(owner, destroyAll)

	local function acquire(): Lease<T>
		if disposed then
			return Diagnostics.raise("pool/disposed", "a disposed pool cannot acquire resources", {
				contract = "the pool shares its owner's lifetime",
			})
		end
		local value: T
		if #idle > 0 then
			value = idle[#idle]
			idle[#idle] = nil
		else
			value = options.create()
		end
		local lease: Lease<T>
		local released = false
		local function release()
			if released then
				return
			end
			released = true
			active[lease] = nil
			if disposed then
				return
			end
			if options.reset ~= nil then
				local ok, err: unknown = pcall(options.reset, value)
				if not ok then
					options.destroy(value)
					error(err, 0)
				end
			end
			if #idle < maximum then
				idle[#idle + 1] = value
			else
				options.destroy(value)
			end
		end
		lease = { value = value, release = release }
		active[lease] = value
		return lease
	end

	return {
		acquire = acquire,
		idle = function()
			return #idle
		end,
		active = function()
			local count = 0
			for _ in active do
				count += 1
			end
			return count
		end,
	}
end

return createPool
]]></ProtectedString>
