					</Item>
					<Item class="ModuleScript" referent="RBXC78C9670440B49A5A66BC3CB4BF9E97B">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- One confirmation dialog for every spend. It stays open until the server answers.
local Facet = require(game.ReplicatedStorage.Packages.Facet)

return function(ctx: any): any
	local UI, C, Store = ctx.UI, ctx.C, ctx.Store
	local open, busy, refusal = C.cell(false), C.cell(false), C.cell("")
	local spec = C.cell({ title = "", lines = {}, confirm = "Confirm" } :: any)
	-- spec: { title, lines, confirm, credits?, gems?, run = () -> result, after? }
	function ctx.confirm(s: any)
		refusal:set("")
		busy:set(false)
		spec:set(s)
		open:set(true)
	end
	local actions: { Facet.DialogAction } = {
		{ id = "Cancel", label = "Cancel", role = "cancel", onActivate = function() end },
		{ id = "Confirm", label = function(use: Facet.Use): string return use(spec).confirm end, role = "default", keepOpen = true, busy = busy,
			onActivate = function()
				if busy:peek() then return end
				busy:set(true)
				refusal:set("")
				local r = spec:peek().run()
				busy:set(false)
				if r and r.ok then
					open:set(false)
					ctx.toast("success", r.message)
					if spec:peek().after then spec:peek().after(r) end
				else
					refusal:set(if r then r.message else "Request failed. Try again.")
				end
			end },
	} :: any
	return UI.Dialog "Confirm" {
		isPresented = open, title = function(use: Facet.Use): string return use(spec).title end, actions = actions,
		onPresentedChange = function(v: boolean) if not busy:peek() then open:set(v) end end,
		content = function()
			return UI.VStack "Terms" { gap = "s", width = "fill",
				UI.Text { text = function(use: Facet.Use): string return table.concat(use(spec).lines or {}, "\n") end, wrap = true },
				UI.Text { textRole = "caption", wrap = true, text = function(use: Facet.Use): string
					local s, pr = use(spec), use(Store.profile)
					if not pr or (not s.credits and not s.gems) then return "" end
					local c, g = s.credits or 0, s.gems or 0
					return string.format("Balance now: %s Credits · %s Gems\nAfter: %s Credits · %s Gems", Store.fmt(pr.credits), Store.fmt(pr.gems), Store.fmt(pr.credits - c), Store.fmt(pr.gems - g))
				end },
				UI.Text { text = function(use: Facet.Use): string local r = use(refusal) return if r ~= "" then "✕ " .. r else "" end, textRole = "strong", wrap = true,
					Visible = function(use: Facet.Use): boolean return use(refusal) ~= "" end },
			}
		end,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{E15E3937-B9C9-476E-A461-AE845377C547}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Confirm</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">73c8afe78d24b4d30afced1100001fa0</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX34CB75B5FB32456CB0FE5D3BC7135D50">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Garage: browse, search, filter and sort karts; inspect, try, choose, favorite; per-kart upgrades.
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local Common = require(script.Parent.Common)
local C = Facet.Compose

-- Durable browse state survives closing and reopening the garage.
local inspected = C.cell("volt")
local query = C.cell("")
local category = C.cell("All")
local rarity = C.cell("All")
local sortBy = C.cell("name")
local page = C.cell("karts")
local upgradeKart = C.cell("volt")

return function(ctx: any): any
	local UI, Store = ctx.UI, ctx.Store
	local env = ctx.env
	local function prof(use: Facet.Use): any return use(Store.profile) or { karts = {}, favorites = {}, upgrades = {} } end
	local function effective(p: any, k: any, stat: string): number
		local up = (p.upgrades or {})[k.id]
		return k[stat] + (if up then up[stat] * GameData.UpgradeStep else 0)
	end
	local function matches(use: Facet.Use, k: any): boolean
		local q = string.lower(use(query))
		q = q:gsub("^%s+", ""):gsub("%s+$", "")
		if q ~= "" and not string.find(string.lower(k.name), q, 1, true) then return false end
		local cat, rar = use(category), use(rarity)
		if cat ~= "All" and k.category ~= cat then return false end
		if rar ~= "All" and k.rarity ~= rar then return false end
		return true
	end
	local order = C.formula(function(use: Facet.Use): { [string]: number }
		local p = prof(use)
		local list = table.clone(GameData.Karts)
		local mode = use(sortBy)
		table.sort(list, function(a, b)
			if mode == "speed" then
				local sa, sb = effective(p, a, "speed"), effective(p, b, "speed")
				if sa ~= sb then return sa > sb end
			elseif mode == "rarity" then
				local ra, rb = GameData.RarityOrder[a.rarity], GameData.RarityOrder[b.rarity]
				if ra ~= rb then return ra > rb end
			end
			return a.name < b.name
		end)
		local map = {}
		for i, k in list do map[k.id] = i end
		return map
	end)
	local visibleCount = C.formula(function(use: Facet.Use): number
		local n = 0
		for _, k in GameData.Karts do if matches(use, k) then n += 1 end end
		return n
	end)
	local function kartOf(use: Facet.Use): any return GameData.find(GameData.Karts, use(inspected)) or GameData.Karts[1] end

	local catOptions: { Facet.PickerOption<string> } = { { value = "All", label = "All classes" }, { value = "Balanced", label = "Balanced" }, { value = "Speed", label = "Speed" }, { value = "Grip", label = "Grip" } }
	local rarOptions: { Facet.PickerOption<string> } = { { value = "All", label = "All rarities" }, { value = "Common", label = "Common" }, { value = "Rare", label = "Rare" }, { value = "Epic", label = "Epic" }, { value = "Legendary", label = "Legendary" } }
	local sortOptions: { Facet.PickerOption<string> } = { { value = "name", label = "Name A–Z" }, { value = "speed", label = "Speed: highest" }, { value = "rarity", label = "Rarity: highest" } }
	local pageOptions: { Facet.PickerOption<string> } = { { value = "karts", label = "Karts" }, { value = "upgrades", label = "Upgrades" } }
	local kartOptions: { Facet.PickerOption<string> } = {}
	for _, k in GameData.Karts do table.insert(kartOptions, { value = k.id, label = k.name }) end

	local function row(k: any): Instance
		return UI.Button("Kart_" .. k.id) {
			LayoutOrder = function(use: Facet.Use): number return use(order)[k.id] or 99 end,
			Visible = function(use: Facet.Use): boolean return matches(use, k) end,
			label = function(use: Facet.Use): string
				local p = prof(use)
				local marks = (if p.favorites[k.id] then "★ " else "") .. k.name
				if p.selectedKart == k.id then marks ..= "  · NEXT RACE" end
				return marks
			end,
			subtitle = function(use: Facet.Use): string
				local p = prof(use)
				local own = if p.karts[k.id] then "Owned" elseif k.price > 0 then Store.fmt(k.price) .. " Credits" else "Streak reward"
				return string.format("%s %s · SPD %d · HND %d · BST %d · %s", k.rarity, k.category, effective(p, k, "speed"), effective(p, k, "handling"), effective(p, k, "boost"), own)
			end,
			appearance = function(use: Facet.Use): string return if use(inspected) == k.id then "emphasis" else "standard" end,
			onActivate = function() inspected:set(k.id) end,
		}
	end

	local function statBar(label: string, stat: string): Instance
		return UI.ProgressView("Stat_" .. stat) { label = label,
			value = function(use: Facet.Use): number return math.clamp(effective(prof(use), kartOf(use), stat) / 100, 0, 1) end,
			endLabel = function(use: Facet.Use): string
				local p, k = prof(use), kartOf(use)
				local up = (p.upgrades[k.id] or {})[stat] or 0
				return tostring(effective(p, k, stat)) .. (if up > 0 then string.format(" (+%d)", up * GameData.UpgradeStep) else "")
			end }
	end

	local function buyKart()
		local k = GameData.find(GameData.Karts, inspected:peek()) :: any
		ctx.confirm({ title = "Buy " .. k.name .. "?", lines = { k.rarity .. " " .. k.category .. " kart", "Price: " .. Store.fmt(k.price) .. " Credits" },
			confirm = "Buy for " .. Store.fmt(k.price) .. " Credits", credits = k.price,
			run = function() return Store.request("buyKart", k.id) end })
	end

	local function upgradeRow(stat: string, label: string): Instance
		local function data(use: Facet.Use): any
			local p = prof(use)
			local id = use(upgradeKart)
			if id == "" then id = p.selectedKart or "volt" end
			local k = GameData.find(GameData.Karts, id) :: any
			local level = ((p.upgrades or {})[id] or {})[stat] or 0
			local cr, gm = GameData.upgradeCost(level)
			return { p = p, k = k, id = id, level = level, credits = cr, gems = gm, owned = p.karts[id] == true }
		end
		return UI.VStack("Up_" .. stat) { width = "fill", gap = "xs", surface = "panel", padding = "m",
			UI.HStack "Head" { width = "fill",
				UI.Text { text = label, textRole = "heading" }, UI.Spacer {},
				UI.Text { textRole = "strong", text = function(use: Facet.Use): string return string.format("Level %d / %d", data(use).level, GameData.MaxUpgrade) end } },
			UI.ProgressView "Level" { value = function(use: Facet.Use): number return data(use).level / GameData.MaxUpgrade end },
			UI.Text { wrap = true, text = function(use: Facet.Use): string
				local d = data(use)
				local now = d.k[stat] + d.level * GameData.UpgradeStep
				if d.level >= GameData.MaxUpgrade then return string.format("%s %d · Maximum level reached", label, now) end
				return string.format("Next: %s %d → %d · Costs %s Credits + %d Gems", label, now, now + GameData.UpgradeStep, Store.fmt(d.credits), d.gems)
			end },
			UI.Text { textRole = "caption", wrap = true, text = function(use: Facet.Use): string
				local d = data(use)
				if not d.owned then return "Own this kart to upgrade it." end
				if d.level >= GameData.MaxUpgrade then return "" end
				local missing = {}
				if d.p.credits < d.credits then table.insert(missing, Store.fmt(d.credits - d.p.credits) .. " more Credits") end
				if d.p.gems < d.gems then table.insert(missing, (d.gems - d.p.gems) .. " more Gems") end
				return if #missing > 0 then "Not enough funds: need " .. table.concat(missing, " and ") else ""
			end },
			UI.Button "Upgrade" { label = function(use: Facet.Use): string
					local d = data(use)
					return if d.level >= GameData.MaxUpgrade then "Max level" else "Upgrade " .. label
				end,
				enabled = function(use: Facet.Use): boolean
					local d = data(use)
					return d.owned and d.level < GameData.MaxUpgrade and d.p.credits >= d.credits and d.p.gems >= d.gems
				end,
				onActivate = function()
					local p = Store.profile:peek()
					local id = upgradeKart:peek()
					if id == "" then id = p.selectedKart end
					local level = ((p.upgrades or {})[id] or {})[stat] or 0
					local cr, gm = GameData.upgradeCost(level)
					local k = GameData.find(GameData.Karts, id) :: any
					ctx.confirm({ title = "Upgrade " .. label .. "?", lines = { k.name .. ": " .. label .. " level " .. level .. " → " .. (level + 1), "Cost: " .. Store.fmt(cr) .. " Credits + " .. gm .. " Gems" },
						confirm = "Spend " .. Store.fmt(cr) .. " Credits + " .. gm .. " Gems", credits = cr, gems = gm,
						run = function() return Store.request("upgrade", { kart = id, stat = stat }) end })
				end },
		}
	end

	return UI.Sheet "Garage" {
		title = "Garage", isPresented = ctx.open.garage, placement = "center", width = "wide", detents = { "hug" },
		content = function()
			local rows = {}
			for _, k in GameData.Karts do table.insert(rows, row(k)) end
			local colW = env.scaled(360)
			return UI.VStack "Body" { width = "fill", gap = "m",
				UI.Picker "Page" { selected = page, options = pageOptions, style = "segmented" },
				UI.HStack "Karts" { width = "fill", wrap = true, gap = "m",
					Visible = function(use: Facet.Use): boolean return use(page) == "karts" end,
					UI.VStack "Browse" { gap = "s", Size = UDim2.fromOffset(colW, 0),
						UI.TextInput "Search" { value = query, placeholder = "Search karts", presentation = "search" },
						UI.VStack "Filters" { width = "fill", gap = "xs",
							UI.Picker "Category" { selected = category, options = catOptions },
							UI.Picker "Rarity" { selected = rarity, options = rarOptions },
							UI.Picker "Sort" { selected = sortBy, options = sortOptions },
						},
						UI.Text { textRole = "caption", text = function(use: Facet.Use): string return use(visibleCount) .. " of " .. #GameData.Karts .. " karts" end },
						UI.VStack "Empty" { width = "fill", gap = "s", surface = "panel", padding = "m",
							Visible = function(use: Facet.Use): boolean return use(visibleCount) == 0 end,
							UI.Text { wrap = true, text = function(use: Facet.Use): string return "No karts match “" .. use(query) .. "” with these filters." end },
							UI.Button "ClearSearch" { label = "Clear search", onActivate = function() query:set("") end },
						},
						UI.VStack "List" { width = "fill", gap = "xs", align = "stretch", table.unpack(rows) },
					},
					UI.VStack "Detail" { gap = "s", Size = UDim2.fromOffset(colW, 0), surface = "panel", padding = "m",
						Common.preview(ctx, env.scaled(190), function(use: Facet.Use): string return use(inspected) end,
							function(use: Facet.Use): any
								local p = prof(use)
								return if use(inspected) == p.selectedKart then p.livery else nil
							end),
						UI.Text { textRole = "heading", text = function(use: Facet.Use): string return kartOf(use).name end },
						UI.Text { textRole = "caption", text = function(use: Facet.Use): string local k = kartOf(use) return k.rarity .. " · " .. k.category end },
						statBar("Speed", "speed"), statBar("Handling", "handling"), statBar("Boost", "boost"),
						UI.Text { wrap = true, text = function(use: Facet.Use): string return kartOf(use).blurb end },
						UI.Button "Choose" { appearance = "emphasis",
							label = function(use: Facet.Use): string
								local p, k = prof(use), kartOf(use)
								if p.selectedKart == k.id then return "✓ Next race kart" end
								if p.karts[k.id] then return "Choose for next race" end
								if k.price > 0 then return "Buy · " .. Store.fmt(k.price) .. " Credits" end
								return "Locked · Day-7 streak reward"
							end,
							enabled = function(use: Facet.Use): boolean
								local p, k = prof(use), kartOf(use)
								return p.selectedKart ~= k.id and (p.karts[k.id] or k.price > 0)
							end,
							onActivate = function()
								local p, id = Store.profile:peek(), inspected:peek()
								if p.karts[id] then ctx.req("selectKart", id) else buyKart() end
							end },
						UI.HStack "Secondary" { width = "fill", gap = "s", wrap = true,
							UI.Button "Try" { label = "Test drive", icon = "flag", UI.fill(), onActivate = function()
								local r = ctx.req("testDrive", inspected:peek(), true)
								if r.ok then ctx.open.garage:set(false) end
							end },
							UI.Button "Favorite" { UI.fill(), icon = "star",
								label = function(use: Facet.Use): string return if prof(use).favorites[use(inspected)] then "Unfavorite" else "Favorite" end,
								onActivate = function() ctx.req("favorite", inspected:peek(), true) end },
						},
					},
				},
				UI.VStack "Upgrades" { width = "fill", gap = "s", maxWidth = env.scaled(620),
					Visible = function(use: Facet.Use): boolean return use(page) == "upgrades" end,
					UI.Text { text = "Each kart keeps its own upgrades. Every level adds +3 to that stat in races.", wrap = true, textRole = "caption" },
					UI.Picker "UpgradeKart" { selected = upgradeKart, options = kartOptions },
					upgradeRow("speed", "Speed"), upgradeRow("handling", "Handling"), upgradeRow("boost", "Boost"),
				},
			}
		end,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{4A64008D-8DB4-458A-A1BC-663F92747372}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
