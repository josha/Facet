					</Item>
					<Item class="ModuleScript" referent="RBX43167FC7C5F34CB7AAFA9BA9F42527B0">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Party: friends with headshots and presence, search, invites with pending and replies.
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local Common = require(script.Parent.Common)
local C = Facet.Compose

local friends = C.cell({} :: { any })
local loaded = false
local query = C.cell("")
local SLOTS = 17

return function(ctx: any): any
	local UI, Store = ctx.UI, ctx.Store
	local env = ctx.env
	task.spawn(function()
		while not loaded do
			task.wait(0.3)
			if ctx.open.party:peek() then
				loaded = true
				local r = Store.request("friends")
				if r.ok then friends:set(r.friends) else loaded = false end
			end
		end
	end)
	local function party(use: Facet.Use): any
		local p = use(Store.profile)
		return (p and p.party) or { members = {}, pending = {}, results = {} }
	end
	local function matches(use: Facet.Use, f: any): boolean
		local q = string.lower(use(query)):gsub("^%s+", ""):gsub("%s+$", "")
		return q == "" or string.find(string.lower(f.name), q, 1, true) ~= nil
	end
	local rows = {}
	for i = 1, SLOTS do
		local function f(use: Facet.Use): any? return use(friends)[i] end
		local function state(use: Facet.Use): string
			local fr = f(use)
			if not fr then return "" end
			local pt = party(use)
			if pt.members[fr.id] then return "member" end
			if pt.pending[fr.id] then return "pending" end
			if fr.status ~= "online" then return fr.status end
			return pt.results[fr.id] or "invite"
		end
		table.insert(rows, UI.HStack("Friend" .. i) { width = "fill", gap = "s", surface = "panel", padding = "s",
			Visible = function(use: Facet.Use): boolean local fr = f(use) return fr ~= nil and matches(use, fr) end,
			Common.portrait(ctx, env.scaled(40), function(use: Facet.Use): any?
				local fr = f(use)
				if not fr then return nil end
				return { name = fr.name, userId = fr.userId, bot = fr.demo, color = if fr.demo then { 0.55, 0.25, 1 } else nil }
			end),
			UI.VStack "Info" { UI.fill(), gap = "xs",
				UI.Text { textRole = "strong", text = function(use: Facet.Use): string local fr = f(use) return fr and fr.name or "" end },
				UI.Text { textRole = "caption", text = function(use: Facet.Use): string
					local fr = f(use)
					if not fr then return "" end
					local st = state(use)
					local presence = if fr.status == "online" then "● Online" elseif fr.status == "racing" then "◐ Racing" else "○ Offline"
					local extra = if st == "member" then " · In your party" elseif st == "pending" then " · Invite pending…" elseif st == "declined" then " · Declined your invite" else ""
					return presence .. extra
				end },
			},
			UI.Button "Invite" {
				label = function(use: Facet.Use): string
					local st = state(use)
					return if st == "member" then "✓ In party" elseif st == "pending" then "Pending…" elseif st == "offline" then "Offline"
						elseif st == "racing" then "In a race" elseif st == "declined" then "Invite again" else "Invite"
				end,
				enabled = function(use: Facet.Use): boolean local st = state(use) return st == "invite" or st == "declined" end,
				onActivate = function()
					local fr = friends:peek()[i]
					if fr then ctx.req("invite", fr.id, true) end
				end },
		})
	end
	return UI.Sheet "Party" {
		title = "Party", isPresented = ctx.open.party, placement = "center", detents = { "hug" },
		content = function()
			return UI.VStack "Body" { width = "fill", gap = "s", maxWidth = env.scaled(560),
				UI.Text { textRole = "strong", wrap = true, text = function(use: Facet.Use): string
					local names = {}
					for _, fr in use(friends) do if party(use).members[fr.id] then table.insert(names, fr.name) end end
					return if #names > 0 then "Party: You, " .. table.concat(names, ", ") else "Party: just you"
				end },
				UI.Text { textRole = "caption", wrap = true, text = "Names marked (demo) are demo participants for solo sessions. Nova and Echo accept invites; Rook declines." },
				UI.TextInput "Search" { value = query, placeholder = "Search friends", presentation = "search" },
				UI.Text { textRole = "caption", text = function(use: Facet.Use): string
					if #use(friends) == 0 then return "Loading friends…" end
					local n = 0
					for _, fr in use(friends) do if matches(use, fr) then n += 1 end end
					return if n == 0 then "No friends match “" .. use(query) .. "”." else n .. " friends"
				end },
				UI.Button "ClearSearch" { label = "Clear search", Visible = function(use: Facet.Use): boolean return use(query) ~= "" end, onActivate = function() query:set("") end },
				table.unpack(rows),
			}
		end,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{A1CA95B9-58FE-496F-AF2A-7AEE5FABD385}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Party</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">73c8afe78d24b4d30afced1100001fae</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXD1F32F0278EA463ABB4F2AF3D2BA22B7">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Settings: draft values, server save with honest states, confirmed reset.
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local C = Facet.Compose

local music, sfx = C.cell(0.6), C.cell(0.8)
local damage, shake, reduced = C.cell(true), C.cell(true), C.cell(false)
local graphics = C.cell("High")
local saving, status = C.cell(false), C.cell("")

return function(ctx: any): any
	local UI, Store = ctx.UI, ctx.Store
	local env = ctx.env
	local function accepted(): any
		local p = Store.profile:peek()
		return (p and p.settings) or { music = 0.6, sfx = 0.8, damageNumbers = true, cameraShake = true, graphics = "High", reducedMotion = false }
	end
	local function sync()
		local s = accepted()
		music:set(s.music); sfx:set(s.sfx); damage:set(s.damageNumbers); shake:set(s.cameraShake); reduced:set(s.reducedMotion); graphics:set(s.graphics)
	end
	local dirty = C.formula(function(use: Facet.Use): boolean
		local p = use(Store.profile)
		local s = p and p.settings
		if not s then return false end
		return math.abs(use(music) - s.music) > 0.001 or math.abs(use(sfx) - s.sfx) > 0.001 or use(damage) ~= s.damageNumbers
			or use(shake) ~= s.cameraShake or use(reduced) ~= s.reducedMotion or use(graphics) ~= s.graphics
	end)
	local wasOpen = false
	task.spawn(function()
		while true do
			task.wait(0.15)
			local o = ctx.open.settings:peek()
			if o and not wasOpen then sync(); status:set("") end
			wasOpen = o
		end
	end)
	local function save()
		if saving:peek() then return end
		saving:set(true)
		status:set("saving")
		local r = Store.request("saveSettings", { music = music:peek(), sfx = sfx:peek(), damageNumbers = damage:peek(), cameraShake = shake:peek(), graphics = graphics:peek(), reducedMotion = reduced:peek() })
		saving:set(false)
		status:set(if r.ok then "saved" else "failed:" .. r.message)
	end
	local gfxOptions: { Facet.PickerOption<string> } = { { value = "Low", label = "Low" }, { value = "Medium", label = "Medium" }, { value = "High", label = "High" } }
	local function pct(v: number): string return string.format("%d%%", math.floor(v * 100 + 0.5)) end
	return UI.Sheet "Settings" {
		title = "Settings", isPresented = ctx.open.settings, placement = "center", detents = { "hug" },
		content = function()
			return UI.VStack "Body" { width = "fill", gap = "m", maxWidth = env.scaled(560),
				UI.Text { text = "AUDIO", textRole = "label" },
				UI.Slider "Music" { label = "Music volume", value = music, min = 0, max = 1, step = 0.05, format = pct },
				UI.Slider "Effects" { label = "Effects volume", value = sfx, min = 0, max = 1, step = 0.05, format = pct },
				UI.Text { text = "DISPLAY", textRole = "label" },
				UI.Text { text = "Graphics quality", textRole = "caption" },
				UI.Picker "Graphics" { selected = graphics, options = gfxOptions, style = "segmented" },
				UI.Toggle "Damage" { label = "Impact numbers when you hit a wall", value = damage },
				UI.Text { text = "ACCESSIBILITY", textRole = "label" },
				UI.Toggle "Shake" { label = "Camera shake while boosting", value = shake },
				UI.Toggle "Reduced" { label = "Reduced motion (calmer camera)", value = reduced },
				UI.Text { textRole = "strong", wrap = true, text = function(use: Facet.Use): string
					local s = use(status)
					if s == "saving" then return "Saving…" end
					if string.sub(s, 1, 7) == "failed:" then return "✕ Not saved: " .. string.sub(s, 8) end
					if use(dirty) then return "● Unsaved changes" end
					if s == "saved" then return "✓ Saved" end
					return "All changes saved"
				end },
				UI.HStack "Actions" { width = "fill", gap = "s", wrap = true,
					UI.Button "Save" { label = "Save settings", appearance = "emphasis", busy = saving, UI.fill(),
						enabled = function(use: Facet.Use): boolean return use(dirty) end, onActivate = save },
					UI.Button "Reset" { label = "Reset to defaults", UI.fill(), onActivate = function()
						ctx.confirm({ title = "Reset all settings?", lines = { "Audio, display and accessibility return to their defaults." }, confirm = "Reset settings",
							run = function() return Store.request("resetSettings") end,
							after = function() task.wait(0.3); sync(); status:set("saved") end })
					end },
				},
				UI.Text { text = "CONTROLS", textRole = "label" },
				UI.Text { wrap = true, textRole = "caption", text = table.concat({
					"Drive: W/S or arrows · left stick · touch thumbstick",
					"Steer: A/D · left stick",
					"Boost: E · gamepad X · Boost button",
					"Drift (hold while steering, release to boost): Left Shift · R1 · Drift button",
					"Recover stuck kart: R · L1 · Recover button",
					"Camera view: C · D-pad down · View button",
					"Standings: L · D-pad up · Standings button",
					"Quick chat: Q · gamepad Y · Chat button",
					"Interact in the hub: F · gamepad X",
				}, "\n") },
			}
		end,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{6F4F7A9E-F0FF-4684-B2FF-FAB26E159914}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Settings</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">73c8afe78d24b4d30afced1100001fb0</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX69BED0ABA9F4446B9B33D37932E319B0">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Sprocket the mechanic: short conversation and a power-cell job paid once by the server.
local Players = game:GetService("Players")
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local C = Facet.Compose

local node = C.cell("intro")

return function(ctx: any): any
	local UI, Store = ctx.UI, ctx.Store
	local env = ctx.env
	local open = ctx.open.mechanic
	local function job(use: Facet.Use): any
		local p = use(Store.profile)
		return (p and p.mechanic) or { state = "none", cells = {} }
	end
	ctx.talkToMechanic = function()
		node:set("intro")
		ctx.openOnly("mechanic")
	end
	-- Walking away ends the conversation.
	task.spawn(function()
		while true do
			task.wait(0.3)
			if open:peek() then
				local char = Players.LocalPlayer.Character
				local npc = workspace:FindFirstChild("World") and workspace.World.Hub:FindFirstChild("Mechanic") :: Model?
				if char and char.PrimaryPart and npc and (char.PrimaryPart.Position - npc:GetPivot().Position).Magnitude > 18 then
					open:set(false)
					ctx.toast("info", "You walked away. Conversation ended.")
				end
			end
		end
	end)
	local function line(use: Facet.Use): string
		local n, j = use(node), job(use)
		if n == "about" then return "This is the Neon Hub. Garage to the left, shop to the right, and the race gate dead ahead. The test track is behind you." end
		if n == "work" then
			if j.state == "active" then return string.format("Found my power cells yet? You have %d of 3. They glow green around the plaza.", #j.cells) end
			if j.state == "ready" then return "You found all three! Hand them over and I'll pay you." end
			if j.state == "done" then return "You already sorted my cells. Thanks again, the cart is humming." end
			return "Three power cells fell off my cart around the plaza. Bring all 3 back and I'll pay 500 Credits and 5 Gems."
		end
		if n == "declined" then return "No worries. The offer stands if you change your mind." end
		if n == "accepted" then return "Great! Look for the green glowing cells around the plaza, then come back." end
		if n == "paid" then return "Here you go: 500 Credits and 5 Gems. Pleasure doing business!" end
		return "Hey racer! I'm Sprocket. Engines don't fix themselves. What do you need?"
	end
	local function choice(name: string, label: string, visible: (Facet.Use) -> boolean, fn: () -> ()): Instance
		return UI.Button(name) { label = label, Visible = visible, onActivate = fn }
	end
	return UI.Sheet "Mechanic" {
		title = "Sprocket · Mechanic", isPresented = open, placement = "center", detents = { "hug" },
		content = function()
			return UI.VStack "Body" { width = "fill", gap = "m", maxWidth = env.scaled(520),
				UI.Text { text = line, wrap = true, textRole = "body" },
				UI.Text { textRole = "caption", wrap = true, text = function(use: Facet.Use): string
					local j = job(use)
					return if j.state == "active" then string.format("Job: %s · %d/3", GameData.Mechanic.job, #j.cells)
						elseif j.state == "ready" then "Job complete · reward ready"
						elseif j.state == "done" then "Job finished · reward paid"
						else "Job available"
				end },
				UI.VStack "Choices" { width = "fill", gap = "s", align = "stretch",
					choice("About", "What is this place?", function(use: Facet.Use): boolean return use(node) == "intro" end, function() node:set("about") end),
					choice("Work", "Got any work for me?", function(use: Facet.Use): boolean local n = use(node) return n == "intro" or n == "about" or n == "declined" end, function() node:set("work") end),
					choice("Accept", "Accept the job", function(use: Facet.Use): boolean return use(node) == "work" and job(use).state == "none" end, function()
						local r = ctx.req("mechanic", "accept", true)
						if r.ok then node:set("accepted") end
					end),
					choice("Decline", "Not right now", function(use: Facet.Use): boolean return use(node) == "work" and job(use).state == "none" end, function() node:set("declined") end),
					choice("Claim", "Hand over the power cells", function(use: Facet.Use): boolean return use(node) == "work" and job(use).state == "ready" end, function()
						local r = ctx.req("mechanic", "claim")
						if r.ok then node:set("paid") end
					end),
					UI.Button "Leave" { label = "Goodbye", onActivate = function() open:set(false) end },
				},
			}
		end,
	}
end
]]></ProtectedString>
