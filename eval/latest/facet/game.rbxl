				BackgroundTransparency = 1,
				Size = function(use: ComposeTypes.Use): UDim2
					return D2.fromScale(1, if use(placement) == "sidebar" then 0 else 1)
				end,
				AutomaticSize = function(use: ComposeTypes.Use): Enum.AutomaticSize
					return if use(placement) == "sidebar" then E.AutomaticSize.Y else E.AutomaticSize.X
				end,
				Host.UIPadding {
					PaddingLeft = inset,
					PaddingRight = inset,
					PaddingTop = inset,
					PaddingBottom = inset,
				},
				stripLayout,
				tabItem(ctx, UI, surfaces, spec, {
					isCurrent = isCurrent,
					frame = frame,
					select = select,
					sectionLabels = sectionLabels,
					tabButtons = tabButtons,
					tabMeasures = tabMeasures,
					tabLinks = tabLinks,
					metrics = metrics,
				}),
			},
		}
		scrollLock.own(bar, ctx)
		local function stowOffset(use: ComposeTypes.Use): UDim2
			local amount = use(stow)
			if amount <= 0 then
				return D2.fromOffset(0, 0)
			end
			local place = use(placement)
			if place == "sidebar" then
				return D2.fromOffset(-amount * railWidth(use), 0)
			elseif string.find(place, "bottom") then
				return D2.fromOffset(0, amount * (band(use) + bottomInset(use) + 2 * INSET))
			elseif place == "topBar" then
				return D2.fromOffset(0, -amount * (band(use) + 2 * INSET))
			end
			return D2.fromOffset(0, 0)
		end
		local bandBox = Host.Frame "TabBand" {
			ZIndex = 2,
			BackgroundTransparency = 1,
			Size = function(use: ComposeTypes.Use): UDim2
				if floating(use) then
					return floatingSize(use)
