							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">RaceHud</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">73c8afe78d24b4d30afced1100001ce9</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXE296D1301EEB43339BCDE959977A650F">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Race queue (Solo/Duo), track vote and the results screen.
local Players = game:GetService("Players")
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local Common = require(script.Parent.Common)

return function(ctx: any): any
	local UI, C, Store = ctx.UI, ctx.C, ctx.Store
	local env = ctx.env
	local race = Store.race
	local mode = C.cell("Solo")
	local busy = C.cell(false)
	local dismissedResults = 0
	local lastPhase = ""

	-- Follow server phases: close the lobby when the race starts, open results once per race.
	task.spawn(function()
		while true do
			task.wait(0.2)
			local rc = race:peek()
			if Store.mode:peek() == "race" and ctx.open.race:peek() then ctx.open.race:set(false) end
			if rc.phase == "results" and Store.inRace(rc) and rc.raceId ~= dismissedResults and not ctx.open.results:peek() and Store.mode:peek() == "race" then
				for key, cell in ctx.open do if key ~= "results" then cell:set(false) end end
				ctx.open.results:set(true)
			end
			if rc.phase ~= lastPhase then
				lastPhase = rc.phase
				if rc.phase == "voting" and Store.inRace(rc) then
					ctx.openOnly("race")
				end
			end
		end
	end)

	local function phase(use: Facet.Use): string
		local rc = use(race)
		if Store.inRace(rc) then return rc.phase end
		if Store.queued(rc) then return "queued" end
		return "idle"
	end

	local modeOptions: { Facet.PickerOption<string> } = {
		{ value = "Solo", label = "Solo · 1 racer + CPUs" },
		{ value = "Duo", label = "Duo · 2 racers + CPUs" },
	}

	local function trackButton(t: any): Instance
		return UI.Button("Vote_" .. t.id) {
			label = function(use: Facet.Use): string
				local rc = use(race)
				local mine = (rc.voters or {})["p" .. Players.LocalPlayer.UserId] == t.id
				local count = (rc.votes or {})[t.id] or 0
				return (if mine then "✓ " else "") .. t.name .. " · " .. count .. (if count == 1 then " vote" else " votes")
			end,
			subtitle = t.blurb .. (if t.mode == "Knockout" then "" else " " .. t.laps .. " laps."),
			appearance = function(use: Facet.Use): string
				local mine = (use(race).voters or {})["p" .. Players.LocalPlayer.UserId] == t.id
				return if mine then "emphasis" else "standard"
			end,
			enabled = function(use: Facet.Use): boolean return use(race).phase == "voting" end,
			onActivate = function() ctx.req("vote", t.id, true) end,
		}
	end

	local function leave()
		busy:set(true)
		ctx.req("leaveQueue")
		busy:set(false)
	end

	local lobby = UI.Sheet "RaceLobby" {
		title = "Race", isPresented = ctx.open.race, placement = "center", detents = { "hug" },
		content = function()
			local tracks = {}
			for _, t in GameData.Tracks do table.insert(tracks, trackButton(t)) end
			return UI.VStack "Lobby" { width = "fill", gap = "m", maxWidth = env.scaled(560),
				-- Idle: choose a queue
				UI.VStack "Join" { width = "fill", gap = "s",
					Visible = function(use: Facet.Use): boolean return phase(use) == "idle" end,
					UI.Text { text = "Pick a queue. CPU opponents fill the grid to 6 racers.", wrap = true },
					UI.Picker "Mode" { selected = mode, options = modeOptions, style = "segmented" },
					UI.Text { text = function(use: Facet.Use): string
						local rc = use(race)
						if rc.phase ~= "idle" then return "A race is running now. You will start when it ends." end
						return if use(mode) == "Duo" then "Duo starts when 2 players have joined." else "Solo starts right away."
					end, textRole = "caption", wrap = true },
					UI.Button "JoinQueue" { label = function(use: Facet.Use): string return "Join " .. use(mode) .. " queue" end, appearance = "emphasis", busy = busy,
						onActivate = function()
							if busy:peek() then return end
							busy:set(true)
							ctx.req("queue", mode:peek(), true)
							busy:set(false)
						end },
				},
				-- Queued: waiting for players
				UI.VStack "Queued" { width = "fill", gap = "s",
					Visible = function(use: Facet.Use): boolean return phase(use) == "queued" end,
					UI.Text { textRole = "heading", text = function(use: Facet.Use): string
						local rc = use(race)
						local q = Store.queued(rc)
						local m = q and q.mode or "Solo"
						local joined = 0
						for _, e in rc.queued or {} do if e.mode == m then joined += 1 end end
						local need = if m == "Duo" then 2 else 1
						return string.format("%s queue · %d/%d joined", m, joined, need)
					end },
					UI.Text { wrap = true, text = function(use: Facet.Use): string
						local rc = use(race)
						local q = Store.queued(rc)
						if rc.phase ~= "idle" then return "Waiting for the current race to finish." end
						if q and q.mode == "Duo" then return "Waiting for one more player. Leave any time before the start." end
						return "Starting…"
					end },
					UI.Button "LeaveQueue" { label = "Leave queue", busy = busy, onActivate = leave },
				},
				-- Voting
				UI.VStack "Vote" { width = "fill", gap = "s",
					Visible = function(use: Facet.Use): boolean return phase(use) == "voting" end,
					UI.HStack "Head" { width = "fill",
						UI.Text { text = "Vote for the track", textRole = "heading" }, UI.Spacer {},
						UI.Text { textRole = "numeral", text = function(use: Facet.Use): string
							local rc = use(race)
							return string.format("%ds", math.max(0, math.ceil((rc.voteEnds or 0) - use(Store.time))))
						end } },
					UI.Text { text = "Votes from every racer, CPUs included. Change your vote until the timer ends.", textRole = "caption", wrap = true },
					UI.VStack "Tracks" { width = "fill", gap = "s", align = "stretch", table.unpack(tracks) },
					UI.Button "LeaveLobby" { label = "Leave race", busy = busy, onActivate = leave },
				},
				-- Winner reveal
				UI.VStack "Reveal" { width = "fill", gap = "s",
					Visible = function(use: Facet.Use): boolean local ph = phase(use) return ph == "reveal" or ph == "countdown" end,
					UI.Text { text = "Voting closed", textRole = "caption" },
					UI.Text { textRole = "title", wrap = true, text = function(use: Facet.Use): string
						local rc = use(race)
						local t = rc.winner and GameData.find(GameData.Tracks, rc.winner)
						return t and (t :: any).name or ""
					end },
					UI.Text { wrap = true, text = function(use: Facet.Use): string
						local rc = use(race)
						local t = rc.winner and GameData.find(GameData.Tracks, rc.winner) :: any
						if not t then return "" end
						return string.format("%d of %d votes · %s · %d laps. Get ready!", (rc.votes or {})[t.id] or 0, 6, t.mode, t.laps)
					end },
				},
			}
		end,
	}

	-- Results
	local function myResult(use: Facet.Use): any?
		for _, r in use(race).results or {} do
			if r.userId == Players.LocalPlayer.UserId then return r end
		end
		return nil
	end
	local function closeResults()
		dismissedResults = race:peek().raceId
		ctx.open.results:set(false)
		if Store.mode:peek() == "race" then
			ctx.req("returnToHub", nil, true)
		end
	end
	local resultRows = {}
	for i = 1, 6 do
		local function entry(use: Facet.Use): any? return (use(race).results or {})[i] end
		table.insert(resultRows, UI.HStack("Result" .. i) { width = "fill", gap = "s",
			Visible = function(use: Facet.Use): boolean return entry(use) ~= nil end,
			UI.Text { text = Store.ordinal(i), textRole = "strong", Size = UDim2.fromOffset(env.scaled(40), 0) },
			Common.portrait(ctx, env.scaled(34), entry),
			UI.Text { UI.fill(), text = function(use: Facet.Use): string
				local r = entry(use)
				if not r then return "" end
				return if r.userId == Players.LocalPlayer.UserId then "▶ " .. r.name .. " (You)" else r.name
			end },
			UI.Text { textRole = "caption", text = function(use: Facet.Use): string
				local r = entry(use)
				if not r then return "" end
				if r.out then return "OUT" end
				if r.finished and r.finishTime then return string.format("%d:%05.2f", math.floor(r.finishTime / 60), r.finishTime % 60) end
				return "DNF"
			end },
		})
	end
	local results = UI.Sheet "Results" {
		title = "Race results", isPresented = ctx.open.results, placement = "center", detents = { "hug" },
		onPresentedChange = function(v: boolean) if not v then closeResults() end end,
		content = function()
			return UI.VStack "Body" { width = "fill", gap = "m", maxWidth = env.scaled(560),
				UI.Text { textRole = "title", text = function(use: Facet.Use): string
					local r = myResult(use)
					if not r then return "Race over" end
					if r.out then return "Knocked out · " .. Store.ordinal(r.position) end
					return if r.finished then "You finished " .. Store.ordinal(r.position) else "Did not finish · " .. Store.ordinal(r.position)
				end, wrap = true },
				UI.VStack "Rewards" { surface = "panel", padding = "m", gap = "xs", width = "fill",
					UI.Text { text = "REWARDS ACCEPTED", textRole = "label" },
					UI.Text { textRole = "strong", wrap = true, text = function(use: Facet.Use): string
						local r = myResult(use)
						local rw = r and r.reward
						if not rw then return "No rewards" end
						return string.format("+%s Credits   +%d Gems   +%d XP", Store.fmt(rw.credits), rw.gems, rw.xp)
					end },
					UI.Text { textRole = "caption", wrap = true, text = function(use: Facet.Use): string
						local r = myResult(use)
						local rw = r and r.reward
						if not rw then return "" end
						local bits = {}
						if rw.levelUp then table.insert(bits, "LEVEL UP! Now level " .. rw.level) end
						if rw.xpBoost then table.insert(bits, "Double XP applied") end
						if rw.creditBoost then table.insert(bits, "Credit Surge applied") end
						local pr = use(Store.profile)
						if pr then table.insert(bits, "Wallet: " .. Store.fmt(pr.credits) .. " Credits · " .. Store.fmt(pr.gems) .. " Gems · " .. pr.races .. " races") end
						return table.concat(bits, " · ")
					end },
				},
				UI.VStack "Order" { width = "fill", gap = "xs", table.unpack(resultRows) },
				UI.Button "Continue" { label = "Back to hub", appearance = "emphasis", onActivate = closeResults },
			}
		end,
	}
	return { lobby, results }
end
]]></ProtectedString>
							<string name="ScriptGuid">{4382A8AF-257E-4038-9A76-059E153EAB5A}</string>
