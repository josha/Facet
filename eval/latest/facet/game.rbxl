								<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
								<UniqueId name="UniqueId">73c8afe78d24b4d30afced11000007ac</UniqueId>
							</Properties>
						</Item>
						<Item class="StringValue" referent="976">
							<Properties>
								<string name="Value"><![CDATA[# VirtualList.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
arrival: Input<"none" | "rise">? = omitted
autoFocus: boolean? = omitted
autoscroll: boolean? = omitted
cards: { perView: number?, minWidth: number?, peek: number? }? = omitted
children: (((item: V) -> { V }?) | string)<V>? = omitted
collectionId: unknown? = omitted
columns: ValueNumber? = omitted
contentOverflow: Input<"visible" | "clip">? = omitted
controls: OrderedCollectionControls<K>? | OrderedCollectionControls<V>? = omitted
crossGap: ValueNumber? = omitted
deletable: boolean? = omitted
direction: OrderedCollectionDirection? = omitted
disabled: RowPredicate<V>? = omitted
drag: ((items: { V }, keys: { K }) -> DraggableSpec)? | ((items: { V }, keys: { V }) -> DraggableSpec)? = omitted
dragLabel: ((item: V) -> string)? = omitted
drop: DropTargetSpec? = omitted
editing: ValueBoolean? = omitted
expanded: Value<Selection<K>>? | Value<Selection<V>>? = omitted
focus: FocusControls<K>? | FocusControls<V>? = omitted
focusPolicy: ("key" | "index")? = omitted
follow: Input<("end" | "none")>? = omitted
followThreshold: number? = omitted
from: Input<{ V }> = required
gap: ValueNumber? = omitted
hug: boolean? = omitted
indent: ValueNumber? = omitted
