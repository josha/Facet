					<Item class="ModuleScript" referent="239">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Types = require("./types")

return function(ctx: Types.Context, frame: ScrollingFrame, source: Types.Input<Vector2>?)
	if source == nil then
		return
	end
	local pending: Vector2? = ctx.read<<Vector2?>>(source)
	local canvas = ctx.observe.AbsoluteCanvasSize(frame)
	local window = ctx.observe.AbsoluteWindowSize(frame)
	local function cancel(input: InputObject)
		local kind = input.UserInputType
		local E = ctx.types.Enum
		if
			kind == E.UserInputType.Touch
			or kind == E.UserInputType.MouseButton1
			or kind == E.UserInputType.MouseWheel
		then
			pending = nil
		end
	end
	ctx.runtime.connect(frame, "InputBegan", cancel)
	ctx.runtime.connect(frame, "InputChanged", cancel)
	ctx.Compose.watch(function(use)
		local extent, view = use(canvas), use(window)
		local goal = pending
		if goal == nil or view.X <= 0 or view.Y <= 0 then
			return
		end
		if (goal.X ~= 0 and extent.X <= view.X) or (goal.Y ~= 0 and extent.Y <= view.Y) then
			return
		end
		frame.CanvasPosition = goal
		if frame.CanvasPosition == goal then
			pending = nil
		end
	end)
end
]]></ProtectedString>
							<string name="ScriptGuid">{73762F70-2FA8-4662-A15D-7C9C750825AC}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">scroll_initial</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">73c8afe78d24b4d30afced11000004cd</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="240">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Types = require("./types")
local chain = require("./scroll_chain")
local scrollLock = {}

type Hold = { count: number, saved: boolean, watch: RBXScriptConnection }

local holds: { [ScrollingFrame]: Hold } = setmetatable({}, { __mode = "k" })
local owned: { [ScrollingFrame]: boolean } = setmetatable({}, { __mode = "k" })

local function take(frame: ScrollingFrame)
	local current = holds[frame]
	if current then
		current.count += 1
		return
	end
	local created: Hold = {
		count = 1,
		saved = frame.ScrollingEnabled,
		watch = frame:GetPropertyChangedSignal("ScrollingEnabled"):Connect(function()
			local held = holds[frame]
			if held and frame.ScrollingEnabled then
				held.saved = true
				frame.ScrollingEnabled = false
			end
		end),
	}
	holds[frame] = created
	if created.saved then
		frame.ScrollingEnabled = false
	end
end

local function give(frame: ScrollingFrame)
	local current = holds[frame]
	if current == nil then
		return
	end
	current.count -= 1
	if current.count == 0 then
		holds[frame] = nil
		current.watch:Disconnect()
		if frame.ScrollingEnabled ~= current.saved then
			frame.ScrollingEnabled = current.saved
		end
	end
end

function scrollLock.own(frame: ScrollingFrame, ctx: Types.Context?)
	owned[frame] = true
	if ctx then
		chain(ctx, frame, function(candidate: ScrollingFrame): boolean
			return owned[candidate] == true
		end, function(exhausted: ScrollingFrame): () -> ()
			take(exhausted)
			return function()
				give(exhausted)
			end
		end)
	end
end

local function holdAncestors(node: Instance, ownedOnly: boolean): () -> ()
	local held: { ScrollingFrame } = {}
	local at = node.Parent
	while at do
		if at:IsA("ScrollingFrame") and (not ownedOnly or owned[at]) then
			take(at)
			table.insert(held, at)
		end
		at = at.Parent
	end
	return function()
		for _, frame in held do
			give(frame)
		end
		table.clear(held)
	end
end

function scrollLock.holdOwnedAncestors(node: Instance): () -> ()
	return holdAncestors(node, true)
end

function scrollLock.holdAncestors(node: Instance): () -> ()
	return holdAncestors(node, false)
end

return scrollLock
]]></ProtectedString>
