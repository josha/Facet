	read TouchRotate: (({ Vector2 }, number, number, Enum.UserInputState) -> ())?,
	read TouchSwipe: ((Enum.SwipeDirection, number) -> ())?,
	read TouchTap: (({ Vector2 }) -> ())?,
	read Visible: Engine.ValueBoolean?,
	read ZIndex: Engine.ValueNumber?,
	read Style: Engine.ValueEnumFrameStyle?,
	read ref: ((Frame) -> ())?,
	read items: Engine.Input<{ Radial.RadialItem<V> }>,
	read label: Engine.ValueString?,
	read icon: Engine.ValueString?,
	read launcher: boolean?,
	read preset: Radial.Preset?,
	read appearance: Radial.Appearance?,
	read buttonSurface: ("native" | "none")?,
