							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Compose = require("../vendor/compose/core")
local Engine = require("./engine_types")
local Collections = require("./collection_types")

local Env = require("./environment_types")
local Navigation = require("./navigation_types")
local Types = require("./types")

export type KeyedCollectionSpec<V, K> = {
	Changed: ((string) -> ())?,
	Attributes: Engine.Attributes?,
	AncestryChanged: ((Instance, Instance?) -> ())?,
	Archivable: Engine.ValueBoolean?,
	AttributeChanged: ((string) -> ())?,
	Capabilities: Engine.ValueSecurityCapabilities?,
	ChildAdded: ((Instance) -> ())?,
	ChildRemoved: ((Instance) -> ())?,
	DescendantAdded: ((Instance) -> ())?,
	DescendantRemoving: ((Instance) -> ())?,
	Destroying: (() -> ())?,
	Name: Engine.ValueString?,
	Parent: (Engine.ValueInstanceOptional | Engine.StaticValue)?,
	Sandboxed: Engine.ValueBoolean?,
	StyledPropertiesChanged: (() -> ())?,
	AutoLocalize: Engine.ValueBoolean?,
	RootLocalizationTable: (Engine.ValueLocalizationTableOptional | Engine.StaticValue)?,
	SelectionBehaviorDown: Engine.ValueEnumSelectionBehavior?,
	SelectionBehaviorLeft: Engine.ValueEnumSelectionBehavior?,
	SelectionBehaviorRight: Engine.ValueEnumSelectionBehavior?,
	SelectionBehaviorUp: Engine.ValueEnumSelectionBehavior?,
	SelectionChanged: ((boolean, GuiObject, GuiObject) -> ())?,
	SelectionGroup: Engine.ValueBoolean?,
	Active: Engine.ValueBoolean?,
	AnchorPoint: Engine.ValueVector2?,
	AutomaticSize: Engine.ValueEnumAutomaticSize?,
	BackgroundColor3: Engine.ValueColor3?,
	BackgroundTransparency: Engine.ValueNumber?,
	BorderColor3: Engine.ValueColor3?,
	BorderMode: Engine.ValueEnumBorderMode?,
	BorderSizePixel: Engine.ValueNumber?,
	ClipsDescendants: Engine.ValueBoolean?,
	InputBegan: ((InputObject) -> ())?,
	InputChanged: ((InputObject) -> ())?,
	InputEnded: ((InputObject) -> ())?,
	InputSink: Engine.ValueEnumInputSink?,
	Interactable: Engine.ValueBoolean?,
	LayoutOrder: Engine.ValueNumber?,
	MouseEnter: ((number, number) -> ())?,
	MouseLeave: ((number, number) -> ())?,
	MouseMoved: ((number, number) -> ())?,
	MouseWheelBackward: ((number, number) -> ())?,
	MouseWheelForward: ((number, number) -> ())?,
	NextSelectionDown: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
	NextSelectionLeft: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
	NextSelectionRight: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
	NextSelectionUp: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
	Position: Engine.ValueUDim2?,
	Rotation: Engine.ValueNumber?,
	Selectable: Engine.ValueBoolean?,
	SelectionGained: (() -> ())?,
	SelectionImageObject: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
	SelectionLost: (() -> ())?,
	SelectionOrder: Engine.ValueNumber?,
	Size: Engine.ValueUDim2?,
	SizeConstraint: Engine.ValueEnumSizeConstraint?,
	TouchLongPress: (({ Vector2 }, Enum.UserInputState) -> ())?,
	TouchPan: (({ Vector2 }, Vector2, Vector2, Enum.UserInputState) -> ())?,
	TouchPinch: (({ Vector2 }, number, number, Enum.UserInputState) -> ())?,
	TouchRotate: (({ Vector2 }, number, number, Enum.UserInputState) -> ())?,
	TouchSwipe: ((Enum.SwipeDirection, number) -> ())?,
	TouchTap: (({ Vector2 }) -> ())?,
	Visible: Engine.ValueBoolean?,
	ZIndex: Engine.ValueNumber?,
	AutomaticCanvasSize: Engine.ValueEnumAutomaticSize?,
	BottomImage: Engine.ValueString?,
	BottomImageContent: Engine.ValueContent?,
	CanvasPosition: Engine.ValueVector2?,
	CanvasSize: Engine.ValueUDim2?,
	ElasticBehavior: Engine.ValueEnumElasticBehavior?,
	HorizontalScrollBarInset: Engine.ValueEnumScrollBarInset?,
	MidImage: Engine.ValueString?,
	MidImageContent: Engine.ValueContent?,
	ScrollBarImageColor3: Engine.ValueColor3?,
	ScrollBarImageTransparency: Engine.ValueNumber?,
	ScrollBarThickness: Engine.ValueNumber?,
	ScrollingDirection: Engine.ValueEnumScrollingDirection?,
	ScrollingEnabled: Engine.ValueBoolean?,
	TopImage: Engine.ValueString?,
	TopImageContent: Engine.ValueContent?,
	VerticalScrollBarInset: Engine.ValueEnumScrollBarInset?,
	VerticalScrollBarPosition: Engine.ValueEnumVerticalScrollBarPosition?,
	ref: ((ScrollingFrame) -> ())?,
	selection: Compose.Value<Collections.Selection<K>>?,
	selectionFrom: Types.Input<{ V }>?,
	selectionIndicator: boolean?,
	selectionMode: ("none" | "single" | "multiple")?,
	selectable: Collections.RowPredicate<V>?,
	disabled: Collections.RowPredicate<V>?,
	onSelectionChange: ((selection: Collections.Selection<K>) -> ())?,
	editing: Types.ValueBoolean?,
	collectionId: unknown?,
	drag: ((items: { V }, keys: { K }) -> Env.DraggableSpec)?,
	drop: Env.DropTargetSpec?,
	rowDrop: ((Compose.ReadOnlyValue<V>, K) -> Env.DropTargetSpec?)?,
	reorderable: boolean?,
	movable: Collections.RowPredicate<V>?,
	onReorder: ((keys: { K }, slot: number, parentKey: K?) -> ())?,
	deletable: boolean?,
	rowDeletable: Collections.RowPredicate<V>?,
	onDelete: ((keys: { K }) -> ())?,
	dragLabel: ((item: V) -> string)?,
	autoscroll: boolean?,
	direction: Compose.OrderedCollectionDirection?,
	expanded: Compose.Value<Collections.Selection<K>>?,
	onExpansionChange: ((expanded: Collections.Selection<K>) -> ())?,
	indent: Types.ValueNumber?,
	from: Types.Input<{ V }>,
	recycle: boolean?,
	slots: Types.Input<{ K }>?,
	slotControls: Collections.SlotControls<K>?,
	render: Collections.RowRender<V, K>?,
