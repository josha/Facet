							<ProtectedString name="Source"><![CDATA[--!strict
-- Hub HUD: wallet, level, race count, zone progress and destinations.
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local GameData = require(game.ReplicatedStorage.Shared.GameData)

return function(ctx: any): any
	local UI, C, Store = ctx.UI, ctx.C, ctx.Store
	local env = ctx.env
	local profile = Store.profile
	local function p(use: Facet.Use): any return use(profile) or {} end
	local isHub = C.formula(function(use: Facet.Use): boolean
		local m = use(Store.mode)
		return m == "hub"
	end)
	local function dailyReady(use: Facet.Use): boolean
		local pr = p(use)
		if not pr.daily then return false end
		use(Store.clock)
		local today = math.floor(Store.now() / 86400)
		return pr.daily.lastDay ~= today
	end
	local function boostText(use: Facet.Use): string
		local pr = p(use)
		use(Store.clock)
		local parts = {}
		for _, b in GameData.Boosts do
			local exp = (pr.boosts or {})[b.id]
			if exp and exp > Store.now() then
				table.insert(parts, b.name .. " " .. Store.clockText(exp - Store.now()))
			end
		end
		return table.concat(parts, " · ")
	end

	local xpWidth = env.scaled(220)
	return C.show(isHub, function()
	local function nav(name: string, label: string, icon: string, key: string): Instance
		return UI.Button(name) { label = label, icon = icon, onActivate = function() ctx.openOnly(key) end }
	end
	local garageBtn = UI.Button "Garage" { label = "Garage", icon = "car", onActivate = function() ctx.openOnly("garage") end }
	local shopBtn = UI.Button "Shop" { label = "Shop", icon = "bag", onActivate = function() ctx.openOnly("shop") end }
	local raceBtn = UI.Button "Race" { label = "Race", subtitle = "Join the queue", icon = "flag", appearance = "emphasis", onActivate = function() ctx.openOnly("race") end }
	ctx.anchors.garage, ctx.anchors.shop, ctx.anchors.race = garageBtn, shopBtn, raceBtn
	local rewardsBtn = UI.Button "Rewards" { label = function(use: Facet.Use): string return if dailyReady(use) then "Rewards · Ready" else "Rewards" end,
		icon = "gift", onActivate = function() ctx.openOnly("rewards") end }
	local helpBtn = UI.Button "Help" { label = "Help", icon = "status.info", onActivate = function() if ctx.startTutorial then ctx.startTutorial() end end }
	ctx.anchors.help = helpBtn
	local moreBtn = UI.Button "More" { label = "Menu", icon = "menu", onActivate = function() ctx.openOnly("menu") end }
	ctx.anchors.more = moreBtn

		return UI.Composition "HubHUD" {
			UI.Region "Profile" { zone = "topLeft", rank = 3,
				UI.VStack "Full" { surface = "panel", padding = "m", gap = "xs",
					UI.HStack "Level" { gap = "s",
						UI.Text { text = function(use: Facet.Use): string return "LEVEL " .. tostring(p(use).level or 1) end, textRole = "heading" },
						UI.Text { text = function(use: Facet.Use): string return tostring(p(use).races or 0) .. " races" end, textRole = "caption" },
					},
					UI.ProgressView "XP" { Size = UDim2.fromOffset(xpWidth, 0),
						value = function(use: Facet.Use): number
							local pr = p(use)
							return (pr.xp or 0) / GameData.xpForLevel(pr.level or 1)
						end,
						endLabel = function(use: Facet.Use): string
							local pr = p(use)
							return Store.fmt(pr.xp or 0) .. " / " .. Store.fmt(GameData.xpForLevel(pr.level or 1)) .. " XP"
						end },
					UI.Text { text = function(use: Facet.Use): string
						local pr = p(use)
						local s = pr.save or { message = "Connecting…" }
						return "☁ " .. s.message
					end, textRole = "caption", role = "secondary" },
				},
				UI.HStack "Short" { surface = "panel", padding = "s", gap = "s",
					UI.Text { text = function(use: Facet.Use): string return "LV " .. tostring(p(use).level or 1) end, textRole = "strong" },
					UI.Text { text = function(use: Facet.Use): string return tostring(p(use).races or 0) .. " races" end, textRole = "caption" },
				},
			},
			UI.Region "Wallet" { zone = "topRight", rank = 1,
				UI.VStack "Full" { surface = "panel", padding = "s", gap = "xs", align = "end",
					UI.Text { text = function(use: Facet.Use): string return Store.short(p(use).credits or 0) .. " Credits" end, textRole = "heading" },
					UI.Text { text = function(use: Facet.Use): string return Store.short(p(use).gems or 0) .. " Gems" end, textRole = "strong" },
					UI.Text { text = function(use: Facet.Use): string
						local b = boostText(use)
						return if b == "" then "No boost active" else "⚡ " .. b
					end, textRole = "caption", role = "secondary" },
				},
				UI.VStack "Short" { surface = "panel", padding = "xs", gap = "xs", align = "end",
					UI.Text { text = function(use: Facet.Use): string return Store.short(p(use).credits or 0) .. " Cr" end, textRole = "caption" },
					UI.Text { text = function(use: Facet.Use): string return Store.short(p(use).gems or 0) .. " Gems" end, textRole = "caption" } },
			},
			UI.Region "Zone" { zone = "top", rank = 5, mayDrop = true,
				UI.VStack "Full" { surface = "panel", padding = "s", gap = "xs", align = "center",
					UI.Text { text = "NEON HUB", textRole = "label" },
					UI.Text { text = function(use: Facet.Use): string
						local pr = p(use)
						local m = pr.mechanic or { state = "none", cells = {} }
						local job = if m.state == "active" then string.format("Power cells %d/3", #m.cells)
							elseif m.state == "ready" then "Job done · see Sprocket"
							elseif m.state == "done" then "Sprocket's job complete"
							else "Sprocket has a job"
						local last = pr.lastRace
						local income = if last and last.reward then string.format(" · Last race +%s Credits", Store.fmt(last.reward.credits)) else ""
						return job .. income
					end, textRole = "caption" },
				},
			},
			UI.Region "Destinations" { zone = "left", rank = 4,
				UI.VStack "Full" { gap = "xs", align = "stretch",
					nav("Livery", "Livery", "edit", "livery"),
					nav("Inventory", "Parts & Drivers", "bolt", "inventory"),
					nav("Crates", "Crates", "star", "crates"),
					rewardsBtn,
					nav("Party", "Party", "person", "party"),
					nav("Settings", "Settings", "settings", "settings"),
					helpBtn,
				},
				UI.VStack "Compact" { moreBtn },
			},
			UI.Region "Primary" { zone = "action", rank = 1,
				UI.VStack "Actions" { gap = "s", align = "stretch",
					raceBtn,
					UI.HStack "Row" { gap = "s", garageBtn, shopBtn },
				},
			},
		}
	end)
end
]]></ProtectedString>
							<string name="ScriptGuid">{90B73B89-4DEF-47D6-AC85-F411BE4ACD7B}</string>
