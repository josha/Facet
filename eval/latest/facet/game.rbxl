	read MouseWheelForward: ((number, number) -> ())?,
	read NextSelectionDown: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
	read NextSelectionLeft: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
	read NextSelectionRight: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
	read NextSelectionUp: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
