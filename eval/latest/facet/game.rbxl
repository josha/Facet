							</Properties>
						</Item>
						<Item class="StringValue" referent="1058">
							<Properties>
								<string name="Value"><![CDATA[--!strict
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local relicArt = require(script.Parent.Parent.assets["relic-art"])

type Relic = {
	id: string,
	name: string,
	origin: string,
	material: string,
	light: string,
	mount: string,
	description: string,
	color: Color3,
}
export type InspectionModel = {
	selection: Facet.Value<{ [string]: boolean }>,
	column: Facet.Value<"sidebar" | "detail">,
	notesExpanded: Facet.Value<boolean>,
}
export type State = {
	accepted: Facet.ReadOnlyValue<string>,
	busy: Facet.ReadOnlyValue<boolean>,
	message: Facet.ReadOnlyValue<string>,
	inspection: InspectionModel?,
}
export type Callbacks = { commit: (string) -> (), close: () -> () }

local relics: { Relic } = {
	{
		id = "sun",
		name = "Sun prism",
		origin = "East Observatory",
		material = "Amber",
		light = "Warm",
		mount = "Brass cradle",
		description = "Recovered from the East Observatory. The brass cradle still carries the surveyors' sun marks.",
		color = Color3.fromRGB(197, 133, 68),
	},
	{
		id = "tide",
		name = "Tide lens",
		origin = "Tidal chamber",
		material = "Sea glass",
		light = "Cool",
		mount = "Polished glass",
		description = "Found below the tide line. The lens once guided returning survey boats through the reef.",
		color = Color3.fromRGB(78, 137, 147),
	},
}

return {
	theme = require(script.Parent.Parent.assets["field-station-theme"]),
	build = function(app: Facet.App, state: State, callbacks: Callbacks): Frame
		local C, UI, Host = Facet.Compose, app.UI, Facet.host(app.runtime)
		local model: InspectionModel = state.inspection
			or {
				selection = C.cell({ sun = true }),
				column = C.cell("sidebar" :: "sidebar" | "detail"),
				notesExpanded = C.cell(false),
			}
		state.inspection = model
		local selection, column, notesExpanded = model.selection, model.column, model.notesExpanded
		local back = C.cell(false)
		local taskBody = UI.ZStack "TaskBody" { width = "fill", height = "fill", UI.fill() }
		local chosen = C.formula(function(use: Facet.Use): Relic
			for _, relic in relics do
				if use(selection)[relic.id] then
					return relic
				end
			end
			return relics[1]
		end)
		local function trait(label: string, field: "material" | "light" | "mount"): Frame
			return UI.VStack(label)({
				gap = "xs",
				UI.Text {
					text = function(use: Facet.Use): string
						local relic = use(chosen)
						return if field == "material"
							then relic.material
							elseif field == "light" then relic.light
							else relic.mount
					end,
					textRole = "strong",
				},
				UI.Text { text = label, textRole = "caption", role = "secondary" },
			})
		end
		local chosenId = C.formula(function(use: Facet.Use): string
			return use(chosen).id
		end)
		local function subject(): ViewportFrame
			return UI.Stage "Relic" {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				camera = CFrame.lookAt(Vector3.new(4, 2.4, 6.5), Vector3.new(0, -0.1, 0)),
				fieldOfView = 36,
				content = function(runtime, world)
					return relicArt(runtime, world, chosenId, relics[1].color, relics[2].color)
				end,
			}
		end
		local function decision(): Frame
			return UI.VStack "Decision" {
				width = "fill",
				gap = "s",
				align = "stretch",
				UI.Text {
					text = function(use: Facet.Use)
						return use(chosen).name
					end,
					textRole = "title",
					wrap = true,
				},
				UI.HStack "Traits" {
					width = "fill",
					wrap = true,
					gap = "l",
					trait("Material", "material"),
					trait("Light", "light"),
					trait("Mount", "mount"),
				},
				UI.Button "CommitRelic" {
					label = function(use: Facet.Use)
						return if use(state.accepted) == use(chosen).id
							then "Selected for display"
							else "Display this relic"
					end,
					appearance = "emphasis",
					busy = state.busy,
					enabled = function(use: Facet.Use)
						return not use(state.busy) and use(state.accepted) ~= use(chosen).id
					end,
					onActivate = function()
						callbacks.commit(chosen:peek().id)
					end,
				},
				UI.Text { text = state.message, textRole = "caption", wrap = true },
				UI.DisclosureGroup "ObjectNotes" {
					label = "Field notes",
					expanded = notesExpanded,
					content = function(): Instance
						return UI.Text {
							text = function(use: Facet.Use)
								return use(chosen).description
							end,
							wrap = true,
						}
					end,
				},
			}
		end
		local list: Facet.KeyedCollectionSpec<Relic, string> = {
			from = relics,
			key = "id",
			selection = selection,
			selectionMode = "single",
			itemSize = 96,
			measure = true,
			autoFocus = false,
			focusPolicy = "key",
			Size = UDim2.fromScale(1, 1),
			onActivate = function()
				column:set("detail")
			end,
			render = function(current)
				return UI.Card "RelicCard" {
					title = function(use: Facet.Use)
						return (if use(selection)[use(current).id] then "Selected: " else "") .. use(current).name
					end,
					caption = function(use: Facet.Use)
						return use(current).origin
					end,
					artwork = function(): GuiObject
						return Host.Frame "Swatch" {
							BackgroundColor3 = function(use: Facet.Use): Color3
								return use(current).color
							end,
							BorderSizePixel = 0,
						}
					end,
					imageAspectRatio = 5,
				}
			end,
			UI.fill(),
		}
		local panes: Facet.NavigationSplitViewProps = {
			Parent = C.static(taskBody),
			preferredCompactColumn = column,
			compactBack = back,
			detailLabel = false,
			resizable = false,
			compactWidth = 1000,
			compactHeight = 500,
			minSidebarWidth = 220,
			maxSidebarWidth = 300,
			minDetailWidth = 500,
			sidebar = function(): Instance
				return UI.ZStack "BrowseBody" {
					width = "fill",
					height = "fill",
					alignH = "center",
					UI.VStack "Collection" {
						width = "fill",
						maxWidth = 520,
						height = "fill",
						padding = "s",
						UI.VirtualList "Relics" (list),
					},
				}
			end,
			detail = function(): Instance
				local body = UI.ZStack "InspectionBody" {
					width = "fill",
					height = "fill",
					alignH = "center",
					alignV = "center",
					UI.fill(),
				}
				local room = UI.environment(body)
				local sideBySide = C.formula(function(use: Facet.Use): boolean
					return use(room.viewportWidth) >= 560
				end)
				UI.ZStack "InspectionContent" {
					Parent = C.static(body),
					width = "fill",
					height = "fill",
					alignH = "center",
					alignV = "center",
					C.show(sideBySide, function()
						return UI.HStack "SubjectAndDecision" {
							width = "fill",
							maxWidth = 960,
							height = function(use: Facet.Use): number
								return math.max(0, use(room.viewportHeight))
							end,
							gap = "m",
							padding = "s",
							align = "stretch",
							UI.ZStack "Subject" { width = "fill", height = "fill", UI.fill(), subject() },
							UI.ScrollView "DecisionScroll" {
								width = function(use: Facet.Use): number
									return if use(room.viewportWidth) < 800 then 280 else 340
								end,
								height = "fill",
								gap = "s",
								padding = "s",
								decision(),
							},
						}
					end, function()
						return UI.ScrollView "PortraitInspection" {
							width = "fill",
							maxWidth = 520,
							height = "fill",
							gap = "s",
							padding = "s",
							UI.ZStack "Subject" {
								width = "fill",
								height = function(use: Facet.Use): number
									return math.max(144, math.min(230, use(room.viewportHeight) * 0.36))
								end,
								subject(),
							},
							decision(),
						}
					end),
				}
				return body
			end,
			UI.fill(),
		}
		UI.NavigationSplitView "RelicPanes" (panes)
		local close: GuiObject = UI.Button {
			label = "Close",
			appearance = "utility",
			onActivate = function()
				callbacks.close()
			end,
		}
		local navigation: Facet.NavBarSpec = {
			title = "Field Station / Relics",
			titleSize = "heading",
			onBack = back,
			trailing = close,
		}
		local canvas = UI.ZStack "ArchiveCanvas" {
			width = "fill",
			height = "fill",
			UI.fill(),
		}
		local room = UI.environment(canvas)
		UI.VStack "ArchivePanel" {
			Parent = C.static(canvas),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			width = "fill",
			maxWidth = 1240,
			height = function(use: Facet.Use): number
				return math.max(0, math.min(720, use(room.viewportHeight)))
			end,
			surface = "surface",
			padding = "s",
			gap = 0,
			UI.NavBar(navigation),
			taskBody,
		}
		return UI.Screen "RelicInspection" { padding = "m", canvas }
	end,
}
]]></string>
								<BinaryString name="AttributesSerialize"></BinaryString>
								<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
								<bool name="DefinesCapabilities">false</bool>
								<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
								<string name="Name">inspection.luau</string>
								<BinaryString name="SerializedOverrides"></BinaryString>
								<int64 name="SourceAssetId">-1</int64>
								<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
								<UniqueId name="UniqueId">73c8afe78d24b4d30afced11000007ff</UniqueId>
							</Properties>
						</Item>
						<Item class="StringValue" referent="1059">
							<Properties>
								<string name="Value"><![CDATA[--!strict
local Facet = require(game.ReplicatedStorage.Packages.Facet)

export type Gain = { value: string, label: string }
export type Standing = { id: string, name: string, result: string }
export type AcceptedOutcome = {
	title: string,
	context: string?,
	gains: { Gain },
	standings: { Standing }?,
	standingsLabel: string?,
	explanation: string?,
}
export type State = { accepted: AcceptedOutcome }
export type Callbacks = { onContinue: () -> () }

local Outcome = {}

function Outcome.build(app: Facet.App, state: State, callbacks: Callbacks): Frame
	local C, UI, Host = Facet.Compose, app.UI, Facet.host(app.runtime)
	local result = state.accepted
	local root = Host.Frame "OutcomeTask" { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }
	local room = UI.environment(root)
	local open, details, explanation = C.cell(true), C.cell(false), C.cell(false)
	local finished = false
	local function continue()
		if finished then
			return
		end
		finished = true
		open:set(false)
		callbacks.onContinue()
	end
	local function short(use: Facet.Use): boolean
		return use(room.viewportHeight) < 520 and use(room.viewportWidth) > 600
	end
	local function support(use: Facet.Use): boolean
		return short(use) and (use(details) or use(explanation))
	end
	local function summary()
		details:set(false)
		explanation:set(false)
	end
	local detents: { Facet.SheetDetent } = { "hug", { id = "bounded", fraction = 0.88 } }
	local detent = C.cell("hug")
	C.watch(function(use: Facet.Use)
		detent:set(if short(use) then "bounded" else "hug")
	end)
	local actions: { Facet.OverlayAction } = {
		{ id = "Continue", label = "Continue", role = "default", onActivate = continue },
	}
	UI.Sheet "AcceptedOutcome" {
		Parent = C.static(root),
		title = result.title,
		header = false,
		closeButton = false,
		isPresented = open,
		placement = "center",
		width = function(use: Facet.Use): "narrow" | "wide"
			return if use(room.viewportWidth) < 600 then "narrow" else "wide"
		end,
		detents = detents,
		detent = detent,
		actions = actions,
		initialFocus = "Continue",
		onPresentedChange = function(presented: boolean)
			if not presented then
				if
					room.viewportHeight:peek() < 520
					and room.viewportWidth:peek() > 600
					and (details:peek() or explanation:peek())
				then
					summary()
				else
					continue()
				end
			end
		end,
		content = function()
			local gainsArea = Host.Frame "GainsArea" {
				BackgroundTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = function(use: Facet.Use): UDim2
					return if short(use) then UDim2.new(0.55, -8, 0, 0) else UDim2.new(1, 0, 0, 0)
				end,
			}
			local gainsRoom = UI.environment(gainsArea)
			local function verticalGains(use: Facet.Use): boolean
				return use(gainsRoom.viewportWidth) < math.max(1, #result.gains) * 150
			end
			local gains: { Instance } = {}
			for index, gain in result.gains do
				gains[index] = UI.VStack("Gain" .. index)({
					Size = function(use: Facet.Use): UDim2
						return if verticalGains(use)
							then UDim2.new(1, 0, 0, 0)
							else UDim2.new(1 / math.max(1, #result.gains), -12, 0, 0)
					end,
					AutomaticSize = Enum.AutomaticSize.Y,
					gap = "xs",
					UI.Text "Value" { text = gain.value, textRole = "numeral", textAlign = "center", wrap = true },
					UI.Text "Meaning" { text = gain.label, textAlign = "center", wrap = true },
				})
			end
			local standings = result.standings or {}
			local columns: { Facet.TableColumn<Standing, string> } = {
				{
					id = "name",
					label = "Participant",
					value = function(row: Standing)
						return row.name
					end,
				},
				{
					id = "result",
					label = "Contribution",
					value = function(row: Standing)
						return row.result
					end,
				},
			}
			local records: Facet.KeyedTableSpec<Standing, string> = {
				from = standings,
				key = "id",
				columns = columns,
				selectionMode = "none",
				header = false,
				Size = function(use: Facet.Use): UDim2
					return UDim2.new(1, 0, 0, math.clamp(use(room.viewportHeight) * 0.3, 140, 240))
				end,
			}
			local contributions: Facet.KeyedTableSpec<Standing, string> = {
				from = standings,
				key = "id",
				columns = columns,
				selectionMode = "none",
				header = false,
				Visible = details,
				Size = UDim2.new(1, 0, 0, 160),
			}
			UI.AdaptiveStack "AcceptedGains" {
				Parent = C.static(gainsArea),
				width = "fill",
				AutomaticSize = Enum.AutomaticSize.Y,
				gap = "m",
				distribute = "center",
				axis = function(use: Facet.Use): "x" | "y"
					return if verticalGains(use) then "y" else "x"
				end,
				table.unpack(gains),
			}

			return UI.VStack "OutcomeBody" {
				width = "fill",
				gap = "m",
				padding = "m",
				UI.VStack "SupportStep" {
					Visible = support,
					width = "fill",
					gap = "s",
					UI.HStack "SupportHeader" {
						width = "fill",
						gap = "m",
						align = "center",
						UI.Button "BackToOutcome" { label = "Back to outcome", onActivate = summary },
						UI.Text(
							{ text = result.title, textRole = "heading", wrap = true, UI.fill() },
							"AcceptedIdentity"
						),
					},
					UI.Table "ContributionDetails" (contributions),
					UI.Text "ChangeDetails" { text = result.explanation or "", wrap = true, Visible = explanation },
				},
				UI.AdaptiveStack "OutcomeAndGains" {
					Visible = function(use: Facet.Use): boolean
						return not support(use)
					end,
					width = "fill",
					gap = "m",
					align = "center",
					axis = function(use: Facet.Use): "x" | "y"
						return if short(use) then "x" else "y"
					end,
					UI.VStack "Outcome" {
						Size = function(use: Facet.Use): UDim2
							return if short(use) then UDim2.new(0.45, -8, 0, 0) else UDim2.new(1, 0, 0, 0)
						end,
						AutomaticSize = Enum.AutomaticSize.Y,
						gap = "s",
						if result.context
							then UI.Text "Context" {
								text = result.context,
								role = "secondary",
								textAlign = "center",
								wrap = true,
							}
							else nil,
						UI.Text "OutcomeTitle" {
							text = result.title,
							textRole = "title",
							textAlign = "center",
							wrap = true,
						},
					},
					gainsArea,
				},
				if #standings > 0
					then UI.DisclosureGroup "Standings" {
						Visible = function(use: Facet.Use): boolean
							return not support(use)
						end,
						label = result.standingsLabel or "Contributions",
						expanded = details,
						content = function()
							return UI.Table "Participants" (records)
						end,
					}
					else nil,
				if result.explanation
					then UI.DisclosureGroup "Explanation" {
						Visible = function(use: Facet.Use): boolean
							return not support(use)
						end,
						label = "What changed?",
						expanded = explanation,
						content = function()
							return UI.Text { text = result.explanation or "", wrap = true }
						end,
					}
					else nil,
			}
		end,
	}
	return root
end

return Outcome
]]></string>
