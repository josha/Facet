	TextTransparency: (TextBox | TextButton | TextLabel) -> Compose.ReadOnlyValue<number>,
	TextTruncate: (TextBox | TextButton | TextLabel) -> Compose.ReadOnlyValue<Enum.TextTruncate>,
	TextWrapped: (TextBox | TextButton | TextLabel) -> Compose.ReadOnlyValue<boolean>,
	TextXAlignment: (TextBox | TextButton | TextLabel) -> Compose.ReadOnlyValue<Enum.TextXAlignment>,
	TextYAlignment: (TextBox | TextButton | TextLabel) -> Compose.ReadOnlyValue<Enum.TextYAlignment>,
	TopbarInset: (GuiService) -> Compose.ReadOnlyValue<Rect>,
	TouchEnabled: (UserInputService) -> Compose.ReadOnlyValue<boolean>,
	ViewportDisplaySize: (GuiService) -> Compose.ReadOnlyValue<Enum.DisplaySize>,
	ViewportSize: (Camera) -> Compose.ReadOnlyValue<Vector2>,
	Visible: (GuiObject) -> Compose.ReadOnlyValue<boolean>,
	ZIndex: (GuiObject) -> Compose.ReadOnlyValue<number>,
}

