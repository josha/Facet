}
export type Facet = {
	VERSION: string,
	COMPOSE_COMMIT: string,
	Compose: ComposeModule,
	Roblox: ComposeRobloxModule,
	design: () -> DesignKit,
	composeDesign: () -> DesignStudioKit,
	tag: <T>(instance: T, tags: { string }) -> T,
	controls: (Runtime, ControlOptions?) -> Controls,
	host: (Runtime) -> Host,
	app: (AppOptions?) -> App,
	themes: ThemeTypes.Themes,
	civilDate: CivilTypes.Module,
	adaptive: adaptive.Adaptive,
	gamepadContention: gamepadContention.GamepadContention,
	pathShapes: typeof(pathShapes),
	richText: typeof(richText),
	format: typeof(format),
	review: typeof(review),
	recipes: { arithmetic: { parse: (unknown) -> number? } },
	inputPriority: { read belowControls: number, read aboveFacet: number },
	bind: (ComposeModule, ComposeRobloxModule) -> Facet,
}

local VERSION = "0.12.0"
local INPUT_PRIORITY = table.freeze({ belowControls = 25, aboveFacet = 12000 })
local COMPOSE_COMMIT = "85f5c180eae1cd29e253707c9c46f9738a9205f4"
local USED = {
	"boundary",
	"cell",
	"cleanup",
	"createContext",
	"createFocusScope",
	"createPool",
	"createSharedResource",
	"currentOwner",
	"focusNeighbor",
	"formula",
	"fragment",
	"isValue",
	"keyed",
	"portal",
	"presence",
	"sharedCell",
	"show",
	"static",
	"switch",
	"watch",
	"withOwner",
	"withRootOwner",
}

local function tag<T>(instance: T, tags: { string }): T
	if typeof(instance) == "Instance" then
		local tagged: Instance = instance
		for _, name in tags do
			tagged:AddTag(name)
		end
	end
	return instance
end

local recipes: { arithmetic: { parse: (unknown) -> number? } } =
	freeze({ arithmetic = freeze({ parse = arithmetic.parse }) })

local function bind(core: ComposeModule, roblox: ComposeRobloxModule): Facet
	local fields = (core :: unknown) :: { [string]: unknown }
	for _, name in USED do
		if type(fields[name]) ~= "function" then
			error(
				`Facet.bind: this Compose has no function '{name}'. Facet {VERSION} supports Compose `
					.. `{string.sub(COMPOSE_COMMIT, 1, 7)} and later commits that keep the functions Facet uses.`,
				2
			)
		end
	end
	if type(roblox) ~= "table" or type(roblox.createRuntime) ~= "function" then
		error("Facet.bind: pass the Compose Roblox module from the same Compose copy as the second argument", 2)
	end
	local themes = bindThemes(core)
	local function controls(runtime: Runtime, options: ControlOptions?): Controls
		return createControls(core, runtime, options)
	end
	local designKit: DesignKit? = nil
	local function design(): DesignKit
		local kit = designKit
		if kit == nil then
			local FacetDesignModule = require("@self/design")
			local made: DesignKit = freeze({
				Design = require("@self/vendor/compose/design"),
				library = FacetDesignModule.library,
				controls = FacetDesignModule.controls,
				seeds = FacetDesignModule.seeds,
				motion = FacetDesignModule.motion,
			})
			designKit = made
			return made
		end
		return kit
	end
	local surface: Facet
	local function composeDesign(): DesignStudioKit
		local DesignEditor = require("@self/vendor/compose/design-editor")
		return DesignEditor.kit("Facet", function(): DesignEditor.Workspace
			local runtime = roblox.createRuntime()
			local Host = surface.host(runtime)
			local theme = themes.neutralPackage()
			local palette = core.cell("Light")
			local textSize = core.cell("Medium")
			local UI = controls(runtime, { theme = theme, environment = { preferredTextSize = textSize } })
			local kit = design()
			local library = kit.library({
				UI = UI,
				motion = kit.motion(UI),
				host = function(className: string, name: string, props: { [unknown]: unknown }): unknown
					return runtime.constructors[className](props, name)
				end,
				provide = function(content: unknown): unknown
					local sheet = themes.createStyleSheet(runtime, theme, { theme = palette })
					local styles: Compose.Child = sheet
					local linkProps: SharedTypes.StyleLinkNativeProps = { StyleSheet = core.static(sheet) }
					local link: Compose.Child = Host.StyleLink(linkProps)
					local design: Compose.Child? = if typeof(content) == "Instance" then content else nil
					local themeProps: SharedTypes.FrameNativeProps = {
						Name = "FacetTheme",
						Size = UDim2.fromScale(1, 1),
						BackgroundTransparency = 1,
						styles,
						link,
						design,
					}
					return Host.Frame(themeProps)
				end,
			})
			return {
				runtime = runtime,
				environment = roblox.designEnvironment(),
				library = library,
				root = "Screen",
				previews = {
					{
						name = "Theme",
						choices = { "Light", "Dark" },
						select = function(choice: string)
							palette:set(choice)
						end,
					},
					{
						name = "Text size",
						choices = { "Medium", "Large", "Larger", "Largest" },
						select = function(choice: string)
							textSize:set(choice)
						end,
					},
				},
				dispose = function()
					runtime:dispose()
				end,
			}
		end)
	end
	surface = freeze({
		VERSION = VERSION,
		COMPOSE_COMMIT = COMPOSE_COMMIT,
		Compose = core,
		Roblox = roblox,
		design = design,
		composeDesign = composeDesign,
		tag = tag,
		controls = controls,
		host = function(runtime: Runtime): Host
			if type(runtime) ~= "table" or type(runtime.constructors) ~= "table" then
				error("Facet.host: pass a Compose runtime", 2)
			end
			return (runtime.constructors :: unknown) :: Host
		end,
		app = function(options: AppOptions?): App
			return createApp(core, roblox, createControls, themes, options)
		end,
		themes = themes,
		civilDate = civilDate,
		adaptive = adaptive,
		gamepadContention = gamepadContention,
		pathShapes = pathShapes,
		richText = richText,
		format = format,
		review = review,
		recipes = recipes,
		inputPriority = INPUT_PRIORITY,
		bind = bind,
	})
	return surface
end

return bind(Compose, Roblox)
