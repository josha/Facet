						<Item class="StringValue" referent="959">
							<Properties>
								<string name="Value"><![CDATA[# Typewriter.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
controls: TypewriterControls? = omitted
direction: ("auto" | "ltr" | "rtl")? = omitted
disclose: boolean? = omitted
lines: number? = omitted
onRevealed: (() -> ())? = omitted
ref: ((TextLabel) -> ())? = omitted
reveal: "auto"? = omitted
rich: boolean? = omitted
role: Input<"secondary" | "content">? = omitted
text: ValueString = required
textAlign: Input<("start" | "center" | "end")>? = omitted
textRole: Input<("caption" | "label" | "body" | "heading" | "title" | "control" | "strong" | "numeral")>? = omitted
textSize: (number | ("caption" | "label" | "body" | "heading" | "title" | "control" | "strong" | "numeral") | ("fit" | { fit: { cap: (number | TextRole)?, floor: (number | TextRole)? } }))? = omitted
tint: Input<Color3>? = omitted
truncate: ("end" | "middle")? = omitted
wrap: ValueBoolean? = omitted
TypewriterControls = { revealed: ReadOnlyValue<boolean>?, finish: (() -> ())?, }]]></string>
