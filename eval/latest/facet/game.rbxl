				<Item class="ModuleScript" referent="RBXBDEFFF30E92C42B197FA494C4ABD0FA6">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Game-owned input actions for racing and quick commands. Escape and gamepad Start stay unbound.
local Players = game:GetService("Players")
local Input = {}
local player = Players.LocalPlayer

local function action(context: InputContext, name: string, keys: { Enum.KeyCode }): InputAction
	local a = Instance.new("InputAction")
	a.Name = name
	a.Type = Enum.InputActionType.Bool
	for _, k in keys do
		local b = Instance.new("InputBinding")
		b.KeyCode = k
		b.Parent = a
	end
	a.Parent = context
	return a
end

function Input.init(kart: any)
	local race = Instance.new("InputContext")
	race.Name = "RaceContext"
	race.Priority = 2000
	Input.race = race
	Input.boost = action(race, "Boost", { Enum.KeyCode.E, Enum.KeyCode.ButtonX })
	Input.drift = action(race, "Drift", { Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonR1 })
	Input.recover = action(race, "Recover", { Enum.KeyCode.R, Enum.KeyCode.ButtonL1 })
	Input.camera = action(race, "Camera", { Enum.KeyCode.C, Enum.KeyCode.DPadDown })
	local commands = Instance.new("InputContext")
	commands.Name = "CommandContext"
	commands.Priority = 1500
	Input.commands = commands
	Input.standings = action(commands, "Standings", { Enum.KeyCode.L, Enum.KeyCode.DPadUp })
	Input.chat = action(commands, "QuickChat", { Enum.KeyCode.Q, Enum.KeyCode.ButtonY })
	race.Enabled = false
	local gui = player:WaitForChild("PlayerGui")
	race.Parent = gui
	commands.Parent = gui
	Input.suspended = function(): boolean return false end
	Input.boost.Pressed:Connect(function() if not Input.suspended() then kart.boost() end end)
	Input.drift.Pressed:Connect(function() if not Input.suspended() then kart.setDrift(true) end end)
	Input.drift.Released:Connect(function() kart.setDrift(false) end)
	Input.recover.Pressed:Connect(function() if not Input.suspended() then kart.recover() end end)
	local Store = require(script.Parent.Store)
	Input.camera.Pressed:Connect(function()
		if Input.suspended() then return end
		Store.camera:set(if Store.camera:peek() == "far" then "near" else "far")
	end)
	local function sync()
		local m = player:GetAttribute("Mode")
		race.Enabled = m == "race" or m == "test"
	end
	player:GetAttributeChangedSignal("Mode"):Connect(sync)
	sync()
end

return Input
]]></ProtectedString>
