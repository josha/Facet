				AutomaticCanvasSize = E.AutomaticSize.X,
				CanvasSize = D2.fromOffset(0, 0),
				CanvasPosition = ctx.types.Vector2.zero,
				ScrollingDirection = E.ScrollingDirection.X,
				ScrollBarThickness = 0,
				ClipsDescendants = true,
				Host.UIListLayout {
					FillDirection = E.FillDirection.Horizontal,
					HorizontalAlignment = E.HorizontalAlignment.Left,
					SortOrder = E.SortOrder.LayoutOrder,
				},
				spec.trailing,
			}
			trailingFrame = trailing
			table.insert(rootChildren, trailing)
		end
		local root = ctx.row(
			rootChildren,
			ctx.props(spec, NAV_KEYS, {
				Name = "NavBar",
				Size = D2.new(1, 0, 0, 0),
				AutomaticSize = E.AutomaticSize.Y,
			})
		)
		if plate then
			root:AddTag(plate)
		end
		root:SetAttribute("FacetNavBar", true)
		local list = root:FindFirstChildWhichIsA("UIListLayout")
		if list then
			runtime.decorate(list, {
				FillDirection = function(use: ComposeTypes.Use)
					return if use(stacked) then E.FillDirection.Vertical else E.FillDirection.Horizontal
				end,
				HorizontalAlignment = E.HorizontalAlignment.Right,
				VerticalAlignment = E.VerticalAlignment.Center,
				Padding = function(use: ComposeTypes.Use)
					return UD.new(0, gap(use))
				end,
			})
		end
		local rows: { GuiObject } = { primaryFrame }
		if trailingFrame then
			table.insert(rows, trailingFrame)
		end
		for _, frame in rows do
			local layout = frame:FindFirstChildWhichIsA("UIListLayout")
			if layout then
				runtime.decorate(layout, {
					VerticalAlignment = E.VerticalAlignment.Center,
					Padding = function(use: ComposeTypes.Use)
						return UD.new(0, gap(use))
					end,
				})
			end
		end
		local primaryFlex = Host.UIFlexItem {
			FlexMode = function(use: ComposeTypes.Use)
				return if use(stacked) then E.UIFlexMode.None else E.UIFlexMode.Fill
			end,
		}
		surfaces.attach(primaryFrame, { primaryFlex })
		runtime.decorate(primaryFrame, {
			Size = function(use: ComposeTypes.Use)
				return if use(stacked) then D2.new(1, 0, 0, 0) else D2.new(0, 0, 0, 0)
			end,
		})
		if spec.padding ~= nil then
			surfaces.attach(root, { ctx.padding(space(spec.padding, "s"), space(spec.padding, "s")) })
		end
		if trailingFrame then
			local available = ctx.layoutSize(root)
			local unit = ctx.layoutUnit(root)
			local trailingLayout = assert(trailingFrame:FindFirstChildWhichIsA("UIListLayout"))
			local content = ctx.observe.AbsoluteContentSize(trailingLayout)
			local thickness = ctx.observeStyled.ScrollBarThickness(trailingFrame)
			local function offered(use: ComposeTypes.Use): number
				local width = use(available).X
				return if width > 0
					then math.max(0, width - (if spec.padding ~= nil then 2 * space(spec.padding, "s", use) else 0))
					else math.huge
			end
			runtime.decorate(trailingFrame, {
				AutomaticSize = E.AutomaticSize.None,
				Size = function(use: ComposeTypes.Use): UDim2
					local size = use(content) / use(unit)
					return D2.fromOffset(size.X, size.Y + (if size.X > offered(use) then use(thickness) else 0))
				end,
			})
			runtime.mount(function()
				return Host.UISizeConstraint "ViewportBounds" {
					MaxSize = function(use: ComposeTypes.Use): Vector2
						return ctx.types.Vector2.new(offered(use), math.huge)
					end,
				}
			end, trailingFrame)
			local box = ctx.observe.AbsoluteSize(root)
			local sides = ctx.observe.AbsoluteSize(trailingFrame)
			local before: { { size: ComposeTypes.ReadOnlyValue<Vector2>, shown: ComposeTypes.ReadOnlyValue<boolean> } } =
				{}
			for _, child in primaryFrame:GetChildren() do
				if child:IsA("GuiObject") and child ~= centerFrame then
					table.insert(before, { size = ctx.observe.AbsoluteSize(child), shown = ctx.observe.Visible(child) })
				end
			end
			local natural = if titleMeasure then ctx.observe.TextBounds(titleMeasure) else nil
			local decided = false
			Compose.watch(function(use: ComposeTypes.Use)
				local scale = use(unit)
				local width = use(box).X / scale
				if width <= 0 or use(sides).X <= 0 then
					return
				end
				local at: Instance? = root
				while decided and at do
					local zoom: unknown = at:GetAttribute("FacetTransitionZoom")
					if type(zoom) == "number" and zoom ~= 1 then
						return
					end
					at = at.Parent
				end
				decided = true
				local fixed = 0
				for _, part in before do
					if use(part.shown) then
						fixed += use(part.size).X / scale + gap(use)
					end
				end
				local room = width - fixed - use(sides).X / scale - gap(use)
				local wanted = if natural then use(natural).X / scale else ctx.metric("controls.popup.panelWidth", use)
				local floor = math.min(wanted, width - fixed)
				local next = room < floor
				if next ~= stacked:peek() then
					stacked:set(next)
				end
			end)
		end
		return root
	end)
end
