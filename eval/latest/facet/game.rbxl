				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Validated player requests. Every handler returns { ok, message, ... } and changes state only on success.
local Players = game:GetService("Players")
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local Profiles = require(script.Parent.Profiles)
local Remotes = game.ReplicatedStorage.Remotes

local Actions = {}
local handlers: { [string]: (Player, any, any) -> any } = {}
Actions.handlers = handlers

local function fail(message: string, extra: any?): any
	local r = extra or {}
	r.ok = false
	r.message = message
	return r
end
local function done(player: Player, message: string, extra: any?): any
	Profiles.changed(player)
	local r = extra or {}
	r.ok = true
	r.message = message
	return r
end
local function canPay(p: any, credits: number, gems: number): boolean
	return p.credits >= credits and p.gems >= gems
end
local function pay(p: any, currency: string, amount: number): boolean
	if p[currency] == nil or p[currency] < amount then return false end
	p[currency] -= amount
	return true
end
local function short(currency: string): string
	return if currency == "gems" then "Gems" else "Credits"
end
local function fmt(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end
Actions.fmt = fmt

local function today(): number
	return math.floor(os.time() / 86400)
end

-- Shop
handlers.buyPart = function(player, p, id)
	local part = GameData.find(GameData.Parts, id)
	if not part then return fail("Unknown part") end
	if p.ownedParts[part.id] then return fail("You already own " .. part.name) end
	if not pay(p, part.currency, part.price) then
		return fail(string.format("Not enough %s: %s needed, you have %s", short(part.currency), fmt(part.price), fmt(p[part.currency])))
	end
	p.ownedParts[part.id] = true
	p.parts += 1
	return done(player, "Bought " .. part.name)
end

handlers.equip = function(player, p, args)
	local slot, id = args.slot, args.id
	if not GameData.SlotLabel[slot] then return fail("Unknown slot") end
	if id == nil then
		p.equipped[slot] = nil
		return done(player, GameData.SlotLabel[slot] .. " slot emptied")
	end
	local part = GameData.find(GameData.Parts, id)
	if not part or part.slot ~= slot then return fail("That part does not fit this slot") end
	if not p.ownedParts[id] then return fail("You do not own " .. part.name) end
	p.equipped[slot] = id
	return done(player, "Equipped " .. part.name)
end

-- Garage
handlers.buyKart = function(player, p, id)
	local kart = GameData.find(GameData.Karts, id)
	if not kart then return fail("Unknown kart") end
	if p.karts[id] then return fail("Already owned") end
	if kart.price <= 0 then return fail(kart.name .. " is a streak reward and cannot be bought") end
	if not pay(p, "credits", kart.price) then return fail("Not enough Credits: " .. fmt(kart.price) .. " needed") end
	p.karts[id] = true
	return done(player, "Bought " .. kart.name)
end
handlers.selectKart = function(player, p, id)
	if not p.karts[id] then return fail("You do not own that kart") end
	p.selectedKart = id
	return done(player, "Next race kart: " .. (GameData.find(GameData.Karts, id) :: any).name)
end
handlers.favorite = function(player, p, id)
	if not GameData.find(GameData.Karts, id) then return fail("Unknown kart") end
	p.favorites[id] = if p.favorites[id] then nil else true
	return done(player, if p.favorites[id] then "Added to favorites" else "Removed from favorites")
end

-- Upgrades: each level costs Credits and Gems.
handlers.upgrade = function(player, p, args)
	local kartId, stat = args.kart, args.stat
	if not p.karts[kartId] then return fail("You do not own that kart") end
	if not table.find(GameData.UpgradeStats, stat) then return fail("Unknown upgrade") end
	p.upgrades[kartId] = p.upgrades[kartId] or { speed = 0, handling = 0, boost = 0 }
	local level = p.upgrades[kartId][stat]
	if level >= GameData.MaxUpgrade then return fail("Already at maximum level") end
	local credits, gems = GameData.upgradeCost(level)
	if not canPay(p, credits, gems) then
		return fail(string.format("Needs %s Credits and %d Gems", fmt(credits), gems))
	end
	p.credits -= credits
	p.gems -= gems
	p.upgrades[kartId][stat] = level + 1
	return done(player, string.format("%s upgraded to level %d", stat:sub(1, 1):upper() .. stat:sub(2), level + 1))
end

-- Drivers
handlers.buyDriver = function(player, p, id)
	local d = GameData.find(GameData.Drivers, id)
	if not d then return fail("Unknown driver") end
	if p.drivers[id] then return fail("Already owned") end
	local currency = GameData.driverCurrency(d)
	if not pay(p, currency, d.price) then return fail(string.format("Not enough %s: %s needed", short(currency), fmt(d.price))) end
	p.drivers[id] = true
	p.rentals[id] = nil
	return done(player, "Hired " .. d.name .. " permanently")
end
handlers.rentDriver = function(player, p, id)
	local d = GameData.find(GameData.Drivers, id)
	if not d then return fail("Unknown driver") end
	if p.drivers[id] then return fail("You already own " .. d.name) end
	if p.rentals[id] and p.rentals[id] > os.time() then return fail("Rental still active") end
	local currency = GameData.driverCurrency(d)
	if not pay(p, currency, d.rent) then return fail(string.format("Not enough %s: %s needed", short(currency), fmt(d.rent))) end
	p.rentals[id] = os.time() + GameData.RentalSeconds
	return done(player, "Rented " .. d.name .. " for 10 minutes")
end
handlers.selectDriver = function(player, p, id)
	if not Profiles.driverUsable(p, id) then return fail("Buy or rent this driver first") end
	p.selectedDriver = id
	return done(player, "Driver: " .. (GameData.find(GameData.Drivers, id) :: any).name)
end

-- Livery
handlers.saveLivery = function(player, p, l)
	if type(l) ~= "table" then return fail("Invalid design") end
	local function swatch(id: any): boolean return GameData.find(GameData.Swatches, id) ~= nil end
	if not swatch(l.body) or not swatch(l.accent) then return fail("Unknown color") end
	if not table.find(GameData.Shades, l.bodyShade) or not table.find(GameData.Shades, l.accentShade) then return fail("Unknown shade") end
	if not table.find(GameData.Decals, l.decal) then return fail("Unknown decal") end
	p.livery = { body = l.body, bodyShade = l.bodyShade, accent = l.accent, accentShade = l.accentShade, decal = l.decal }
	return done(player, "Livery saved")
end

-- Crates: free crate first, then currency.
local rng = Random.new()
handlers.openCrate = function(player, p, id)
	local crate = GameData.find(GameData.Crates, id) :: any
	if not crate then return fail("Unknown crate") end
	local usedFree = false
	if crate.id == "spark" and p.freeCrates > 0 then
		p.freeCrates -= 1
		usedFree = true
	elseif not pay(p, crate.currency, crate.price) then
		return fail(string.format("Not enough %s: %s needed", short(crate.currency), fmt(crate.price)))
	end
	local cards = {}
	for _ = 1, crate.cards do
		local roll = rng:NextNumber(0, 100)
		local acc, rarity = 0, "Common"
		for _, r in GameData.Rarities do
			acc += crate.odds[r]
			if roll <= acc then rarity = r break end
		end
		local pool = {}
		for _, c in GameData.Cards do if c.rarity == rarity then table.insert(pool, c) end end
		local card = pool[rng:NextInteger(1, #pool)]
		local isNew = (p.cards[card.id] or 0) == 0
		p.cards[card.id] = (p.cards[card.id] or 0) + 1
		table.insert(cards, { id = card.id, name = card.name, rarity = card.rarity, new = isNew })
	end
	p.crates += 1
	return done(player, if usedFree then "Opened a free " .. crate.name else "Opened " .. crate.name, { cards = cards, free = usedFree })
end

-- Daily track
function Actions.dailyState(p: any): any
	local t = today()
	local d = p.daily
	local streak, missed = d.streak, false
	if d.lastDay >= 0 and t > d.lastDay + 1 then
		streak, missed = 0, true
	elseif d.streak >= 7 and t > d.lastDay then
		streak = 0
	end
	local ready = d.lastDay ~= t
	return { streak = streak, ready = ready, missed = missed, nextAt = (t + 1) * 86400 }
end
handlers.claimDaily = function(player, p)
	local st = Actions.dailyState(p)
	if not st.ready then return fail("Already claimed today. Come back tomorrow.") end
	local day = st.streak + 1
	local reward = GameData.Daily[day] :: any
	p.credits += reward.credits or 0
	p.gems += reward.gems or 0
	p.freeCrates += reward.crate or 0
	if reward.kart then p.karts[reward.kart] = true end
	p.daily = { streak = day, lastDay = today() }
	return done(player, "Day " .. day .. " claimed: " .. reward.label, { day = day })
end

-- Codes
local codeBusy: { [Player]: boolean } = {}
handlers.redeem = function(player, p, raw)
	if type(raw) ~= "string" then return fail("Enter a code", { state = "empty" }) end
	local code = raw:gsub("^%s+", ""):gsub("%s+$", ""):upper()
	if code == "" then return fail("Enter a code", { state = "empty" }) end
	if codeBusy[player] then return fail("Still checking your last code", { state = "busy" }) end
	local now = os.clock()
	local recent = {}
	for _, t in p.codeAttempts do if now - t < 30 then table.insert(recent, t) end end
	p.codeAttempts = recent
	if #recent >= 4 then
		local retry = math.ceil(30 - (now - recent[1]))
		return fail("Too many attempts. Try again in " .. retry .. "s", { state = "limited", retry = retry })
	end
	table.insert(p.codeAttempts, now)
	codeBusy[player] = true
	task.wait(0.8)
	codeBusy[player] = nil
	local entry = GameData.Codes[code]
	if not entry then return fail("“" .. code .. "” is not a valid code", { state = "invalid" }) end
	if entry.expired then return fail("“" .. code .. "” has expired", { state = "expired" }) end
	if p.codesUsed[code] then return fail("You already used “" .. code .. "”", { state = "used" }) end
	p.codesUsed[code] = true
	p.credits += entry.credits or 0
	p.gems += entry.gems or 0
	return done(player, "Redeemed: " .. entry.label, { state = "success" })
end

-- Boosts, offer, quests
handlers.buyBoost = function(player, p, id)
	local b = GameData.find(GameData.Boosts, id) :: any
	if not b then return fail("Unknown boost") end
	if not pay(p, "gems", b.gems) then return fail("Not enough Gems: " .. b.gems .. " needed") end
	p.boosts[id] = math.max(p.boosts[id] or 0, os.time()) + b.minutes * 60
	return done(player, b.name .. " active")
end
function Actions.offerEligible(p: any): (boolean, string)
	local o = GameData.Offer
	if p.offer.bought then return false, "Already purchased" end
	if os.time() >= p.offer.expires then return false, "Offer expired" end
	if p.level >= o.maxLevel then return false, "Only for racers below level " .. o.maxLevel end
	return true, "Eligible"
end
handlers.buyOffer = function(player, p)
	local ok, why = Actions.offerEligible(p)
	if not ok then return fail(why) end
	if not pay(p, "gems", GameData.Offer.gems) then return fail("Not enough Gems: " .. GameData.Offer.gems .. " needed") end
	p.offer.bought = true
	p.credits += GameData.Offer.credits
	p.ownedParts[GameData.Offer.part] = true
	return done(player, "Starter Pack claimed")
end
handlers.claimQuest = function(player, p, id)
	local q = GameData.find(GameData.Quests, id) :: any
	if not q then return fail("Unknown quest") end
	if p.questsClaimed[id] then return fail("Already claimed") end
	if (p[q.stat] or 0) < q.goal then return fail("Quest not complete yet") end
	p.questsClaimed[id] = true
	p.credits += q.credits
	p.gems += q.gems
	return done(player, "Quest reward claimed")
end

-- Mechanic job
local function nearMechanic(player: Player): boolean
	local char = player.Character
	local npc = workspace.World.Hub:FindFirstChild("Mechanic") :: Model?
	if not char or not npc or not char.PrimaryPart then return false end
	return (char.PrimaryPart.Position - npc:GetPivot().Position).Magnitude < 20
end
handlers.mechanic = function(player, p, step)
	local m = p.mechanic
	if not nearMechanic(player) then return fail("Walk up to Sprocket first") end
	if step == "accept" then
		if m.state ~= "none" then return fail("Job already taken") end
		m.state = "active"
		m.cells = {}
		return done(player, "Job accepted: collect 3 power cells")
	elseif step == "claim" then
		if m.state ~= "ready" then return fail(if m.state == "done" then "Reward already paid" else "Bring all 3 power cells first") end
		m.state = "done"
		p.credits += GameData.Mechanic.credits
		p.gems += GameData.Mechanic.gems
		return done(player, "Sprocket paid 500 Credits and 5 Gems")
	end
	return fail("Unknown step")
end
function Actions.collectCell(player: Player, index: number)
	local p = Profiles.get(player)
	if not p or p.mechanic.state ~= "active" then return end
	if table.find(p.mechanic.cells, index) then return end
	table.insert(p.mechanic.cells, index)
	if #p.mechanic.cells >= GameData.Mechanic.goal then
		p.mechanic.state = "ready"
		Remotes.Notify:FireClient(player, { kind = "success", text = "All power cells found. Return to Sprocket." })
	else
		Remotes.Notify:FireClient(player, { kind = "info", text = string.format("Power cell %d/%d", #p.mechanic.cells, GameData.Mechanic.goal) })
	end
	Profiles.changed(player)
end

-- Settings
handlers.saveSettings = function(player, p, s)
	if type(s) ~= "table" then return fail("Invalid settings") end
	local function vol(v: any): boolean return type(v) == "number" and v >= 0 and v <= 1 end
	if not vol(s.music) or not vol(s.sfx) then return fail("Volume out of range") end
	if not table.find({ "Low", "Medium", "High" }, s.graphics) then return fail("Unknown graphics level") end
	for _, k in { "damageNumbers", "cameraShake", "reducedMotion" } do
		if type(s[k]) ~= "boolean" then return fail("Invalid value for " .. k) end
	end
	p.settings = { music = math.round(s.music * 100) / 100, sfx = math.round(s.sfx * 100) / 100, damageNumbers = s.damageNumbers, cameraShake = s.cameraShake, graphics = s.graphics, reducedMotion = s.reducedMotion }
	return done(player, "Settings saved")
end
handlers.resetSettings = function(player, p)
	p.settings = table.clone(Profiles.DefaultSettings)
	return done(player, "Settings reset to defaults")
end
handlers.tutorial = function(player, p, state)
	p.tutorial = { done = true, skipped = state == "skip" }
	return done(player, if state == "skip" then "Tutorial skipped" else "Tutorial complete")
end

-- Party with demo participants
local DEMO = {
	{ id = "demo_nova", name = "Nova (demo)", status = "online", reply = "accept", delay = 2 },
	{ id = "demo_rook", name = "Rook (demo)", status = "online", reply = "decline", delay = 3 },
	{ id = "demo_echo", name = "Echo (demo)", status = "online", reply = "accept", delay = 4 },
	{ id = "demo_pixel", name = "Pixel (demo)", status = "racing" },
	{ id = "demo_vex", name = "Vex (demo)", status = "offline" },
}
local friendCache: { [Player]: { any } } = {}
function Actions.friends(player: Player): { any }
	if friendCache[player] then return friendCache[player] end
	local list = {}
	for _, d in DEMO do table.insert(list, { id = d.id, name = d.name, status = d.status, userId = 0, demo = true }) end
	if player.UserId > 0 then
		pcall(function()
			local pages = Players:GetFriendsAsync(player.UserId)
			local count = 0
			while count < 12 do
				for _, f in pages:GetCurrentPage() do
					count += 1
					local inServer = Players:GetPlayerByUserId(f.Id) ~= nil
					table.insert(list, { id = "u" .. f.Id, name = f.DisplayName or f.Username, status = if inServer then "online" else "offline", userId = f.Id, demo = false })
					if count >= 12 then break end
				end
				if pages.IsFinished or count >= 12 then break end
				pages:AdvanceToNextPageAsync()
			end
		end)
	end
	friendCache[player] = list
	return list
end
handlers.friends = function(player, p)
	return { ok = true, message = "", friends = Actions.friends(player) }
end
handlers.invite = function(player, p, id)
	local friend
	for _, f in Actions.friends(player) do if f.id == id then friend = f end end
	if not friend then return fail("Unknown friend") end
	local party = p.party
	if party.members[id] then return fail(friend.name .. " is already in your party") end
	if party.pending[id] then return fail("Invite to " .. friend.name .. " is still pending") end
	if friend.status == "offline" then return fail(friend.name .. " is offline") end
	if friend.status == "racing" then return fail(friend.name .. " is in a race right now") end
	party.pending[id] = true
	party.results[id] = nil
	local demo
	for _, d in DEMO do if d.id == id then demo = d end end
	if demo then
		task.delay(demo.delay, function()
			local cur = Profiles.get(player)
			if not cur or not cur.party.pending[id] then return end
			cur.party.pending[id] = nil
			if demo.reply == "accept" then
				cur.party.members[id] = true
				cur.party.results[id] = "accepted"
			else
				cur.party.results[id] = "declined"
			end
			Remotes.Notify:FireClient(player, { kind = if demo.reply == "accept" then "success" else "warning", text = friend.name .. (if demo.reply == "accept" then " joined your party" else " declined your invite") })
			Profiles.push(player)
		end)
	end
	Profiles.push(player)
	return { ok = true, message = "Invite sent to " .. friend.name }
end
handlers.leaveParty = function(player, p, id)
	p.party.members[id] = nil
	p.party.results[id] = nil
	Profiles.push(player)
	return { ok = true, message = "Removed from party" }
end

-- Dispatcher
local inFlight: { [Player]: { [string]: boolean } } = {}
function Actions.dispatch(player: Player, action: string, args: any): any
	local handler = handlers[action]
	local p = Profiles.get(player)
	if not handler or not p then return fail("Unavailable") end
	inFlight[player] = inFlight[player] or {}
	if action ~= "redeem" and inFlight[player][action] then return fail("Request already in progress") end
	inFlight[player][action] = true
	local ok, result = pcall(handler, player, p, args)
	if inFlight[player] then inFlight[player][action] = nil end
	if not ok then
		warn("Action failed", action, result)
		return fail("Server error. Try again.")
	end
	return result
end
Players.PlayerRemoving:Connect(function(player)
	inFlight[player] = nil
	friendCache[player] = nil
	codeBusy[player] = nil
end)

return Actions
]]></ProtectedString>
					<string name="ScriptGuid">{BB0C2E46-491F-44FF-86CD-9E15EC34C7BD}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Actions</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">73c8afe78d24b4d30afced11000018d4</UniqueId>
