					<Item class="ModuleScript" referent="120">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Types = require("./types")
local arbitration = require("./gesture_arbitration")
local services: { [UserInputService]: arbitration.Arbiter } = setmetatable({}, { __mode = "k" })
local fallbacks: { [Types.Context]: arbitration.Arbiter } = setmetatable({}, { __mode = "k" })

return function(ctx: Types.Context): arbitration.Arbiter
	local input = ctx.config.userInputService
	if input then
		if not services[input] then
			services[input] = arbitration.new()
		end
		return services[input]
	end
	if not fallbacks[ctx] then
		fallbacks[ctx] = arbitration.new()
	end
	return fallbacks[ctx]
end
]]></ProtectedString>
							<string name="ScriptGuid">{5537D843-FE37-44AC-831D-D04F72D18482}</string>
