						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Types = require("./types")
local Env = require("./environment_types")

export type Placement = Env.DropPlacement
export type Options<V, K> = {
	from: Types.Input<{ V }>,
	key: (V) -> K,
	placement: (V) -> Placement,
	columns: number,
	rows: number,
	cellSize: Types.ValueNumber?,
	gap: Types.ValueNumber?,
	render: (Types.ReadOnlyValue<V>, K) -> GuiObject,
	drag: ((Types.ReadOnlyValue<V>, K) -> Env.DraggableSpec)?,
	drop: Env.DropTargetSpec?,
	footprint: ((unknown) -> Vector2?)?,
}
return {}
]]></ProtectedString>
							<string name="ScriptGuid">{2B6312FA-7172-46FB-B7F7-39A84D1342F8}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">spatial_grid_types</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">73c8afe78d24b4d30afced11000004da</UniqueId>
