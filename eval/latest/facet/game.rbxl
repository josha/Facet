					</Item>
					<Item class="ModuleScript" referent="RBXE1E19883DC4247CEB616C18F30BEBDC5">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- World hooks: hub prompts open their tasks, power cells, audio, graphics and feedback numbers.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")
local Facet = require(game.ReplicatedStorage.Packages.Facet)

return function(ctx: any): any
	local Store, kart = ctx.Store, ctx.kart
	local player = Players.LocalPlayer
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
		if Store.mode:peek() ~= "hub" then return end
		local station = prompt.Parent and prompt.Parent.Parent
		local name = station and station.Name
		if name == "RaceGate" then ctx.openOnly("race")
		elseif name == "Garage" then ctx.openOnly("garage")
		elseif name == "Shop" then ctx.openOnly("shop")
		elseif name == "CodeBoard" then if ctx.openCodes then ctx.openCodes() end
		elseif name == "TestTrack" then ctx.openOnly("garage")
		elseif name == "Mechanic" then if ctx.talkToMechanic then ctx.talkToMechanic() end end
	end)

	local function group(name: string): SoundGroup
		local g = SoundService:FindFirstChild(name) :: SoundGroup?
		if not g then
			local n = Instance.new("SoundGroup")
			n.Name = name
			n.Parent = SoundService
			g = n
		end
		return g :: SoundGroup
	end
	local musicGroup, sfxGroup = group("Music"), group("Effects")
	local music = Instance.new("Sound")
	music.Name = "HubMusic"
	music.SoundId = "rbxassetid://1837849285"
	music.Looped = true
	music.Volume = 0.5
	music.SoundGroup = musicGroup
	music.Parent = SoundService
	pcall(function() music:Play() end)
	local boostSound = Instance.new("Sound")
	boostSound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
	boostSound.SoundGroup = sfxGroup
	boostSound.Parent = SoundService

	local function settings(): any
		local p = Store.profile:peek()
		return (p and p.settings) or {}
	end
	local lastApplied = ""
	task.spawn(function()
		while true do
			task.wait(0.3)
			local s = settings()
			local key = string.format("%s|%s|%s", tostring(s.music), tostring(s.sfx), tostring(s.graphics))
			if key ~= lastApplied then
				lastApplied = key
				musicGroup.Volume = s.music or 0.6
				sfxGroup.Volume = s.sfx or 0.8
				local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
				local atm = Lighting:FindFirstChildOfClass("Atmosphere")
				local g = s.graphics or "High"
				if bloom then bloom.Enabled = g ~= "Low" end
				if atm then atm.Density = if g == "High" then 0.32 elseif g == "Medium" then 0.22 else 0.1 end
				Lighting.GlobalShadows = g == "High"
			end
			-- Collected power cells disappear for this player.
			local p = Store.profile:peek()
			local cells = workspace:FindFirstChild("World") and workspace.World.Hub:FindFirstChild("PowerCells")
			if p and cells then
				for _, c in cells:GetChildren() do
					if c:IsA("BasePart") then
						local idx = c:GetAttribute("CellIndex")
						local show = p.mechanic.state == "active" and not table.find(p.mechanic.cells, idx)
						c.Transparency = if show then 0 else 1
						local light = c:FindFirstChildOfClass("PointLight")
						if light then light.Enabled = show end
					end
				end
			end
		end
	end)

	local function floating(text: string, color: Color3)
		local name = player:GetAttribute("Kart")
		local model = name and workspace:FindFirstChild("Karts") and workspace.Karts:FindFirstChild(name :: string) :: Model?
		if not model or not model.PrimaryPart then return end
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(220, 50)
		bb.StudsOffset = Vector3.new(0, 7, 0)
		bb.AlwaysOnTop = true
		bb.Adornee = model.PrimaryPart
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Text = text
		t.TextColor3 = color
		t.TextStrokeTransparency = 0.3
		t.TextScaled = true
		t.FontFace = Font.new("rbxasset://fonts/families/Michroma.json", Enum.FontWeight.Bold)
		t.Parent = bb
		bb.Parent = player:WaitForChild("PlayerGui")
		task.delay(0.9, function() bb:Destroy() end)
	end
	kart.onImpact = function(lost: number)
		if settings().damageNumbers ~= false then floating("-" .. lost, Color3.fromRGB(255, 70, 100)) end
	end
	kart.onBoost = function(label: string)
		pcall(function() boostSound:Play() end)
		if settings().damageNumbers ~= false then floating(label, Color3.fromRGB(0, 229, 255)) end
	end
	return nil
end
]]></ProtectedString>
							<string name="ScriptGuid">{8D33E59F-B5F1-412A-8790-956C2B294472}</string>
