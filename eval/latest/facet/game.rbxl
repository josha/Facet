							<Item class="ModuleScript" referent="394">
								<Properties>
									<Content name="LinkedSource"><null></null></Content>
									<ProtectedString name="Source"><![CDATA[--!strict

local UI = require "./ui"
local Math = require "./math"

local Compose = require "../core"
local Design = require "../design"

export type Stage = {
	surface: Compose.Node,
	overlay: Compose.Node,
	nodes: { [string]: Compose.Node },
	zoom: Compose.Value<number>,
	fit: () -> (),
	zoomTo: (scale: number, around: UI.Point?) -> (),
	play: (sequence: string) -> (),
	dispose: () -> (),
}

export type Options = {
	size: UI.Point,
	library: Design.Library?,
	compact: boolean?,
	readOnly: boolean?,
	accent: unknown?,
	token: ((name: string) -> Design.Literal)?,
	resolveToken: ((name: string) -> Design.Resolved)?,
	inputs: { [string]: Design.Literal }?,
	bindings: { [string]: Design.Resolved }?,
	slots: { [string]: () -> unknown }?,
}

return function(ui: UI.UI)
	local Theme = require "./theme"(ui)
	local ATTRIBUTE = "ComposeDesignNode"

	local function frame(name: string): Compose.Node
		local created = ui.new "Frame"
		ui.set(created, "Name", name)
		ui.set(created, "BackgroundTransparency", 1)
		ui.set(created, "BorderSizePixel", 0)
		return created
	end

	local function contains(instance: Compose.Node, point: UI.Point, root: Compose.Node): boolean
		local current: Compose.Node? = instance
		while current and ui.isA(current, "GuiObject") do
			if not ui.get(current, "Visible") then
				return false
			end
			if current == instance or ui.get(current, "ClipsDescendants") then
				local at, size = ui.xy(current, "AbsolutePosition"), ui.xy(current, "AbsoluteSize")
				if point.X < at.X or point.Y < at.Y or point.X > at.X + size.X or point.Y > at.Y + size.Y then
					return false
				end
			end
			if current == root then
				break
			end
			current = ui.optionalNode(ui.get(current, "Parent"))
		end
		return true
	end

	local function depthOf(instance: Compose.Node, root: Compose.Node): number
		local depth, ancestor = 0, ui.get(instance, "Parent")
		while ancestor and ancestor ~= root do
			depth += 1
			ancestor = ui.get(ancestor, "Parent")
		end
		return depth
	end

	local function scaleOf(instance: Compose.Node): number
		local factor, current: Compose.Node? = 1, instance
		while current do
			local uiScale = ui.call(current, "FindFirstChildWhichIsA", "UIScale")
			if uiScale then
				factor *= ui.number(uiScale, "Scale")
			end
			current = ui.optionalNode(ui.get(current, "Parent"))
		end
		return factor
	end

	return function(session: Design.Session, parent: Compose.Node, options: Options): Stage
		local library = options.library or session.library
		local accent = options.accent or Theme.color.accent
		local width, height = options.size.X, options.size.Y
		local holder = frame "DesignStage"
		ui.set(holder, "Size", ui.values.udim2(1, 0, 1, 0))
		ui.set(holder, "AnchorPoint", ui.values.vector2(0.5, 0.5))
		ui.set(holder, "Position", ui.values.udim2(0.5, 0, 0.5, 0))
		local camera = ui.new "UIScale"
		ui.set(camera, "Parent", holder)
		local zoom = Compose.cell(1)
		local pan: UI.Point = { X = 0, Y = 0 }
		local function centered(name: string, grow: number): Compose.Node
			local created = frame(name)
			ui.set(created, "AnchorPoint", ui.values.vector2(0.5, 0.5))
			ui.set(created, "Position", ui.values.udim2(0.5, 0, 0.5, 0))
			ui.set(created, "Size", ui.values.udim2(0, width + grow, 0, height + grow))
			return created
		end
		for depth, spread in { 24, 12, 4 } do
			local shadow = centered("Shadow", spread)
			ui.set(shadow, "Position", ui.values.udim2(0.5, 0, 0.5, spread / 3))
			ui.set(shadow, "BackgroundColor3", Theme.color.shadow)
			ui.set(shadow, "BackgroundTransparency", 0.94 - depth * 0.06)
			ui.set(shadow, "ZIndex", 0)
			Theme.corner(shadow, 4 + spread / 2)
			ui.set(shadow, "Parent", holder)
		end
		local surface = centered("DesignSurface", 0)
		ui.set(surface, "ClipsDescendants", true)
		ui.set(surface, "BackgroundTransparency", 0)
		ui.set(surface, "BackgroundColor3", ui.rgb(18, 20, 26))
		ui.set(surface, "ZIndex", 1)
		local title = Theme.label("", Theme.color.secondary, Theme.size.small, Theme.font.bold)
		ui.set(title, "Name", "ArtboardTitle")
		ui.set(title, "AnchorPoint", ui.values.vector2(0.5, 1))
		ui.set(title, "Position", ui.values.udim2(0.5, 0, 0.5, -height / 2 - 6))
		ui.set(title, "Size", ui.values.udim2(0, width, 0, 24))
		local titleScale = ui.new "UIScale"
		ui.set(titleScale, "Parent", title)
		ui.set(title, "Parent", holder)
		local dimensions = Theme.label(`{width} × {height}`, Theme.color.tertiary, Theme.size.small)
		ui.set(dimensions, "Name", "ArtboardSize")
		ui.set(dimensions, "TextXAlignment", ui.values.enum("TextXAlignment", "Right"))
		Theme.place(dimensions, title, ui.values.udim2(1, 0, 1, 0))
		local overlay = centered("DesignOverlay", 0)
		ui.set(overlay, "ZIndex", 2)
		ui.set(overlay, "Active", true)
		ui.set(surface, "Parent", holder)
		ui.set(overlay, "Parent", holder)
		ui.set(holder, "Parent", parent)
		local nodes: { [string]: Compose.Node } = {}
		local UserInputService = ui.service "UserInputService"
		local function blocked(id: string): boolean
			local node, parentNode = Design.document.find(session.document:peek().root, id)
			while node do
				if node.locked or node.hidden then
					return true
				end
				node = parentNode
				if node then
					local _, ancestor = Design.document.find(session.document:peek().root, node.id)
					parentNode = ancestor
				end
			end
			return false
		end
		type Resize = {
			corner: UI.Point,
			from: UI.Point,
			size: UI.Point,
			instance: Compose.Node,
			result: UI.Point?,
		}
		local resizing: Resize? = nil
		local function toGui(input: Compose.Node): UI.Point
			return Theme.point(input)
		end
		type Grip = { frame: Compose.Node, corner: UI.Point }
		local selectionGrips: { Grip } = {}
		local function gripAt(point: UI.Point): Grip?
			for _, grip in selectionGrips do
				local frame = grip.frame
				if
					ui.get(frame, "Visible")
					and ui.get(frame, "Parent")
					and ui.isA(ui.get(frame, "Parent"), "GuiObject")
					and ui.get(ui.get(frame, "Parent"), "Visible")
				then
					local center =
						Math.add(ui.xy(frame, "AbsolutePosition"), Math.scale(ui.xy(frame, "AbsoluteSize"), 0.5))
					if Math.length(Math.sub(point, center)) <= 8 then
						return grip
					end
				end
			end
			return nil
		end
		local function resizable(id: string?): ("fields" | "size")?
			local node = if id then Design.document.find(session.document:peek().root, id) else nil
			local kind = if node then session.library.kinds[node.kind] else nil
			if kind == nil then
				return nil
			end
			local fields = kind.fields
			if fields.width ~= nil and fields.height ~= nil then
				return "fields"
			end
			local native = fields.Size
			if native ~= nil and native.type == "datatype" and native.datatype == "UDim2" then
				return "size"
			end
			return nil
		end
		type Drop = { destination: string, before: number, edge: UI.Point, along: UI.Point }
		type Carry = { id: string, start: UI.Point, active: boolean, drop: Drop? }
		local carrying: Carry? = nil
		type Marquee = { from: UI.Point, to: UI.Point, base: { string } }
		local marquee: Marquee? = nil
		local marqueeBox = frame "DesignMarquee"
		ui.set(marqueeBox, "BackgroundColor3", accent)
		ui.set(marqueeBox, "BackgroundTransparency", 0.85)
		ui.set(marqueeBox, "Visible", false)
		ui.set(marqueeBox, "ZIndex", 2005)
		Theme.stroke(marqueeBox, accent, 1)
		ui.set(marqueeBox, "Parent", overlay)
		local function updateMarquee(point: UI.Point)
			local active = marquee
			if active == nil then
				return
			end
			active.to = point
			local left, top = math.min(active.from.X, point.X), math.min(active.from.Y, point.Y)
			local right, bottom = math.max(active.from.X, point.X), math.max(active.from.Y, point.Y)
			local origin, factor = ui.xy(overlay, "AbsolutePosition"), scaleOf(overlay)
			ui.set(marqueeBox, "Position", ui.values.udim2(0, (left - origin.X) / factor, 0, (top - origin.Y) / factor))
			ui.set(marqueeBox, "Size", ui.values.udim2(0, (right - left) / factor, 0, (bottom - top) / factor))
			ui.set(marqueeBox, "Visible", true)
		end
		local function finishMarquee()
			local active = marquee
			marquee = nil
			ui.set(marqueeBox, "Visible", false)
			if active == nil then
				return
			end
			local ids = table.clone(active.base)
			if Math.length(Math.sub(active.to, active.from)) >= 4 then
				local left, top = math.min(active.from.X, active.to.X), math.min(active.from.Y, active.to.Y)
				local right, bottom = math.max(active.from.X, active.to.X), math.max(active.from.Y, active.to.Y)
				for id, instance in nodes do
					if id ~= session.document:peek().root.id and not blocked(id) and ui.get(instance, "Parent") then
						local at, extent = ui.xy(instance, "AbsolutePosition"), ui.xy(instance, "AbsoluteSize")
						local x1 = math.max(at.X, left)
						local y1 = math.max(at.Y, top)
						local x2 = math.min(at.X + extent.X, right)
						local y2 = math.min(at.Y + extent.Y, bottom)
						local current: Compose.Node? = instance
						local visible = true
						while current and ui.isA(current, "GuiObject") do
							visible = visible and ui.get(current, "Visible") ~= false
							if ui.get(current, "ClipsDescendants") then
								local origin, size = ui.xy(current, "AbsolutePosition"), ui.xy(current, "AbsoluteSize")
								x1 = math.max(x1, origin.X)
								y1 = math.max(y1, origin.Y)
								x2 = math.min(x2, origin.X + size.X)
								y2 = math.min(y2, origin.Y + size.Y)
							end
							if current == surface then
								break
							end
							current = ui.optionalNode(ui.get(current, "Parent"))
						end
						if visible and x1 <= x2 and y1 <= y2 then
							table.insert(ids, id)
						end
					end
				end
			end
			session.selectMany(ids)
		end
		local marker = frame "DesignDropMarker"
		ui.set(marker, "BackgroundTransparency", 0)
		ui.set(marker, "BackgroundColor3", accent)
		ui.set(marker, "ZIndex", 2004)
		ui.set(marker, "Visible", false)
		ui.set(marker, "Parent", overlay)
		local function horizontal(instance: Compose.Node): boolean
			local layout = ui.call(instance, "FindFirstChildWhichIsA", "UIListLayout")
			return layout ~= nil and ui.get(layout, "FillDirection") == ui.values.enum("FillDirection", "Horizontal")
		end
		local function dropAt(point: UI.Point, moving: string): Drop?
			local value = session.document:peek()
			local movingNode = Design.document.find(value.root, moving)
			if movingNode == nil then
				return nil
			end
			local host: Design.Node? = nil
			local deepest = -1
			for id, instance in nodes do
				local node = Design.document.find(value.root, id)
				local kind = if node then session.library.kinds[node.kind] else nil
				if
					node
					and kind
					and kind.children == "list"
					and kind.leaf ~= true
					and not blocked(id)
					and not table.find(session.selection:peek(), id)
					and Design.document.find(movingNode, id) == nil
					and ui.get(instance, "Parent")
					and contains(instance, point, surface)
				then
					local depth = depthOf(instance, surface)
					if depth > deepest then
						host, deepest = node, depth
					end
				end
			end
			local container = host
			if container == nil then
				return nil
			end
			local box = nodes[container.id]
			local across = horizontal(box)
			local origin = ui.xy(overlay, "AbsolutePosition")
			local at, extent = ui.xy(box, "AbsolutePosition"), ui.xy(box, "AbsoluteSize")
			local before, count = 1, 0
			local edge = if across then at.X else at.Y
			for _, child in container.children do
				if child.id ~= moving and not table.find(session.selection:peek(), child.id) then
					count += 1
					local instance = nodes[child.id]
					if instance then
						local position, size = ui.xy(instance, "AbsolutePosition"), ui.xy(instance, "AbsoluteSize")
						local middle = if across then position.X + size.X / 2 else position.Y + size.Y / 2
						local pointer = if across then point.X else point.Y
						if pointer > middle then
							before = count + 1
							edge = if across then position.X + size.X else position.Y + size.Y
						end
					end
				end
			end
			return {
				destination = container.id,
				before = before,
				edge = if across
					then { X = edge - origin.X, Y = at.Y - origin.Y }
					else { X = at.X - origin.X, Y = edge - origin.Y },
				along = if across then { X = 2, Y = extent.Y } else { X = extent.X, Y = 2 },
			}
		end
		local function carry(point: UI.Point)
			local active = carrying
			if active == nil then
				return
			end
			if not active.active and Math.length(Math.sub(point, active.start)) < 4 then
				return
			end
			active.active = true
			local drop = dropAt(point, active.id)
			active.drop = drop
			ui.set(marker, "Visible", drop ~= nil)
			if drop then
				ui.set(marker, "Position", ui.values.udim2(0, drop.edge.X, 0, drop.edge.Y))
				ui.set(marker, "Size", ui.values.udim2(0, drop.along.X, 0, drop.along.Y))
			end
		end
		local function finishCarry()
			local active = carrying
			carrying = nil
			ui.set(marker, "Visible", false)
			local drop = if active and active.active then active.drop else nil
			if active and drop then
				session.move(active.id, drop.destination, drop.before)
			elseif active and not active.active then
				session.select(active.id)
			end
		end
		local function startResize(corner: UI.Point, from: UI.Point)
			local id = session.selected:peek()
			if #session.selection:peek() ~= 1 or blocked(id) then
				return
			end
			local instance: Compose.Node? = nodes[id]
			local node = Design.document.find(session.document:peek().root, id)
			if instance == nil or node == nil then
				return
			end
			if resizable(id) == nil then
				return
			end
			resizing = {
				corner = corner,
				from = from,
				size = Math.scale(ui.xy(instance, "AbsoluteSize"), 1 / scaleOf(instance)),
				instance = instance,
				result = nil,
			}
		end
		local function updateResize(at: UI.Point)
			local active = resizing
			if active == nil then
				return
			end
			local delta = Math.scale(Math.sub(at, active.from), 1 / scaleOf(active.instance))
			local signed = { X = delta.X * (active.corner.X * 2 - 1), Y = delta.Y * (active.corner.Y * 2 - 1) }
			local width = math.max(1, math.round(active.size.X + signed.X))
			local height = math.max(1, math.round(active.size.Y + signed.Y))
			if
				ui.call(UserInputService, "IsKeyDown", ui.values.enum("KeyCode", "LeftShift")) == true
				and active.size.Y > 0
			then
				local ratio = active.size.X / active.size.Y
				if math.abs(signed.X) > math.abs(signed.Y) then
					height = math.max(1, math.round(width / ratio))
				else
					width = math.max(1, math.round(height * ratio))
				end
			end
			active.result = { X = width, Y = height }
			ui.set(active.instance, "AutomaticSize", ui.values.enum("AutomaticSize", "None"))
			ui.set(active.instance, "Size", ui.values.udim2(0, width, 0, height))
		end
		local function finishResize()
			local active = resizing
			resizing = nil
			local result = if active then active.result else nil
			if result == nil then
				return
			end
			local id = session.selected:peek()
			local node = Design.document.find(session.document:peek().root, id)
			if node == nil then
				return
			end
			local fields = session.library.kinds[node.kind].fields
			if resizable(id) == "size" then
				session.change("Size", { literal = { 0, result.X, 0, result.Y } })
				return
			end
			local changes: { [string]: Design.Value } = {
				width = { literal = result.X },
				height = { literal = result.Y },
			}
			if fields.fillWidth then
				changes.fillWidth = { literal = false }
			end
			if fields.fillHeight then
				changes.fillHeight = { literal = false }
			end
			session.changeMany(changes)
		end
		local runtime = ui.runtime
		local stopDesign: (() -> ())? = nil
		local function pick(point: UI.Point): string?
			local chosen: string? = nil
			local deepest = -1
			for id, instance in nodes do
				if not blocked(id) and ui.get(instance, "Parent") and contains(instance, point, surface) then
					local depth = depthOf(instance, surface)
					if depth > deepest then
						chosen, deepest = id, depth
					end
				end
			end
			return chosen
		end
		local function outline(
			name: string,
			thickness: number,
			handles: boolean,
			target: (Compose.Use) -> { string }
		): Compose.Node
			local box = frame(name)
			ui.set(box, "Visible", false)
			ui.set(box, "Interactable", false)
			ui.set(box, "ZIndex", 2001)
			local ring = Theme.stroke(box, accent, thickness)
			local badge: Compose.Node? = nil
			local grips: { Compose.Node } = {}
			local badgeScale = if handles then ui.new "UIScale" else nil
			if handles then
				for _, corner in { { X = 0, Y = 0 }, { X = 1, Y = 0 }, { X = 0, Y = 1 }, { X = 1, Y = 1 } } do
					local handle = frame "Handle"
					ui.set(handle, "AnchorPoint", ui.values.vector2(0.5, 0.5))
					ui.set(handle, "Position", ui.values.udim2(corner.X, 0, corner.Y, 0))
					ui.set(handle, "Size", ui.values.udim2(0, 7, 0, 7))
					ui.set(handle, "BackgroundTransparency", 0)
					ui.set(handle, "BackgroundColor3", Theme.color.white)
					ui.set(handle, "ZIndex", 2002)
					Theme.stroke(handle, accent, 1)
					ui.set(handle, "Parent", box)
					table.insert(grips, handle)
					table.insert(selectionGrips, { frame = handle, corner = corner })
				end
				local size = Theme.label("", Theme.color.white, Theme.size.small, Theme.font.bold)
				ui.set(size, "Name", "SizeBadge")
				ui.set(size, "TextTruncate", ui.values.enum("TextTruncate", "None"))
				ui.set(size, "AutomaticSize", ui.values.enum("AutomaticSize", "X"))
				ui.set(size, "AnchorPoint", ui.values.vector2(0.5, 0))
				ui.set(size, "Position", ui.values.udim2(0.5, 0, 1, 8))
				ui.set(size, "Size", ui.values.udim2(0, 0, 0, 24))
				ui.set(size, "BackgroundTransparency", 0)
				ui.set(size, "BackgroundColor3", accent)
				ui.set(size, "TextXAlignment", ui.values.enum("TextXAlignment", "Center"))
				ui.set(size, "ZIndex", 2003)
				Theme.corner(size, 4)
				Theme.pad(size, 6)
				ui.set(badgeScale, "Parent", size)
				ui.set(size, "Parent", box)
				badge = size
			end
			ui.set(box, "Parent", overlay)
			local connections: { UI.Connection } = {}
			local function release()
				for _, connection in connections do
					connection:Disconnect()
				end
				table.clear(connections)
			end
			local shown: { Compose.Node } = {}
			local function place()
				local instance = shown[1]
				if instance == nil or ui.get(instance, "Parent") == nil or ui.get(instance, "Visible") == false then
					ui.set(box, "Visible", false)
					return
				end
				local factor = scaleOf(instance)
				local at = Math.scale(
					Math.sub(ui.xy(instance, "AbsolutePosition"), ui.xy(overlay, "AbsolutePosition")),
					1 / factor
				)
				local extent = Math.scale(ui.xy(instance, "AbsoluteSize"), 1 / factor)
				local left = at.X
				local top = at.Y
				local right = at.X + extent.X
				local bottom = at.Y + extent.Y
				for _, other in shown do
					local point = Math.scale(
						Math.sub(ui.xy(other, "AbsolutePosition"), ui.xy(overlay, "AbsolutePosition")),
						1 / factor
					)
					local otherSize = Math.scale(ui.xy(other, "AbsoluteSize"), 1 / factor)
					left = math.min(left, point.X)
					top = math.min(top, point.Y)
					right = math.max(right, point.X + otherSize.X)
					bottom = math.max(bottom, point.Y + otherSize.Y)
				end
				local size = { X = right - left, Y = bottom - top }
				ui.set(box, "Position", ui.values.udim2(0, left, 0, top))
				ui.set(box, "Size", ui.values.udim2(0, size.X, 0, size.Y))
				ui.set(box, "Visible", true)
				ui.set(ring, "Thickness", thickness / factor)
				for _, grip in grips do
					ui.set(grip, "Size", ui.values.udim2(0, 7 / factor, 0, 7 / factor))
				end
				if badgeScale then
					ui.set(badgeScale, "Scale", 1 / factor)
				end
				if badge then
					ui.set(badge, "Position", ui.values.udim2(0.5, 0, 1, 8 / factor))
					ui.set(
						badge,
						"Text",
						`{math.round(size.X / ui.number(camera, "Scale") * factor)} × {math.round(
							size.Y / ui.number(camera, "Scale") * factor
						)}`
					)
				end
			end
			Compose.watch(function(use: Compose.Use)
				release()
				local ids = target(use)
				table.clear(shown)
				for _, id in ids do
					if nodes[id] then
						table.insert(shown, nodes[id])
					end
				end
				local id = ids[1]
				local canResize = #ids == 1 and resizable(id) ~= nil and not blocked(id)
				for _, grip in grips do
					ui.set(grip, "Visible", canResize)
				end
				for _, instance in shown do
					table.insert(connections, ui.changed(instance, "AbsolutePosition", place))
					table.insert(connections, ui.changed(instance, "AbsoluteSize", place))
					table.insert(connections, ui.changed(overlay, "AbsolutePosition", place))
					table.insert(connections, ui.changed(overlay, "AbsoluteSize", place))
				end
				place()
			end)
			Compose.cleanup(release)
			return box
		end
		local started = false
		local players: { [string]: Design.Player } = {}
		local root = Compose.createRootOwner(function()
			Compose.watch(function(use: Compose.Use)
				local value = use(session.document)
				ui.set(title, "Text", value.name)
				if stopDesign then
					stopDesign()
				end
				table.clear(nodes)
				stopDesign = runtime.mountFragment(function(): { Compose.Child }
					local rendered, content = pcall(function(): unknown
						return Design.render(value, library, {
							exclude = function(node: Design.Node): boolean
								return node.hidden == true
							end,
							inputs = options.inputs,
							bindings = options.bindings,
							slots = options.slots,
							token = options.token,
							resolveToken = options.resolveToken,
							players = function(made: { [string]: Design.Player })
								players = made
							end,
							decorate = function(node: Design.Node, subject: unknown)
								local built = ui.node(subject)
								if ui.isA(built, "GuiObject") then
									runtime.decorate(built, { Attributes = { [ATTRIBUTE] = node.id } })
									nodes[node.id] = built
								end
							end,
						})
					end)
					if not rendered then
						if not started then
							error(content, 0)
						end
						table.clear(nodes)
						session.problem:set(`This design does not render: {content}`)
						return {}
					end
					local provide = library.provide
					return { ui.node(if provide then provide(content) else content) }
				end, surface)
			end)
			outline("DesignHover", 1, false, function(use: Compose.Use): { string }
				local id = use(session.hovered)
				return if id and not table.find(use(session.selection), id) then { id } else {}
			end)
			outline("DesignSelected", 1.5, true, function(use: Compose.Use): { string }
				use(session.document)
				return use(session.selection)
			end)
			local perNode: { Compose.Node } = {}
			Compose.watch(function(use: Compose.Use)
				use(session.document)
				local ids = use(session.selection)
				for _, box in perNode do
					ui.destroy(box)
				end
				table.clear(perNode)
				if #ids > 1 then
					for _, id in ids do
						table.insert(
							perNode,
							outline(`DesignSelected_{id}`, 1, false, function(read: Compose.Use): { string }
								read(session.document)
								return { id }
							end)
						)
					end
				end
			end)
		end, runtime.reactor)
		started = true
		local release = Compose.owner.own(ui.owner, root.dispose)
		local function apply()
			local scale = zoom:peek()
			ui.set(camera, "Scale", scale)
			ui.set(titleScale, "Scale", 1 / scale)
			ui.set(title, "Size", ui.values.udim2(0, width * scale, 0, 24))
			ui.set(title, "Position", ui.values.udim2(0.5, 0, 0.5, -height / 2 - 6 / scale))
			ui.set(holder, "Position", ui.values.udim2(0.5, pan.X, 0.5, pan.Y))
		end
		local function zoomTo(scale: number, around: UI.Point?)
			local before = zoom:peek()
			local after = math.clamp(scale, 0.02, 8)
			if around and ui.get(holder, "Parent") and ui.isA(ui.get(holder, "Parent"), "GuiObject") then
				local host = ui.get(holder, "Parent")
				local center = Math.add(
					Math.add(ui.xy(host, "AbsolutePosition"), Math.scale(ui.xy(host, "AbsoluteSize"), 0.5)),
					pan
				)
				pan = Math.add(pan, Math.scale(Math.sub(around, center), 1 - after / before))
			end
			zoom:set(after)
			apply()
		end
		local function fit()
			pan = { X = 0, Y = 0 }
			local host = ui.get(holder, "Parent")
			if host and ui.isA(host, "GuiObject") and ui.xy(host, "AbsoluteSize").X > 0 then
				local room = Math.sub(
					ui.xy(host, "AbsoluteSize"),
					if options.compact then { X = 32, Y = 56 } else { X = 96, Y = 120 }
				)
				zoom:set(math.clamp(math.min(room.X / width, room.Y / height), 0.02, 1))
			else
				zoom:set(1)
			end
			apply()
		end
		local panning: UI.Point? = nil
		local function beginMarquee(point: UI.Point, input: Compose.Node)
			local picked = pick(point)
			if picked == nil or picked == session.document:peek().root.id then
				local additive = ui.modified(input, { "Shift", "Ctrl", "Meta" })
				marquee =
					{ from = point, to = point, base = if additive then table.clone(session.selection:peek()) else {} }
			end
		end
		local surfaceInput: { UI.Connection } = {}
		if ui.isA(parent, "GuiObject") then
			table.insert(
				surfaceInput,
				ui.connect(parent, "InputChanged", function(input: Compose.Node)
					if ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseWheel") then
						local factor = if ui.xyz(input, "Position").Z > 0 then 1.15 else 1 / 1.15
						zoomTo(zoom:peek() * factor, toGui(input))
					end
				end)
			)
			table.insert(
				surfaceInput,
				ui.connect(parent, "InputBegan", function(input: Compose.Node)
					if options.readOnly then
						return
					end
					local middle = ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton3")
					local spaced = ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton1")
						and ui.call(UserInputService, "IsKeyDown", ui.values.enum("KeyCode", "Space")) == true
					if middle or spaced then
						panning = toGui(input)
					elseif ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton1") then
						beginMarquee(toGui(input), input)
					end
				end)
			)
		end
		local function onPointerChanged(input: Compose.Node)
			if marquee and ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseMovement") then
				updateMarquee(toGui(input))
				return
			end
			if resizing and ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseMovement") then
				updateResize(toGui(input))
				return
			end
			if carrying and ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseMovement") then
				carry(toGui(input))
				return
			end
			local from = panning
			if from and ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseMovement") then
				local at = toGui(input)
				pan = Math.add(pan, Math.sub(at, from))
				panning = at
				apply()
			end
		end
		local function onPointerEnded(input: Compose.Node)
			if ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton1") and marquee then
				finishMarquee()
			end
			if
				ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton3")
				or ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton1")
			then
				panning = nil
			end
			if ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton1") and resizing then
				finishResize()
			end
			if ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton1") and carrying then
				finishCarry()
			end
		end
		for _, source in { UserInputService, parent } do
			if source == UserInputService or ui.isA(source, "GuiObject") then
				table.insert(surfaceInput, ui.connect(source, "InputChanged", onPointerChanged))
				table.insert(surfaceInput, ui.connect(source, "InputEnded", onPointerEnded))
			end
		end
		local began = ui.connect(overlay, "InputBegan", function(input: Compose.Node)
			if options.readOnly then
				return
			end
			if
				ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton1")
				or ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "Touch")
			then
				local point = toGui(input)
				local grip = gripAt(point)
				if grip then
					startResize(grip.corner, point)
				elseif ui.call(UserInputService, "IsKeyDown", ui.values.enum("KeyCode", "Space")) ~= true then
					local picked = pick(point)
					if picked == nil or picked == session.document:peek().root.id then
						beginMarquee(point, input)
						return
					end
					local modified = ui.modified(input, { "Shift", "Ctrl", "Meta" })
					if modified then
						session.select(picked, "toggle")
					elseif not table.find(session.selection:peek(), picked) then
						session.select(picked)
					end
					if not modified then
						local movable: { string } = {}
						for _, id in session.selection:peek() do
							if not blocked(id) then
								table.insert(movable, id)
							end
						end
						session.selectMany(movable)
						carrying = { id = picked, start = point, active = false, drop = nil }
					end
				end
			end
		end)
		local moved = ui.connect(overlay, "InputChanged", function(input: Compose.Node)
			if ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseMovement") then
				session.hovered:set(pick(toGui(input)))
			end
		end)
		local left = ui.connect(overlay, "MouseLeave", function()
			session.hovered:set(nil)
		end)
		return {
			surface = surface,
			overlay = overlay,
			nodes = nodes,
			zoom = zoom,
			fit = fit,
			zoomTo = zoomTo,
			play = function(sequence: string)
				local player = players[sequence]
				if player then
					player.play()
				end
			end,
			dispose = function()
				for _, connection in surfaceInput do
					connection:Disconnect()
				end
				began:Disconnect()
				moved:Disconnect()
				left:Disconnect()
				if stopDesign then
					stopDesign()
				end
				release()
				ui.destroy(holder)
			end,
		}
	end
end
]]></ProtectedString>
									<string name="ScriptGuid">{7D275773-4382-40D3-8466-1517B8F7231E}</string>
									<BinaryString name="AttributesSerialize"></BinaryString>
									<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
									<bool name="DefinesCapabilities">false</bool>
									<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
									<string name="Name">stage</string>
									<BinaryString name="SerializedOverrides"></BinaryString>
									<int64 name="SourceAssetId">-1</int64>
									<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
									<UniqueId name="UniqueId">73c8afe78d24b4d30afced1100000568</UniqueId>
								</Properties>
							</Item>
							<Item class="ModuleScript" referent="395">
								<Properties>
									<Content name="LinkedSource"><null></null></Content>
									<ProtectedString name="Source"><![CDATA[--!strict

local UI = require "./ui"
local Math = require "./math"

local Compose = require "../core"
local Design = require "../design"

local MAX_DISTANCE = 5000

export type Scene = {
	viewport: Compose.Node,
	world: Compose.Node,
	camera: Compose.Node,
	nodes: { [string]: Compose.Node },
	zoom: Compose.Value<number>,
	fit: () -> (),
	zoomTo: (scale: number, around: UI.Point?) -> (),
	pick: (point: UI.Point) -> string?,
	dispose: () -> (),
}

export type Options = {
	library: Design.Library?,
	fieldOfView: number?,
	readOnly: boolean?,
	accent: unknown?,
	token: ((name: string) -> Design.Literal)?,
	resolveToken: ((name: string) -> Design.Resolved)?,
	inputs: { [string]: Design.Literal }?,
	bindings: { [string]: Design.Resolved }?,
	slots: { [string]: () -> unknown }?,
}

return function(ui: UI.UI)
	local Theme = require "./theme"(ui)
	local ATTRIBUTE = "ComposeDesignNode"
	local AXES = {
		{ name = "X", direction = { X = 1, Y = 0, Z = 0 }, color = ui.rgb(242, 92, 84) },
		{ name = "Y", direction = { X = 0, Y = 1, Z = 0 }, color = ui.rgb(80, 200, 120) },
		{ name = "Z", direction = { X = 0, Y = 0, Z = 1 }, color = ui.rgb(53, 129, 247) },
	}

	local function helper(name: string, size: UI.Vector, color: unknown, transparency: number): Compose.Node
		local part = ui.new "Part"
		ui.set(part, "Name", name)
		ui.set(part, "Anchored", true)
		ui.set(part, "CanCollide", false)
		ui.set(part, "CanQuery", false)
		ui.set(part, "CastShadow", false)
		ui.set(part, "Material", ui.values.enum("Material", "SmoothPlastic"))
		ui.set(part, "Size", ui.values.vector3(size.X, size.Y, size.Z))
		ui.set(part, "Color", color)
		ui.set(part, "Transparency", transparency)
		return part
	end

	local function boundsOf(instance: Compose.Node): (unknown, UI.Vector)
		if ui.isA(instance, "Model") then
			local frame, extent = ui.call(instance, "GetBoundingBox")
			return frame, ui.vector(extent)
		elseif ui.isA(instance, "BasePart") then
			return ui.get(instance, "CFrame"), ui.xyz(instance, "Size")
		end
		return ui.call(instance, "GetPivot"), { X = 1, Y = 1, Z = 1 }
	end

	local function closestOnAxis(
		origin: UI.Vector,
		axis: UI.Vector,
		rayOrigin: UI.Vector,
		rayDirection: UI.Vector
	): number
		local w = Math.vsub(origin, rayOrigin)
		local b = Math.dot(axis, rayDirection)
		local d = Math.dot(axis, w)
		local e = Math.dot(rayDirection, w)
		local c = Math.dot(rayDirection, rayDirection)
		local denominator = c - b * b
		if math.abs(denominator) < 1e-6 then
			return 0
		end
		return (b * e - c * d) / denominator
	end

	return function(session: Design.Session, parent: Compose.Node, options: Options): Scene
		local library = options.library or session.library
		local accent = options.accent or Theme.color.accent
		local viewport = ui.new "ViewportFrame"
		ui.set(viewport, "Name", "DesignScene")
		ui.set(viewport, "Size", ui.values.udim2(1, 0, 1, 0))
		ui.set(viewport, "BackgroundColor3", Theme.color.canvas)
		ui.set(viewport, "BorderSizePixel", 0)
		ui.set(viewport, "Ambient", ui.rgb(150, 150, 160))
		ui.set(viewport, "LightColor", ui.rgb(255, 250, 240))
		ui.set(viewport, "LightDirection", ui.values.vector3(-1, -2, -0.6))
		ui.set(viewport, "Active", true)
		local world = ui.new "WorldModel"
		ui.set(world, "Parent", viewport)
		local camera = ui.new "Camera"
		ui.set(camera, "FieldOfView", options.fieldOfView or 50)
		ui.set(camera, "Parent", viewport)
		ui.set(viewport, "CurrentCamera", camera)
		local guides = ui.new "Folder"
		ui.set(guides, "Name", "Guides")
		ui.set(guides, "Parent", world)
		for step = -32, 32, 4 do
			local major = step == 0
			local tone = if major then Theme.color.secondary else Theme.color.grid
			local width = if major then 0.08 else 0.04
			local fade = if major then 0.3 else 0.5
			local across = helper("GridX", { X = 64, Y = 0.02, Z = width }, tone, fade)
			ui.set(across, "CFrame", ui.values.cframe(Math.frame { X = 0, Y = 0, Z = step }))
			ui.set(across, "Parent", guides)
			local along = helper("GridZ", { X = width, Y = 0.02, Z = 64 }, tone, fade)
			ui.set(along, "CFrame", ui.values.cframe(Math.frame { X = step, Y = 0, Z = 0 }))
			ui.set(along, "Parent", guides)
		end
		ui.set(viewport, "Parent", parent)
		local nodes: { [string]: Compose.Node } = {}
		local function blocked(id: string): boolean
			local node, parentNode = Design.document.find(session.document:peek().root, id)
			while node do
				if node.locked or node.hidden then
					return true
				end
				node = parentNode
				if node then
					local _, ancestor = Design.document.find(session.document:peek().root, node.id)
					parentNode = ancestor
				end
			end
			return false
		end
		local runtime = ui.runtime
		local stopDesign: (() -> ())? = nil
		local yaw, pitch, distance, focus = math.rad(35), math.rad(-28), 28, { X = 0, Y = 1, Z = 0 }
		local zoom = Compose.cell(1)
		local function aim()
			local rotation = Math.rotation(pitch, yaw, 0)
			ui.set(
				camera,
				"CFrame",
				ui.values.cframe(
					Math.multiply(Math.multiply(Math.frame(focus), rotation), Math.frame { X = 0, Y = 0, Z = distance })
				)
			)
			ui.set(camera, "Focus", ui.values.cframe(Math.frame(focus)))
			zoom:set(28 / distance)
		end
		aim()
		local function ray(point: UI.Point): (UI.Vector, UI.Vector)
			local size = ui.xy(viewport, "AbsoluteSize")
			local local2 = Math.sub(point, ui.xy(viewport, "AbsolutePosition"))
			local ndc = { X = local2.X / math.max(size.X, 1) * 2 - 1, Y = 1 - local2.Y / math.max(size.Y, 1) * 2 }
			local tanY = math.tan(math.rad(ui.number(camera, "FieldOfView")) / 2)
			local tanX = tanY * size.X / math.max(size.Y, 1)
			local direction = Math.unit(
				Math.transform(ui.components(ui.get(camera, "CFrame")), { X = ndc.X * tanX, Y = ndc.Y * tanY, Z = -1 })
			)
			return ui.xyz(ui.get(camera, "CFrame"), "Position"), direction
		end
		type Bounds = { left: number, top: number, right: number, bottom: number }
		local function projectedBounds(instance: Compose.Node): Bounds?
			local frame, extent = boundsOf(instance)
			local components = ui.components(frame)
			local origin = ui.xyz(frame, "Position")
			local at, size = ui.xy(viewport, "AbsolutePosition"), ui.xy(viewport, "AbsoluteSize")
			local tanY = math.tan(math.rad(ui.number(camera, "FieldOfView")) / 2)
			local tanX = tanY * size.X / math.max(size.Y, 1)
			local bounds: Bounds = { left = math.huge, top = math.huge, right = -math.huge, bottom = -math.huge }
			for _, x in { -0.5, 0.5 } do
				for _, y in { -0.5, 0.5 } do
					for _, z in { -0.5, 0.5 } do
						local corner = Math.vadd(
							origin,
							Math.transform(components, { X = extent.X * x, Y = extent.Y * y, Z = extent.Z * z })
						)
						local localPoint = ui.vector(
							ui.call(
								ui.get(camera, "CFrame"),
								"PointToObjectSpace",
								ui.values.vector3(corner.X, corner.Y, corner.Z)
							)
						)
						if localPoint.Z < -0.01 then
							local px = at.X + (localPoint.X / -localPoint.Z / tanX + 1) * size.X / 2
							local py = at.Y + (1 - localPoint.Y / -localPoint.Z / tanY) * size.Y / 2
							bounds.left = math.min(bounds.left, px)
							bounds.top = math.min(bounds.top, py)
							bounds.right = math.max(bounds.right, px)
							bounds.bottom = math.max(bounds.bottom, py)
						end
					end
				end
			end
			return if bounds.left < math.huge then bounds else nil
		end
		local function nodeOf(instance: Compose.Node?): string?
			local current = instance
			while current and current ~= world do
				local id = ui.call(current, "GetAttribute", ATTRIBUTE)
				if type(id) == "string" then
					return id
				end
				current = ui.optionalNode(ui.get(current, "Parent"))
			end
			return nil
		end
		local gizmo = ui.new "Folder"
		ui.set(gizmo, "Name", "Gizmo")
		ui.set(gizmo, "Parent", world)
		local selectedBox = helper("Selected", { X = 1, Y = 1, Z = 1 }, accent, 0.9)
		ui.set(selectedBox, "Parent", gizmo)
		local hoverBox = helper("Hovered", { X = 1, Y = 1, Z = 1 }, accent, 0.95)
		ui.set(hoverBox, "Parent", gizmo)
		local handles: { [Compose.Node]: UI.Vector } = {}
		for _, axis in AXES do
			local shaft = helper("Axis" .. axis.name, { X = 0.12, Y = 0.12, Z = 2.4 }, axis.color, 0)
			ui.set(shaft, "CanQuery", true)
			ui.set(shaft, "Parent", gizmo)
			local tip = helper("Tip" .. axis.name, { X = 0.4, Y = 0.4, Z = 0.6 }, axis.color, 0)
			ui.set(tip, "CanQuery", true)
			ui.set(tip, "Parent", gizmo)
			handles[shaft] = axis.direction
			handles[tip] = axis.direction
		end
		local function show(box: Compose.Node, id: string?)
			local instance = if id then nodes[id] else nil
			if instance == nil or ui.get(instance, "Parent") == nil then
				ui.set(box, "Transparency", 1)
				return
			end
			local frame, size = boundsOf(instance)
			ui.set(box, "CFrame", frame)
			ui.set(box, "Size", ui.values.vector3(size.X + 0.15, size.Y + 0.15, size.Z + 0.15))
			ui.set(box, "Transparency", if box == selectedBox then 0.9 else 0.95)
		end
		local function placeGizmo(id: string?)
			local instance = if id then nodes[id] else nil
			local node = if id then Design.document.find(session.document:peek().root, id) else nil
			local position = if node then node.props.position else nil
			local movable = node ~= nil
				and session.library.kinds[node.kind].fields.position ~= nil
				and (position == nil or position.literal ~= nil)
			for part, direction in handles do
				if not movable or instance == nil or ui.get(instance, "Parent") == nil or (id and blocked(id)) then
					ui.set(part, "Transparency", 1)
					ui.set(part, "CanQuery", false)
				else
					local origin = ui.xyz(ui.call(instance, "GetPivot"), "Position")
					local _, extent = boundsOf(instance)
					local reach = math.abs(Math.dot(extent, direction)) / 2 + 0.6
					local length = if string.sub(ui.text(part, "Name"), 1, 3) == "Tip" then reach + 2.7 else reach + 1.2
					ui.set(
						part,
						"CFrame",
						ui.values.cframe(
							Math.lookAt(
								Math.vadd(origin, Math.vscale(direction, length)),
								Math.vadd(origin, Math.vscale(direction, length + 1))
							)
						)
					)
					ui.set(part, "Transparency", 0)
					ui.set(part, "CanQuery", true)
				end
			end
		end
		local function pick(point: UI.Point): string?
			local origin, direction = ray(point)
			local excluded: { unknown } = { guides, gizmo }
			for id, instance in nodes do
				if blocked(id) then
					table.insert(excluded, instance)
				end
			end
			local parameters = ui.values.raycastParams(false, excluded)
			local hit = ui.call(
				world,
				"Raycast",
				ui.values.vector3(origin.X, origin.Y, origin.Z),
				ui.values.vector3(direction.X * 15000, direction.Y * 15000, direction.Z * 15000),
				parameters
			)
			return if hit then nodeOf(ui.optionalNode(ui.get(hit, "Instance"))) else nil
		end
		local refreshSelection: () -> () = function() end
		local root = Compose.createRootOwner(function()
			Compose.watch(function(use: Compose.Use)
				local value = use(session.document)
				if stopDesign then
					stopDesign()
				end
				table.clear(nodes)
				stopDesign = runtime.mount(function(): Compose.Node
					return ui.node(Design.render(value, library, {
						exclude = function(node: Design.Node): boolean
							return node.hidden == true
						end,
						inputs = options.inputs,
						bindings = options.bindings,
						slots = options.slots,
						token = options.token,
						resolveToken = options.resolveToken,
						decorate = function(node: Design.Node, subject: unknown)
							local built = ui.node(subject)
							if ui.isA(built, "PVInstance") then
								runtime.decorate(built, { Attributes = { [ATTRIBUTE] = node.id } })
								nodes[node.id] = built
							end
						end,
					}))
				end, world)
			end)
			local selectionBoxes: { [string]: Compose.Node } = {}
			Compose.watch(function(use: Compose.Use)
				use(session.document)
				local id = use(session.selected)
				local ids = use(session.selection)
				for _, box in selectionBoxes do
					ui.destroy(box)
				end
				table.clear(selectionBoxes)
				if #ids > 1 then
					for _, selected in ids do
						if nodes[selected] then
							local box = helper(`Selected_{selected}`, { X = 1, Y = 1, Z = 1 }, accent, 0.95)
							ui.set(box, "Parent", gizmo)
							selectionBoxes[selected] = box
						end
					end
				end
				refreshSelection = function()
					show(selectedBox, id)
					if #ids > 1 then
						local low = { X = math.huge, Y = math.huge, Z = math.huge }
						local high = { X = -math.huge, Y = -math.huge, Z = -math.huge }
						for _, selected in ids do
							local instance = nodes[selected]
							if instance then
								show(selectionBoxes[selected], selected)
								local frame, size = boundsOf(instance)
								local components = ui.components(frame)
								local origin = ui.xyz(frame, "Position")
								for _, x in { -0.5, 0.5 } do
									for _, y in { -0.5, 0.5 } do
										for _, z in { -0.5, 0.5 } do
											local point = Math.vadd(
												origin,
												Math.transform(
													components,
													{ X = size.X * x, Y = size.Y * y, Z = size.Z * z }
												)
											)
											low = {
												X = math.min(low.X, point.X),
												Y = math.min(low.Y, point.Y),
												Z = math.min(low.Z, point.Z),
											}
											high = {
												X = math.max(high.X, point.X),
												Y = math.max(high.Y, point.Y),
												Z = math.max(high.Z, point.Z),
											}
										end
									end
								end
							end
						end
						if low.X < math.huge then
							local center = Math.vscale(Math.vadd(low, high), 0.5)
							local size = Math.vadd(Math.vsub(high, low), { X = 0.15, Y = 0.15, Z = 0.15 })
							ui.set(selectedBox, "CFrame", ui.values.cframe(Math.frame(center)))
							ui.set(selectedBox, "Size", ui.values.vector3(size.X, size.Y, size.Z))
							ui.set(selectedBox, "Transparency", 0.9)
						end
					end
					placeGizmo(id)
				end
				refreshSelection()
			end)
			Compose.watch(function(use: Compose.Use)
				use(session.document)
				local hovered = use(session.hovered)
				show(hoverBox, if hovered and table.find(use(session.selection), hovered) then nil else hovered)
			end)
		end, runtime.reactor)
		local release = Compose.owner.own(ui.owner, root.dispose)
		local function fit()
			local value = session.document:peek()
			local instance = nodes[value.root.id]
			if instance then
				local frame, size = boundsOf(instance)
				focus = ui.xyz(frame, "Position")
				local viewportSize = ui.xy(viewport, "AbsoluteSize")
				local vertical = math.rad(ui.number(camera, "FieldOfView")) / 2
				local horizontal = math.atan(math.tan(vertical) * viewportSize.X / math.max(1, viewportSize.Y))
				distance =
					math.clamp(Math.magnitude(size) * 0.575 / math.sin(math.min(vertical, horizontal)), 6, MAX_DISTANCE)
			end
			aim()
		end
		local function zoomTo(scale: number, _around: UI.Point?)
			distance = math.clamp(28 / math.max(scale, 0.005), 2, MAX_DISTANCE)
			aim()
		end
		local UserInputService = ui.service "UserInputService"
		type Drag = {
			kind: "orbit" | "pan" | "move" | "marquee",
			from: UI.Point,
			axis: UI.Vector?,
			origin: UI.Vector?,
			start: number?,
			origins: { [string]: UI.Vector }?,
			to: UI.Point?,
			base: { string }?,
		}
		local drag: Drag? = nil
		local moved: UI.Vector? = nil
		local marquee = Theme.frame("DesignMarquee", accent)
		ui.set(marquee, "BackgroundTransparency", 0.85)
		ui.set(marquee, "Visible", false)
		ui.set(marquee, "ZIndex", 10)
		Theme.stroke(marquee, accent, 1)
		ui.set(marquee, "Parent", viewport)
		local function translate(instance: Compose.Node, target: UI.Vector)
			local origin = ui.xyz(ui.call(instance, "GetPivot"), "Position")
			local delta = Math.vsub(target, origin)
			local targets: { Compose.Node } = if ui.isA(instance, "BasePart")
				then { instance }
				else ui.descendants(instance)
			local changes: { { node: Compose.Node, property: string, frame: { number } } } = {}
			for _, node in targets do
				local part = ui.isA(node, "BasePart")
				if part or ui.isA(node, "Model") then
					local frame = ui.components(if part then ui.get(node, "CFrame") else ui.call(node, "GetPivot"))
					frame[1] += delta.X
					frame[2] += delta.Y
					frame[3] += delta.Z
					table.insert(
						changes,
						{ node = node, property = if part then "CFrame" else "WorldPivot", frame = frame }
					)
				end
			end
			if ui.isA(instance, "Model") then
				local pivot = ui.components(ui.call(instance, "GetPivot"))
				pivot[1], pivot[2], pivot[3] = target.X, target.Y, target.Z
				table.insert(changes, { node = instance, property = "WorldPivot", frame = pivot })
			end
			for _, change in changes do
				ui.set(change.node, change.property, ui.values.cframe(change.frame))
			end
		end
		local connections: { UI.Connection } = {}
		local function connect(connection: UI.Connection)
			table.insert(connections, connection)
		end
		connect(ui.connect(viewport, "InputBegan", function(input: Compose.Node)
			if options.readOnly then
				return
			end
			local point = Theme.point(input)
			if ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton2") then
				drag = { kind = "orbit", from = point }
			elseif
				ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton3")
				or (
					ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton1")
					and ui.call(UserInputService, "IsKeyDown", ui.values.enum("KeyCode", "Space")) == true
				)
			then
				drag = { kind = "pan", from = point }
			elseif ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton1") then
				local origin, direction = ray(point)
				local parameters = ui.values.raycastParams(true, { gizmo })
				local hit = ui.call(
					world,
					"Raycast",
					ui.values.vector3(origin.X, origin.Y, origin.Z),
					ui.values.vector3(direction.X * 2000, direction.Y * 2000, direction.Z * 2000),
					parameters
				)
				local axis = if hit and ui.isA(ui.get(hit, "Instance"), "Part")
					then handles[ui.node(ui.get(hit, "Instance"))]
					else nil
				local selected = nodes[session.selected:peek()]
				if axis and selected and not blocked(session.selected:peek()) then
					local origins: { [string]: UI.Vector } = {}
					local ids: { string } = {}
					for _, id in session.selection:peek() do
						local node = Design.document.find(session.document:peek().root, id)
						local covered = false
						for _, ancestor in ids do
							local holder = Design.document.find(session.document:peek().root, ancestor)
							covered = covered or (holder ~= nil and Design.document.find(holder, id) ~= nil)
						end
						if
							node
							and nodes[id]
							and not blocked(id)
							and not covered
							and session.library.kinds[node.kind].fields.position
							and (node.props.position == nil or node.props.position.literal ~= nil)
						then
							table.insert(ids, id)
							origins[id] = ui.xyz(ui.call(nodes[id], "GetPivot"), "Position")
						end
					end
					session.selectMany(ids)
					selected = nodes[session.selected:peek()]
					if selected == nil then
						return
					end
					local pivot = ui.xyz(ui.call(selected, "GetPivot"), "Position")
					drag = {
						kind = "move",
						from = point,
						axis = axis,
						origin = pivot,
						start = closestOnAxis(pivot, axis, origin, direction),
						origins = origins,
					}
					moved = nil
				else
					local id = pick(point)
					if id then
						local modified = ui.keyDown {
							"LeftShift",
							"RightShift",
							"LeftControl",
							"RightControl",
							"LeftMeta",
							"RightMeta",
							"LeftSuper",
							"RightSuper",
						}
						session.select(id, if modified then "toggle" else "replace")
					else
						local modified = ui.keyDown {
							"LeftShift",
							"RightShift",
							"LeftControl",
							"RightControl",
							"LeftMeta",
							"RightMeta",
							"LeftSuper",
							"RightSuper",
						}
						local base = if modified then table.clone(session.selection:peek()) else {}
						drag = { kind = "marquee", from = point, base = base }
						session.selectMany(base)
					end
				end
			elseif ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseWheel") then
				distance =
					math.clamp(distance * (if ui.xyz(input, "Position").Z > 0 then 0.87 else 1 / 0.87), 2, MAX_DISTANCE)
				aim()
			end
		end))
		connect(ui.connect(viewport, "InputChanged", function(input: Compose.Node)
			if ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseWheel") then
				distance =
					math.clamp(distance * (if ui.xyz(input, "Position").Z > 0 then 0.87 else 1 / 0.87), 2, MAX_DISTANCE)
				aim()
			elseif
				ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseMovement") and drag == nil
			then
				session.hovered:set(pick(Theme.point(input)))
			end
		end))
		connect(ui.connect(UserInputService, "InputChanged", function(input: Compose.Node)
			local active = drag
			if active == nil or ui.get(input, "UserInputType") ~= ui.values.enum("UserInputType", "MouseMovement") then
				return
			end
			local point = Theme.point(input)
			local delta = Math.sub(point, active.from)
			if active.kind == "orbit" then
				yaw -= delta.X * 0.008
				pitch = math.clamp(pitch - delta.Y * 0.008, math.rad(-88), math.rad(88))
				active.from = point
				aim()
			elseif active.kind == "marquee" then
				active.to = point
				local at = ui.xy(viewport, "AbsolutePosition")
				ui.set(
					marquee,
					"Position",
					ui.values.udim2(
						0,
						math.min(active.from.X, point.X) - at.X,
						0,
						math.min(active.from.Y, point.Y) - at.Y
					)
				)
				ui.set(marquee, "Size", ui.values.udim2(0, math.abs(delta.X), 0, math.abs(delta.Y)))
				ui.set(marquee, "Visible", true)
			elseif active.kind == "pan" then
				local scale = distance * 0.0016
				local frame = ui.get(camera, "CFrame")
				focus = Math.vadd(
					focus,
					Math.vadd(
						Math.vscale(ui.xyz(frame, "RightVector"), -delta.X * scale),
						Math.vscale(ui.xyz(frame, "UpVector"), delta.Y * scale)
					)
				)
				active.from = point
				aim()
			else
				local axis, origin, start = active.axis, active.origin, active.start
				local selected = nodes[session.selected:peek()]
				if axis and origin and start and selected then
					local rayOrigin, rayDirection = ray(point)
					local along = closestOnAxis(origin, axis, rayOrigin, rayDirection) - start
					if ui.call(UserInputService, "IsKeyDown", ui.values.enum("KeyCode", "LeftControl")) ~= true then
						along = math.round(along)
					end
					local target = Math.vadd(origin, Math.vscale(axis, along))
					if active.origins then
						for id, from in active.origins do
							translate(nodes[id], Math.vadd(from, Math.vscale(axis, along)))
						end
					end
					moved = target
					refreshSelection()
				end
			end
		end))
		connect(ui.connect(UserInputService, "InputEnded", function(input: Compose.Node)
			local active = drag
			if active == nil then
				return
			end
			local released = ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton1")
				or ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton2")
				or ui.get(input, "UserInputType") == ui.values.enum("UserInputType", "MouseButton3")
			if not released then
				return
			end
			drag = nil
			if active.kind == "marquee" then
				ui.set(marquee, "Visible", false)
				local ids = table.clone(active.base or {})
				local point = active.to
				if point and Math.length(Math.sub(point, active.from)) >= 4 then
					local left, right = math.min(point.X, active.from.X), math.max(point.X, active.from.X)
					local top, bottom = math.min(point.Y, active.from.Y), math.max(point.Y, active.from.Y)
					for id, instance in nodes do
						if id ~= session.document:peek().root.id and not blocked(id) then
							local bounds = projectedBounds(instance)
							if
								bounds
								and bounds.left <= right
								and bounds.right >= left
								and bounds.top <= bottom
								and bounds.bottom >= top
							then
								table.insert(ids, id)
							end
						end
					end
				end
				session.selectMany(ids)
				return
			end
			local target = moved
			moved = nil
			if active.kind == "move" and target then
				local node = Design.document.find(session.document:peek().root, session.selected:peek())
				if node and session.library.kinds[node.kind].fields.position then
					local origin = active.origin
					if origin then
						local delta = Math.vsub(target, origin)
						session.change("position", function(current: Design.Node): Design.Value
							local property = current.props.position
							local literal = if property then property.literal else nil
							local x = if type(literal) == "table" then literal[1] else nil
							local y = if type(literal) == "table" then literal[2] else nil
							local z = if type(literal) == "table" then literal[3] else nil
							return {
								literal = {
									(if type(x) == "number" then x else 0) + delta.X,
									(if type(y) == "number" then y else 0) + delta.Y,
									(if type(z) == "number" then z else 0) + delta.Z,
								},
							}
						end)
					end
				end
			end
		end))
		return {
			viewport = viewport,
			world = world,
			camera = camera,
			nodes = nodes,
			zoom = zoom,
			fit = fit,
			zoomTo = zoomTo,
			pick = pick,
			dispose = function()
				for _, connection in connections do
					connection:Disconnect()
				end
				if stopDesign then
					stopDesign()
				end
				release()
				ui.destroy(viewport)
			end,
		}
	end
end
]]></ProtectedString>
									<string name="ScriptGuid">{16120CF3-71B7-4018-BAA6-5DFF06EA4B8A}</string>
