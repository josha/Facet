							<ProtectedString name="Source"><![CDATA[--!strict
-- Compact destination menu for small screens.
local Facet = require(game.ReplicatedStorage.Packages.Facet)

return function(ctx: any): any
	local UI = ctx.UI
	local function go(name: string, label: string, icon: string): Instance
		return UI.Button("Go_" .. name) { label = label, icon = icon, onActivate = function() ctx.openOnly(name) end }
	end
	return UI.Sheet "MainMenu" {
		title = "Menu", isPresented = ctx.open.menu, placement = "center", detents = { "hug" },
		content = function()
			return UI.VStack "Items" { width = "fill", gap = "s", align = "stretch",
				go("livery", "Livery", "edit"), go("inventory", "Parts & Drivers", "bolt"), go("crates", "Crates", "star"),
				go("rewards", "Rewards", "gift"), go("party", "Party", "person"), go("settings", "Settings", "settings"),
				UI.Button "Go_help" { label = "Help", icon = "status.info", onActivate = function()
					ctx.open.menu:set(false)
					if ctx.startTutorial then ctx.startTutorial() end
				end },
			}
		end,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{AEF7C620-508B-4E57-B857-1CA2A8BB23A7}</string>
