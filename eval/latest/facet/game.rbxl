	contentFit: Radial.ContentFit?,
	gestureSelection: ("bounded" | "direction")?,
	enabled: Engine.ValueBoolean?,
	holdAction: InputAction?,
	skin: {
		item: Radial.SkinImages?,
		center: Radial.SkinImages?,
		launcher: Radial.SkinImages?,
		background: Radial.SkinImages?,
	}?,
	onOpen: (() -> ())?,
	onClose: (() -> ())?,
	isPresented: Compose.Value<boolean>?,
	transition: boolean?,
	scrim: ("dark" | "light" | "none")?,
	[number]: Compose.Child?,
}
export type RadialMenuSpecInput<V = string> = {
	read Changed: ((string) -> ())?,
	read Attributes: Engine.Attributes?,
	read AncestryChanged: ((Instance, Instance?) -> ())?,
	read Archivable: Engine.ValueBoolean?,
