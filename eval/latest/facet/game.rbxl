local Players = game:GetService("Players")
local Client = script.Parent:WaitForChild("Client")
local Store = require(Client:WaitForChild("Store"))
local Kart = require(Client:WaitForChild("KartController"))
local Input = require(Client:WaitForChild("Input"))
Input.init(Kart)
local ok, err = pcall(function()
	local UI = require(Client:WaitForChild("UI"))
	UI.start(Kart, Input)
end)
if not ok then warn("UI failed to start: " .. tostring(err)) end
]]></ProtectedString>
