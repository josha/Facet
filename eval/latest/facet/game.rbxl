						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Shop: browse parts by category with full prices; codes page returns to the same shop state.
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local C = Facet.Compose

local category = C.cell("all")
local page = C.cell("shop")
local code = C.cell("")
local codeBusy = C.cell(false)
local codeStatus = C.cell({ state = "", message = "" } :: any)
local retryUntil = C.cell(0)
local CONFIRM_CREDITS, CONFIRM_GEMS = 1000, 25

return function(ctx: any): any
	local UI, Store = ctx.UI, ctx.Store
	local env = ctx.env
	ctx.openCodes = function() page:set("codes"); ctx.openOnly("shop") end
	local function prof(use: Facet.Use): any return use(Store.profile) or { ownedParts = {}, credits = 0, gems = 0 } end
	local catOptions: { Facet.PickerOption<string> } = {
		{ value = "all", label = "All" }, { value = "motor", label = "Motors" }, { value = "boost", label = "Boosts" },
		{ value = "wheels", label = "Wheels" }, { value = "cosmetic", label = "Cosmetics" } }
	local function priceText(part: any): string
		return Store.fmt(part.price) .. (if part.currency == "gems" then " Gems" else " Credits")
	end
	local function buy(part: any)
		local expensive = (part.currency == "credits" and part.price >= CONFIRM_CREDITS) or (part.currency == "gems" and part.price >= CONFIRM_GEMS)
		if expensive then
			ctx.confirm({ title = "Buy " .. part.name .. "?", lines = { GameData.SlotLabel[part.slot] .. " · " .. part.blurb, "Price: " .. priceText(part) },
				confirm = "Buy for " .. priceText(part), credits = if part.currency == "credits" then part.price else nil, gems = if part.currency == "gems" then part.price else nil,
				run = function() return Store.request("buyPart", part.id) end })
		else
			ctx.req("buyPart", part.id)
		end
	end
	local function row(part: any): Instance
		local function afford(use: Facet.Use): boolean return (prof(use)[part.currency] or 0) >= part.price end
		return UI.HStack("Item_" .. part.id) { width = "fill", gap = "s", surface = "panel", padding = "s",
			Visible = function(use: Facet.Use): boolean local c = use(category) return c == "all" or c == part.slot end,
			UI.VStack "Info" { UI.fill(), gap = "xs",
				UI.Text { text = part.name, textRole = "strong" },
				UI.Text { text = GameData.SlotLabel[part.slot] .. " · " .. part.blurb, textRole = "caption", wrap = true },
			},
			UI.VStack "Price" { gap = "xs", align = "end",
				UI.Text { text = priceText(part), textRole = "strong" },
				UI.Text { textRole = "caption", text = function(use: Facet.Use): string
					if prof(use).ownedParts[part.id] then return "Owned" end
					if afford(use) then return "Affordable" end
					return "Need " .. Store.fmt(part.price - (prof(use)[part.currency] or 0)) .. " more"
				end },
			},
			UI.Button "Buy" {
				label = function(use: Facet.Use): string
					if prof(use).ownedParts[part.id] then return "✓ Owned" end
					return if afford(use) then "Buy" else "Can't afford"
				end,
				appearance = function(use: Facet.Use): string return if not prof(use).ownedParts[part.id] and afford(use) then "emphasis" else "standard" end,
				enabled = function(use: Facet.Use): boolean return not prof(use).ownedParts[part.id] and afford(use) end,
				onActivate = function() buy(part) end },
		}
	end
	local function redeem()
		if codeBusy:peek() then return end
		local wait = retryUntil:peek() - os.clock()
		if wait > 0 then return end
		codeBusy:set(true)
		codeStatus:set({ state = "busy", message = "Checking code…" })
		local r = Store.request("redeem", code:peek())
		codeBusy:set(false)
		codeStatus:set({ state = r.state or (if r.ok then "success" else "invalid"), message = r.message })
		if r.state == "limited" and r.retry then retryUntil:set(os.clock() + r.retry) end
		if r.ok then code:set("") end
	end

	return UI.Sheet "Shop" {
		title = "Shop", isPresented = ctx.open.shop, placement = "center", width = "wide", detents = { "hug" },
		content = function()
			local rows = {}
			for _, p in GameData.Parts do table.insert(rows, row(p)) end
			return UI.VStack "Body" { width = "fill", gap = "m", maxWidth = env.scaled(640),
				UI.VStack "Store" { width = "fill", gap = "s",
					Visible = function(use: Facet.Use): boolean return use(page) == "shop" end,
					UI.HStack "Top" { width = "fill", gap = "s",
						UI.Text { textRole = "strong", UI.fill(), text = function(use: Facet.Use): string
							local p = prof(use)
							return "Wallet: " .. Store.fmt(p.credits) .. " Credits · " .. Store.fmt(p.gems) .. " Gems"
						end },
						UI.Button "Codes" { label = "Redeem code", icon = "gift", onActivate = function() page:set("codes") end },
					},
					UI.Picker "Category" { selected = category, options = catOptions, style = "segmented" },
					UI.Text { text = "Purchases of 1,000 Credits or 25 Gems and more ask for confirmation.", textRole = "caption", wrap = true },
					table.unpack(rows),
				},
				UI.VStack "Codes" { width = "fill", gap = "s",
					Visible = function(use: Facet.Use): boolean return use(page) == "codes" end,
					UI.Button "BackToShop" { label = "Back to shop", icon = "chevron.leading", onActivate = function() page:set("shop") end },
					UI.Text { text = "Redeem a code", textRole = "heading" },
					UI.Text { text = "Codes ignore case and extra spaces. Spot one on the purple billboard in the hub: " .. GameData.SampleCode, wrap = true, textRole = "caption" },
					UI.TextInput "Code" { value = code, placeholder = "Enter code", onCommit = function() redeem() end },
					UI.Button "Redeem" { appearance = "emphasis", busy = codeBusy,
						label = function(use: Facet.Use): string
							use(Store.time)
							local wait = math.ceil(use(retryUntil) - os.clock())
							return if wait > 0 then "Retry in " .. wait .. "s" else "Redeem"
						end,
						enabled = function(use: Facet.Use): boolean
							use(Store.time)
							return use(retryUntil) - os.clock() <= 0 and not use(codeBusy)
						end,
						onActivate = redeem },
					UI.Text { wrap = true, textRole = "strong", text = function(use: Facet.Use): string
						local s = use(codeStatus)
						use(Store.time)
						if s.state == "limited" then
							local wait = math.ceil(use(retryUntil) - os.clock())
							return if wait > 0 then "⏳ Too many attempts. Try again in " .. wait .. "s" else "You can try again now."
						end
						local glyph = if s.state == "success" then "✓ " elseif s.state == "busy" then "… " elseif s.state == "" then "" else "✕ "
						return glyph .. s.message
					end, Visible = function(use: Facet.Use): boolean return use(codeStatus).message ~= "" end },
				},
			}
		end,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{4A263D05-EC44-4371-8311-5A639B16C773}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Shop</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">73c8afe78d24b4d30afced1100001fa8</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXF5DEE3B143BC4648B8A9E96AFEB67FA9">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Crates: odds, prices and card counts; reveal cards one at a time or all; collection progress.
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local C = Facet.Compose

local revealed = C.cell(0)
local opened = C.cell({} :: { any })

return function(ctx: any): any
	local UI, Store = ctx.UI, ctx.Store
	local env = ctx.env
	local function prof(use: Facet.Use): any return use(Store.profile) or { cards = {}, freeCrates = 0, credits = 0, gems = 0 } end
	local function oddsText(c: any): string
		local bits = {}
		for _, r in GameData.Rarities do table.insert(bits, r .. " " .. c.odds[r] .. "%") end
		return table.concat(bits, " · ")
	end
	local function open(c: any)
		local p = Store.profile:peek()
		local free = c.id == "spark" and p.freeCrates > 0
		local unit = if c.currency == "gems" then "Gems" else "Credits"
		ctx.confirm({
			title = "Open " .. c.name .. "?",
			lines = { c.cards .. " cards · " .. oddsText(c), if free then "Uses 1 free crate · costs nothing" else "Price: " .. Store.fmt(c.price) .. " " .. unit },
			confirm = if free then "Open free crate" else "Open for " .. Store.fmt(c.price) .. " " .. unit,
			credits = if not free and c.currency == "credits" then c.price else nil, gems = if not free and c.currency == "gems" then c.price else nil,
			run = function() return Store.request("openCrate", c.id) end,
			after = function(r: any)
				opened:set(r.cards or {})
				revealed:set(0)
			end })
	end
	local function crateCard(c: any): Instance
		return UI.VStack("Crate_" .. c.id) { gap = "xs", surface = "panel", padding = "m", Size = UDim2.fromOffset(env.scaled(290), 0),
			UI.Text { text = c.name, textRole = "heading" },
			UI.Text { text = c.cards .. " cards per crate", textRole = "strong" },
			UI.Text { text = oddsText(c), textRole = "caption", wrap = true },
			UI.Text { textRole = "strong", text = function(use: Facet.Use): string
				local p = prof(use)
				if c.id == "spark" and p.freeCrates > 0 then return "FREE · " .. p.freeCrates .. " free crate" .. (if p.freeCrates > 1 then "s" else "") .. " left" end
				return Store.fmt(c.price) .. (if c.currency == "gems" then " Gems" else " Credits")
			end },
			UI.Button "Open" { label = "Open", appearance = "emphasis",
				enabled = function(use: Facet.Use): boolean
					local p = prof(use)
					return (c.id == "spark" and p.freeCrates > 0) or (p[c.currency] or 0) >= c.price
				end,
				onActivate = function() open(c) end },
		}
	end
	local revealSlots = {}
	for i = 1, 5 do
		revealSlots[i] = UI.VStack("Card" .. i) { gap = "xs", surface = "panel", padding = "s", Size = UDim2.fromOffset(env.scaled(130), 0),
			Visible = function(use: Facet.Use): boolean return use(opened)[i] ~= nil end,
			UI.Text { textRole = "caption", text = "Card " .. i },
			UI.Text { textRole = "strong", wrap = true, text = function(use: Facet.Use): string
				local card = use(opened)[i]
				if not card then return "" end
				return if use(revealed) >= i then card.name else "? ? ?"
			end },
			UI.Text { textRole = "caption", text = function(use: Facet.Use): string
				local card = use(opened)[i]
				if not card or use(revealed) < i then return "Hidden" end
				return card.rarity .. (if card.new then " · NEW" else " · duplicate")
			end },
		}
	end
	local collection = {}
	for _, card in GameData.Cards do
		table.insert(collection, UI.VStack("Col_" .. card.id) { gap = "xs", surface = "panel", padding = "s", Size = UDim2.fromOffset(env.scaled(130), 0),
			UI.Text { textRole = "strong", text = function(use: Facet.Use): string
				return if (prof(use).cards[card.id] or 0) > 0 then card.name else "Unknown card"
			end },
			UI.Text { textRole = "caption", text = function(use: Facet.Use): string
				local n = prof(use).cards[card.id] or 0
				return if n > 0 then card.rarity .. " · ×" .. n else card.rarity .. " · not found"
			end },
		})
	end
	return UI.Sheet "Crates" {
		title = "Crates", isPresented = ctx.open.crates, placement = "center", width = "wide", detents = { "hug" },
		content = function()
			return UI.VStack "Body" { width = "fill", gap = "m", maxWidth = env.scaled(680),
				UI.HStack "Crates" { width = "fill", wrap = true, gap = "m", crateCard(GameData.Crates[1]), crateCard(GameData.Crates[2]) },
				UI.VStack "Reveal" { width = "fill", gap = "s",
					Visible = function(use: Facet.Use): boolean return #use(opened) > 0 end,
					UI.HStack "Head" { width = "fill", gap = "s", wrap = true,
						UI.Text { text = "Your cards", textRole = "heading" }, UI.Spacer {},
						UI.Button "Next" { label = function(use: Facet.Use): string return string.format("Reveal next (%d/%d)", math.min(use(revealed) + 1, #use(opened)), #use(opened)) end,
							enabled = function(use: Facet.Use): boolean return use(revealed) < #use(opened) end,
							onActivate = function() revealed:set(math.min(#opened:peek(), revealed:peek() + 1)) end },
						UI.Button "All" { label = "Reveal all", enabled = function(use: Facet.Use): boolean return use(revealed) < #use(opened) end,
							onActivate = function() revealed:set(#opened:peek()) end },
					},
					UI.HStack "Cards" { width = "fill", wrap = true, gap = "s", table.unpack(revealSlots) },
				},
				UI.HStack "ColHead" { width = "fill",
					UI.Text { text = "Collection", textRole = "heading" }, UI.Spacer {},
					UI.Text { textRole = "strong", text = function(use: Facet.Use): string
						local n = 0
						for _, card in GameData.Cards do if (prof(use).cards[card.id] or 0) > 0 then n += 1 end end
						return n .. " / " .. #GameData.Cards .. " found"
					end } },
				UI.ProgressView "ColProgress" { value = function(use: Facet.Use): number
					local n = 0
					for _, card in GameData.Cards do if (prof(use).cards[card.id] or 0) > 0 then n += 1 end end
					return n / #GameData.Cards
				end },
				UI.HStack "Collection" { width = "fill", wrap = true, gap = "s", table.unpack(collection) },
			}
		end,
	}
end
]]></ProtectedString>
