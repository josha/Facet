			schemaVersion = themes.SCHEMA,
			version = "1.0.0",
		},
		style = {
			defaultTheme = "Daylight",
			themes = {
				{ name = "Daylight", colors = DAYLIGHT.colors, extra = DAYLIGHT.extra },
				{ name = "Candlelight", colors = CANDLELIGHT.colors, extra = CANDLELIGHT.extra },
			},
		},

		metrics = GENERATED.metrics,
		chrome = {
			panelTail = {
				kind = "fill",
				asset = "parchment_panel_tail",
				size = { w = 32, h = 28 },
				overhang = 16,
				margin = 18,
			},

			panel = {
				kind = "nineSlice",
				asset = "parchment_panel",
				contentInsets = { top = 18, right = 18, bottom = 18, left = 18 },
				fallback = "native",

				shadow = "raised",
			},
			control = {
				kind = "nineSlice",
				asset = {
					default = "parchment_button",
					selected = { asset = "parchment_button", rotation = 180, tint = INK },
				},
				contentInsets = { top = 8, right = 12, bottom = 8, left = 12 },
				fallback = "native",
				shadow = "raised",
			},
			field = {
				kind = "nineSlice",
				asset = "parchment_field",
				contentInsets = { top = 8, right = 12, bottom = 8, left = 12 },
				fallback = "native",
			},

			focus = { kind = "ring", color = "$FocusGlow", thickness = 3 },

			selection = { kind = "native" },
			divider = { kind = "native" },
			scrollbar = { kind = "native" },

			sliderTrack = {
				kind = "nineSlice",
