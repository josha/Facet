						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local Overlay = require("./overlay_types")
local InputProps = require("./input_props")
local NavigationProps = require("./navigation_props")
local surfaceParts = require("./nav_surface_parts")

type CollapsibleButtonSpec = InputProps.ButtonProps & {
	content: Nav.Content?,
	expanded: ComposeTypes.Value<boolean>?,
	initialFocus: string?,
	dismissButton: Nav.Input<boolean>?,
	outsideDismiss: Nav.Input<boolean>?,
}

return function(
	ctx: Types.Context,
	UI: ControlTypes.Controls,
	surfaces: Nav.Surfaces,
	kit: surfaceParts.SurfaceParts
): ()
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local body = kit.body
	UI.CollapsibleView = ctx.construct(
		"CollapsibleView",
		function(spec: NavigationProps.CollapsibleViewSpec): TextButton
			assert(
				type(spec.expanded) == "table" and spec.expanded.set,
				"CollapsibleView.expanded requires a writable Compose cell"
			)
			local buttonSpec = (table.clone(spec) :: unknown) :: CollapsibleButtonSpec
			buttonSpec.content = nil
			buttonSpec.expanded = nil
			buttonSpec.initialFocus = nil
			buttonSpec.dismissButton = nil
			buttonSpec.outsideDismiss = nil
			buttonSpec.ref = nil
			buttonSpec.trailingIcon = spec.trailingIcon or "chevron.down"
			buttonSpec.corners = spec.corners or "pill"
			buttonSpec.onActivate = function()
				spec.expanded:set(not spec.expanded:peek())
			end
			local root = UI.Button(buttonSpec)
			local input = surfaces.service("UserInputService")
			local preferred = if input
				then ctx.observe.PreferredInput(input)
				else Compose.cell<<Enum.PreferredInput?>>(nil)
			local prepared, entered = Compose.cell(false), Compose.cell(false)
			Compose.watch(function(use: ComposeTypes.Use)
				entered:set(use(spec.expanded) and use(prepared))
			end)
			local progress, closed, opacity = kit.revealMotion(entered)
			local function hidden(use: ComposeTypes.Use): number
				return if use(prepared) then opacity(use) else 1
			end
			local function collapse()
				spec.expanded:set(false)
			end
			local title = root:FindFirstChild("Title", true)
			if title and title:IsA("TextLabel") then
				runtime.decorate(title, { TextTruncate = E.TextTruncate.AtEnd, TextWrapped = false })
				runtime.mount(function()
					return Host.UIFlexItem { FlexMode = E.UIFlexMode.Shrink }
				end, title)
			end
			local caret = root:FindFirstChild("TrailingIcon", true)
			if spec.trailingIcon == nil and caret and caret:IsA("GuiObject") then
				runtime.decorate(caret, {
					Rotation = function(use: ComposeTypes.Use)
						return 180 * progress(use)
					end,
				})
			end
			local rootBox, rootAt = ctx.observe.AbsoluteSize(root), ctx.observe.AbsolutePosition(root)
			surfaces.attach(root, {
				surfaces.overlay(root, spec.expanded, function(phase: Nav.PresencePhase?)
					prepared:set(false)
					Compose.cleanup(function()
						prepared:set(false)
					end)
					local layer = assert(surfaces.parent(root))
					local extent, origin = ctx.observe.AbsoluteSize(layer), ctx.observe.AbsolutePosition(layer)
					local column = ctx.column({
						body(spec.content),
						ctx.padding(16, 16),
					}, { Name = "ExpandedBody", Size = D2.new(1, 0, 0, 0), AutomaticSize = E.AutomaticSize.Y })
					local footer = ctx.column({
						Compose.show(function(use: ComposeTypes.Use)
							return read(spec.dismissButton, use) ~= false or use(preferred) == E.PreferredInput.Gamepad
						end, function()
							return UI.Button "Close" { label = "Close", onActivate = collapse }
						end),
						Host.UIPadding {
							PaddingLeft = ctx.types.UDim.new(0, 16),
							PaddingRight = ctx.types.UDim.new(0, 16),
							PaddingBottom = ctx.types.UDim.new(0, 16),
						},
					}, {
						Name = "ExpandedFooter",
						AnchorPoint = V2.new(0, 1),
						Position = D2.fromScale(0, 1),
						Size = D2.new(1, 0, 0, 0),
						AutomaticSize = E.AutomaticSize.Y,
					})
					local natural = ctx.observe.AbsoluteSize(column)
					local footerSize = ctx.observe.AbsoluteSize(footer)
					local chrome = Compose.cell(V2.zero)
					local target = Compose.formula(function(use: ComposeTypes.Use): Overlay.Rect
						local room, offset, at, box = use(extent), use(origin), use(rootAt), use(rootBox)
						local margin = ctx.metric("space.s", use)
						local w = math.min(
							math.max(box.X, (ctx.metric("controls.popup.panelWidth", use))),
							math.max(0, room.X - 2 * margin)
						)
						local h = math.min(
							math.max(use(natural).Y + use(footerSize).Y + use(chrome).Y, box.Y),
							math.max(0, room.Y - 2 * margin)
						)
						local x, y = at.X - offset.X, at.Y - offset.Y
						return {
							x = math.clamp(x, margin, math.max(margin, room.X - margin - w)),
							y = math.clamp(y, margin, math.max(margin, room.Y - margin - h)),
							w = w,
							h = h,
						}
					end)
					local function lerp(use: ComposeTypes.Use): Overlay.Rect
						local goal, at, offset = use(target), use(rootAt), use(origin)
						local t = if use(prepared) then progress(use) else 1
						local x, y = at.X - offset.X, at.Y - offset.Y
						return {
							x = x + (goal.x - x) * t,
							y = y + (goal.y - y) * t,
							w = goal.w,
							h = goal.h,
						}
					end
					local fade = ctx.fade {
						Name = "ExpandedFade",
						BackgroundTransparency = 1,
						Size = function(use: ComposeTypes.Use)
							local goal, inset = use(target), use(chrome)
							return D2.fromOffset(goal.w - inset.X, goal.h - inset.Y)
						end,
						GroupTransparency = 0,
						Host.ScrollingFrame "ExpandedScroll" {
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							Size = function(use: ComposeTypes.Use)
								return D2.new(1, 0, 1, -use(footerSize).Y)
							end,
							CanvasSize = function(use: ComposeTypes.Use)
								return D2.fromOffset(0, use(natural).Y)
							end,
							ScrollingDirection = E.ScrollingDirection.Y,
							ScrollBarThickness = 4,
							VerticalScrollBarInset = E.ScrollBarInset.Always,
							Selectable = false,
							column,
						},
						footer,
					}
					local content = Host.Frame "ContentBox" {
						BackgroundTransparency = 1,
						Interactable = false,
						Size = D2.fromScale(1, 1),
					}
					local plate = surfaces.skin(ctx.styled(
						ctx.fade {
							Name = "Expanded",
							GroupTransparency = hidden,
							Active = true,
							BackgroundTransparency = 0,
							ClipsDescendants = true,
							Position = function(use: ComposeTypes.Use)
								local rect = lerp(use)
								return D2.fromOffset(rect.x, rect.y)
							end,
							Size = function(use: ComposeTypes.Use)
								local rect = lerp(use)
								return D2.fromOffset(rect.w, rect.h)
							end,
							fade,
							content,
							ctx.corner(),
						},
						"panel"
					))
					ctx.styled(plate, "floating")
					local plateBox, contentBox = ctx.observe.AbsoluteSize(plate), ctx.observe.AbsoluteSize(content)
					Compose.watch(function(use: ComposeTypes.Use)
						use(plateBox)
						use(contentBox)
						local outer, inner = plate.AbsoluteSize, content.AbsoluteSize
						if inner.X > 0 and inner.Y > 0 then
							chrome:set(outer - inner)
						end
					end)
					surfaces.atRest(function()
						return 0
					end, prepared, { plate, fade, column, footer, content })
					local modal = surfaces.modal(
						function()
							return plate
						end,
						collapse,
						{
							Name = "CollapsibleModal",
							outsideMargin = 0,
							outsideDismiss = spec.outsideDismiss,
							backgroundTransparency = 1,
							initialFocus = spec.initialFocus,
							exiting = if phase then phase.exiting else nil,
							appearance = progress,
						}
					)
					modal:SetAttribute("FacetArrivalGroup", true)
					surfaces.keep(spec.content)
					return modal
				end, {
					presence = {
						exit = function(): ComposeTypes.Exiting
							return { completed = closed }
						end,
					},
				}),
			})
			return root
		end
	)
end
]]></ProtectedString>
							<string name="ScriptGuid">{64C11046-BA70-4927-9340-ABE855A2DDCC}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">nav_collapsible</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">73c8afe78d24b4d30afced1100000487</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="170">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local Inputs = require("./input_types")
local ComposeTypes = require("../vendor/compose/core")
local NavigationProps = require("./navigation_props")
local MenuPanel = require("./nav_menu_panel")

return function(ctx: Types.Context, UI: ControlTypes.Controls, surfaces: Nav.Surfaces)
	local Host, Compose, runtime, read = ctx.Host, ctx.Compose, ctx.runtime, ctx.read
	local readOptions = read<<{ Nav.PickerOption<string> }>>
	local readText = read<<string>>
	local E, D2 = ctx.types.Enum, ctx.types.UDim2
	local menuPanel = MenuPanel(ctx, UI, surfaces)<<string>>
	local function writable(cell: { read set: unknown }, name: string)
		assert(type(cell) == "table" and type(cell.set) == "function", name .. " requires a writable Compose cell")
	end
	UI.ComboBox = ctx.construct("ComboBox", function(spec: NavigationProps.ComboBoxSpec): Frame
		writable(spec.value, "ComboBox.value")
		writable(spec.text, "ComboBox.text")
		assert(type(spec.value:peek()) == "string", "ComboBox.value must be a string")
		assert(type(read(spec.options)) == "table", "ComboBox requires options")
		assert(type(spec.acceptCustom) == "function", "ComboBox requires acceptCustom")
		local errorText = Compose.cell("")
		local alive = true
		Compose.cleanup(function()
			alive = false
		end)
		local opened, editing = Compose.cell(false), Compose.cell(false)
		local navigating = false
		local popup: Frame?
		local gui = surfaces.service("GuiService")
		local function close()
			opened:set(false)
		end
		local function label(value: string): string
			for _, option in readOptions(spec.options) do
				if (option.value or option.id) == value then
					return readText(option.label)
				end
			end
			return value
		end
		local function update(value: string)
			close()
			errorText:set("")
			spec.text:set(label(value))
			if value ~= spec.value:peek() then
				spec.value:set(value)
				if spec.onChange then
					spec.onChange(value)
				end
			end
		end
		local function commit(text: string, reason: Inputs.CommitReason)
			if
				navigating
				or read(spec.enabled) == false
				or (reason == "focusLost" and spec.commitOnFocusLost ~= true)
			then
				return
			end
			for _, option in readOptions(spec.options) do
				if read(option.label) == text then
					if read(option.enabled) == false then
						errorText:set("This option is unavailable.")
					else
						update(option.value or option.id)
					end
					return
				end
			end
			local ok, accepted, message = pcall(spec.acceptCustom, text)
			if not alive or read(spec.enabled) == false then
				return
			end
			if ok and accepted == true then
				update(text)
			else
				errorText:set(message or "This value is not accepted.")
			end
		end
		local function cancel()
			close()
			spec.text:set(label(spec.value:peek()))
			errorText:set("")
		end
		local created = UI.TextInput "Editor" {
			value = spec.text,
			placeholder = spec.placeholder,
			enabled = spec.enabled,
			Size = D2.new(1, -60, 1, 0),
			AutomaticSize = E.AutomaticSize.None,
			onCommit = function(value, reason)
				commit(value, reason)
				if reason == "submit" then
					close()
				end
			end,
			onCancel = cancel,
			onChange = function(value)
				spec.text:set(value)
				opened:set(true)
			end,
			Focused = function()
				editing:set(true)
			end,
			FocusLost = function()
				editing:set(false)
			end,
		}
		assert(created:IsA("TextBox"), "Facet ComboBox: the editor is a TextBox")
		local editor = created

		local function open()
			if read(spec.enabled) ~= false then
				opened:set(true)
			end
		end
		local triggerAttributes: Types.Attributes = { FacetLabel = "Suggestions" }
		local suggestions = Host.Frame "Suggestions" {
			BackgroundTransparency = 1,
			Position = D2.new(1, -56, 0, 0),
			Size = D2.new(0, 56, 1, 0),
			UI.Button "Trigger" {
				label = "",
				icon = "chevron.down",
				enabled = spec.enabled,
				Size = D2.fromScale(1, 1),
				AutomaticSize = E.AutomaticSize.None,
				Attributes = triggerAttributes,
				onActivate = function()
					if opened:peek() then
						close()
					else
						open()
					end
				end,
			},
		}
		local row = Host.Frame "Row" {
			BackgroundTransparency = 1,
			Size = D2.new(1, 0, 0, 44),
			editor,
			suggestions,
		}
		local root = ctx.column(
			{
				row,
				Compose.show(function(use: ComposeTypes.Use)
					return use(errorText) ~= ""
				end, function()
					return ctx.text({ Name = "Validation", Text = errorText, TextWrapped = true, LayoutOrder = 2 })
				end),
			},
			ctx.props(spec, {
				"value",
				"text",
				"options",
				"enabled",
				"acceptCustom",
				"onChange",
				"commitOnFocusLost",
				"placeholder",
			}, {
				Name = "ComboBox",
				Size = D2.new(1, 0, 0, 44),
				AutomaticSize = E.AutomaticSize.Y,
			})
		)
		local available = surfaces.available(root)
		Compose.watch(function(use: ComposeTypes.Use)
			if not use(available) or read(spec.enabled, use) == false then
				close()
			end
		end)
		local choices = function(use: ComposeTypes.Use): { Nav.MenuItem<string> }
			local result: { Nav.MenuItem<string> } = {}
			local query = string.lower(use(spec.text))
			for _, option in readOptions(spec.options, use) do
				if string.find(string.lower(readText(option.label, use)), query, 1, true) then
					local item: Nav.MenuCommand = {
						id = option.id or tostring(option.value),
						label = option.label,
						enabled = option.enabled,
						onSelect = function()
							update(option.value or option.id)
						end,
					}
					table.insert(result, item)
				end
			end
			return result
		end
		surfaces.attach(root, {
			surfaces.overlay(row, function(use: ComposeTypes.Use)
				return use(opened) and #choices(use) > 0
			end, function()
				local menuSpec: NavigationProps.MenuSpec<string> = { items = choices, presentation = "menu" }
				local panel = menuPanel(menuSpec, close, row, true)
				popup = panel
				Compose.cleanup(function()
					if gui and surfaces.within(gui.SelectedObject, panel) then
						gui.SelectedObject = if ctx.available(root) then editor else nil
					end
					popup = nil
				end)
				local input = surfaces.service("UserInputService")
				if input then
					runtime.connect(input, "InputBegan", function(event: InputObject)
						if
							event.UserInputType ~= E.UserInputType.MouseButton1
							and event.UserInputType ~= E.UserInputType.Touch
						then
							return
						end
						local function hit(node: GuiObject): boolean
							local at, size, point = node.AbsolutePosition, node.AbsoluteSize, event.Position
							return point.X >= at.X
								and point.Y >= at.Y
								and point.X <= at.X + size.X
								and point.Y <= at.Y + size.Y
						end
						local menu = panel:FindFirstChild("MenuPanel")
						if not hit(row) and menu and menu:IsA("GuiObject") and not hit(menu) then
							close()
						end
					end)
				end
				return panel
			end),
			Compose.show(function(use: ComposeTypes.Use)
				return use(editing) or use(opened)
			end, function()
				ctx.action(root, "ComboSuggestions", { E.KeyCode.Down, E.KeyCode.DPadDown }, editing, function()
					open()
					local panel = popup
					local target: GuiObject?
					if panel then
						for _, item in Compose.sample(choices) do
							if item.divider ~= true and read(item.enabled) ~= false then
								target = surfaces.firstSelectable(panel, item.id)
								if target then
									break
								end
							end
						end
					end
					if target and gui then
						navigating = true
						editor:ReleaseFocus(false)
						navigating = false
						gui.SelectedObject = target
					end
				end, { priority = 11000 })
				ctx.action(root, "ComboCancel", { E.KeyCode.Escape, E.KeyCode.ButtonB }, opened, function()
					cancel()
					if ctx.available(root) then
						editor:CaptureFocus()
					end
				end, { priority = 11000 })
				return Host.Folder {}
			end),
		})
		return root
	end)
end
]]></ProtectedString>
							<string name="ScriptGuid">{0522ADA4-9B4D-4E47-B0D5-FD7B74BC6B34}</string>
