				return Host.Frame "SkinHost" {
					Size = types.UDim2.fromOffset(0, 0),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					ZIndex = stateOptions.ZIndex or 0,
					createSkin(0),
				}
			end, node)
			place(art :: GuiObject)
		end)
		return nil, nil
	end
end
