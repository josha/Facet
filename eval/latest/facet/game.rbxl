								<UniqueId name="UniqueId">73c8afe78d24b4d30afced110000065d</UniqueId>
							</Properties>
						</Item>
						<Item class="StringValue" referent="641">
							<Properties>
								<string name="Value"><![CDATA[# Picker.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
appearance: ValueString? = omitted
axis: Input<"x" | "y">? = by style
controlSize: Input<("xsmall" | "compact" | "regular" | "large")?>? = omitted
corners: ("pill" | "square")? = omitted
enabled: ValueBoolean? = true
errorText: ValueString? = omitted
hint: ValueString? = omitted
iconOnly: ValueBoolean? = omitted
indicator: Input<("automatic" | "pill" | "underline" | "none")?>? = omitted
indicatorPosition: ("leading" | "trailing")? = omitted
isPresented: Value<boolean>? = cell(false)
label: ValueString? = omitted
maxHeight: number? = 400
multiple: false? | true = false
onChange: ((V) -> ())? | (({ [V]: boolean }) -> ())? = omitted
onChanging: ((V, V) -> boolean?)? | (({ [V]: boolean }, { [V]: boolean }) -> boolean?)? = omitted
options: Input<PickerOptions<V>> = required
placeholder: ValueString? = omitted
query: Value<string>? = omitted
ref: ((GuiObject) -> ())? = omitted
required: boolean? = omitted
requiredMark: ("required" | "optional")? = omitted
selected: Value<V> | Value<{ [V]: boolean }> = required
sizing: Input<"fill" | "hug">? = "fill"
style: ("automatic" | "menu" | "navigationLink" | "segmented" | "inline" | "radioGroup" | "cards")? = "automatic"
textSize: ValueNumber? = omitted
valueAlignment: ("start" | "end")? = omitted
options: Type the list as { Facet.PickerOption<V> }. For a typed example, open Picker.card.
PickerOptions = { read [number]: PickerOption<V> }]]></string>
