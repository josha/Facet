							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Shared = require("./types")
local tag = require("./tag")

return function(ctx: Shared.Context): ((Instance) -> ()) -> ()
	local Compose = ctx.Compose
	local building: string? = nil
	local track: ((Instance) -> ())? = nil
	local metatableOf: (unknown) -> unknown = getmetatable
	local native: { [unknown]: boolean } = {}
	native[metatableOf(Compose.cell(nil))] = true
	native[metatableOf(Compose.sharedCell(nil))] = true
	local probe = Compose.formula(function()
		return nil
	end)
	native[metatableOf(probe)] = true
	probe:dispose()
	local function reject(key: string?)
		local option = if key then ` option '{key}'` else " a value"
		error(
			`Facet UI.{building or "control"}:{option} is a readable from another Compose instance. `
				.. "Facet cannot track it. Bind Facet to that Compose with Facet.bind(Compose, Roblox).",
			0
		)
	end
	local function distance(a: string, b: string): number
		local previous: { number } = {}
		for j = 0, #b do
			previous[j] = j
		end
		for i = 1, #a do
			local current: { number } = { [0] = i }
			for j = 1, #b do
				local cost = if string.byte(a, i) == string.byte(b, j) then 0 else 1
				current[j] = math.min(previous[j] + 1, current[j - 1] + 1, previous[j - 1] + cost)
			end
			previous = current
		end
		return previous[#b]
	end
	local function unknownOption(key: string, known: { [string]: boolean }): string
		if key == "width" or key == "height" then
			return `Facet UI.{building or "control"}: unknown option '{key}'. `
				.. "Use native Size and AutomaticSize on this control, or size its layout container. "
				.. "Read Layout-options for leaf sizing."
		end
		local best: string? = nil
		local bestDistance = 3
		for name in known do
			if name ~= "ref" then
				local d = distance(key, name)
				if d < bestDistance or (d == bestDistance and best ~= nil and name < best) then
					best, bestDistance = name, d
				end
			end
		end
		local suggestion = if best then ` Did you mean '{best}'?` else ""
		return `Facet UI.{building or "control"}: unknown option '{key}'.{suggestion}`
	end
	local consumedSets: { [unknown]: { [string]: boolean } } = setmetatable({}, { __mode = "k" })
	local function consumedFor(behavioralKeys: { string } | { [string]: boolean }?): { [string]: boolean }
		local frozen = behavioralKeys ~= nil and table.isfrozen(behavioralKeys)
		local cached = if frozen then consumedSets[behavioralKeys] else nil
		if cached then
			return cached
		end
		local consumed: { [string]: boolean } = { ref = true }
		for key, value in (behavioralKeys or {}) do
			if type(key) == "number" then
				assert(type(value) == "string")
				consumed[value] = true
			elseif type(key) == "string" then
				consumed[key] = true
			end
		end
		if frozen then
			consumedSets[behavioralKeys] = consumed
		end
		return consumed
	end
	function ctx.props<P>(spec: P, behavioralKeys: { string } | { [string]: boolean }?, defaults: unknown?): P
		local result: { [unknown]: unknown } = if type(defaults) == "table"
			then table.clone(defaults :: { [unknown]: unknown })
			else {}
		local consumed = consumedFor(behavioralKeys)
		local unknown: { string }? = nil
		for key, value in (spec :: unknown) :: { [unknown]: unknown } do
			if type(key) == "number" then
				result[#result + 1] = value
			elseif type(key) ~= "string" or not consumed[key] then
				if type(key) == "string" and string.match(key, "^[a-z]") then
					local list = unknown or {}
					unknown = list
					table.insert(list, key)
				end
				result[key] = value
			end
		end
		if unknown then
			table.sort(unknown)
			local messages: { string } = {}
			for _, key in unknown do
				table.insert(messages, unknownOption(key, consumed))
			end
			error(table.concat(messages, "\n"), 0)
		end
		return (result :: unknown) :: P
	end

	local function strictNow(): boolean
		local mode = ctx.config.buildMode
		if mode then
			return mode.strict
		end
		return ctx.config.strictBuild ~= false
	end
	local function failedControl(control: string, failure: unknown): Instance
		local message = string.sub((string.gsub(tostring(failure), "^[%w%._]+:%d+: ", "")), 1, 400)
		if ctx.config.onError then
			ctx.config.onError(failure)
		elseif task and task.spawn then
			task.spawn(error, `Facet UI.{control} failed to build and shows a placeholder: {message}`, 0)
		end
		local types = ctx.types
		local label = ctx.Host.TextLabel {
			Name = `FacetFailed{control}`,
			Text = `Facet UI.{control} failed: {message}`,
			TextWrapped = true,
			TextXAlignment = types.Enum.TextXAlignment.Left,
			TextSize = 14,
			TextColor3 = types.Color3.new(1, 1, 1),
			BackgroundColor3 = types.Color3.fromRGB(170, 30, 50),
			BackgroundTransparency = 0,
			Size = types.UDim2.new(1, 0, 0, 0),
			AutomaticSize = types.Enum.AutomaticSize.Y,
		}
		label:SetAttribute("FacetError", message)
		return label
	end
	function ctx.build<P, N>(control: string, build: (P) -> N, spec: P?, name: string?): N
		if spec ~= nil and type(spec) ~= "table" then
			error(`Facet UI.{control}: expected a property table, got {typeof(spec)}`, 0)
		end
		local fields = ((spec or {}) :: unknown) :: { [unknown]: unknown }
		if name then
			fields = table.clone(fields)
			assert(fields.Name == nil, "Facet: supply either a constructor name or Name")
			fields.Name = name
		end
		local outer = building
		building = control
		if Compose.currentOwner() == nil then
			building = outer
			error(
				`Facet UI.{control}: no owner from Facet's Compose is active. Build controls inside app.mount or runtime.mount. `
					.. "If the runtime comes from another Compose instance, "
					.. "bind Facet to that instance with Facet.bind(Compose, Roblox).",
				0
			)
		end
		for key, value in fields do
			if type(key) == "string" then
				if Compose.isValue(value) then
					if not native[metatableOf(value)] then
						reject(key)
					end
				elseif type(value) == "table" and metatableOf(value) == nil then
					for _, entry in value do
						if type(entry) == "table" and not Compose.isValue(entry) then
							for field, inner in entry do
								if Compose.isValue(inner) and not native[metatableOf(inner)] then
									reject(`{key}.{tostring(field)}`)
								end
							end
						elseif Compose.isValue(entry) and not native[metatableOf(entry)] then
							reject(key)
						end
					end
				end
			end
		end
		local built, node = pcall(build, (fields :: unknown) :: P)
		building = outer
		if not built then
			if strictNow() then
				error(node, 0)
			end
			node = (failedControl(control, node) :: unknown) :: N
		end
		if track and (type(node) == "userdata" or type(node) == "table") then
			track(node :: Instance)
		end
		if fields.ref then
			assert(type(fields.ref) == "function")
			local ref = fields.ref :: (unknown) -> ()
			ref(node)
		end
		return node
	end
	local function construct<P, N>(control: string, build: (P) -> N)
		return function(spec: P | string, name: string?)
			if type(spec) == "string" then
				return function(fields: P): N
					return ctx.build(control, build, fields, spec)
				end
			end
			return ctx.build(control, build, spec, name)
		end
	end
	ctx.construct = (construct :: unknown) :: typeof(ctx.construct)
	ctx.styled = tag
	return function(tracker: (Instance) -> ())
		track = tracker
	end
end
]]></ProtectedString>
							<string name="ScriptGuid">{CF8A742D-E588-4F87-B992-C0C28CCC4E31}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">context_construct</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">73c8afe78d24b4d30afced1100000426</UniqueId>
