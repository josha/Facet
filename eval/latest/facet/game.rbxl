					<Item class="ModuleScript" referent="17">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Types = require("./types")

export type CameraPose = { focus: Vector3, yaw: number, pitch: number, distance: number }
export type CameraRigOptions = {
	inputRoot: PlayerGui,
	initial: CameraPose,
	focusBounds: { min: Vector3, max: Vector3 },
	yawBounds: Vector2?,
	pitchBounds: Vector2?,
	distanceBounds: Vector2,
	presets: { [string]: CameraPose }?,
	enabled: Types.Input<boolean>?,
	blocked: Types.Input<boolean>?,
	smoothing: boolean?,
	inertia: boolean?,
	orbitSensitivity: number?,
	panSensitivity: number?,
	orbitSpeed: number?,
	zoomSpeed: number?,
}
export type CameraRig = {
	camera: Types.ReadOnlyValue<CFrame>,
	state: Types.ReadOnlyValue<CameraPose>,
	focus: Types.Value<Vector3>,
	preset: Types.Value<string?>,
	reset: () -> (),
}
return {}
]]></ProtectedString>
							<string name="ScriptGuid">{231527FF-7E17-4E5F-8F1C-DCDC5E5A4E75}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">camera_rig_types</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">73c8afe78d24b4d30afced11000003ef</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="18">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Types = require("./types")
local ComposeTypes = require("../vendor/compose/core")
local Content = require("./content_types")
local MediaProps = require("./media_props")
local values = require("./content_values")
local parts = require("./overlay_parts")
local ContentProps = require("./content_props")
local ControlTypes = require("./control_types")
local InputProps = require("./input_props")
local reducedMotion = require("./motion").reduced
local feedbackPaint = require("./feedback_paint")

local ACTION_KEYS: { [string]: boolean } = { label = true, icon = true, onActivate = true, enabled = true, busy = true }
local MENU_KEYS: { [string]: boolean } = { items = true, label = true }
local BADGE_KEYS: { [string]: boolean } = { label = true, status = true, icon = true, name = true }
local CORNER_KEYS: { [string]: boolean } = { leading = true, trailing = true }

return function(ctx: Types.Context, UI: ControlTypes.Controls): ()
	local Host, Compose, read, runtime = ctx.Host, ctx.Compose, ctx.read, ctx.runtime
	local E, D2, D = ctx.types.Enum, ctx.types.UDim2, ctx.types.UDim
	local inactive = Compose.cell(false)
	local active = Compose.cell(true)
	local full = Compose.cell(1)
	local unselected = Compose.cell<<GuiObject?>>(nil)
	local noActions: ComposeTypes.Value<{ ComposeTypes.ReadOnlyValue<boolean> }> = Compose.cell({})
	local function nonempty(value: unknown): boolean
		return type(value) == "string" and string.find(value, "%S") ~= nil
	end
	local function text(value: unknown): boolean
		return type(value) == "string"
	end
	local function within(node: Instance?, ancestor: Instance): boolean
		return node ~= nil and (node == ancestor or node:IsDescendantOf(ancestor))
	end
	local function fields(value: unknown, known: { [string]: boolean }, name: string)
		assert(type(value) == "table", `Facet UI.Card: {name} must be a table`)
		for key in value do
			assert(
				type(key) == "string" and known[key],
				`Facet UI.Card: {name} has the unknown field '{tostring(key)}'`
			)
		end
	end

	UI.Card = ctx.construct("Card", function(spec: ContentProps.CardSpec): Frame
		assert(
			spec.artwork == nil or type(spec.artwork) == "function",
			"Facet UI.Card: artwork must be a function that returns a GuiObject"
		)
		assert(spec.image == nil or nonempty(read(spec.image)), "Facet UI.Card: image must be a nonempty image string")
		local media = spec.image ~= nil or spec.artwork ~= nil
		assert(nonempty(read(spec.title)), "Facet UI.Card: title is required: a nonempty string")
		assert(spec.caption == nil or text(read(spec.caption)), "Facet UI.Card: caption must be a string")
		local ratio = spec.imageAspectRatio or 16 / 9
		assert(
			type(ratio) == "number" and ratio > 0 and ratio < math.huge,
			"Facet UI.Card: imageAspectRatio must be a positive finite number"
		)
		assert(
			spec.imageFraming == nil or spec.imageFraming == "fit" or spec.imageFraming == "crop",
			"Facet UI.Card: imageFraming must be fit or crop"
		)
		assert(
			spec.ringTarget == nil or spec.ringTarget == "card" or spec.ringTarget == "media",
			"Facet UI.Card: ringTarget must be card or media"
		)
		local reveal = spec.reveal or "automatic"
		assert(reveal == "automatic" or reveal == "always", "Facet UI.Card: reveal must be automatic or always")
		assert(
			spec.onActivate == nil or type(spec.onActivate) == "function",
			"Facet UI.Card: onActivate must be a function"
		)
		assert(
			spec.browseTarget == nil or type(spec.browseTarget) == "function",
			"Facet UI.Card: browseTarget must be a function that returns the browse stop"
		)
		local primary = spec.primaryAction
		if primary ~= nil then
			fields(primary, ACTION_KEYS, "primaryAction")
			assert(nonempty(read(primary.label)), "Facet UI.Card: primaryAction.label must be a nonempty string")
			assert(type(primary.onActivate) == "function", "Facet UI.Card: primaryAction.onActivate is required")
		end
		local menu = spec.menu
		if menu ~= nil then
			fields(menu, MENU_KEYS, "menu")
			assert(menu.items ~= nil, "Facet UI.Card: menu.items is required")
		end
		local revealing = primary ~= nil or menu ~= nil
		local badges = spec.badges
		if badges ~= nil then
			fields(badges, CORNER_KEYS, "badges")
			assert(media, "Facet UI.Card: badges need image or artwork")
			local function checkBadge(corner: string, badge: Content.CardBadge?)
				if badge == nil then
					return
				end
				fields(badge, BADGE_KEYS, `badges.{corner}`)
				assert(
					badge.label ~= nil or (badge.icon ~= nil and nonempty(badge.name)),
					`Facet UI.Card: badges.{corner} needs a label, or an icon and a name`
				)
			end
			checkBadge("leading", badges.leading)
			checkBadge("trailing", badges.trailing)
		end
		local checks = values(ctx, "Card")
		local title = if type(spec.title) == "string"
			then spec.title
			else checks.legal<<string>>("title", spec.title, nonempty, "must be a nonempty string")
		local image = if spec.image == nil
			then ""
			elseif type(spec.image) == "string" then spec.image
			else checks.legal<<string>>("image", spec.image, nonempty, "must be a nonempty image string")
		local caption = if spec.caption == nil
			then ""
			elseif type(spec.caption) == "string" then spec.caption
			else checks.legal<<string>>("caption", spec.caption, text, "must be a string")
		local enabled = function(use: ComposeTypes.Use?): boolean
			return read(spec.enabled, use) ~= false
		end
		local gui = ctx.config.services.GuiService
		local input = ctx.config.services.UserInputService
		local selected: ComposeTypes.ReadOnlyValue<GuiObject?> = if gui
			then ctx.observe.SelectedObject(gui)
			else unselected
		local touchEnabled = if input then ctx.observe.TouchEnabled(input) else inactive
		local preferred = if input then ctx.observe.PreferredInput(input) else nil
		local function prefersTouch(use: ComposeTypes.Use): boolean
			return preferred ~= nil and use(preferred) == E.PreferredInput.Touch
		end
		local hovered = Compose.cell(false)
		local entered, menuOpen =
			if revealing then Compose.cell(false) else inactive, if menu then Compose.cell(false) else inactive
		local pressingBody = if spec.onActivate then Compose.cell(false) else inactive
		local reduced = reducedMotion(ctx)
		local root: Frame? = nil
		local primaryButton: GuiObject?
		local moreTrigger: GuiObject?
		local actionStates = if revealing then Compose.cell({}) else noActions
		local function holding(button: GuiObject): ComposeTypes.ReadOnlyValue<boolean>
			local down = Compose.cell(false)
			local state = ctx.observe.GuiState(button)
			local function pointer(input: InputObject): boolean
				return input.UserInputType == E.UserInputType.MouseButton1
					or input.UserInputType == E.UserInputType.Touch
			end
			runtime.connect(button, "InputBegan", function(input: InputObject)
				if pointer(input) then
					down:set(true)
				end
			end)
			runtime.connect(button, "InputEnded", function(input: InputObject)
				if pointer(input) then
					down:set(false)
				end
			end)
			return Compose.formula(function(use: ComposeTypes.Use): boolean
				return use(down) or use(state) == E.GuiState.Press
			end)
		end
		local hasStop = spec.onActivate ~= nil or spec.browseTarget ~= nil
		local focusWithin = if not gui
			then inactive
			else Compose.formula(function(use: ComposeTypes.Use): boolean
				local node, card = use(selected), root
				return node ~= nil and card ~= nil and within(node, card)
			end)
		local browsing = if not spec.browseTarget
			then inactive
			else Compose.formula(function(use: ComposeTypes.Use): boolean
				local node = use(selected)
				local target: Instance? = if spec.browseTarget then spec.browseTarget() else nil
				return node ~= nil and target ~= nil and node == target
			end)
		local pressing = if not revealing
			then pressingBody
			else Compose.formula(function(use: ComposeTypes.Use): boolean
				if use(pressingBody) then
					return true
				end
				for _, state in use(actionStates) do
					if use(state) then
						return true
					end
				end
				return false
			end)
		local engaged = Compose.formula(function(use: ComposeTypes.Use): boolean
			return use(hovered) or use(focusWithin) or use(pressing) or use(menuOpen) or use(entered) or use(browsing)
		end)
		local touch = function(use: ComposeTypes.Use): boolean
			return use(touchEnabled) == true or prefersTouch(use)
		end
		local inFlow = function(use: ComposeTypes.Use): boolean
			return reveal == "always" or touch(use)
		end
		local revealed = if reveal == "always" or not hasStop
			then active
			else Compose.formula(function(use: ComposeTypes.Use): boolean
				return touch(use) or use(engaged)
			end)
		local lifting = Compose.formula(function(use: ComposeTypes.Use): boolean
			if prefersTouch(use) then
				return false
			end
			return use(engaged)
		end)
		local liftSpring = ctx.motionSpring("snappy")
		local spring = runtime.spring(function(use: ComposeTypes.Use)
			return if use(lifting) then ctx.metric("motion.materialize.lift", use) else 1
		end, { period = liftSpring.period, damping = liftSpring.damping })
		local scale = Compose.formula(function(use: ComposeTypes.Use): number
			return if reduced(use) then 1 else use(spring)
		end)
		local fade = if reveal == "always" or not hasStop
			then full
			else runtime.tween(function(use: ComposeTypes.Use)
				return if use(revealed) then 1 else 0
			end, { seconds = ctx.metric("motion.durations.cardFade") })
		local function enterActions(): boolean
			local card = root
			if not enabled() or card == nil or card.Parent == nil then
				return false
			end
			local first = if primaryButton
					and primary
					and read(primary.enabled) ~= false
					and read(primary.busy) ~= true
				then primaryButton
				else moreTrigger
			if first == nil then
				return false
			end
			entered:set(true)
			if gui then
				gui.SelectedObject = first
			end
			return true
		end
		local function leaveActions()
			if not entered:peek() then
				return
			end
			entered:set(false)
			if gui and root and within(gui.SelectedObject, root) then
				local target = if spec.browseTarget then spec.browseTarget() else nil
				if target and target.Parent then
					gui.SelectedObject = target
				elseif root.Parent then
					local body = root:FindFirstChild("Body")
					if body and body:IsA("GuiObject") and body.Selectable then
						gui.SelectedObject = body
					end
				end
			end
		end
		if spec.controls then
			spec.controls.enterActions = enterActions
			spec.controls.leaveActions = leaveActions
			spec.controls.engaged = engaged
			spec.controls.revealed = revealed
			spec.controls.scale = scale
			spec.controls.lifting = lifting
			spec.controls.diagnostics = checks.list
		end
		local badgeLayer: Frame? = nil
		local moved = function(_: ComposeTypes.Use): { string }
			return {}
		end
		if badges then
			local function gap(use: ComposeTypes.Use): UDim
				return D.new(0, ctx.metric("space.s", use))
			end
			local layerProps: Types.FrameProps = {
				Name = "Badges",
				BackgroundTransparency = 1,
				Size = D2.fromScale(1, 1),
				ZIndex = 2,
				Host.UIPadding { PaddingLeft = gap, PaddingRight = gap, PaddingTop = gap, PaddingBottom = gap },
			}
			local widths: { [string]: ComposeTypes.Value<number> } =
				{ Leading = Compose.cell(0), Trailing = Compose.cell(0) }
			local onArt: { [string]: ComposeTypes.Value<boolean> } =
				{ Leading = Compose.cell(true), Trailing = Compose.cell(true) }
			local function corner(name: string, badge: Content.CardBadge?, x: number)
				if badge == nil then
					return
				end
				local label = badge.label
				local last = ""
				local function marked(use: ComposeTypes.Use): boolean
					return badge.name ~= nil and nonempty(read(badge.icon, use))
				end
				local shown = function(use: ComposeTypes.Use): boolean
					return label == nil or nonempty(read(label, use)) or marked(use)
				end
				local props: MediaProps.BadgeProps = {
					label = function(use: ComposeTypes.Use): string?
						local value = read<<string?>>(label, use)
						if type(value) == "string" and nonempty(value) then
							last = value
						elseif marked(use) then
							return nil
						end
						return if label == nil then nil else last
					end,
					status = badge.status,
					icon = badge.icon,
					name = badge.name,
					Visible = onArt[name],
				}
				local holder: Types.FrameNativeProps = {
					Name = name,
					BackgroundTransparency = 1,
					AnchorPoint = ctx.types.Vector2.new(x, 0),
					Position = D2.fromScale(x, 0),
					Size = D2.fromOffset(0, 0),
					AutomaticSize = E.AutomaticSize.XY,
					Compose.show(shown, function()
						local pill = UI.Badge(props)
						pill:AddTag("facet-badge-on-media")
						local size = ctx.observe.AbsoluteSize(pill)
						Compose.watch(function(use: ComposeTypes.Use)
							widths[name]:set(use(size).X)
						end)
						Compose.cleanup(function()
							widths[name]:set(0)
						end)
						return pill
					end),
				}
				layerProps[#layerProps + 1] = Host.Frame(holder)
			end
			corner("Leading", badges.leading, 0)
			corner("Trailing", badges.trailing, 1)
			local trailingLabel = if badges.trailing then badges.trailing.label else nil
			local leadingLabel = if badges.leading then badges.leading.label else nil
			moved = function(use: ComposeTypes.Use): { string }
				local list: { string } = {}
				local function add(name: string, label: Content.Input<string?>?)
					local value = read<<string?>>(label, use)
					if not use(onArt[name]) and type(value) == "string" and nonempty(value) then
						table.insert(list, value)
					end
				end
				add("Trailing", trailingLabel)
				add("Leading", leadingLabel)
				return list
			end
			local badgeArea = Host.Frame(layerProps)
			local area, unit = ctx.observe.AbsoluteSize(badgeArea), ctx.layoutUnit(badgeArea)
			Compose.watch(function(use: ComposeTypes.Use)
				local leading, trailing = use(widths.Leading), use(widths.Trailing)
				local room = use(area).X
				local space = ctx.metric("space.s", use) * use(unit)
				local function alone(width: number): boolean
					return width <= 0 or room <= 0 or width + 2 * space <= room
				end
				local keepsTrailing = alone(trailing)
				onArt.Trailing:set(keepsTrailing)
				onArt.Leading:set(
					if keepsTrailing and trailing > 0
						then leading <= 0 or room <= 0 or leading + trailing + 3 * space <= room
						else alone(leading)
				)
			end)
			badgeLayer = badgeArea
		end
		local artwork = Host.ImageLabel {
			Name = "Artwork",
			LayoutOrder = 1,
			BackgroundTransparency = 1,
			Image = image,
			Visible = media,
			Size = if media then D2.new(1, 0, 0, 100000) else D2.new(1, 0, 0, 0),
			ScaleType = if spec.imageFraming == "fit" then E.ScaleType.Fit else E.ScaleType.Crop,
			Host.UIAspectRatioConstraint {
				AspectRatio = ratio,
				AspectType = E.AspectType.FitWithinMaxSize,
				DominantAxis = E.DominantAxis.Width,
			},
		}
		if badgeLayer then
			badgeLayer.Parent = artwork
		end
		if spec.artwork then
			local build = spec.artwork
			runtime.mount(function()
				local live = build()
				assert(parts.instance(live) and live:IsA("GuiObject"), "Facet UI.Card: artwork must return a GuiObject")
				runtime.decorate(live, { Size = D2.fromScale(1, 1) })
				return live
			end, artwork)
		end
		local subtitle: Types.Input<string> = if not badges
			then caption
			else function(use: ComposeTypes.Use): string
				local rest = read<<string>>(caption, use)
				local parts: { string } = {}
				for _, label in moved(use) do
					if not string.find(string.lower(rest), string.lower(label), 1, true) then
						table.insert(parts, label)
					end
				end
				if rest ~= "" then
					table.insert(parts, rest)
				end
				return table.concat(parts, " · ")
			end
		local function closing(use: ComposeTypes.Use): UDim
			return D.new(
				0,
				if media
						and read<<string>>(subtitle, use) == ""
						and (not revealing or not inFlow(use))
					then ctx.metric("space.s", use)
					else 0
			)
		end
		local function inset(bottom: boolean): UIPadding
			local function side(use: ComposeTypes.Use): UDim
				return D.new(0, ctx.metric("space.s", use))
			end
			return Host.UIPadding {
				PaddingLeft = side,
				PaddingRight = side,
				PaddingTop = if media or bottom then nil else side,
				PaddingBottom = if bottom then side else closing,
			}
		end
		local titleLabel = ctx.text({
			Name = "Title",
			LayoutOrder = 2,
			Text = title,
			Size = D2.fromScale(1, 0),
			AutomaticSize = E.AutomaticSize.Y,
			TextWrapped = true,
			inset(false),
		})
		titleLabel:AddTag("facet-type-label")
		local captionLabel: TextLabel?
		if spec.caption ~= nil or badges ~= nil then
			local label = ctx.text({
				Name = "Caption",
				LayoutOrder = 3,
				Text = subtitle,
				Visible = if type(subtitle) == "string"
					then subtitle ~= ""
					else function(use: ComposeTypes.Use): boolean
						return read<<string>>(subtitle, use) ~= ""
					end,
				Size = D2.fromScale(1, 0),
				AutomaticSize = E.AutomaticSize.Y,
				TextWrapped = true,
				inset(true),
			})
			label:AddTag("facet-type-caption")
			label:AddTag("facet-secondary")
			captionLabel = label
		end
		local bodyChildren: { Types.Child } = {
			Host.UIPadding {
				PaddingLeft = D.new(0, 0),
				PaddingRight = D.new(0, 0),
				PaddingTop = D.new(0, 0),
				PaddingBottom = D.new(0, 0),
			},
			Host.UIListLayout {
				FillDirection = E.FillDirection.Vertical,
				SortOrder = E.SortOrder.LayoutOrder,
				Padding = function(use: ComposeTypes.Use)
					return D.new(0, ctx.metric("space.xs", use))
				end,
			},
			artwork,
			titleLabel,
		}
		if captionLabel then
			table.insert(bodyChildren, captionLabel)
		end
		local body: GuiObject
		if spec.onActivate then
			local onActivate = spec.onActivate
			local props: InputProps.ButtonProps = {
				Name = "Body",
				LayoutOrder = 1,
				label = "",
				name = title,
				Size = D2.fromScale(1, 0),
				AutomaticSize = E.AutomaticSize.Y,
				enabled = enabled,
				onActivate = function(input: InputObject?)
					onActivate(input)
				end,
				onPointerDown = function()
					pressingBody:set(true)
				end,
				onPointerUp = function()
					pressingBody:set(false)
				end,
				onPointerCancel = function()
					pressingBody:set(false)
				end,
			}
			for _, child in bodyChildren do
				props[#props + 1] = child
			end
			local button = UI.Button(props)
			button:AddTag("facet-panel")
			body = button
			runtime.mount(function()
				return Host.UIShadow {
					Name = "LiftShadow",
					Enabled = lifting,
				}
			end, button)
		else
			local props: Types.FrameProps = {
				Name = "Body",
				LayoutOrder = 1,
				Size = D2.fromScale(1, 0),
				AutomaticSize = E.AutomaticSize.Y,
				Attributes = {
					label = title,
				},
			}
			for _, child in bodyChildren do
				props[#props + 1] = child
			end
			body = ctx.styled(Host.Frame(props), "panel")
		end
		ctx.styled<<GuiObject>>(body, "card-body")
		body:AddTag("facet-card-part")
		local actionEnabled = function(use: ComposeTypes.Use?): boolean
			return enabled(use) and ctx.readSource(revealed, use)
		end
		local function tuck(use: ComposeTypes.Use): number
			return 2 * ctx.metric("radii.panel", use)
		end
		local function actionRow(flowing: boolean): Frame
			local rowChildren: { Types.Child } = {}
			local states: { ComposeTypes.ReadOnlyValue<boolean> } = {}
			if primary then
				local action = primary
				local buttonProps: InputProps.ButtonPropsInput = {
					Name = "Primary",
					LayoutOrder = 1,
					label = action.label,
					icon = action.icon,
					appearance = "emphasis",
					busy = action.busy,
					enabled = function(use: ComposeTypes.Use): boolean
						return enabled(use) and read(action.enabled, use) ~= false
					end,
					onActivate = function()
						if actionEnabled() then
							action.onActivate()
						end
					end,
					Host.UIFlexItem { FlexMode = E.UIFlexMode.Fill },
				}
				local button = UI.Button(buttonProps)
				primaryButton = button
				table.insert(states, holding(button))
				table.insert(rowChildren, button)
			end
			if menu then
				local more = UI.Menu {
					Name = "More",
					LayoutOrder = 2,
					trigger = UI.Button { label = "", name = menu.label or "More", icon = "more", enabled = enabled },
					items = menu.items,
					isPresented = menuOpen,
					enabled = enabled,
				}
				moreTrigger = more
				table.insert(states, holding(more))
				table.insert(rowChildren, more)
			end
			actionStates:set(states)
			Compose.cleanup(function()
				primaryButton, moreTrigger = nil, nil
				actionStates:set({})
			end)
			local function selectionBehavior(use: ComposeTypes.Use): Enum.SelectionBehavior
				return if use(entered) then E.SelectionBehavior.Stop else E.SelectionBehavior.Escape
			end
			local rowProps: Types.FrameProps = {
				Name = "Row",
				BackgroundTransparency = 1,
				Size = D2.fromScale(1, 0),
				AutomaticSize = E.AutomaticSize.Y,
				SelectionGroup = true,
				SelectionBehaviorUp = selectionBehavior,
				SelectionBehaviorDown = selectionBehavior,
				SelectionBehaviorLeft = selectionBehavior,
				SelectionBehaviorRight = selectionBehavior,
				Host.UIListLayout {
					FillDirection = E.FillDirection.Horizontal,
					SortOrder = E.SortOrder.LayoutOrder,
					VerticalAlignment = E.VerticalAlignment.Center,
					Padding = function(use: ComposeTypes.Use)
						return D.new(0, ctx.metric("space.s", use))
					end,
				},
			}
			for _, child in rowChildren do
				rowProps[#rowProps + 1] = child
			end
			rowProps.ZIndex = 2
			if reveal == "automatic" then
				local function side(use: ComposeTypes.Use): UDim
					return D.new(0, ctx.metric("space.s", use))
				end
				rowProps[#rowProps + 1] = Host.UIPadding {
					PaddingLeft = side,
					PaddingRight = side,
					PaddingTop = function(use: ComposeTypes.Use): UDim
						return D.new(0, ctx.metric("space.s", use) + tuck(use))
					end,
					PaddingBottom = side,
				}
			end
			local row = Host.Frame(rowProps)
			local plateLayer = ctx.styled(
				Host.Frame {
					Name = "Plate",
					Size = D2.fromScale(1, 1),
					Visible = reveal == "automatic",
				},
				"panel"
			)
			plateLayer:AddTag("facet-card-part")
			if flowing then
				plateLayer:AddTag("facet-card-inflow")
			end
			return ctx.fade {
				Name = "Reveal",
				LayoutOrder = 2,
				AnchorPoint = ctx.types.Vector2.new(0, if flowing then 0 else 1),
				Position = D2.fromScale(0, if flowing then 0 else 1),
				ZIndex = if flowing then 0 else 2,
				BackgroundTransparency = 1,
				Size = D2.fromScale(1, 0),
				AutomaticSize = E.AutomaticSize.Y,
				Interactable = revealed,
				GroupTransparency = function(use: ComposeTypes.Use): number
					if reduced(use) then
						return if use(revealed) then 0 else 1
					end
					return 1 - use(fade)
				end,
				plateLayer,
				row,
			}
		end
		local function inLayout(): boolean
			local parent = root and root.Parent
			return parent ~= nil and parent:FindFirstChildWhichIsA("UIGridStyleLayout") ~= nil
		end
		local liftScale = Host.UIScale {
			Name = "Lift",
			Scale = function(use: ComposeTypes.Use): number
				local factor = use(scale)
				return if inLayout() then 1 else factor
			end,
		}
		local layout = Host.UIListLayout {
			FillDirection = E.FillDirection.Vertical,
			SortOrder = E.SortOrder.LayoutOrder,
			Padding = function(use: ComposeTypes.Use)
				return D.new(0, if reveal == "always" then ctx.metric("space.s", use) else -tuck(use))
			end,
		}
		local actions = if revealing
			then Compose.show(inFlow, function()
				return actionRow(true)
			end, function()
				return Host.Folder "ActionOverlay" { actionRow(false) }
			end)
			else nil
		local card = Host.Frame(ctx.props(spec, {
			"image",
			"artwork",
			"title",
			"caption",
			"imageAspectRatio",
			"imageFraming",
			"onActivate",
			"primaryAction",
			"menu",
			"reveal",
			"browseTarget",
			"enabled",
			"controls",
			"ringTarget",
			"badges",
		}, {
			Name = "Card",
			BackgroundTransparency = if media then 1 else nil,
			Size = D2.fromScale(1, 0),
			AutomaticSize = E.AutomaticSize.Y,
			MouseEnter = function()
				hovered:set(true)
			end,
			MouseLeave = function()
				hovered:set(false)
			end,
			Attributes = {
				FacetReveal = reveal,
				FacetRevealed = if reveal == "always" or not hasStop then true else revealed,
				FacetEngaged = engaged,
				FacetLifting = lifting,
				FacetHovered = hovered,
				FacetFocusWithin = if gui then focusWithin else false,
				FacetPressing = if spec.onActivate or revealing then pressing else false,
				FacetBrowsing = if spec.browseTarget then browsing else false,
				FacetEntered = if revealing then entered else false,
				FacetMenuOpen = if menu then menuOpen else false,
				FacetBody = if spec.onActivate then "button" else "informational",
			},
			layout,
			body,
			liftScale,
			Compose.show(function(use: ComposeTypes.Use): boolean
				local active = use(lifting) or use(scale) ~= 1
				return active and not reduced(use) and inLayout()
			end, function()
				feedbackPaint(
					ctx,
					assert(root),
					Host.UIScale { Name = "PaintLift", Scale = scale },
					{ Size = spec.Size, AutomaticSize = spec.AutomaticSize or E.AutomaticSize.Y, reflow = true }
				)
				return Compose.fragment(function(): { ComposeTypes.Node }
					return {}
				end)
			end),
			actions,
		}))
		if not media then
			ctx.styled(card, "panel")
			card:AddTag("facet-card-text")
			Host.UIPadding { Parent = Compose.static(card) }
		end
		root = card
		local extent: ComposeTypes.ReadOnlyValue<Vector2>? = if spec.onActivate or spec.controls
			then ctx.observe.AbsoluteSize(card)
			else nil
		if spec.onActivate then
			local bodyExtent = ctx.observe.AbsoluteSize(body)
			local ringed = if spec.ringTarget == "media" then ctx.observe.AbsoluteSize(artwork) else assert(extent)
			local ratio = Compose.formula(function(use: ComposeTypes.Use): number
				local bodyHeight = use(bodyExtent).Y
				return if bodyHeight > 0 then use(ringed).Y / bodyHeight else 1
			end)
			Compose.watch(function(use: ComposeTypes.Use)
				body:SetAttribute("FacetFocusHeight", use(ratio))
			end)
		end
		if spec.Position == nil then
			runtime.decorate(card, {
				AnchorPoint = function(use: ComposeTypes.Use): Vector2
					local factor = math.max(use(scale), 0.001)
					local anchor = read<<Vector2?>>(spec.AnchorPoint, use) or ctx.types.Vector2.new(0, 0)
					local growth = (1 - 1 / factor) / 2
					return if inLayout() then anchor else anchor + ctx.types.Vector2.new(growth, growth)
				end,
			})
		end
		if spec.controls then
			local measured = assert(extent)
			spec.controls.revealExtent = Compose.formula(function(use: ComposeTypes.Use): { body: number }
				return { body = use(measured).Y }
			end)
		end
		if spec.browseTarget then
			local browseTarget = spec.browseTarget
			local attachedTo: Instance? = nil
			local stopScale: (() -> ())? = nil
			Compose.watch(function(use: ComposeTypes.Use)
				use(selected)
				local target = browseTarget()
				if target == attachedTo then
					return
				end
				if stopScale then
					stopScale()
					stopScale = nil
				end
				attachedTo = target
				if target then
					stopScale = runtime.mount(function()
						return Host.UIScale { Name = "CardLift", Scale = scale }
					end, target)
				end
			end)
			Compose.cleanup(function()
				if stopScale then
					stopScale()
				end
			end)
		end
		if revealing then
			Compose.watch(function(use: ComposeTypes.Use)
				if not enabled(use) and entered:peek() then
					leaveActions()
				end
			end)
			Compose.watch(function(use: ComposeTypes.Use)
				local node = use(selected)
				if entered:peek() and not menuOpen:peek() and node ~= nil and not within(node, card) then
					entered:set(false)
				end
			end)
			ctx.action(card, "CardCancel", { E.KeyCode.Escape, E.KeyCode.ButtonB }, function(use: ComposeTypes.Use)
				return use(entered) and not use(menuOpen)
			end, leaveActions, { priority = 1500 })
			if input then
				runtime.connect(input, "InputBegan", function(event: InputObject)
					if not entered:peek() or menuOpen:peek() then
						return
					end
					if
						event.UserInputType ~= E.UserInputType.MouseButton1
						and event.UserInputType ~= E.UserInputType.Touch
					then
						return
					end
					local at, size, point = card.AbsolutePosition, card.AbsoluteSize, event.Position
					if point.X < at.X or point.Y < at.Y or point.X > at.X + size.X or point.Y > at.Y + size.Y then
						entered:set(false)
					end
				end)
			end
			Compose.cleanup(function()
				if entered:peek() and gui and within(gui.SelectedObject, card) then
					entered:set(false)
					local target = if spec.browseTarget then spec.browseTarget() else nil
					gui.SelectedObject = if target and target.Parent and not within(target, card) then target else nil
				end
			end)
		end
		return card
	end)
end
]]></ProtectedString>
