							<ProtectedString name="Source"><![CDATA[--!strict
local Types = require("./types")

export type Input<T> = Types.Input<T>

export type Rect = { x: number, y: number, w: number, h: number }
export type ScaleMode = "fit" | "crop" | "stretch"
export type Media = {
	image: string,
	aspectRatio: number?,
	height: (number | string)?,
	scaleMode: ScaleMode?,
	background: Input<Color3>?,
}
export type Hero = {
	read image: string?,
	read content: (Instance | (() -> Instance))?,
	read aspectRatio: number?,
	read height: (number | string)?,
	read scaleMode: ScaleMode?,
	read background: Input<Color3>?,
	read sticky: boolean?,
}
export type ActionRole = "default" | "cancel" | "destructive"
export type Action = {
	read id: string,
	read label: Types.ValueString,
	read role: ActionRole?,
	read enabled: Types.ValueBoolean?,
	read busy: Types.ValueBoolean?,
	read onActivate: () -> (),
}
export type DialogAction = {
	read id: string,
	read label: Types.ValueString,
	read role: ActionRole?,
	read enabled: Types.ValueBoolean?,
	read busy: Types.ValueBoolean?,
	read keepOpen: boolean?,
	read onActivate: () -> (),
}
export type ActionLayout = "automatic" | "row" | "stacked"
export type WidthPreset = "automatic" | "narrow" | "wide"
export type Edge = "top" | "bottom" | "leading" | "trailing"
export type Align = "start" | "center" | "end"

export type DialogDismissReason = "close" | "outside" | "cancel" | "action"
export type DialogOptions = {
	isPresented: Types.ValueBoolean,
	onPresentedChange: ((boolean) -> ())?,
	onDismiss: ((DialogDismissReason) -> ())?,
	title: Types.ValueString?,
	content: (() -> Instance)?,
	hero: Media?,
	actionLabel: Types.ValueString?,
	actions: { DialogAction }?,
	actionLayout: Input<ActionLayout?>?,
	closeButton: boolean?,
	width: Input<WidthPreset?>?,
	contentSelectable: boolean?,
}

export type PopoverDismissReason = "cancel" | "outside" | "trigger" | "anchorLost"
export type PopoverSource = { node: GuiObject } | { rect: Rect }
export type PopoverOptions = {
	closeButton: boolean?,
	isPresented: Types.ValueBoolean,
	onPresentedChange: ((boolean) -> ())?,
	onDismiss: ((PopoverDismissReason) -> ())?,
	trigger: Types.GuiButtonInstance?,
	source: PopoverSource?,
	content: () -> Instance,
	edge: Edge?,
	align: Align?,
	gap: number?,
	crossOffset: number?,
	tail: boolean?,
	maxWidth: number?,
	maxHeight: number?,
	compact: ("sheet" | "popover")?,
	title: Types.ValueString?,
	modal: boolean?,
	cancelPolicy: ("dismiss" | "none")?,
}

export type NoticeSeverity = "info" | "success" | "warning" | "error"
export type NoticeOptions = {
	message: Types.ValueString,
	title: Types.ValueString?,
	severity: NoticeSeverity?,
	appearance: ("standard" | "emphasis")?,
	placement: ("inline" | "affixed")?,
	icon: (boolean | string)?,
	link: { read label: Types.ValueString, read onActivate: () -> () }?,
	actions: { Action }?,
	onDismiss: (() -> ())?,
	controlSize: Input<Types.ControlSize?>?,
}

export type NavBarOptions = {
	onBack: ((() -> ()) | Types.Value<boolean>)?,
	backLabel: string?,
	title: Types.ValueString?,
	titleSize: string?,
	leading: GuiObject?,
	center: GuiObject?,
	trailing: GuiObject?,
	gap: number?,
	padding: number?,
	surface: ("surface" | "panel" | "pane")?,
}

export type ToastDismissReason =
	"timeout"
	| "supersede"
	| "preempt"
	| "capacity"
	| "manual"
	| "action"
	| "close"
	| "cancel"
export type ToastAction = { read label: Types.ValueString, read onActivate: () -> () }
export type ToastOptions = {
	message: Types.ValueString?,
	content: (() -> Instance)?,
	icon: string?,
	action: ToastAction?,
	closeButton: boolean?,
	isPresented: Types.ValueBoolean?,
	onPresentedChange: ((boolean) -> ())?,
	key: string?,
	priority: number?,
	duration: number?,
	readFloor: number?,
	position: ("top" | "bottom")?,
	width: ("fill" | "hug")?,
	fade: boolean?,
	onDismiss: ((ToastDismissReason) -> ())?,
}

return {}
