						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Quick chat wheel: eight preset messages, five-second cooldown kept across openings.
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local Remotes = game.ReplicatedStorage:WaitForChild("Remotes")
local COOLDOWN = 5
local lastSent = -math.huge

return function(ctx: any): any
	local UI, Store = ctx.UI, ctx.Store
	local items: { Facet.RadialItem<string> } = {}
	for index, message in GameData.QuickChat do
		items[index] = { id = "chat" .. index, label = message, onSelect = function()
			local wait = COOLDOWN - (os.clock() - lastSent)
			if wait > 0 then
				ctx.toast("warning", string.format("Quick chat ready in %ds", math.ceil(wait)))
				return
			end
			lastSent = os.clock();
			(Remotes:WaitForChild("Chat") :: RemoteEvent):FireServer(index)
		end }
	end
	ctx.chatCooldown = function(): number return math.max(0, COOLDOWN - (os.clock() - lastSent)) end
	return UI.RadialMenu({ label = "Quick chat", items = items, launcher = false, isPresented = ctx.chatOpen, holdAction = ctx.input.chat }, "QuickChat")
end
]]></ProtectedString>
