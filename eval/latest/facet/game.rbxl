type BarLayer = {
	kind: "fill" | "tile",
	asset: string,
	inset: { x: number, y: number }?,
	mask: string?,
	tileSize: { w: number, h: number }?,
}

local BAR_TRACK_LAYERS: { BarLayer } = {
	{ kind = "fill", asset = "glossy_bar_track" },
	{
		kind = "tile",
		asset = "glossy_stripe_tile",
