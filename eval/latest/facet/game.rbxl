								<UniqueId name="UniqueId">73c8afe78d24b4d30afced11000007c4</UniqueId>
							</Properties>
						</Item>
						<Item class="StringValue" referent="1000">
							<Properties>
								<string name="Value"><![CDATA[### draggable and dropTarget

<!-- aliases: draggable and dropTarget | draggable-and-droptarget -->

Open one option group below. Each group gives part of this contract.

