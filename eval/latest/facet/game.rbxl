									<string name="Name">layers</string>
									<BinaryString name="SerializedOverrides"></BinaryString>
									<int64 name="SourceAssetId">-1</int64>
									<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
									<UniqueId name="UniqueId">73c8afe78d24b4d30afced1100000561</UniqueId>
								</Properties>
							</Item>
							<Item class="ModuleScript" referent="388">
								<Properties>
									<Content name="LinkedSource"><null></null></Content>
									<ProtectedString name="Source"><![CDATA[--!strict

local UI = require "./ui"

local Compose = require "../core"
local Design = require "../design"

export type LibraryPanel = {
	root: Compose.Node,
	filter: (text: string) -> (),
	dispose: () -> (),
}

return function(ui: UI.UI)
	local Theme = require "./theme"(ui)
	local color = Theme.color
	local size = Theme.size

	return function(session: Design.Session, parent: Compose.Node): LibraryPanel
		local library = session.library
		local connections: { UI.Connection } = {}
		local root = Theme.frame "DesignLibrary"
		Theme.place(root, parent, ui.values.udim2(1, 0, 1, 0))

		local search = Theme.field ""
		ui.set(search, "Name", "Search")
		ui.set(search, "Position", ui.values.udim2(0, 8, 0, 4))
		ui.set(search, "Size", ui.values.udim2(1, -16, 0, size.row))
		ui.set(search, "PlaceholderText", "Search")
		ui.set(search, "Parent", root)

		local scroller = Theme.scroller "Kinds"
		ui.set(scroller, "Position", ui.values.udim2(0, 0, 0, size.row + 8))
		ui.set(scroller, "Size", ui.values.udim2(1, 0, 1, -(size.row + 8)))
		Theme.list(scroller, ui.values.enum("FillDirection", "Vertical"), 1)
		Theme.pad(scroller, 8, 8, 4, 8)
		ui.set(scroller, "Parent", root)

		local groups: { [string]: { string } } = {}
		local order: { string } = {}
		for name, kind in library.kinds do
			local category = kind.category or "Library"
			local members = groups[category]
			if members == nil then
				members = {}
				groups[category] = members
				table.insert(order, category)
			end
			table.insert(members, name)
		end
		local preferred = library.categories or {}
		table.sort(order, function(left: string, right: string): boolean
			local a, b = table.find(preferred, left), table.find(preferred, right)
			if a and b then
				return a < b
			elseif a or b then
				return a ~= nil
			end
			return left < right
		end)

		type Entry = { name: string, button: Compose.Node, header: Compose.Node }
		local entries: { Entry } = {}
		local headers: { [string]: Compose.Node } = {}
		local layout = 0
		for _, category in order do
			local members = groups[category]
			table.sort(members)
			layout += 1
			local header = Theme.label(category, color.tertiary, size.small, Theme.font.bold)
			ui.set(header, "Name", category)
			ui.set(header, "Size", ui.values.udim2(1, 0, 0, size.row))
			ui.set(header, "LayoutOrder", layout)
			ui.set(header, "Parent", scroller)
			headers[category] = header
			for _, name in members do
				layout += 1
				local button = Theme.button(name, "")
				ui.set(button, "Size", ui.values.udim2(1, 0, 0, size.row))
				ui.set(button, "BackgroundColor3", color.hover)
				ui.set(button, "LayoutOrder", layout)
				Theme.corner(button, 4)
				local glyph = Theme.label(Theme.glyph[name] or "◇", color.tertiary, size.small, Theme.font.bold)
				ui.set(glyph, "Name", "Glyph")
				ui.set(glyph, "Size", ui.values.udim2(0, 16, 1, 0))
				ui.set(glyph, "TextXAlignment", ui.values.enum("TextXAlignment", "Center"))
				ui.set(glyph, "Parent", button)
				local title = Theme.label(name, color.secondary, size.text)
				ui.set(title, "Name", "Title")
				Theme.place(title, button, ui.values.udim2(1, -22, 1, 0), ui.values.udim2(0, 22, 0, 0))
				ui.set(button, "Parent", scroller)
				for _, connection in Theme.hover(button, color.panel, color.hover, 1) do
					table.insert(connections, connection)
				end
				table.insert(
					connections,
					ui.connect(button, "Activated", function()
						session.insert(name)
					end)
				)
				table.insert(entries, { name = name, button = button, header = header })
			end
		end

		local function filter(text: string)
			local needle = string.lower(text)
			local shown: { [Compose.Node]: boolean } = {}
			for _, entry in entries do
				local visible = needle == "" or string.find(string.lower(entry.name), needle, 1, true) ~= nil
				ui.set(entry.button, "Visible", visible)
				if visible then
					shown[entry.header] = true
				end
			end
			for _, header in headers do
				ui.set(header, "Visible", shown[header] == true)
			end
		end

		table.insert(
			connections,
			ui.changed(search, "Text", function()
				filter(ui.text(search, "Text"))
			end)
		)

		return {
			root = root,
			filter = filter,
			dispose = function()
				for _, connection in connections do
					connection:Disconnect()
				end
				table.clear(connections)
				ui.destroy(root)
			end,
		}
	end
end
]]></ProtectedString>
									<string name="ScriptGuid">{E750BB64-890A-4717-BCB2-FA1833DA86CE}</string>
									<BinaryString name="AttributesSerialize"></BinaryString>
									<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
									<bool name="DefinesCapabilities">false</bool>
									<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
									<string name="Name">library-panel</string>
									<BinaryString name="SerializedOverrides"></BinaryString>
									<int64 name="SourceAssetId">-1</int64>
									<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
									<UniqueId name="UniqueId">73c8afe78d24b4d30afced1100000562</UniqueId>
								</Properties>
							</Item>
							<Item class="ModuleScript" referent="389">
								<Properties>
									<Content name="LinkedSource"><null></null></Content>
									<ProtectedString name="Source"><![CDATA[--!strict

export type Point = { X: number, Y: number }
export type Vector = { X: number, Y: number, Z: number }

local function add(a: Point, b: Point): Point
	return { X = a.X + b.X, Y = a.Y + b.Y }
end

local function sub(a: Point, b: Point): Point
	return { X = a.X - b.X, Y = a.Y - b.Y }
end

local function scale(a: Point, factor: number): Point
	return { X = a.X * factor, Y = a.Y * factor }
end

local function length(a: Point): number
	return math.sqrt(a.X * a.X + a.Y * a.Y)
end

local function vadd(a: Vector, b: Vector): Vector
	return { X = a.X + b.X, Y = a.Y + b.Y, Z = a.Z + b.Z }
end

local function vsub(a: Vector, b: Vector): Vector
	return { X = a.X - b.X, Y = a.Y - b.Y, Z = a.Z - b.Z }
end

local function vscale(a: Vector, factor: number): Vector
	return { X = a.X * factor, Y = a.Y * factor, Z = a.Z * factor }
end

local function dot(a: Vector, b: Vector): number
	return a.X * b.X + a.Y * b.Y + a.Z * b.Z
end

local function magnitude(a: Vector): number
	return math.sqrt(dot(a, a))
end

local function unit(a: Vector): Vector
	local size = magnitude(a)
	return vscale(a, if size > 0 then 1 / size else 0)
end

local function cross(a: Vector, b: Vector): Vector
	return { X = a.Y * b.Z - a.Z * b.Y, Y = a.Z * b.X - a.X * b.Z, Z = a.X * b.Y - a.Y * b.X }
end

local function frame(position: Vector): { number }
	return { position.X, position.Y, position.Z, 1, 0, 0, 0, 1, 0, 0, 0, 1 }
end

local function transform(a: { number }, v: Vector): Vector
	return {
		X = a[4] * v.X + a[5] * v.Y + a[6] * v.Z,
		Y = a[7] * v.X + a[8] * v.Y + a[9] * v.Z,
		Z = a[10] * v.X + a[11] * v.Y + a[12] * v.Z,
	}
end

local function multiply(a: { number }, b: { number }): { number }
	local offset = transform(a, { X = b[1], Y = b[2], Z = b[3] })
	local result = frame { X = a[1] + offset.X, Y = a[2] + offset.Y, Z = a[3] + offset.Z }
	for row = 0, 2 do
		for col = 0, 2 do
			local sum = 0
			for index = 0, 2 do
				sum += a[4 + row * 3 + index] * b[4 + index * 3 + col]
			end
			result[4 + row * 3 + col] = sum
		end
	end
	return result
end

local function rotation(pitch: number, yaw: number, roll: number): { number }
	local cx, sx, cy, sy, cz, sz =
		math.cos(pitch), math.sin(pitch), math.cos(yaw), math.sin(yaw), math.cos(roll), math.sin(roll)
	return {
		0,
		0,
		0,
		cy * cz + sy * sx * sz,
		-cy * sz + sy * sx * cz,
		sy * cx,
		cx * sz,
		cx * cz,
		-sx,
		-sy * cz + cy * sx * sz,
		sy * sz + cy * sx * cz,
		cy * cx,
	}
end

local function lookAt(position: Vector, target: Vector): { number }
	local back = unit(vsub(position, target))
	local right = unit(cross({ X = 0, Y = 1, Z = 0 }, back))
	if magnitude(right) < 1e-6 then
		right = unit(cross({ X = 0, Y = 0, Z = 1 }, back))
	end
	local up = cross(back, right)
	return { position.X, position.Y, position.Z, right.X, up.X, back.X, right.Y, up.Y, back.Y, right.Z, up.Z, back.Z }
end

return {
	add = add,
	sub = sub,
	scale = scale,
	length = length,
	vadd = vadd,
	vsub = vsub,
	vscale = vscale,
	dot = dot,
	magnitude = magnitude,
	unit = unit,
	frame = frame,
	transform = transform,
	multiply = multiply,
	rotation = rotation,
	lookAt = lookAt,
}
]]></ProtectedString>
