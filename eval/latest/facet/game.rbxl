									<Content name="LinkedSource"><null></null></Content>
									<ProtectedString name="Source"><![CDATA[--!strict

local Types = require "./types"
local Datatype = require "./datatype"
local Document = require "./document"

type Node = Types.Node
type Literal = Types.Literal
type Library = Types.Library
type Value = Types.Value
type Record = { [string | number]: Literal }

local source = {}

type Token = { kind: "name" | "string" | "number" | "symbol", text: string }

local function tokenize(code: string): { Token }
	local tokens: { Token } = {}
	local at = 1
	while at <= #code do
		local character = string.sub(code, at, at)
		local _, space = string.find(code, "^%s+", at)
		if space then
			at = space + 1
		elseif string.sub(code, at, at + 1) == "--" then
			local stop = string.find(code, "\n", at, true)
			at = if stop then stop + 1 else #code + 1
		elseif character == '"' then
			local stop = at + 1
			while stop <= #code and string.sub(code, stop, stop) ~= '"' do
				stop += if string.sub(code, stop, stop) == "\\" then 2 else 1
			end
			tokens[#tokens + 1] = { kind = "string", text = string.sub(code, at, stop) }
			at = stop + 1
		elseif string.match(character, "[%a_]") then
			local word = assert(string.match(code, "^[%w_]+", at))
			tokens[#tokens + 1] = { kind = "name", text = word }
			at += #word
		elseif string.match(code, "^%-?%d", at) then
			local number = string.match(code, "^%-?%d+%.?%d*[eE][%+%-]?%d+", at)
				or assert(string.match(code, "^%-?%d+%.?%d*", at))
			tokens[#tokens + 1] = { kind = "number", text = number }
			at += #number
		elseif string.sub(code, at, at + 2) == "..." then
			tokens[#tokens + 1] = { kind = "symbol", text = "..." }
			at += 3
		else
			tokens[#tokens + 1] = { kind = "symbol", text = character }
			at += 1
		end
	end
	return tokens
end

local function unquote(text: string): string
	local inner = string.sub(text, 2, -2)
	return (
		string.gsub(inner, "\\(.)", function(escaped: string): string
			return if escaped == "n" then "\n" elseif escaped == "t" then "\t" else escaped
		end)
	)
end

local function readLiteral(
	tokens: { Token },
	start: number,
	callback: ((at: number) -> (Literal, number))?
): (Literal, number)
	local at = start
	local function peek(offset: number?): string
		local token = tokens[at + (offset or 0)]
		return if token then token.text else ""
	end
	local function take(expected: string?): Token
		local token = assert(tokens[at], "The value ended early")
		assert(expected == nil or token.text == expected, `Expected {expected or ""} but found {token.text}`)
		at += 1
		return token
	end
	local function read(): Literal
		local ahead = tokens[at]
		local named = ahead ~= nil and ahead.kind == "name" and ahead.text ~= "true" and ahead.text ~= "false"
		if callback ~= nil and (peek() == "function" or named) then
			local marker, after = callback(at)
			at = after
			return marker
		end
		local token = take()
		if token.kind == "string" then
			return unquote(token.text)
		elseif token.kind == "number" then
			return assert(tonumber(token.text), "Invalid number")
		elseif token.text == "true" or token.text == "false" then
			return token.text == "true"
		end
		assert(token.text == "{", `Unexpected {token.text}`)
		local result: Record = {}
		local index = 0
		while peek() ~= "}" do
			local key: string | number
			if peek() == "[" then
				take "["
				local raw = read()
				if type(raw) == "string" or type(raw) == "number" then
					key = raw
				else
					error "Table keys are text or numbers"
				end
				take "]"
				take "="
			elseif tokens[at] and tokens[at].kind == "name" and peek(1) == "=" then
				key = take().text
				take "="
			else
				index += 1
				key = index
			end
			result[key] = read()
			if peek() == "," then
				take ","
			end
		end
		take "}"
		return result
	end
	local value = read()
	return value, at
end

function source.parseLiteral(code: string): Literal
	local tokens = tokenize(code)
	local value, after = readLiteral(tokens, 1)
	assert(after > #tokens, "Unexpected text after the value")
	return value
end

local function text(record: Record, key: string): string
	local found = record[key]
	assert(type(found) == "string", `The design header needs text at {key}`)
	return found
end

local function list(record: Record, key: string): { Record }
	local found = record[key]
	local result: { Record } = {}
	if found == nil then
		return result
	end
	assert(type(found) == "table", `The design header needs a list at {key}`)
	for _, entry in found do
		assert(type(entry) == "table", `The design header list {key} holds records`)
		table.insert(result, entry)
	end
	return result
end

local function inputKind(name: string): Types.InputKind
	if name == "value" or name == "readable" or name == "cell" then
		return name
	end
	error(`Unknown input kind {name}`, 0)
end

local function inputType(name: string): Types.InputType
	if
		name == "string"
		or name == "number"
		or name == "boolean"
		or name == "color"
		or name == "image"
		or name == "vector3"
		or name == "list"
		or name == "record"
		or name == "slot"
	then
		return name
	end
	error(`Unknown input type {name}`, 0)
end

local function stateFrom(header: Record): { Types.State }?
	if header.state == nil then
		return nil
	end
	local state: { Types.State } = {}
	for _, entry in list(header, "state") do
		local initial = entry.initial
		assert(initial ~= nil, "State needs an initial value")
		table.insert(state, { id = text(entry, "id"), type = inputType(text(entry, "type")), initial = initial })
	end
	return state
end

local function sequencesFrom(header: Record): { Types.Sequence }?
	if header.sequences == nil then
		return nil
	end
	local sequences: { Types.Sequence } = {}
	for _, entry in list(header, "sequences") do
		local steps: { Types.SequenceStep } = {}
		for _, step in list(entry, "steps") do
			local function token(key: string): string?
				local found = step[key]
				return if type(found) == "string" then found else nil
			end
			table.insert(steps, {
				delay = token "delay",
				duration = token "duration",
				easing = token "easing",
				state = token "state",
				to = step.to,
				output = token "output",
			})
		end
		table.insert(
			sequences,
			{ id = text(entry, "id"), autoplay = if entry.autoplay == true then true else nil, steps = steps }
		)
	end
	return sequences
end

local function fieldsFrom(entry: Record): { Types.ItemField }
	local declared: { Types.ItemField } = {}
	for _, field in list(entry, "fields") do
		local options: { string }? = nil
		if type(field.options) == "table" then
			options = {}
			for _, option in field.options do
				assert(type(option) == "string", "Item options are text")
				table.insert(options, option)
			end
		end
		table.insert(declared, {
			id = text(field, "id"),
			type = inputType(text(field, "type")),
			luauType = if field.luauType ~= nil then text(field, "luauType") else nil,
			fields = if field.fields ~= nil then fieldsFrom(field) else nil,
			options = options,
		})
	end
	return declared
end

local function contractOf(header: Record): Types.Contract
	local found = header.contract
	assert(type(found) == "table", "The design header needs a contract")
	local inputs: { Types.Input } = {}
	for _, entry in list(found, "inputs") do
		local fields: { Types.ItemField }? = if entry.fields ~= nil then fieldsFrom(entry) else nil
		local options: { string }? = nil
		if entry.options ~= nil then
			assert(type(entry.options) == "table", "Input options are a list")
			local choices: { string } = {}
			for _, option in entry.options do
				assert(type(option) == "string", "Input options are text")
				table.insert(choices, option)
			end
			options = choices
		end
		table.insert(inputs, {
			id = text(entry, "id"),
			kind = inputKind(text(entry, "kind")),
			luauType = if entry.luauType ~= nil then text(entry, "luauType") else nil,
			type = inputType(text(entry, "type")),
			preview = entry.preview,
			fields = fields,
			required = if entry.required == true then true else nil,
			options = options,
		})
	end
	local outputs: { Types.Output } = {}
	for _, entry in list(found, "outputs") do
		local args: { Types.InputType }? = nil
		local declared = entry.args
		if declared ~= nil then
			assert(type(declared) == "table", "Output arguments are a list")
			local typed: { Types.InputType } = {}
			for _, argument in declared do
				assert(type(argument) == "string", "Output arguments name input types")
				table.insert(typed, inputType(argument))
			end
			args = typed
		end
		local row = entry.row
		table.insert(outputs, { id = text(entry, "id"), args = args, row = if type(row) == "string" then row else nil })
	end
	return { inputs = inputs, outputs = outputs }
end

local function editorNodes(node: Node, path: string, visit: (Node, string) -> ())
	visit(node, path)
	local content: { [string]: string } = {}
	local function templates(value: Literal, at: string)
		if type(value) ~= "table" then
			return
		end
		local id = value["$template"]
		if type(id) == "string" and (content[id] == nil or at < content[id]) then
			content[id] = at
		end
		for key, child in value do
			templates(child, `{at}/{tostring(key)}`)
		end
	end
	for key, property in node.props do
		if property.literal ~= nil then
			templates(property.literal, tostring(key))
		end
	end
	local index = 0
	for _, child in node.children do
		local slot = content[child.id]
		if slot then
			editorNodes(child, `{path}/content/{slot}`, visit)
		else
			index += 1
			editorNodes(child, `{path}/{index}`, visit)
		end
	end
	if node.rowVariant then
		for _, case in node.rowVariant.cases do
			local wrapper = table.clone(node)
			wrapper.rowVariant = nil
			wrapper.props, wrapper.children = case.props, case.children
			editorNodes(wrapper, `{path}/variant/{case.value}`, visit)
		end
	end
end

function source.parse(code: string, library: Library): Types.Document
	local tokens = tokenize(code)
	local at = 1
	local function peek(offset: number?): string
		local token = tokens[at + (offset or 0)]
		return if token then token.text else ""
	end
	local function take(expected: string?): Token
		local token = assert(tokens[at], "The design source ended early")
		assert(expected == nil or token.text == expected, `Expected {expected or ""} but found {token.text}`)
		at += 1
		return token
	end
	local function name(): string
		local token = take()
		assert(token.kind == "name", `Expected a name but found {token.text}`)
		return token.text
	end
	local function annotation(stop: string)
		if peek() == ":" then
			while peek() ~= stop do
				take()
			end
		end
	end
	local function rowAlias()
		if peek() == "local" and string.match(peek(1), "^row_[%w]+$") then
			take "local"
			take()
			take "="
			take "current"
		end
	end
	local function referenceMessage()
		take ","
		local message = take()
		assert(
			message.kind == "string" and unquote(message.text) == "Node reference is not captured",
			"Node references assert their capture"
		)
		take ")"
	end
	local calls: { [string]: string } = {}
	for kindName, kind in library.kinds do
		calls[kind.call] = kindName
	end
	local rows: { [string]: Node } = {}
	local typedLiterals: { [string]: Literal } = {}
	local typedCells: { [string]: { Node } } = {}
	local namedRefs: { [string]: string } = {}
	local node: () -> Node
	local function rowBody(): Node
		local cases: { Types.VariantCase } = {}
		local alternatives: { Node } = {}
		local item: string? = nil
		while peek() == "if" do
			take "if"
			take "current"
			take ":"
			take "peek"
			take "("
			take ")"
			take "."
			local field = name()
			assert(item == nil or item == field, "Row variants read one enum field")
			item = field
			take "="
			take "="
			local selected = take()
			assert(selected.kind == "string", "Row variants select text enum options")
			take "then"
			take "return"
			local alternative = node()
			table.insert(alternatives, alternative)
			table.insert(cases, {
				value = unquote(selected.text),
				kind = alternative.kind,
				props = alternative.props,
				children = alternative.children,
			})
			take "end"
		end
		take "return"
		local root = node()
		if item then
			for _, alternative in alternatives do
				assert(
					(root.nameInput ~= nil or alternative.name == root.name)
						and alternative.nameInput == root.nameInput
						and alternative.nameField == root.nameField,
					"Row variants keep one direct root name"
				)
			end
			root.rowVariant = { item = item, cases = cases }
		end
		return root
	end
	local pendingCells: { Node } = {}
	local function plain(): Literal
		local value, after = readLiteral(tokens, at, function(position: number): (Literal, number)
			at = position
			if peek() == "props" then
				take "props"
				take "."
				return { ["$input"] = name() }, at
			end
			if peek() ~= "function" then
				local rowName = name()
				local cell = assert(rows[rowName], `{rowName} is not a row function`)
				table.insert(pendingCells, cell)
				local reference: Record = { ["$template"] = cell.id }
				return reference, at
			end
			take "function"
			take "("
			if peek() == "current" or peek() == ")" then
				if peek() == "current" then
					take "current"
					annotation ")"
				end
				take ")"
				annotation "return"
				take "return"
				local cell = node()
				take "end"
				table.insert(pendingCells, cell)
				local reference: Record = { ["$template"] = cell.id }
				return reference, at
			end
			take "..."
			take ")"
			take "if"
			take "props"
			take "."
			local output = name()
			take "then"
			take "props"
			take "."
			take(output)
			take "("
			local marker: Record = { ["$output"] = output }
			if peek() == "current" then
				take "current"
				take ":"
				take "peek"
				take "("
				take ")"
				marker["$row"] = true
			else
				take "..."
			end
			take ")"
			take "end"
			take "end"
			return marker, at
		end)
		at = after
		return value
	end
	local nextId = 1
	local function dotted(): string
		local path = name()
		while peek() == "." do
			take "."
			path ..= "." .. name()
		end
		return path
	end
	local function token(): string?
		local call = library.token
		if call == nil or tokens[at] == nil or tokens[at].kind ~= "name" then
			return nil
		end
		local start = at
		local path = dotted()
		if string.sub(call, -1) == "." and string.sub(path, 1, #call) == call then
			return string.sub(path, #call + 1)
		elseif path == call then
			local wrapped = peek() == "("
			if wrapped then
				take "("
			end
			local name = plain()
			if wrapped then
				take ")"
			end
			assert(type(name) == "string", "Token names are text")
			return name
		end
		at = start
		return nil
	end
	local motion = library.motion
	local motionTokens = if motion then tokenize(motion.call .. "(") else {}
	local function startsMotion(): boolean
		for index, part in motionTokens do
			if peek(index - 1) ~= part.text then
				return false
			end
		end
		return true
	end
	local function value(): (Value?, Node?)
		if motion ~= nil and startsMotion() then
			dotted()
			take "("
			local moving = assert(value(), `{motion.call} moves an input, state or item`)
			take ","
			moving.motion = unquote(take().text)
			take ")"
			return moving, nil
		end
		local bare = tokens[at]
		if bare and bare.kind == "name" and rows[bare.text] ~= nil and (peek(1) == "," or peek(1) == "}") then
			take()
			return nil, rows[bare.text]
		end
		if bare and bare.kind == "name" and typedLiterals[bare.text] ~= nil and (peek(1) == "," or peek(1) == "}") then
			take()
			local carried: { Node } = typedCells[bare.text] or {}
			for _, cell in carried do
				table.insert(pendingCells, cell)
			end
			return { literal = typedLiterals[bare.text] }, nil
		end
		if peek() == "sequences" and peek(1) == "." then
			take "sequences"
			take "."
			local played = name()
			take "."
			take "play"
			return { play = played }, nil
		end
		if peek() == "state" and peek(1) == "." then
			take "state"
			take "."
			return { state = name() }, nil
		elseif peek() == "refs" then
			take "refs"
			take "."
			return { node = name() }, nil
		elseif peek() == "props" then
			take "props"
			take "."
			local input = name()
			local path: { string } = {}
			while peek() == "." do
				take "."
				table.insert(path, name())
			end
			return { input = input, path = if #path > 0 then path else nil }, nil
		elseif peek() == "function" then
			take "function"
			take "("
			if peek() == "use" and peek(2) == "local" then
				take "use"
				take ")"
				take "local"
				take "chosen"
				take "="
				take "named"
				take "["
				local wrapped = peek() == "use"
				if wrapped then
					take "use"
					take "("
				end
				local holder = name()
				take "."
				local source = name()
				if wrapped then
					take ")"
				end
				assert(holder == "props" or holder == "state", "A chosen node follows an input or state")
				take "]"
				take "return"
				local captured = peek() == "assert"
				if captured then
					take "assert"
					take "("
				end
				take "if"
				take "chosen"
				take "then"
				take "use"
				take "("
				take "chosen"
				take ")"
				take "else"
				take "nil"
				if captured then
					referenceMessage()
				end
				take "end"
				local candidates: { string } = {}
				for _, id in namedRefs do
					table.insert(candidates, id)
				end
				table.sort(candidates)
				return { nodeFrom = source, nodes = candidates }, nil
			elseif peek() == "use" then
				take "use"
				take ")"
				take "return"
				if peek() == "assert" then
					take "assert"
					take "("
					take "use"
					take "("
					take "refs"
					take "."
					local target = name()
					take ")"
					referenceMessage()
					take "end"
					return { node = target }, nil
				end
				if peek() ~= "use" and peek() ~= "tostring" then
					local datatype = assert(value(), "A datatype formula returns a constructor")
					assert(type(datatype.literal) == "table", "A datatype formula returns components")
					take "end"
					return datatype, nil
				end
				local converted = peek() == "tostring"
				if converted then
					take "tostring"
					take "("
				end
				take "use"
				take "("
				local row = name()
				assert(
					row == "current" or string.match(row, "^row_[%w]+$") ~= nil,
					"Item bindings read the current row"
				)
				take ")"
				take "."
				local field = name()
				if converted then
					take ")"
				end
				take "end"
				local qualifier = string.match(row, "^row_([%w]+)$")
				return { item = if qualifier then qualifier .. "." .. field else field }, nil
			elseif peek() == "current" or peek() == ")" then
				if peek() == "current" then
					take "current"
					annotation ")"
				end
				take ")"
				annotation "return"
				rowAlias()
				if peek() == "if" then
					local child = rowBody()
					take "end"
					return nil, child
				end
				take "return"
				local next = tokens[at]
				if next ~= nil and (next.text == "{" or next.kind == "string" or next.kind == "number") then
					local perRow = plain()
					take "end"
					return { literal = perRow }, nil
				end
				local child = node()
				take "end"
				return nil, child
			end
			take "..."
			take ")"
			take "if"
			take "props"
			take "."
			local id = name()
			take "then"
			take "props"
			take "."
			take(id)
			take "("
			local args: { Literal }? = nil
			local passed: { string }? = nil
			if peek() == "..." then
				take "..."
			else
				local supplied: { Literal } = {}
				local fields: { string } = {}
				while peek() ~= ")" do
					if peek() == "current" then
						take "current"
						take ":"
						take "peek"
						take "("
						take ")"
						take "."
						table.insert(fields, name())
					else
						table.insert(supplied, plain())
					end
					if peek() == "," then
						take ","
					end
				end
				if #supplied > 0 or #fields == 0 then
					args = supplied
				end
				if #fields > 0 then
					passed = fields
				end
			end
			take ")"
			take "end"
			take "end"
			return { output = id, args = args, fields = passed }, nil
		end
		if tokens[at] and tokens[at].kind == "name" and peek(1) == "." then
			local start = at
			local path = dotted()
			local item = string.match(path, "^Enum%.[%w_]+%.([%w_]+)$")
			if item ~= nil then
				return { literal = item }, nil
			elseif path == "Color3.fromHex" then
				local wrapped = peek() == "("
				if wrapped then
					take "("
				end
				local hex = plain()
				if wrapped then
					take ")"
				end
				assert(type(hex) == "string", "Color3.fromHex takes text")
				return { literal = "#" .. hex }, nil
			elseif
				path == "Vector2.one"
				or path == "Vector2.zero"
				or path == "Vector3.one"
				or path == "Vector3.zero"
			then
				local datatype, constant = string.match(path, "^(%w+)%.(%w+)$")
				local components: Record = {}
				for index = 1, assert(Datatype.arity[assert(datatype)]) do
					components[index] = if constant == "one" then 1 else 0
				end
				return { literal = components }, nil
			elseif
				(string.match(path, "^[%w_]+%.new$") or path == "UDim2.fromOffset" or path == "UDim2.fromScale")
				and peek() == "("
			then
				take "("
				local components: { Types.DatatypeComponent } = {}
				while peek() ~= ")" do
					local name = token()
					if name then
						components[#components + 1] = { token = name }
					elseif peek() == "props" or peek() == "use" then
						local live = peek() == "use"
						if live then
							take "use"
							take "("
						end
						take "props"
						take "."
						local id = take()
						assert(id.kind == "name", "A datatype component names an input")
						if live then
							take ")"
						end
						components[#components + 1] = { input = id.text }
					else
						local number = plain()
						assert(
							type(number) == "number",
							"Datatype constructors take numeric, token or input components"
						)
						components[#components + 1] = number
					end
					if peek() == "," then
						take ","
					end
				end
				take ")"
				if path == "UDim2.fromOffset" or path == "UDim2.fromScale" then
					assert(#components == 2, `{path} takes two components`)
					local expanded: { Types.DatatypeComponent } = if path == "UDim2.fromOffset"
						then { 0, components[1], 0, components[2] }
						else { components[1], 0, components[2], 0 }
					components = expanded
				end
				return { literal = Datatype.literal(components) }, nil
			end
			at = start
		end
		local name = token()
		if name then
			return { token = name }, nil
		end
		return { literal = plain() }, nil
	end
	local captured: { [string]: string } = {}
	local sharedContent: Node? = nil
	node = function(): Node
		if peek() == "props" or peek() == "if" then
			local optional = peek() == "if"
			local condition: string? = nil
			if optional then
				take "if"
				take "props"
				take "."
				condition = name()
				take "then"
			end
			take "props"
			take "."
			local input = name()
			take "("
			take ")"
			if optional then
				assert(condition == input, "Optional slot children test their own factory")
				take "else"
				take "nil"
			end
			local child: Node =
				{ id = `n{nextId}`, kind = "$slot", name = input, slot = input, props = {}, children = {} }
			nextId += 1
			return child
		end
		if peek() == "rootContent" then
			take "rootContent"
			take "("
			take ")"
			local content = assert(sharedContent, "Root content needs its shared function")
			return content
		end
		if peek() == "capture" then
			take "capture"
			take "("
			local source = take()
			assert(source.kind == "string", "A captured node names its id")
			take ","
			local inner = node()
			take ")"
			captured[unquote(source.text)] = inner.id
			return inner
		end
		local call = dotted()
		local tagging = library.tags
		if tagging ~= nil and call == tagging.call and peek() == "(" then
			take "("
			local inner = node()
			take ","
			local binding = assert(value(), "Tags need a value")
			take ")"
			if binding.input or binding.item then
				inner.tagBinding = binding
				return inner
			end
			local raw = binding.literal
			local tags: { string } = {}
			if type(raw) == "table" then
				for _, tag in raw do
					if type(tag) == "string" then
						table.insert(tags, tag)
					end
				end
			end
			inner.tags = tags
			return inner
		end
		local kindName = assert(calls[call], `{call} is not a {library.name} kind`)
		local kind = library.kinds[kindName]
		local templated = kind.children == "template"
		local nodeName = take()
		local nameField: string? = nil
		local nodeTitle: string
		local nameInput: string? = nil
		if nodeName.kind == "symbol" and nodeName.text == "(" and peek() == "props" then
			take "props"
			take "."
			nameInput = name()
			nodeTitle = kindName
			if peek() == "or" then
				take "or"
				local fallback = take()
				assert(fallback.kind == "string", "A named node falls back to text")
				nodeTitle = unquote(fallback.text)
			end
			take ")"
		elseif nodeName.kind == "symbol" and nodeName.text == "(" then
			take "tostring"
			take "("
			take "current"
			take ":"
			take "peek"
			take "("
			take ")"
			take "."
			nameField = name()
			take ")"
			take ")"
			nodeTitle = kindName
		else
			assert(nodeName.kind == "string", "Every node needs a name")
			nodeTitle = unquote(nodeName.text)
		end
		local result: Node = {
			id = `n{nextId}`,
			kind = kindName,
			name = nodeTitle,
			nameField = nameField,
			nameInput = nameInput,
			props = {},
			children = {},
		}
		nextId += 1
		local outerCells = pendingCells
		pendingCells = {}
		take "{"
		local from: string?, key: string? = nil, nil
		local rowId: string? = nil
		while peek() ~= "}" do
			if tokens[at] and tokens[at].kind == "name" and peek(1) == "=" then
				local prop = name()
				take "="
				local property, template = value()
				local contentField = kind.fields[prop]
				if template and contentField and contentField.type == "content" and prop ~= kind.slot then
					local marker: Record = { ["$template"] = template.id }
					result.props[prop] = { literal = marker }
					table.insert(pendingCells, template)
				elseif template then
					assert(
						prop == (if kind.children == "slot" then kind.slot else kind.template),
						`{prop} cannot hold a template`
					)
					if templated then
						rowId = template.id
					end
					table.insert(result.children, template)
				elseif property and templated and prop == kind.source then
					from = assert(property.input or property.item, `{prop} must read a list input or item field`)
				elseif property and templated and prop == kind.key then
					local current = property.literal
					assert(type(current) == "string", "Item keys are text")
					key = current
				elseif property then
					result.props[prop] = property
				end
			else
				local start = at
				local lead = if tokens[at] and tokens[at].kind == "name" then dotted() else ""
				if library.show ~= nil and lead == library.show then
					take "("
					local condition: string
					if peek() == "function" then
						take "function"
						take "("
						local item = peek() == "use"
						if item then
							take "use"
						end
						take ")"
						if item then
							rowAlias()
						end
						take "return"
						if item then
							take "use"
							take "("
							take "current"
							take ")"
						else
							take "props"
						end
						take "."
						condition = name()
						take "="
						take "="
						take "true"
						take "end"
					else
						local holder = name()
						assert(holder == "props" or holder == "state", "A shown node reads an input or state")
						take "."
						condition = name()
					end
					take ","
					take "function"
					take "("
					take ")"
					take "return"
					local shown = node()
					take "end"
					take ")"
					shown.when = condition
					table.insert(result.children, shown)
				elseif library.keyed ~= nil and lead == library.keyed then
					take "{"
					take "from"
					take "="
					local listValue = assert(value(), "A keyed list reads a list")
					local list =
						assert(listValue.input or listValue.item, "A keyed list reads a list input or item field")
					take ","
					take "key"
					take "="
					take "function"
					take "("
					take "row"
					annotation ")"
					take ")"
					annotation "return"
					take "return"
					take "row"
					take "."
					local itemKey = name()
					take "end"
					take ","
					take "render"
					take "="
					local row: Node
					if peek() == "function" then
						take "function"
						take "("
						take "current"
						annotation ")"
						take ")"
						row = rowBody()
						take "end"
					else
						local rowName = name()
						row = assert(rows[rowName], `{rowName} is not a row function`)
					end
					if peek() == "," then
						take ","
					end
					take "}"
					from, key, rowId = list, itemKey, row.id
					table.insert(result.children, row)
				else
					at = start
					table.insert(result.children, node())
				end
			end
			if peek() == "," then
				take ","
			end
		end
		take "}"
		local listed = #result.children
		for _, cell in pendingCells do
			table.insert(result.children, cell)
		end
		pendingCells = outerCells
		if from then
			local row = if rowId ~= nil and listed > 1 then rowId else nil
			local keyProp = kind.key
			local field = if keyProp then kind.fields[keyProp] else nil
			local default = if field then field.default else nil
			result.bind = { from = from, key = key or (if type(default) == "string" then default else "id"), row = row }
		end
		return result
	end
	while not (peek() == "local" and (peek(1) == "design" or peek(1) == "_design")) do
		take()
	end
	take "local"
	take()
	take "="
	local header = plain()
	assert(type(header) == "table", "The design header is a table")
	while not ((peek() == "return" or peek() == "local") and peek(1) == "function") do
		take()
	end
	take()
	take "function"
	local variant: Types.RootVariant? = nil
	local alternative: Node? = nil
	while not (peek() == "return" and peek(1) ~= "node") do
		if peek() == "if" and peek(1) == "props" then
			take "if"
			take "props"
			take "."
			local input = name()
			take "="
			take "="
			local selected = plain()
			assert(type(selected) == "string", "A root variant selects an enum option")
			take "then"
			take "return"
			alternative = node()
			local found: Types.RootVariant =
				{ input = input, value = selected, kind = alternative.kind, props = alternative.props }
			variant = found
			take "end"
		elseif peek() == "local" and peek(1) == "function" and peek(2) == "rootContent" then
			take "local"
			take "function"
			take "rootContent"
			take "("
			take ")"
			annotation "return"
			take "return"
			sharedContent = node()
			take "end"
		elseif peek() == "local" and peek(1) == "named" then
			take "local"
			take "named"
			while peek() ~= "=" do
				take()
			end
			take "="
			take "{"
			while peek() ~= "}" do
				local chosenName = name()
				take "="
				take "refs"
				take "."
				namedRefs[chosenName] = name()
				if peek() == "," then
					take ","
				end
			end
			take "}"
		elseif
			peek() == "local"
			and tokens[at + 1]
			and tokens[at + 1].kind == "name"
			and peek(1) ~= "refs"
			and peek(2) == ":"
		then
			take "local"
			local literalName = name()
			take ":"
			while peek() ~= "=" do
				take()
			end
			take "="
			local outerCells = pendingCells
			pendingCells = {}
			typedLiterals[literalName] = plain()
			typedCells[literalName] = pendingCells
			pendingCells = outerCells
		elseif peek() == "local" and peek(1) == "function" and peek(2) ~= "capture" then
			take "local"
			take "function"
			local rowName = name()
			take "("
			take "current"
			annotation ")"
			take ")"
			rowAlias()
			rows[rowName] = rowBody()
			take "end"
		else
			take()
		end
	end
	take "return"
	local root = node()
	if alternative and variant then
		assert(
			(root.nameInput ~= nil or alternative.name == root.name)
				and alternative.nameInput == root.nameInput
				and alternative.nameField == root.nameField,
			"Root variants keep one direct root name"
		)
		if sharedContent then
			assert(
				#root.children == 1
					and root.children[1] == sharedContent
					and #alternative.children == 1
					and alternative.children[1] == sharedContent,
				"Root variants share their content"
			)
		else
			variant.children = alternative.children
		end
	end
	take "end"
	local function remap(current: Node)
		for _, property in current.props do
			local target = property.node
			if target ~= nil then
				property.node = assert(captured[target], `refs.{target} names no captured node`)
			end
			local candidates = property.nodes
			if candidates then
				local remapped: { string } = {}
				for _, candidate in candidates do
					local mapped: string = assert(captured[candidate], `refs.{candidate} names no captured node`)
					table.insert(remapped, mapped)
				end
				property.nodes = remapped
			end
		end
		for _, child in current.children do
			remap(child)
		end
		if current.rowVariant then
			for _, case in current.rowVariant.cases do
				local wrapper = table.clone(current)
				wrapper.rowVariant = nil
				wrapper.props, wrapper.children = case.props, case.children
				remap(wrapper)
			end
		end
	end
	remap(root)
	if alternative then
		local wrapper = table.clone(alternative)
		wrapper.children = if sharedContent then {} else alternative.children
		remap(wrapper)
	end
	do
		local ids: { [string]: string } = {}
		nextId = 1
		local function renumber(current: Node)
			local id = `n{nextId}`
			nextId += 1
			ids[current.id] = id
			current.id = id
			for _, child in current.children do
				renumber(child)
			end
			if current.rowVariant then
				for _, case in current.rowVariant.cases do
					for _, child in case.children do
						renumber(child)
					end
				end
			end
		end
		renumber(root)
		if variant and variant.children then
			for _, child in variant.children do
				renumber(child)
			end
		end
		local function markers(current: Literal)
			if type(current) ~= "table" then
				return
			end
			local template = current["$template"]
			if type(template) == "string" then
				current["$template"] = ids[template]
			end
			for _, item in current do
				markers(item)
			end
		end
		local function bindings(current: Node)
			for _, property in current.props do
				if property.node then
					property.node = ids[property.node]
				end
				if property.nodes then
					for index, id in property.nodes do
						property.nodes[index] = ids[id]
					end
				end
				if property.literal ~= nil then
					markers(property.literal)
				end
			end
			if current.bind and current.bind.row then
				current.bind.row = ids[current.bind.row]
			end
			for _, child in current.children do
				bindings(child)
			end
			if current.rowVariant then
				for _, case in current.rowVariant.cases do
					local wrapper = table.clone(current)
					wrapper.rowVariant = nil
					wrapper.props, wrapper.children = case.props, case.children
					bindings(wrapper)
				end
			end
		end
		bindings(root)
		if variant then
			local wrapper = table.clone(root)
			wrapper.rowVariant = nil
			wrapper.props = variant.props
			wrapper.children = variant.children or {}
			bindings(wrapper)
		end
	end
	local editor = header.editor
	if editor ~= nil then
		assert(type(editor) == "table", "The editor header is a table")
		local function restore(node: Node, path: string)
			local flags = editor[path]
			if flags ~= nil then
				assert(type(flags) == "table", "Editor flags are a table")
				assert(flags.hidden == nil or type(flags.hidden) == "boolean", "Hidden is a boolean")
				assert(flags.locked == nil or type(flags.locked) == "boolean", "Locked is a boolean")
				if flags.name ~= nil then
					node.name = text(flags, "name")
				end
				node.hidden = if flags.hidden == true then true else nil
				node.locked = if flags.locked == true then true else nil
			end
		end
		editorNodes(root, "root", restore)
		if variant and variant.children then
			local wrapper = table.clone(root)
			wrapper.rowVariant = nil
			wrapper.props, wrapper.children = variant.props, variant.children
			editorNodes(wrapper, "alternative", restore)
		end
	end
	return Document.validate({
		schema = "compose-design/1",
		name = text(header, "name"),
		library = library.name,
		nextId = nextId,
		contract = contractOf(header),
		state = stateFrom(header),
		sequences = sequencesFrom(header),
		root = root,
		rootVariant = variant,
	}, library)
end

source.editorNodes = editorNodes

return source
]]></ProtectedString>
									<string name="ScriptGuid">{10966F24-2F4A-40EA-9431-5644658C9739}</string>
									<BinaryString name="AttributesSerialize"></BinaryString>
									<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
									<bool name="DefinesCapabilities">false</bool>
									<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
									<string name="Name">source-read</string>
									<BinaryString name="SerializedOverrides"></BinaryString>
									<int64 name="SourceAssetId">-1</int64>
									<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
									<UniqueId name="UniqueId">73c8afe78d24b4d30afced1100000557</UniqueId>
								</Properties>
							</Item>
							<Item class="ModuleScript" referent="378">
								<Properties>
									<Content name="LinkedSource"><null></null></Content>
									<ProtectedString name="Source"><![CDATA[--!strict

local Types = require "./types"
local Document = require "./document"
local Read = require "./source-read"
local Datatype = require "./datatype"

type Node = Types.Node
type Literal = Types.Literal
type Library = Types.Library
type Value = Types.Value
type Record = { [string | number]: Literal }

local source = { parse = Read.parse, parseLiteral = Read.parseLiteral }

local function before(a: string | number, b: string | number): boolean
	if type(a) == "number" and type(b) == "number" then
		return a < b
	elseif type(a) == "string" and type(b) == "string" then
		return a < b
	end
	return type(a) == "number"
end

local function keysOf(value: Record): { string | number }
	local keys: { string | number } = {}
	for key in value do
		table.insert(keys, key)
	end
	table.sort(keys, before)
	return keys
end

local function prefix(key: string | number, index: number): string
	if key == index then
		return ""
	elseif type(key) == "string" and string.match(key, "^[%a_][%w_]*$") then
		return key .. " = "
	end
	local text = if type(key) == "string" then string.format("%q", key) else tostring(key)
	return "[" .. text .. "] = "
end

local function literal(value: Literal): string
	if type(value) == "string" then
		return string.format("%q", value)
	elseif type(value) == "number" or type(value) == "boolean" then
		return tostring(value)
	end
	local keys = keysOf(value)
	if #keys == 0 then
		return "{}"
	end
	local pieces: { string } = {}
	for index, key in keys do
		table.insert(pieces, prefix(key, index) .. literal(value[key]))
	end
	return "{ " .. table.concat(pieces, ", ") .. " }"
end
source.literal = literal

local WIDTH = 120

local function layoutHeader(header: Literal): string
	local function lay(current: Literal, depth: number, used: number): string
		if type(current) ~= "table" then
			return literal(current)
		end
		local single = literal(current)
		if single == "{}" or used + #single <= WIDTH then
			return single
		end
		local lines = { "{" }
		for index, key in keysOf(current) do
			local prefix = prefix(key, index)
			local width = (depth + 1) * 4 + #prefix + 1
			table.insert(lines, string.rep("\t", depth + 1) .. prefix .. lay(current[key], depth + 1, width) .. ",")
		end
		table.insert(lines, string.rep("\t", depth) .. "}")
		return table.concat(lines, "\n")
	end
	return lay(header, 0, 16)
end

local function tokenExpression(library: Library, token: string): string
	local call = assert(library.token, `{library.name} has no theme tokens`)
	return if string.sub(call, -1) == "." then call .. token else `{call} {literal(token)}`
end

local function datatypeLiteral(
	document: Types.Document,
	library: Library,
	datatype: string,
	value: Literal,
	depth: number
): string
	if string.sub(datatype, 1, 5) == "Enum." then
		return `{datatype}.{tostring(value)}`
	end
	if datatype == "Color3" and type(value) == "string" then
		return `Color3.fromHex {literal((string.gsub(value, "^#", "")))}`
	end
	local parts: { string } = {}
	local reactive = false
	local function finish(expression: string): string
		return if reactive
			then `function(use)\n{string.rep("\t", depth + 1)}return {expression}\n{string.rep("\t", depth)}end`
			else expression
	end
	if type(value) == "table" then
		for _, component in value do
			local token = Datatype.token(component)
			local input = Datatype.input(component)
			local part = if token then tokenExpression(library, token) else literal(component)
			if input then
				local live = assert(Document.input(document, input)).kind ~= "value"
				reactive = reactive or live
				part = if live then `use(props.{input})` else `props.{input}`
			end
			table.insert(parts, part)
		end
		if datatype == "UDim2" then
			if value[1] == 0 and value[3] == 0 then
				return finish(`UDim2.fromOffset({parts[2]}, {parts[4]})`)
			elseif value[2] == 0 and value[4] == 0 then
				return finish(`UDim2.fromScale({parts[1]}, {parts[3]})`)
			end
		elseif datatype == "Vector2" or datatype == "Vector3" then
			for _, constant in { "zero", "one" } do
				local same = true
				for _, component in value do
					same = same and component == (if constant == "zero" then 0 else 1)
				end
				if same then
					return `{datatype}.{constant}`
				end
			end
		end
	end
	return finish(`{datatype}.new({table.concat(parts, ", ")})`)
end

local function fieldsLiteral(fields: { Types.ItemField }): Record
	local list: Record = {}
	for _, field in fields do
		local nested = field.fields
		list[#list + 1] = {
			id = field.id,
			type = field.type,
			luauType = field.luauType,
			options = if field.options then table.clone(field.options) else nil,
			fields = if nested then fieldsLiteral(nested) else nil,
		}
	end
	return list
end

local function contractLiteral(contract: Types.Contract): Literal
	local inputs: Record = {}
	for _, input in contract.inputs do
		local fields = input.fields
		local entry = {
			id = input.id,
			kind = input.kind,
			type = input.type,
			luauType = input.luauType,
			preview = input.preview,
			required = if input.required then true else nil,
			fields = if fields then fieldsLiteral(fields) else nil,
		}
		if input.options then
			local options: Record = {}
			for index, option in input.options do
				options[index] = option
			end
			entry.options = options
		end
		inputs[#inputs + 1] = entry
	end
	local outputs: Record = {}
	for _, output in contract.outputs do
		local item = { id = output.id, row = output.row }
		local args = output.args
		if args then
			local list: Record = {}
			for index, argument in args do
				list[index] = argument
			end
			item.args = list
		end
		outputs[#outputs + 1] = item
	end
	return { inputs = inputs, outputs = outputs }
end

local function stateLiteral(state: { Types.State }): Literal
	local list: Record = {}
	for index, entry in state do
		list[index] = { id = entry.id, type = entry.type, initial = entry.initial }
	end
	return list
end

local function sequencesLiteral(sequences: { Types.Sequence }): Literal
	local entries: Record = {}
	for index, sequence in sequences do
		local steps: Record = {}
		for at, step in sequence.steps do
			steps[at] = {
				delay = step.delay,
				duration = step.duration,
				easing = step.easing,
				state = step.state,
				output = step.output,
				to = step.to,
			}
		end
		entries[index] = { id = sequence.id, steps = steps, autoplay = if sequence.autoplay then true else nil }
	end
	return entries
end

local function scalar(library: Library, kind: string): string
	if kind == "number" then
		return "number"
	elseif kind == "boolean" then
		return "boolean"
	elseif kind == "vector3" then
		return "{ number }"
	elseif kind == "list" then
		return "{ { [string]: unknown } }"
	elseif kind == "record" then
		return "{ [string]: unknown }"
	elseif kind == "slot" then
		return `() -> {library.returnType}`
	end
	return "string"
end

local function enumType(options: { string }?): string?
	if options == nil then
		return nil
	end
	local choices: { string } = {}
	for _, option in options do
		table.insert(choices, literal(option))
	end
	return table.concat(choices, " | ")
end

local function flatRowType(library: Library, fields: { Types.ItemField }): string
	local pieces: { string } = {}
	for _, field in fields do
		local shape: string? = enumType(field.options)
		if shape == nil then
			shape = field.luauType
		end
		local nested = field.fields
		if shape == nil and nested ~= nil and #nested > 0 then
			local child = flatRowType(library, nested)
			shape = if field.type == "list" then "{ " .. child .. " }" else child
		end
		table.insert(pieces, `{field.id}: {shape or scalar(library, field.type)}`)
	end
	return "{ " .. table.concat(pieces, ", ") .. " }"
end

local function rowType(library: Library, fields: { Types.ItemField }, depth: number?, used: number?): string
	local level = depth or 0
	local single = flatRowType(library, fields)
	if (used or 0) + #single <= WIDTH then
		return single
	end
	local lines = { "{" }
	for _, field in fields do
		local prefix = string.rep("\t", level + 1) .. field.id .. ": "
		local shape: string? = enumType(field.options)
		if shape == nil then
			shape = field.luauType
		end
		local nested = field.fields
		if shape == nil and nested ~= nil and #nested > 0 then
			local width = (level + 1) * 4 + #field.id + 3
			local child = rowType(library, nested, level + 1, width + (if field.type == "list" then 2 else 0))
			shape = if field.type == "list" then "{ " .. child .. " }" else child
		end
		table.insert(lines, prefix .. (shape or scalar(library, field.type)) .. ",")
	end
	table.insert(lines, string.rep("\t", level) .. "}")
	return table.concat(lines, "\n")
end

local function listItemName(input: Types.Input): string
	return string.upper(string.sub(input.id, 1, 1)) .. string.sub(input.id, 2) .. "Item"
end

local function base(library: Library, input: Types.Input): string
	if input.options then
		local choices: { string } = {}
		for _, option in input.options do
			table.insert(choices, literal(option))
		end
		return table.concat(choices, " | ")
	end
	if input.luauType ~= nil then
		return input.luauType
	end
	local fields = input.fields
	if fields and #fields > 0 then
		if input.type == "list" then
			return "{ " .. listItemName(input) .. " }"
		elseif input.type == "record" then
			return rowType(library, fields)
		end
	end
	return scalar(library, input.type)
end

local function outputType(library: Library, output: Types.Output, contract: Types.Contract): string
	local row = output.row
	if row ~= nil then
		for _, input in contract.inputs do
			if input.id == row then
				return `({listItemName(input)}) -> ()`
			end
		end
	end
	local args = output.args
	if args == nil then
		return "(...unknown) -> ()"
	end
	local pieces: { string } = {}
	for _, argument in args do
		table.insert(pieces, scalar(library, argument))
	end
	return "(" .. table.concat(pieces, ", ") .. ") -> ()"
end

local function fieldType(library: Library, input: Types.Input): string
	local shape = base(library, input)
	if input.kind == "readable" then
		return `{library.readable}<{shape}>`
	elseif input.kind == "cell" then
		return `{library.cell}<{shape}>`
	end
	return if input.type == "slot" and not input.required then `({shape})` else shape
end

export type EmitOptions = Types.EmitOptions

function source.emit(value: Types.Document, library: Library, options: EmitOptions?): string
	local exported = if options then options.name else nil
	if exported ~= nil then
		assert(string.match(exported, "^[%a_][%w_]*$") ~= nil, "A component name is a Luau identifier")
	end
	Document.validate(value, library)
	local controls = if options then options.controls else nil
	local propsType = if options then options.propsType else nil
	local lines: { string } = { "--!strict", "" }
	for _, line in library.prelude do
		table.insert(lines, line)
	end
	local extra = if options then options.prelude else nil
	if extra then
		for _, line in extra do
			table.insert(lines, line)
		end
	end
	local localControls = options ~= nil and options.localControls == true
	if controls ~= nil and not localControls then
		table.insert(lines, controls)
	end
	table.insert(lines, "")
	if propsType == nil and #value.contract.inputs == 0 and #value.contract.outputs == 0 then
		table.insert(lines, "export type Props = {}")
		table.insert(lines, "")
	elseif propsType == nil then
		for _, input in value.contract.inputs do
			local fields = input.fields
			if input.type == "list" and fields and #fields > 0 then
				local prefix = `export type {listItemName(input)} = `
				table.insert(lines, prefix .. rowType(library, fields, 0, #prefix))
				table.insert(lines, "")
			end
		end
		table.insert(lines, "export type Props = {")
		for _, input in value.contract.inputs do
			local optional = if input.required then "" else "?"
			table.insert(lines, `\t{input.id}: {fieldType(library, input)}{optional},`)
		end
		for _, output in value.contract.outputs do
			table.insert(lines, `\t{output.id}: ({outputType(library, output, value.contract)})?,`)
		end
		table.insert(lines, "}")
		table.insert(lines, "")
	end
	local rowTypesAt = #lines + 1
	local header: Record = { name = value.name, contract = contractLiteral(value.contract) }
	local editor: Record = {}
	local function recordEditor(node: Node, path: string)
		local input = if node.nameInput then Document.input(value, node.nameInput) else nil
		local name = if node.nameField or (input and input.required) then node.name else nil
		if node.hidden or node.locked or name then
			editor[path] = {
				hidden = if node.hidden then true else nil,
				locked = if node.locked then true else nil,
				name = name,
			}
		end
	end
	Read.editorNodes(value.root, "root", recordEditor)
	if value.rootVariant and value.rootVariant.children then
		local wrapper = table.clone(value.root)
		wrapper.rowVariant = nil
		wrapper.props, wrapper.children = value.rootVariant.props, value.rootVariant.children
		Read.editorNodes(wrapper, "alternative", recordEditor)
	end
	if next(editor) ~= nil then
		header.editor = editor
	end
	local state = value.state
	if state and #state > 0 then
		header.state = stateLiteral(state)
	end
	local sequences = value.sequences
	if sequences and #sequences > 0 then
		header.sequences = sequencesLiteral(sequences)
	end
	table.insert(lines, "local _design = " .. layoutHeader(header))
	table.insert(lines, "")
	local referenced: { [string]: boolean } = {}
	local referencedIds: { string } = {}
	local chosenNames: { [string]: string } = {}
	local nodeNames: { [string]: string } = {}
	local function nameNodes(node: Node)
		nodeNames[node.id] = node.name
		for _, child in node.children do
			nameNodes(child)
		end
		if node.rowVariant then
			for _, case in node.rowVariant.cases do
				for _, child in case.children do
					nameNodes(child)
				end
			end
		end
	end
	nameNodes(value.root)
	local function collect(node: Node)
		for _, property in node.props do
			local target = property.node
			if target ~= nil and not referenced[target] then
				referenced[target] = true
				table.insert(referencedIds, target)
			end
			local candidates = property.nodes
			if candidates then
				for _, candidate in candidates do
					chosenNames[nodeNames[candidate]] = candidate
					if not referenced[candidate] then
						referenced[candidate] = true
						table.insert(referencedIds, candidate)
					end
				end
			end
		end
		for _, child in node.children do
			collect(child)
		end
		if node.rowVariant then
			for _, case in node.rowVariant.cases do
				local wrapper = table.clone(node)
				wrapper.rowVariant = nil
				wrapper.props, wrapper.children = case.props, case.children
				collect(wrapper)
			end
		end
	end
	collect(value.root)
	local variant = value.rootVariant
	local alternative: Node? = nil
	if variant then
		alternative = table.clone(value.root)
		alternative.kind = variant.kind
		alternative.props = variant.props
		alternative.children = variant.children or value.root.children
		nameNodes(alternative)
		collect(alternative)
	end
	table.sort(referencedIds)
	local rowFunctions = options ~= nil and options.rowFunctions == true
	local rowDefinitions: { string } = {}
	local rowNames: { [string]: boolean } =
		{ props = true, state = true, refs = true, capture = true, rootContent = true }
	rowNames[library.parameter] = true
	local emitNode: (node: Node, depth: number) -> string
	local emit: (node: Node, depth: number) -> string
	local function tabs(depth: number): string
		return string.rep("\t", depth)
	end
	local function callback(output: string, list: string, depth: number): string
		return `function(...)\n{tabs(depth + 1)}if props.{output} then\n{tabs(depth + 2)}props.{output}({list})\n`
			.. `{tabs(depth + 1)}end\n{tabs(depth)}end`
	end
	local function returning(params: string, body: string, depth: number, returnType: string?): string
		local annotated = if returnType then `: {returnType}` else ""
		return `function({params}){annotated}\n{tabs(depth + 1)}return {body}\n{tabs(depth)}end`
	end
	local rowTypeLines: { string } = {}
	local rowItemTypes: { [string]: string } = {}
	local function rowBase(template: Node): string
		local base = string.gsub(template.name, "[^%w_]", "")
		if not string.match(base, "^%u") then
			base = "Row" .. base
		elseif not string.match(base, "Row$") then
			base ..= "Row"
		end
		return base
	end
	local function unique(base: string): string
		local name = base
		local suffix = 1
		while rowNames[name] do
			suffix += 1
			name = base .. tostring(suffix)
		end
		rowNames[name] = true
		return name
	end
	local scopes: { { fields: { Types.ItemField }? } } = {}
	local function fieldsOf(from: string): { Types.ItemField }?
		local declared = Document.input(value, from)
		if declared ~= nil then
			return declared.fields
		end
		local enclosing = scopes[#scopes]
		local around = if enclosing then enclosing.fields else nil
		local selected = string.match(from, "^[%w]+%.([%w_]+)$") or from
		if around ~= nil then
			for _, field in around do
				if field.id == selected then
					return field.fields
				end
			end
		end
		return nil
	end
	local function sourceOf(from: string, depth: number): string
		if Document.input(value, from) ~= nil then
			return `props.{from}`
		end
		local qualifier, selected = string.match(from, "^([%w]+)%.([%w_]+)$")
		if qualifier then
			return returning("use", `use(row_{qualifier}).{selected}`, depth)
		end
		return returning("use", `use(current).{from}`, depth)
	end
	local listItemTypes: { [string]: string } = {}
	if propsType == nil then
		for _, input in value.contract.inputs do
			local fields = input.fields
			if input.type == "list" and fields and #fields > 0 then
				listItemTypes[input.id] = listItemName(input)
				rowNames[listItemName(input)] = true
			end
		end
	end
	local function itemType(template: Node, from: string?, provided: { Types.ItemField }?): string?
		local known = rowItemTypes[template.id] or (if from then listItemTypes[from] else nil)
		if known ~= nil then
			rowItemTypes[template.id] = known
			return known
		end
		local fields: { Types.ItemField } = {}
		if provided ~= nil then
			for _, field in provided do
				table.insert(fields, field)
			end
		elseif from ~= nil then
			local found = fieldsOf(from)
			if found ~= nil then
				for _, field in found do
					table.insert(fields, field)
				end
			end
		end
		if #fields == 0 then
			return nil
		end
		local name = unique(if provided then "RepeatedItem" else rowBase(template) .. "Item")
		rowItemTypes[template.id] = name
		if from then
			listItemTypes[from] = name
		end
		local prefix = `type {name} = `
		table.insert(rowTypeLines, prefix .. rowType(library, fields, 0, #prefix))
		return name
	end
	local function keyFunction(template: Node, bind: Types.Bind, depth: number): string
		local typed = itemType(template, bind.from)
		if typed == nil then
			return returning("row", "row." .. bind.key, depth)
		end
		local keyType = "string"
		local fields = fieldsOf(bind.from)
		if fields then
			for _, field in fields do
				if field.id == bind.key then
					keyType = scalar(library, field.type)
				end
			end
		end
		return `function(row: {typed}): {keyType}\n{tabs(depth + 1)}return row.{bind.key}\n{tabs(depth)}end`
	end
	local function rowFunction(template: Node, depth: number, from: string?, provided: { Types.ItemField }?): string
		local typed = itemType(template, from, provided)
		local parameter = if typed then `current: {library.rowReadable or library.readable}<{typed}>` else "current"
		table.insert(scopes, { fields = provided or (if from then fieldsOf(from) else nil) })
		local written
		local function rowBody(level: number): string
			local body = emit(template, level + 1)
			local branches: { string } = {}
			if template.rowVariant then
				for _, case in template.rowVariant.cases do
					local wrapper = table.clone(template)
					wrapper.rowVariant = nil
					wrapper.kind, wrapper.props, wrapper.children = case.kind, case.props, case.children
					table.insert(
						branches,
						`{tabs(level + 1)}if current:peek().{template.rowVariant.item} == {literal(case.value)} then\n{tabs(
							level + 2
						)}return {emit(wrapper, level + 2)}\n{tabs(level + 1)}end\n`
					)
				end
			end
			local source = if from then string.match(from, "%.([%w_]+)$") or from else nil
			local alias = if source then `row_{source}` else nil
			local declaration = if alias and string.find(body, `use({alias})`, 1, true)
				then `{tabs(level + 1)}local {alias} = current\n`
				else ""
			return declaration .. table.concat(branches, "") .. `{tabs(level + 1)}return {body}`
		end
		if not rowFunctions then
			written = `function({parameter})\n{rowBody(depth)}\n{tabs(depth)}end`
		else
			local name = unique(rowBase(template))
			table.insert(rowDefinitions, `\tlocal function {name}({parameter})\n{rowBody(1)}\n\tend`)
			written = name
		end
		table.remove(scopes)
		return written
	end
	local cellOwner: Node? = nil
	local function layout(current: Literal, depth: number, used: number): string
		if type(current) ~= "table" then
			return literal(current)
		end
		local output = current["$output"]
		local input = current["$input"]
		if type(input) == "string" then
			return `props.{input}`
		end
		if type(output) == "string" then
			return callback(output, if current["$row"] == true then "current:peek()" else "...", depth)
		end
		local template = current["$template"]
		if type(template) == "string" then
			local owner = assert(cellOwner, "A cell template needs its node")
			local found = Document.find(owner, template)
			local cell = assert(found, "A cell template names a child")
			local bound = owner.bind
			if bound == nil then
				return returning("", emit(cell, depth + 1), depth)
			end
			return rowFunction(cell, depth, bound.from)
		end
		local keys = keysOf(current)
		if #keys == 0 then
			return "{}"
		end
		local prefixes: { string } = {}
		for index, key in keys do
			prefixes[index] = prefix(key, index)
		end
		local flat: { string } = {}
		local fits = true
		for index, key in keys do
			local piece = layout(current[key], depth, 0)
			if string.find(piece, "\n", 1, true) then
				fits = false
				break
			end
			flat[index] = prefixes[index] .. piece
		end
		if fits then
			local single = "{ " .. table.concat(flat, ", ") .. " }"
			if used + #single <= WIDTH then
				return single
			end
		end
		local lines = { "{" }
		for index, key in keys do
			local prefix = prefixes[index]
			local width = (depth + 1) * 4 + #prefix + 1
			table.insert(lines, `{tabs(depth + 1)}{prefix}{layout(current[key], depth + 1, width)},`)
		end
		table.insert(lines, tabs(depth) .. "}")
		return table.concat(lines, "\n")
	end
	local hoisted: { string } = {}
	local function carriesRow(current: Literal): boolean
		if type(current) ~= "table" then
			return false
		end
		if current["$row"] ~= nil then
			return true
		end
		for _, item in current do
			if carriesRow(item) then
				return true
			end
		end
		return false
	end
	local lateHoisted: { string } = {}
	local function hoist(node: Node, key: string, luauType: string, current: Literal): string
		local base = string.gsub(node.name, "[^%w_]", "")
		base = string.lower(string.sub(base, 1, 1)) .. string.sub(base, 2)
		if not string.match(base, "^%a") then
			base = "value"
		end
		base ..= string.upper(string.sub(key, 1, 1)) .. string.sub(key, 2)
		local name = unique(base)
		local typed = luauType
		local bound = node.bind
		if bound ~= nil then
			local keyType = "unknown"
			local fields: { Types.ItemField } = fieldsOf(bound.from) or {}
			for _, field in fields do
				if field.id == bound.key then
					keyType = scalar(library, field.type)
				end
			end
			local itemName = itemType(node, bound.from) or "unknown"
			typed = (string.gsub(typed, "%$Item", itemName))
			typed = (string.gsub(typed, "%$Key", keyType))
		end
		local prefix = `\tlocal {name}: {typed} = `
		local late = next(Document.cellsOf(current, {})) ~= nil
		table.insert(if late then lateHoisted else hoisted, prefix .. layout(current, 1, #prefix + 3))
		return name
	end
	local function expression(property: Value, depth: number, used: number): string
		local role = property.motion
		if role ~= nil then
			local motion = assert(library.motion, `{library.name} has no motion roles`)
			local still = table.clone(property)
			still.motion = nil
			return `{motion.call}({expression(still, depth, used)}, {literal(role)})`
		end
		local target = property.node
		if target ~= nil then
			return returning("use", `assert(use(refs.{target}), "Node reference is not captured")`, depth)
		end
		local stateId = property.state
		if stateId ~= nil then
			return `state.{stateId}`
		end
		local played = property.play
		if played ~= nil then
			return `sequences.{played}.play`
		end
		local source = property.nodeFrom
		if source ~= nil then
			local read
			if Document.stateOf(value, source) ~= nil then
				read = `use(state.{source})`
			elseif assert(Document.input(value, source)).kind == "value" then
				read = `props.{source}`
			else
				read = `use(props.{source})`
			end
			return `function(use)\n{tabs(depth + 1)}local chosen = named[{read}]\n`
				.. `{tabs(depth + 1)}return assert(if chosen then use(chosen) else nil, "Node reference is not captured")\n{tabs(
					depth
				)}end`
		end
		local current, input, item, output, token =
			property.literal, property.input, property.item, property.output, property.token
		if current ~= nil then
			return layout(current, depth, used)
		elseif input then
			local path = property.path
			return `props.{input}` .. (if path then "." .. table.concat(path, ".") else "")
		elseif item then
			return returning("use", `use(current).{item}`, depth)
		elseif output then
			local args = property.args
			local passed = property.fields
			local packed: Record = {}
			if args then
				for index, argument in args do
					packed[index] = argument
				end
			end
			local list = if args then string.sub(literal(packed), 3, -3) else if passed then "" else "..."
			if passed then
				local reads: { string } = {}
				for _, name in passed do
					table.insert(reads, `current:peek().{name}`)
				end
				list = if list == "" then table.concat(reads, ", ") else `{list}, {table.concat(reads, ", ")}`
			end
			return callback(output, list, depth)
		end
		return tokenExpression(library, assert(token))
	end
	local function tagged(node: Node, depth: number): string
		local tags, tagging = node.tags, library.tags
		if (tags == nil and node.tagBinding == nil) or tagging == nil then
			return emitNode(node, depth)
		end
		local inner = tabs(depth + 1)
		local quoted: { string } = {}
		for _, tag in tags or {} do
			table.insert(quoted, string.format("%q", tag))
		end
		local list = if node.tagBinding
			then expression(node.tagBinding, depth + 1, (depth + 1) * 4)
			else "{ " .. table.concat(quoted, ", ") .. " }"
		local body = emitNode(node, depth + 1)
		if node.tagBinding and not string.find(body, "\n", 1, true) then
			local bound = expression(node.tagBinding, depth, depth * 4 + #tagging.call + #body + 3)
			if string.sub(bound, 1, 8) == "function" then
				return `{tagging.call}({body}, {bound})`
			end
		end
		local single = `{tagging.call}({body}, {list})`
		if not string.find(single, "\n", 1, true) and depth * 4 + #single <= WIDTH then
			return single
		end
		return `{tagging.call}(\n{inner}{body},\n{inner}{list}\n{tabs(depth)})`
	end
	local sharedContent: Node? = nil
	emit = function(node: Node, depth: number): string
		if node.slot then
			local call = `props.{node.slot}()`
			return if assert(Document.input(value, node.slot)).required
				then call
				else `if props.{node.slot} then {call} else nil`
		end
		if node == sharedContent then
			return "rootContent()"
		end
		if referenced[node.id] then
			local inner = tabs(depth + 1)
			local body = tagged(node, depth + 1)
			local single = `capture("{node.id}", {body})`
			if not string.find(body, "\n", 1, true) and depth * 4 + #single <= WIDTH then
				return single
			end
			return `capture(\n{inner}"{node.id}",\n{inner}{body}\n{tabs(depth)})`
		end
		return tagged(node, depth)
	end
	emitNode = function(node: Node, depth: number): string
		local kind = assert(library.kinds[node.kind])
		local inner = tabs(depth + 1)
		local nameField, nameInput = node.nameField, node.nameInput
		local opening
		if nameField ~= nil then
			opening = `{kind.call}(tostring(current:peek().{nameField})) `
		elseif nameInput ~= nil then
			local input = assert(Document.input(value, nameInput))
			local fallback = if input.required then "" else ` or {literal(node.name)}`
			opening = `{kind.call}(props.{nameInput}{fallback}) `
		else
			opening = `{kind.call} {literal(node.name)} `
		end
		local body: { string } = {}
		local keys: { string } = {}
		local boundTemplate = kind.children == "template" and node.bind ~= nil
		local slot = if kind.children == "slot" then kind.slot else nil
		for key, property in node.props do
			local current = property.literal
			local declared = kind.fields[key]
			local default = if declared then declared.default else nil
			if
				not (boundTemplate and (key == kind.source or key == kind.key))
				and (key ~= slot or current == nil)
				and not (current ~= nil and default ~= nil and literal(current) == literal(default))
			then
				table.insert(keys, key)
			end
		end
		table.sort(keys)
		local cells: { [string]: true } = {}
		local outerOwner = cellOwner
		cellOwner = node
		for _, key in keys do
			local property = node.props[key]
			local field = kind.fields[key]
			local current = property.literal
			if current ~= nil then
				Document.cellsOf(current, cells)
			end
			local datatype: string? = if field then field.datatype else nil
			local written: string
			local luauType: string? = if field then field.luauType else nil
			local bound = node.bind
			local itemName = property.item
			if current ~= nil and field ~= nil and field.perRow and bound ~= nil then
				local typed = itemType(node, bound.from)
				local parameter = if typed
					then `current: {library.rowReadable or library.readable}<{typed}>`
					else "current"
				table.insert(scopes, { fields = fieldsOf(bound.from) })
				written = returning(parameter, layout(current, depth + 2, 0), depth + 1, luauType)
				table.remove(scopes)
			elseif current ~= nil and datatype ~= nil then
				written = datatypeLiteral(value, library, datatype, current, depth + 1)
			elseif current ~= nil and type(current) == "table" and luauType and not carriesRow(current) then
				written = hoist(node, key, luauType, current)
			else
				written = expression(property, depth + 1, (depth + 1) * 4 + #key + 4)
			end
			if itemName ~= nil and field ~= nil and field.type == "string" then
				local enclosing = scopes[#scopes]
				local around: { Types.ItemField } = if enclosing and enclosing.fields then enclosing.fields else {}
				local textual = true
				for _, entry in around do
					if entry.id == itemName and entry.type ~= "string" then
						textual = false
					end
				end
				if not textual then
					written = returning("use", `tostring(use(current).{itemName})`, depth + 1)
				end
			end
			table.insert(body, `{inner}{key} = {written},`)
		end
		cellOwner = outerOwner
		local content: { Node } = {}
		for _, child in node.children do
			if not cells[child.id] then
				table.insert(content, child)
			end
		end
		local bind, template = node.bind, content[1]
		if kind.children == "slot" then
			if template then
				table.insert(
					body,
					`{inner}{assert(kind.slot)} = {returning("", emit(template, depth + 2), depth + 1)},`
				)
			end
		elseif kind.children == "template" then
			if bind then
				table.insert(body, `{inner}{assert(kind.source)} = {sourceOf(bind.from, depth + 1)},`)
				local keyProp = kind.key
				if keyProp then
					local field = kind.fields[keyProp]
					local default = if field then field.default else nil
					if default ~= bind.key then
						table.insert(body, `{inner}{keyProp} = {literal(bind.key)},`)
					end
				end
			end
			local templateProp = kind.template
			if templateProp == nil then
				for _, child in content do
					table.insert(body, `{inner}{emit(child, depth + 1)},`)
				end
			elseif kind.iteration and template and bind == nil then
				table.insert(
					body,
					`{inner}{templateProp} = {rowFunction(template, depth + 1, nil, kind.iteration.fields)},`
				)
			elseif bind and template then
				local rowId = bind.row or template.id
				local rowNode = template
				for _, child in content do
					if child.id == rowId then
						rowNode = child
					end
				end
				table.insert(body, `{inner}{templateProp} = {rowFunction(rowNode, depth + 1, bind.from)},`)
				for _, child in content do
					if child ~= rowNode then
						table.insert(body, `{inner}{emit(child, depth + 1)},`)
					end
				end
			end
		else
			local rowId = if bind then bind.row or (if template then template.id else nil) else nil
			for _, child in content do
				local condition = child.when
				if bind and child.id == rowId then
					local keyedCall = assert(library.keyed)
					local field = tabs(depth + 2)
					table.insert(body, `{inner}{keyedCall} ` .. "{")
					table.insert(body, `{field}from = {sourceOf(bind.from, depth + 2)},`)
					table.insert(body, `{field}key = {keyFunction(child, bind, depth + 2)},`)
					table.insert(body, `{field}render = {rowFunction(child, depth + 2, bind.from)},`)
					table.insert(body, `{inner}},`)
				elseif condition == nil then
					table.insert(body, `{inner}{emit(child, depth + 1)},`)
				else
					local showCall = assert(library.show)
					local source
					if Document.stateOf(value, condition) ~= nil then
						source = `state.{condition}`
					elseif Document.input(value, condition) == nil then
						source = returning("use", `use(current).{condition} == true`, depth + 1)
					elseif assert(Document.input(value, condition)).kind == "value" then
						source = returning("", `props.{condition} == true`, depth + 1)
					else
						source = `props.{condition}`
					end
					local shown = returning("", emit(child, depth + 2), depth + 1)
					table.insert(body, `{inner}{showCall}({source}, {shown}),`)
				end
			end
		end
		if #body == 0 then
			return opening .. "{}"
		end
		return opening .. "{\n" .. table.concat(body, "\n") .. "\n" .. tabs(depth) .. "}"
	end
	local propsName = propsType or "Props"
	local signature = if controls ~= nil
		then `(props: {propsName}): {library.returnType}`
		else `({library.parameter}: {library.parameterType}, props: {propsName}): {library.returnType}`
	table.insert(lines, if exported then `local function {exported}{signature}` else `return function{signature}`)
	if controls ~= nil and localControls then
		table.insert(lines, "\t" .. controls)
	end
	local contentSource: string? = nil
	if variant and variant.children == nil then
		local content = value.root.children[1]
		contentSource = emit(content, 2)
		sharedContent = content
	end
	local rootSource = emit(value.root, 1)
	local alternativeSource = if alternative then emit(alternative, 2) else nil
	for index, line in rowTypeLines do
		table.insert(lines, rowTypesAt + 2 * index - 2, line)
		table.insert(lines, rowTypesAt + 2 * index - 1, "")
	end
	for _, definition in hoisted do
		table.insert(lines, definition)
	end
	local readsState = string.find(rootSource .. (contentSource or "") .. (alternativeSource or ""), "state.", 1, true)
		~= nil
	for _, definition in lateHoisted do
		readsState = readsState or string.find(definition, "state.", 1, true) ~= nil
	end
	for _, definition in rowDefinitions do
		readsState = readsState or string.find(definition, "state.", 1, true) ~= nil
	end
	if #referencedIds > 0 then
		local newCell = assert(library.newCell, `{library.name} cannot reference nodes; it names no cell constructor`)
		local cells: { string } = {}
		for _, id in referencedIds do
			table.insert(cells, `{id} = {newCell}<<{library.returnType}?>>(nil)`)
		end
		local prefix = "\tlocal refs: { [string]: " .. `{library.cell}<{library.returnType}?>` .. " } = "
		local single = prefix .. "{ " .. table.concat(cells, ", ") .. " }"
		if #single + 3 <= WIDTH then
			table.insert(lines, single)
		else
			table.insert(lines, prefix .. "{")
			for _, cell in cells do
				table.insert(lines, "\t\t" .. cell .. ",")
			end
			table.insert(lines, "\t}")
		end
		table.insert(lines, `\tlocal function capture(id: string, node: {library.returnType}): {library.returnType}`)
		table.insert(lines, "\t\trefs[id]:set(node)")
		table.insert(lines, "\t\treturn node")
		table.insert(lines, "\tend")
		local chosen: { string } = {}
		for name in chosenNames do
			table.insert(chosen, name)
		end
		table.sort(chosen)
		if #chosen > 0 then
			local entries: { string } = {}
			for _, name in chosen do
				table.insert(entries, `{name} = refs.{chosenNames[name]}`)
			end
			table.insert(
				lines,
				"\tlocal named: { [string]: "
					.. `{library.readable}<{library.returnType}?>`
					.. " } = { "
					.. table.concat(entries, ", ")
					.. " }"
			)
		end
	end
	local sequenceLines: { string } = {}
	if sequences and #sequences > 0 then
		local sequencing = assert(library.sequence, `{library.name} cannot play sequences`)
		table.insert(sequenceLines, "\tlocal sequences = {")
		for _, sequence in sequences do
			table.insert(sequenceLines, "\t\t" .. sequence.id .. " = " .. sequencing.call .. " {")
			table.insert(sequenceLines, "\t\t\tsteps = {")
			for _, step in sequence.steps do
				local parts: { string } = {}
				local function timed(key: string, token: string?)
					if token ~= nil then
						table.insert(parts, `{key} = {literal(token)}`)
					end
				end
				timed("delay", step.delay)
				timed("duration", step.duration)
				timed("easing", step.easing)
				local target, to = step.state, step.to
				if target ~= nil and to ~= nil then
					table.insert(
						parts,
						if type(to) == "number"
							then `sample = {sequencing.toward}(state.{target}, {literal(to)})`
							else `onStart = function() state.{target}:set({literal(to)}) end`
					)
					readsState = true
				end
				local output = step.output
				if output ~= nil then
					table.insert(parts, `onEnd = props.{output}`)
				end
				table.insert(sequenceLines, "\t\t\t\t{ " .. table.concat(parts, ", ") .. " },")
			end
			table.insert(sequenceLines, "\t\t\t},")
			table.insert(sequenceLines, "\t\t},")
		end
		table.insert(sequenceLines, "\t}")
		for _, sequence in sequences do
			if sequence.autoplay then
				table.insert(sequenceLines, `\tsequences.{sequence.id}.play()`)
			end
		end
	end
	if state and #state > 0 and readsState then
		local newCell = assert(library.newCell, `{library.name} cannot hold state; it names no cell constructor`)
		local cells: { string } = {}
		for _, entry in state do
			local initial = entry.initial
			local argument = literal(initial)
			table.insert(
				cells,
				if type(initial) == "string" or type(initial) == "table"
					then `{entry.id} = {newCell} {argument}`
					else `{entry.id} = {newCell}({argument})`
			)
		end
		table.insert(lines, "\tlocal state = { " .. table.concat(cells, ", ") .. " }")
	end
	for _, line in sequenceLines do
		table.insert(lines, line)
	end
	for _, definition in rowDefinitions do
		table.insert(lines, definition)
	end
	for _, definition in lateHoisted do
		table.insert(lines, definition)
	end
	if variant and alternativeSource then
		if contentSource then
			table.insert(
				lines,
				`\tlocal function rootContent(): {library.returnType}\n\t\treturn {contentSource}\n\tend`
			)
		end
		table.insert(
			lines,
			`\tif props.{variant.input} == {literal(variant.value)} then\n\t\treturn {alternativeSource}\n\tend`
		)
	end
	table.insert(lines, `\treturn {rootSource}`)
	table.insert(lines, "end")
	if exported then
		table.insert(lines, "")
		table.insert(lines, `return {exported}`)
	end
	table.insert(lines, "")
	return table.concat(lines, "\n")
end

return source
]]></ProtectedString>
