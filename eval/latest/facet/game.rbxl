Options: name: type = default. omitted uses the control or theme default; required has no default.
gap: Input<(number | ("xs" | "s" | "m" | "l" | "xl") | string)>? = omitted
icon: string? = omitted
iconPosition: ("leading" | "trailing")? = omitted
iconSize: (number | string)? = omitted
presentation: ("titleAndIcon" | "titleOnly" | "iconOnly")? = omitted
ref: ((Frame) -> ())? = omitted
