					<Item class="ModuleScript" referent="RBXDD60DB5059B34B6E9809E293A00AE1AB">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- First-use help attached to the real Garage, Shop and Race buttons. Replay from Help.
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local C = Facet.Compose

local step = C.cell(0)
local autoStarted = false
local STEPS = {
	{ anchor = "garage", title = "Your garage", text = "Pick the kart for your next race, compare stats, upgrade it and take a test drive. Try opening it now, then come back here." },
	{ anchor = "shop", title = "The shop", text = "Buy motors, boosts, wheels and cosmetics, and redeem codes. Equip parts from Parts & Drivers." },
	{ anchor = "race", title = "Race queue", text = "Join a Solo or Duo queue, vote on a track and race CPU opponents for Credits, Gems and XP." },
}

return function(ctx: any): any
	local UI, Store = ctx.UI, ctx.Store
	local anyOpen = C.formula(function(use: Facet.Use): boolean
		for _, cell in ctx.open do if use(cell) then return true end end
		return use(Store.mode) ~= "hub"
	end)
	local function finish(kind: string)
		step:set(0)
		ctx.req("tutorial", kind, true)
		local help = ctx.anchors.help
		if help and UserInputService.GamepadEnabled then
			task.defer(function()
				local target = help:IsA("GuiObject") and help.Selectable and help or help:FindFirstChildWhichIsA("GuiButton", true)
				if target then GuiService.SelectedObject = target end
			end)
		end
	end
	ctx.startTutorial = function()
		for _, cell in ctx.open do cell:set(false) end
		step:set(1)
	end
	task.spawn(function()
		while not autoStarted do
			task.wait(0.5)
			local p = Store.profile:peek()
			if p and p.tutorial then
				autoStarted = true
				if not p.tutorial.done then step:set(1) end
			end
		end
	end)
	local nodes = {}
	for i, s in STEPS do
		table.insert(nodes, C.show(function(use: Facet.Use): boolean return use(step) == i and not use(anyOpen) end, function()
			local anchor = ctx.anchors[s.anchor]
			local actions = {
				{ id = "Back", label = "Back", enabled = i > 1, onActivate = function() step:set(math.max(1, i - 1)) end },
				{ id = "Next", label = if i == #STEPS then "Finish" else "Next", role = "default", onActivate = function()
					if i == #STEPS then finish("done") else step:set(i + 1) end
				end },
			}
			return UI.Callout("Help" .. i) {
				anchor = anchor, title = s.title, closeButton = true,
				steps = { index = i, count = #STEPS },
				content = function()
					return UI.VStack "Text" { gap = "s", Size = UDim2.fromScale(1, 0),
						UI.Text { text = s.text, wrap = true, Size = UDim2.fromScale(1, 0) },
						UI.Button "Skip" { label = "Skip tutorial", appearance = "utility", onActivate = function() finish("skip") end },
					}
				end,
				actions = actions,
				onRetire = function(reason: string)
					if reason == "dismissed" and step:peek() == i then
						if i > 1 then step:set(i - 1) else finish("skip") end
					end
				end,
			}
		end))
	end
	return nodes
end
]]></ProtectedString>
							<string name="ScriptGuid">{E8CB9DCC-634E-4C75-9B06-01297F18DE57}</string>
