										<Content name="LinkedSource"><null></null></Content>
										<ProtectedString name="Source"><![CDATA[--!strict
--!native

local Evaluation = require "./evaluation"
local stats = Evaluation.stats
local Dynamic = require "../dynamic"
local Graph = require "./graph"
local Nodes = require "./node"
local Types = require "./types"
local statsOn = stats.state

type Body = (use: Types.Use) -> ()
type Node = Types.Node
type Reactor = Types.Reactor
type Dispose = Types.Dispose

local CLEAN = Graph.CLEAN
local CHECK = Graph.CHECK
local DIRTY = Graph.DIRTY

local enterScope: (Node) -> () = function(_node: Node) end
local leaveScope: (Node) -> () = function(_node: Node) end

local function installScope(enter: (Node) -> (), leave: (Node) -> ())
	enterScope, leaveScope = enter, leave
end

local function rerun(node: Node, frame: Evaluation.Evaluation?)
	if statsOn.enabled then
		stats.bump "watchRuns"
		statsOn.recorder.enterRun(node)
	end
	node.state = CLEAN
	if node.inherited ~= nil then
		enterScope(node)
	end
	if frame ~= nil then
		Graph.runEffectIn(frame, node)
	else
		Graph.runEffect(node)
	end
end

local function moved(node: Node): boolean
	node.retry = true
	local result = Graph.dependenciesMoved(node)
	node.retry = false
	return result
end

local function guardedMoved(node: Node): boolean
	local checked, result = pcall(Graph.dependenciesMoved, node)
	return not checked or result
end

local WATCH = {}
WATCH.__index = WATCH
Nodes.adopt(WATCH)
WATCH.state = CLEAN
WATCH.kind = 3

function WATCH.run(node: Node, frame: Evaluation.Evaluation?)
	if node.released then
		return
	end
	if node.state == CHECK and not moved(node) then
		node.state = CLEAN
		return
	end
	rerun(node, frame)
end

WATCH.runIn = WATCH.run

local TERMINAL = {}
TERMINAL.__index = TERMINAL
Nodes.adopt(TERMINAL)
TERMINAL.state = CLEAN
TERMINAL.group = true
TERMINAL.kind = 4

local resume: Node? = nil

local function sweep(leader: Node, producer: Node, from: Node?)
	local reactor = leader.reactor
	local frame, previousConsumer, previousOrder = Evaluation.enterFrame(leader)
	local edge = from
	while edge ~= nil do
		local following = edge[4]
		resume = following
		local consumer = edge[2]
		if
			consumer ~= nil
			and consumer ~= leader
			and consumer[2] == nil
			and consumer.state == DIRTY
			and consumer.reactor == reactor
			and not consumer.queued
			and not consumer.released
			and consumer.group
		then
			if statsOn.enabled then
				stats.bump "watchRuns"
				statsOn.recorder.enterRun(consumer)
			end
			consumer.state = CLEAN
			Graph.runEffectIn(frame, consumer)
		end
		edge = following
	end
	Evaluation.leaveFrame(frame, previousConsumer, previousOrder)
end

function TERMINAL.run(leader: Node, frame: Evaluation.Evaluation?)
	local producer = leader.source
	leader.source = nil
	if not leader.released then
		if leader.state == CHECK and not moved(leader) then
			leader.state = CLEAN
		else
			rerun(leader, frame)
		end
	end
	if producer == nil then
		return
	end
	local first = producer.first
	if first ~= nil and first[4] == nil then
		return
	end
	local consumer, at = Evaluation.snapshot()
	local from = producer.first
	local failures: { string }? = nil
	while from ~= nil do
		local previous = resume
		resume = nil
		local ok, err: unknown = pcall(sweep, leader, producer, from)
		local following = resume
		resume = previous
		if ok then
			break
		end
		Evaluation.leave(consumer, at)
		local collected = failures or {}
		failures = collected
		table.insert(collected, tostring(err))
		from = following
	end
	if failures ~= nil then
		if #failures == 1 then
			error(failures[1], 0)
		end
		error(("Compose: %d fused bindings failed:\n  %s"):format(#failures, table.concat(failures, "\n  ")), 0)
	end
end

function TERMINAL.runIn(node: Node, frame: Evaluation.Evaluation)
	if node.source ~= nil or node.state == CHECK then
		TERMINAL.run(node, frame)
		return
	end
	if node.released then
		return
	end
	if statsOn.enabled then
		stats.bump "watchRuns"
		statsOn.recorder.enterRun(node)
	end
	node.state = CLEAN
	Graph.runEffectIn(frame, node)
end

local GUARDED = {}
GUARDED.__index = GUARDED
Nodes.adopt(GUARDED)
GUARDED.state = CLEAN
GUARDED.kind = 3

function GUARDED.run(node: Node, frame: Evaluation.Evaluation?)
	if node.released then
		return
	end
	if node.state == CHECK and not guardedMoved(node) then
		node.state = CLEAN
		return
	end
	rerun(node, frame)
end

GUARDED.runIn = GUARDED.run

local function begin(reactor: Reactor, body: Body, class: {}, label: string?, scope: Types.Owner?): Node
	local node: Node = {
		reactor = reactor,
		effect = body,
		released = false,
		queued = false,
		reads = nil,
		inherited = scope,
		child = nil,
		base = nil,
	}
	Nodes.classify(node, class)
	if statsOn.enabled then
		statsOn.recorder.born(node, label)
	end
	local consumer, at = Evaluation.snapshot()
	local ok, err: unknown = pcall(rerun, node, nil)
	if not ok then
		Evaluation.leave(consumer, at)
		Graph.release(node)
		if node.child ~= nil then
			leaveScope(node)
		end
		error(err, 0)
	end
	if #node == 0 and not node.queued then
		node.effect = nil
	end
	return node
end

local function releaseEdge(node: Types.Node)
	if node.listener ~= nil then
		Graph.unlisten(node)
	elseif not node.released and node.state ~= nil then
		Graph.release(node)
		node.queued = false
	end
end

local function releaseHeld(subject: unknown)
	local node = Nodes.asNode(subject)
	if node ~= nil then
		releaseEdge(node)
	end
end

local function start(reactor: Reactor, body: Body, class: {}, label: string?, scope: Types.Owner?): Dispose
	local node = begin(reactor, body, class, label, scope)
	return function()
		if node.released then
			return
		end
		Graph.release(node)
		node.queued = false
		if node.child ~= nil then
			leaveScope(node)
		end
	end
end

local function watchGuarded(reactor: Reactor, body: Body, label: string?): Dispose
	return start(reactor, body, GUARDED, label)
end

local function watchScoped(reactor: Reactor, body: Body, label: string?, scope: Types.Owner, guarded: boolean): Dispose
	return start(reactor, body, if guarded then GUARDED else WATCH, label, scope)
end

local function watchTerminal(reactor: Reactor, body: Body): Dispose
	return start(reactor, body, TERMINAL, nil)
end

local function terminalNode(reactor: Reactor, body: Body, guarded: boolean?): Node
	return begin(reactor, body, if guarded then GUARDED else TERMINAL, nil)
end

local function watchStatic<T>(reactor: Reactor, value: Types.ReadOnlyValue<T>, body: (value: T) -> ()): Dispose
	return Graph.listen(reactor, Graph.nodeOf(value), Dynamic.listener(body))
end

local function sample<T>(body: () -> T): T
	return Graph.untracked(body)
end

return {
	watchGuarded = watchGuarded,
	watchScoped = watchScoped,
	installScope = installScope,
	watchStatic = watchStatic,
	terminalNode = terminalNode,
	releaseHeld = releaseHeld,
	releaseEdge = releaseEdge,
	watchTerminal = watchTerminal,
	sample = sample,
}
]]></ProtectedString>
										<string name="ScriptGuid">{ABB8B5F4-56D1-420E-BC9F-3A1AB26FC5F9}</string>
										<BinaryString name="AttributesSerialize"></BinaryString>
										<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
										<bool name="DefinesCapabilities">false</bool>
										<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
										<string name="Name">watch</string>
										<BinaryString name="SerializedOverrides"></BinaryString>
										<int64 name="SourceAssetId">-1</int64>
										<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
										<UniqueId name="UniqueId">73c8afe78d24b4d30afced110000052d</UniqueId>
									</Properties>
								</Item>
