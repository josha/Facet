				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Builds a kart model from a livery and kart definition. Used for race karts and UI previews.
local GameData = require(script.Parent.GameData)
local KartBuilder = {}

export type Livery = { body: string, bodyShade: number, accent: string, accentShade: number, decal: string }

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then p.Shape = shape end
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

function KartBuilder.build(kartId: string, livery: Livery?, glow: Color3?, withSeat: boolean?): Model
	local kart = GameData.find(GameData.Karts, kartId) or GameData.Karts[1]
	local body = if livery then GameData.swatchColor(livery.body, livery.bodyShade) else kart.body
	local accent = if livery then GameData.swatchColor(livery.accent, livery.accentShade) else kart.accent
	local decal = if livery then livery.decal else "Stripe"
	local model = Instance.new("Model")
	model.Name = "Kart"
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(6, 1.6, 10)
	root.CFrame = CFrame.new(0, 1.6, 0)
	root.Color = body
	root.Material = Enum.Material.SmoothPlastic
	root.CustomPhysicalProperties = PhysicalProperties.new(1, 0, 0, 100, 100)
	root.TopSurface = Enum.SurfaceType.Smooth
	root.BottomSurface = Enum.SurfaceType.Smooth
	root.Parent = model
	model.PrimaryPart = root
	local o = root.CFrame
	-- Silhouette varies by category
	local nose = if kart.category == "Speed" then 4.5 elseif kart.category == "Grip" then 3 else 2.4
	part(model, "Nose", Vector3.new(5, 1, nose), o * CFrame.new(0, -0.1, -5 - nose / 2) * CFrame.Angles(0, math.pi, 0), body, nil, Enum.PartType.Wedge)
	part(model, "Cowl", Vector3.new(4.4, 1.2, 3.2), o * CFrame.new(0, 1.2, -2.2), body:Lerp(Color3.new(0, 0, 0), 0.25))
	part(model, "Glass", Vector3.new(3.6, 0.9, 1.6), o * CFrame.new(0, 2.0, -2.6) * CFrame.Angles(math.rad(-25), 0, 0), Color3.fromRGB(120, 220, 255), Enum.Material.Glass).Transparency = 0.35
	part(model, "Spoiler", Vector3.new(6.6, 0.3, 1.6), o * CFrame.new(0, 2.6, 4.6), accent, Enum.Material.Neon)
	part(model, "StrutL", Vector3.new(0.3, 1.8, 0.6), o * CFrame.new(-2.2, 1.6, 4.6), body)
	part(model, "StrutR", Vector3.new(0.3, 1.8, 0.6), o * CFrame.new(2.2, 1.6, 4.6), body)
	part(model, "SideL", Vector3.new(0.25, 0.4, 9), o * CFrame.new(-3.1, 0.2, 0), accent, Enum.Material.Neon)
	part(model, "SideR", Vector3.new(0.25, 0.4, 9), o * CFrame.new(3.1, 0.2, 0), accent, Enum.Material.Neon)
	part(model, "Engine", Vector3.new(3, 1.2, 2), o * CFrame.new(0, 1.2, 3.4), Color3.fromRGB(30, 34, 50), Enum.Material.Metal)
	part(model, "Exhaust", Vector3.new(1.6, 0.6, 0.4), o * CFrame.new(0, 1.0, 5.1), accent, Enum.Material.Neon)
	local top = o * CFrame.new(0, 0.81, 0)
	if decal == "Stripe" then
		part(model, "Decal", Vector3.new(1.2, 0.05, 9.6), top, accent, Enum.Material.Neon)
	elseif decal == "Twin" then
		part(model, "Decal", Vector3.new(0.6, 0.05, 9.6), top * CFrame.new(-1.4, 0, 0), accent, Enum.Material.Neon)
		part(model, "Decal2", Vector3.new(0.6, 0.05, 9.6), top * CFrame.new(1.4, 0, 0), accent, Enum.Material.Neon)
	elseif decal == "Chevron" then
		for i = 0, 2 do
			part(model, "DecalL" .. i, Vector3.new(0.5, 0.05, 2.6), top * CFrame.new(-1, 0, -1 + i * 2) * CFrame.Angles(0, math.rad(-40), 0), accent, Enum.Material.Neon)
			part(model, "DecalR" .. i, Vector3.new(0.5, 0.05, 2.6), top * CFrame.new(1, 0, -1 + i * 2) * CFrame.Angles(0, math.rad(40), 0), accent, Enum.Material.Neon)
		end
	elseif decal == "Checker" then
		for x = 0, 3 do
			for z = 0, 5 do
				if (x + z) % 2 == 0 then
					part(model, "Check", Vector3.new(1.3, 0.05, 1.3), top * CFrame.new(-1.95 + x * 1.3, 0, -0.5 + z * 1.0 - 2), accent, Enum.Material.Neon)
				end
			end
		end
	elseif decal == "Bolt" then
		part(model, "Bolt1", Vector3.new(0.6, 0.05, 3.4), top * CFrame.new(0.6, 0, 1.6) * CFrame.Angles(0, math.rad(25), 0), accent, Enum.Material.Neon)
		part(model, "Bolt2", Vector3.new(2.2, 0.05, 0.6), top * CFrame.new(0, 0, 0), accent, Enum.Material.Neon)
		part(model, "Bolt3", Vector3.new(0.6, 0.05, 3.4), top * CFrame.new(-0.6, 0, -1.6) * CFrame.Angles(0, math.rad(25), 0), accent, Enum.Material.Neon)
	end
	for _, w in { { -3.4, -3.4, "WheelFL" }, { 3.4, -3.4, "WheelFR" }, { -3.4, 3.4, "WheelRL" }, { 3.4, 3.4, "WheelRR" } } do
		local wheel = part(model, w[3] :: string, Vector3.new(1.4, 2.6, 2.6), o * CFrame.new(w[1] :: number, 0.5, w[2] :: number), Color3.fromRGB(20, 22, 32), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		local rim = part(model, (w[3] :: string) .. "Rim", Vector3.new(1.5, 1.4, 1.4), wheel.CFrame, accent, Enum.Material.Neon, Enum.PartType.Cylinder)
		rim.Name = (w[3] :: string) .. "Rim"
	end
	local under = part(model, "Underglow", Vector3.new(5.4, 0.2, 8.6), o * CFrame.new(0, -0.7, 0), glow or accent, Enum.Material.Neon)
	under.Transparency = 0.2
	local light = Instance.new("PointLight")
	light.Color = glow or accent
	light.Range = 14
	light.Brightness = 2
	light.Parent = under
	if withSeat then
		local seat = Instance.new("Seat")
		seat.Name = "Seat"
		seat.Size = Vector3.new(2.4, 0.4, 2.4)
		seat.CFrame = o * CFrame.new(0, 0.6, 0.6)
		seat.Transparency = 1
		seat.CanCollide = false
		seat.Massless = true
		seat.Parent = model
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = d
			weld.Parent = d
		end
	end
	return model
end

-- Simple driver figure for local opponents (no account avatar).
function KartBuilder.addPilot(model: Model, color: Color3)
	local root = model.PrimaryPart :: BasePart
	local torso = part(model, "PilotTorso", Vector3.new(2, 2, 1.2), root.CFrame * CFrame.new(0, 2, 0.8), color)
	local head = part(model, "PilotHead", Vector3.new(1.8, 1.8, 1.8), root.CFrame * CFrame.new(0, 3.9, 0.8), Color3.fromRGB(30, 30, 45), Enum.Material.Glass, Enum.PartType.Ball)
	local visor = part(model, "PilotVisor", Vector3.new(1.4, 0.5, 0.3), root.CFrame * CFrame.new(0, 4.0, -0.05), color, Enum.Material.Neon)
	for _, p in { torso, head, visor } do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
	end
end

return KartBuilder
]]></ProtectedString>
