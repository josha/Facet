					<Item class="ModuleScript" referent="119">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
export type Kind = "pending" | "drag" | "pan" | "scroll" | "press" | "doubleTap" | "cancelled"
export type Options = {
	pickup: ("immediate" | "longPress")?,
	axis: ("X" | "Y" | "XY")?,
	scroll: boolean?,
	threshold: number?,
}
export type Decision = { owner: Instance, origin: Vector2, kind: Kind }
type Contact = Decision & { options: Options }
export type Arbiter = {
	begin: (InputObject, Instance, Vector2, Options) -> boolean,
	move: (InputObject, Vector2) -> Kind?,
	claim: (InputObject, Instance, Kind) -> boolean,
	get: (InputObject) -> Decision?,
	finish: (InputObject, Instance, boolean?) -> Kind?,
	cancelOwner: (Instance) -> (),
	capture: (Instance, () -> ()) -> (),
	claimCamera: (Instance) -> boolean,
	busy: () -> boolean,
}
export type Binding = {
	begin: (InputObject, Vector2, Options) -> boolean,
	move: (InputObject, Vector2) -> Kind?,
	claim: (InputObject, Kind) -> boolean,
	get: (InputObject) -> Decision?,
	finish: (InputObject, boolean?) -> Kind?,
}
local arbitration = {}

function arbitration.new(): Arbiter
	local contacts: { [InputObject]: Contact } = {}
	local arbiter = {}
	local captureOwner: Instance? = nil
	local cameras: { [Instance]: boolean } = {}
	function arbiter.busy(): boolean
		return next(contacts) ~= nil or captureOwner ~= nil
	end
	function arbiter.begin(pointer: InputObject, owner: Instance, origin: Vector2, options: Options): boolean
		local held = contacts[pointer]
		if held and (held.owner == owner or held.kind ~= "pending" or not owner:IsDescendantOf(held.owner)) then
			return held.owner == owner
		end
		local threshold = options.threshold or 6
		assert(threshold > 0 and threshold < math.huge, "Facet gesture threshold must be finite and positive")
		contacts[pointer] = { owner = owner, origin = origin, kind = "pending", options = table.clone(options) }
		return true
	end
	function arbiter.move(pointer: InputObject, position: Vector2): Kind?
		local contact = contacts[pointer]
		if not contact then
			return nil
		end
		if contact.kind ~= "pending" then
			return contact.kind
		end
		local delta = position - contact.origin
		local options = contact.options
		if delta.Magnitude < (options.threshold or 6) then
			return "pending"
		end
		local along = (options.axis ~= "X" or math.abs(delta.X) >= math.abs(delta.Y))
			and (options.axis ~= "Y" or math.abs(delta.Y) >= math.abs(delta.X))
		contact.kind = if options.pickup == "immediate" and along
			then "drag"
			elseif options.scroll then "scroll"
			else "pan"
		return contact.kind
	end
	function arbiter.claim(pointer: InputObject, owner: Instance, kind: Kind): boolean
		local contact = contacts[pointer]
		if not contact or contact.owner ~= owner then
			return false
		end
		if contact.kind ~= "pending" then
			return contact.kind == kind
		end
		if kind == "drag" and contact.options.pickup == nil then
			return false
		end
		if kind == "pan" or kind == "scroll" then
			return false
		end
		contact.kind = kind
		return true
	end
	function arbiter.get(pointer: InputObject): Decision?
		local contact = contacts[pointer]
		return if contact then { owner = contact.owner, origin = contact.origin, kind = contact.kind } else nil
	end
	function arbiter.finish(pointer: InputObject, owner: Instance, cancelled: boolean?): Kind?
		local contact = contacts[pointer]
		if not contact or contact.owner ~= owner then
			return nil
		end
		contacts[pointer] = nil
		return if cancelled then "cancelled" elseif contact.kind == "pending" then "press" else contact.kind
	end
	function arbiter.capture(owner: Instance, callback: () -> ())
		assert(captureOwner == nil, "Facet capture callbacks cannot start another capture")
		captureOwner = owner
		table.clear(cameras)
		local ok, failure = pcall(function(): unknown
			callback()
			return nil
		end)
		captureOwner = nil
		table.clear(cameras)
		if not ok then
			error(failure, 0)
		end
	end
	function arbiter.claimCamera(surface: Instance): boolean
		local owner = captureOwner
		if not owner or cameras[surface] then
			return false
		end
		cameras[surface] = true
		return true
	end
	function arbiter.cancelOwner(owner: Instance)
		for pointer, contact in contacts do
			if contact.owner == owner then
				contacts[pointer] = nil
			end
		end
	end
	return arbiter
end

return arbitration
]]></ProtectedString>
