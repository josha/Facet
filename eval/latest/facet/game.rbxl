					<Item class="ModuleScript" referent="RBXB1705A0C70374982BB85545CF73554AC">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Livery editor: draft colors, shades and decal on a live preview; save, revert and guarded exit.
local GuiService = game:GetService("GuiService")
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local Common = require(script.Parent.Common)
local C = Facet.Compose

local draft = C.cell(table.clone(GameData.DefaultLivery) :: any)
local saving = C.cell(false)
local saveError = C.cell("")
local confirmDiscard = C.cell(false)
local discardReason = C.cell("close")

local FIELDS = { "body", "bodyShade", "accent", "accentShade", "decal" }
local function same(a: any, b: any): boolean
	for _, f in FIELDS do if a[f] ~= b[f] then return false end end
	return true
end

return function(ctx: any): any
	local UI, Store, Host = ctx.UI, ctx.Store, ctx.Host
	local env = ctx.env
	local function saved(use: Facet.Use?): any
		local p = if use then use(Store.profile) else Store.profile:peek()
		return (p and p.livery) or GameData.DefaultLivery
	end
	local dirty = C.formula(function(use: Facet.Use): boolean return not same(use(draft), saved(use)) end)
	local open = ctx.open.livery
	local wasOpen = false
	-- A clean editor picks up the saved design each time it opens.
	task.spawn(function()
		while true do
			task.wait(0.15)
			local o = open:peek()
			if o and not wasOpen and same(draft:peek(), draft:peek()) then
				if not saving:peek() then
					local s = saved()
					if not confirmDiscard:peek() and same(draft:peek(), s) == false and not ctx.liveryDirtyKept then
						draft:set(table.clone(s))
					end
				end
			end
			wasOpen = o
		end
	end)
	local function set(field: string, value: any)
		local d = table.clone(draft:peek())
		d[field] = value
		draft:set(d)
		ctx.liveryDirtyKept = true
	end
	local function requestClose(nextValue: boolean)
		if not nextValue and dirty:peek() then
			discardReason:set("close")
			confirmDiscard:set(true)
		else
			if not nextValue then ctx.liveryDirtyKept = false end
			open:set(nextValue)
		end
	end
	local function revert()
		if dirty:peek() then
			discardReason:set("revert")
			confirmDiscard:set(true)
		end
	end
	local function save()
		if saving:peek() then return end
		saving:set(true)
		saveError:set("")
		local r = Store.request("saveLivery", draft:peek())
		saving:set(false)
		if r.ok then
			ctx.liveryDirtyKept = false
			ctx.toast("success", "Livery saved · used in your next race")
		else
			saveError:set(r.message)
		end
	end

	local function swatchRow(field: string): Instance
		local items = {}
		for _, sw in GameData.Swatches do
			table.insert(items, UI.HStack("Sw_" .. sw.id) { gap = "xs",
				Host.Frame "Chip" { Size = UDim2.fromOffset(env.scaled(18), env.scaled(18)),
					BackgroundColor3 = function(use: Facet.Use): Color3
						local d = use(draft)
						return GameData.swatchColor(sw.id, d[field .. "Shade"])
					end,
					Host.UICorner "R" { CornerRadius = UDim.new(0.5, 0) } },
				UI.Button("Pick") {
					label = function(use: Facet.Use): string return (if use(draft)[field] == sw.id then "✓ " else "") .. sw.id end,
					appearance = function(use: Facet.Use): string return if use(draft)[field] == sw.id then "emphasis" else "standard" end,
					onActivate = function() set(field, sw.id) end },
			})
		end
		return UI.HStack("Swatches_" .. field) { width = "fill", wrap = true, gap = "s", table.unpack(items) }
	end
	local function shadeRow(field: string): Instance
		local items = {}
		for _, sh in GameData.Shades do
			table.insert(items, UI.Button("Shade" .. sh) {
				label = function(use: Facet.Use): string return (if use(draft)[field] == sh then "✓ " else "") .. sh .. "%" end,
				appearance = function(use: Facet.Use): string return if use(draft)[field] == sh then "emphasis" else "standard" end,
				onActivate = function() set(field, sh) end })
		end
		return UI.HStack("Shades_" .. field) { gap = "s", wrap = true, width = "fill", UI.Text { text = "Shade", textRole = "caption" }, table.unpack(items) }
	end
	local decals = {}
	for _, dc in GameData.Decals do
		table.insert(decals, UI.Button("Decal_" .. dc) {
			label = function(use: Facet.Use): string return (if use(draft).decal == dc then "✓ " else "") .. dc end,
			appearance = function(use: Facet.Use): string return if use(draft).decal == dc then "emphasis" else "standard" end,
			onActivate = function() set("decal", dc) end })
	end

	local discardActions: { Facet.DialogAction } = {
		{ id = "Cancel", label = "Keep editing", role = "cancel", onActivate = function() end },
		{ id = "Discard", label = "Discard changes", role = "destructive", onActivate = function()
			draft:set(table.clone(saved()))
			ctx.liveryDirtyKept = false
			if discardReason:peek() == "close" then open:set(false) end
		end },
	}
	local sheet = UI.Sheet "Livery" {
		title = "Livery", isPresented = open, placement = "center", width = "wide", detents = { "hug" },
		onPresentedChange = requestClose,
		content = function()
			return UI.HStack "Body" { width = "fill", wrap = true, gap = "m",
				UI.VStack "PreviewCol" { gap = "s", Size = UDim2.fromOffset(env.scaled(340), 0),
					Common.preview(ctx, env.scaled(220), function(use: Facet.Use): string
						local p = use(Store.profile)
						return p and p.selectedKart or "volt"
					end, function(use: Facet.Use): any return use(draft) end),
					UI.Text { textRole = "strong", wrap = true, text = function(use: Facet.Use): string
						if use(saving) then return "Saving…" end
						if use(saveError) ~= "" then return "✕ Save failed: " .. use(saveError) end
						return if use(dirty) then "● Unsaved changes" else "✓ Saved design"
					end },
					UI.Text { textRole = "caption", wrap = true, text = function(use: Facet.Use): string
						local s = saved(use)
						return string.format("Saved: %s %d%% body · %s %d%% accent · %s decal", s.body, s.bodyShade, s.accent, s.accentShade, s.decal)
					end },
					UI.HStack "Actions" { width = "fill", gap = "s", wrap = true,
						UI.Button "Save" { label = "Save design", appearance = "emphasis", busy = saving, UI.fill(),
							enabled = function(use: Facet.Use): boolean return use(dirty) end, onActivate = save },
						UI.Button "Revert" { label = "Revert", UI.fill(),
							enabled = function(use: Facet.Use): boolean return use(dirty) end, onActivate = revert },
					},
				},
				UI.VStack "Controls" { gap = "s", Size = UDim2.fromOffset(env.scaled(400), 0),
					UI.Text { text = "Body color", textRole = "label" }, swatchRow("body"), shadeRow("bodyShade"),
					UI.Text { text = "Accent color", textRole = "label" }, swatchRow("accent"), shadeRow("accentShade"),
					UI.Text { text = "Decal", textRole = "label" },
					UI.HStack "Decals" { width = "fill", wrap = true, gap = "s", table.unpack(decals) },
				},
			}
		end,
	}
	local dialog = UI.Dialog "DiscardLivery" {
		isPresented = confirmDiscard,
		title = function(use: Facet.Use): string return if use(discardReason) == "close" then "Leave without saving?" else "Revert to saved design?" end,
		actions = discardActions,
		onPresentedChange = function(v: boolean) confirmDiscard:set(v) end,
		content = function()
			return UI.Text { wrap = true, text = "Your unsaved livery changes will be lost. Keep editing to return to your draft." }
		end,
	}
	return { sheet, dialog }
end
]]></ProtectedString>
							<string name="ScriptGuid">{C7580D1E-E7B5-4944-A3F1-83BA528ED400}</string>
