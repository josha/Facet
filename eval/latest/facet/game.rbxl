						<Item class="StringValue" referent="578">
							<Properties>
								<string name="Value"><![CDATA[# LevelPicker.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
allowZero: boolean? = omitted
count: number? = omitted
enabled: ValueBoolean? = omitted
glyphs: Glyphs? = omitted
images: Images? = omitted
onChange: OnChangeField = required
readOnly: ReadOnlyField = required
ref: ((TextButton) -> ())? = omitted
segment: ("bar" | "glyph" | "image")? = omitted
segmentSize: ("small" | "medium" | "large")? = omitted
tint: Tint? = omitted
value: ValueField = required
Glyphs = { read filled: string, read empty: string }
Images = { read filled: string, read empty: string }
Tint = { read filled: Input<Color3>?, read empty: Input<Color3>? }]]></string>
