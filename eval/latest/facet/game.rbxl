						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Rewards: seven-day track, quests, boosts and the timed offer.
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local C = Facet.Compose

local page = C.cell("daily")
local claiming = C.cell(false)

return function(ctx: any): any
	local UI, Store = ctx.UI, ctx.Store
	local env = ctx.env
	local function prof(use: Facet.Use): any return use(Store.profile) or { daily = { streak = 0, lastDay = -1 }, questsClaimed = {}, boosts = {}, offer = { expires = 0, bought = false } } end
	-- Mirrors the server's daily rules for display; the server decides each claim.
	local function daily(use: Facet.Use): any
		use(Store.clock)
		local d = prof(use).daily
		local today = math.floor(Store.now() / 86400)
		local streak, missed = d.streak, false
		if d.lastDay >= 0 and today > d.lastDay + 1 then streak, missed = 0, true
		elseif d.streak >= 7 and today > d.lastDay then streak = 0 end
		return { streak = streak, ready = d.lastDay ~= today, missed = missed, nextAt = (today + 1) * 86400 }
	end
	local pageOptions: { Facet.PickerOption<string> } = { { value = "daily", label = "Daily" }, { value = "quests", label = "Quests" }, { value = "boosts", label = "Boosts & Offer" } }

	local dayRows = {}
	for _, r in GameData.Daily do
		local function st(use: Facet.Use): string
			local d = daily(use)
			if r.day <= d.streak then return "claimed" end
			if r.day == d.streak + 1 and d.ready then return "ready" end
			return "locked"
		end
		table.insert(dayRows, UI.VStack("Day" .. r.day) { gap = "xs", surface = "panel", padding = "s", Size = UDim2.fromOffset(env.scaled(r.special and 200 or 120), 0),
			UI.Text { text = (if r.special then "★ DAY 7" else "DAY " .. r.day), textRole = "label" },
			UI.Text { text = r.label, wrap = true, textRole = if r.special then "strong" else "body" },
			UI.Text { textRole = "strong", text = function(use: Facet.Use): string
				local s = st(use)
				return if s == "claimed" then "✓ Claimed" elseif s == "ready" then "● Ready" else "🔒 Locked"
			end },
		})
	end
	local questRows = {}
	for _, q in GameData.Quests do
		local function progress(use: Facet.Use): number return math.min(q.goal, prof(use)[q.stat] or 0) end
		table.insert(questRows, UI.VStack("Quest_" .. q.id) { width = "fill", gap = "xs", surface = "panel", padding = "s",
			UI.HStack "Head" { width = "fill", gap = "s",
				UI.Text { text = q.label, textRole = "strong", UI.fill(), wrap = true },
				UI.Text { textRole = "caption", text = string.format("+%s Credits%s", Store.fmt(q.credits), if q.gems > 0 then " +" .. q.gems .. " Gems" else "") } },
			UI.ProgressView "Progress" { value = function(use: Facet.Use): number return progress(use) / q.goal end,
				endLabel = function(use: Facet.Use): string return progress(use) .. "/" .. q.goal end },
			UI.Button "Claim" {
				label = function(use: Facet.Use): string
					if prof(use).questsClaimed[q.id] then return "✓ Claimed" end
					return if progress(use) >= q.goal then "Claim reward" else "In progress"
				end,
				appearance = function(use: Facet.Use): string return if progress(use) >= q.goal and not prof(use).questsClaimed[q.id] then "emphasis" else "standard" end,
				enabled = function(use: Facet.Use): boolean return progress(use) >= q.goal and not prof(use).questsClaimed[q.id] end,
				onActivate = function() ctx.req("claimQuest", q.id) end },
		})
	end
	local boostRows = {}
	for _, b in GameData.Boosts do
		table.insert(boostRows, UI.HStack("Boost_" .. b.id) { width = "fill", gap = "s", surface = "panel", padding = "s",
			UI.VStack "Info" { UI.fill(), gap = "xs",
				UI.Text { text = b.name .. " · " .. b.gems .. " Gems", textRole = "strong" },
				UI.Text { textRole = "caption", wrap = true, text = function(use: Facet.Use): string
					use(Store.clock)
					local exp = prof(use).boosts[b.id]
					local active = if exp and exp > Store.now() then " Active · " .. Store.clockText(exp - Store.now()) .. " left." else ""
					return b.blurb .. active
				end } },
			UI.Button "Buy" { label = function(use: Facet.Use): string
					use(Store.clock)
					local exp = prof(use).boosts[b.id]
					return if exp and exp > Store.now() then "Extend" else "Activate"
				end,
				enabled = function(use: Facet.Use): boolean return (prof(use).gems or 0) >= b.gems end,
				onActivate = function()
					ctx.confirm({ title = "Activate " .. b.name .. "?", lines = { b.blurb, "Price: " .. b.gems .. " Gems" }, confirm = "Spend " .. b.gems .. " Gems", gems = b.gems,
						run = function() return Store.request("buyBoost", b.id) end })
				end },
		})
	end
	local o = GameData.Offer
	local function offerState(use: Facet.Use): (boolean, string)
		use(Store.clock)
		local p = prof(use)
		if p.offer.bought then return false, "Already purchased" end
		if Store.now() >= p.offer.expires then return false, "Offer expired" end
		if (p.level or 1) >= o.maxLevel then return false, "Only for racers below level " .. o.maxLevel end
		return true, "Ends in " .. Store.clockText(p.offer.expires - Store.now())
	end

	return UI.Sheet "Rewards" {
		title = "Rewards", isPresented = ctx.open.rewards, placement = "center", width = "wide", detents = { "hug" },
		content = function()
			return UI.VStack "Body" { width = "fill", gap = "m", maxWidth = env.scaled(680),
				UI.Picker "Page" { selected = page, options = pageOptions, style = "segmented" },
				UI.VStack "Daily" { width = "fill", gap = "s",
					Visible = function(use: Facet.Use): boolean return use(page) == "daily" end,
					UI.Text { text = "7-day streak", textRole = "heading" },
					UI.Text { wrap = true, textRole = "strong", text = function(use: Facet.Use): string
						local d = daily(use)
						if d.missed then return "You missed a day, so the track restarted at Day 1." end
						if d.ready then return "Day " .. (d.streak + 1) .. " is ready to claim." end
						return "Next reward in " .. Store.clockText(d.nextAt - Store.now())
					end },
					UI.HStack "Days" { width = "fill", wrap = true, gap = "s", table.unpack(dayRows) },
					UI.Button "Claim" { appearance = "emphasis", busy = claiming,
						label = function(use: Facet.Use): string
							local d = daily(use)
							return if d.ready then "Claim Day " .. (d.streak + 1) else "Claimed · next in " .. Store.clockText(d.nextAt - Store.now())
						end,
						enabled = function(use: Facet.Use): boolean return daily(use).ready and not use(claiming) end,
						onActivate = function()
							if claiming:peek() then return end
							claiming:set(true)
							ctx.req("claimDaily")
							claiming:set(false)
						end },
				},
				UI.VStack "Quests" { width = "fill", gap = "s",
					Visible = function(use: Facet.Use): boolean return use(page) == "quests" end,
					table.unpack(questRows),
				},
				UI.VStack "Boosts" { width = "fill", gap = "s",
					Visible = function(use: Facet.Use): boolean return use(page) == "boosts" end,
					UI.Text { text = "Boosts", textRole = "heading" },
					boostRows[1], boostRows[2],
					UI.VStack "Offer" { width = "fill", gap = "xs", surface = "panel", padding = "m",
						UI.Text { text = "TIMED OFFER · " .. o.name, textRole = "label" },
						UI.Text { text = o.blurb, wrap = true },
						UI.Text { text = "Price: " .. o.gems .. " Gems", textRole = "strong" },
						UI.Text { textRole = "caption", text = function(use: Facet.Use): string local _, why = offerState(use) return why end },
						UI.Button "BuyOffer" { label = "Buy pack · " .. o.gems .. " Gems", appearance = "emphasis",
							enabled = function(use: Facet.Use): boolean local ok = offerState(use) return ok and (prof(use).gems or 0) >= o.gems end,
							onActivate = function()
								ctx.confirm({ title = "Buy " .. o.name .. "?", lines = { o.blurb, "Price: " .. o.gems .. " Gems" }, confirm = "Buy for " .. o.gems .. " Gems", gems = o.gems,
									run = function() return Store.request("buyOffer") end })
							end },
					},
				},
			}
		end,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{15AD64A9-59D3-4061-980E-5F29FB0E4329}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
