							<ProtectedString name="Source"><![CDATA[--!strict
local Compose = require("../vendor/compose/core")
local Engine = require("./engine_types")
local Layout = require("./layout_types")

local Media = require("./media_types")
local Types = require("./types")

export type StackProps = {
	Changed: ((string) -> ())?,
	Attributes: Engine.Attributes?,
	AncestryChanged: ((Instance, Instance?) -> ())?,
	Archivable: Engine.ValueBoolean?,
	AttributeChanged: ((string) -> ())?,
	Capabilities: Engine.ValueSecurityCapabilities?,
