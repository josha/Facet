							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Livery</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">73c8afe78d24b4d30afced1100001fa4</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXFC8F8D90B9D244E3BB677958CF1BD9CB">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Parts and drivers: equip one part per slot, choose, buy or rent a driver.
local Facet = require(game.ReplicatedStorage.Packages.Facet)
local GameData = require(game.ReplicatedStorage.Shared.GameData)
local C = Facet.Compose

local page = C.cell("parts")
local group = C.cell("All")
local inspectedPart = C.cell("")

return function(ctx: any): any
	local UI, Store = ctx.UI, ctx.Store
	local env = ctx.env
	local function prof(use: Facet.Use): any return use(Store.profile) or { ownedParts = {}, equipped = {}, drivers = {}, rentals = {} } end
	local pageOptions: { Facet.PickerOption<string> } = { { value = "parts", label = "Parts" }, { value = "drivers", label = "Drivers" } }
	local groupOptions: { Facet.PickerOption<string> } = { { value = "All", label = "All groups" } }
	for _, g in GameData.DriverGroups do table.insert(groupOptions, { value = g, label = g }) end

	local function effect(part: any): string
		local bits = {}
		if part.speed ~= 0 then table.insert(bits, string.format("%+d speed", part.speed)) end
		if part.handling ~= 0 then table.insert(bits, string.format("%+d handling", part.handling)) end
		if part.boost ~= 0 then table.insert(bits, string.format("%+d boost", part.boost)) end
		return if #bits > 0 then table.concat(bits, ", ") else part.blurb
	end

	local function slotRow(slot: string): Instance
		return UI.HStack("Slot_" .. slot) { width = "fill", gap = "s", surface = "panel", padding = "s",
			UI.Text { text = GameData.SlotLabel[slot], textRole = "label", Size = UDim2.fromOffset(env.scaled(90), 0) },
			UI.Text { UI.fill(), wrap = true, text = function(use: Facet.Use): string
				local id = prof(use).equipped[slot]
				local part = id and GameData.find(GameData.Parts, id) :: any
				return if part then part.name .. " · " .. effect(part) else "Empty slot"
			end, textRole = function(use: Facet.Use): string return if prof(use).equipped[slot] then "strong" else "caption" end },
			UI.Button "Unequip" { label = "Unequip",
				Visible = function(use: Facet.Use): boolean return prof(use).equipped[slot] ~= nil end,
				onActivate = function() ctx.req("equip", { slot = slot, id = nil }, true) end },
		}
	end

	local function partRow(part: any): Instance
		local function stateOf(use: Facet.Use): string
			local p = prof(use)
			if p.equipped[part.slot] == part.id then return "equipped" end
			if p.ownedParts[part.id] then return "owned" end
			return "locked"
		end
		return UI.HStack("Part_" .. part.id) { width = "fill", gap = "s",
			UI.Button "Inspect" { UI.fill(),
				label = function(use: Facet.Use): string
					local st = stateOf(use)
					return (if st == "equipped" then "✓ " elseif st == "locked" then "🔒 " else "") .. part.name
				end,
				subtitle = function(use: Facet.Use): string
					local st = stateOf(use)
					local status = if st == "equipped" then "Equipped" elseif st == "owned" then "Owned" else "Not owned · buy in Shop"
					return GameData.SlotLabel[part.slot] .. " · " .. effect(part) .. " · " .. status
				end,
				appearance = function(use: Facet.Use): string return if use(inspectedPart) == part.id then "emphasis" else "standard" end,
				onActivate = function() inspectedPart:set(part.id) end },
			UI.Button "Act" {
				label = function(use: Facet.Use): string
					local st = stateOf(use)
					return if st == "equipped" then "Unequip" elseif st == "owned" then "Equip" else "Unavailable"
				end,
				enabled = function(use: Facet.Use): boolean return stateOf(use) ~= "locked" end,
				onActivate = function()
					local p = Store.profile:peek()
					if p.equipped[part.slot] == part.id then
						ctx.req("equip", { slot = part.slot, id = nil }, true)
					else
						ctx.req("equip", { slot = part.slot, id = part.id }, true)
					end
				end },
		}
	end

	local function driverStats(d: any): string
		return string.format("Accel +%d · Drift +%d · Boost +%d", d.accel, d.drift, d.boost)
	end
	local function driverRow(d: any): Instance
		local cur = GameData.driverCurrency(d)
		local function rentLeft(use: Facet.Use): number
			use(Store.clock)
			local exp = prof(use).rentals[d.id]
			return if exp then exp - Store.now() else 0
		end
		local function usable(use: Facet.Use): boolean
			local p = prof(use)
			return p.drivers[d.id] == true or rentLeft(use) > 0
		end
		local function confirmSpend(kind: string)
			local amount = if kind == "buy" then d.price else d.rent
			local unit = if cur == "gems" then "Gems" else "Credits"
			ctx.confirm({
				title = (if kind == "buy" then "Hire " else "Rent ") .. d.name .. "?",
				lines = { d.name .. " · " .. d.group, driverStats(d), if kind == "buy" then "Permanent ownership" else "Rental lasts 10 minutes", "Full price: " .. Store.fmt(amount) .. " " .. unit },
				confirm = (if kind == "buy" then "Buy for " else "Rent for ") .. Store.fmt(amount) .. " " .. unit,
				credits = if cur == "credits" then amount else nil, gems = if cur == "gems" then amount else nil,
				run = function() return Store.request(if kind == "buy" then "buyDriver" else "rentDriver", d.id) end })
		end
		return UI.VStack("Driver_" .. d.id) { width = "fill", gap = "xs", surface = "panel", padding = "s",
			Visible = function(use: Facet.Use): boolean local g = use(group) return g == "All" or g == d.group end,
			UI.HStack "Head" { width = "fill", gap = "s",
				UI.Text { text = d.name, textRole = "heading" },
				UI.Text { text = d.group, textRole = "caption" },
				UI.Spacer {},
				UI.Text { textRole = "strong", text = function(use: Facet.Use): string
					local p = prof(use)
					if p.selectedDriver == d.id and usable(use) then return "✓ DRIVING" end
					if p.drivers[d.id] then return "Owned" end
					local left = rentLeft(use)
					if left > 0 then return "Rented · " .. Store.clockText(left) .. " left" end
					return "Locked"
				end } },
			UI.Text { text = driverStats(d) .. " · " .. d.blurb, wrap = true, textRole = "caption" },
			UI.HStack "Actions" { width = "fill", gap = "s", wrap = true,
				UI.Button "Select" { label = "Drive", enabled = function(use: Facet.Use): boolean return usable(use) and prof(use).selectedDriver ~= d.id end,
					onActivate = function() ctx.req("selectDriver", d.id, true) end },
				UI.Button "Buy" { label = "Buy · " .. Store.fmt(d.price) .. (if cur == "gems" then " Gems" else " Credits"),
					Visible = function(use: Facet.Use): boolean return not prof(use).drivers[d.id] and d.price > 0 end,
					onActivate = function() confirmSpend("buy") end },
				UI.Button "Rent" { label = "Rent 10 min · " .. Store.fmt(d.rent) .. (if cur == "gems" then " Gems" else " Credits"),
					Visible = function(use: Facet.Use): boolean return not prof(use).drivers[d.id] and d.rent > 0 end,
					enabled = function(use: Facet.Use): boolean return rentLeft(use) <= 0 end,
					onActivate = function() confirmSpend("rent") end },
			},
		}
	end

	return UI.Sheet "Inventory" {
		title = "Parts & Drivers", isPresented = ctx.open.inventory, placement = "center", width = "wide", detents = { "hug" },
		content = function()
			local slots, parts, drivers = {}, {}, {}
			for _, s in GameData.PartSlots do table.insert(slots, slotRow(s)) end
			for _, p in GameData.Parts do table.insert(parts, partRow(p)) end
			for _, d in GameData.Drivers do table.insert(drivers, driverRow(d)) end
			return UI.VStack "Body" { width = "fill", gap = "m", maxWidth = env.scaled(640),
				UI.Picker "Page" { selected = page, options = pageOptions, style = "segmented" },
				UI.VStack "Parts" { width = "fill", gap = "s",
					Visible = function(use: Facet.Use): boolean return use(page) == "parts" end,
					UI.Text { text = "EQUIPPED · one part per slot, used in your next race", textRole = "label" },
					UI.VStack "Slots" { width = "fill", gap = "xs", table.unpack(slots) },
					UI.Text { textRole = "caption", wrap = true, text = function(use: Facet.Use): string
						local id = use(inspectedPart)
						local part = GameData.find(GameData.Parts, id) :: any
						if not part then return "Select a part to inspect its effect." end
						return part.name .. ": " .. effect(part) .. ". Equipping replaces the current " .. GameData.SlotLabel[part.slot] .. "."
					end },
					UI.VStack "All" { width = "fill", gap = "xs", table.unpack(parts) },
				},
				UI.VStack "Drivers" { width = "fill", gap = "s",
					Visible = function(use: Facet.Use): boolean return use(page) == "drivers" end,
					UI.Picker "Group" { selected = group, options = groupOptions, style = "segmented" },
					UI.Text { textRole = "caption", wrap = true, text = function(use: Facet.Use): string
						local p = prof(use)
						local d = GameData.find(GameData.Drivers, p.selectedDriver or "kit") :: any
						return "Current driver: " .. (d and (d.name .. " · " .. driverStats(d)) or "Kit")
					end },
					table.unpack(drivers),
				},
			}
		end,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{27552EFB-CB4D-4A79-9240-B2EA698894DF}</string>
