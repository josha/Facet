						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local transitions = require("./transition")
local presentationReadiness = require("./presentation_readiness")
local preparation = require("./preparation")

export type PageLayers = {
	content: <P>(Instance | ((Nav.NavigationEntry<P>?) -> Instance), Nav.NavigationEntry<P>?) -> Instance,
	checkTransition: (Nav.Transition | false?) -> (),
	layer: (
		Types.CanvasGroupProps,
		ComposeTypes.ReadOnlyValue<ComposeTypes.LayerStackState>,
		Nav.Transition | false?,
		(() -> ())?,
		boolean?,
		ComposeTypes.Value<boolean>?,
		ComposeTypes.ReadOnlyValue<boolean>?,
		boolean?
	) -> GuiObject,
	checkedSelection: (ComposeTypes.Value<string>, { Nav.Tab }, string) -> { [string]: Nav.Tab },
}

return function(ctx: Types.Context): PageLayers
	local Host, Compose, runtime = ctx.Host, ctx.Compose, ctx.runtime
	local function content<P>(
		builder: Instance | ((Nav.NavigationEntry<P>?) -> Instance),
		entry: Nav.NavigationEntry<P>?
	): Instance
		return if type(builder) == "function" then builder(entry) else builder
	end
	local checkTransition = transitions.check
	local function plate(panel: GuiObject, scale: ComposeTypes.ReadOnlyValue<number>)
		local ancestry = Compose.cell(0)
		runtime.connect(panel, "AncestryChanged", function()
			ancestry:set(ancestry:peek() + 1)
		end)
		local zooming = Compose.formula(function(use: ComposeTypes.Use): boolean
			return use(scale) ~= 1
		end)
		local backdrop = Compose.formula(function(use: ComposeTypes.Use): Color3?
			if not use(zooming) then
				return nil
			end
			use(ancestry)
			local at: Instance? = panel.Parent
			while at do
				if at:IsA("GuiObject") and (at:GetStyled("BackgroundTransparency")) < 1 then
					return at:GetStyled("BackgroundColor3")
				end
				at = at.Parent
			end
			return nil
		end)
		runtime.mountFragment(function()
			return {
				Compose.show(function(use: ComposeTypes.Use): boolean
					return use(backdrop) ~= nil
				end, function()
					local color = assert(backdrop:peek())
					return Host.Frame "TransitionPlate" {
						AnchorPoint = ctx.types.Vector2.new(0.5, 0.5),
						Position = ctx.types.UDim2.fromScale(0.5, 0.5),
						Size = ctx.types.UDim2.fromScale(1, 1),
						BorderSizePixel = 0,
						ZIndex = 0,
						Interactable = false,
						BackgroundColor3 = function(use: ComposeTypes.Use): Color3
							color = use(backdrop) or color
							return color
						end,
						Host.UIScale "TransitionScale" {
							Scale = scale,
						},
					}
				end),
			}
		end, panel)
	end
	local function layer(
		properties: Types.CanvasGroupProps,
		state: ComposeTypes.ReadOnlyValue<ComposeTypes.LayerStackState>,
		transition: Nav.Transition | false?,
		hidden: (() -> ())?,
		immediate: boolean?,
		prepared: ComposeTypes.Value<boolean>?,
		groupReady: ComposeTypes.ReadOnlyValue<boolean>?,
		holdOnExit: boolean?
	): GuiObject
		if transition == nil or transition == false then
			local node = Host.Frame(properties)
			if hidden then
				Compose.watch(function(use: ComposeTypes.Use)
					if not use(state).top then
						hidden()
					end
				end)
			end
			return node
		end
		local presented = Compose.formula(function(use: ComposeTypes.Use): boolean
			return use(state).top
		end)
		local animatedPresented: ComposeTypes.ReadOnlyValue<boolean> = presented
		if groupReady then
			local synchronized = Compose.cell(presented:peek())
			Compose.watch(function(use: ComposeTypes.Use)
				if use(groupReady) then
					synchronized:set(use(presented))
				end
			end)
			animatedPresented = synchronized
		end
		local frames = ctx.config.services.RunService
		local arrived: ComposeTypes.Value<boolean> = prepared or Compose.cell(false)
		arrived:set(frames == nil or frames.PreRender == nil or runtime.host.frames == nil)
		local moving = transitions.create(
			ctx,
			transition,
			presented,
			immediate,
			if immediate then nil else arrived,
			nil,
			animatedPresented,
			holdOnExit
		)
		local content: Frame? = nil
		local pageZoom = if transition.zoom ~= nil then moving.zoom else nil
		if transition.apply or pageZoom then
			content = Host.Frame {
				Name = "TransitionContent",
				BackgroundTransparency = 1,
				AnchorPoint = if pageZoom then ctx.types.Vector2.new(0.5, 0.5) else nil,
				Position = if pageZoom then ctx.types.UDim2.fromScale(0.5, 0.5) else nil,
				Size = ctx.types.UDim2.fromScale(1, 1),
				if pageZoom then Host.UIScale "TransitionZoom" { Scale = pageZoom } else nil,
			}
			local children: { Types.Child } = {}
			local entries = properties
			for index, child in entries do
				if type(index) == "number" then
					children[index] = properties[index]
				end
			end
			for index in entries do
				if type(index) == "number" then
					properties[index] = nil
				end
			end
			runtime.mountFragment(function()
				return children
			end, content)
			properties[1] = content
		end
		properties.GroupTransparency = function(use: ComposeTypes.Use)
			return if not use(arrived) then 1 else use(moving.transparency)
		end
		properties.Visible = moving.visible
		properties.Interactable = function(use: ComposeTypes.Use)
			return use(arrived)
				and use(state).top
				and not use(moving.interacting)
				and (
					(
						transition.apply == nil
						and transition.progress == nil
						and transition.scale == nil
						and transition.zoom == nil
					) or use(moving.opacity) == 1
				)
		end
		local panel = ctx.fade(properties, nil, if properties.BackgroundTransparency == 1 then false else nil)
		moving.apply(content or panel, panel)
		local scale = moving.scale
		if scale then
			plate(panel, scale)
		end
		local zoom = moving.zoom
		if zoom then
			Compose.watch(function(use: ComposeTypes.Use)
				panel:SetAttribute("FacetTransitionZoom", use(zoom))
			end)
		end
		if not arrived:peek() and runtime.host.frames then
			local ready = presentationReadiness(ctx, { panel })
			preparation.begin(ctx, panel)
			Compose.watch(function(use: ComposeTypes.Use)
				if use(ready) then
					arrived:set(true)
					preparation.finish(ctx, panel)
				end
			end)
		end
		if hidden then
			Compose.watch(function(use: ComposeTypes.Use)
				if use(moving.completed) then
					hidden()
				end
			end)
		end
		return panel
	end

	local function checkedSelection(
		selection: ComposeTypes.Value<string>,
		entries: { Nav.Tab },
		label: string
	): { [string]: Nav.Tab }
		assert(selection and selection.set, label .. ".selection requires a writable Compose cell")
		assert(type(entries) == "table" and #entries > 0, label .. " requires entries")
		local byId: { [string]: Nav.Tab } = {}
		for _, entry in entries do
			assert(type(entry.id) == "string" and byId[entry.id] == nil, label .. " entries require unique string ids")
			byId[entry.id] = entry
		end
		assert(byId[selection:peek()], label .. ".selection must name an entry")
		return byId
	end
	return {
		content = content,
		checkTransition = checkTransition,
		layer = layer,
		checkedSelection = checkedSelection,
	}
end
]]></ProtectedString>
							<string name="ScriptGuid">{383B4E99-AA1D-43A7-AED5-2B2267BDB151}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">nav_page_layers</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">73c8afe78d24b4d30afced1100000495</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="184">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local ControlTypes = require("./control_types")
local Types = require("./types")
local Nav = require("./navigation_types")
local ComposeTypes = require("../vendor/compose/core")
local reducedMotion = require("./motion").reduced
local NavigationProps = require("./navigation_props")
local CollectionProps = require("./collection_props")
local pageLayers = require("./nav_page_layers")
local contacts = require("./input_contacts")
local settling = require("./settle")

return function(
	ctx: Types.Context,
	UI: ControlTypes.Controls,
	surfaces: Nav.Surfaces,
	layers: pageLayers.PageLayers
): ()
	local Host, Compose, runtime = ctx.Host, ctx.Compose, ctx.runtime
	local E, D2, V2 = ctx.types.Enum, ctx.types.UDim2, ctx.types.Vector2
	local checkedSelection = layers.checkedSelection
	local readNumber = ctx.read<<number?>>
	UI.PageView = ctx.construct("PageView", function(spec: NavigationProps.PageViewSpec): Frame
		assert(
			spec.indicatorPlacement == nil
				or spec.indicatorPlacement == "footer"
				or spec.indicatorPlacement == "overlay",
			"PageView.indicatorPlacement must be footer or overlay"
		)
		local overlayIndicators = spec.indicatorPlacement == "overlay"
		local byId = checkedSelection(spec.selection, spec.pages, "PageView")
		local indexById: { [string]: number } = {}
		for index, page in spec.pages do
			indexById[page.id] = index
		end
		local footerHeight = (if spec.summary ~= false then 24 else 0)
			+ (if spec.indicators ~= false and not overlayIndicators then 48 else 0)
			+ (if spec.controls ~= false then 48 else 0)
		local pageNodes: { [string]: Frame } = {}
		local reduced = reducedMotion(ctx)
		local hugs = spec.AutomaticSize == E.AutomaticSize.Y or spec.AutomaticSize == E.AutomaticSize.XY
		local tallest = Compose.cell(0)
		local heights: { ComposeTypes.ReadOnlyValue<Vector2> } = {}
		for index, page in spec.pages do
			local content = page.content
			local body = if type(content) == "function" then content() else content
			if hugs and body:IsA("GuiObject") then
				table.insert(heights, ctx.observe.AbsoluteSize(body))
			end
			local node = Host.Frame(page.id)({
				BackgroundTransparency = 1,
				Size = D2.fromScale(1, 1),
				LayoutOrder = index,
				body,
			})
			pageNodes[page.id] = node
		end
		local width = Compose.cell(1)
		local effectiveInput = ctx.effectiveInput()
		local function nativeScroll(use: ComposeTypes.Use): boolean
			return effectiveInput(use) == "Touch" or ctx.read(spec.scrollWheel, use) == true
		end
		local function Page(current: ComposeTypes.ReadOnlyValue<Nav.Tab>): GuiObject
			return assert(pageNodes[current:peek().id])
		end
		local pageSpec: CollectionProps.KeyedCollectionSpec<Nav.Tab, string> = {
			from = spec.pages,
			key = function(page: Nav.Tab): string
				return page.id
			end,
			render = Page,
			mode = "all",
			direction = "horizontal",
			itemSize = width,
			gap = 0,
			Active = nativeScroll,
			ScrollingEnabled = nativeScroll,
			ScrollBarThickness = 0,
			Selectable = true,
			ElasticBehavior = E.ElasticBehavior.Never,
			BackgroundTransparency = 1,
			Size = function(use: ComposeTypes.Use)
				return if hugs then D2.new(1, 0, 0, use(tallest)) else D2.new(1, 0, 1, -footerHeight)
			end,
			ClipsDescendants = true,
		}
		local pages = UI.VirtualList(pageSpec, "Pages")
		local held = Compose.cell(false)
		local target: number? = nil
		local paused = if spec.autoAdvanceSeconds ~= nil then Compose.cell(false) else nil
		local hovering = false
		local cooling = false
		local later = runtime.scheduler()
		local parent = ctx.observe.Parent(pages)
		local available = surfaces.available(pages)
		local gui = surfaces.service("GuiService")
		local focusPending = false
		local unit = ctx.layoutUnit(pages)
		local size = ctx.observe.AbsoluteWindowSize(pages)
		local canvasSize = ctx.observe.AbsoluteCanvasSize(pages)
		local function pageOffset(index: number, box: Vector2, canvas: Vector2): number
			return math.clamp((index - 1) * box.X, 0, math.max(0, canvas.X - box.X))
		end
		local function nearestPage(at: number, box: Vector2): number
			return math.clamp(math.floor(at / box.X + 0.5) + 1, 1, #spec.pages)
		end
		local initialized = Compose.cell(false)
		local snapTarget = 0
		local snapping = false
		local glide = settling(ctx, function()
			return snapTarget
		end, ctx.motionSpring("control"))
		local frames = assert(runtime.host.frames)
		local startIndex, previous, previousTime, velocity = 1, 0, frames.now(), 0
		local function stopSnap()
			snapping = false
			glide.halt()
		end
		Compose.watch(function(use: ComposeTypes.Use)
			local offset = use(glide.value)
			if snapping then
				pages:ResetScrollVelocity()
				pages.CanvasPosition = V2.new(offset or snapTarget, 0)
				if offset == nil then
					snapping = false
				end
			end
		end)
		contacts(ctx, pages, function()
			later.cancel("wheel")
			stopSnap()
			target = nil
			held:set(true)
			UI.scrollTo(pages, pages.CanvasPosition, { animated = false })
			pages:ResetScrollVelocity()
			local box = size:peek()
			startIndex = if box.X > 0
				then nearestPage(pages.CanvasPosition.X, box)
				else indexById[spec.selection:peek()]
			previous, previousTime, velocity = pages.CanvasPosition.X, frames.now(), 0
			later.cancel("resume")
			cooling = false
			if paused then
				paused:set(true)
			end
		end, function(cancelled)
			local box, canvas = size:peek(), canvasSize:peek()
			if initialized:peek() and box.X > 0 then
				local at = pages.CanvasPosition.X
				local speed = pages:GetScrollVelocity().X
				if speed == 0 and frames.now() - previousTime <= ctx.metric("motion.fling.projection") then
					speed = velocity
				end
				local distance = at - pageOffset(startIndex, box, canvas)
				local direction = if not cancelled
						and math.abs(speed) >= ctx.metric("motion.fling.bounceSpeed")
					then math.sign(speed)
					elseif not cancelled and math.abs(distance) > box.X / 2 then math.sign(distance)
					else 0
				local index = math.clamp(startIndex + direction, 1, #spec.pages)
				snapTarget = pageOffset(index, box, canvas)
				target = snapTarget
				pages:ResetScrollVelocity()
				snapping = true
				if not glide.launch(at, 0, ctx.motionSpring("control")) then
					snapping = false
					pages.CanvasPosition = V2.new(snapTarget, 0)
				end
			end
			cooling = true
			held:set(false)
			later.replace("resume", ctx.metric("motion.durations.scrollReveal"), function()
				cooling = false
				if paused then
					paused:set(hovering or held:peek())
				end
			end)
		end)
		local wasAvailable, lastWidth = false, 0
		Compose.watch(function(use: ComposeTypes.Use)
			local box = use(size)
			local id = use(spec.selection)
			assert(byId[id], "PageView.selection must name a declared page")
			local scale = use(unit)
			if box.X > 0 then
				width:set(box.X / math.max(scale, 0.001))
			end
			if box.X <= 0 or not use(parent) or not use(available) then
				wasAvailable = false
				initialized:set(false)
				return
			end
			local resized = lastWidth ~= box.X
			local canvas = use(canvasSize)
			local expected = D2.fromOffset(box.X / math.max(scale, 0.001) * #spec.pages, 0).X.Offset * scale
			if math.abs(canvas.X - expected) > 0.5 then
				initialized:set(false)
				return
			end
			stopSnap()
			later.cancel("wheel")
			target = pageOffset(indexById[id], box, canvas)
			if gui and surfaces.within(gui.SelectedObject, pages) then
				focusPending = true
			end
			initialized:set(true)
			if
				not UI.scrollTo(
					pages,
					V2.new(target, 0),
					{ animated = wasAvailable and not resized and not reduced(use) }
				)
			then
				target = nil
			end
			wasAvailable, lastWidth = true, box.X
		end)
		local position = ctx.observe.CanvasPosition(pages)
		Compose.watch(function(use: ComposeTypes.Use)
			local at = use(position).X
			if held:peek() then
				local now = frames.now()
				if now > previousTime then
					velocity = (at - previous) / (now - previousTime)
				end
				previous, previousTime = at, now
			end
			local box = use(size)
			if not held:peek() and not target and not snapping and initialized:peek() and box.X > 0 then
				local index = nearestPage(at, box)
				local boundary = pageOffset(index, box, canvasSize:peek())
				if math.abs(at - boundary) >= 0.5 then
					later.replace("wheel", ctx.metric("motion.durations.scrollReveal"), function()
						snapTarget, target, snapping = boundary, boundary, true
						pages:ResetScrollVelocity()
						if not glide.launch(pages.CanvasPosition.X, 0) then
							snapping = false
							pages.CanvasPosition = V2.new(boundary, 0)
						end
					end)
				end
			end
			if
				not use(initialized)
				or not use(available)
				or use(held)
				or box.X <= 0
				or (target and math.abs(at - target) > 0.5)
			then
				return
			end
			target = nil
			local index = nearestPage(at, box)
			if math.abs(at - pageOffset(index, box, use(canvasSize))) < 0.5 then
				local id = spec.pages[index].id
				if spec.selection:peek() ~= id then
					spec.selection:set(id)
				end
				local page = pageNodes[id]
				local selected = if gui then gui.SelectedObject else nil
				if gui and ((focusPending and selected == nil) or surfaces.within(selected, pages)) then
					focusPending = false
					if not surfaces.within(selected, page) then
						local nextControl: GuiObject? = nil
						for _, node in page:GetChildren() do
							nextControl = surfaces.firstSelectable(node)
							if nextControl then
								break
							end
						end
						if nextControl == nil then
							page.Selectable = true
							nextControl = page
						end
						gui.SelectedObject = nextControl
					end
				end
			end
		end)
		if paused then
			local interaction = paused
			local focused = if gui then ctx.observe.SelectedObject(gui) else nil
			runtime.connect(pages, "MouseEnter", function()
				hovering = true
				interaction:set(true)
			end)
			runtime.connect(pages, "MouseLeave", function()
				hovering = false
				interaction:set(held:peek() or cooling)
			end)
			Compose.watch(function(use: ComposeTypes.Use)
				local seconds = readNumber(spec.autoAdvanceSeconds, use)
				local id = use(spec.selection)
				local held = use(interaction)
				local selected = if focused then use(focused) else nil
				later.cancel("advance")
				if seconds == nil then
					return
				end
				assert(seconds > 0 and seconds < math.huge, "PageView.autoAdvanceSeconds must be finite and positive")
				if held or (selected and surfaces.within(selected, pages)) or #spec.pages < 2 then
					return
				end
				later.replace("advance", seconds, function()
					spec.selection:set(spec.pages[indexById[id] % #spec.pages + 1].id)
				end)
			end)
		end
		local function step(amount: number): ()
			local at = math.clamp(indexById[spec.selection:peek()] + amount, 1, #spec.pages)
			spec.selection:set(spec.pages[at].id)
		end
		if gui and ctx.action then
			local selectedObject = ctx.observe.SelectedObject(gui)
			local function inside(use: ComposeTypes.Use): boolean
				return surfaces.within(use(selectedObject), pages)
			end
			ctx.action(pages, "PageForward", { E.KeyCode.Right, E.KeyCode.DPadRight }, inside, function()
				step(1)
			end, { priority = 1500, capture = true })
			ctx.action(pages, "PageBack", { E.KeyCode.Left, E.KeyCode.DPadLeft }, inside, function()
				step(-1)
			end, { priority = 1500, capture = true })
		end
		local footer: { Types.Child } = {}
		local indicatorRow: GuiObject? = nil
		if spec.summary ~= false then
			table.insert(
				footer,
				ctx.text({
					Name = "Summary",
					Text = function(use: ComposeTypes.Use)
						return ctx.phrase(
							"Facet.PageOf",
							"Page {current} of {count}",
							{ current = indexById[use(spec.selection)], count = #spec.pages },
							use
						)
					end,
				})
			)
		end
		if spec.indicators ~= false then
			local dots: { ComposeTypes.Child } = {}
			for index, page in spec.pages do
				local id = page.id
				local dot = UI.Button(id)({
					name = function(use: ComposeTypes.Use): string
						return ctx.phrase(
							"Facet.PageOf",
							"Page {current} of {count}",
							{ current = index, count = #spec.pages },
							use
						)
					end,
					LayoutOrder = index,
					Size = D2.fromOffset(if overlayIndicators then 24 else 44, 44),
					target = if overlayIndicators then "inline" else "hit",
					AutomaticSize = E.AutomaticSize.None,
					BackgroundTransparency = 1,
					selected = function(use: ComposeTypes.Use): boolean
						return use(spec.selection) == id
					end,
					onActivate = function()
						spec.selection:set(id)
					end,
				})
				dot:AddTag("facet-page-indicator")
				runtime.mount(function()
					return ctx.styled(
						Host.Frame "Dot" {
							AnchorPoint = V2.new(0.5, 0.5),
							Position = D2.fromScale(0.5, 0.5),
							Size = D2.fromOffset(8, 8),
							BorderSizePixel = 0,
							Host.UICorner { CornerRadius = ctx.round },
						},
						"page-dot"
					)
				end, dot)
				table.insert(dots, dot)
			end
			local rowProps: Types.FrameProps = { Name = "Indicators" }
			if overlayIndicators then
				rowProps.AnchorPoint = V2.new(0.5, 1)
				rowProps.Position = function(use: ComposeTypes.Use): UDim2
					return if hugs then D2.new(0.5, 0, 0, use(tallest)) else D2.new(0.5, 0, 1, -footerHeight)
				end
				rowProps.ZIndex = 2
			end
			local row = ctx.row(dots, rowProps)
			assert(row:FindFirstChildWhichIsA("UIListLayout")).Padding = ctx.types.UDim.new(0, 0)
			if overlayIndicators then
				indicatorRow = row
			else
				table.insert(footer, row)
			end
		end
		if spec.controls ~= false then
			table.insert(
				footer,
				ctx.row({
					UI.Button "Previous" {
						label = "Previous",
						enabled = function(use: ComposeTypes.Use)
							return indexById[use(spec.selection)] > 1
						end,
						onActivate = function()
							step(-1)
						end,
					},
					UI.Button "Next" {
						label = "Next",
						enabled = function(use: ComposeTypes.Use)
							return indexById[use(spec.selection)] < #spec.pages
						end,
						onActivate = function()
							step(1)
						end,
					},
				})
			)
		end
		local column = ctx.column(footer, {
			Name = "Footer",
			Position = function(use: ComposeTypes.Use)
				return if hugs then D2.fromOffset(0, use(tallest)) else D2.new(0, 0, 1, -footerHeight)
			end,
			Size = D2.new(1, 0, 0, footerHeight),
			AutomaticSize = E.AutomaticSize.None,
		})
		assert(column:FindFirstChildWhichIsA("UIListLayout")).HorizontalAlignment = E.HorizontalAlignment.Center
		local defaults: Types.FrameProps = {
			Name = "PageView",
			BackgroundTransparency = 1,
			Size = D2.fromScale(1, 1),
			pages,
			column,
		}
		if indicatorRow then
			defaults[#defaults + 1] = indicatorRow
		end
		local root = Host.Frame(ctx.props(spec, {
			"pages",
			"selection",
			"indicators",
			"indicatorPlacement",
			"summary",
			"controls",
			"autoAdvanceSeconds",
			"scrollWheel",
		}, defaults))
		if hugs then
			local unit = ctx.layoutUnit(root)
			Compose.watch(function(use: ComposeTypes.Use)
				local most = 0
				for _, height in heights do
					most = math.max(most, use(height).Y)
				end
				tallest:set(math.ceil(most / use(unit) - 1e-3))
			end)
		end
		return root
	end)
end
]]></ProtectedString>
							<string name="ScriptGuid">{8B124983-7C61-4A63-A076-EF43E0C2DA04}</string>
