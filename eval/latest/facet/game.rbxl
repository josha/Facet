								<string name="Value"><![CDATA[# VStack.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
align: Input<("start" | "center" | "end" | "stretch")>? = native
corners: Input<(number | "pill" | "square" | "control" | "panel")>? = omitted
distribute: Input<("start" | "center" | "end" | "spaceBetween" | "spaceAround" | "spaceEvenly")>? = native
gap: Input<(number | ("xs" | "s" | "m" | "l" | "xl") | string)>? = 0
height: Input<(number | "fill" | "hug")>? = "hug"
maxWidth: ValueNumber? = nil
padding: Input<((number | ("xs" | "s" | "m" | "l" | "xl") | string) | Sides)>? = 0
ref: ((Frame) -> ())? = omitted
status: Input<("neutral" | "info" | "success" | "warning" | "error" | "accent" | "voice" | "contrast")?>? = omitted
surface: ("surface" | "panel" | "pane")? = omitted
width: Input<(number | "fill" | "hug")>? = "hug"
wrap: ValueBoolean? = false
Sides = { top: (number | SpaceStep | string)?, right: (number | SpaceStep | string)?, bottom: (number | SpaceStep | string)?, left: (number | SpaceStep | string)?, [string]: nil }]]></string>
