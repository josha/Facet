	read Sandboxed: Engine.ValueBoolean?,
	read StyledPropertiesChanged: (() -> ())?,
	read AutoLocalize: Engine.ValueBoolean?,
	read RootLocalizationTable: (Engine.ValueLocalizationTableOptional | Engine.StaticValue)?,
	read SelectionBehaviorDown: Engine.ValueEnumSelectionBehavior?,
	read SelectionBehaviorLeft: Engine.ValueEnumSelectionBehavior?,
	read SelectionBehaviorRight: Engine.ValueEnumSelectionBehavior?,
	read SelectionBehaviorUp: Engine.ValueEnumSelectionBehavior?,
	read SelectionChanged: ((boolean, GuiObject, GuiObject) -> ())?,
	read SelectionGroup: Engine.ValueBoolean?,
