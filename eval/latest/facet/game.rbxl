								<string name="Value"><![CDATA[# NavBar.props
Options: name: type = default. omitted uses the control or theme default; required has no default.
backLabel: string? = omitted
center: GuiObject? = omitted
gap: number? = omitted
leading: GuiObject? = omitted
onBack: ((() -> ()) | Value<boolean>)? = omitted
padding: number? = omitted
ref: ((Frame) -> ())? = omitted
surface: ("surface" | "panel" | "pane")? = omitted
title: ValueString? = omitted
titleSize: string? = omitted
trailing: GuiObject? = omitted]]></string>
