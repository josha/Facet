	ChildRemoved: ((Instance) -> ())?,
	DescendantAdded: ((Instance) -> ())?,
	DescendantRemoving: ((Instance) -> ())?,
	Destroying: (() -> ())?,
	Name: Engine.ValueString?,
	Parent: (Engine.ValueInstanceOptional | Engine.StaticValue)?,
	Sandboxed: Engine.ValueBoolean?,
	StyledPropertiesChanged: (() -> ())?,
	AutoLocalize: Engine.ValueBoolean?,
	RootLocalizationTable: (Engine.ValueLocalizationTableOptional | Engine.StaticValue)?,
	SelectionBehaviorDown: Engine.ValueEnumSelectionBehavior?,
	SelectionBehaviorLeft: Engine.ValueEnumSelectionBehavior?,
	SelectionBehaviorRight: Engine.ValueEnumSelectionBehavior?,
	SelectionBehaviorUp: Engine.ValueEnumSelectionBehavior?,
	SelectionChanged: ((boolean, GuiObject, GuiObject) -> ())?,
	SelectionGroup: Engine.ValueBoolean?,
	Active: Engine.ValueBoolean?,
	AnchorPoint: Engine.ValueVector2?,
	AutomaticSize: Engine.ValueEnumAutomaticSize?,
	BackgroundColor3: Engine.ValueColor3?,
	BackgroundTransparency: Engine.ValueNumber?,
	BorderColor3: Engine.ValueColor3?,
	BorderMode: Engine.ValueEnumBorderMode?,
	BorderSizePixel: Engine.ValueNumber?,
	ClipsDescendants: Engine.ValueBoolean?,
	InputBegan: ((InputObject) -> ())?,
	InputChanged: ((InputObject) -> ())?,
	InputEnded: ((InputObject) -> ())?,
	InputSink: Engine.ValueEnumInputSink?,
	Interactable: Engine.ValueBoolean?,
	LayoutOrder: Engine.ValueNumber?,
	MouseEnter: ((number, number) -> ())?,
	MouseLeave: ((number, number) -> ())?,
	MouseMoved: ((number, number) -> ())?,
	MouseWheelBackward: ((number, number) -> ())?,
	MouseWheelForward: ((number, number) -> ())?,
	NextSelectionDown: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
	NextSelectionLeft: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
	NextSelectionRight: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
	NextSelectionUp: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
	Position: Engine.ValueUDim2?,
	Rotation: Engine.ValueNumber?,
	Selectable: Engine.ValueBoolean?,
	SelectionGained: (() -> ())?,
	SelectionImageObject: (Engine.ValueGuiObjectOptional | Engine.StaticValue)?,
	SelectionLost: (() -> ())?,
	SelectionOrder: Engine.ValueNumber?,
	Size: Engine.ValueUDim2?,
	SizeConstraint: Engine.ValueEnumSizeConstraint?,
	TouchLongPress: (({ Vector2 }, Enum.UserInputState) -> ())?,
	TouchPan: (({ Vector2 }, Vector2, Vector2, Enum.UserInputState) -> ())?,
	TouchPinch: (({ Vector2 }, number, number, Enum.UserInputState) -> ())?,
	TouchRotate: (({ Vector2 }, number, number, Enum.UserInputState) -> ())?,
	TouchSwipe: ((Enum.SwipeDirection, number) -> ())?,
	TouchTap: (({ Vector2 }) -> ())?,
	Visible: Engine.ValueBoolean?,
	ZIndex: Engine.ValueNumber?,
	Style: Engine.ValueEnumFrameStyle?,
	ref: ((Frame) -> ())?,
	padding: Types.Input<Layout.Padding>?,
	surface: ("surface" | "panel" | "pane")?,
	corners: Types.Input<Layout.StackCorners>?,
	status: Types.Input<Media.Status?>?,
	width: Types.Input<Layout.Extent>?,
	maxWidth: Types.ValueNumber?,
	height: Types.Input<Layout.Extent>?,
	gap: Types.Input<Layout.Space>?,
	align: Types.Input<Layout.Align>?,
	distribute: Types.Input<Layout.Distribute>?,
	wrap: Types.ValueBoolean?,
	[number]: Compose.Child?,
}
export type StackPropsInput = {
	read Changed: ((string) -> ())?,
	read Attributes: Engine.Attributes?,
	read AncestryChanged: ((Instance, Instance?) -> ())?,
	read Archivable: Engine.ValueBoolean?,
	read AttributeChanged: ((string) -> ())?,
	read Capabilities: Engine.ValueSecurityCapabilities?,
	read ChildAdded: ((Instance) -> ())?,
	read ChildRemoved: ((Instance) -> ())?,
	read DescendantAdded: ((Instance) -> ())?,
	read DescendantRemoving: ((Instance) -> ())?,
	read Destroying: (() -> ())?,
	read Name: Engine.ValueString?,
	read Parent: (Engine.ValueInstanceOptional | Engine.StaticValue)?,
	read Sandboxed: Engine.ValueBoolean?,
	read StyledPropertiesChanged: (() -> ())?,
	read AutoLocalize: Engine.ValueBoolean?,
	read RootLocalizationTable: (Engine.ValueLocalizationTableOptional | Engine.StaticValue)?,
	read SelectionBehaviorDown: Engine.ValueEnumSelectionBehavior?,
	read SelectionBehaviorLeft: Engine.ValueEnumSelectionBehavior?,
	read SelectionBehaviorRight: Engine.ValueEnumSelectionBehavior?,
	read SelectionBehaviorUp: Engine.ValueEnumSelectionBehavior?,
	read SelectionChanged: ((boolean, GuiObject, GuiObject) -> ())?,
	read SelectionGroup: Engine.ValueBoolean?,
	read Active: Engine.ValueBoolean?,
	read AnchorPoint: Engine.ValueVector2?,
	read AutomaticSize: Engine.ValueEnumAutomaticSize?,
	read BackgroundColor3: Engine.ValueColor3?,
	read BackgroundTransparency: Engine.ValueNumber?,
	read BorderColor3: Engine.ValueColor3?,
	read BorderMode: Engine.ValueEnumBorderMode?,
	read BorderSizePixel: Engine.ValueNumber?,
	read ClipsDescendants: Engine.ValueBoolean?,
	read InputBegan: ((InputObject) -> ())?,
	read InputChanged: ((InputObject) -> ())?,
	read InputEnded: ((InputObject) -> ())?,
