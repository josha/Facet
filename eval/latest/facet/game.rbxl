style: "automatic" | "sidebarAdaptable" | "collapsible"? = omitted
tabs: Input<{ Tab }> = required
textSize: Input<number | "fit">? = omitted
track: Input<"automatic" | "floating">? = omitted
transition: Transition | false? = omitted]]></string>
