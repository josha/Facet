# ── Review captures ─────────────────────────────────────────────────────────
# `artifacts/` is the evidence trail of every director round: paired Studio
# captures and their resolution dumps. It is 241 MB of the 261 MB on disk, it
# is REGENERABLE (the capture tools and the scenario rig are both in-tree), and
# a clone of this library should not carry a quarter of a gigabyte of PNGs.
#
artifacts/**/*.png
artifacts/**/*.jpg
artifacts/**/*.jpeg
artifacts/**/*.mov
artifacts/**/*.mp4
artifacts/**/*.json
artifacts/**/*.log

# build output + editor/OS noise
build/
sourcemap.json
.DS_Store

# Studio holds an open place open with a .lock beside it — never a repo artifact
*.rbxl.lock

# Python bytecode from tools/*.py — never an artifact
__pycache__/

# The sweep suite cache: one transcript per tree state, regenerated on any
# edit. Machine-local by construction (it keys on THIS checkout's content).
artifacts/suite_cache/

# The pinned SCOWL archive the example word data is generated from. 2.5 MB, and
# tools/build_word_lists.py re-downloads it on demand against a recorded SHA-256
# — the GENERATED word data is what ships, not its source.
tools/.wordlist-cache/

# The verification graph's result store: one structured producer result per
# exact input identity, regenerated by tools/verify.sh whenever an input moves.
# Machine-local by construction (it keys on THIS checkout's content and this
# machine's toolchain pins), and the whole point of it is that it can be thrown
# away without losing a claim.
artifacts/verify/

# secret-shaped files never enter the repository at all
API_KEYS.txt
*.env
.env
*.key
*.pem
id_rsa*

# run outputs regenerate under artifacts/; the tracked exceptions stay tracked
artifacts/


examples/facet-lab/evidence/
