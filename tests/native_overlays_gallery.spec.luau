--!strict
local t = require("./lib/testkit")
local Compose = require("../src/vendor/compose/core")
local overlay = require("./lib/overlay_world")
local Vector2 = require("@lune/roblox").Vector2

local function scenario(name: string, options: any?): (any, any)
	local built: any
	local w = overlay.new(function(UI, Host, engine, _, runtime)
		local ctx = { UI = UI, Host = Host, Compose = Compose, types = engine.types, runtime = runtime }
		built = require("../examples/gallery/scenarios/" .. name).build(ctx)
		return built.screen()
	end, options)
	return w, built
end

t.describe("native gallery: the Overlays tab", function()
	t.it("opens the about and source popovers from its steps, shows the rich tour, and resets", function()
		local w, built = scenario("overlays", { reducedMotion = true })
		t.expect(w.find("Header") ~= nil and w.find("Search") ~= nil).toBe(true)
		built.steps.openAbout()
		t.expect(w.find("AboutModal") ~= nil).toBe(true)
		t.expect(overlay.find(w.find("AboutModal"), "Body").ClassName).toBe("ScrollingFrame")
		w.find("ModalBack").Pressed.fire()
		t.expect(built.report().about).toBe(false)
		t.expect(built.report().status).toBe("Last: about closed (cancel)")
		built.steps.openSource()
		t.expect(w.find("SourceModal") ~= nil).toBe(true)
		w.find("SourceRow").AbsolutePosition = Vector2.new(16, 300)
		w.find("SourceRow").AbsoluteSize = Vector2.new(400, 20)
		w.find("Panel").AbsoluteSize = Vector2.new(200, 60)
		t.expect(w.find("Tail").Visible).toBe(true)
		w.find("DismissOutside").Activated.fire({ Position = Vector2.new(790, 590) })
		t.expect(built.report().source).toBe(false)
		built.steps.tour()
		local plate = w.find("CalloutPanel")
		t.expect(overlay.find(plate, "Steps").Text).toBe("1 of 3")
		overlay.find(plate, "Go").Activated.fire()
		t.expect(built.report().step).toBe(2)
		t.expect(overlay.find(w.find("CalloutPanel"), "Steps").Text).toBe("2 of 3")
		overlay.find(w.find("CalloutPanel"), "Later").Activated.fire()
		t.expect(w.find("CalloutPanel")).toBeNil()
		built.steps.openDialog()
		t.expect(w.find("DialogModal") ~= nil).toBe(true)
		t.expect(w.find("Hero") ~= nil).toBe(true)
		overlay.find(w.find("Actions"), "Stay").Activated.fire()
		t.expect(built.report().dialog).toBe(false)
		built.steps.reset()
		t.expect(built.report().status).toBe("Last: nothing yet")
		t.expect(built.report().step).toBe(1)
		built.steps.tour()
		t.expect(overlay.find(w.find("CalloutPanel"), "Steps").Text).toBe("1 of 3")
		w.stop()
	end)

	t.it("the locked popover and the terms dialog refuse their close until the screen allows it", function()
		local w, built = scenario("overlays", { reducedMotion = true })
		w.find("LockedButton").Activated.fire()
		t.expect(built.report().locked).toBe(true)
		w.find("ModalBack").Pressed.fire()
		t.expect(built.report().locked).toBe(true)
		t.expect(built.report().status).toBe("Last: close refused")
		w.find("Allow").Activated.fire()
		w.find("ModalBack").Pressed.fire()
		t.expect(built.report().locked).toBe(false)
		w.find("TermsButton").Activated.fire()
		w.find("Close").Activated.fire()
		t.expect(built.report().terms).toBe(true)
		w.find("Read").Activated.fire()
		w.find("Close").Activated.fire()
		t.expect(built.report().terms).toBe(false)
		t.expect(built.report().status).toBe("Last: terms closed (close)")
		w.stop()
	end)
end)

t.describe("native gallery: the Status tab notices and snackbars", function()
	t.it("the banner pins to the tab's top and its content moves out of the way, then back", function()
		local w, built = scenario("status_family", { reducedMotion = true })
		local frame = w.find("StatusFamily")
		local padding = frame:FindFirstChildWhichIsA("UIPadding")
		t.expect(padding.PaddingTop.Offset).toBe(16)
		built.notices.banner:set(true)
		local banner = w.find("Offline")
		t.expect(banner:IsDescendantOf(frame)).toBe(false)
		banner.AbsolutePosition = Vector2.new(0, 0)
		banner.AbsoluteSize = Vector2.new(800, 48)
		t.expect(padding.PaddingTop.Offset).toBe(16 + 48)
		built.notices.banner:set(false)
		t.expect(padding.PaddingTop.Offset).toBe(16)
		w.stop()
	end)

	t.it("the showcase buttons present through the same service; a burst is capped, never dropped silently", function()
		local w, built = scenario("status_family", { reducedMotion = true })
		w.find("SnackMessage").Activated.fire()
		t.expect(#w.findAll("Snack")).toBe(1)
		t.expect(overlay.find(w.find("Snack"), "Message").Text).toBe("Saved to your garage.")
		w.find("SnackBurst").Activated.fire()
		t.expect(#built.notices.entries:peek()).toBe(9)
		t.expect(built.notices.last:peek()).toBe("Last: refused, the snackbar queue is full")
		t.expect(#w.findAll("Snack")).toBe(1)
		w.advance(4.2, 42)
		t.expect(built.notices.last:peek()).toBe("Last: snackbar timeout")
		t.expect(#built.notices.entries:peek()).toBe(8)
		built.steps.reset()
		t.expect(#w.findAll("Snack")).toBe(0)
		w.stop()
	end)
end)
