	t.it("streams replies and preserves the conversation through presentation changes", function()
		withModel(function(model)
			model.prompt("What game should I play with friends?")
			t.expect(model.chat.send()).toBe(true)
			for _ = 1, 8 do
				model.step(0.1, false)
			end
			local messages = model.chat.messages:peek()
			t.expect(#messages).toBe(2)
			t.expect(#messages[2].content > 0).toBe(true)
			model.toggleMode()
			t.expect(#model.chat.messages:peek()).toBe(2)
			model.chat.stop()
			local content = model.chat.messages:peek()[2].content
			model.step(0.1, false)
			t.expect(model.chat.messages:peek()[2].content).toBe(content)
			model.chat.remove(messages[1].id)
			t.expect(#model.chat.messages:peek()).toBe(1)
			model.chat.clear()
			t.expect(#model.chat.messages:peek()).toBe(0)
		end)
	end)

