	t.it("NVM-2 retains native avatar controls across narrow layouts and expands live HUD", function()
		withScreens(function(world)
			local avatar, model, types = world.Avatar, world.model, world.types
			t.expect(find(avatar, "Rotation")).toBe(nil)
