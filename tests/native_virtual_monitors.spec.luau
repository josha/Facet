--!strict
local t = require("./lib/testkit")
local Compose = require("../src/vendor/compose/core")
local Roblox = require("../src/vendor/compose/roblox")
local modelModule = require("../examples/virtual_monitors/model")
local screens = require("../examples/virtual_monitors/screens")
local engineModule = require("./lib/native_engine")

local function withModel(body)
	local root = Compose.createRootOwner(function()
		local model = modelModule.new(Compose)
		Compose.cleanup(model.dispose)
		body(model)
	end)
	root.dispose()
end

local function find(node, name)
	if node.Name == name then
		return node
	end
	for _, child in node:GetChildren() do
		local found = find(child, name)
		if found then
			return found
		end
	end
	return nil
end

local function rate(node, value, types)
	local control = find(node, "Stars")
	control.AbsolutePosition = types.Vector2.new(0, 0)
	control.AbsoluteSize = types.Vector2.new(220, 44)
	control.Activated.fire({ Position = types.Vector3.new((value - 0.5) * 44, 20, 0) })
end

local function withScreens(body, options)
	local Facet = require("../src")
	local engine = engineModule.new()
	local runtime = Roblox.createRuntime(engine)
	local target = engine.new("ScreenGui")
	local gui, input = engine.new("GuiService"), engine.new("UserInputService")
	input.GetFocusedTextBox = function()
		return nil
	end
	input.IsKeyDown = function()
		return false
	end
	local lifetime = Compose.createRootOwner(function()
		local model = modelModule.new(Compose)
		Compose.cleanup(model.dispose)
		local config = {
			model = model,
			types = engine.types,
			services = { GuiService = gui, UserInputService = input },
			reducedMotion = true,
		}
		for key, value in options or {} do
			config[key] = value
		end
		local views = screens.create(Facet, runtime, config)
		local world = {
			model = model,
			runtime = runtime,
			engine = engine,
			target = target,
			gui = gui,
			input = input,
			types = engine.types,
			views = views,
			stops = {},
		}
		for _, name in { "Discover", "Avatar", "Chat" } do
			local stop, node = runtime.mount(views[name], target)
			world[name] = node
			world.stops[name] = stop
		end
		body(world)
	end, runtime.reactor)
	lifetime.dispose()
	t.expect(#target:GetChildren()).toBe(0)
	runtime:dispose()
end

t.describe("native virtual monitors", function()
	t.it("rejects nonnative Path2D paint properties in the engine fixture", function()
		local engine = engineModule.new()
		local path = engine.new("Path2D")
		for _, property in { "Color", "BackgroundColor3" } do
			local ok, failure = pcall(function()
				path[property] = engine.types.Color3.new(1, 0, 0)
			end)
			t.expect(ok).toBe(false)
			t.expect(string.find(tostring(failure), property .. " is not a valid member", 1, true) ~= nil).toBe(true)
		end
		path.Color3 = engine.types.Color3.new(1, 0, 0)
		path.Closed = true
		path.Thickness = 3
		t.expect(path.Color3).toBe(engine.types.Color3.new(1, 0, 0))
		t.expect(path.Closed).toBe(true)
		t.expect(path.Thickness).toBe(3)
		path:Destroy()
	end)
	t.it("filters and sorts the full catalog with stable tie order", function()
		withModel(function(model)
			t.expect(#model.catalog.items:peek()).toBe(36)
			model.discoveryScroll:set(472)
			model.genre:set("Adventure")
			t.expect(model.discoveryScroll:peek()).toBe(0)
			for _, item in model.visibleGames:peek() do
				t.expect(item.genre).toBe("Adventure")
			end
			model.discoveryScroll:set(236)
			model.query:set("chapter 2")
			t.expect(model.discoveryScroll:peek()).toBe(0)
			t.expect(#model.visibleGames:peek()).toBe(2)
			model.query:set("")
			model.genre:set("all")
			model.sort:set("rating")
			local games = model.visibleGames:peek()
			for i = 2, #games do
				t.expect(games[i - 1].percent >= games[i].percent).toBe(true)
				if games[i - 1].percent == games[i].percent then
					t.expect(games[i - 1].index < games[i].index).toBe(true)
				end
			end
			model.catalog.seen(35)
			model.catalog.step()
			t.expect(#model.catalog.items:peek()).toBe(72)
		end)
	end)

