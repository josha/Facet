			t.expect(world.model.discoveryScroll:peek()).toBe(800)
			world.stops.Discover()
			world.model.toggleMode()
			local _, nextDiscover = world.runtime.mount(world.views.Discover, world.target)
			local restored = find(nextDiscover, "Games")
			restored.AbsoluteWindowSize = types.Vector2.new(600, 260)
			t.expect(restored.CanvasPosition.Y).toBe(800)
			local history = {}
			for index = 1, 24 do
				table.insert(history, { id = index, role = "assistant", content = "Message " .. index })
			end
			world.model.chat.messages:set(history)
			local feed = find(world.Chat, "Messages")
			feed.AbsoluteWindowSize = types.Vector2.new(850, 260)
			feed.CanvasPosition = types.Vector2.new(0, 240)
			world.stops.Chat()
			world.model.toggleMode()
			local _, nextChat = world.runtime.mount(world.views.Chat, world.target)
			local restoredFeed = find(nextChat, "Messages")
			restoredFeed.AbsoluteWindowSize = types.Vector2.new(600, 260)
			t.expect(restoredFeed.CanvasPosition.Y).toBe(240)
		end)
	end)

	t.it("NVM-12 native modals capture selection and restore the launching control", function()
		withScreens(function(world)
			find(world.Discover, "Games").AbsoluteWindowSize = world.types.Vector2.new(850, 260)
			local open = find(world.Discover, "Game_1")
			world.gui.SelectedObject = open
			open.Activated.fire()
			t.expect(world.gui.SelectedObject == open).toBe(false)
			t.expect(world.gui.SelectedObject:IsDescendantOf(find(world.target, "AlertModal"))).toBe(true)
			find(world.Avatar, "TurnRight").Activated.fire()
			t.expect(world.model.angle:peek()).toBe(-15)
			find(world.target, "close").Activated.fire()
			t.expect(world.gui.SelectedObject).toBe(open)
		end)
	end)

	t.it("NVM-19 grows a game card into the screen and returns to its retained card and scroll", function()
		withScreens(function(world)
			local grid = find(world.Discover, "Games")
			grid.AbsoluteWindowSize = world.types.Vector2.new(850, 260)
			grid.CanvasPosition = world.types.Vector2.new(0, 236)
			local position = grid.CanvasPosition
			local card = find(world.Discover, "Game_1")
			local open = card
			local sourceParent = card.Parent
			card.AbsolutePosition = world.types.Vector2.new(100, 190)
			card.AbsoluteSize = world.types.Vector2.new(270, 224)
			world.gui.SelectedObject = open
			open.Activated.fire()
			local selected = world.model.selectedGame:peek()
			local panel = find(world.target, "AlertPanel")
			find(world.target, "AlertModal").AbsoluteSize = world.types.Vector2.new(920, 640)
			local detail = find(panel, "GameDetails")
			local snapshot = find(panel, "SourceSnapshot")
			t.expect(panel.Size.X.Offset).toBe(270)
			t.expect(panel.Size.Y.Offset).toBe(224)
			t.expect(panel.Position.X.Offset).toBe(100)
			t.expect(panel.Position.Y.Offset).toBe(190)
			world.engine.heartbeat.fire(0.12)
			t.expect(panel.Size.X.Offset > 270 and panel.Size.X.Offset < 920).toBe(true)
			t.expect(panel.Size.Y.Offset > 224 and panel.Size.Y.Offset < 640).toBe(true)
			world.engine.heartbeat.fire(0.2)
			t.expect(panel.Size.X.Offset).toBe(920)
			t.expect(panel.Size.Y.Offset).toBe(640)
			find(panel, "close").Activated.fire()
			t.expect(world.model.selectedGame:peek()).toBe(nil)
			t.expect(find(panel, "GameDetails")).toBe(detail)
			world.engine.heartbeat.fire(0.1)
			local departingSize = panel.Size
			world.model.selectGame(selected)
			t.expect(find(world.target, "AlertPanel")).toBe(panel)
			t.expect(panel.Size).toBe(departingSize)
			world.engine.heartbeat.fire(0.32)
			find(panel, "close").Activated.fire()
			world.engine.heartbeat.fire(0.32)
			t.expect(find(world.target, "AlertPanel")).toBe(nil)
			t.expect(snapshot.isDestroyed()).toBe(true)
			t.expect(card.Parent).toBe(sourceParent)
			t.expect(card.isDestroyed()).toBe(false)
			t.expect(grid.CanvasPosition).toBe(position)
			t.expect(world.gui.SelectedObject).toBe(open)
		end, { reducedMotion = false })
	end)

	t.it("NVM-13 desktop tab transitions reclaim interrupted content and release departing owners", function()
		local Facet, desktop = require("../src"), require("../examples/virtual_monitors/desktop")
		local engine = engineModule.new()
		local runtime = Roblox.createRuntime(engine)
		local mounted, released, now = {}, {}, 0
		local target = engine.new("ScreenGui")
		local lifetime = Compose.createRootOwner(function()
			local model = modelModule.new(Compose)
			Compose.cleanup(model.dispose)
			local views = {}
			for _, name in { "Discover", "Avatar", "Chat" } do
				views[name] = function()
					mounted[name] = (mounted[name] or 0) + 1
					Compose.cleanup(function()
						released[name] = (released[name] or 0) + 1
					end)
					return runtime.constructors.Frame({ Name = name .. "Content" })
				end
			end
			local stop, root = runtime.mount(
				desktop.create(Facet, runtime, views, model, Compose.cell(1), { types = engine.types }),
				target
			)
			local first = find(root, "DiscoverContent")
			for _ = 1, 20 do
				engine.heartbeat.fire(1 / 60)
			end
			model.selectedTab:set("Avatar")
			engine.heartbeat.fire(0.04)
			t.expect(find(root, "AvatarContent") ~= nil).toBe(true)
			t.expect(find(root, "DiscoverContent")).toBe(first)
			model.selectedTab:set("Discover")
			t.expect(find(root, "DiscoverContent")).toBe(first)
			for _ = 1, 30 do
				engine.heartbeat.fire(1 / 60)
			end
			t.expect(find(root, "AvatarContent")).toBe(nil)
			t.expect(released.Avatar).toBe(1)
			t.expect(mounted.Discover).toBe(1)
			stop()
			t.expect(released.Discover).toBe(1)
		end, runtime.reactor)
		lifetime.dispose()
		runtime:dispose()
	end)
	t.it("NVM-14 keeps the selected app and shared avatar state across presentation round trips", function()
		withModel(function(model)
			model.focus("Discover")
			model.toggleMode()
			model.selectedTab:set("Avatar")
			model.avatarSettingsExpanded:set(false)
			model.avatarTipsExpanded:set(true)
			model.avatarSummaryDetent:set("large")
			model.toggleMode()
			t.expect(model.focused:peek()).toBe("Avatar")
			t.expect(model.selectedTab:peek()).toBe("Avatar")
			model.toggleMode()
			t.expect(model.avatarSettingsExpanded:peek()).toBe(false)
			t.expect(model.avatarTipsExpanded:peek()).toBe(true)
			t.expect(model.avatarSummaryDetent:peek()).toBe("large")
		end)
	end)
	t.it("NVM-15 keeps six recommendations and the original per-game trend values", function()
		withScreens(function(world)
			local model = world.model
			model.catalog.seen(35)
			model.catalog.step()
			model.selectGame(model.catalog.items:peek()[1])
			local points = find(world.target, "TrendLine"):GetControlPoints()
			for day = 0, 6 do
				local expected = 1 - (0.25 + 0.5 * ((1 * (day + 1) * 37) % 23) / 23)
				t.expect(math.abs(points[day + 1].Position.Y.Scale - expected) < 0.0001).toBe(true)
			end
			find(world.target, "SimilarTab").Activated.fire()
			local count = 0
			for _, node in find(world.target, "SimilarGames"):GetChildren() do
				if node.Name:match("^SimilarRow_") then
					count += 1
				end
			end
			t.expect(count).toBe(6)
		end)
	end)

