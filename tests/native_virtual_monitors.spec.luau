			local image = find(world.target, "CreatorAvatar")
			t.expect(find(image, "CreatorShimmer") ~= nil).toBe(true)
			pending[first.creatorImage](first.creatorImage)
			t.expect(find(image, "CreatorShimmer")).toBe(nil)
			t.expect(find(image, "Image").Image).toBe(first.creatorImage)
			t.expect(#find(world.target, "TrendLine"):GetControlPoints()).toBe(7)
			local point = find(world.target, "TrendLine"):GetControlPoints()[1].Position.Y.Scale
			model.selectGame(second)
