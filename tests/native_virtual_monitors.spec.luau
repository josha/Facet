	t.it(
		"keeps touch scrolling available until native long press and saves only the held contact on release",
		function()
			withScreens(function(world)
				local types, model, input = world.types, world.model, world.input
				local states = types.Enum.UserInputState
				local games = find(world.Discover, "Games")
				games.AbsoluteWindowSize = types.Vector2.new(820, 260)
				games.ScrollingEnabled = true
				local shelves = find(world.Discover, "Shelves")
				shelves.AbsolutePosition, shelves.AbsoluteSize = types.Vector2.new(20, 80), types.Vector2.new(600, 40)
				local card = find(world.Discover, "Game_1")
				local body, preview = find(card, "Body"), find(card, "Preview")
				local drag = find(card, "SaveDrag")
				t.expect(drag.Enabled).toBe(true)
				input.TouchEnabled = true
				t.expect(drag.Enabled).toBe(false)
				local function contact()
					local value = world.engine.new("InputObject")
					value.UserInputType = types.Enum.UserInputType.Touch
					value.UserInputState = states.Begin
					value.Position = types.Vector3.new(60, 260, 0)
					return value
				end
				local function beginHold(value)
					preview.InputBegan.fire(value)
					preview.TouchLongPress.fire({ types.Vector2.new(60, 260) }, states.Begin)
					t.expect(drag.Enabled).toBe(false)
					t.expect(games.ScrollingEnabled).toBe(false)
				end
				local function release(value)
					value.UserInputState = states.End
					input.InputEnded.fire(value, true)
				end
				local flick = contact()
				preview.InputBegan.fire(flick)
				flick.Position = types.Vector3.new(50, 95, 0)
				t.expect(games.ScrollingEnabled).toBe(true)
				release(flick)
				t.expect(model.saved:peek()["1"]).toBe(nil)
				t.expect(flick:GetPropertyChangedSignal("Position").count()).toBe(0)
				local held = contact()
				beginHold(held)
				preview.TouchLongPress.fire({ types.Vector2.new(50, 95) }, states.End)
				t.expect(games.ScrollingEnabled).toBe(false)
				t.expect(model.saved:peek()["1"]).toBe(nil)
				held.Position = types.Vector3.new(50, 95, 0)
				release(contact())
				t.expect(games.ScrollingEnabled).toBe(false)
				t.expect(model.saved:peek()["1"]).toBe(nil)
				release(held)
				t.expect(games.ScrollingEnabled).toBe(true)
				t.expect(model.saved:peek()["1"]).toBe(true)
				body.Activated.fire(held)
				t.expect(model.selectedGame:peek()).toBe(nil)
				t.expect(held:GetPropertyChangedSignal("Position").count()).toBe(0)
				t.expect(held:GetPropertyChangedSignal("UserInputState").count()).toBe(0)
				drag.DragEnd.fire(types.Vector2.new(50, 95))
