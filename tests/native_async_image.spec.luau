--!strict
local t = require("./lib/testkit")
local Facet = require("../src")
local Compose = Facet.Compose
local world = require("./lib/native_motion_world")
t.describe("Native AsyncImage", function()
	t.it("shares a request, renders completion, and releases it with the mounted owner", function()
		local app, adapter, advance, core = world()
		local UI = app.controls
		local provider = Facet.newResourceProvider(core)
		local dimmed = Compose.cell(false)
		local close = app.mount(function()
			local before = core.owner.size()
			local result = UI.AsyncImage("Avatar")({ provider = provider, key = "rbxassetid://123", dimmed = dimmed })
			t.expect(core.owner.size()).toBe(before)
			return UI.Screen("S")({ result })
		end)
		advance(0.1)
		t.expect(provider.counters().handles).toBe(1)
		t.expect(adapter.node("/S/Avatar/Placeholder/then/Fill") ~= nil).toBe(true)
		local request = provider.pendingRequests()[1]
		t.expect(provider.complete(request.key, request.generation, request.key)).toBe("applied")
		advance(0.1)
		t.expect(adapter.node("/S/Avatar/Content").props.image).toBe(request.key)
		t.expect(adapter.node("/S/Avatar/Placeholder/then/Fill")).toBe(nil)
		dimmed:set(true)
		advance(0.1)
		t.expect(adapter.node("/S/Avatar/Content").props.tint.blend).toBe(0.35)
		close()
		advance(0.1)
		t.expect(provider.counters().handles).toBe(0)
		t.expect(adapter.rootCount()).toBe(0)
		provider.dispose()
		app.dispose()
	end)
	t.it("rejects a pending completion after its view unmounts", function()
		local app, _, advance, core = world()
		local provider = Facet.newResourceProvider(core)
		local close = app.mount(function()
			return app.controls.AsyncImage({ provider = provider, key = "rbxassetid://456" })
		end)
		advance(0.1)
		local request = provider.pendingRequests()[1]
		close()
		advance(0.1)
		t.expect(provider.counters().handles).toBe(0)
		t.expect(#provider.pendingRequests()).toBe(0)
		t.expect(provider.complete(request.key, request.generation, request.key)).toBe("stale")
		provider.dispose()
		app.dispose()
	end)
end)
