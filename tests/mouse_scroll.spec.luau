--!strict
local t = require("./lib/testkit")
local mouseScroll = require("../src/input/mouse_scroll")
t.describe("mouse scroll arbitration", function()
	t.it("preserves clicks, ignores vertical intent, and clamps horizontal drag", function()
		local drag = mouseScroll.new({ x = 100, y = 40 }, 20)
		t.expect(drag.move({ x = 97, y = 40 }, 200)).toBe(nil)
		t.expect(drag.move({ x = 60, y = 42 }, 200)).toBe(60)
		t.expect(drag.move({ x = -400, y = 42 }, 200)).toBe(200)
		t.expect(drag.move({ x = 200, y = 42 }, 200)).toBe(0)
		local vertical = mouseScroll.new({ x = 0, y = 0 }, 0)
		t.expect(vertical.move({ x = 2, y = 20 }, 200)).toBe(nil)
		t.expect(vertical.move({ x = 100, y = 20 }, 200)).toBe(nil)
	end)
end)
