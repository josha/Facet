--!strict
local t = require("./lib/testkit")
local mouseScroll = require("../src/input/mouse_scroll")
t.describe("mouse scroll arbitration", function()
	t.it("preserves clicks, ignores vertical intent, and clamps horizontal drag", function()
		local drag = mouseScroll.new({ x = 100, y = 40 }, 20)
		t.expect(drag.move({ x = 97, y = 40 }, 200)).toBe(nil)
		t.expect(drag.move({ x = 60, y = 42 }, 200)).toBe(60)
		t.expect(drag.move({ x = -400, y = 42 }, 200)).toBe(200)
		t.expect(drag.move({ x = 200, y = 42 }, 200)).toBe(0)
		local vertical = mouseScroll.new({ x = 0, y = 0 }, 0)
		t.expect(vertical.move({ x = 2, y = 20 }, 200)).toBe(nil)
		t.expect(vertical.move({ x = 100, y = 20 }, 200)).toBe(nil)
	end)
	t.it("a paged drag cannot pass an adjacent page and can reverse before release", function()
		local drag = mouseScroll.new({ x = 100, y = 40 }, 600, 600)
		t.expect(drag.move({ x = -1900, y = 40 }, 3000)).toBe(1200)
		t.expect(drag.move({ x = 2100, y = 40 }, 3000)).toBe(0)
		t.expect(drag.move({ x = 110, y = 40 }, 3000)).toBe(590)
		local resized = mouseScroll.new({ x = 100, y = 40 }, 1200, 600)
		t.expect(resized.move({ x = -1900, y = 40 }, 200)).toBe(200) -- resized canvas
		local first = mouseScroll.new({ x = 100, y = 40 }, 0, 600)
		t.expect(first.move({ x = 2100, y = 40 }, 3000)).toBe(0)
		local last = mouseScroll.new({ x = 100, y = 40 }, 3000, 600)
		t.expect(last.move({ x = -1900, y = 40 }, 3000)).toBe(3000)
	end)
end)
