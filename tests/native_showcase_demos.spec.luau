--!strict
local t = require("./lib/testkit")
local Facet = require("../src")
local engineLib = require("./lib/native_engine")
local gallery = require("../examples/gallery/client/screen")
local C = Facet.Compose

local function mount(name, run)
	local engine = engineLib.new()
	local runtime = Facet.Roblox.createRuntime(engine)
	local target = engine.new("ScreenGui")
	local ctx = {
		Facet = Facet,
		Compose = C,
		runtime = runtime,
		Host = runtime.constructors,
		types = engine.types,
		viewport = C.cell({ width = 1280, height = 720 }),
		inputTarget = target,
		worldTarget = engine.new("Folder"),
		runService = { Heartbeat = engine.heartbeat },
	}
	ctx.UI = Facet.controls(runtime, { types = ctx.types, viewport = ctx.viewport })
	local built
	local stop, root = runtime.mount(function()
		gallery.configure(ctx)
		built = require("../examples/gallery/examples/" .. name).build(ctx)
		return built.screen()
	end, target)
	run(built, root, ctx, engine)
	stop()
	t.expect(#target:GetChildren()).toBe(0)
	t.expect(#ctx.worldTarget:GetChildren()).toBe(0)
	runtime:dispose()
end

t.describe("showcase demos", function()
	t.it("keeps saved cars through page changes and restores their appearance", function()
		mount("08_garage", function(built, root, ctx)
			built.model.vehicle:set("rover")
			built.model.wheel:set("rally")
			built.save()
			t.expect(built.report().presets).toBe(1)
			built.model.vehicle:set("sprint")
			built.model.savedOpen:set(true)
			ctx.inputTarget:FindFirstChild("LoadPreset1", true).Activated.fire()
			t.expect(built.report().vehicle).toBe("rover")
			t.expect(built.report().wheels).toBe("rally")
			built.model.savedOpen:set(false)
			t.expect(built.report().presets).toBe(1)
			built.reset()
			t.expect(built.report().presets).toBe(0)
		end)
	end)
	t.it("names cars in an anchored popover and reveals saved cars inline", function()
		mount("08_garage", function(built, root, ctx)
			root:FindFirstChild("SavePreset", true).Activated.fire()
			t.expect(ctx.inputTarget:FindFirstChild("PresetName", true) ~= nil).toBe(true)
			ctx.inputTarget:FindFirstChild("ConfirmSave", true).Activated.fire()
			t.expect(built.report().presets).toBe(1)
			built.model.savedOpen:set(true)
			t.expect(root:FindFirstChild("LoadPreset1", true) ~= nil).toBe(true)
		end)
	end)

	t.it("equips a warm outfit, filters equipment and swaps hotbar slots without duplication", function()
		mount("09_adventurers_pack", function(built)
			t.expect(built.report().warmth).toBe(2)
			built.equip("frostcoat")
			built.equip("snowboots")
			t.expect(built.report().warmth).toBe(10)
			built.model.query:set("frost")
			t.expect(#built.model.filtered:peek()).toBe(1)
			built.model.loadoutOpen:set(true)
			built.model.loadoutOpen:set(false)
			t.expect(built.assign("lantern", 1)).toBe(true)
			t.expect(built.report().hotbar[1]).toBe("lantern")
			t.expect(built.report().hotbar[2]).toBe("sword")
			t.expect(built.assign("frostcoat", 1)).toBe(false)

			built.model.path:set({ { id = "item", value = "lantern" } })
			t.expect(built.report().warmth).toBe(10)
			built.reset()
			t.expect(built.report().warmth).toBe(2)
		end)
	end)
	t.it("rejects the wrong batch and pays exactly once for each of three orders", function()
		mount("10_potion_shop", function(built)
			t.expect(built.brew()).toBe(false)
			for _, order in { { "sun", 2 }, { "moon", 1 }, { "moss", 3 } } do
				for _ = 1, order[2] do
					t.expect(built.addIngredient(order[1])).toBe(true)
				end
				t.expect(built.addIngredient(if order[1] == "sun" then "moon" else "sun")).toBe(false)
				t.expect(built.brew()).toBe(true)
				t.expect(built.serve()).toBe(false)
				built.advance(3)
				t.expect(built.serve()).toBe(true)
				t.expect(built.serve()).toBe(false)
			end
			t.expect(built.report().coins).toBe(86)
			t.expect(built.report().sales).toBe(3)
			t.expect(built.brew()).toBe(false)
			built.model.bookOpen:set(true)
			built.model.bookOpen:set(false)
			built.model.ledgerOpen:set(true)
			built.reset()
			t.expect(built.report().coins).toBe(0)
		end)
	end)
	t.it("requires water and collects three distinct nectar visitors", function()
		mount("11_glade", function(built)
			t.expect(built.invite()).toBe(false)
			built.refill()
			for _, nectar in { "bramble", "clover", "meadow" } do
				built.model.nectar:set(nectar)
				t.expect(built.invite()).toBe(true)
			end
			t.expect(built.report().discovered).toBe(3)
			built.invite()
			t.expect(built.report().discovered).toBe(3)
			built.model.guideOpen:set(true)
			built.model.guideOpen:set(false)
			built.model.journalOpen:set(true)
			t.expect(built.report().visits).toBe(4)
			built.reset()
			t.expect(built.report().discovered).toBe(0)
		end)
	end)
	t.it("rejects excess power and tears down its world surface", function()
		mount("12_outpost", function(built)
			built.model.draft.door:set(3)
			built.model.draft.beacon:set(2)
			built.model.draft.workshop:set(4)
			t.expect(built.apply()).toBe(false)
			t.expect(built.report().running).toBe(1)
			built.model.draft.door:set(2)
			built.model.draft.beacon:set(1)
			built.model.draft.workshop:set(2)
			t.expect(built.apply()).toBe(true)
			t.expect(built.report().running).toBe(3)
			built.model.worldMode:set(true)
			t.expect(built.report().world).toBe(true)
			built.model.worldMode:set(false)
			built.reset()
			t.expect(built.report().running).toBe(1)
		end)
	end)
	t.it("opens every arcade game from the retained navigation", function()
		mount("13_arcade", function(built)
			for _, page in { "word", "crossword", "match3", "outpost", "word" } do
				t.expect(built.select(page)).toBe(true)
				t.expect(built.report().active).toBe(page)
			end
		end)
	end)
	t.it("keeps recipe history and ingredient checks while following related blends", function()
		mount("14_sipworks", function(built)
			built.open("amber-harvest")
			built.model.servings:set(3)
			built.model.gathered["amber-harvest/cinnamon"]:set(true)
			built.push("ingredient", "cinnamon")
			built.push("recipe", "copper-chai")
			t.expect(#built.report().path).toBe(3)
			built.back()
			t.expect(built.report().path[2].value).toBe("cinnamon")
			built.back()
			t.expect(built.report().path[1].value).toBe("amber-harvest")
			t.expect(built.report().servings).toBe(3)
			t.expect(built.model.gathered["amber-harvest/cinnamon"]:peek()).toBe(true)
			t.expect(built.select("saved")).toBe(true)
			t.expect(built.select("all")).toBe(true)
		end)
	end)
	t.it("clears the recipe search and uses stack Back in the wide detail pane", function()
		mount("14_sipworks", function(built, root, ctx, engine)
			local navigation = root:FindFirstChild("RecipeNavigation", true)
			t.expect(navigation ~= nil).toBe(true)
			local back = navigation:FindFirstChild("Back", true)
			t.expect(back == nil or not back.Visible).toBe(true)
			built.model.query:set("cinnamon")
			root:FindFirstChild("FindRecipe", true):FindFirstChild("Clear", true).Activated.fire()
			t.expect(built.model.query:peek()).toBe("")
			built.open("amber-harvest")
			for _ = 1, 90 do
				engine.heartbeat.fire(1 / 60)
			end
			built.push("ingredient", "cinnamon")
			for _ = 1, 90 do
				engine.heartbeat.fire(1 / 60)
			end
			navigation:FindFirstChild("ingredient"):FindFirstChild("Back", true).Activated.fire()
			t.expect(#built.report().path).toBe(1)
			for _ = 1, 90 do
				engine.heartbeat.fire(1 / 60)
			end
			navigation:FindFirstChild("recipe"):FindFirstChild("Back", true).Activated.fire()
			t.expect(#built.report().path).toBe(0)
		end)
	end)
	t.it("puts Cartwheel Close on the action ring and inspects the order inline", function()
		mount("15_cartwheel", function(built, root, ctx)
			root:FindFirstChild("Actions_101", true):FindFirstChild("Launcher").Activated.fire()
			local close = ctx.inputTarget:FindFirstChild("$navigation", true)
			t.expect(close ~= nil).toBe(true)
			close.Activated.fire()
			built.inspect(101)
			t.expect(root:FindFirstChild("Order_101", true):FindFirstChild("Potion", true) ~= nil).toBe(true)
		end)
	end)

	t.it("runs market orders through confirmation brewing and collection", function()
		mount("15_cartwheel", function(built)
			built.steps.start(101)
			built.steps.advance(2)
			t.expect(built.model.orders.statusOf(101)).toBe("brewing")
			built.steps.advance(61)
			t.expect(built.model.orders.statusOf(101)).toBe("ready")
			built.steps.collect(101)
			built.steps.advance(2)
			t.expect(built.model.orders.statusOf(101)).toBe("done")
		end)
	end)
end)
